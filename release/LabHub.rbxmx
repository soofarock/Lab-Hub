        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Ts</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- MPEG transport stream (.ts, the segments of an HLS stream) and HLS playlists (.m3u8).
--
--   local ts = Ts.parse(buf)   -- buffer of 188-byte packets
--   ts.video = { codec = "h264", units = { { pts, dts, data = buffer } ... } }   one access unit (Annex B) each, in
--              decoding order; times in seconds
--   ts.audio = { codec = "aac", frames = { { pts, data = buffer } ... } }       ADTS frames (header included)
--   Ts.isTs(buf)
--   Ts.packUnits(units, audio) -> buffer: access units ({ { pts, data } ... }, Annex B) handed on without a transport
--       stream (an MP4 streamed in parts, Tools.Live.openMp4), and its sound (ADTS frames, as ts.audio.frames; optional);
--       Ts.parse reads it back the same way as a segment
--
--   local pl = Ts.playlist(text, baseUrl)
--   pl.variants = { { url, bandwidth, width, height } ... }   (a master playlist: pick one, read its playlist)
--   pl.segments = { { url, duration, start } ... }, pl.duration, pl.ended (true: the whole video is listed)
--   Ts.pickVariant(pl.variants, lines) -> the variant at most `lines` tall with the highest bandwidth (else the smallest)

local Ts = {}

local readu8 = buffer.readu8

function Ts.isTs(b)
	local n = buffer.len(b)
	if n < 188 * 2 then
		return n >= 188 and readu8(b, 0) == 0x47
	end
	return readu8(b, 0) == 0x47 and readu8(b, 188) == 0x47
end

-- 33-bit PTS / DTS at p -> seconds
local function readTime(b, p)
	local a = readu8(b, p)
	local v = bit32.band(bit32.rshift(a, 1), 7) * 1073741824
	v += readu8(b, p + 1) * 4194304 + bit32.rshift(readu8(b, p + 2), 1) * 32768
	v += readu8(b, p + 3) * 128 + bit32.rshift(readu8(b, p + 4), 1)
	return v / 90000
end

function Ts.packUnits(units, audio)
	local total = 8
	for _, u in ipairs(units) do
		total += 12 + buffer.len(u.data)
	end
	if audio and #audio > 0 then
		total += 8
		for _, f in ipairs(audio) do
			total += 12 + buffer.len(f.data)
		end
	end
	local b = buffer.create(total)
	buffer.writestring(b, 0, "FLAU")
	buffer.writeu32(b, 4, #units)
	local p = 8
	for _, u in ipairs(units) do
		local len = buffer.len(u.data)
		buffer.writef64(b, p, u.pts)
		buffer.writeu32(b, p + 8, len)
		buffer.copy(b, p + 12, u.data, 0, len)
		p += 12 + len
	end
	if audio and #audio > 0 then
		buffer.writestring(b, p, "AUDS")
		buffer.writeu32(b, p + 4, #audio)
		p += 8
		for _, f in ipairs(audio) do
			local len = buffer.len(f.data)
			buffer.writef64(b, p, f.pts)
			buffer.writeu32(b, p + 8, len)
			buffer.copy(b, p + 12, f.data, 0, len)
			p += 12 + len
		end
	end
	return b
end

local function unpackUnits(b)
	local units = {}
	local p = 8
	for i = 1, buffer.readu32(b, 4) do
		local pts, len = buffer.readf64(b, p), buffer.readu32(b, p + 8)
		local d = buffer.create(len)
		buffer.copy(d, 0, b, p + 12, len)
		units[i] = { pts = pts, dts = pts, data = d }
		p += 12 + len
	end
	local audio = {}
	if p + 8 <= buffer.len(b) and buffer.readstring(b, p, 4) == "AUDS" then
		local frames = {}
		local n = buffer.readu32(b, p + 4)
		p += 8
		for i = 1, n do
			local pts, len = buffer.readf64(b, p), buffer.readu32(b, p + 8)
			local d = buffer.create(len)
			buffer.copy(d, 0, b, p + 12, len)
			frames[i] = { pts = pts, data = d }
			p += 12 + len
		end
		audio = { codec = "aac", frames = frames }
	end
	return { video = { codec = "h264", units = units }, audio = audio }
end

function Ts.parse(b)
	local n = buffer.len(b)
	if n >= 8 and buffer.readstring(b, 0, 4) == "FLAU" then
		return unpackUnits(b)
	end
	local start = 0
	-- (find the first sync byte with another one a packet later)
	while start + 188 < n and not (readu8(b, start) == 0x47 and readu8(b, start + 188) == 0x47) do
		start += 1
	end
	local pmtPid, videoPid, audioPid
	local videoType, audioType
	local pes = {} -- pid -> { parts = { {pos, len} }, size, pts, dts }
	local out = { video = { codec = nil, units = {} }, audio = { codec = nil, frames = {} } }

	local function flush(pid)
		local cur = pes[pid]
		pes[pid] = nil
		if not cur or cur.size == 0 then
			return
		end
		local data = buffer.create(cur.size)
		local o = 0
		for _, part in ipairs(cur.parts) do
			buffer.copy(data, o, b, part[1], part[2])
			o += part[2]
		end
		if pid == videoPid then
			table.insert(out.video.units, { pts = cur.pts, dts = cur.dts or cur.pts, data = data })
		elseif pid == audioPid then
			-- split into ADTS frames; times follow the PES time (1024 samples a frame)
			local p, t = 0, cur.pts or 0
			while p + 7 <= cur.size do
				if readu8(data, p) ~= 0xFF or bit32.band(readu8(data, p + 1), 0xF0) ~= 0xF0 then
					p += 1
					continue
				end
				local len = bit32.bor(bit32.lshift(bit32.band(readu8(data, p + 3), 3), 11), bit32.lshift(readu8(data, p + 4), 3),
					bit32.rshift(readu8(data, p + 5), 5))
				if len < 7 or p + len > cur.size then
					break
				end
				local rateIndex = bit32.band(bit32.rshift(readu8(data, p + 2), 2), 15)
				local rates = { 96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050, 16000, 12000, 11025, 8000, 7350 }
				local frame = buffer.create(len)
				buffer.copy(frame, 0, data, p, len)
				table.insert(out.audio.frames, { pts = t, data = frame })
				t += 1024 / (rates[rateIndex + 1] or 48000)
				p += len
			end
		end
	end

	for p = start, n - 188, 188 do
		if readu8(b, p) ~= 0x47 then
			continue
		end
		local b1, b2, b3 = readu8(b, p + 1), readu8(b, p + 2), readu8(b, p + 3)
		local unitStart = bit32.band(b1, 0x40) ~= 0
		local pid = bit32.band(b1, 0x1F) * 256 + b2
		local afc = bit32.band(bit32.rshift(b3, 4), 3)
		local q = p + 4
		if afc == 2 or afc == 3 then
			q += 1 + readu8(b, q)
		end
		if afc == 2 or afc == 0 or q >= p + 188 then
			continue
		end
		local stop = p + 188
		if pid == 0 then
			-- PAT: the first program's PMT
			if unitStart then
				q += 1 + readu8(b, q)
			end
			local secLen = bit32.band(readu8(b, q + 1), 15) * 256 + readu8(b, q + 2)
			local e = math.min(q + 3 + secLen - 4, stop)
			local r = q + 8
			while r + 4 <= e do
				local prog = readu8(b, r) * 256 + readu8(b, r + 1)
				local ppid = bit32.band(readu8(b, r + 2), 0x1F) * 256 + readu8(b, r + 3)
				if prog ~= 0 then
					pmtPid = ppid
					break
				end
				r += 4
			end
		elseif pid == pmtPid then
			if unitStart then
				q += 1 + readu8(b, q)
			end
			local secLen = bit32.band(readu8(b, q + 1), 15) * 256 + readu8(b, q + 2)
			local e = math.min(q + 3 + secLen - 4, stop)
			local infoLen = bit32.band(readu8(b, q + 10), 15) * 256 + readu8(b, q + 11)
			local r = q + 12 + infoLen
			while r + 5 <= e do
				local st = readu8(b, r)
				local epid = bit32.band(readu8(b, r + 1), 0x1F) * 256 + readu8(b, r + 2)
				local esLen = bit32.band(readu8(b, r + 3), 15) * 256 + readu8(b, r + 4)
				if not videoPid and (st == 0x1B or st == 0x24 or st == 0x01 or st == 0x02) then
					videoPid, videoType = epid, st
				elseif not audioPid and (st == 0x0F or st == 0x03 or st == 0x04 or st == 0x81) then
					audioPid, audioType = epid, st
				end
				r += 5 + esLen
			end
		elseif pid == videoPid or pid == audioPid then
			if unitStart then
				flush(pid)
				-- PES header: 00 00 01, stream id, length (2), flags (2), header length, PTS / DTS
				if readu8(b, q) == 0 and readu8(b, q + 1) == 0 and readu8(b, q + 2) == 1 then
					local flags = readu8(b, q + 7)
					local hlen = readu8(b, q + 8)
					local cur = { parts = {}, size = 0 }
					if bit32.band(flags, 0x80) ~= 0 then
						cur.pts = readTime(b, q + 9)
						if bit32.band(flags, 0x40) ~= 0 then
							cur.dts = readTime(b, q + 14)
						end
					end
					pes[pid] = cur
					q += 9 + hlen
				end
			end
			local cur = pes[pid]
			if cur and q < stop then
				table.insert(cur.parts, { q, stop - q })
				cur.size += stop - q
			end
		end
	end
	if videoPid then
		flush(videoPid)
	end
	if audioPid then
		flush(audioPid)
	end
	local vnames = { [0x1B] = "h264", [0x24] = "h265", [0x01] = "mpeg1", [0x02] = "mpeg2" }
	local anames = { [0x0F] = "aac", [0x03] = "mp3", [0x04] = "mp3", [0x81] = "ac3" }
	out.video.codec = videoType and vnames[videoType] or nil
	out.audio.codec = audioType and anames[audioType] or nil
	return out
end

-- ------------------------------------------------------------------------------------------------- playlists
local function resolve(base, ref)
	if string.match(ref, "^%a[%w+.-]*://") then
		return ref
	end
	local scheme, host = string.match(base, "^(%a[%w+.-]*://)([^/]+)")
	if not scheme then
		return ref
	end
	if string.sub(ref, 1, 2) == "//" then
		return string.match(scheme, "^(%a[%w+.-]*:)") .. ref
	elseif string.sub(ref, 1, 1) == "/" then
		return scheme .. host .. ref
	end
	local dir = string.match(string.gsub(base, "[?#].*$", ""), "^(.*/)") or (scheme .. host .. "/")
	return dir .. ref
end
Ts.resolve = resolve

function Ts.playlist(text, baseUrl)
	local pl = { variants = {}, segments = {}, duration = 0, ended = false }
	local pendingVariant, pendingDuration
	for line in string.gmatch(text .. "\n", "([^\r\n]*)\r?\n") do
		line = string.gsub(line, "^%s+", "")
		if line == "" then
			continue
		end
		if string.sub(line, 1, 1) == "#" then
			if string.sub(line, 1, 18) == "#EXT-X-STREAM-INF:" then
				local attrs = string.sub(line, 19)
				local v = { bandwidth = tonumber(string.match(attrs, "BANDWIDTH=(%d+)")) or 0 }
				local w, h = string.match(attrs, "RESOLUTION=(%d+)x(%d+)")
				v.width, v.height = tonumber(w), tonumber(h)
				pendingVariant = v
			elseif string.sub(line, 1, 8) == "#EXTINF:" then
				pendingDuration = tonumber(string.match(line, "^#EXTINF:%s*([%d%.]+)")) or 0
			elseif string.sub(line, 1, 14) == "#EXT-X-ENDLIST" then
				pl.ended = true
			elseif string.sub(line, 1, 21) == "#EXT-X-PLAYLIST-TYPE:" and string.find(line, "VOD", 1, true) then
				pl.ended = true
			end
		elseif pendingVariant then
			pendingVariant.url = resolve(baseUrl or "", line)
			table.insert(pl.variants, pendingVariant)
			pendingVariant = nil
		elseif pendingDuration then
			table.insert(pl.segments, { url = resolve(baseUrl or "", line), duration = pendingDuration, start = pl.duration })
			pl.duration += pendingDuration
			pendingDuration = nil
		end
	end
	return pl
end

function Ts.pickVariant(variants, lines)
	local best, smallest
	for _, v in ipairs(variants) do
		local l = (v.width and v.height) and math.min(v.width, v.height) or nil
		if l and l <= lines then
			local bl = best and math.min(best.width, best.height)
			if not best or l > bl or (l == bl and v.bandwidth > best.bandwidth) then
				best = v
			end
		end
		if not smallest or v.bandwidth < smallest.bandwidth then
			smallest = v
		end
	end
	return best or smallest
end

return Ts
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Webm</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- WebM / Matroska (EBML) demuxer: finds the first video and sound tracks and lists their frames (byte ranges and
-- times), in the same shape as Formats.Mp4, so the same import path reads both. Video: VP9 (codec "vp09"), VP8
-- ("vp08"), AV1 ("av01", av1C = CodecPrivate), H.264 ("avc1", with its avcC from CodecPrivate), H.265
-- ("hvc1", hvcC = CodecPrivate), MPEG-4 Part 2 ("mp4v", config: its VOL headers; also from an AVI-style V_MS/VFW/FOURCC track). Sound: Opus ("Opus", with a dOps-style setup
-- and the codec delay as `skip`), Vorbis ("vorbis", its three setup packets in `vorbisHeaders`), AAC ("mp4a", esds.asc)
-- and MP3 (".mp3"). Laced blocks are split into their frames. A file cut off part way keeps the frames that arrived.
--
--   local m = Webm.parse(bytes)               -- m.video, m.audio as Formats.Mp4.parse
--   Webm.isWebm(bytes)
--   local head = Webm.readHead(bytes, len)     -- the part before the first cluster (for streaming):
--       head = { segStart, timescale (ns per tick), duration (s), tracks = { video, audio }, cues = { { time (s),
--               pos (byte offset in the file) } ... } or nil, firstCluster (byte offset), headerEnd }
--   Webm.readClusters(bytes, from, to, head, fileOffset?) -> video samples, audio samples (the clusters in [from, to)
--       of a piece of the file that starts at fileOffset; sample pos are offsets in `bytes`, times in seconds from the
--       segment's start)
-- Streaming (Tools.Live.openWebm) - a stretch of the file from one keyframe to a later one, fetched by byte range:
--   local parts = Webm.planParts(head, cues, fileSize, minSeconds?)  -> { { start (s), a, b (byte range, inclusive) } }
--   local seg = Webm.packPart(body, a, head)   the clusters of body (the file's bytes a ..) -> a stream part (buffer):
--       its VP9 / VP8 frames and its sound packets, readable with Webm.unpackPart (the same shape as Formats.Ts.parse:
--       { video = { codec = "vp9" / "vp8", units = { { pts, data } } }, audio = { codec = "opus" / "vorbis", frames, dOps,
--       skip, vorbisHeaders, start } })
--   Webm.isPart(bytes)

local Webm = {}

local readu8 = buffer.readu8

local function fail(msg)
	error("WebM: " .. msg, 0)
end

local IDS = {
	EBML = 0x1A45DFA3,
	Segment = 0x18538067,
	SeekHead = 0x114D9B74,
	Info = 0x1549A966,
	TimecodeScale = 0x2AD7B1,
	Duration = 0x4489,
	Tracks = 0x1654AE6B,
	TrackEntry = 0xAE,
	TrackNumber = 0xD7,
	TrackType = 0x83,
	CodecID = 0x86,
	CodecPrivate = 0x63A2,
	CodecDelay = 0x56AA,
	DefaultDuration = 0x23E383,
	Video = 0xE0,
	PixelWidth = 0xB0,
	PixelHeight = 0xBA,
	Audio = 0xE1,
	SamplingFrequency = 0xB5,
	Channels = 0x9F,
	ContentEncodings = 0x6D80,
	Cues = 0x1C53BB6B,
	CuePoint = 0xBB,
	CueTime = 0xB3,
	CueTrackPositions = 0xB7,
	CueTrack = 0xF7,
	CueClusterPosition = 0xF1,
	Cluster = 0x1F43B675,
	Timecode = 0xE7,
	SimpleBlock = 0xA3,
	BlockGroup = 0xA0,
	Block = 0xA1,
	ReferenceBlock = 0xFB,
	Tags = 0x1254C367,
	Chapters = 0x1043A770,
	Attachments = 0x1941A469,
}
-- elements directly in the Segment (an unknown-size cluster ends where one of these starts)
local TOP = {
	[IDS.Cluster] = true, [IDS.Cues] = true, [IDS.Tags] = true, [IDS.Chapters] = true, [IDS.Attachments] = true,
	[IDS.Info] = true, [IDS.Tracks] = true, [IDS.SeekHead] = true,
}

function Webm.isWebm(bytes)
	local b = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	return buffer.len(b) >= 4 and buffer.readu32(b, 0) == 0xA3DF451A
end

-- an element ID at p (its marker bits kept) -> id, next position; nil past the end
local function readId(b, p, len)
	if p >= len then
		return nil
	end
	local c = readu8(b, p)
	local n = c >= 0x80 and 1 or (c >= 0x40 and 2 or (c >= 0x20 and 3 or (c >= 0x10 and 4 or 0)))
	if n == 0 then
		fail("broken data (an element ID)")
	end
	if p + n > len then
		return nil
	end
	local v = c
	for i = 1, n - 1 do
		v = v * 256 + readu8(b, p + i)
	end
	return v, p + n
end

-- an element size -> size (nil: unknown), next position
local function readSize(b, p, len)
	if p >= len then
		return false
	end
	local c = readu8(b, p)
	local n = 1
	local mask = 0x80
	while n <= 8 and bit32.band(c, mask) == 0 do
		n += 1
		mask //= 2
	end
	if n > 8 then
		fail("broken data (an element size)")
	end
	if p + n > len then
		return false
	end
	local v = bit32.band(c, mask - 1)
	local allOnes = v == mask - 1
	for i = 1, n - 1 do
		local x = readu8(b, p + i)
		if x ~= 255 then
			allOnes = false
		end
		v = v * 256 + x
	end
	if allOnes then
		return nil, p + n
	end
	return v, p + n
end

local function readUint(b, p, n)
	local v = 0
	for i = 0, n - 1 do
		v = v * 256 + readu8(b, p + i)
	end
	return v
end

local function readFloat(b, p, n)
	if n == 4 then
		local t = buffer.create(4)
		for i = 0, 3 do
			buffer.writeu8(t, i, readu8(b, p + 3 - i))
		end
		return buffer.readf32(t, 0)
	elseif n == 8 then
		local t = buffer.create(8)
		for i = 0, 7 do
			buffer.writeu8(t, i, readu8(b, p + 7 - i))
		end
		return buffer.readf64(t, 0)
	end
	return 0
end

-- children of [p, stop): fn(id, data start, data end (clipped), size or nil)
local function children(b, p, stop, fn)
	while p < stop do
		local id, q = readId(b, p, stop)
		if not id then
			return
		end
		local size, d = readSize(b, q, stop)
		if size == false then
			return
		end
		local e = size and math.min(d + size, stop) or stop
		if fn(id, d, e, size, p) == false then
			return
		end
		if not size then
			return
		end
		p = d + size
	end
end

local VIDEO_CODECS = { V_VP9 = "vp09", V_VP8 = "vp08", V_AV1 = "av01", ["V_MPEG4/ISO/AVC"] = "avc1", ["V_MPEGH/ISO/HEVC"] = "hvc1",
	V_THEORA = "theora", ["V_MPEG4/ISO/ASP"] = "mp4v" }
-- MPEG-4 Part 2 FourCCs of AVI-style tracks (upper case)
local VFW_MPEG4 = { XVID = true, XVIX = true, DIVX = true, DX50 = true, DX40 = true, FMP4 = true, MP4V = true, MP4S = true,
	M4S2 = true, ["3IV2"] = true, RMP4 = true, ZMP4 = true, SIPP = true, UMP4 = true, WV1F = true, BLZ0 = true, DXGM = true,
	EM4A = true, GEOV = true, SMP4 = true, LMP4 = true, DIGI = true, PVMM = true, SEDG = true, M4CC = true, ["3IVD"] = true,
	FFDS = true, FVFW = true, DM4V = true, DMK2 = true, HDX4 = true, MVXM = true, NDIG = true, QMP4 = true }

local function readTrack(b, p, e)
	local t = { number = 0, kind = 0, codecId = "" }
	children(b, p, e, function(id, d, q)
		if id == IDS.TrackNumber then
			t.number = readUint(b, d, q - d)
		elseif id == IDS.TrackType then
			t.kind = readUint(b, d, q - d)
		elseif id == IDS.CodecID then
			t.codecId = string.gsub(buffer.readstring(b, d, q - d), "%z+$", "")
		elseif id == IDS.CodecPrivate then
			local nb = buffer.create(q - d)
			buffer.copy(nb, 0, b, d, q - d)
			t.private = nb
		elseif id == IDS.CodecDelay then
			t.codecDelay = readUint(b, d, q - d)
		elseif id == IDS.DefaultDuration then
			t.defaultDuration = readUint(b, d, q - d)
		elseif id == IDS.ContentEncodings then
			t.encoded = true
		elseif id == IDS.Video then
			children(b, d, q, function(cid, cd, cq)
				if cid == IDS.PixelWidth then
					t.width = readUint(b, cd, cq - cd)
				elseif cid == IDS.PixelHeight then
					t.height = readUint(b, cd, cq - cd)
				end
				return nil
			end)
		elseif id == IDS.Audio then
			children(b, d, q, function(cid, cd, cq)
				if cid == IDS.SamplingFrequency then
					t.sampleRate = readFloat(b, cd, cq - cd)
				elseif cid == IDS.Channels then
					t.channels = readUint(b, cd, cq - cd)
				end
				return nil
			end)
		end
		return nil
	end)
	return t
end

-- Xiph lacing in CodecPrivate (Vorbis): count - 1, sizes of all but the last, then the packets
local function xiphPackets(priv)
	local n = readu8(priv, 0) + 1
	local p = 1
	local sizes = {}
	for i = 1, n - 1 do
		local s = 0
		repeat
			local c = readu8(priv, p)
			p += 1
			s += c
		until c < 255
		sizes[i] = s
	end
	local out = {}
	for i = 1, n do
		local s = sizes[i] or (buffer.len(priv) - p)
		local nb = buffer.create(s)
		buffer.copy(nb, 0, priv, p, s)
		out[i] = nb
		p += s
	end
	return out
end

-- an OpusHead -> the MP4 'dOps' layout Formats.Opus reads (big-endian fields, no magic)
local function opusHeadToDops(h)
	if buffer.len(h) < 19 or buffer.readstring(h, 0, 8) ~= "OpusHead" then
		return nil
	end
	local extra = buffer.len(h) - 19
	local d = buffer.create(11 + extra)
	buffer.writeu8(d, 0, 0)
	buffer.writeu8(d, 1, readu8(h, 9))
	local preSkip = buffer.readu16(h, 10)
	buffer.writeu8(d, 2, preSkip // 256)
	buffer.writeu8(d, 3, preSkip % 256)
	local rate = buffer.readu32(h, 12)
	for i = 0, 3 do
		buffer.writeu8(d, 4 + i, (rate // 256 ^ (3 - i)) % 256)
	end
	local gain = buffer.readu16(h, 16)
	buffer.writeu8(d, 8, gain // 256)
	buffer.writeu8(d, 9, gain % 256)
	buffer.writeu8(d, 10, readu8(h, 18))
	if extra > 0 then
		buffer.copy(d, 11, h, 19, extra)
	end
	return d, preSkip
end

-- the Cues element's payload [d, e) -> { { time (s), pos (file offset of the cluster) } ... } in time order
function Webm.readCues(bytes, d, e, segStart, timescale)
	local b = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	local cues = {}
	children(b, d, e, function(cid, cd, cq)
		if cid == IDS.CuePoint then
			local time, pos
			children(b, cd, cq, function(xid, xd, xq)
				if xid == IDS.CueTime then
					time = readUint(b, xd, xq - xd)
				elseif xid == IDS.CueTrackPositions then
					children(b, xd, xq, function(yid, yd, yq)
						if yid == IDS.CueClusterPosition then
							pos = pos or readUint(b, yd, yq - yd)
						end
						return nil
					end)
				end
				return nil
			end)
			if time and pos then
				table.insert(cues, { time = time * timescale / 1e9, pos = segStart + pos })
			end
		end
		return nil
	end)
	table.sort(cues, function(x, y)
		return x.time < y.time
	end)
	return cues
end

-- a Cues element at pos (as the SeekHead says) inside a piece of the file starting at fileOffset -> the cue list
function Webm.readCuesAt(bytes, pos, segStart, timescale, fileOffset)
	local b = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	local p = pos - (fileOffset or 0)
	local id, q = readId(b, p, buffer.len(b))
	if id ~= IDS.Cues then
		fail("the cue list is not where the file says")
	end
	local size, d = readSize(b, q, buffer.len(b))
	if not size then
		fail("the cue list is cut off")
	end
	return Webm.readCues(b, d, math.min(d + size, buffer.len(b)), segStart, timescale)
end

function Webm.readHead(bytes, len)
	local b = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	len = len or buffer.len(b)
	if not Webm.isWebm(b) then
		fail("not a WebM / Matroska file")
	end
	local head = { timescale = 1000000, duration = 0 }
	children(b, 0, len, function(id, d, e)
		if id == IDS.Segment then
			head.segStart = d
			head.segEnd = e
			head.segEndFile = size and d + size or nil
			return false
		end
		return nil
	end)
	if not head.segStart then
		fail("no Segment found: the file is cut off or not a complete WebM")
	end
	local tracks = {}
	local durationTicks
	children(b, head.segStart, head.segEnd, function(id, d, e, size, start)
		if id == IDS.Info then
			children(b, d, e, function(cid, cd, cq)
				if cid == IDS.TimecodeScale then
					head.timescale = readUint(b, cd, cq - cd)
				elseif cid == IDS.Duration then
					durationTicks = readFloat(b, cd, cq - cd)
				end
				return nil
			end)
		elseif id == IDS.Tracks then
			children(b, d, e, function(cid, cd, cq)
				if cid == IDS.TrackEntry then
					table.insert(tracks, readTrack(b, cd, cq))
				end
				return nil
			end)
		elseif id == IDS.Cues and size then
			head.cues = Webm.readCues(b, d, e, head.segStart, head.timescale)
		elseif id == IDS.SeekHead then
			-- where the Cues are (often after the clusters)
			children(b, d, e, function(cid, cd, cq)
				if cid == 0x4DBB then -- Seek
					local sid, spos
					children(b, cd, cq, function(xid, xd, xq)
						if xid == 0x53AB then
							sid = readUint(b, xd, xq - xd)
						elseif xid == 0x53AC then
							spos = readUint(b, xd, xq - xd)
						end
						return nil
					end)
					if sid == IDS.Cues and spos then
						head.cuesPos = head.segStart + spos
					end
				end
				return nil
			end)
		elseif id == IDS.Cluster then
			head.firstCluster = start
			return false
		end
		return nil
	end)
	for _, t in ipairs(tracks) do
		if t.kind == 1 and not head.video then
			head.video = t
		elseif t.kind == 2 and not head.audio then
			head.audio = t
		end
	end
	head.tracks = tracks
	local ts = head.timescale
	if durationTicks then
		head.duration = durationTicks * ts / 1e9
	end
	return head
end

-- the frames of one block (lacing split) -> list of { pos, size }
local function blockFrames(b, p, e, lacing)
	if lacing == 0 then
		return { { p, e - p } }
	end
	local count = readu8(b, p) + 1
	p += 1
	local sizes = table.create(count, 0)
	if lacing == 1 then -- Xiph
		for i = 1, count - 1 do
			local s = 0
			repeat
				local c = readu8(b, p)
				p += 1
				s += c
			until c < 255
			sizes[i] = s
		end
	elseif lacing == 3 then -- EBML: first size, then signed differences
		local first, q = readSize(b, p, e)
		if not first then
			fail("broken data (lacing)")
		end
		p = q
		sizes[1] = first
		for i = 2, count - 1 do
			local raw, q2 = readSize(b, p, e)
			if raw == false or raw == nil then
				fail("broken data (lacing)")
			end
			local n = q2 - p
			local bias = 2 ^ (7 * n - 1) - 1
			sizes[i] = sizes[i - 1] + (raw - bias)
			p = q2
		end
	else -- fixed
		local each = (e - p) // count
		for i = 1, count do
			sizes[i] = each
		end
	end
	local used = 0
	for i = 1, count - 1 do
		used += sizes[i]
	end
	sizes[count] = (e - p) - used
	local out = table.create(count)
	for i = 1, count do
		out[i] = { p, sizes[i] }
		p += sizes[i]
	end
	return out
end

local function isVp9Key(b, p, size)
	if size < 1 then
		return false
	end
	local c = readu8(b, p)
	if bit32.rshift(c, 6) ~= 2 then
		return false
	end
	local profile = bit32.band(bit32.rshift(c, 5), 1) + 2 * bit32.band(bit32.rshift(c, 4), 1)
	local bit = 3
	if profile == 3 then
		bit = 2
	end
	-- show_existing_frame, then frame_type (0 = key)
	if bit32.band(bit32.rshift(c, bit), 1) == 1 then
		return false
	end
	return bit32.band(bit32.rshift(c, bit - 1), 1) == 0
end

-- a VP8 frame's tag: bit 0 clear on a key frame
local function isVp8Key(b, p, size)
	return size >= 3 and bit32.band(readu8(b, p), 1) == 0
end

function Webm.readClusters(bytes, from, to, head, fileOffset)
	local b = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	fileOffset = fileOffset or 0
	local vt, at = head.video, head.audio
	local vnum, anum = vt and vt.number, at and at.number
	local ts = head.timescale / 1e9
	local vsamples, asamples = {}, {}
	local vp9 = vt and vt.codecId == "V_VP9"
	local vp8 = vt and vt.codecId == "V_VP8"
	local function block(p, e, clusterTime, isSimple, refFound)
		local tn, q = readSize(b, p, e)
		if not tn or q + 3 > e then
			return
		end
		local rel = readu8(b, q) * 256 + readu8(b, q + 1)
		if rel >= 32768 then
			rel -= 65536
		end
		local flags = readu8(b, q + 2)
		local lacing = bit32.band(bit32.rshift(flags, 1), 3)
		local time = (clusterTime + rel) * ts
		local key = isSimple and bit32.band(flags, 0x80) ~= 0 or (not isSimple and not refFound)
		if tn == vnum then
			for _, f in ipairs(blockFrames(b, q + 3, e, lacing)) do
				local sync = key
				if vp9 then
					sync = isVp9Key(b, f[1], f[2])
				elseif vp8 then
					sync = isVp8Key(b, f[1], f[2])
				end
				table.insert(vsamples, { pos = f[1], size = f[2], pts = time, dts = time, sync = sync })
			end
		elseif tn == anum then
			local frames = blockFrames(b, q + 3, e, lacing)
			for _, f in ipairs(frames) do
				table.insert(asamples, { pos = f[1], size = f[2], pts = time, dts = time, sync = true })
			end
		end
	end
	local len = math.min(to, buffer.len(b))
	local p = from
	while p < len do
		local id, q = readId(b, p, len)
		if not id then
			break
		end
		local size, d = readSize(b, q, len)
		if size == false then
			break
		end
		if id ~= IDS.Cluster then
			if not size then
				break
			end
			p = d + size
			continue
		end
		local cut = size and d + size > len
		local stop = size and math.min(d + size, len) or len
		local clusterTime = 0
		local cp = d
		while cp < stop do
			local cid, cq = readId(b, cp, stop)
			if not cid then
				break
			end
			if not size and TOP[cid] then
				break -- (an unknown-size cluster ends here)
			end
			local csize, cd = readSize(b, cq, stop)
			if csize == false or csize == nil then
				break
			end
			local ce = cd + csize
			if ce > stop then
				-- the file ends inside this block: the frame is incomplete
				if cid == IDS.SimpleBlock or cid == IDS.BlockGroup then
					local n = #vsamples
					block(cd, stop, clusterTime, cid == IDS.SimpleBlock, false)
					for i = n + 1, #vsamples do
						vsamples[i].cut = true
					end
				end
				break
			end
			if cid == IDS.Timecode then
				clusterTime = readUint(b, cd, csize)
			elseif cid == IDS.SimpleBlock then
				block(cd, ce, clusterTime, true, false)
			elseif cid == IDS.BlockGroup then
				local bp, be, ref = nil, nil, false
				children(b, cd, ce, function(xid, xd, xq)
					if xid == IDS.Block then
						bp, be = xd, xq
					elseif xid == IDS.ReferenceBlock then
						ref = true
					end
					return nil
				end)
				if bp then
					block(bp, be, clusterTime, false, ref)
				end
			end
			cp = ce
		end
		if cut or not size then
			p = cp
			if cut then
				break
			end
		else
			p = d + size
		end
	end
	if fileOffset ~= 0 then
		for _, s in ipairs(vsamples) do
			s.filePos = s.pos + fileOffset
		end
	end
	return vsamples, asamples
end

-- a track's description in Formats.Mp4's shape
local function videoInfo(t)
	local v = { codec = VIDEO_CODECS[t.codecId] or t.codecId, codecId = t.codecId, width = t.width, height = t.height }
	if v.codec == "mp4v" then
		v.config = t.private -- (MPEG-4 Part 2: its VOL headers)
	elseif t.codecId == "V_MS/VFW/FOURCC" and t.private and buffer.len(t.private) >= 40 then
		-- (an AVI-style track: a BITMAPINFOHEADER, then the codec's setup)
		local fourcc = buffer.readstring(t.private, 16, 4)
		if VFW_MPEG4[string.upper(fourcc)] then
			v.codec, v.fourcc = "mp4v", fourcc
			if buffer.len(t.private) > 40 then
				v.config = buffer.create(buffer.len(t.private) - 40)
				buffer.copy(v.config, 0, t.private, 40)
			end
		else
			v.codec = fourcc
		end
	end
	if v.codec == "avc1" and t.private and buffer.len(t.private) >= 7 then
		local b = t.private
		local cfg = { nalLength = bit32.band(readu8(b, 4), 3) + 1, sps = {}, pps = {}, profile = readu8(b, 1), level = readu8(b, 3) }
		local c = 5
		local ns = bit32.band(readu8(b, c), 31)
		c += 1
		for _ = 1, ns do
			local l = readu8(b, c) * 256 + readu8(b, c + 1)
			local nb = buffer.create(l)
			buffer.copy(nb, 0, b, c + 2, l)
			table.insert(cfg.sps, nb)
			c += 2 + l
		end
		local np = readu8(b, c)
		c += 1
		for _ = 1, np do
			local l = readu8(b, c) * 256 + readu8(b, c + 1)
			local nb = buffer.create(l)
			buffer.copy(nb, 0, b, c + 2, l)
			table.insert(cfg.pps, nb)
			c += 2 + l
		end
		v.avcC = cfg
	end
	if v.codec == "hvc1" and t.private then
		v.hvcC = t.private
	end
	if v.codec == "av01" and t.private then
		v.av1C = t.private
	end
	return v
end
Webm.videoInfo = videoInfo

local function audioInfo(t)
	local a = { codecId = t.codecId, channels = t.channels or 2, sampleRate = t.sampleRate or 48000 }
	local id = t.codecId
	if id == "A_OPUS" then
		a.codec = "Opus"
		local preSkip
		if t.private then
			a.dOps, preSkip = opusHeadToDops(t.private)
		end
		if t.codecDelay and t.codecDelay > 0 then
			a.skip = math.floor(t.codecDelay * 48000 / 1e9 + 0.5)
		else
			a.skip = preSkip
		end
	elseif id == "A_VORBIS" then
		a.codec = "vorbis"
		if t.private then
			a.vorbisHeaders = xiphPackets(t.private)
		end
	elseif id == "A_AAC" or string.sub(id, 1, 6) == "A_AAC/" then
		a.codec = "mp4a"
		a.esds = { oti = 0x40, asc = t.private }
	elseif id == "A_MPEG/L3" then
		a.codec = ".mp3"
	elseif id == "A_FLAC" then
		a.codec = "fLaC"
		a.flacHeader = t.private -- ("fLaC" and the metadata blocks)
	elseif id == "A_AC3" then
		a.codec = "ac-3"
	elseif id == "A_EAC3" then
		a.codec = "ec-3"
	else
		a.codec = id
	end
	return a
end
Webm.audioInfo = audioInfo

function Webm.parse(bytes)
	local b = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	local len = buffer.len(b)
	local head = Webm.readHead(b, len)
	if not head.video and not head.audio then
		fail("the file has no video or sound track")
	end
	for _, t in ipairs({ head.video, head.audio }) do
		if t and t.encoded then
			fail("the file's tracks are compressed or encrypted (ContentEncoding), which isn't supported")
		end
	end
	if not head.firstCluster then
		fail("the file has no frames (no clusters)")
	end
	local vs, as = Webm.readClusters(b, head.firstCluster, len, head)
	local out = {}
	if head.audio then
		local a = audioInfo(head.audio)
		if #as > 0 then
			local t0 = as[1].pts
			for _, s in ipairs(as) do
				s.pts -= t0
				s.dts = s.pts
			end
			a.samples = as
			a.duration = head.duration
			out.audio = a
		end
	end
	if head.video then
		local v = videoInfo(head.video)
		if #vs == 0 then
			fail("the video track has no frames")
		end
		local t0 = math.huge
		for _, s in ipairs(vs) do
			t0 = math.min(t0, s.pts)
		end
		for _, s in ipairs(vs) do
			s.pts -= t0
			s.dts = s.pts
		end
		v.samples = vs
		v.duration = head.duration
		if v.duration <= 0 and #vs > 1 then
			local last = vs[#vs].pts
			v.duration = last + last / (#vs - 1)
		end
		out.video = v
	end
	out.head = head
	return out
end

-- stream parts: from each cue (a cluster that starts with a key frame) to a later one, at least minSeconds long
function Webm.planParts(head, cues, fileSize, minSeconds)
	minSeconds = minSeconds or 2
	local list = {}
	for _, c in ipairs(cues) do
		if #list == 0 or c.pos > list[#list].pos then
			table.insert(list, c)
		end
	end
	local stop = math.min(fileSize, head.segEndFile or fileSize)
	local parts = {}
	local i = 1
	while i <= #list do
		local j = i + 1
		while list[j] and list[j].time - list[i].time < minSeconds do
			j += 1
		end
		local b = list[j] and (list[j].pos - 1) or (stop - 1)
		table.insert(parts, { start = list[i].time, a = list[i].pos, b = b })
		i = j
	end
	return parts
end

local MAGIC = "VPS1" -- (a part of a VP9 video)
local MAGIC8 = "VPS8" -- (a part of a VP8 video)
function Webm.isPart(bytes)
	if buffer.len(bytes) < 4 then
		return false
	end
	local m = buffer.readstring(bytes, 0, 4)
	return m == MAGIC or m == MAGIC8
end

-- Opus samples (48 kHz) in one packet, from its TOC byte
local function opusSamples(b, p, size)
	if size < 1 then
		return 0
	end
	local toc = readu8(b, p)
	local config = bit32.rshift(toc, 3)
	local ms
	if config < 12 then
		ms = ({ 10, 20, 40, 60 })[config % 4 + 1]
	elseif config < 16 then
		ms = ({ 10, 20 })[config % 2 + 1]
	else
		ms = ({ 2.5, 5, 10, 20 })[config % 4 + 1]
	end
	local c = bit32.band(toc, 3)
	local count = c == 0 and 1 or (c == 3 and (size > 1 and bit32.band(readu8(b, p + 1), 63) or 0) or 2)
	return math.floor(48 * ms * count + 0.5)
end
Webm.opusSamples = opusSamples

function Webm.packPart(body, a, head)
	local b = type(body) == "string" and buffer.fromstring(body) or body
	local vs, as = Webm.readClusters(b, 0, buffer.len(b), head, a)
	local at = head.audio and audioInfo(head.audio)
	local useAudio = at and (at.codec == "Opus" or at.codec == "vorbis") and #as > 0
	local size = 64
	for _, s in ipairs(vs) do
		size += 12 + s.size
	end
	if useAudio then
		for _, s in ipairs(as) do
			size += 12 + s.size
		end
		size += at.dOps and buffer.len(at.dOps) or 0
		for _, h in ipairs(at.vorbisHeaders or {}) do
			size += 4 + buffer.len(h)
		end
	end
	local out = buffer.create(size)
	local o = 0
	local function u8(v)
		buffer.writeu8(out, o, v)
		o += 1
	end
	local function u32(v)
		buffer.writeu32(out, o, v)
		o += 4
	end
	local function f64(v)
		buffer.writef64(out, o, v)
		o += 8
	end
	local function bytes(src, p, n)
		buffer.copy(out, o, src, p, n)
		o += n
	end
	buffer.writestring(out, 0, head.video and head.video.codecId == "V_VP8" and MAGIC8 or MAGIC)
	o = 4
	u32(#vs)
	for _, s in ipairs(vs) do
		f64(s.pts)
		u32(s.size)
		bytes(b, s.pos, s.size)
	end
	if not useAudio then
		u8(0)
	else
		u8(at.codec == "Opus" and 1 or 2)
		if at.codec == "Opus" then
			local d = at.dOps
			u32(d and buffer.len(d) or 0)
			if d then
				bytes(d, 0, buffer.len(d))
			end
			-- (each part starts a fresh decoder: its start-up delay is dropped)
			local preSkip = d and (readu8(d, 2) * 256 + readu8(d, 3)) or 312
			u32(preSkip)
		else
			u8(#at.vorbisHeaders)
			for _, h in ipairs(at.vorbisHeaders) do
				u32(buffer.len(h))
				bytes(h, 0, buffer.len(h))
			end
		end
		u32(#as)
		for _, s in ipairs(as) do
			f64(s.pts)
			u32(s.size)
			bytes(b, s.pos, s.size)
		end
	end
	local r = buffer.create(o)
	buffer.copy(r, 0, out, 0, o)
	return r
end

function Webm.unpackPart(bytes)
	local b = bytes
	if not Webm.isPart(b) then
		fail("not a stream part")
	end
	local o = 4
	local function u8()
		local v = readu8(b, o)
		o += 1
		return v
	end
	local function u32()
		local v = buffer.readu32(b, o)
		o += 4
		return v
	end
	local function f64()
		local v = buffer.readf64(b, o)
		o += 8
		return v
	end
	local function take(n)
		local nb = buffer.create(n)
		buffer.copy(nb, 0, b, o, n)
		o += n
		return nb
	end
	local units = {}
	for i = 1, u32() do
		local pts = f64()
		units[i] = { pts = pts, data = take(u32()) }
	end
	local out = { video = { codec = buffer.readstring(b, 0, 4) == MAGIC8 and "vp8" or "vp9", units = units }, audio = {} }
	local kind = u8()
	if kind ~= 0 then
		local a = out.audio
		if kind == 1 then
			a.codec = "opus"
			local n = u32()
			a.dOps = n > 0 and take(n) or nil
			a.skip = u32()
		else
			a.codec = "vorbis"
			a.vorbisHeaders = {}
			for i = 1, u8() do
				a.vorbisHeaders[i] = take(u32())
			end
		end
		a.frames = {}
		for i = 1, u32() do
			local pts = f64()
			a.frames[i] = { pts = pts, data = take(u32()) }
		end
		a.start = a.frames[1] and a.frames[1].pts
	end
	return out
end

return Webm
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Mpg</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- MPEG program streams (.mpg / .mpeg / .vob, MPEG-1 system streams), transport stream files (.ts / .m2ts / .mts) and
-- MPEG video elementary streams (.m1v / .m2v): the video as frames to decode, and the sound's elementary stream.
--
--   Mpg.isMpg(bytes) -> true for any of these
--   local m = Mpg.parse(bytes)
--   m.container = "MPEG-PS" | "MPEG-TS" | "MPEG video"
--   m.video = { codec = "mpgv" (MPEG-1 / MPEG-2: Video.Mpeg2), "avc1" (H.264) or "hvc1" (H.265; both annexB = true,
--               from transport streams), data = buffer (the
--               elementary stream), samples = { { pos, size, pts, sync } ... } in decode order (pts: seconds from the
--               first frame shown; a field pair is one sample), duration, width, height (the picture's shape: wide
--               pictures are widened), mpeg2, fps }
--   m.audio = { codec = "mpga" (MPEG audio: MP1 / MP2 / MP3) | "ac-3" | "aac" (ADTS) | "lpcm", data = buffer (the
--               elementary stream; "lpcm": 16-bit big-endian samples), sampleRate, channels (lpcm), start (seconds
--               from the first frame shown to the sound's first sample; negative: the sound starts earlier) } or nil
--   m.otherVideo = the name of a video codec found that isn't read (transport streams), or nil
--   (frames before the first key frame, and the B frames right after it that lean on a picture before it, are left out)

local Mpg = {}

local readu8, band, rshift = buffer.readu8, bit32.band, bit32.rshift

local function isStartCode(b, p, code)
	return readu8(b, p) == 0 and readu8(b, p + 1) == 0 and readu8(b, p + 2) == 1 and (code == nil or readu8(b, p + 3) == code)
end

-- transport stream packet size (188, or 192 for .m2ts / .mts) and the first packet's offset, or nil
local function tsLayout(b)
	local n = buffer.len(b)
	for _, size in ipairs({ 188, 192 }) do
		local lead = size - 188
		if n >= lead + 3 * size and readu8(b, lead) == 0x47 and readu8(b, lead + size) == 0x47 and readu8(b, lead + 2 * size) == 0x47 then
			return size, lead
		end
	end
	return nil
end

function Mpg.isMpg(b)
	local n = buffer.len(b)
	if n < 8 then
		return false
	end
	if isStartCode(b, 0, 0xBA) or isStartCode(b, 0, 0xB3) then
		return true
	end
	return tsLayout(b) ~= nil
end

-- 33-bit PTS at p -> seconds
local function readTime(b, p)
	local a = readu8(b, p)
	local v = band(rshift(a, 1), 7) * 1073741824
	v += readu8(b, p + 1) * 4194304 + rshift(readu8(b, p + 2), 1) * 32768
	v += readu8(b, p + 3) * 128 + rshift(readu8(b, p + 4), 1)
	return v / 90000
end

-- an elementary stream gathered from packets: parts { pos, len } of the file, payload times { esOffset, pts }
local function newStream(kind)
	return { kind = kind, parts = {}, size = 0, times = {} }
end
local function addPart(st, b, pos, len, pts)
	if len <= 0 then
		return
	end
	if pts then
		table.insert(st.times, { st.size, pts })
	end
	table.insert(st.parts, { pos, len })
	st.size += len
end
local function gather(st, b)
	local data = buffer.create(math.max(st.size, 1))
	local o = 0
	for _, part in ipairs(st.parts) do
		buffer.copy(data, o, b, part[1], part[2])
		o += part[2]
	end
	return data
end

---------------------------------------------------------------------------------------------------------------------------
-- MPEG-1 / MPEG-2 video: pictures -> frames, display order, times

local FRAME_RATES = { 24000 / 1001, 24, 25, 30000 / 1001, 30, 50, 60000 / 1001, 60 }
-- MPEG-1 pixel shapes (height / width of a pixel) by aspect code
local MPEG1_PEL = { 1.0, 0.6735, 0.7031, 0.7615, 0.8055, 0.8437, 0.8935, 0.9157, 0.9815, 1.0255, 1.0695, 1.0950, 1.1575, 1.2015 }

local function mpegVideo(es, times)
	local n = buffer.len(es)
	local info = { width = 0, height = 0, fps = 25, mpeg2 = false, progressive = true, aspect = 1 }
	local pics = {}
	local headerStart = nil
	local gopClosed, gopBroken, newGop = false, false, false
	local cur = nil
	local p = 0
	while p + 3 < n do
		local c2 = readu8(es, p + 2)
		if c2 > 1 then
			p += 3
			continue
		elseif c2 == 0 or readu8(es, p + 1) ~= 0 or readu8(es, p) ~= 0 then
			p += 1
			continue
		end
		local code = p + 3 < n and readu8(es, p + 3) or 0
		if code == 0xB3 and p + 11 < n then
			info.width = readu8(es, p + 4) * 16 + rshift(readu8(es, p + 5), 4)
			info.height = band(readu8(es, p + 5), 15) * 256 + readu8(es, p + 6)
			info.aspect = rshift(readu8(es, p + 7), 4)
			info.rate = band(readu8(es, p + 7), 15)
			info.fps = FRAME_RATES[info.rate] or info.fps
			headerStart = headerStart or p
		elseif code == 0xB8 and p + 7 < n then
			gopClosed = band(readu8(es, p + 7), 0x40) ~= 0
			gopBroken = band(readu8(es, p + 7), 0x20) ~= 0
			newGop = true
			headerStart = headerStart or p
		elseif code == 0xB5 and p + 9 < n then
			local id = rshift(readu8(es, p + 4), 4)
			if id == 1 then
				info.mpeg2 = true
				info.progressive = band(readu8(es, p + 5), 0x08) ~= 0
				local hx = band(readu8(es, p + 5), 1) * 2 + rshift(readu8(es, p + 6), 7)
				local vx = band(rshift(readu8(es, p + 6), 5), 3)
				info.width = band(info.width, 0xFFF) + hx * 4096
				info.height = band(info.height, 0xFFF) + vx * 4096
				local en = band(rshift(readu8(es, p + 9), 5), 3)
				local ed = band(readu8(es, p + 9), 31)
				info.fps = (FRAME_RATES[info.rate or 3] or 25) * (en + 1) / (ed + 1)
			elseif id == 8 and cur then
				local b6, b7, b8 = readu8(es, p + 6), readu8(es, p + 7), readu8(es, p + 8)
				cur.structure = band(b6, 3)
				cur.tff = band(b7, 0x80) ~= 0
				cur.rff = band(b7, 0x02) ~= 0
				cur.progressiveFrame = band(b8, 0x80) ~= 0
			end
		elseif code == 0x00 and p + 5 < n then
			cur = { pos = p, start = headerStart or p, type = band(rshift(readu8(es, p + 5), 3), 7), structure = 3, tff = true,
				rff = false, progressiveFrame = true, newGop = newGop, closed = gopClosed, broken = gopBroken }
			table.insert(pics, cur)
			headerStart = nil
			newGop = false
		end
		p += 4
	end
	-- frames: a frame picture, or two field pictures
	local frames = {}
	local i = 1
	while i <= #pics do
		local pic = pics[i]
		local f = { pos = pic.start, pic = pic }
		local nx = pics[i + 1]
		if pic.structure ~= 3 and nx and nx.structure ~= 3 and nx.structure ~= pic.structure and nx.start == nx.pos then
			i += 2
		else
			i += 1
		end
		table.insert(frames, f)
	end
	for k, f in ipairs(frames) do
		local stop = frames[k + 1] and frames[k + 1].pos or n
		f.size = stop - f.pos
	end
	-- the frame shown first after the first key frame, and B frames that lean on pictures before a key frame
	local kept = {}
	local seenI, dropB = false, false
	for _, f in ipairs(frames) do
		local t = f.pic.type
		if t == 1 then
			dropB = (not seenI and not (f.pic.newGop and f.pic.closed)) or f.pic.broken
			seenI = true
			table.insert(kept, f)
		elseif seenI then
			if t == 3 then
				if not dropB then
					table.insert(kept, f)
				end
			elseif t == 2 then
				dropB = false
				table.insert(kept, f)
			end
		end
	end
	-- display order (a B frame shows at once; an I / P frame when the next one arrives) and times: a frame lasts two
	-- fields, three with repeat_first_field (a progressive sequence: two or three frames)
	local order = {}
	local held = nil
	for _, f in ipairs(kept) do
		if f.pic.type == 3 then
			table.insert(order, f)
		else
			if held then
				table.insert(order, held)
			end
			held = f
		end
	end
	if held then
		table.insert(order, held)
	end
	local t = 0
	for _, f in ipairs(order) do
		f.pts = t
		local fields = 2
		if f.pic.rff then
			if info.mpeg2 and info.progressive then
				fields = f.pic.tff and 6 or 4
			elseif f.pic.structure == 3 then
				fields = 3
			end
		end
		t += fields / (2 * info.fps)
	end
	-- the time of the first frame shown, from a packet time (it belongs to the first picture starting in that packet)
	local t0 = nil
	if times and #times > 0 then
		local ti = 1
		for _, pic in ipairs(pics) do
			while times[ti + 1] and times[ti + 1][1] <= pic.pos do
				ti += 1
			end
			local tm = times[ti]
			if tm and tm[1] <= pic.pos and not tm.used then
				tm.used = true
				pic.time = tm[2]
			end
		end
		for _, f in ipairs(kept) do
			if f.pic.time then
				t0 = f.pic.time - f.pts
				break
			end
		end
	end
	local samples = table.create(#kept)
	for k, f in ipairs(kept) do
		samples[k] = { pos = f.pos, size = f.size, pts = f.pts, sync = f.pic.type == 1 }
	end
	-- the picture's shape
	local w, h = info.width, info.height
	local shownW = w
	if info.mpeg2 then
		local dar = ({ [2] = 4 / 3, [3] = 16 / 9, [4] = 2.21 })[info.aspect]
		if dar then
			shownW = math.floor(h * dar / 2 + 0.5) * 2
		end
	else
		local pel = MPEG1_PEL[info.aspect]
		if pel and pel ~= 1 then
			shownW = math.floor(w / pel / 2 + 0.5) * 2
		end
	end
	return {
		codec = "mpgv", data = es, samples = samples, duration = t, width = shownW, height = h, pixelWidth = w,
		mpeg2 = info.mpeg2, fps = info.fps,
	}, t0
end

-- H.264 / H.265 access units (one per timed packet): samples in decode order
local function h264Video(st, es, hevc)
	local times = st.times
	local samples = {}
	local base = math.huge
	for k, tm in ipairs(times) do
		local stop = times[k + 1] and times[k + 1][1] or buffer.len(es)
		if stop > tm[1] then
			-- (an IDR slice anywhere in the unit; H.265: an IRAP picture - IDR, CRA or BLA)
			local sync = false
			local p = tm[1]
			while p + 3 < stop do
				if readu8(es, p) == 0 and readu8(es, p + 1) == 0 and readu8(es, p + 2) == 1 then
					if hevc then
						local nt = band(rshift(readu8(es, p + 3), 1), 63)
						if nt >= 16 and nt <= 21 then
							sync = true
							break
						elseif nt <= 9 then
							break
						end
					else
						local nt = band(readu8(es, p + 3), 31)
						if nt == 5 then
							sync = true
							break
						elseif nt == 1 then
							break
						end
					end
					p += 3
				else
					p += 1
				end
			end
			table.insert(samples, { pos = tm[1], size = stop - tm[1], pts = tm[2], sync = sync })
			base = math.min(base, tm[2])
		end
	end
	-- (from the first key frame)
	local first = 1
	while first <= #samples and not samples[first].sync do
		first += 1
	end
	local kept = {}
	for k = first, #samples do
		table.insert(kept, samples[k])
	end
	base = math.huge
	for _, s in ipairs(kept) do
		base = math.min(base, s.pts)
	end
	local last, dur = 0, 0
	for _, s in ipairs(kept) do
		s.pts -= base
		last = math.max(last, s.pts)
	end
	if #kept > 1 then
		dur = last + last / (#kept - 1)
	end
	return { codec = hevc and "hvc1" or "avc1", annexB = true, data = es, samples = kept, duration = dur }, base
end

---------------------------------------------------------------------------------------------------------------------------
-- containers

local function parsePs(b)
	local n = buffer.len(b)
	local video = nil
	local audios = {} -- key -> stream
	local p = 0
	while p + 4 <= n do
		if not isStartCode(b, p) or readu8(b, p + 3) < 0xB9 then
			-- (resynchronise at the next pack or packet)
			p += 1
			while p + 4 <= n and not (isStartCode(b, p) and readu8(b, p + 3) >= 0xB9) do
				p += 1
			end
			continue
		end
		local code = readu8(b, p + 3)
		if code == 0xBA then
			if p + 14 > n then
				break
			end
			if band(readu8(b, p + 4), 0xC0) == 0x40 then
				p += 14 + band(readu8(b, p + 13), 7)
			else
				p += 12
			end
		elseif code == 0xB9 then
			p += 4
		else
			if p + 6 > n then
				break
			end
			local len = readu8(b, p + 4) * 256 + readu8(b, p + 5)
			local q, stop = p + 6, math.min(p + 6 + len, n)
			local isVideo = code >= 0xE0 and code <= 0xEF
			local isAudio = code >= 0xC0 and code <= 0xDF
			if (isVideo or isAudio or code == 0xBD) and q < stop then
				local pts = nil
				if band(readu8(b, q), 0xC0) == 0x80 then
					local flags, hlen = readu8(b, q + 1), readu8(b, q + 2)
					if band(flags, 0x80) ~= 0 then
						pts = readTime(b, q + 3)
					end
					q += 3 + hlen
				else
					while q < stop and readu8(b, q) == 0xFF do
						q += 1
					end
					if q < stop and band(readu8(b, q), 0xC0) == 0x40 then
						q += 2
					end
					if q < stop then
						local c = band(readu8(b, q), 0xF0)
						if c == 0x20 then
							pts = readTime(b, q)
							q += 5
						elseif c == 0x30 then
							pts = readTime(b, q)
							q += 10
						else
							q += 1
						end
					end
				end
				if isVideo then
					video = video or newStream(code)
					if video.kind == code then
						addPart(video, b, q, stop - q, pts)
					end
				elseif isAudio then
					local st = audios[code] or newStream("mpga")
					audios[code] = st
					addPart(st, b, q, stop - q, pts)
				elseif q < stop then
					local sub = readu8(b, q)
					if sub >= 0x80 and sub <= 0x87 then
						local st = audios[0x100 + sub] or newStream("ac-3")
						audios[0x100 + sub] = st
						addPart(st, b, q + 4, stop - q - 4, pts)
					elseif sub >= 0xA0 and sub <= 0xA7 and q + 7 <= stop then
						local st = audios[0x100 + sub] or newStream("lpcm")
						audios[0x100 + sub] = st
						local fmt = readu8(b, q + 5)
						st.bits = ({ 16, 20, 24 })[rshift(fmt, 6) + 1] or 16
						st.sampleRate = band(rshift(fmt, 4), 3) == 1 and 96000 or 48000
						st.channels = band(fmt, 7) + 1
						addPart(st, b, q + 7, stop - q - 7, pts)
					end
				end
			end
			p += 6 + len
		end
	end
	return video, audios
end

local function parseTs(b)
	local n = buffer.len(b)
	local size, lead = tsLayout(b)
	local pmtPid, videoPid, audioPid, videoType, audioType
	local video, audio, other
	local open = {} -- pid -> stream receiving the current packet's payload
	for p = lead, n - 188, size do
		if readu8(b, p) ~= 0x47 then
			continue
		end
		local b1, b2, b3 = readu8(b, p + 1), readu8(b, p + 2), readu8(b, p + 3)
		local unitStart = band(b1, 0x40) ~= 0
		local pid = band(b1, 0x1F) * 256 + b2
		local afc = band(rshift(b3, 4), 3)
		local q = p + 4
		local stop = p + 188
		if afc == 2 or afc == 3 then
			q += 1 + readu8(b, q)
		end
		if afc == 2 or afc == 0 or q >= stop then
			continue
		end
		if pid == 0 and not pmtPid then
			if unitStart then
				q += 1 + readu8(b, q)
			end
			local secLen = band(readu8(b, q + 1), 15) * 256 + readu8(b, q + 2)
			local e = math.min(q + 3 + secLen - 4, stop)
			local r = q + 8
			while r + 4 <= e do
				local prog = readu8(b, r) * 256 + readu8(b, r + 1)
				if prog ~= 0 then
					pmtPid = band(readu8(b, r + 2), 0x1F) * 256 + readu8(b, r + 3)
					break
				end
				r += 4
			end
		elseif pid == pmtPid and not videoPid then
			if unitStart then
				q += 1 + readu8(b, q)
			end
			local secLen = band(readu8(b, q + 1), 15) * 256 + readu8(b, q + 2)
			local e = math.min(q + 3 + secLen - 4, stop)
			local infoLen = band(readu8(b, q + 10), 15) * 256 + readu8(b, q + 11)
			local r = q + 12 + infoLen
			while r + 5 <= e do
				local st = readu8(b, r)
				local epid = band(readu8(b, r + 1), 0x1F) * 256 + readu8(b, r + 2)
				local esLen = band(readu8(b, r + 3), 15) * 256 + readu8(b, r + 4)
				-- (stream type 6 is private data: AC-3 when its descriptors say so)
				local ac3 = st == 0x81
				if st == 0x06 then
					local d = r + 5
					while d + 2 <= r + 5 + esLen do
						local tag, dlen = readu8(b, d), readu8(b, d + 1)
						if tag == 0x6A or (tag == 0x05 and dlen >= 4 and buffer.readstring(b, d + 2, 4) == "AC-3") then
							ac3 = true
						end
						d += 2 + dlen
					end
				end
				if not videoPid and (st == 0x01 or st == 0x02 or st == 0x1B or st == 0x24) then
					videoPid, videoType = epid, st
				elseif st == 0x10 or st == 0xEA or st == 0x42 then
					other = other or ({ [0x10] = "MPEG-4 Part 2", [0xEA] = "VC-1", [0x42] = "AVS" })[st]
				elseif not audioPid and (st == 0x03 or st == 0x04 or st == 0x0F or ac3) then
					audioPid, audioType = epid, ac3 and "ac-3" or (st == 0x0F and "aac" or "mpga")
				end
				r += 5 + esLen
			end
			if videoPid then
				video = newStream(videoType == 0x1B and "h264" or (videoType == 0x24 and "h265" or "mpgv"))
			end
			if audioPid then
				audio = newStream(audioType)
			end
		elseif pid == videoPid or pid == audioPid then
			local st = pid == videoPid and video or audio
			local pts = nil
			if unitStart then
				if readu8(b, q) == 0 and readu8(b, q + 1) == 0 and readu8(b, q + 2) == 1 then
					local flags, hlen = readu8(b, q + 7), readu8(b, q + 8)
					if band(flags, 0x80) ~= 0 then
						pts = readTime(b, q + 9)
					end
					q += 9 + hlen
					open[pid] = true
				end
			end
			if open[pid] and q < stop then
				if unitStart and not pts and (st.kind == "h264" or st.kind == "h265") then
					-- (an H.264 / H.265 unit without a time: interpolated later)
					pts = -1
				end
				addPart(st, b, q, stop - q, pts)
			end
		end
	end
	return video, audio, other
end

function Mpg.parse(b)
	local n = buffer.len(b)
	local m = { audio = nil }
	local vst, audio
	if tsLayout(b) and not isStartCode(b, 0) then
		m.container = "MPEG-TS"
		vst, audio, m.otherVideo = parseTs(b)
	elseif isStartCode(b, 0, 0xB3) then
		m.container = "MPEG video"
		vst = { kind = "mpgv", parts = { { 0, n } }, size = n, times = {} }
	else
		m.container = "MPEG-PS"
		local audios
		vst, audios = parsePs(b)
		-- the sound: the first MPEG audio stream, else the first AC-3, else the first PCM
		local keys = {}
		for k in pairs(audios) do
			table.insert(keys, k)
		end
		table.sort(keys)
		for _, pref in ipairs({ "mpga", "ac-3", "lpcm" }) do
			for _, k in ipairs(keys) do
				if not audio and audios[k].kind == pref and audios[k].size > 0 then
					audio = audios[k]
				end
			end
		end
	end
	local t0 = nil
	if vst and vst.size > 0 then
		local es = gather(vst, b)
		if vst.kind == "h264" or vst.kind == "h265" then
			-- (times: units without one get the one before plus a frame)
			local last = nil
			for _, tm in ipairs(vst.times) do
				if tm[2] < 0 then
					tm[2] = last and last + 1 / 30 or 0
				end
				last = tm[2]
			end
			m.video, t0 = h264Video(vst, es, vst.kind == "h265")
		else
			m.video, t0 = mpegVideo(es, vst.times)
		end
		if #m.video.samples == 0 then
			m.video = nil
		end
	end
	if audio and audio.size > 0 then
		local a = { codec = audio.kind, data = gather(audio, b), sampleRate = audio.sampleRate, channels = audio.channels,
			bits = audio.bits }
		local first = audio.times[1]
		if first and t0 then
			a.start = first[2] - t0
		end
		m.audio = a
	end
	return m
end

return Mpg
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Heif</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- HEIF still pictures (ISO base media "meta" items): HEIC (H.265 / HEVC, Video.Hevc) - the iPhone photo format - and
-- AVIF (AV1, Video.Av1 when present). The primary picture is decoded - one coded image, or a grid of tiles - then
-- cropped (clap), turned and mirrored (irot / imir) and box-filtered down to MaxSize while it is put together, so a
-- 12-megapixel photo never needs a full-size RGBA copy. A transparency (alpha) picture stored with it is applied.
--
--   Heif.isHeif(bytes) -> true for HEIC / HEIF / AVIF files (by their ftyp brands)
--   Heif.brand(bytes) -> "heic" / "avif" / "heif" (an HEIF file of another kind), or nil
--   local info = Heif.parse(bytes) -> { brand, codec ("hvc1" / "av01" / "grid"), width, height (the picture as shown,
--       after turning), tiles (number of coded images) }
--   local image = Heif.decode(bytes, { MaxSize = longest side (default: full size), Yield = true })
--       -> { width, height, data = RGBA buffer, hasAlpha (a transparency picture with see-through parts),
--       sourceWidth, sourceHeight }

local Heif = {}

local readu8, readu32 = buffer.readu8, buffer.readu32
local band, rshift = bit32.band, bit32.rshift

local function fail(msg)
	error("HEIF: " .. msg, 0)
end

local function be16(b, o)
	return readu8(b, o) * 256 + readu8(b, o + 1)
end
local function be32(b, o)
	return readu8(b, o) * 16777216 + readu8(b, o + 1) * 65536 + readu8(b, o + 2) * 256 + readu8(b, o + 3)
end
-- an unsigned big-endian number of n bytes (0, 4 or 8)
local function beN(b, o, n)
	if n == 0 then
		return 0
	elseif n == 4 then
		return be32(b, o)
	elseif n == 8 then
		return be32(b, o) * 4294967296 + be32(b, o + 4)
	elseif n == 2 then
		return be16(b, o)
	end
	fail("damaged data (bad field size)")
	return 0
end

local BRANDS = { heic = "heic", heix = "heic", hevc = "heic", hevx = "heic", heim = "heic", heis = "heic", mif1 = "heif",
	msf1 = "heif", avif = "avif", avis = "avif" }

-- the file's kind ("heic" / "avif" / "heif") from its ftyp box, or nil
local function brandOf(b)
	if buffer.len(b) < 16 or buffer.readstring(b, 4, 4) ~= "ftyp" then
		return nil
	end
	local size = be32(b, 0)
	local major = BRANDS[buffer.readstring(b, 8, 4)]
	local found = nil
	for o = 16, math.min(size, buffer.len(b)) - 4, 4 do
		local k = BRANDS[buffer.readstring(b, o, 4)]
		if k == "heic" or k == "avif" then
			found = found or k
		end
	end
	if major == "heif" then
		return found or "heif"
	end
	return major or found
end

function Heif.isHeif(bytes)
	local b = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	return brandOf(b) ~= nil
end

function Heif.brand(bytes)
	local b = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	return brandOf(b)
end

-- boxes in [pos, stop): fn(type, payload start, payload end)
local function boxes(b, pos, stop, fn)
	while pos + 8 <= stop do
		local size = be32(b, pos)
		local t = buffer.readstring(b, pos + 4, 4)
		local head = 8
		if size == 1 then
			if pos + 16 > stop then
				break
			end
			size = beN(b, pos + 8, 8)
			head = 16
		elseif size == 0 then
			size = stop - pos
		end
		if size < head then
			fail("damaged data (a box is too small)")
		end
		if fn(t, pos + head, math.min(pos + size, stop)) == false then
			return
		end
		pos += size
	end
end

-- the items of the file's meta box
local function readMeta(b)
	local len = buffer.len(b)
	local meta
	boxes(b, 0, len, function(t, p, q)
		if t == "meta" then
			meta = { p + 4, q }
			return false
		end
		return nil
	end)
	if not meta then
		fail("the file has no picture description (meta box)")
	end
	local items = {}
	local function item(id)
		local it = items[id]
		if not it then
			it = { id = id, props = {}, refs = {} }
			items[id] = it
		end
		return it
	end
	local props = {}
	local idat
	local primary
	boxes(b, meta[1], meta[2], function(t, p, q)
		local v = readu8(b, p)
		if t == "pitm" then
			primary = v == 0 and be16(b, p + 4) or be32(b, p + 4)
		elseif t == "iinf" then
			local o = p + 4 + (v == 0 and 2 or 4)
			boxes(b, o, q, function(t2, p2, q2)
				if t2 == "infe" then
					local iv = readu8(b, p2)
					if iv >= 2 then
						local id = iv == 2 and be16(b, p2 + 4) or be32(b, p2 + 4)
						local to = p2 + 4 + (iv == 2 and 2 or 4) + 2
						local it = item(id)
						it.type = buffer.readstring(b, to, 4)
						it.hidden = band(readu8(b, p2 + 3), 1) == 1
					end
				end
				return nil
			end)
		elseif t == "iloc" then
			local o = p + 4
			local s1, s2 = readu8(b, o), readu8(b, o + 1)
			local offSize, lenSize, baseSize = rshift(s1, 4), band(s1, 15), rshift(s2, 4)
			local idxSize = (v == 1 or v == 2) and band(s2, 15) or 0
			o += 2
			local count
			if v < 2 then
				count = be16(b, o)
				o += 2
			else
				count = be32(b, o)
				o += 4
			end
			for _ = 1, count do
				local id
				if v < 2 then
					id = be16(b, o)
					o += 2
				else
					id = be32(b, o)
					o += 4
				end
				local method = 0
				if v == 1 or v == 2 then
					method = band(be16(b, o), 15)
					o += 2
				end
				o += 2 -- data reference index
				local base = beN(b, o, baseSize)
				o += baseSize
				local n = be16(b, o)
				o += 2
				local it = item(id)
				it.extents = {}
				it.method = method
				for _ = 1, n do
					o += idxSize
					local eo = beN(b, o, offSize)
					o += offSize
					local el = beN(b, o, lenSize)
					o += lenSize
					table.insert(it.extents, { base + eo, el })
				end
			end
		elseif t == "iref" then
			boxes(b, p + 4, q, function(t2, p2, q2)
				local o = p2
				local from
				if v == 0 then
					from = be16(b, o)
					o += 2
				else
					from = be32(b, o)
					o += 4
				end
				local n = be16(b, o)
				o += 2
				local list = {}
				for _ = 1, n do
					if v == 0 then
						table.insert(list, be16(b, o))
						o += 2
					else
						table.insert(list, be32(b, o))
						o += 4
					end
				end
				item(from).refs[t2] = list
				return nil
			end)
		elseif t == "iprp" then
			boxes(b, p, q, function(t2, p2, q2)
				if t2 == "ipco" then
					boxes(b, p2, q2, function(t3, p3, q3)
						table.insert(props, { type = t3, p = p3, q = q3 })
						return nil
					end)
				elseif t2 == "ipma" then
					local pv, flags = readu8(b, p2), readu8(b, p2 + 3)
					local n = be32(b, p2 + 4)
					local o = p2 + 8
					for _ = 1, n do
						local id
						if pv < 1 then
							id = be16(b, o)
							o += 2
						else
							id = be32(b, o)
							o += 4
						end
						local na = readu8(b, o)
						o += 1
						local it = item(id)
						for _ = 1, na do
							local idx
							if band(flags, 1) == 1 then
								idx = band(be16(b, o), 0x7FFF)
								o += 2
							else
								idx = band(readu8(b, o), 0x7F)
								o += 1
							end
							if idx > 0 then
								table.insert(it.props, idx)
							end
						end
					end
				end
				return nil
			end)
		elseif t == "idat" then
			idat = { p, q }
		end
		return nil
	end)
	if not primary or not items[primary] then
		fail("the file names no main picture")
	end
	return items, props, idat, primary
end

-- the first property of a kind associated with an item: its { type, p, q }
local function prop(props, it, kind)
	for _, idx in ipairs(it.props) do
		local pr = props[idx]
		if pr and pr.type == kind then
			return pr
		end
	end
	return nil
end

-- an item's bytes (its extents, one after another)
local function itemData(b, it, idat)
	if not it.extents or #it.extents == 0 then
		fail("a picture part has no data")
	end
	local len = buffer.len(b)
	local base, stop = 0, len
	if it.method == 1 then
		if not idat then
			fail("damaged data (missing idat)")
		end
		base, stop = idat[1], idat[2]
	elseif it.method ~= 0 then
		fail("damaged data (unsupported item location)")
	end
	local total = 0
	for _, e in ipairs(it.extents) do
		local l = e[2] == 0 and (stop - base - e[1]) or e[2]
		if base + e[1] + l > stop or l < 0 then
			fail("the file is cut off (a picture part is missing)")
		end
		total += l
	end
	local out = buffer.create(total)
	local o = 0
	for _, e in ipairs(it.extents) do
		local l = e[2] == 0 and (stop - base - e[1]) or e[2]
		buffer.copy(out, o, b, base + e[1], l)
		o += l
	end
	return out
end

local function payload(b, pr)
	local n = pr.q - pr.p
	local out = buffer.create(n)
	buffer.copy(out, 0, b, pr.p, n)
	return out
end

-- the picture's layout: coded tiles and the transforms to apply
local function layout(b)
	local brand = brandOf(b)
	local items, props, idat, primary = readMeta(b)
	local main = items[primary]
	local L = { brand = brand, codec = main.type, tiles = {}, transforms = {}, idat = idat }
	local function sizeOf(it)
		local ispe = prop(props, it, "ispe")
		if ispe then
			return be32(b, ispe.p + 4), be32(b, ispe.p + 8)
		end
		return nil, nil
	end
	-- an item's coded tiles: { tiles = { { item, x, y, config } }, codec, width, height }
	local function picture(it)
		local P = { tiles = {} }
		if it.type == "grid" then
			local g = itemData(b, it, idat)
			local flags = readu8(g, 1)
			local rows, cols = readu8(g, 2) + 1, readu8(g, 3) + 1
			if band(flags, 1) == 1 then
				P.width, P.height = be32(g, 4), be32(g, 8)
			else
				P.width, P.height = be16(g, 4), be16(g, 6)
			end
			local list = it.refs.dimg
			if not list or #list < rows * cols then
				fail("damaged data (the picture's grid lacks tiles)")
			end
			local tw, th = sizeOf(items[list[1]])
			if not tw then
				fail("damaged data (tile size missing)")
			end
			for r = 0, rows - 1 do
				for c = 0, cols - 1 do
					local t = items[list[r * cols + c + 1]]
					if not t then
						fail("damaged data (a tile is missing)")
					end
					table.insert(P.tiles, { item = t, x = c * tw, y = r * th })
				end
			end
			P.codec = items[list[1]].type
		elseif it.type == "hvc1" or it.type == "av01" then
			P.width, P.height = sizeOf(it)
			P.tiles[1] = { item = it, x = 0, y = 0 }
			P.codec = it.type
		else
			return nil
		end
		-- the coded tiles' setup
		for _, t in ipairs(P.tiles) do
			local cfg = prop(props, t.item, P.codec == "av01" and "av1C" or "hvcC")
			if not cfg then
				fail("damaged data (a tile's decoder setup is missing)")
			end
			t.config = cfg
		end
		return P
	end
	local P = picture(main)
	if not P then
		fail(("the main picture is of a kind that isn't read (%q)"):format(tostring(main.type)))
	end
	L.tiles, L.tileCodec, L.width, L.height = P.tiles, P.codec, P.width, P.height
	-- a transparency (alpha) picture: an auxiliary item for the main one
	for _, it in pairs(items) do
		local aux = it.refs.auxl
		local auxC = prop(props, it, "auxC")
		if aux and auxC and table.find(aux, primary) then
			local urn = buffer.readstring(b, auxC.p + 4, math.max(0, auxC.q - auxC.p - 4))
			if string.find(urn, "alpha", 1, true) then
				L.alpha = picture(it)
				break
			end
		end
	end
	-- colour (nclx) and the transforms, in their order
	for _, idx in ipairs(main.props) do
		local pr = props[idx]
		if pr then
			if pr.type == "colr" and buffer.readstring(b, pr.p, 4) == "nclx" then
				L.matrix = be16(b, pr.p + 8)
				L.fullRange = band(readu8(b, pr.p + 10), 0x80) ~= 0
			elseif pr.type == "irot" then
				table.insert(L.transforms, { "rot", band(readu8(b, pr.p), 3) })
			elseif pr.type == "imir" then
				table.insert(L.transforms, { "mir", band(readu8(b, pr.p), 1) })
			elseif pr.type == "clap" then
				local function frac(o)
					local d = be32(b, o + 4)
					local n = be32(b, o)
					if n >= 2147483648 then
						n -= 4294967296
					end
					return d ~= 0 and n / d or 0
				end
				table.insert(L.transforms, { "clap", frac(pr.p), frac(pr.p + 8), frac(pr.p + 16), frac(pr.p + 24) })
			end
		end
	end
	return L, props
end

function Heif.parse(bytes)
	local b = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	local L = layout(b)
	local w, h = L.width or 0, L.height or 0
	for _, t in ipairs(L.transforms) do
		if t[1] == "rot" and t[2] % 2 == 1 then
			w, h = h, w
		elseif t[1] == "clap" then
			w, h = math.floor(t[2] + 0.5), math.floor(t[3] + 0.5)
		end
	end
	return { brand = L.brand, codec = L.codec, width = w, height = h, tiles = #L.tiles }
end

-- a decoder for the tiles' codec: new(config buffer) -> object with :picture(data) -> pic (Y, U, V, ys, cs, yo, co) and
-- width, height, cropX, cropY, fullRange, bt709 fields
local function codecFor(kind)
	local Video = script.Parent.Parent:FindFirstChild("Video")
	if kind == "hvc1" then
		local Hevc = require(Video.Hevc)
		return function(cfg)
			local dec = Hevc.new(cfg)
			return dec, function(data)
				local pic = dec:decodeSample(data, 0, buffer.len(data))
				if not pic then
					fail("a tile didn't decode")
				end
				return pic
			end
		end
	elseif kind == "av01" then
		local mod = Video and Video:FindFirstChild("Av1")
		if not mod then
			fail("AV1 pictures (AVIF) can't be read here")
		end
		local Av1 = require(mod)
		return function(cfg)
			local dec = Av1.new(cfg)
			dec.fullChroma = true
			return dec, function(data)
				local pic = dec:decodeSample(data, 0, buffer.len(data))
				if not pic then
					fail("a tile didn't decode")
				end
				return pic
			end
		end
	end
	fail(("pictures coded as %q can't be read"):format(tostring(kind)))
	return nil :: any
end

-- turn / mirror an RGBA image
local function rotate(img, quarter)
	-- quarter turns anticlockwise
	local w, h, d = img.width, img.height, img.data
	if quarter == 0 then
		return img
	end
	local nw, nh = w, h
	if quarter % 2 == 1 then
		nw, nh = h, w
	end
	local out = buffer.create(nw * nh * 4)
	for y = 0, h - 1 do
		for x = 0, w - 1 do
			local nx, ny
			if quarter == 1 then
				nx, ny = y, w - 1 - x
			elseif quarter == 2 then
				nx, ny = w - 1 - x, h - 1 - y
			else
				nx, ny = h - 1 - y, x
			end
			buffer.writeu32(out, (ny * nw + nx) * 4, readu32(d, (y * w + x) * 4))
		end
	end
	return { width = nw, height = nh, data = out, hasAlpha = img.hasAlpha }
end
local function mirror(img, axis)
	-- axis 0: about the vertical axis (left and right swap); 1: about the horizontal axis (top and bottom swap)
	local w, h, d = img.width, img.height, img.data
	local out = buffer.create(w * h * 4)
	for y = 0, h - 1 do
		for x = 0, w - 1 do
			local sx, sy = x, y
			if axis == 0 then
				sx = w - 1 - x
			else
				sy = h - 1 - y
			end
			buffer.writeu32(out, (y * w + x) * 4, readu32(d, (sy * w + sx) * 4))
		end
	end
	return { width = w, height = h, data = out, hasAlpha = img.hasAlpha }
end

function Heif.decode(bytes, opts)
	opts = opts or {}
	local b = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	local L = layout(b)
	local yieldOn = opts.Yield and task ~= nil
	local lastYield = os.clock()
	local function breathe()
		if yieldOn and os.clock() - lastYield > 0.03 then
			task.wait()
			lastYield = os.clock()
		end
	end
	local newDecoder = codecFor(L.tileCodec)
	-- the first tile gives the size when the file doesn't
	local decoders = {}
	local function decodeTile(t)
		local key = t.config
		local entry = decoders[key]
		if not entry then
			local dec, run = newDecoder(payload(b, t.config))
			entry = { dec = dec, run = run }
			decoders[key] = entry
		end
		local pic = entry.run(itemData(b, t.item, L.idat))
		return entry.dec, pic
	end
	local firstDec, firstPic = decodeTile(L.tiles[1])
	local W, H = L.width or firstDec.width, L.height or firstDec.height
	if #L.tiles == 1 then
		W, H = math.min(W, firstDec.width), math.min(H, firstDec.height)
	end
	if W <= 0 or H <= 0 then
		fail("the picture has no size")
	end
	-- the region kept (clean aperture), in coded picture pixels
	local rx0, ry0, rw, rh = 0, 0, W, H
	for _, t in ipairs(L.transforms) do
		if t[1] == "clap" then
			local cw, ch = math.floor(t[2] + 0.5), math.floor(t[3] + 0.5)
			if cw > 0 and ch > 0 and cw <= W and ch <= H then
				rx0 = math.clamp(math.floor((W - 1) / 2 + t[4] - (cw - 1) / 2 + 0.5), 0, W - cw)
				ry0 = math.clamp(math.floor((H - 1) / 2 + t[5] - (ch - 1) / 2 + 0.5), 0, H - ch)
				rw, rh = cw, ch
			end
		end
	end
	-- output size: the longest side at most MaxSize
	local maxSize = opts.MaxSize or math.max(rw, rh)
	local s = math.min(1, maxSize / math.max(rw, rh))
	local ow, oh = math.max(1, math.floor(rw * s + 0.5)), math.max(1, math.floor(rh * s + 0.5))
	local n = ow * oh
	local SY, SU, SV, CY = table.create(n, 0), table.create(n, 0), table.create(n, 0), table.create(n, 0)
	-- picture column / row -> output column / row (+1), or 0 outside the kept region
	local mapX, mapY = table.create(W + 2, 0), table.create(H + 2, 0)
	for x = 0, W - 1 do
		local rx = x - rx0
		mapX[x + 1] = (rx >= 0 and rx < rw) and (rx * ow // rw + 1) or 0
	end
	for y = 0, H - 1 do
		local ry = y - ry0
		mapY[y + 1] = (ry >= 0 and ry < rh) and (ry * oh // rh + 1) or 0
	end
	local matrix, fullRange = L.matrix, L.fullRange
	local function add(dec, pic, tx, ty)
		if matrix == nil then
			matrix = dec.matrix or (dec.bt709 and 1 or 6)
			if matrix == 2 then
				matrix = 6
			end
		end
		if fullRange == nil then
			fullRange = dec.fullRange
		end
		local tw = math.min(dec.width, W - tx)
		local th = math.min(dec.height, H - ty)
		local Y, U, V = pic.Y, pic.U, pic.V
		local ys, cs = pic.ys, pic.cs
		local sx, sy = dec.chromaShiftX or 1, dec.chromaShiftY or 1
		local yo = pic.yo + (dec.cropY or 0) * ys + (dec.cropX or 0)
		local co = pic.co + ((dec.cropY or 0) // 2 ^ sy) * cs + (dec.cropX or 0) // 2 ^ sx
		for y = 0, th - 1 do
			local my = mapY[ty + y + 1]
			if my > 0 then
				local row = (my - 1) * ow
				local r = yo + y * ys
				local rc = co + (y // 2 ^ sy) * cs
				for x = 0, tw - 1 do
					local mx = mapX[tx + x + 1]
					if mx > 0 then
						local k = row + mx
						local c = rc + x // 2 ^ sx
						SY[k] += readu8(Y, r + x)
						SU[k] += readu8(U, c)
						SV[k] += readu8(V, c)
						CY[k] += 1
					end
				end
			end
			if y % 32 == 31 then
				breathe()
			end
		end
	end
	add(firstDec, firstPic, L.tiles[1].x, L.tiles[1].y)
	for i = 2, #L.tiles do
		local t = L.tiles[i]
		if t.x < W and t.y < H then
			local dec, pic = decodeTile(t)
			add(dec, pic, t.x, t.y)
		end
		breathe()
	end
	-- transparency
	local SA, CA
	if L.alpha then
		SA, CA = table.create(n, 0), table.create(n, 0)
		local A = L.alpha
		local alphaDecoder = codecFor(A.codec)
		local adecs = {}
		for _, t in ipairs(A.tiles) do
			local entry = adecs[t.config]
			if not entry then
				local dec, run = alphaDecoder(payload(b, t.config))
				entry = { dec = dec, run = run }
				adecs[t.config] = entry
			end
			local pic = entry.run(itemData(b, t.item, L.idat))
			local dec = entry.dec
			local aw, ah = A.width or dec.width, A.height or dec.height
			local tw = math.min(dec.width, aw - t.x)
			local th = math.min(dec.height, ah - t.y)
			local Yp, ys = pic.Y, pic.ys
			local yo = pic.yo + (dec.cropY or 0) * ys + (dec.cropX or 0)
			local full = dec.fullRange
			for y = 0, th - 1 do
				-- (an alpha picture of another size is scaled onto the colour one)
				local py = (t.y + y) * H // ah
				local my = mapY[py + 1]
				if my > 0 then
					local row = (my - 1) * ow
					local r = yo + y * ys
					for x = 0, tw - 1 do
						local mx = mapX[(t.x + x) * W // aw + 1]
						if mx > 0 then
							local v = readu8(Yp, r + x)
							if not full then
								v = math.clamp((v - 16) * 255 / 219, 0, 255)
							end
							SA[row + mx] += v
							CA[row + mx] += 1
						end
					end
				end
				if y % 32 == 31 then
					breathe()
				end
			end
		end
	end
	-- to RGBA
	local kr, kb = 0.299, 0.114
	if matrix == 1 then
		kr, kb = 0.2126, 0.0722
	elseif matrix == 9 or matrix == 10 then
		kr, kb = 0.2627, 0.0593
	end
	local kg = 1 - kr - kb
	local ys0, yscale, cscale = 16, 255 / 219, 255 / 224
	if fullRange then
		ys0, yscale, cscale = 0, 1, 1
	end
	local rv, bu = 2 * (1 - kr) * cscale, 2 * (1 - kb) * cscale
	local gu, gv = 2 * (1 - kb) * kb / kg * cscale, 2 * (1 - kr) * kr / kg * cscale
	local identity = matrix == 0 -- (GBR: the planes hold green, blue, red)
	local out = buffer.create(n * 4)
	local hasAlpha = false
	for k = 1, n do
		local cy = CY[k]
		local Yv = cy > 0 and SY[k] / cy or 0
		local Uv = cy > 0 and SU[k] / cy or 128
		local Vv = cy > 0 and SV[k] / cy or 128
		local r, g, bl
		if identity then
			g, bl, r = Yv, Uv, Vv
		else
			local yy = (Yv - ys0) * yscale
			local u, v = Uv - 128, Vv - 128
			r = yy + rv * v
			g = yy - gu * u - gv * v
			bl = yy + bu * u
		end
		local a = 255
		if SA and CA[k] > 0 then
			a = math.clamp(math.floor(SA[k] / CA[k] + 0.5), 0, 255)
			if a < 255 then
				hasAlpha = true
			end
		end
		buffer.writeu32(out, (k - 1) * 4, math.clamp(math.floor(r + 0.5), 0, 255) + 256 * math.clamp(math.floor(g + 0.5), 0, 255)
			+ 65536 * math.clamp(math.floor(bl + 0.5), 0, 255) + 16777216 * a)
	end
	local img = { width = ow, height = oh, data = out, hasAlpha = hasAlpha }
	local sw, sh = rw, rh
	for _, t in ipairs(L.transforms) do
		if t[1] == "rot" then
			img = rotate(img, t[2])
			if t[2] % 2 == 1 then
				sw, sh = sh, sw
			end
		elseif t[1] == "mir" then
			img = mirror(img, t[2])
		end
	end
	img.sourceWidth, img.sourceHeight = sw, sh
	return img
end

return Heif
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Image</string>
          <BinaryString name="AttributesSerialize"></BinaryString>
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <Color3 name="IconTint">
            <R>0</R>
            <G>0</G>
            <B>0</B>
          </Color3>
