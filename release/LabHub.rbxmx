          <Properties>
            <string name="Name">Strips</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- Strip encoder: a picture as GUI strips. A strip is one span of one pixel row (or column) drawn by a Frame whose
-- UIGradient holds up to 20 colour keypoints; Roblox blends linearly between them. Keypoints are chosen so the blend
-- stays within `tol` (0..255) of every pixel, and they sit on pixels (each keypoint colour is that pixel's colour).
--
--   Strips.fitRow(px, base, step, a, b, tol, out)  -> number of keypoints written to out (pixel indices)
--   Strips.fitRowFree(px, base, step, a, b, tol, out, colOut) -> n; keypoint colours free (colOut: r, g, b each)
--   Strips.nextCut(kp, s0, n) -> s1: the strip from keypoint s0 ends at s1 (<= 19 segments; shorter where detail is fine)
--   Strips.encode(image, options) -> strips
--       image: { width, height, data = buffer RGBA }
--       options: Tol (default 12), Merge (true: a strip grows down while the next row still matches), Orientation
--                ("rows" | "columns" | "auto": the one with fewer strips, default)
--       strips = { orientation, width, height, list = { { line, line1, kp = {positions}, col = {r, g, b, ...} } } }
--       (line .. line1 = the rows (or columns) it covers, kp = positions along the line, col = 0..255 per keypoint)

local Strips = {}

Strips.MaxKeypoints = 20

-- Greedy fit of one line from index a to b (inclusive). Pixel i of the line is at byte base + i * step (RGBA).
-- For each segment start i, the slope of the blend towards a candidate end k must keep every pixel in between within
-- tol: each pixel narrows the allowed slope range per channel (a cone), and the segment ends at the last k whose own
-- slope still fits. O(length) per line.
function Strips.fitRow(px, base, step, a, b, tol, out)
	local n = 1
	out[1] = a
	local i = a
	while i < b do
		local o = base + i * step
		local r0, g0, b0 = buffer.readu8(px, o), buffer.readu8(px, o + 1), buffer.readu8(px, o + 2)
		local loR, hiR, loG, hiG, loB, hiB = -math.huge, math.huge, -math.huge, math.huge, -math.huge, math.huge
		local last = i + 1
		local k = i + 1
		while k <= b do
			local p = base + k * step
			local d = k - i
			local vr, vg, vb = buffer.readu8(px, p) - r0, buffer.readu8(px, p + 1) - g0, buffer.readu8(px, p + 2) - b0
			-- k can end the segment if its own slope fits the cone of the pixels before it
			local sr, sg, sb = vr / d, vg / d, vb / d
			if sr >= loR and sr <= hiR and sg >= loG and sg <= hiG and sb >= loB and sb <= hiB then
				last = k
			end
			-- narrow the cone with pixel k (for segments ending further on)
			local t = tol / d
			local l, h = sr - t, sr + t
			if l > loR then
				loR = l
			end
			if h < hiR then
				hiR = h
			end
			l, h = sg - t, sg + t
			if l > loG then
				loG = l
			end
			if h < hiG then
				hiG = h
			end
			l, h = sb - t, sb + t
			if l > loB then
				loB = l
			end
			if h < hiB then
				hiB = h
			end
			if loR > hiR or loG > hiG or loB > hiB then
				break
			end
			k += 1
		end
		n += 1
		out[n] = last
		i = last
	end
	return n
end

-- Like fitRow, but a keypoint's colour may be anything within tol of its pixel (not the pixel's own colour): a segment
-- runs while any blend from its start colour stays inside every pixel's +-tol band, and ends at the middle of what is
-- left. Same accuracy with ~20% fewer keypoints (Monkey Watch, 240p: the strip budget fits at tolerance 22 instead
-- of 29, so thin curves smear less). colOut gets whole numbers 0..255.
function Strips.fitRowFree(px, base, step, a, b, tol, out, colOut)
	local readu8 = buffer.readu8
	local o = base + a * step
	local r0, g0, b0 = readu8(px, o), readu8(px, o + 1), readu8(px, o + 2)
	out[1] = a
	colOut[1], colOut[2], colOut[3] = r0, g0, b0
	local n = 1
	local i = a
	local t0 = math.max(tol - 0.5, 0) -- (room for rounding the colours)
	while i < b do
		local loR, hiR, loG, hiG, loB, hiB = -math.huge, math.huge, -math.huge, math.huge, -math.huge, math.huge
		local k = i + 1
		while k <= b do
			local p = base + k * step
			local d = k - i
			local vr, vg, vb = readu8(px, p), readu8(px, p + 1), readu8(px, p + 2)
			local l1, h1 = (vr - t0 - r0) / d, (vr + t0 - r0) / d
			local l2, h2 = (vg - t0 - g0) / d, (vg + t0 - g0) / d
			local l3, h3 = (vb - t0 - b0) / d, (vb + t0 - b0) / d
			if l1 < loR then l1 = loR end
			if h1 > hiR then h1 = hiR end
			if l2 < loG then l2 = loG end
			if h2 > hiG then h2 = hiG end
			if l3 < loB then l3 = loB end
			if h3 > hiB then h3 = hiB end
			if l1 > h1 or l2 > h2 or l3 > h3 then
				break
			end
			loR, hiR, loG, hiG, loB, hiB = l1, h1, l2, h2, l3, h3
			k += 1
		end
		local e = k - 1
		local d = e - i
		r0 = math.clamp(math.floor(r0 + (loR + hiR) * 0.5 * d + 0.5), 0, 255)
		g0 = math.clamp(math.floor(g0 + (loG + hiG) * 0.5 * d + 0.5), 0, 255)
		b0 = math.clamp(math.floor(b0 + (loB + hiB) * 0.5 * d + 0.5), 0, 255)
		n += 1
		out[n] = e
		colOut[n * 3 - 2], colOut[n * 3 - 1], colOut[n * 3] = r0, g0, b0
		i = e
	end
	return n
end

-- Roblox draws a gradient from a texture of limited width: in a strip 800 pixels long a 1-pixel dark line vanishes and a
-- 2-pixel one is faint, while short strips show them. So a strip ends early when its span would pass
-- Strips.DetailSpan x its shortest segment (fine detail stays in short strips; smooth rows keep long ones).
Strips.DetailSpan = 256
function Strips.nextCut(kp, s0, n)
	local MAXK = Strips.MaxKeypoints
	local K = Strips.DetailSpan
	local s1 = s0 + 1
	if s1 > n then
		return n
	end
	local minSeg = kp[s1] - kp[s0]
	while s1 < n and s1 - s0 < MAXK - 1 do
		local seg = kp[s1 + 1] - kp[s1]
		local m2 = seg < minSeg and seg or minSeg
		if kp[s1 + 1] - kp[s0] > K * math.max(m2, 1) then
			break
		end
		minSeg = m2
		s1 += 1
	end
	return s1
end

-- strips a row fitted into n keypoints takes (nextCut)
function Strips.countStrips(kp, n)
	local c, s0 = 0, 1
	while s0 < n do
		s0 = Strips.nextCut(kp, s0, n)
		c += 1
	end
	return math.max(c, 1)
end

-- does the strip (positions kp[1..m], colours col) still draw line `line` within tol?
local function fits(px, base, step, kp, col, m, tol)
	for s = 1, m - 1 do
		local x0, x1 = kp[s], kp[s + 1]
		local c = (s - 1) * 3
		local r0, g0, b0 = col[c + 1], col[c + 2], col[c + 3]
		local dr, dg, db = col[c + 4] - r0, col[c + 5] - g0, col[c + 6] - b0
		local inv = 1 / (x1 - x0)
		for x = x0, x1 do
			local t = (x - x0) * inv
			local p = base + x * step
			if math.abs(r0 + dr * t - buffer.readu8(px, p)) > tol or math.abs(g0 + dg * t - buffer.readu8(px, p + 1)) > tol
				or math.abs(b0 + db * t - buffer.readu8(px, p + 2)) > tol then
				return false
			end
		end
	end
	return true
end
Strips.fits = fits

local function encodeDir(image, tol, merge, columns)
	local W, H = image.width, image.height
	local alpha = image.hasAlpha == true
	if alpha then
		merge = false
	end
	local px = image.data
	local lines, length, lineStep, step
	if columns then
		lines, length, lineStep, step = W, H, 4, W * 4
	else
		lines, length, lineStep, step = H, W, W * 4, 4
	end
	local MAXK = Strips.MaxKeypoints
	local list = {}
	local active = {} -- strips still growing (merge)
	local kpBuf = table.create(length + 1, 0)
	local colBuf = table.create((length + 1) * 3, 0)
	for line = 0, lines - 1 do
		local base = line * lineStep
		local keep = {}
		if merge then
			for _, s in ipairs(active) do
				if fits(px, base, step, s.kp, s.col, #s.kp, tol) then
					s.line1 = line
					table.insert(keep, s)
				end
			end
		end
		-- positions not covered by a continuing strip get new strips
		table.sort(keep, function(x, y)
			return x.kp[1] < y.kp[1]
		end)
		local spans = {}
		if alpha then
			-- transparent pixels (alpha < 128) get no strip: one span per opaque run
			local x = 0
			while x < length do
				while x < length and buffer.readu8(px, base + x * step + 3) < 128 do
					x += 1
				end
				local a = x
				while x < length and buffer.readu8(px, base + x * step + 3) >= 128 do
					x += 1
				end
				if x > a then
					table.insert(spans, { a, x - 1 })
				end
			end
		else
			local x = 0
			for _, s in ipairs(keep) do
				if s.kp[1] > x then
					table.insert(spans, { x, s.kp[1] })
				end
				x = math.max(x, s.kp[#s.kp])
			end
			if x < length - 1 or #keep == 0 then
				table.insert(spans, { (#keep == 0) and 0 or x, length - 1 })
			end
		end
		local fresh = {}
		for _, sp in ipairs(spans) do
			local a, b = sp[1], sp[2]
			local n = Strips.fitRowFree(px, base, step, a, b, tol, kpBuf, colBuf)
			if n == 1 then
				kpBuf[2] = b
				colBuf[4], colBuf[5], colBuf[6] = colBuf[1], colBuf[2], colBuf[3]
				n = 2
			end
			-- cut into strips of at most MAXK keypoints, shorter around fine detail (neighbours share their end keypoint)
			local s0 = 1
			while s0 < n do
				local s1 = Strips.nextCut(kpBuf, s0, n)
				local kp, col = table.create(s1 - s0 + 1), table.create((s1 - s0 + 1) * 3)
				for q = s0, s1 do
					kp[q - s0 + 1] = kpBuf[q]
					local c = (q - s0) * 3
					col[c + 1], col[c + 2], col[c + 3] = colBuf[q * 3 - 2], colBuf[q * 3 - 1], colBuf[q * 3]
				end
				local s = { line = line, line1 = line, kp = kp, col = col }
				table.insert(list, s)
				table.insert(fresh, s)
				s0 = s1
			end
		end
		if merge then
			for _, s in ipairs(fresh) do
				table.insert(keep, s)
			end
			active = keep
		end
	end
	return { orientation = columns and "columns" or "rows", width = W, height = H, list = list }
end

function Strips.encode(image, options)
	options = options or {}
	local tol = options.Tol or 12
	local merge = options.Merge ~= false
	local o = options.Orientation or "auto"
	if o == "rows" then
		return encodeDir(image, tol, merge, false)
	elseif o == "columns" then
		return encodeDir(image, tol, merge, true)
	end
	local r = encodeDir(image, tol, merge, false)
	local c = encodeDir(image, tol, merge, true)
	return (#c.list < #r.list) and c or r
end

-- draw strips back into an RGBA buffer (tests / previews)
function Strips.render(strips)
	local W, H = strips.width, strips.height
	local out = buffer.create(W * H * 4)
	local cols = strips.orientation == "columns"
	for _, s in ipairs(strips.list) do
		local kp, col = s.kp, s.col
		for line = s.line, s.line1 do
			for q = 1, #kp - 1 do
				local x0, x1 = kp[q], kp[q + 1]
				local c = (q - 1) * 3
				for x = x0, x1 do
					local t = (x1 == x0) and 0 or (x - x0) / (x1 - x0)
					local px, py = x, line
					if cols then
						px, py = line, x
					end
					local o = (py * W + px) * 4
					buffer.writeu8(out, o, math.floor(col[c + 1] + (col[c + 4] - col[c + 1]) * t + 0.5))
					buffer.writeu8(out, o + 1, math.floor(col[c + 2] + (col[c + 5] - col[c + 2]) * t + 0.5))
					buffer.writeu8(out, o + 2, math.floor(col[c + 3] + (col[c + 6] - col[c + 3]) * t + 0.5))
					buffer.writeu8(out, o + 3, 255)
				end
			end
		end
	end
	return out
end

return Strips
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Blocks</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- Block pictures (JPEG's idea for GUI objects): the picture in 8 x 8 blocks, a block cut into four 4 x 4 where 8 x 8 misses
-- by more than Threshold. A block is ONE ImageLabel: background colour A, a pattern from the shared library
-- (Render.Patterns: one uploaded image) tinted colour B, so pixel = A + pattern x (B - A). Flat blocks are plain Frames,
-- and neighbouring flat blocks of one colour become one Frame. No UIGradients at all (no ~1000 limit), no strips (no
-- sideways streaks): a 400-pixel photo is ~3500 objects, a 512 one ~9000.
--
--   local list = Blocks.encode(image, { Threshold = 6, Yield = true }) -> { width, height, count, items = {...} }
--   local view = Blocks.draw(list, parent, { KeepAspect = true, ZIndex }) -> { Frame, destroy = function }
--   Blocks.ready() -> the pattern library is available

local Blocks = {}

local FrameLab = script:FindFirstAncestor("FrameLab")
local Patterns = require(FrameLab.Render.Patterns)

function Blocks.ready()
	return Patterns.ready()
end

local readu8 = buffer.readu8
local FLAT = 6 -- a block whose colours span less than this (0..255) is one colour

local pr, pg, pb = table.create(64, 0), table.create(64, 0), table.create(64, 0)
local av = table.create(64, 0)

-- fit the BS x BS block at (x0, y0): returns kind ("flat" | "pat"), A r g b, B r g b, pattern index, rms error
-- (stride: pixels per row of data, default W)
local function fitBlock(data, W, H, x0, y0, BS, stride)
	stride = stride or W
	local n = BS * BS
	local mr, mg, mb = 0, 0, 0
	for y = 0, BS - 1 do
		local yy = math.min(y0 + y, H - 1)
		for x = 0, BS - 1 do
			local xx = math.min(x0 + x, W - 1)
			local o = (yy * stride + xx) * 4
			local k = y * BS + x + 1
			local r, g, b = readu8(data, o), readu8(data, o + 1), readu8(data, o + 2)
			pr[k], pg[k], pb[k] = r, g, b
			mr += r
			mg += g
			mb += b
		end
	end
	mr /= n
	mg /= n
	mb /= n
	-- main colour axis (power iteration on the 3x3 covariance)
	local crr, cgg, cbb, crg, crb, cgb = 0, 0, 0, 0, 0, 0
	for k = 1, n do
		local dr, dg, db = pr[k] - mr, pg[k] - mg, pb[k] - mb
		crr += dr * dr
		cgg += dg * dg
		cbb += db * db
		crg += dr * dg
		crb += dr * db
		cgb += dg * db
	end
	local ax, ay, az = 0.577, 0.577, 0.577
	if crr >= cgg and crr >= cbb then
		ax, ay, az = 1, 0.3, 0.3
	elseif cgg >= cbb then
		ax, ay, az = 0.3, 1, 0.3
	else
		ax, ay, az = 0.3, 0.3, 1
	end
	for _ = 1, 8 do
		local nx = crr * ax + crg * ay + crb * az
		local ny = crg * ax + cgg * ay + cgb * az
		local nz = crb * ax + cgb * ay + cbb * az
		local l = math.sqrt(nx * nx + ny * ny + nz * nz)
		if l < 1e-9 then
			break
		end
		ax, ay, az = nx / l, ny / l, nz / l
	end
	local lo, hi = math.huge, -math.huge
	for k = 1, n do
		local t = (pr[k] - mr) * ax + (pg[k] - mg) * ay + (pb[k] - mb) * az
		av[k] = t
		if t < lo then lo = t end
		if t > hi then hi = t end
	end
	if hi - lo < FLAT then
		local se = 0
		for k = 1, n do
			local dr, dg, db = pr[k] - mr, pg[k] - mg, pb[k] - mb
			se += dr * dr + dg * dg + db * db
		end
		return "flat", mr, mg, mb, mr, mg, mb, 0, math.sqrt(se / (3 * n))
	end
	local inv = 15 / (hi - lo)
	for k = 1, n do
		av[k] = (av[k] - lo) * inv
	end
	local idx = Patterns.match(BS, av)
	-- least-squares colours for pixel = A + p (B - A)
	local sp, spp, sr, sg, sb, spr, spg, spb = 0, 0, 0, 0, 0, 0, 0, 0
	for k = 1, n do
		local p = Patterns.value(BS, idx, k) / 15
		av[k] = p
		sp += p
		spp += p * p
		sr += pr[k]
		sg += pg[k]
		sb += pb[k]
		spr += p * pr[k]
		spg += p * pg[k]
		spb += p * pb[k]
	end
	local det = n * spp - sp * sp
	if math.abs(det) < 1e-6 then
		det = 1e-6
	end
	local Ar = math.clamp((spp * sr - sp * spr) / det, 0, 255)
	local Ag = math.clamp((spp * sg - sp * spg) / det, 0, 255)
	local Ab = math.clamp((spp * sb - sp * spb) / det, 0, 255)
	local Br = math.clamp(Ar + (n * spr - sp * sr) / det, 0, 255)
	local Bg = math.clamp(Ag + (n * spg - sp * sg) / det, 0, 255)
	local Bb = math.clamp(Ab + (n * spb - sp * sb) / det, 0, 255)
	local se = 0
	for k = 1, n do
		local p = av[k]
		local er, eg, eb = Ar + p * (Br - Ar) - pr[k], Ag + p * (Bg - Ag) - pg[k], Ab + p * (Bb - Ab) - pb[k]
		se += er * er + eg * eg + eb * eb
	end
	return "pat", Ar, Ag, Ab, Br, Bg, Bb, idx, math.sqrt(se / (3 * n))
end

Blocks.fitBlock = fitBlock

-- rms error of a drawn block (pattern idx, or -1 for one colour A) against the picture at (x0, y0)
function Blocks.errorOf(data, W, H, x0, y0, BS, stride, idx, ar, ag, ab, br, bg, bb)
	local se = 0
	for y = 0, BS - 1 do
		local yy = math.min(y0 + y, H - 1)
		for x = 0, BS - 1 do
			local xx = math.min(x0 + x, W - 1)
			local o = (yy * stride + xx) * 4
			local p = (idx >= 0) and Patterns.value(BS, idx, y * BS + x + 1) / 15 or 0
			local er = ar + p * (br - ar) - readu8(data, o)
			local eg = ag + p * (bg - ag) - readu8(data, o + 1)
			local eb = ab + p * (bb - ab) - readu8(data, o + 2)
			se += er * er + eg * eg + eb * eb
		end
	end
	return math.sqrt(se / (3 * BS * BS))
end

function Blocks.encode(image, options)
	options = options or {}
	local T = options.Threshold or 6
	local W, H, data = image.width, image.height, image.data
	local items = {}
	local t0 = os.clock()
	local pending -- a run of flat 8x8 blocks of one colour (one Frame)
	local function flush()
		if pending then
			table.insert(items, pending)
			pending = nil
		end
	end
	for by = 0, (H - 1) // 8 do
		for bx = 0, (W - 1) // 8 do
			local x0, y0 = bx * 8, by * 8
			local kind, ar, ag, ab, br, bg, bb, idx, e = fitBlock(data, W, H, x0, y0, 8)
			if e <= T then
				if kind == "flat" then
					local r, g, b = math.floor(ar + 0.5), math.floor(ag + 0.5), math.floor(ab + 0.5)
					if pending and pending.y == y0 and pending.x + pending.w == x0 and math.abs(pending.r - r) <= 2
						and math.abs(pending.g - g) <= 2 and math.abs(pending.b - b) <= 2 then
						pending.w += 8
					else
						flush()
						pending = { flat = true, x = x0, y = y0, w = 8, h = 8, r = r, g = g, b = b }
					end
				else
					flush()
					table.insert(items, { x = x0, y = y0, s = 8, a = { ar, ag, ab }, b = { br, bg, bb }, idx = idx })
				end
			else
				flush()
				for q = 0, 3 do
					local sx, sy = x0 + (q % 2) * 4, y0 + (q // 2) * 4
					if sx < W and sy < H then
						local k2, r1, g1, b1, r2, g2, b2, i2 = fitBlock(data, W, H, sx, sy, 4)
						if k2 == "flat" then
							table.insert(items, { flat = true, x = sx, y = sy, w = 4, h = 4, r = r1, g = g1, b = b1 })
						else
							table.insert(items, { x = sx, y = sy, s = 4, a = { r1, g1, b1 }, b = { r2, g2, b2 }, idx = i2 })
						end
					end
				end
			end
			if options.Yield and os.clock() - t0 > 0.008 then
				task.wait()
				t0 = os.clock()
			end
		end
		flush()
	end
	return { width = W, height = H, count = #items, items = items }
end

local fromRGB = Color3.fromRGB

function Blocks.draw(list, parent, options)
	options = options or {}
	local W, H = list.width, list.height
	local frame = Instance.new("Frame")
	frame.Name = "FrameLabBlocks"
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.ClipsDescendants = true
	frame.Size = UDim2.fromScale(1, 1)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.fromScale(0.5, 0.5)
	if options.KeepAspect ~= false then
		local ar = Instance.new("UIAspectRatioConstraint")
		ar.AspectRatio = W / H
		ar.Parent = frame
	end
	local img = Patterns.image()
	local z = options.ZIndex or 1
	local t0 = os.clock()
	local view = { Frame = frame, alive = true }
	function view.destroy()
		view.alive = false
		frame:Destroy()
	end
	frame.Parent = parent
	-- (built a chunk at a time: ~9000 objects at once would hitch)
	local chunk = Instance.new("Folder")
	for i, it in ipairs(list.items) do
		if not view.alive then
			return view
		end
		local o
		if it.flat then
			o = Instance.new("Frame")
			o.BackgroundColor3 = fromRGB(it.r, it.g, it.b)
			o.Position = UDim2.fromScale(it.x / W, it.y / H)
			o.Size = UDim2.new(it.w / W, 1, it.h / H, 1)
		else
			o = Instance.new("ImageLabel")
			o.BackgroundColor3 = fromRGB(it.a[1], it.a[2], it.a[3])
			o.ImageColor3 = fromRGB(it.b[1], it.b[2], it.b[3])
			o.Image = img
			o.ImageRectOffset = Patterns.rect(it.s, it.idx)
			o.ImageRectSize = Vector2.new(it.s, it.s)
			o.Position = UDim2.fromScale(it.x / W, it.y / H)
			o.Size = UDim2.new(it.s / W, 1, it.s / H, 1)
		end
		o.BorderSizePixel = 0
		o.ZIndex = z
		o.Parent = chunk
		if i % 800 == 0 then
			for _, c in ipairs(chunk:GetChildren()) do
				c.Parent = frame
			end
			if os.clock() - t0 > 0.006 then
				task.wait()
				t0 = os.clock()
			end
		end
	end
	for _, c in ipairs(chunk:GetChildren()) do
		c.Parent = frame
	end
	chunk:Destroy()
	return view
end

return Blocks
]]></string>
            <int64 name="SourceAssetId">-1</int64>
