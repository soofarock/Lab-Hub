            <string name="Source"><![CDATA[--!native
--!optimize 2
-- Texture codec ("RBA4"): short sound effects rebuilt from three kinds of generic, pre-uploaded sound pieces, each started
-- at an exact time:
--   bubbles  short tones that glide (water drops, rings, chirps): one of 120 generic tone shapes, at a speed (sets pitch
--            and length together) and a volume
--   clicks   sharp decaying octave-noise bursts (5 octaves x 3 decays x 3 variants)
--   grains   sine-windowed noise puffs on a fixed grid per band, one volume each: a half-octave set (15 bands, 44 Hz ..
--            5.7 kHz) and a sixth-octave set (34 bands, 40 Hz .. 2 kHz) that gives the lows their exact colour
-- plus a low-pass at the top of the original's own spectrum.
--
--   local bytes, stats = Texture.encode(signal, { Yield = task.wait, Progress = function(stage, frac) end })
--   Texture.isClip(bytes) / Texture.unpack(bytes) -> clip    Texture.LAYOUT (which upload file holds each piece, and where)
-- The generic upload files are tex_tones, tex_clicks, tex_grains2 and tex_loop; a kind in Texture.SplitSeconds is split into
-- tex_<kind>_NN files under that many seconds. Their ids are in Codec.Manifests.Files; Codec.Manifests puts every file of
-- Texture.LAYOUT.allFiles in its Core set (preloaded like the other generic files).
--
-- The analysis splits the sound into its steady tones and its noise (median filters
-- over the spectrogram), finds tone ridges and fits a tone shape to each (spectrogram matching), keeps a tone only if it
-- brings the rebuilt sound closer to the original where it plays AND explains far more than chance (phase-scrambled
-- copies), finds clicks in the noise (0.5 ms energy peaks per octave), and sets the grain volumes from what remains.

local AudioLab = script:FindFirstAncestor("AudioLab")
local FFT = require(AudioLab.DSP.FFT)

local Texture = {}
Texture.Magic = "RBA4"
Texture.Version = 2 -- (v2: two grain sets, tex_grains2)

local R = 48000
local PI = math.pi
local sqrt, log, exp, sin, cos, floor, abs, max, min = math.sqrt, math.log, math.exp, math.sin, math.cos, math.floor, math.abs,
	math.max, math.min
local LN10 = log(10)

-- (constant tables: filters as second-order sections {b0,b1,b2,a1,a2}, grain calibration, upload layout)
local GB_SOS = {{{1.0275881898587514e-12,2.0551763797175028e-12,1.0275881898587514e-12,-1.9979766991034387,0.99801496212575802},{1,2,1,-1.9982361036882139,0.99826531997589174},{1,-2,1,-1.9990604316784835,0.99910654961550938},{1,-2,1,-1.9993275961506209,0.99935186266538178}},{{4.105878421375535e-12,8.2117568427510701e-12,4.105878421375535e-12,-1.9971173931743771,0.99719388755188776},{1,2,1,-1.9974892591773437,0.99754767063958083},{1,-2,1,-1.9986444882447538,0.99873670670609704},{1,-2,1,-1.9990349905552975,0.99908351697432496}},{{1.6398249238773406e-11,3.2796498477546813e-11,1.6398249238773406e-11,-1.9958809676356051,0.99603386665490434},{1,2,1,-1.9964168732761158,0.99653363638544079},{1,-2,1,-1.9980295208559011,0.99821390814203248},{1,-2,1,-1.9986071051383891,0.99870413917195788}},{{6.5450448517451431e-11,1.3090089703490286e-10,6.5450448517451431e-11,-1.9940901115389809,0.99439565509794703},{1,2,1,-1.9948679627387491,0.99510131938188751},{1,-2,1,-1.9971064068068751,0.99747503944386373},{1,-2,1,-1.9979738417959996,0.99816785624732529}},{{2.6099835793929076e-10,5.2199671587858152e-10,2.6099835793929076e-10,-1.9914731150119782,0.99208347968685484},{1,2,1,-1.9926129552616145,0.99307918734623868},{1,-2,1,-1.9956942338534713,0.99643109151774312},{1,-2,1,-1.9970220321954515,0.99740990773519345}},{{1.0394719010753965e-09,2.0789438021507931e-09,1.0394719010753965e-09,-1.9876040890992916,0.98882276445727235},{1,2,1,-1.9892952538305066,0.99022635068421161},{1,-2,1,-1.9934841568177448,0.99495669469265557},{1,-2,1,-1.9955636179043579,0.99633892835173432}},{{4.1324956682255312e-09,8.2649913364510624e-09,4.1324956682255312e-09,-1.9817982600871897,0.98422975906078514},{1,2,1,-1.9843471676919755,0.98620546900061223},{1,-2,1,-1.9899339511243661,0.99287559866756214},{1,-2,1,-1.993276778914651,0.99482612609866261}},{{1.6387813941702644e-08,3.2775627883405288e-08,1.6387813941702644e-08,-1.9729245410869078,0.97777082068956367},{1,2,1,-1.9768404726598465,0.98054596596355459},{1,-2,1,-1.984