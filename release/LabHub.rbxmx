	t14, t9 = (t14 * 3784 + t9 * 1567 + 2048) // 4096, (t14 * 1567 - t9 * 3784 + 2048) // 4096
	t13, t10 = (t13 * 1567 - t10 * 3784 + 2048) // 4096, (-t13 * 3784 - t10 * 1567 + 2048) // 4096
	u, v = t0 + t3, t0 - t3
	t0, t3 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
