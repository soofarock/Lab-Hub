        </Item>
        <Item class="Folder" referent="73">
          <Properties>
            <string name="Name">Server</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <Color3 name="IconTint">
              <R>0</R>
              <G>0</G>
              <B>0</B>
            </Color3>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">Media</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab:init() on the server: makes the FrameLab remotes and answers the clients'
-- requests for videos and pictures. Videos in ServerStorage.FrameLabData (the big ones) never replicate; a client gets
-- only the byte ranges it asks for, while it plays them. Other server runtimes add actions to FrameLab.Server.handlers.
return function(FrameLab)
	local Players = game:GetService("Players")
	local ServerStorage = game:GetService("ServerStorage")
	local root = script:FindFirstAncestor("FrameLab")
	local Net = require(root.Tools.Net)
	local Store = FrameLab.Store
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))
	local remotes = Net.remotes(true)
	if not remotes:FindFirstChild("Cache") then
		local e = Instance.new("RemoteEvent")
		e.Name = "Cache"
		e.Parent = remotes
	end

	local function serverRoot(kind)
		local data = ServerStorage:FindFirstChild("FrameLabData")
		return data and data:FindFirstChild(kind)
	end
	local function roots(kind) -- "Videos" / "Images": the replicated library, then the server-only one
		local list = { root.Data[kind] }
		local s = serverRoot(kind)
		if s then
			table.insert(list, s)
		end
		return list
	end
	-- in-game imports: kept in memory while the server runs ("imported/<name>"); Sounds: their AudioLab clips
	-- ("video/imported/<name>"), sent to a client only when it plays one (clipHead / clipRange)
	local session = { Images = {}, Videos = {}, Sounds = {} }
	local function sessionEntry(kind, name)
		local s = session[kind] and session[kind][name]
		if not s then
			return nil
		end
		return {
			Name = name,
			GetAttribute = function(_, k)
				return s.attrs[k]
			end,
			GetAttributes = function()
				return table.clone(s.attrs)
			end,
		}
	end
	local function find(kind, name)
		local se = sessionEntry(kind, name)
		if se then
			return "session", se
		end
		for _, r in ipairs(roots(kind)) do
			if Store.has(r, name) then
				return r, Store.entry(r, name)
			end
		end
		return nil
	end

	-- recently read entries (decoding a big entry's text is the slow part)
	local cache, order = {}, {}
	local function readEntry(kind, name)
		local key = kind .. "/" .. name
		local c = cache[key]
		if c then
			return c
		end
		local r = find(kind, name)
		if not r then
			return nil
		end
		if r == "session" then
			return session[kind][name].bytes
		end
		c = Store.read(r, name)
		cache[key] = c
		table.insert(order, key)
		if #order > (Config.CachedEntries or 6) then
			cache[table.remove(order, 1)] = nil
		end
		return c
	end

	-- the owner (the place's creator, or rank 254+ in its group), anyone in Admins, and everyone in a Studio test (an
	-- unpublished place has no creator: the one testing is its developer, as for the owner's settings)
	local function isAdmin(player)
		if game:GetService("RunService"):IsStudio() then
			return true
		end
		if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
			return true
		end
		if game.CreatorType == Enum.CreatorType.Group then
			local ok, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
			if ok and rank >= 254 then
				return true
			end
		end
		return Config.listed(player, "Admins")
	end

	local server = { handlers = {}, isAdmin = isAdmin, readEntry = readEntry, find = find, remotes = remotes, urlImages = {}, session = session }
	require(root.Sync).extraEntry = function(name)
		return sessionEntry("Videos", name)
	end
	-- seconds a client needs to download an imported video's sound (~300 KB/s with FrameLab.Net.clip, plus a margin)
	require(root.Sync).soundLoadDelay = function(clip)
		if string.sub(clip, 1, 7) == "stream/" then
			return 0 -- (a stream's sound comes in parts as it plays: it joins the picture when its part is in)
		end
		local s = session.Sounds[clip]
		if not s then
			return 0
		end
		local size = typeof(s.bytes) == "buffer" and buffer.len(s.bytes) or #tostring(s.bytes)
		return math.clamp(size / 300000 + 0.7, 0.5, 6)
	end

	local function listOf(kind)
		local out, seen = {}, {}
		local names = {}
		for name in pairs(session[kind]) do
			table.insert(names, name)
		end
		table.sort(names)
		for _, name in ipairs(names) do
			seen[name] = true
			local a = session[kind][name].attrs
			table.insert(out, { name = name, Width = a.Width, Height = a.Height, Seconds = a.Seconds, Fps = a.Fps, Bytes = a.Bytes, Audio = a.Audio, Server = true, Imported = true })
		end
		for i, r in ipairs(roots(kind)) do
			for _, name in ipairs(Store.list(r)) do
				if not seen[name] then
					seen[name] = true
					local e = Store.entry(r, name)
					local a = e and e:GetAttributes() or {}
					table.insert(out, { name = name, Width = a.Width, Height = a.Height, Seconds = a.Seconds, Fps = a.Fps, Bytes = a.Bytes, Audio = a.Audio, Server = i > 1 })
				end
			end
		end
		return out
	end

	local h = server.handlers
	h.videos = function()
		return listOf("Videos")
	end
	h.images = function()
		return listOf("Images")
	end
	h.isAdmin = function(player)
		return isAdmin(player) == true
	end
	-- a video's header (an FLV2 one: header and chunk directory). A video kept at several sizes (FLVS) answers for one of
	-- them: the largest at most `lines` tall, or number `index`; base is where its bytes start in the entry (videoRange
	-- offsets are the entry's), renditions lists them all ({ width, height, bytesPerSecond })
	h.videoHead = function(_, name, lines, index, direct)
		if type(name) ~= "string" then
			return nil
		end
		local se = session.Videos[name]
		if se and se.live then
			-- a stream: its header and directory (the chunks are made as they are asked for: liveChunk / liveRange)
			local live = se.live
			local list = {}
			for k, sz in ipairs(live.sizes) do
				list[k] = { width = sz.w, height = sz.h, bytesPerSecond = (sz.kbps or 60) * 1024 }
			end
			if direct == "blocks" and live.blocksHead then
				-- the block player's own picture, worked out here (Video.BlockStream: rendition -1)
				return { live = true, blocks = true, size = 0, head = live.blocksHead(), base = 0, rendition = -1,
					renditions = list, source = { width = live.width, height = live.height }, attrs = table.clone(se.attrs) }
			end
			if direct == true then
				-- unconverted: the client decodes the segments itself (rendition 0)
				return { live = true, direct = true, size = 0, head = live.rawHead(), base = 0, rendition = 0, renditions = list,
					source = { width = live.width, height = live.height }, attrs = table.clone(se.attrs) }
			end
			local i = tonumber(index) or require(root.Video.Flv2).pick(list, tonumber(lines) or 360)
			i = math.clamp(math.floor(i), 1, #list)
			return { live = true, size = 0, head = live.head(i), base = 0, rendition = i, renditions = list,
				attrs = table.clone(se.attrs) }
		end
		local bytes = readEntry("Videos", name)
		if not bytes then
			return nil
		end
		if buffer.len(bytes) >= 8 and buffer.readstring(bytes, 0, 4) == "FLVS" then
			local Flv2 = require(root.Video.Flv2)
			local list = Flv2.readSet(bytes)
			local i = tonumber(index) or Flv2.pick(list, tonumber(lines) or 360)
			i = math.clamp(math.floor(i), 1, #list)
			local e = list[i]
			local headLen = math.min(e.size, 24 + buffer.readu16(bytes, e.offset + 16) * 16)
			local head = buffer.create(headLen)
			buffer.copy(head, 0, bytes, e.offset, headLen)
			local renditions = {}
			for k, r in ipairs(list) do
				renditions[k] = { width = r.width, height = r.height, bytesPerSecond = r.bytesPerSecond }
			end
			local _, entry = find("Videos", name)
			return { size = e.size, head = head, base = e.offset, rendition = i, renditions = renditions,
				attrs = entry and entry:GetAttributes() or {} }
		end
		local headLen = 24
		if buffer.readstring(bytes, 0, 4) == "FLV2" then
			headLen = 24 + buffer.readu16(bytes, 16) * 16
		else
			headLen = math.min(buffer.len(bytes), 20 + buffer.readu16(bytes, 16) * 16)
		end
		local head = buffer.create(headLen)
		buffer.copy(head, 0, bytes, 0, headLen)
		local _, e = find("Videos", name)
		return { size = buffer.len(bytes), head = head, attrs = e and e:GetAttributes() or {} }
	end
	h.videoRange = function(_, name, offset, len)
		if type(name) ~= "string" or type(offset) ~= "number" or type(len) ~= "number" then
			return nil
		end
		local bytes = readEntry("Videos", name)
		if not bytes then
			return nil
		end
		offset = math.floor(offset)
		len = math.clamp(math.floor(len), 0, Net.RANGE)
		if offset < 0 or offset >= buffer.len(bytes) then
			return nil
		end
		len = math.min(len, buffer.len(bytes) - offset)
		local out = buffer.create(len)
		buffer.copy(out, 0, bytes, offset, len)
		return out
	end
	-- a stream's chunk (Tools.Live): { sizeA, sizeB } when it is made, false while it is being made, a message when it
	-- failed; then its bytes in ranges
	h.liveChunk = function(_, name, r, ci)
		local se = type(name) == "string" and session.Videos[name]
		if not (se and se.live) or type(r) ~= "number" or type(ci) ~= "number" then
			return nil
		end
		if math.floor(r) == -1 then
			-- a piece of the block picture (Video.BlockStream)
			local data, why = se.live.blockPiece(math.floor(ci))
			if data then
				return { sizeA = buffer.len(data), sizeB = 0 }
			end
			return why and tostring(why) or false
		end
		if math.floor(r) == 0 then
			-- a whole segment, unconverted
			local raw, offset = se.live.rawChunk(math.floor(ci))
			if raw then
				return { sizeA = buffer.len(raw), sizeB = 0, offset = offset }
			end
			return offset and tostring(offset) or false
		end
		local data, a, b = se.live.chunk(math.floor(r), math.floor(ci))
		if data then
			return { sizeA = a, sizeB = b }
		end
		if a then
			return tostring(a)
		end
		return false
	end
	h.liveRange = function(_, name, r, ci, offset, len)
		local se = type(name) == "string" and session.Videos[name]
		if not (se and se.live) or type(r) ~= "number" or type(ci) ~= "number" or type(offset) ~= "number" or type(len) ~= "number" then
			return nil
		end
		local data
		if math.floor(r) == -1 then
			data = se.live.blockPiece(math.floor(ci))
		elseif math.floor(r) == 0 then
			data = se.live.rawChunk(math.floor(ci))
		else
			data = se.live.chunk(math.floor(r), math.floor(ci))
		end
		if not data then
			return nil
		end
		offset = math.floor(offset)
		len = math.clamp(math.floor(len), 0, Net.RANGE)
		if offset < 0 or offset >= buffer.len(data) then
			return nil
		end
		len = math.min(len, buffer.len(data) - offset)
		local out = buffer.create(len)
		buffer.copy(out, 0, data, offset, len)
		return out
	end

	-- a stream kept in this server's session, named after its file
	local function addStream(live, url, file, qName, player)
		local base = "imported/" .. string.sub(string.gsub(file, "[^%w%-_ ]", "_"), 1, 40)
		local name, n = base, 2
		while find("Videos", name) do
			name = base .. "-" .. n
			n += 1
		end
		session.Videos[name] = { live = live, attrs = { Width = live.sizes[1].w, Height = live.sizes[1].h, Fps = live.fps,
			Frames = live.frames, Seconds = live.seconds, Url = url, Live = true, Bytes = 0, Quality = qName,
			ImportedBy = player and player.UserId or 0,
			-- (its sound: AudioLab clips made part by part, which clients fetch as it plays: FrameLab.Video.StreamSound)
			Audio = live.hasSound and ("clip:stream/" .. name) or nil } }
		local result = { name = name, kind = "video", width = live.sizes[1].w, height = live.sizes[1].h, seconds = live.seconds,
			bytes = 0, stream = true }
		if server.onImported then
			task.spawn(pcall, server.onImported, result, url, qName, player) -- (its record and picture, for the data manager)
		end
		return result
	end

	-- stream mode (the TV's Stream switch): an MP4 / MOV or VP9 / VP8 WebM address that sends byte ranges plays in parts as it
	-- is watched, never downloaded whole (Tools.Live.openMp4 / openWebm)
	local function startMp4Stream(url, qName, player)
		local Importer = FrameLab.Importer
		local live = require(root.Tools.Live).openMp4(url, {
			MaxLines = Config.StreamMaxSourceLines or 400,
			MaxSeconds = Config.StreamMaxSeconds or 7200,
			Workers = Config.ImportWorkers or 4,
			Sizes = function(w, h)
				return Importer.videoSizes(w, h, qName)
			end,
		})
		local path = string.gsub(url, "[?#].*$", "")
		local file = string.match(path, "([^/]+)%.%w+$") or string.match(path, "([^/]+)$") or "stream"
		return addStream(live, url, file, qName, player)
	end

	-- a stream's sound, part by part (Tools.Live.sound): { size, start } when the part's clip is made, false while it is
	-- being made, a message for a part without sound (or that failed); then its bytes in ranges
	h.liveSound = function(_, name, si)
		local se = type(name) == "string" and session.Videos[name]
		if not (se and se.live and se.live.hasSound) or type(si) ~= "number" then
			return "none"
		end
		local clip, start = se.live.sound(math.floor(si))
		if clip then
			return { size = buffer.len(clip), start = start }
		end
		return start and tostring(start) or false
	end
	h.liveSoundRange = function(_, name, si, offset, len)
		local se = type(name) == "string" and session.Videos[name]
		if not (se and se.live) or type(si) ~= "number" or type(offset) ~= "number" or type(len) ~= "number" then
			return nil
		end
		local clip = se.live.sound(math.floor(si))
		if not clip then
			return nil
		end
		offset = math.floor(offset)
		len = math.clamp(math.floor(len), 0, Net.RANGE)
		if offset < 0 or offset >= buffer.len(clip) then
			return nil
		end
		len = math.min(len, buffer.len(clip) - offset)
		local out = buffer.create(len)
		buffer.copy(out, 0, clip, offset, len)
		return out
	end

	-- an HLS address (.m3u8): a stream the server converts as it is watched (Tools.Live), kept in this server's session
	local function startStream(url, text, qName, player)
		local Importer = FrameLab.Importer
		local q = Importer.quality(qName)
		local live = require(root.Tools.Live).open(url, text, {
			Lines = q.lines,
			MaxSeconds = Config.StreamMaxSeconds or 7200,
			Workers = Config.ImportWorkers or 4,
			Sizes = function(w, h)
				return Importer.videoSizes(w, h, qName)
			end,
		})
		-- named after the playlist (or its folder, for index / master / playlist)
		local path = string.gsub(url, "[?#].*$", "")
		local file = string.match(path, "([^/]+)%.m3u8?$") or "stream"
		local lowFile = string.lower(file)
		if lowFile == "index" or lowFile == "master" or lowFile == "playlist" or lowFile == "prog_index" or lowFile == "main" then
			file = string.match(path, "([^/]+)/[^/]+$") or file
		end
		return addStream(live, url, file, qName, player)
	end

	-- each client's video memory (FrameLab.Net.cacheUsage, sent when it changes), for the admins' data manager
	local cacheReports = {}
	h.cacheReport = function(player, u)
		if type(u) ~= "table" then
			return nil
		end
		cacheReports[player] = { video = tonumber(u.video) or 0, limit = tonumber(u.limit) or 0, streams = tonumber(u.streams) or 0,
			pictures = tonumber(u.pictures) or 0, sounds = tonumber(u.sounds) or 0, memory = tonumber(u.memory) or 0,
			luau = tonumber(u.luau) or 0 }
		return true
	end
	h.cacheList = function(player)
		if not isAdmin(player) then
			return nil
		end
		local out = {}
		for _, p in ipairs(Players:GetPlayers()) do
			local r = cacheReports[p] or {}
			table.insert(out, { userId = p.UserId, name = p.Name, display = p.DisplayName, video = r.video or 0, limit = r.limit or 0,
				streams = r.streams or 0, pictures = r.pictures or 0, sounds = r.sounds or 0, memory = r.memory or 0,
				luau = r.luau or 0, reported = r.video ~= nil })
		end
		table.sort(out, function(a, b)
			return a.video > b.video
		end)
		return out
	end
	-- userId: one player's client, nil: everyone's
	h.cacheClear = function(player, userId)
		if not isAdmin(player) then
			return nil
		end
		local ev = remotes:FindFirstChild("Cache")
		if userId == nil then
			ev:FireAllClients("clear")
			return true
		end
		local target = Players:GetPlayerByUserId(tonumber(userId) or 0)
		if target then
			ev:FireClient(target, "clear")
			return true
		end
		return false
	end
	h.clipHead = function(_, path)
		local s = type(path) == "string" and session.Sounds[path]
		return s and { size = buffer.len(s.bytes) } or nil
	end
	h.clipRange = function(_, path, offset, len)
		local s = type(path) == "string" and session.Sounds[path]
		if not s or type(offset) ~= "number" or type(len) ~= "number" then
			return nil
		end
		local bytes = s.bytes
		offset = math.floor(offset)
		len = math.clamp(math.floor(len), 0, Net.RANGE)
		if offset < 0 or offset >= buffer.len(bytes) then
			return nil
		end
		len = math.min(len, buffer.len(bytes) - offset)
		local out = buffer.create(len)
		buffer.copy(out, 0, bytes, offset, len)
		return out
	end
	h.image = function(_, key)
		if type(key) ~= "string" then
			return nil
		end
		if string.sub(key, 1, 4) == "lib:" then
			return readEntry("Images", string.sub(key, 5))
		elseif string.sub(key, 1, 4) == "url:" then
			local u = server.urlImages[key]
			return u and u.bytes
		end
		return nil
	end

	-- YouTube links go through the VideoLab YouTube helper (yt-dlp + ffmpeg in a small program of your own: see
	-- VideoLab's helper folder). It answers 202 while it works, so this asks again until the MP4 is ready.
	local function youtubeId(url)
		local host = string.lower(string.match(url, "^https?://([^/:?#]+)") or "")
		host = string.gsub(string.gsub(string.gsub(host, "^www%.", ""), "^m%.", ""), "^music%.", "")
		local id
		if host == "youtu.be" then
			id = string.match(url, "^https?://[^/]+/([%w_%-]+)")
		elseif host == "youtube.com" or host == "youtube-nocookie.com" then
			id = string.match(url, "[?&]v=([%w_%-]+)") or string.match(url, "/shorts/([%w_%-]+)")
				or string.match(url, "/embed/([%w_%-]+)") or string.match(url, "/live/([%w_%-]+)")
		end
		return id and #id == 11 and id or nil, host == "youtube.com" or host == "youtu.be" or host == "youtube-nocookie.com"
	end
	local function fetchYouTube(id, size, onWait)
		local HttpService = game:GetService("HttpService")
		local base = string.gsub(tostring(Config.YouTubeHelper or "http://localhost:8787"), "/+$", "")
		local q = ("%s/fetch?id=%s&size=%d&seconds=%d&key=%s"):format(base, id, size or 256, Config.ImportMaxSeconds or 120,
			HttpService:UrlEncode(tostring(Config.YouTubeHelperKey or "")))
		local t0 = os.clock()
		while true do
			local ok, r = pcall(HttpService.RequestAsync, HttpService, { Url = q, Method = "GET" })
			if not ok then
				local local_ = string.find(base, "localhost", 1, true) or string.find(base, "127.0.0.1", 1, true)
				return nil, ("the YouTube helper at %s didn't answer: start it (start-windows.bat in the helper folder)%s (%s)"):format(base,
					(local_ and not game:GetService("RunService"):IsStudio()) and "; a live server can't reach localhost, so give YouTubeHelper a public address" or "",
					tostring(r))
			end
			if r.StatusCode == 202 then
				if onWait then
					onWait()
				end
				if os.clock() - t0 > 900 then
					return nil, "the YouTube helper is still working after 15 minutes"
				end
				task.wait(2)
			elseif r.Success then
				return r
			else
				local okJ, j = pcall(HttpService.JSONDecode, HttpService, r.Body)
				return nil, "YouTube: " .. ((okJ and type(j) == "table" and j.error) or ("the helper answered " .. r.StatusCode))
			end
		end
	end

	-- admins: import a picture or a video from a web address, kept in memory while the server runs
	local importing = false
	-- how far the import is: attribute ImportStatus on the FrameLab remotes folder ("" when none runs), which the TV's
	-- panel shows, e.g. "42% - video - 31 s"; the server's output gets each step's time when it ends
	local statusAt = 0
	local function setStatus(text, force)
		if force or os.clock() - statusAt > 0.25 then
			statusAt = os.clock()
			remotes:SetAttribute("ImportStatus", text)
		end
	end
	-- quality: "144p" / "240p" / "360p" (FrameLab.Importer.Qualities) or nil for Config.ImportVideoQuality
	-- stream: true (the TV's Stream switch) plays an MP4 / MOV in parts as it is watched instead of importing it whole
	h.importUrl = function(player, kind, url, quality, stream) -- player nil: server code (FrameLab.Server.importUrl)
		if player ~= nil and not isAdmin(player) then
			return { error = "only admins can import" }
		end
		if quality ~= nil and (type(quality) ~= "string" or not FrameLab.Importer.Qualities[quality]) then
			quality = nil
		end
		local q, qName = FrameLab.Importer.quality(quality)
		if kind ~= "image" and kind ~= "video" then
			return { error = "import a picture or a video" }
		end
		if type(url) ~= "string" or #url > 2000 or not string.match(url, "^https?://[%w%.%-]+") then
			return { error = "that isn't a web address (http:// or https://)" }
		end
		if kind == "image" then
			local allowed, why = Config.imageUrlAllowed(url)
			if not allowed then
				return { error = why }
			end
		end
		if importing then
			return { error = "another import is running, try again in a moment" }
		end
		importing = true
		local tStart = os.clock()
		local timing = {}
		setStatus("0% - downloading", true)
		local ok, res = pcall(function()
			local HttpService = game:GetService("HttpService")
			local host = string.match(url, "^https?://([^/:?#]+)") or url
			local ytId, isYouTube = youtubeId(url)
			if isYouTube and not ytId then
				return { error = "that YouTube link has no video in it (use a watch, youtu.be or shorts link)" }
			end
			local okHttp, r
			if ytId then
				-- (the helper shrinks to fit a size x size box: the long side of the quality)
				local res2, err2 = fetchYouTube(ytId, math.ceil(q.lines * 16 / 9), function()
					setStatus(("0%% - the YouTube helper is downloading - %d s"):format(os.clock() - tStart))
				end)
				if not res2 then
					return { error = err2 }
				end
				okHttp, r = true, res2
			elseif stream == true and kind == "video" and not string.find(string.lower(url), "%.m3u8") then
				-- stream mode; a site that sends no byte ranges: imported whole instead
				setStatus("reading the video's header", true)
				local okS, resS = pcall(startMp4Stream, url, qName, player)
				if okS then
					return resS
				end
				local noRanges = string.find(tostring(resS), "byte ranges", 1, true) ~= nil
				if not noRanges and not string.find(tostring(resS), "imported whole", 1, true) then
					return { error = tostring(resS) }
				end
				local reason = string.find(tostring(resS), "stream mode's", 1, true) and "too big to stream"
					or noRanges and "the site can't stream it" or "it can't be streamed"
				-- (the file's size first, from one byte of it: a file over ImportMaxBytes isn't downloaded at all)
				local size
				if not noRanges then
					local okR, rr = pcall(HttpService.RequestAsync, HttpService, { Url = url, Method = "GET",
						Headers = { Range = "bytes=0-0" } })
					if okR and rr.StatusCode == 206 then
						for k, v in pairs(rr.Headers or {}) do
							if string.lower(k) == "content-range" then
								size = tonumber(string.match(v, "/(%d+)"))
							end
						end
					elseif okR and rr.Success then
						okHttp, r = okR, rr -- (the whole file came: the site ignored the range)
					end
				end
				local limit = Config.ImportMaxBytes or 8388608
				if size and size > limit then
					local dims = string.match(tostring(resS), "^(%d+x%d+) ")
					return { error = ("%s%s, and at %.1f MB it's over the import limit (%.0f MB, ImportMaxBytes): use a smaller copy (up to %dp streams)"):format(
						dims and (dims .. " is ") or "", reason, size / 1048576, limit / 1048576, Config.StreamMaxSourceLines or 400) }
				end
				if not r then
					-- (the import's own progress takes over once it is here)
					local label = ("%s: downloading it whole%s"):format(reason, size and (" (%.1f MB)"):format(size / 1048576) or "")
					local downloading = true
					task.spawn(function()
						while downloading do
							setStatus(("%s - %d s"):format(label, os.clock() - tStart), true)
							task.wait(1)
						end
					end)
					okHttp, r = pcall(HttpService.RequestAsync, HttpService, { Url = url, Method = "GET" })
					downloading = false
				end
			else
				okHttp, r = pcall(HttpService.RequestAsync, HttpService, { Url = url, Method = "GET" })
			end
			if not okHttp then
				local raw = tostring(r)
				local low = string.lower(raw)
				local why
				if string.find(low, "not enabled", 1, true) then
					why = "HTTP requests are off for this game: turn on Game Settings > Security > Allow HTTP Requests"
				elseif string.find(low, "roblox", 1, true) and string.find(low, "not allowed", 1, true) then
					why = "Roblox doesn't let games download from its own sites (" .. host .. "): use a picture uploaded somewhere else, or the Decal ID tab"
				elseif string.find(low, "dns", 1, true) or string.find(low, "resolve", 1, true) then
					why = "couldn't find the site " .. host .. " (check the address)"
				elseif string.find(low, "timeout", 1, true) or string.find(low, "timed out", 1, true) then
					why = host .. " took too long to answer"
				elseif string.find(low, "number of requests exceeded", 1, true) then
					why = "too many downloads this minute: try again in a moment"
				elseif string.find(low, "trust", 1, true) or string.find(low, "ssl", 1, true) or string.find(low, "certificate", 1, true) then
					why = host .. "'s secure connection failed (bad certificate)"
				else
					why = "the download failed"
				end
				return { error = ("%s (%s)"):format(why, raw) }
			end
			if not r.Success then
				local code = r.StatusCode
				local hint = ""
				if code == 404 or code == 410 then
					hint = string.find(host, "discord", 1, true)
							and ": Discord links expire after about a day, so copy a fresh one"
						or ": the file isn't there (check the link)"
				elseif code == 403 or code == 401 then
					hint = string.find(host, "discord", 1, true) and ": the Discord link expired or is private, so copy a fresh one"
						or ": the site won't share it (it may need a login, or block downloads from games)"
				elseif code == 429 then
					hint = ": the site is limiting downloads, so try again later"
				elseif code >= 500 then
					hint = ": the site is having trouble, so try again later"
				end
				local msg = tostring(r.StatusMessage or "")
				return { error = ("%s answered %d%s%s"):format(host, code, msg ~= "" and (" " .. msg) or "", hint) }
			end
			if #r.Body == 0 then
				return { error = host .. " sent an empty file" }
			end
			if kind == "video" and require(root.Tools.Live).isPlaylist(r.Body) then
				setStatus("reading the stream's playlist", true)
				return startStream(url, r.Body, qName, player)
			end
			local maxBytes = Config.ImportMaxBytes or 8388608
			if #r.Body > maxBytes then
				return { error = ("that file is %.1f MB; the limit is %.1f MB (ImportMaxBytes)"):format(#r.Body / 1048576, maxBytes / 1048576) }
			end
			local ctype = r.Headers and (r.Headers["content-type"] or r.Headers["Content-Type"]) or nil
			local fileName = string.match(url, "([^/?#]+)[?#]?[^/]*$") or "import"
			fileName = string.gsub(fileName, "%%(%x%x)", function(hex) -- "%28" -> "("
				return string.char(tonumber(hex, 16))
			end)
			if ytId then
				-- named after the video's title (the helper sends it URL-encoded)
				local title = r.Headers and (r.Headers["x-title"] or r.Headers["X-Title"]) or ""
				title = string.gsub(title, "%%(%x%x)", function(hex)
					return string.char(tonumber(hex, 16))
				end)
				title = string.sub(string.gsub(title, "[^%w%-_ ]", ""), 1, 40)
				fileName = (title ~= "" and title or ytId) .. ".mp4"
			end
			timing.download = os.clock() - tStart
			local tImport = os.clock()
			local result
			local okImp, err = pcall(function()
				result = FrameLab.Importer.importFile(fileName, buffer.fromstring(r.Body), {
					Timing = timing,
					-- (the picture takes most of the time: video 0 - 80 %, the sound 80 - 100 %)
					Progress = function(stage, f)
						local pct = stage == "video" and f * 80 or 80 + f * 20
						setStatus(("%d%% - %s - %d s"):format(math.floor(pct), stage, os.clock() - tStart))
					end,
					Folder = "imported", MaxImage = Config.ImportMaxPicture or 320, MaxSeconds = Config.ImportMaxSeconds or 120,
					Quality = qName,
					Log = function() end,
					Taken = function(name)
						return find("Videos", name) ~= nil or find("Images", name) ~= nil
					end,
					Sink = function(k, name, bytes, attrs)
						attrs.Bytes = buffer.len(bytes)
						attrs.Url = url
						attrs.ImportedBy = player and player.UserId or 0
						session[k][name] = { bytes = bytes, attrs = attrs }
					end,
				})
			end)
			timing.import = os.clock() - tImport
			if not okImp then
				local msg = FrameLab.Importer.cleanError(err)
				if ctype and string.find(msg, "FrameLab reads", 1, true) then
					msg ..= (" (the site said it's %s)"):format(ctype)
				end
				return { error = msg }
			end
			if (kind == "image") ~= (result.kind == "image") then
				return { error = ("that's a %s, not a %s"):format(result.kind == "image" and "picture" or "video", kind == "image" and "picture" or "video"), name = result.name, kind = result.kind }
			end
			-- the data manager keeps a record of it (Runtime/Server/Library)
			if server.onImported then
				local okRec, errRec = pcall(server.onImported, result, url, qName, player)
				if not okRec then
					warn("[FrameLab] library record: " .. tostring(errRec))
				end
			end
			return { name = result.name, kind = result.kind, width = result.width, height = result.height, seconds = result.seconds, bytes = result.bytes }
		end)
		importing = false
		setStatus("", true)
		local parts = {}
		for _, k in ipairs({ "download", "video", "sound decode", "sound encode" }) do
			if timing[k] then
				table.insert(parts, ("%s %.1f s"):format(k, timing[k]))
			end
		end
		if Config.Debug then
			print(("[FrameLab] import of %s took %.1f s: %s"):format(url, os.clock() - tStart, table.concat(parts, ", ")))
		end
		if not ok then
			return { error = tostring(res) }
		end
		return res
	end

	-- a few requests a second per player is plenty for playback (a 60 KB range is ~2 s of video)
	local budget = {}
	remotes.Media.OnServerInvoke = function(player, action, ...)
		local b = budget[player]
		local now = os.clock()
		if not b or now - b.t > 1 then
			b = { t = now, n = 0 }
			budget[player] = b
		end
		b.n += 1
		if b.n > (Config.RequestsPerSecond or 30) then
			return nil
		end
		local fn = type(action) == "string" and h[action]
		if not fn then
			return nil
		end
		local ok, res = pcall(fn, player, ...)
		if not ok then
			warn("[FrameLab] " .. tostring(action) .. " failed: " .. tostring(res))
			return nil
		end
		return res
	end
	Players.PlayerRemoving:Connect(function(p)
		budget[p] = nil
		cacheReports[p] = nil
	end)

	-- server code (VideoLab.importUrl): the same import, without the admin check
	server.importUrl = function(kind, url, quality, stream)
		return h.importUrl(nil, kind, url, quality, stream)
	end
	server.listOf = listOf
	-- a jump on a screen showing a stream (FrameLabServer, on a seek): the segment there starts downloading at once,
	-- before the clients ask for it
	server.prefetch = function(name, seconds)
		local se = type(name) == "string" and session.Videos[name]
		local live = se and se.live
		if not live or type(seconds) ~= "number" then
			return
		end
		local f = math.floor(math.max(0, seconds) * live.fps)
		local si = 1
		for i, sg in ipairs(live.raw) do
			if sg.k0 <= f then
				si = i
			else
				break
			end
		end
		live.rawChunk(si)
		if live.hasSound then
			live.sound(si) -- (its sound too)
		end
	end

	FrameLab.Server = server
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">FrameLabServer</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab:init() on the server, the same way AudioLabServer works for sound. The
-- server never decodes video: it keeps the playback STATE of synced screens (attributes, see FrameLab.Sync) and every
-- client plays that state itself on the server's playhead.
--
-- 1. Auto-start: an instance tagged "FrameLab" with FrameLabSynced = true and FrameLabAutoPlay = true (set in Studio with
--    FrameLabVideo, FrameLabLoop, FrameLabStartTime, FrameLabSpeed...) starts when the server starts, or when it is
--    added later. Players who join afterwards start in the right place.
-- 2. Client control: ReplicatedStorage.FrameLabSyncRemotes.SyncControl lets a client play / pause / resume / seek / ...
--    a screen it owns (FrameLabOwner = its UserId, e.g. its TV) or one with FrameLabClientControl = true
--    (FrameLab.Sync.request on the client). Requests are validated and rate-limited, and
--    `Sync.authorize(player, target, action, arg)` (set by any server script) can veto them.
-- Other server scripts drive video directly: require(ReplicatedStorage.LabHub.FrameLab.Sync).play(part, { Video = ... }).
return function(FrameLab)
	local CollectionService = game:GetService("CollectionService")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Players = game:GetService("Players")
	local root = script:FindFirstAncestor("FrameLab")
	local Sync = require(root.Sync)
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))

	-- 1. auto-start
	local function autoStart(instance)
		if instance:GetAttribute("FrameLabSynced") ~= true or instance:GetAttribute("FrameLabAutoPlay") ~= true then
			return
		end
		if Sync.state(instance) ~= nil then
			return
		end
		Sync.play(instance, {
			StartTime = instance:GetAttribute("FrameLabStartTime") or 0,
			Speed = instance:GetAttribute("FrameLabSpeed") or 1,
			Delay = 0,
		})
	end
	CollectionService:GetInstanceAddedSignal(Sync.Tag):Connect(autoStart)
	for _, instance in ipairs(CollectionService:GetTagged(Sync.Tag)) do
		task.spawn(autoStart, instance)
	end

	-- 2. client requests
	local remotes = ReplicatedStorage:FindFirstChild("FrameLabSyncRemotes")
	if not remotes then
		remotes = Instance.new("Folder")
		remotes.Name = "FrameLabSyncRemotes"
		remotes.Parent = ReplicatedStorage
	end
	local control = remotes:FindFirstChild("SyncControl")
	if not control then
		control = Instance.new("RemoteEvent")
		control.Name = "SyncControl"
		control.Parent = remotes
	end

	local recent = {}
	local function allowed(player, limit)
		local now = os.clock()
		local r = recent[player]
		if not r or now - r[1] >= 1 then
			r = { now, 0 }
			recent[player] = r
		end
		r[2] += 1
		return r[2] <= limit
	end
	Players.PlayerRemoving:Connect(function(player)
		recent[player] = nil
	end)

	local function sanitizePlay(arg)
		if type(arg) ~= "table" then
			return nil
		end
		local v = arg.Video
		if type(v) ~= "string" or #v == 0 or #v > 200 or string.find(v, "..", 1, true) or not Sync.videoEntry(v) then
			return nil
		end
		local o = { Video = v }
		if type(arg.Loop) == "boolean" then
			o.Loop = arg.Loop
		end
		if type(arg.Sound) == "boolean" then
			o.Sound = arg.Sound
		end
		local function num(key, lo, hi)
			local n = arg[key]
			if type(n) == "number" and n == n then
				return math.clamp(n, lo, hi)
			end
			return nil
		end
		o.Speed, o.StartTime = num("Speed", 0.25, 4), num("StartTime", 0, 36000)
		return o
	end

	local ACTIONS = {
		pause = function(inst) Sync.pause(inst) end,
		resume = function(inst) Sync.resume(inst) end,
		toggle = function(inst)
			local st = Sync.state(inst)
			if st and st.state == "playing" then
				Sync.pause(inst)
			else
				Sync.resume(inst)
			end
		end,
		stop = function(inst) Sync.stop(inst) end,
		restart = function(inst)
			Sync.seek(inst, 0)
			local st = Sync.state(inst)
			if st and st.state ~= "playing" then
				Sync.resume(inst)
			end
		end,
		-- (a playing screen's playhead waits at the new spot until the controller's picture is there: "ready")
		seek = function(inst, n)
			local srv = FrameLab.Server
			if srv and srv.prefetch then
				pcall(srv.prefetch, inst:GetAttribute("FrameLabVideo"), n) -- (a stream: its segment there, downloading now)
			end
			Sync.seek(inst, math.max(n, 0), Config.SeekHold or 8)
		end,
		ready = function(inst, n) Sync.release(inst, n) end,
		-- the controller's picture is stuck loading while it plays: the playhead waits where it is (a held seek to the
		-- spot), like a video player buffering
		stall = function(inst)
			local st = Sync.state(inst)
			if st and st.state == "playing" and inst:GetAttribute("FrameLabHold") == nil then
				local d = inst:GetAttribute("FrameLabDuration") or 0
				Sync.seek(inst, Sync.getTime(inst, { duration = d, loop = inst:GetAttribute("FrameLabLoop") == true }), Config.SeekHold or 8)
			end
		end,
		setSpeed = function(inst, n) Sync.setSpeed(inst, math.clamp(n, 0.25, 4)) end,
	}
	local NEEDS_NUMBER = { seek = true, setSpeed = true, ready = true }

	control.OnServerEvent:Connect(function(player, target, action, arg)
		if type(action) ~= "string" or not allowed(player, Config.ControlPerSecond or 8) then
			return
		end
		if typeof(target) ~= "Instance" or not target:IsDescendantOf(workspace) then
			return
		end
		local owner = target:GetAttribute("FrameLabOwner")
		local mayControl = (owner ~= nil and owner == player.UserId) or target:GetAttribute("FrameLabClientControl") == true
		if not mayControl then
			return
		end
		if Sync.authorize then
			local ok, verdict = pcall(Sync.authorize, player, target, action, arg)
			if not ok or verdict == false then
				return
			end
		end
		if action == "play" then
			local opts = sanitizePlay(arg)
			if opts then
				Sync.play(target, opts)
			end
			return
		end
		local handler = ACTIONS[action]
		if not handler then
			return
		end
		if NEEDS_NUMBER[action] and (type(arg) ~= "number" or arg ~= arg or math.abs(arg) == math.huge) then
			return
		end
		handler(target, arg)
	end)
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">TV</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab.init() on the server: placed TVs. Clicking with the TV tool drops the TV (it leaves the hand,
-- lands in front of the player and grows) and makes it that player's synced FrameLab screen (FrameLab.Sync, owner =
-- the player): its owner picks what it plays through FrameLabServer, everyone sees it through FrameLabClient. Picking
-- it up gives the tool back.
return function(FrameLab)
	local Players = game:GetService("Players")
	local root = script:FindFirstAncestor("FrameLab")
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))
	local Sync = require(root.Sync)
	-- the TV that gets set down: built once from LabHub.Blueprints.tv (Instancer), then cloned
	local template
	local function tvTemplate()
		if not template then
			local hub = root.Parent
			template = require(hub.Instancer).build(require(hub.Blueprints).tv)
		end
		return template
	end
	task.spawn(tvTemplate)
	while not FrameLab.Server do
		task.wait()
	end
	local server = FrameLab.Server
	local remote = server.remotes.TV

	local folder = workspace:FindFirstChild("FrameLabTVs")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "FrameLabTVs"
		folder.Parent = workspace
	end

	local function tvsOf(player)
		local list = {}
		for _, tv in ipairs(folder:GetChildren()) do
			if tv:GetAttribute("FrameLabOwner") == player.UserId then
				table.insert(list, tv)
			end
		end
		return list
	end

	-- the TV tool goes here while its TV stands in the world (picking the TV up gives it back)
	local ServerStorage = game:GetService("ServerStorage")
	local RunService = game:GetService("RunService")
	local TweenService = game:GetService("TweenService")
	local held = ServerStorage:FindFirstChild("FrameLabHeldTools")
	if not held then
		held = Instance.new("Folder")
		held.Name = "FrameLabHeldTools"
		held.Parent = ServerStorage
	end
	local function heldToolOf(player)
		for _, t in ipairs(held:GetChildren()) do
			if t:GetAttribute("HeldBy") == player.UserId then
				return t
			end
		end
	end

	-- the screen takes the shape of what it plays (a 9:16 short gets a tall screen, 21:9 a wide one), as big as fits
	-- inside the TV's own screen, centred; the black backing fills the rest (letterbox / pillarbox bars)
	local function reshape(tv)
		local screen = tv:FindFirstChild("Screen")
		local baseSize = screen and screen:GetAttribute("BaseSize")
		local baseOffset = screen and screen:GetAttribute("BaseOffset")
		if typeof(baseSize) ~= "Vector3" or typeof(baseOffset) ~= "CFrame" then
			return
		end
		local w, h = baseSize.X, baseSize.Y
		local name = tv:GetAttribute("FrameLabVideo")
		local entry = tv:GetAttribute("FrameLabState") ~= "stopped" and name and Sync.videoEntry(name)
		local vw = entry and entry:GetAttribute("Width")
		local vh = entry and entry:GetAttribute("Height")
		if vw and vh and vw > 0 and vh > 0 then
			local aspect = vw / vh
			if aspect >= w / h then
				h = w / aspect
			else
				w = h * aspect
			end
		end
		local key = ("%.3f,%.3f"):format(w, h)
		if screen:GetAttribute("ShapeKey") == key then
			return
		end
		screen:SetAttribute("ShapeKey", key)
		local goal = tv:GetPivot() * baseOffset
		TweenService:Create(screen, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Size = Vector3.new(w, h, baseSize.Z), CFrame = goal }):Play()
	end

	-- like the classic gear that drops itself: the TV leaves the hand where it is, lands in front of the player
	-- facing them, and grows to full size
	local function drop(player)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local tool = char and char:FindFirstChildOfClass("Tool")
		if not hrp or not hum or hum.Health <= 0 or not tool or not tool:GetAttribute("FrameLabTV") then
			return
		end
		local handle = tool:FindFirstChild("Handle")
		local from = handle and handle.CFrame or hrp.CFrame
		-- the spot: ahead of the player (further for a bigger TV), on whatever is below it
		local scale = Config.TVScale or 3
		local size = tvTemplate().Body.Size * scale
		local ahead = hrp.Position + (hrp.CFrame.LookVector * Vector3.new(1, 0, 1)).Unit * (size.Z / 2 + 2.5 + size.Y / 2) -- far enough back to see the screen
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { char, folder }
		local hit = workspace:Raycast(ahead + Vector3.new(0, 4, 0), Vector3.new(0, -40, 0), params)
		local ground = hit and hit.Position or (ahead - Vector3.new(0, hum.HipHeight + hrp.Size.Y / 2, 0))
		local face = (hrp.Position - ground) * Vector3.new(1, 0, 1)
		if face.Magnitude < 0.1 then
			face = -hrp.CFrame.LookVector
		end
		local to = CFrame.lookAt(ground, ground + face.Unit)
		for _, old in ipairs(tvsOf(player)) do
			Sync.stop(old) -- picture and sound
			old:Destroy()
		end
		tool:SetAttribute("HeldBy", player.UserId)
		tool.Parent = held
		local tv = tvTemplate():Clone()
		Sync.setOwner(tv, player) -- the owner controls it through FrameLab.Sync (FrameLabServer checks)
		tv:SetAttribute("OwnerName", player.DisplayName)
		-- its sound is heard at full volume out to the TV's own size (then fades: AudioLab's Range), not Roblox's
		-- default falloff, which made a big TV quiet from where you watch it
		tv:SetAttribute("AudioLabRange", math.max(size.X, size.Y))
		tv.Name = player.Name .. "_TV"
		-- the TV's pivot is its bottom centre; start where the handle was
		tv:PivotTo(from)
		tv.Parent = folder
		local body = tv:FindFirstChild("Body")
		local puff = body and body:FindFirstChild("Puff")
		local t, T = 0, 0.6
		local conn
		conn = RunService.Heartbeat:Connect(function(dt)
			if not tv.Parent then
				conn:Disconnect()
				return
			end
			t = math.min(T, t + dt)
			local a = t / T
			local e = 1 - (1 - a) * (1 - a) -- ease out
			tv:ScaleTo(1 + (scale - 1) * e)
			tv:PivotTo(from:Lerp(to, e))
			if t >= T then
				conn:Disconnect()
				-- ScaleTo scales the prompt's reach too: set it once the TV is full size, reachable from where you stand
				local prompt = body and body:FindFirstChild("Change")
				if prompt then
					prompt.MaxActivationDistance = math.max(12, size.Z / 2 + size.Y / 2 + 10)
				end
				local screen = tv:FindFirstChild("Screen")
				if screen then
					screen:SetAttribute("BaseSize", screen.Size)
					screen:SetAttribute("BaseOffset", tv:GetPivot():ToObjectSpace(screen.CFrame))
					tv:GetAttributeChangedSignal("FrameLabSeq"):Connect(function()
						reshape(tv)
					end)
					reshape(tv)
				end
				if puff then
					puff:Emit(25)
				end
			end
		end)
	end

	local last = {}
	remote.OnServerEvent:Connect(function(player, action, a)
		local now = os.clock()
		if last[player] and now - last[player] < 0.3 then
			return
		end
		last[player] = now
		if action == "drop" then
			drop(player)
		elseif action == "remove" then
			-- pick the TV up: the tool comes back (unless they got a new one when they respawned)
			if typeof(a) ~= "Instance" or a.Parent ~= folder or a:GetAttribute("FrameLabOwner") ~= player.UserId then
				return
			end
			Sync.stop(a) -- picture and sound
			a:Destroy()
			local tool = heldToolOf(player)
			if tool then
				local backpack = player:FindFirstChildOfClass("Backpack")
				local has = false
				for _, place in ipairs({ backpack, player.Character }) do
					for _, t in ipairs(place and place:GetChildren() or {}) do
						if t:IsA("Tool") and t:GetAttribute("FrameLabTV") then
							has = true
						end
					end
				end
				if has or not backpack then
					tool:Destroy()
				else
					tool:SetAttribute("HeldBy", nil)
					tool.Parent = backpack
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		last[player] = nil
		for _, tv in ipairs(tvsOf(player)) do
			Sync.stop(tv)
			tv:Destroy()
		end
		local tool = heldToolOf(player)
		if tool then
			tool:Destroy()
		end
	end)
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">Spray</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab:init() on the server: Spray Paint. A spray is a thin invisible part on the surface that was
-- sprayed (welded to it when it moves), holding what to show:
--   Kind "decal": a Roblox decal / image id, shown with a normal Decal (Roblox-moderated, like the original gear)
--   Kind "image": a FrameLab library picture ("lib:<name>"), drawn by each client with strips (Runtime/Client/Spray)
--   Kind "url":   a picture an admin loaded from a web address ("url:<n>"), drawn the same way
-- Loading from a URL is for admins only (the FrameLab folder's Admins attribute, and the place owner): those pictures skip Roblox's
-- moderation, so whoever loads them is responsible for them.
return function(FrameLab)
	local Players = game:GetService("Players")
	local HttpService = game:GetService("HttpService")
	local MarketplaceService = game:GetService("MarketplaceService")
	local InsertService = game:GetService("InsertService")
	local root = script:FindFirstAncestor("FrameLab")
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))
	while not FrameLab.Server do
		task.wait()
	end
	local server = FrameLab.Server
	local remote = server.remotes.Spray

	local folder = workspace:FindFirstChild("FrameLabSprays")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "FrameLabSprays"
		folder.Parent = workspace
	end

	-- decal id -> image texture ("rbxassetid://<image id>"); a decal's own id doesn't work as a texture at runtime
	local textures = {}
	local function textureOf(id)
		if textures[id] ~= nil then
			return textures[id]
		end
		local result = false
		local ok, info = pcall(MarketplaceService.GetProductInfoAsync, MarketplaceService, id, Enum.InfoType.Asset)
		if ok and info then
			if info.AssetTypeId == 1 then -- already an image
				result = "rbxassetid://" .. id
			elseif info.AssetTypeId == 13 then -- a decal: its image
				local ok2, model = pcall(InsertService.LoadAsset, InsertService, id)
				if ok2 and model then
					local d = model:FindFirstChildWhichIsA("Decal", true)
					if d then
						result = d.Texture
					end
					model:Destroy()
				end
				if not result then
					-- the image is usually uploaded just before the decal, by the same creator
					for k = 1, 8 do
						local ok3, i2 = pcall(MarketplaceService.GetProductInfoAsync, MarketplaceService, id - k, Enum.InfoType.Asset)
						if ok3 and i2 and i2.AssetTypeId == 1 and i2.Creator and info.Creator and i2.Creator.Id == info.Creator.Id then
							result = "rbxassetid://" .. (id - k)
							break
						end
					end
				end
			end
		end
		textures[id] = result
		return result
	end

	-- admins: load a picture from a web address
	local urlCount = 0
	local byUrl = {}
	server.handlers.loadUrl = function(player, url)
		if not server.isAdmin(player) then
			return { error = "only admins can load pictures from a URL" }
		end
		if type(url) ~= "string" or #url > 2000 or not string.match(url, "^https?://[%w%.%-]+") then
			return { error = "that isn't a web address (http:// or https://)" }
		end
		local allowed, why = Config.imageUrlAllowed(url)
		if not allowed then
			return { error = why }
		end
		if byUrl[url] then
			local u = server.urlImages[byUrl[url]]
			return { key = byUrl[url], width = u.width, height = u.height }
		end
		local ok, res = pcall(HttpService.RequestAsync, HttpService, { Url = url, Method = "GET" })
		if not ok then
			return { error = "couldn't fetch it: " .. tostring(res) }
		end
		if not res.Success then
			return { error = ("the site answered %d %s"):format(res.StatusCode, tostring(res.StatusMessage)) }
		end
		local body = res.Body
		if #body > (Config.UrlMaxBytes or 4194304) then
			return { error = "that file is too big" }
		end
		local size = Config.UrlPictureSize or 160
		local ok2, image = pcall(FrameLab.decodeImage, buffer.fromstring(body), url, { MaxSize = size, Yield = true })
		if not ok2 then
			return { error = "not a picture FrameLab reads (PNG, JPG, BMP, TGA, GIF)" }
		end
		image = FrameLab.Resize.fit(image, size, size, true)
		local packed = FrameLab.Importer.packImage(image)
		urlCount += 1
		local key = "url:" .. urlCount
		server.urlImages[key] = { bytes = packed, width = image.width, height = image.height, url = url, by = player.UserId }
		byUrl[url] = key
		return { key = key, width = image.width, height = image.height }
	end

	local mine = {} -- player -> { spray parts, oldest first }
	local last = {}

	local function addSpray(player, part)
		local list = mine[player] or {}
		mine[player] = list
		table.insert(list, part)
		while #list > (Config.SprayMaxPerPlayer or 10) do
			local old = table.remove(list, 1)
			old:Destroy()
		end
		local life = Config.SprayLifetime or 300
		if life > 0 then
			task.delay(life, function()
				if part.Parent then
					part:Destroy()
				end
				local l = mine[player]
				if l then
					local i = table.find(l, part)
					if i then
						table.remove(l, i)
					end
				end
			end)
		end
	end

	remote.OnServerEvent:Connect(function(player, choice, size, pos, normal, target)
		local now = os.clock()
		if last[player] and now - last[player] < (Config.SprayCooldown or 1.5) then
			return
		end
		if type(choice) ~= "table" or type(size) ~= "number" or typeof(pos) ~= "Vector3" or typeof(normal) ~= "Vector3" then
			return
		end
		if typeof(target) ~= "Instance" or not target:IsA("BasePart") or not target:IsDescendantOf(workspace) then
			return
		end
		if target:IsDescendantOf(folder) or (workspace:FindFirstChild("FrameLabTVs") and target:IsDescendantOf(workspace.FrameLabTVs)) then
			return
		end
		local model = target:FindFirstAncestorOfClass("Model")
		if model and model:FindFirstChildOfClass("Humanoid") then
			return -- not on players or NPCs
		end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 or (hrp.Position - pos).Magnitude > (Config.SprayRange or 14) + 4 then
			return
		end
		if normal.Magnitude < 0.5 then
			return
		end
		normal = normal.Unit
		local original = size == 0 -- "O": sized from the picture's own pixels, drawn at full resolution
		size = math.clamp(size, 2, 10)

		-- what to show
		local kind, key, aspect = nil, nil, 1
		if choice.Kind == "decal" then
			local id = tonumber(choice.Value)
			if not id or id <= 0 or id ~= math.floor(id) then
				return
			end
			local tex = textureOf(id)
			if not tex then
				return
			end
			kind, key = "decal", tex
		elseif choice.Kind == "image" and type(choice.Value) == "string" then
			local r, entry = server.find("Images", choice.Value)
			if not r then
				return
			end
			kind, key = "image", "lib:" .. choice.Value
			aspect = (entry:GetAttribute("Height") or 1) / math.max(1, entry:GetAttribute("Width") or 1)
		elseif choice.Kind == "url" and type(choice.Value) == "string" then
			local u = server.urlImages[choice.Value]
			if not u or not server.isAdmin(player) then
				return
			end
			kind, key = "url", choice.Value
			aspect = u.height / math.max(1, u.width)
		else
			return
		end
		last[player] = now

		if original then
			local pw, ph
			if kind == "image" then
				local _, entry = server.find("Images", string.sub(key, 5))
				pw, ph = entry and entry:GetAttribute("Width"), entry and entry:GetAttribute("Height")
			elseif kind == "url" then
				local u = server.urlImages[key]
				pw, ph = u and u.width, u and u.height
			end
			local longest = math.max(pw or 0, ph or 0)
			-- (up to ~21 studs: a 512-pixel picture at 24 pixels a stud)
			size = longest > 0 and math.clamp(longest / (Config.SprayOriginalPixelsPerStud or 24), 3, 22) or 10
		end
		local w, h = size, size
		if aspect > 1 then
			w = size / aspect
		else
			h = size * aspect
		end
		-- facing out of the surface; "up" follows the world, or the player's view on floors and ceilings
		local up = Vector3.yAxis
		if math.abs(normal.Y) > 0.9 then
			up = (hrp.CFrame.LookVector * Vector3.new(1, 0, 1))
			if up.Magnitude < 0.1 then
				up = Vector3.zAxis
			end
			up = up.Unit
			if normal.Y < 0 then
				up = -up
			end
		end
		local p = Instance.new("Part")
		p.Name = "Spray"
		p.Size = Vector3.new(w, h, 0.05)
		p.CFrame = CFrame.lookAt(pos + normal * 0.03, pos + normal * 2, up)
		p.Transparency = 1
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Massless = true
		p:SetAttribute("Kind", kind)
		p:SetAttribute("Key", key)
		p:SetAttribute("Owner", player.UserId)
		if original then
			p:SetAttribute("Original", true)
		end
		if kind == "decal" then
			local d = Instance.new("Decal")
			d.Face = Enum.NormalId.Front
			d.Texture = key
			d.Parent = p
		end
		if target.Anchored then
			p.Anchored = true
		else
			p.Anchored = false
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = target
			weld.Part1 = p
			weld.Parent = p
		end
		p.Parent = folder
		addSpray(player, p)
		local tool = char:FindFirstChildOfClass("Tool")
		local sound = tool and tool:FindFirstChild("Handle") and tool.Handle:FindFirstChildOfClass("Sound")
		if sound then
			sound:Play()
			task.delay(1.2, function()
				sound:Stop()
			end)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		last[player] = nil
		for _, p in ipairs(mine[player] or {}) do
			p:Destroy()
		end
		mine[player] = nil
	end)
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">Library</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab:init() on the server: the data manager's server side (admins only).
-- In-game imports live in the server's memory (Runtime/Server/Media) and are gone when it closes. The library keeps a
-- small record of each in a DataStore instead of the data itself: where it came from (the URL), its kind, quality,
-- size, length, who imported it, and a thumbnail that fits 64 x 64. A record whose data isn't in memory can be
-- imported again from its URL with one click (Load).
--
-- Requests (FrameLab.Net, remotes.Media): libList, libThumb(id), libDelete(id), libLoad(id), libStats,
-- libSetStore(on)
-- The DataStore is OFF by default (Config.LibraryDataStore = false): records live only in this server's memory. An
-- admin turns it on in the data manager (the "DataStore" switch, for this server) or sets the attribute to true.
-- Config.LibraryStore: the DataStore's name
return function(FrameLab)
	local Players = game:GetService("Players")
	local HttpService = game:GetService("HttpService")
	local EncodingService = game:GetService("EncodingService")
	local root = script:FindFirstAncestor("FrameLab")
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))
	local Stream = require(root.Video.Stream)
	local ImportJob = require(root.Tools.ImportJob)

	-- the media runtime makes FrameLab.Server
	local t0 = os.clock()
	while not FrameLab.Server and os.clock() - t0 < 30 do
		task.wait(0.1)
	end
	local server = FrameLab.Server
	if not server then
		warn("[FrameLab] library: the media runtime didn't start")
		return
	end
	local h, session, isAdmin = server.handlers, server.session, server.isAdmin

	-- the DataStores, or nil: switched off (the default), or not available (no API access). Records are kept one
	-- per key (store: "rec/<id>", "thumb/<id>"), and an OrderedDataStore holds id -> import time, which lists them
	-- newest first a page at a time (no single key that grows with every import)
	local store, ordered, storeError
	local function openStore()
		store, ordered, storeError = nil, nil, nil
		local name = Config.LibraryStore
		if type(name) ~= "string" or name == "" then
			name = "FrameLabLibrary_v1"
		end
		local ok, err = pcall(function()
			local DSS = game:GetService("DataStoreService")
			store = DSS:GetDataStore(name)
			ordered = DSS:GetOrderedDataStore(name .. "_order")
		end)
		if not ok then
			store, ordered, storeError = nil, nil, tostring(err)
		end
	end
	if Config.LibraryDataStore == true then
		openStore()
	end

	-- records: id -> { id, kind, name, url, quality, seconds, width, height, bytes, by, byName, at, tw, th }
	local records = {}
	local loadedIndex = false
	-- the newest Config.LibraryListSize (50) records, read once per server (each record is one GetAsync)
	local reading = false
	local function readIndex()
		if loadedIndex or not store or reading then
			return
		end
		reading = true
		local ok, err = pcall(function()
			local want = Config.LibraryListSize or 50
			local pages = ordered:GetSortedAsync(false, math.min(want, 100))
			local ids = {}
			while true do
				for _, e in ipairs(pages:GetCurrentPage()) do
					table.insert(ids, e.key)
				end
				if #ids >= want or pages.IsFinished then
					break
				end
				pages:AdvanceToNextPageAsync()
			end
			for i = 1, math.min(#ids, want) do
				local id = ids[i]
				if not records[id] then
					local r = store:GetAsync("rec/" .. id)
					if type(r) == "table" and type(r.url) == "string" then
						records[id] = r
					end
				end
			end
		end)
		reading = false
		if ok then
			loadedIndex = true
		else
			storeError = tostring(err)
		end
	end
	-- keep one record (and its place in the order)
	local function writeIndex(id)
		local r = records[id]
		if not store or not r then
			return
		end
		local ok, err = pcall(function()
			store:SetAsync("rec/" .. id, r)
			ordered:SetAsync(id, math.floor(r.at or os.time()))
		end)
		if not ok then
			storeError = tostring(err)
			warn("[FrameLab] library: couldn't save a record: " .. tostring(err))
		end
	end
	local function deleteRecord(id)
		records[id] = nil
		if store then
			pcall(function()
				ordered:RemoveAsync(id)
				store:RemoveAsync("rec/" .. id)
				store:RemoveAsync("thumb/" .. id)
			end)
		end
	end
	task.spawn(readIndex) -- (nothing while the DataStore is off)

	-- a thumbnail: the picture fitted into 64 x 64, RGB, zstd, base64 (a few KB)
	local function thumbOf(image)
		local small = FrameLab.Resize.fit(image, 64)
		local w, hgt = small.width, small.height
		local rgb = buffer.create(w * hgt * 3)
		for i = 0, w * hgt - 1 do
			buffer.writeu8(rgb, i * 3, buffer.readu8(small.data, i * 4))
			buffer.writeu8(rgb, i * 3 + 1, buffer.readu8(small.data, i * 4 + 1))
			buffer.writeu8(rgb, i * 3 + 2, buffer.readu8(small.data, i * 4 + 2))
		end
		local z = EncodingService:CompressBuffer(rgb, Enum.CompressionAlgorithm.Zstd, 9)
		return buffer.tostring(EncodingService:Base64Encode(z)), w, hgt
	end

	-- a picture of an imported video: the frame a tenth of the way in
	local function videoFrame(bytes)
		local reader = Stream.reader(bytes, { Decompress = function(b)
			return EncodingService:DecompressBuffer(b, Enum.CompressionAlgorithm.Zstd)
		end })
		local target = math.floor(reader.frameCount * 0.1)
		if target > 0 then
			reader:seek(target)
		else
			reader:advance()
		end
		if reader.render then
			reader.render()
		end
		local W, H, pw = reader.width, reader.height, reader.pw
		local data = buffer.create(W * H * 4)
		for y = 0, H - 1 do
			buffer.copy(data, y * W * 4, reader.rgba, y * pw * 4, W * 4)
		end
		return { width = W, height = H, data = data }
	end

	-- a picture of a stream (Tools.Live): a second into its first part (downloaded when it started)
	local function streamFrame(live)
		local bytes, offset = live.rawChunk(1)
		if not bytes then
			error("its first part isn't here", 0)
		end
		local k0 = live.raw[1].k0
		local k1 = live.raw[2] and live.raw[2].k0 or live.frames
		local s = math.min(1, 160 / math.max(live.width, live.height))
		local tw, th = math.max(1, math.floor(live.width * s)), math.max(1, math.floor(live.height * s))
		local got
		pcall(ImportJob.tsFrames, bytes, k0, k1, offset, live.fps, { { w = tw, h = th } }, function(_, imgs)
			got = imgs[1]
			error("enough", 0)
		end, nil, math.min(k1 - 1, k0 + live.fps))
		if not got then
			error("no picture in its first part", 0)
		end
		return got
	end

	local thumbs = {} -- id -> { data, w, h } (this server's copy)

	-- AudioLab imports (sounds: a clip under AudioLab's Data/Clips; music: a MIDI (and SoundFont) under Data/Files)
	local function audioImporter()
		local AL = game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):FindFirstChild("AudioLab")
		return AL and AL:FindFirstChild("Tools") and AL.Tools:FindFirstChild("Importer") and require(AL.Tools.Importer)
	end
	local function isAudio(r)
		return r.kind == "sound" or r.kind == "music"
	end
	local function audioLoaded(r)
		local ok, yes = pcall(function()
			local I = audioImporter()
			if not I then
				return false
			end
			if r.kind == "sound" then
				return I.hasClip(r.path)
			end
			return I.has(r.path .. "/" .. r.name .. ".mid")
		end)
		return ok and yes == true
	end
	-- remove an AudioLab import's stored data (the node at path under root)
	local function dropPath(rootInst, path)
		local node = rootInst
		for seg in string.gmatch(path, "[^/]+") do
			node = node and node:FindFirstChild(seg)
		end
		if node and node ~= rootInst then
			node:Destroy()
		end
	end

	-- the session entry of a record (or nil: not in memory)
	local function loadedName(r)
		if isAudio(r) then
			return audioLoaded(r) and r.name or nil
		end
		local kind = r.kind == "image" and "Images" or "Videos"
		if r.name and session[kind][r.name] and session[kind][r.name].attrs.Url == r.url then
			return r.name
		end
		for name, e in pairs(session[kind]) do
			if e.attrs.Url == r.url and (e.attrs.Quality == r.quality or r.kind == "image") then
				return name
			end
		end
		return nil
	end

	-- after each import (Media calls it): a record for it, with its thumbnail
	server.onImported = function(result, url, quality, player)
		local kind = result.kind == "image" and "image" or "video"
		local e = session[kind == "image" and "Images" or "Videos"][result.name]
		if not e then
			return
		end
		readIndex()
		local id
		for rid, r in pairs(records) do
			if r.url == url and r.kind == kind and (kind == "image" or r.quality == quality) then
				id = rid
			end
		end
		id = id or HttpService:GenerateGUID(false)
		local r = {
			id = id, kind = kind, name = result.name, url = url, quality = kind == "video" and quality or nil,
			seconds = result.seconds, width = result.width, height = result.height, bytes = result.bytes,
			by = player and player.UserId or 0, byName = player and player.Name or "server", at = os.time(),
			stream = result.stream == true or nil,
		}
		local function makeThumb()
			local ok, err = pcall(function()
				local img = kind == "image" and FrameLab.unpackImage(e.bytes) or (e.live and streamFrame(e.live)) or videoFrame(e.bytes)
				local data, w, hgt = thumbOf(img)
				thumbs[id] = { data = data, w = w, h = hgt }
				r.tw, r.th = w, hgt
				if store then
					store:SetAsync("thumb/" .. id, data)
				end
			end)
			if not ok and Config.Debug then
				warn("[FrameLab] library: no thumbnail for " .. tostring(result.name) .. ": " .. tostring(err))
			end
		end
		records[id] = r
		if e.live then
			-- (a stream's picture is decoded after it has started playing, not before)
			task.spawn(function()
				makeThumb()
				if r.tw then
					writeIndex(id)
				end
			end)
		else
			makeThumb()
		end
		writeIndex(id)
	end

	-- after each AudioLab import (AudioLab's import server calls it): a record, no thumbnail
	server.onAudioImported = function(info)
		readIndex()
		local id
		for rid, r in pairs(records) do
			if r.kind == info.kind and r.path == info.path then
				id = rid
			end
		end
		id = id or HttpService:GenerateGUID(false)
		records[id] = {
			id = id, kind = info.kind, name = info.name, path = info.path, url = info.url, soundFontUrl = info.soundFontUrl,
			seconds = info.seconds, bytes = info.bytes, detail = info.detail,
			by = info.player and info.player.UserId or 0, byName = info.player and info.player.Name or "server", at = os.time(),
		}
		writeIndex(id)
	end

	local function sizeOf(e)
		if e.live and e.live.held then
			return e.live.held() -- (a stream: the parts it holds right now)
		end
		return typeof(e.bytes) == "buffer" and buffer.len(e.bytes) or 0
	end

	-- the DataStore switch (this server; the default comes from Config.LibraryDataStore)
	h.libSetStore = function(player, on)
		if not isAdmin(player) then
			return nil
		end
		if on == true then
			if not store then
				openStore()
				if store then
					-- this server's records join the kept ones
					local mine = records
					records = {}
					loadedIndex = false
					readIndex()
					for id, r in pairs(mine) do
						records[id] = r
						local t = thumbs[id]
						if t then
							pcall(store.SetAsync, store, "thumb/" .. id, t.data)
						end
						writeIndex(id)
					end
				end
			end
		else
			store, storeError = nil, nil
			-- (kept records that aren't in memory leave the list; this server's own stay)
			for id, r in pairs(records) do
				if not loadedName(r) then
					records[id] = nil
				end
			end
			loadedIndex = false
		end
		return { on = store ~= nil, storeError = storeError }
	end

	h.libStats = function(player)
		if not isAdmin(player) then
			return nil
		end
		local n, total = 0, 0
		for _, kind in ipairs({ "Videos", "Images", "Sounds" }) do
			for _, e in pairs(session[kind]) do
				n += 1
				total += sizeOf(e)
			end
		end
		return { entries = n, bytes = total, records = store ~= nil, storeError = storeError }
	end

	-- everything: this server's imports (loaded) and the kept records (loaded or not)
	h.libList = function(player)
		if not isAdmin(player) then
			return nil
		end
		readIndex()
		local out, seen = {}, {}
		for id, r in pairs(records) do
			local name = loadedName(r)
			local e = name and session[r.kind == "image" and "Images" or "Videos"][name]
			local soundBytes = 0
			if e and e.attrs.Audio then
				local s = session.Sounds[string.sub(e.attrs.Audio, 6)]
				soundBytes = s and sizeOf(s) or 0
			end
			if name then
				seen[name] = true
			end
			table.insert(out, {
				id = id, kind = r.kind, name = name or r.name, url = r.url, quality = r.quality, seconds = r.seconds,
				width = r.width, height = r.height, by = r.byName, at = r.at, loaded = name ~= nil,
				bytes = e and (sizeOf(e) + soundBytes) or r.bytes, kept = store ~= nil, thumb = r.tw ~= nil, detail = r.detail,
				soundFontUrl = r.soundFontUrl, stream = r.stream == true or (e ~= nil and e.live ~= nil),
			})
		end
		for kind, k in pairs({ Videos = "video", Images = "image" }) do
			for name, e in pairs(session[kind]) do
				if not seen[name] then
					local a = e.attrs
					table.insert(out, {
						id = "session:" .. kind .. ":" .. name, kind = k, name = name, url = a.Url, quality = a.Quality,
						seconds = a.Seconds, width = a.Width, height = a.Height, loaded = true, bytes = sizeOf(e), kept = false,
						stream = e.live ~= nil,
					})
				end
			end
		end
		table.sort(out, function(a, b)
			return (a.at or math.huge) > (b.at or math.huge)
		end)
		return out
	end

	h.libThumb = function(player, id)
		if not isAdmin(player) or type(id) ~= "string" then
			return nil
		end
		local t = thumbs[id]
		if not t and store and records[id] then
			local ok, v = pcall(store.GetAsync, store, "thumb/" .. id)
			if ok and type(v) == "string" then
				t = { data = v, w = records[id].tw, h = records[id].th }
				thumbs[id] = t
			end
		end
		if not t then
			return nil
		end
		local ok, rgb = pcall(function()
			return EncodingService:DecompressBuffer(EncodingService:Base64Decode(buffer.fromstring(t.data)), Enum.CompressionAlgorithm.Zstd)
		end)
		return ok and { w = t.w, h = t.h, rgb = rgb } or nil
	end

	-- remove: from this server's memory (picture / video and its sound) and from the records
	h.libDelete = function(player, id)
		if not isAdmin(player) or type(id) ~= "string" then
			return { error = "only admins" }
		end
		local kind, name
		local sk, sn = string.match(id, "^session:(%a+):(.+)$")
		if sk then
			kind, name = sk, sn
		else
			readIndex()
			local r = records[id]
			if r and isAudio(r) then
				-- an AudioLab import: its stored clip / MIDI and SoundFont go too
				pcall(function()
					local I = audioImporter()
					if I then
						if r.kind == "sound" then
							dropPath(I.clipsRoot(), r.path)
						else
							dropPath(I.filesRoot(), r.path)
						end
					end
				end)
				deleteRecord(id)
				return { ok = true }
			end
			if r then
				kind = r.kind == "image" and "Images" or "Videos"
				name = loadedName(r)
				thumbs[id] = nil
				deleteRecord(id)
			end
		end
		if kind and name and session[kind] and session[kind][name] then
			local e = session[kind][name]
			if e.attrs.Audio then
				session.Sounds[string.sub(e.attrs.Audio, 6)] = nil
			end
			session[kind][name] = nil
		end
		return { ok = true }
	end

	-- load a kept record that isn't in memory: import it again from its URL
	h.libLoad = function(player, id)
		if not isAdmin(player) or type(id) ~= "string" then
			return { error = "only admins" }
		end
		readIndex()
		local r = records[id]
		if not r then
			return { error = "no such record" }
		end
		if loadedName(r) then
			return { ok = true, name = loadedName(r) }
		end
		if isAudio(r) then
			return { error = "import it again from the music player's Import (Studio): its URL is under URL" }
		end
		return h.importUrl(player, r.kind, r.url, r.quality, r.stream == true)
	end

	Players.PlayerRemoving:Connect(function() end)
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">Settings</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab:init() on the server: the settings panel's server side (the game's owner only; anyone in a
-- Studio test). The settings are the attributes on the FrameLab and AudioLab folders. Changes apply at once (they
-- replicate); Save keeps them in a DataStore, and every server applies the saved ones when it starts, over the place's
-- own values. Clear removes the saved ones (the place's values come back on the next server).
--
-- Requests: settingsGet, settingsSet(folder, key, value), settingsSave, settingsClear, settingsDefault(folder, key)
return function(FrameLab)
	local RunService = game:GetService("RunService")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local root = script:FindFirstAncestor("FrameLab")
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))

	local STORE, KEY = "LabSettings_v1", "settings"

	-- the settings: FrameLab's (Config.Defaults) and AudioLab's
	local AUDIO = {
		{ key = "Manifest", default = "Lean", choices = { "Lean", "Full", "Atlas" }, note = "sound set: Lean (the shared uploads), Full (plus your own extra uploads) or Atlas (your own atlas)" },
		{ key = "Debug", default = false, note = "testing aids: logs, the old comparison versions in the music player" },
	}
	local SKIP = {}
	-- FrameLab settings with a fixed set of values (a dropdown in the panel)
	local CHOICES = {
		SprayPerformanceMode = { "auto", "on", "off" },
		ImportVideoQuality = { "144p", "240p", "360p" },
		TVToolAccess = { "everyone", "admins", "owner", "list", "nobody" },
		SprayToolAccess = { "everyone", "admins", "owner", "list", "nobody" },
	}
	-- lists of people (UserIds or names, comma-separated): edited as a list in the panel
	local PEOPLE = { Admins = true, ToolAccessList = true }
	local function folders()
		return { FrameLab = root, AudioLab = game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):FindFirstChild("AudioLab") }
	end
	local function schema()
		local list = {}
		local keys = {}
		for k in pairs(Config.Defaults) do
			if not SKIP[k] then
				table.insert(keys, k)
			end
		end
		table.sort(keys)
		for _, k in ipairs(keys) do
			table.insert(list, { folder = "FrameLab", key = k, default = Config.Defaults[k], choices = CHOICES[k], people = PEOPLE[k] })
		end
		if folders().AudioLab then
			for _, s in ipairs(AUDIO) do
				table.insert(list, { folder = "AudioLab", key = s.key, default = s.default, choices = s.choices, note = s.note })
			end
		end
		return list
	end
	local function find(folder, key)
		for _, s in ipairs(schema()) do
			if s.folder == folder and s.key == key then
				return s
			end
		end
		return nil
	end
	local function valueOf(s)
		local f = folders()[s.folder]
		local v = f and f:GetAttribute(s.key)
		if v == nil then
			v = s.default
		end
		return v
	end

	local store, storeError
	local ok, err = pcall(function()
		store = game:GetService("DataStoreService"):GetDataStore(STORE)
	end)
	if not ok then
		storeError = tostring(err)
	end
	local saved -- the saved table, or nil

	-- the saved settings, over the place's (every server, at start)
	local function apply(t)
		if type(t) ~= "table" then
			return
		end
		for folderName, values in pairs(t) do
			local f = folders()[folderName]
			if f and type(values) == "table" then
				for k, v in pairs(values) do
					local s = find(folderName, k)
					if s and typeof(v) == typeof(s.default) then
						f:SetAttribute(k, v)
					end
				end
			end
		end
	end
	-- read in the background, so requests are answered from the start; a request that needs the saved settings waits
	-- for the read (up to 10 s)
	local loaded = store == nil
	if store then
		task.spawn(function()
			local okG, v = pcall(store.GetAsync, store, KEY)
			if okG then
				saved = v
				apply(v)
			else
				storeError = tostring(v)
			end
			loaded = true
		end)
	end
	local function whenLoaded()
		local t = os.clock()
		while not loaded and os.clock() - t < 10 do
			task.wait(0.1)
		end
	end

	local function isOwner(player)
		if RunService:IsStudio() then
			return true
		end
		if game.CreatorType == Enum.CreatorType.User then
			return player.UserId == game.CreatorId
		end
		local okR, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
		return okR and rank >= 255
	end

	local t0 = os.clock()
	while not FrameLab.Server and os.clock() - t0 < 30 do
		task.wait(0.1)
	end
	if not FrameLab.Server then
		return
	end
	local h = FrameLab.Server.handlers

	h.settingsGet = function(player)
		if not isOwner(player) then
			return { owner = false }
		end
		whenLoaded()
		local items = {}
		for _, s in ipairs(schema()) do
			local sv = nil
			if type(saved) == "table" and type(saved[s.folder]) == "table" then
				sv = saved[s.folder][s.key]
			end
			table.insert(items, {
				folder = s.folder, key = s.key, value = valueOf(s), default = s.default, kind = s.people and "people" or typeof(s.default),
				choices = s.choices, note = s.note, saved = sv ~= nil, changed = sv ~= nil and sv ~= valueOf(s),
			})
		end
		return { owner = true, items = items, store = store ~= nil and storeError == nil, storeError = storeError, hasSaved = saved ~= nil }
	end

	h.settingsSet = function(player, folder, key, value)
		whenLoaded() -- (a change made before the saved settings arrive would be overwritten by them)
		if not isOwner(player) then
			return { error = "only the owner" }
		end
		local s = find(folder, key)
		if not s then
			return { error = "no such setting" }
		end
		if typeof(value) ~= typeof(s.default) then
			return { error = ("%s takes a %s"):format(key, typeof(s.default)) }
		end
		if type(value) == "number" and (value ~= value or math.abs(value) == math.huge) then
			return { error = "not a number" }
		end
		if s.choices and not table.find(s.choices, value) then
			return { error = "pick one of: " .. table.concat(s.choices, ", ") }
		end
		folders()[folder]:SetAttribute(key, value)
		return { ok = true, value = value }
	end

	-- people: a name or a UserId -> { userId, name } (Roblox's lookups, cached)
	local Players = game:GetService("Players")
	local nameCache, idCache = {}, {}
	local function nameOf(id)
		if nameCache[id] == nil then
			local p = Players:GetPlayerByUserId(id)
			if p then
				nameCache[id] = p.Name
			else
				local okN, n = pcall(Players.GetNameFromUserIdAsync, Players, id)
				nameCache[id] = okN and n or false
			end
		end
		return nameCache[id] or nil
	end
	local function idOf(name)
		local key = string.lower(name)
		if idCache[key] == nil then
			for _, p in ipairs(Players:GetPlayers()) do
				if string.lower(p.Name) == key or string.lower(p.DisplayName) == key then
					idCache[key] = p.UserId
					nameCache[p.UserId] = p.Name
				end
			end
			if idCache[key] == nil then
				local okI, id = pcall(Players.GetUserIdFromNameAsync, Players, name)
				idCache[key] = okI and id or false
			end
		end
		return idCache[key] or nil
	end
	h.settingsResolve = function(player, text)
		if not isOwner(player) or type(text) ~= "string" then
			return nil
		end
		text = string.gsub(text, "^%s*@?(.-)%s*$", "%1")
		local id = tonumber(text)
		if id then
			local n = nameOf(id)
			return n and { userId = id, name = n } or { error = "no Roblox user with id " .. text }
		end
		local uid = idOf(text)
		return uid and { userId = uid, name = nameOf(uid) or text } or { error = "no Roblox user named " .. text }
	end
	-- the people in a list setting, with names and ids filled in where Roblox knows them
	h.settingsPeople = function(player, folder, key)
		if not isOwner(player) then
			return nil
		end
		local s = find(folder, key)
		if not s or not s.people then
			return nil
		end
		local out = {}
		for entry in string.gmatch(tostring(valueOf(s)), "[^,%s]+") do
			local id = tonumber(entry)
			if id then
				table.insert(out, { entry = entry, userId = id, name = nameOf(id), byId = true })
			else
				table.insert(out, { entry = entry, name = entry, userId = idOf(entry), byId = false })
			end
		end
		local online = {}
		for _, p in ipairs(Players:GetPlayers()) do
			table.insert(online, { userId = p.UserId, name = p.Name, display = p.DisplayName })
		end
		return { entries = out, online = online }
	end

	h.settingsDefault = function(player, folder, key)
		if not isOwner(player) then
			return { error = "only the owner" }
		end
		local s = find(folder, key)
		if not s then
			return { error = "no such setting" }
		end
		folders()[folder]:SetAttribute(key, s.default)
		return { ok = true, value = s.default }
	end

	-- keep every setting's current value; every server applies them when it starts
	h.settingsSave = function(player)
		whenLoaded()
		if not isOwner(player) then
			return { error = "only the owner" }
		end
		if not store then
			return { error = "no DataStore: " .. tostring(storeError) }
		end
		local t = {}
		for _, s in ipairs(schema()) do
			t[s.folder] = t[s.folder] or {}
			t[s.folder][s.key] = valueOf(s)
		end
		local okS, e = pcall(store.SetAsync, store, KEY, t)
		if not okS then
			return { error = "couldn't save: " .. tostring(e) .. (RunService:IsStudio() and " (Studio: Game Settings > Security > Enable Studio Access to API Services)" or "") }
		end
		saved = t
		return { ok = true }
	end

	h.settingsClear = function(player)
		whenLoaded()
		if not isOwner(player) then
			return { error = "only the owner" }
		end
		if not store then
			return { error = "no DataStore: " .. tostring(storeError) }
		end
		local okR, e = pcall(store.RemoveAsync, store, KEY)
		if not okR then
			return { error = "couldn't clear: " .. tostring(e) }
		end
		saved = nil
		return { ok = true }
	end
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">ToolAccess</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab.init() on the server: who gets the Lab tools (the "TV" and "Spray Paint" tools, built from
-- LabHub.Blueprints; a tool of that name in StarterPack is used instead). They are kept in ServerStorage and handed out
-- by the settings:
--   TVToolAccess, SprayToolAccess: "everyone" | "admins" (FrameLab admins: Config.Admins, the owner) | "owner" |
--                                   "list" (ToolAccessList: UserIds or names, comma-separated) | "nobody"
-- A change applies at once (tools given or taken away). The settings panel's "Get tools" gives the owner both tools
-- whatever the settings say (request: toolsGive).
return function(FrameLab)
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local StarterPack = game:GetService("StarterPack")
	local ServerStorage = game:GetService("ServerStorage")
	local root = script:FindFirstAncestor("FrameLab")
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))

	local TOOLS = { { name = "TV", setting = "TVToolAccess" }, { name = "Spray Paint", setting = "SprayToolAccess" } }

	-- the tools, kept out of StarterPack (so nobody gets them unless allowed)
	local store = ServerStorage:FindFirstChild("FrameLabTools") or Instance.new("Folder")
	store.Name = "FrameLabTools"
	store.Parent = ServerStorage
	local hub = root.Parent
	local Blueprints = require(hub.Blueprints)
	local Instancer = require(hub.Instancer)
	local tools = {}
	for _, t in ipairs(TOOLS) do
		local tool = StarterPack:FindFirstChild(t.name) or store:FindFirstChild(t.name)
		if not tool and Blueprints.tools[t.name] then
			tool = Instancer.build(Blueprints.tools[t.name]) -- (its behaviour: FrameLab Runtime/Client/ToolBinder)
		end
		if tool then
			tool.Parent = store
			tools[t.name] = tool
		end
	end

	local t0 = os.clock()
	while not FrameLab.Server and os.clock() - t0 < 30 do
		task.wait(0.1)
	end
	local isAdmin = FrameLab.Server and FrameLab.Server.isAdmin or function()
		return false
	end
	local function isOwner(player)
		if RunService:IsStudio() then
			return true
		end
		if game.CreatorType == Enum.CreatorType.User then
			return player.UserId == game.CreatorId
		end
		local ok, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
		return ok and rank >= 255
	end
	local function onList(player)
		for entry in string.gmatch(tostring(Config.ToolAccessList or ""), "[^,%s]+") do
			if tonumber(entry) == player.UserId or string.lower(entry) == string.lower(player.Name) then
				return true
			end
		end
		return false
	end
	local function allowed(player, setting)
		local mode = Config[setting] or "everyone"
		if mode == "everyone" then
			return true
		elseif mode == "admins" then
			return isAdmin(player) or isOwner(player)
		elseif mode == "owner" then
			return isOwner(player)
		elseif mode == "list" then
			return onList(player) or isOwner(player)
		end
		return false -- "nobody"
	end

	local granted = {} -- player -> { [tool name] = true }: given by "Get tools" whatever the settings
	local function has(player, name)
		local bp = player:FindFirstChildOfClass("Backpack")
		return (bp and bp:FindFirstChild(name)) or (player.Character and player.Character:FindFirstChild(name))
	end
	local function update(player)
		for _, t in ipairs(TOOLS) do
			local tool = tools[t.name]
			if tool then
				local want = allowed(player, t.setting) or (granted[player] and granted[player][t.name])
				local held = has(player, t.name)
				if want and not held then
					local bp = player:FindFirstChildOfClass("Backpack")
					if bp then
						tool:Clone().Parent = bp
					end
				elseif not want and held then
					while has(player, t.name) do
						has(player, t.name):Destroy()
					end
				end
			end
		end
	end
	local function hook(player)
		player.CharacterAdded:Connect(function()
			task.wait() -- (the new Backpack)
			update(player)
		end)
		if player.Character then
			update(player)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(hook, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		granted[p] = nil
	end)
	-- a settings change: give / take away now
	for _, key in ipairs({ "TVToolAccess", "SprayToolAccess", "ToolAccessList", "Admins" }) do
		root:GetAttributeChangedSignal(key):Connect(function()
			for _, p in ipairs(Players:GetPlayers()) do
				update(p)
			end
		end)
	end

	if FrameLab.Server then
		FrameLab.Server.handlers.toolsGive = function(player)
			if not isOwner(player) then
				return { error = "only the owner" }
			end
			granted[player] = {}
			for _, t in ipairs(TOOLS) do
				granted[player][t.name] = true
			end
			update(player)
			return { ok = true }
		end
	end
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="81">
        <Properties>
          <string name="Name">Sync</string>
          <BinaryString name="AttributesSerialize"></BinaryString>
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <ContentId name="LinkedSource">
            <null>
            </null>
          </ContentId>
          <bool name="DefinesCapabilities">false</bool>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[-- Server-authoritative video playback for FrameLab, the same way AudioLab.Sync does sound. The server never decodes a
-- video: it writes a handful of attributes on the screen's instance (a Part, or a Model with a part named "Screen"),
-- and every client plays the video there itself (Runtime/Client/FrameLabClient), on the server's playhead. Attributes
-- replicate to everyone and stay on the instance, so a player who joins later starts in the right place.
--
-- Server:
--   local Sync = require(game.ReplicatedStorage.LabHub.FrameLab.Sync)
--   Sync.play(screen, { Video = "intro", Loop = true })     -- also StartTime, Speed, Delay, Face, Sound (default true)
--   Sync.pause(screen); Sync.resume(screen); Sync.seek(screen, 12.5); Sync.stop(screen); Sync.setSpeed(screen, 1.5)
--   Sync.seek(screen, 12.5, hold): a playing screen's playhead waits at the new spot (at most `hold` seconds) until its
--       controller's client has the picture there (it sends "ready"; Sync.release), like a video player loading after
--       a jump; its sound waits with it
--   Sync.getTime(screen, { duration =, loop = })             -- the server's playhead in seconds
--   Sync.setClientControl(screen, true)                      -- clients may pause / seek / ... it (default: only its owner)
--   Sync.setOwner(screen, player)                            -- that player may control it (TVs)
--   Sync.authorize = function(player, target, action, arg) return true end   -- optional: veto client requests
-- Client: Sync.request(screen, "play", { Video = "intro", Loop = true }) or "pause" | "resume" | "toggle" | "stop" |
--   "restart" | "seek" | "setSpeed" | "ready" | "stall", n. The server checks it (Runtime/Server/FrameLabServer).
-- In Studio: tag an instance "FrameLab", set FrameLabSynced = true, FrameLabAutoPlay = true, FrameLabVideo = "<name>"
--   (and FrameLabLoop, FrameLabStartTime) and the server starts it.
-- A video imported with its sound (attribute Audio = "clip:<name>") plays that sound through AudioLab.Sync on the same
-- instance, so picture and sound share one playhead.
-- State attributes: FrameLabState ("playing" | "paused" | "stopped"), FrameLabPos, FrameLabAt, FrameLabSpeed, FrameLabSeq,
-- FrameLabHold (a held seek: the FrameLabSeq it waits on). A playing screen's playhead stays at FrameLabPos until
-- FrameLabAt.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Sync = {}
Sync.Tag = "FrameLab"
Sync.Delay = 0.5 -- seconds between a server command and the start (time for clients to fetch the first chunk)

local CONFIG = { Video = "FrameLabVideo", Loop = "FrameLabLoop", Face = "FrameLabFace" }

local function serverNow()
	return workspace:GetServerTimeNow()
end

function Sync.state(instance)
	local state = instance:GetAttribute("FrameLabState")
	if state == nil then
		return nil
	end
	return {
		state = state,
		pos = instance:GetAttribute("FrameLabPos") or 0,
		at = instance:GetAttribute("FrameLabAt") or 0,
		speed = instance:GetAttribute("FrameLabSpeed") or 1,
		seq = instance:GetAttribute("FrameLabSeq") or 0,
	}
end

function Sync.rawPosition(st, now)
	if st.state == "playing" then
		return st.pos + math.max(0, now - st.at) * st.speed -- (a start ahead: held where it starts)
	end
	return st.pos
end

-- where the video should be at server time `now` (seconds, wrapped into the loop), and whether a one-shot finished
function Sync.target(st, now, info)
	local p = Sync.rawPosition(st, now)
	if p < 0 then
		return 0, false
	end
	local d = info.duration or 0
	if info.loop and d > 0 then
		return p % d, false
	end
	if d > 0 and p >= d then
		return d, true
	end
	return p, false
end

function Sync.getTime(instance, info)
	local st = Sync.state(instance)
	if not st then
		return 0
	end
	local now = serverNow()
	if info then
		return (Sync.target(st, now, info))
	end
	return math.max(0, Sync.rawPosition(st, now))
end

local function serverOnly()
	assert(RunService:IsServer(), "FrameLab.Sync commands run on the server")
end

-- AudioLab sound for a video imported with one (best effort: AudioLab may not be there)
local AudioSync
local function audio()
	if AudioSync == nil then
		local rs = game:GetService("ReplicatedStorage")
		local al = game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):FindFirstChild("AudioLab")
		local m = al and al:FindFirstChild("Sync")
		local ok, mod = pcall(function()
			return m and require(m)
		end)
		AudioSync = (ok and mod) or false
	end
	return AudioSync or nil
end
local function soundOf(instance)
	if instance:GetAttribute("FrameLabSound") == false then
		return nil
	end
	local a = instance:GetAttribute("FrameLabAudio")
	if type(a) == "string" and string.sub(a, 1, 5) == "clip:" then
		return string.sub(a, 6)
	end
	return nil
end
-- runs fn(AudioLab.Sync) when this screen has (or had) sound: a screen that switched to a silent video still has to
-- stop the old video's sound
local function audioDo(instance, fn)
	local A = audio()
	if A and (instance:GetAttribute("FrameLabAudio") or instance:GetAttribute("AudioLabState") ~= nil) then
		pcall(fn, A)
	end
end

-- The sound follows the picture's playhead exactly: AudioLab's state is written with the same position, start time and
-- speed. (Calling AudioLab.Sync.pause / resume / seek let it pick its own start delay, 0.3 s against the picture's
-- 0.5 s, so every pause / resume or seek moved the sound 0.2 s further from the picture.)
local function mirrorSound(instance)
	if instance:GetAttribute("AudioLabState") == nil or not soundOf(instance) then
		return -- (no sound, or a silent video: its old sound stays stopped)
	end
	instance:SetAttribute("AudioLabPos", instance:GetAttribute("FrameLabPos"))
	instance:SetAttribute("AudioLabAt", instance:GetAttribute("FrameLabAt"))
	instance:SetAttribute("AudioLabSpeed", instance:GetAttribute("FrameLabSpeed"))
	instance:SetAttribute("AudioLabState", instance:GetAttribute("FrameLabState"))
	instance:SetAttribute("AudioLabSeq", (instance:GetAttribute("AudioLabSeq") or 0) + 1) -- last: clients react to it
end

local function write(instance, state, pos, at, speed, hold)
	instance:SetAttribute("FrameLabPos", pos)
	instance:SetAttribute("FrameLabAt", at)
	instance:SetAttribute("FrameLabSpeed", speed)
	instance:SetAttribute("FrameLabState", state)
	instance:SetAttribute("FrameLabHold", hold and (instance:GetAttribute("FrameLabSeq") or 0) + 1 or nil)
	instance:SetAttribute("FrameLabSeq", (instance:GetAttribute("FrameLabSeq") or 0) + 1) -- last: clients react to it
end

-- the video library entry (server: both the replicated and the ServerStorage library)
function Sync.videoEntry(name)
	if Sync.extraEntry then -- in-game imports (set by the server's Media runtime)
		local e = Sync.extraEntry(name)
		if e then
			return e
		end
	end
	local root = script.Parent
	local Store = require(root.Tools.Store)
	local roots = { root.Data.Videos }
	if RunService:IsServer() then
		local data = game:GetService("ServerStorage"):FindFirstChild("FrameLabData")
		if data and data:FindFirstChild("Videos") then
			table.insert(roots, data.Videos)
		end
	end
	for _, r in ipairs(roots) do
		local e = Store.entry(r, name)
		if e then
			return e
		end
	end
	return nil
end

function Sync.play(instance, opts)
	serverOnly()
	opts = opts or {}
	for key, attr in pairs(CONFIG) do
		if opts[key] ~= nil then
			instance:SetAttribute(attr, opts[key])
		end
	end
	local name = instance:GetAttribute("FrameLabVideo")
	local entry = name and Sync.videoEntry(name)
	if not entry then
		warn("[FrameLab] Sync.play: no video named " .. tostring(name))
		return
	end
	instance:SetAttribute("FrameLabDuration", entry:GetAttribute("Seconds") or 0)
	instance:SetAttribute("FrameLabAudio", entry:GetAttribute("Audio"))
	instance:SetAttribute("FrameLabSynced", true)
	if opts.Sound ~= nil then
		instance:SetAttribute("FrameLabSound", opts.Sound)
	end
	if not CollectionService:HasTag(instance, Sync.Tag) then
		CollectionService:AddTag(instance, Sync.Tag)
	end
	local delay = opts.Delay or Sync.Delay
	local speed = opts.Speed or instance:GetAttribute("FrameLabSpeed") or 1
	local start = opts.StartTime or 0
	local clip = soundOf(instance)
	-- an imported video's sound downloads to each client when it first plays (FrameLab.Net.clip, a few seconds): the
	-- start waits for it (Sync.soundLoadDelay, set by the server's Media runtime), so picture and sound begin together
	-- (the screen shows its first picture meanwhile)
	if clip and opts.Delay == nil and Sync.soundLoadDelay then
		local ok, d = pcall(Sync.soundLoadDelay, clip)
		if ok and type(d) == "number" then
			delay = math.max(delay, d)
		end
	end
	write(instance, "playing", start, serverNow() + delay, speed)
	-- a video's sound starts on the picture's clock: no start-up lead (AudioLab's default 0.05 s, on top of its own
	-- block-ahead scheduling, put the sound ~0.1 s before the picture), unless the instance sets its own
	if instance:GetAttribute("AudioLabSyncLead") == nil then
		instance:SetAttribute("AudioLabSyncLead", 0)
	end
	audioDo(instance, function(A)
		if clip then
			-- the sound loops on the picture's length (an imported sound is often a few ms shorter or longer than its
			-- video: looping on its own length it crept ~0.05 s further off every loop)
			local len = instance:GetAttribute("FrameLabDuration")
			A.play(instance, { Clip = clip, Loop = instance:GetAttribute("FrameLabLoop") == true, StartTime = start, Speed = speed, Delay = delay, Spatial = true,
				LoopLength = (type(len) == "number" and len > 0) and len or nil })
			mirrorSound(instance) -- the very same start time as the picture
		elseif A.state(instance) then
			A.stop(instance) -- the new video is silent: the old one's sound stops
		end
	end)
end

function Sync.pause(instance)
	serverOnly()
	local st = Sync.state(instance)
	if not st or st.state ~= "playing" then
		return
	end
	local now = serverNow()
	write(instance, "paused", math.max(0, Sync.rawPosition(st, now)), now, st.speed)
	mirrorSound(instance)
end

function Sync.resume(instance)
	serverOnly()
	local st = Sync.state(instance)
	if not st or st.state == "playing" then
		return
	end
	local pos = st.state == "stopped" and 0 or st.pos
	write(instance, "playing", pos, serverNow() + Sync.Delay, st.speed)
	mirrorSound(instance)
end

function Sync.stop(instance)
	serverOnly()
	if not Sync.state(instance) then
		return
	end
	write(instance, "stopped", 0, serverNow(), instance:GetAttribute("FrameLabSpeed") or 1)
	audioDo(instance, function(A)
		A.stop(instance)
	end)
end

function Sync.seek(instance, seconds, hold)
	serverOnly()
	local st = Sync.state(instance)
	if not st then
		return
	end
	local now = serverNow()
	if type(hold) == "number" and hold > 0 and st.state == "playing" then
		-- held: the picture starts again when a client has it (Sync.release) or after `hold` seconds; the sound
		-- waits paused at the spot meanwhile
		local pos = math.max(0, seconds)
		write(instance, "playing", pos, now + hold, st.speed, true)
		local id = instance:GetAttribute("FrameLabHold")
		if instance:GetAttribute("AudioLabState") ~= nil and soundOf(instance) then
			instance:SetAttribute("AudioLabPos", pos)
			instance:SetAttribute("AudioLabAt", now)
			instance:SetAttribute("AudioLabSpeed", st.speed)
			instance:SetAttribute("AudioLabState", "paused")
			instance:SetAttribute("AudioLabSeq", (instance:GetAttribute("AudioLabSeq") or 0) + 1)
		end
		task.delay(hold, function()
			if instance:GetAttribute("FrameLabHold") == id and instance:GetAttribute("FrameLabSeq") == id then
				instance:SetAttribute("FrameLabHold", nil)
				mirrorSound(instance) -- (not released in time: it plays on anyway, the sound with it)
			end
		end)
		return
	end
	write(instance, st.state == "stopped" and "paused" or st.state, math.max(0, seconds), now, st.speed)
	mirrorSound(instance)
end

-- a held seek goes on (its picture is there): hold is the FrameLabHold it answers
function Sync.release(instance, hold)
	serverOnly()
	local st = Sync.state(instance)
	if not st or st.state ~= "playing" or hold ~= st.seq or instance:GetAttribute("FrameLabHold") ~= hold then
		return
	end
	local at = serverNow() + 0.15
	if st.at > at then
		write(instance, "playing", st.pos, at, st.speed)
		mirrorSound(instance)
	end
end

function Sync.setSpeed(instance, speed)
	serverOnly()
	local st = Sync.state(instance)
	if not st then
		instance:SetAttribute("FrameLabSpeed", speed)
		return
	end
	local now = serverNow()
	write(instance, st.state, math.max(0, Sync.rawPosition(st, now)), now, speed)
	mirrorSound(instance)
end

function Sync.setClientControl(instance, allowed)
	instance:SetAttribute("FrameLabClientControl", allowed == true)
end

function Sync.setOwner(instance, player)
	instance:SetAttribute("FrameLabOwner", player and player.UserId or nil)
end

-- client: ask the server to change a screen's video
function Sync.request(target, action, arg)
	assert(RunService:IsClient(), "Sync.request is for clients")
	local remotes = game:GetService("ReplicatedStorage"):WaitForChild("FrameLabSyncRemotes", 10)
	if remotes then
		remotes:WaitForChild("SyncControl"):FireServer(target, action, arg)
	end
end

return Sync
]]></string>
          <int64 name="SourceAssetId">-1</int64>
        </Properties>
      </Item>
    </Item>
    <Item class="ModuleScript" referent="82">
      <Properties>
        <string name="Name">AudioLab</string>
        <BinaryString name="AttributesSerialize">BQAAAAoAAABCbG9ja0FoZWFkAwEFAAAARGVidWcDAAsAAABGaW5lQnVuZGxlcwIGAAAAc3RlYWR5CAAAAE1hbmlmZXN0AgQAAABMZWFuDAAAAFNvdXJjZUZpbHRlcgMA</BinaryString>
        <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
        <ContentId name="LinkedSource">
          <null>
          </null>
        </ContentId>
        <bool name="DefinesCapabilities">false</bool>
        <BinaryString name="SerializedOverrides">
        </BinaryString>
        <string name="Source"><![CDATA[-- AudioLab: binary audio formats, FFT, and a parametric codec that rebuilds
-- sounds from a fixed bank of uploaded waveform loops.
-- (part of LabHub: keep it inside the LabHub module in ReplicatedStorage)
--   Util/     ByteReader, ByteWriter, Base64
--   Formats/  Iff (RIFF/IFF chunks), Wav, Aiff, Mp3 (MPEG Layer III decoder), Midi, Sf2, etc.
--   DSP/      Signal (PCM container), FFT (FFT, windows, STFT)
--   Codec/    WaveBank (waveform + noise asset spec), Analyzer, Format, Encoder, Partials (clip codec v3)
--   Synth/    Renderer (renders a clip to PCM / WAV), OscillatorPool, Player,
--             Instruments (GM presets, drum kit, SF2 analysis), MidiSynth (MIDI player)
--   Tools/    Importer (file import into Data/), Assets (shared decode-once cache),
--             Baker (analyse SoundFonts in Studio into Data/Banks)
--   Synth/Attach  audio attached to instances (registry, tag binder, 3D AudioEmitter output)
--   Synth/Tracks  track manager: AudioLab.play returns a track; playing list, pause/resume/stop/delete, fades,
--                 crossfade/switch, playlist with next/previous/shuffle/repeat (see the block above `lib.play`)
--   Data/     Imported files and encoded clips (base64 ModuleScripts)
--
--   Runtime/  Server (sync + Studio import servers) and Client (tagged-instance player, music player UI) modules,
--             started by AudioLab:init() (LabHub.start calls it)
--
-- Usage: local AudioLab = require(ReplicatedStorage.LabHub.AudioLab); AudioLab.Wav.decode(bytes)

local cache = {}
local paths = {
	ByteReader = {"Util", "ByteReader"}, ByteWriter = {"Util", "ByteWriter"}, Base64 = {"Util", "Base64"},
	Iff = {"Formats", "Iff"}, Wav = {"Formats", "Wav"}, Aiff = {"Formats", "Aiff"},
	Midi = {"Formats", "Midi"}, Sf2 = {"Formats", "Sf2"}, Mp3 = {"Formats", "Mp3"},
	Signal = {"DSP", "Signal"}, FFT = {"DSP", "FFT"},
	WaveBank = {"Codec", "WaveBank"}, Analyzer = {"Codec", "Analyzer"},
	Format = {"Codec", "Format"}, Encoder = {"Codec", "Encoder"}, Partials = {"Codec", "Partials"},
	Renderer = {"Synth", "Renderer"}, OscillatorPool = {"Synth", "OscillatorPool"}, Player = {"Synth", "Player"},
	Instruments = {"Synth", "Instruments"}, MidiSynth = {"Synth", "MidiSynth"},
	Importer = {"Tools", "Importer"}, Tests = {"Tests", "RunAll"},
	Assets = {"Tools", "Assets"}, Library = {"Tools", "Library"}, Baker = {"Tools", "Baker"}, Attach = {"Synth", "Attach"},
	Tracks = {"Synth", "Tracks"},
}

local lib = {}

-- AudioLab:init() (or AudioLab.init()): starts the runtime of this side once: on the server every module in
-- Runtime/Server (sync server, Studio import server), on a client every module in Runtime/Client (tagged-instance
-- player, music player UI). Each module returns function(AudioLab) and runs in its own thread.
-- LabHub.start() calls it.
local started = {}
function lib.init()
	local RunService = game:GetService("RunService")
	local side = RunService:IsServer() and "Server" or "Client"
	if started[side] then
		return lib
	end
	started[side] = true
	local folder = script:FindFirstChild("Runtime") and script.Runtime:FindFirstChild(side)
	if folder then
		for _, m in ipairs(folder:GetChildren()) do
			if m:IsA("ModuleScript") then
				local ok, fn = pcall(require, m)
				if not ok then
					warn(("[AudioLab] %s failed to load: %s"):format(m:GetFullName(), tostring(fn)))
				elseif type(fn) == "function" then
					task.spawn(fn, lib)
				end
			end
		end
	end
	return lib
end

-- AudioLab.attach(instance, options) / AudioLab.get(instance) / AudioLab.detach(instance)
-- AudioLab.bindTag(tag)  -- see Synth/Attach
function lib.attach(instance, options)
	return lib.Attach.attach(instance, options)
end
function lib.get(instance)
	return lib.Attach.get(instance)
end
function lib.detach(instance)
	return lib.Attach.detach(instance)
end
function lib.bindTag(tag)
	return lib.Attach.bindTag(tag)
end

-- Track manager (Synth/Tracks): everything that plays is a track you can list, pause, fade, crossfade or delete.
--   local track = AudioLab.play(path, { Loop = false, Volume = 1, FadeIn = 0, StartTime = 0, SoundFont = "..." })
--       path: a Library id, a .mid/.wav/.aif/.mp3 in Data/Files (a .mid uses the .sf2 next to it, or options.SoundFont)
--       or a clip in Data/Clips. Returns a track: :pause() :resume() :stop() :delete() :seek(t) :setLoop(on)
--       :setVolume(v, fade) :fadeOut(seconds, "stop" | "pause" | "delete") :getTime() :getDuration() :getInfo(); .Ended
--   AudioLab.getAllPlayingTracks(), getAllTracks(), getTrack(id), getTracksInGroup(group)
--   AudioLab.pause / resume / stop / delete (target?)   -- a track, an id, a list, or nothing = all tracks
--   AudioLab.pauseAll / resumeAll / stopAll / deleteAll, AudioLab.fadeOut(target?, seconds, then?)
--   AudioLab.setLoop(target?, on), AudioLab.setMasterVolume(v, fade?), AudioLab.getMasterVolume()
--   AudioLab.crossfade(path, { Duration = 2 })   -- current tracks fade out while the new one fades in
--   AudioLab.switch(path, { FadeOut = 0.5 })     -- current tracks fade out, then the new one starts
--   AudioLab.setPlaylist({ path, ... }, { Repeat = "all" | "one" | "off", Shuffle, Crossfade, StartIndex })
--   AudioLab.next() / previous() / jump(i) / queue(path) / setRepeat(mode) / setShuffle(on) / setCrossfade(s)
--   AudioLab.getPlaylist(), getCurrentTrack(), stopPlaylist(fade?), clearPlaylist()
--   Events: AudioLab.TrackAdded, TrackStateChanged, TrackEnded, TrackRemoved, PlaylistChanged
for _, name in ipairs({
	"play", "create", "crossfade", "switch",
	"getAllPlayingTracks", "getAllTracks", "getTrack", "getTracksInGroup",
	"pause", "resume", "stop", "delete", "pauseAll", "resumeAll", "stopAll", "deleteAll", "fadeOut", "setLoop",
	"setMasterVolume", "getMasterVolume",
	"setPlaylist", "queue", "next", "previous", "jump", "setRepeat", "setShuffle", "setCrossfade",
	"getPlaylist", "getCurrentTrack", "stopPlaylist", "clearPlaylist",
}) do
	lib[name] = function(...)
		return lib.Tracks[name](...)
	end
end
-- AudioLab.warmUp(options?) -- yields: creates the voice players ahead of time, a few per frame, so the first song (and
-- every song switch) doesn't hitch. Call it once at start from a script that can wait: task.spawn(AudioLab.warmUp)
function lib.warmUp(options)
	return lib.OscillatorPool.warmUp(options)
end

-- AudioLab.preload(timeout?) -- starts loading every audio file of the active manifest (once per session; yields up to
-- `timeout` seconds if given) and returns true when all are ready. AudioLab.preloadStatus() -> { State, Total, Ready, ... }
function lib.preload(timeout)
	return lib.OscillatorPool.preload(timeout)
end

function lib.preloadStatus()
	return lib.OscillatorPool.preloadStatus()
end
local EVENTS = { TrackAdded = true, TrackStateChanged = true, TrackEnded = true, TrackRemoved = true, PlaylistChanged = true }

return setmetatable(lib, {
	__index = function(_, name)
		if EVENTS[name] then return lib.Tracks[name] end
		local cached = cache[name]
		if cached ~= nil then return cached end
		local path = paths[name]
		assert(path, "AudioLab has no module named " .. tostring(name))
		local mod = require(script:WaitForChild(path[1]):WaitForChild(path[2]))
		cache[name] = mod
		return mod
	end,
})
]]></string>
