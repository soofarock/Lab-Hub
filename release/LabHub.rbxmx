	u, v = t0 + t15, t0 - t15
	t0, t15 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t1 + t14, t1 - t14
	t1, t14 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t2 + t13, t2 - t13
	t2, t13 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t3 + t12, t3 - t12
	t3, t12 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t4 + t11, t4 - t11
