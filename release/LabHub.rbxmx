        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">SprayTool</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[-- The Spray Paint tool (FrameLab's ToolBinder calls this with the Tool on each client), modded from Roblox's 2012 Spray Paint
-- gear: pick what to spray, then click / tap a surface within reach.
--   Pictures  FrameLab library pictures (imported in Studio)
--   Decal ID  a Roblox decal or image id, like the original gear
--   Import    admins only: a web address of a PNG / JPG / BMP / TGA / GIF picture; the server imports it into the
--             Pictures list for everyone (kept while the server runs)
return function(tool)
	local Players = game:GetService("Players")
	local UIS = game:GetService("UserInputService")
	local root = game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("FrameLab")
	local Net = require(root.Tools.Net)
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))
	local remote = Net.remotes(false):WaitForChild("Spray")
	local player = Players.LocalPlayer

	local C = {
		bg = Color3.fromRGB(20, 23, 30), panel = Color3.fromRGB(30, 34, 43), text = Color3.fromRGB(230, 233, 240),
		dim = Color3.fromRGB(140, 148, 165), accent = Color3.fromRGB(56, 170, 230), on = Color3.fromRGB(28, 96, 140),
	}
	local choice = nil -- { Kind, Value, Label }
	local size = 5
	local gui, statusLabel, chosenLabel
	local busy = false

	local function make(class, props, parent)
		local i = Instance.new(class)
		for k, v in pairs(props) do
			i[k] = v
		end
		i.Parent = parent
		return i
	end
	local function corner(parent, r)
		make("UICorner", { CornerRadius = UDim.new(0, r or 6) }, parent)
	end
	local function button(parent, text, w, h)
		local b = make("TextButton", {
			Size = UDim2.new(0, w, 0, h or 26), BackgroundColor3 = C.panel, TextColor3 = C.text, Text = text,
			Font = Enum.Font.GothamMedium, TextSize = 12, AutoButtonColor = true,
		}, parent)
		corner(b)
		return b
	end
	local function setStatus(t)
		if statusLabel then
			statusLabel.Text = t
		end
	end
	local function choose(c)
		choice = c
		if chosenLabel then
			chosenLabel.Text = c and ("Spraying: " .. c.Label) or "Pick something to spray"
		end
	end

	local function buildGui()
		gui = make("ScreenGui", { Name = "FrameLabSpray", ResetOnSpawn = false, DisplayOrder = 15 })
		local panel = make("Frame", {
			Size = UDim2.new(0, 300, 0, 330), Position = UDim2.new(0, 16, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = C.bg, BackgroundTransparency = 0.05,
		}, gui)
		corner(panel, 10)
		local pad = make("UIPadding", {}, panel)
		pad.PaddingTop, pad.PaddingBottom, pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 10), UDim.new(0, 10), UDim.new(0, 10), UDim.new(0, 10)
		make("TextLabel", {
			Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1, Text = "SPRAY PAINT", TextColor3 = C.dim,
			Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
		}, panel)
		chosenLabel = make("TextLabel", {
			Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 0, 20), BackgroundTransparency = 1, TextColor3 = C.text,
			Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		}, panel)
		-- tabs
		local tabs = make("Frame", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 0, 44), BackgroundTransparency = 1 }, panel)
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, tabs)
		local body = make("Frame", { Size = UDim2.new(1, 0, 1, -146), Position = UDim2.new(0, 0, 0, 76), BackgroundColor3 = C.panel }, panel)
		corner(body, 8)
		-- size
		local sizeRow = make("Frame", { Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 1, -62), BackgroundTransparency = 1 }, panel)
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }, sizeRow)
		make("TextLabel", { Size = UDim2.new(0, 36, 1, 0), BackgroundTransparency = 1, Text = "Size", TextColor3 = C.dim, Font = Enum.Font.Gotham, TextSize = 12, LayoutOrder = 0 }, sizeRow)
		local sizeButtons = {}
		-- XL: the biggest normal spray (10 studs, a sharper picture than the smaller sizes). O (original): the picture at
		-- its own resolution, up to 512 x 512, sized from its pixels (size 0 asks the server for that)
		for i, s in ipairs({ { "S", 3 }, { "M", 5 }, { "L", 8 }, { "XL", 10 }, { "O", 0 } }) do
			local b = button(sizeRow, s[1], 40)
			b.LayoutOrder = i
			sizeButtons[b] = s[2]
			b.MouseButton1Click:Connect(function()
				size = s[2]
				for bb, v in pairs(sizeButtons) do
					bb.BackgroundColor3 = (v == size) and C.on or C.panel
				end
			end)
			b.BackgroundColor3 = (s[2] == size) and C.on or C.panel
		end
		statusLabel = make("TextLabel", {
			Size = UDim2.new(1, 0, 0, 28), Position = UDim2.new(0, 0, 1, -28), BackgroundTransparency = 1, TextColor3 = C.dim,
			Font = Enum.Font.Gotham, TextSize = 11, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
			Text = "Click a surface within reach to spray.",
		}, panel)

		local pages = {}
		local function showPage(name)
			for n, p in pairs(pages) do
				p.page.Visible = (n == name)
				p.tab.BackgroundColor3 = (n == name) and C.on or C.panel
			end
		end
		local function addPage(name)
			local tab = button(tabs, name, 84)
			tab.LayoutOrder = ({ Pictures = 1, ["Decal ID"] = 2, Import = 3 })[name] or 9
			local page = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false }, body)
			pages[name] = { tab = tab, page = page }
			tab.MouseButton1Click:Connect(function()
				showPage(name)
			end)
			return page
		end

		-- Pictures
		local pics = addPage("Pictures")
		local list = make("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4,
			AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
		}, pics)
		make("UIListLayout", { Padding = UDim.new(0, 4) }, list)
		local lp = make("UIPadding", {}, list)
		lp.PaddingTop, lp.PaddingLeft, lp.PaddingRight = UDim.new(0, 6), UDim.new(0, 6), UDim.new(0, 10)
		local function fillPictures()
			for _, c in ipairs(list:GetChildren()) do
				if c:IsA("GuiButton") then
					c:Destroy()
				end
			end
			local images = Net.images()
			if #images == 0 then
				local b = button(list, "No pictures yet (import with FrameLab.import() in Studio)", 10)
				b.Size = UDim2.new(1, 0, 0, 26)
				b.TextWrapped = true
			end
			for _, img in ipairs(images) do
				local b = button(list, ("%s   %dx%d"):format(img.name, img.Width or 0, img.Height or 0), 10)
				b.Size = UDim2.new(1, 0, 0, 26)
				b.TextXAlignment = Enum.TextXAlignment.Left
				make("UIPadding", { PaddingLeft = UDim.new(0, 8) }, b)
				b.MouseButton1Click:Connect(function()
					choose({ Kind = "image", Value = img.name, Label = img.name })
				end)
			end
		end
		task.spawn(fillPictures)

		-- Decal ID
		local decal = addPage("Decal ID")
		local box = make("TextBox", {
			Size = UDim2.new(1, -12, 0, 30), Position = UDim2.new(0, 6, 0, 8), BackgroundColor3 = C.bg, TextColor3 = C.text,
			PlaceholderText = "decal or image id, e.g. 80373024", PlaceholderColor3 = C.dim, Text = "", ClearTextOnFocus = false,
			Font = Enum.Font.Code, TextSize = 13,
		}, decal)
		corner(box)
		local use = button(decal, "Use this decal", 120)
		use.Position = UDim2.new(0, 6, 0, 46)
		local preview = make("ImageLabel", {
			Size = UDim2.new(0, 70, 0, 70), Position = UDim2.new(1, -76, 0, 46), BackgroundColor3 = C.bg, ScaleType = Enum.ScaleType.Fit,
		}, decal)
		corner(preview)
		local function useDecal()
			local id = tonumber(string.match(box.Text, "%d+"))
			if not id then
				setStatus("Type a decal or image id (numbers).")
				return
			end
			box.Text = tostring(id)
			preview.Image = "rbxthumb://type=Asset&id=" .. id .. "&w=150&h=150"
			choose({ Kind = "decal", Value = id, Label = "decal " .. id })
		end
		use.MouseButton1Click:Connect(useDecal)
		box.FocusLost:Connect(function(enter)
			if enter then
				useDecal()
			end
		end)

		-- Import (admins): a picture from a web address joins the Pictures list (for everyone, while the server runs)
		task.spawn(function()
			if not Net.isAdmin() then
				return
			end
			local page = addPage("Import")
			local ubox = make("TextBox", {
				Size = UDim2.new(1, -12, 0, 30), Position = UDim2.new(0, 6, 0, 8), BackgroundColor3 = C.bg, TextColor3 = C.text,
				PlaceholderText = "https://example.com/picture.png", PlaceholderColor3 = C.dim, Text = "", ClearTextOnFocus = false,
				Font = Enum.Font.Code, TextSize = 12, TextTruncate = Enum.TextTruncate.AtEnd,
			}, page)
			corner(ubox)
			local load = button(page, "Import picture", 120)
			load.Position = UDim2.new(0, 6, 0, 46)
			make("TextLabel", {
				Size = UDim2.new(1, -12, 0, 70), Position = UDim2.new(0, 6, 0, 80), BackgroundTransparency = 1, TextColor3 = C.dim,
				Font = Enum.Font.Gotham, TextSize = 11, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				Text = "Admins only. PNG, JPG, WebP, BMP, TGA or GIF. It joins Pictures for everyone until the server closes. Pictures from the web skip Roblox moderation: only import ones you'd be fine with Roblox seeing.",
			}, page)
			local function doImport()
				if busy then
					return
				end
				busy = true
				setStatus("Importing the picture...")
				local ok, res = pcall(Net.invoke, "importUrl", "image", ubox.Text)
				busy = false
				if not ok or type(res) ~= "table" then
					setStatus("That didn't import.")
				elseif res.error then
					setStatus(res.error)
				else
					setStatus(("Imported %s, %dx%d. Click a surface to spray it."):format(res.name, res.width, res.height))
					choose({ Kind = "image", Value = res.name, Label = res.name })
					Net.forget()
					fillPictures()
				end
			end
			load.MouseButton1Click:Connect(doImport)
			ubox.FocusLost:Connect(function(enter)
				if enter then
					doImport()
				end
			end)
		end)

		showPage("Pictures")
		choose(choice)
		gui.Parent = player:WaitForChild("PlayerGui")
	end

	tool.Equipped:Connect(function()
		if not gui then
			buildGui()
		else
			gui.Parent = player:WaitForChild("PlayerGui")
		end
	end)
	tool.Unequipped:Connect(function()
		if gui then
			gui.Parent = nil
		end
	end)

	local lastSpray = 0
	tool.Activated:Connect(function()
		if not choice then
			setStatus("Pick something to spray first.")
			return
		end
		if os.clock() - lastSpray < (Config.SprayCooldown or 1.5) then
			return
		end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local cam = workspace.CurrentCamera
		if not hrp or not cam then
			return
		end
		local m = UIS:GetMouseLocation()
		local ray = cam:ViewportPointToRay(m.X, m.Y)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ignore = { char }
		local sprays = workspace:FindFirstChild("FrameLabSprays")
		if sprays then
			table.insert(ignore, sprays)
		end
		params.FilterDescendantsInstances = ignore
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 300, params)
		if not hit or not hit.Instance:IsA("BasePart") then
			return
		end
		if (hit.Position - hrp.Position).Magnitude > (Config.SprayRange or 14) then
			setStatus("Too far: get closer to the surface.")
			return
		end
		lastSpray = os.clock()
		-- the gear's spray animation (made for R6 bodies)
		local hum = char:FindFirstChildOfClass("Humanoid")
		local anim = tool:FindFirstChild("SprayPaint")
		if hum and anim then
			pcall(function()
				local animator = hum:FindFirstChildOfClass("Animator") or hum
				animator:LoadAnimation(anim):Play()
			end)
		end
		remote:FireServer({ Kind = choice.Kind, Value = choice.Value }, size, hit.Position, hit.Normal, hit.Instance)
		setStatus("Sprayed.")
	end)
end
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">ImportJob</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- FrameLab import work on MP4 / MOV (H.264, H.265, AV1 or MPEG-4 Part 2), WebM / Matroska (VP9, VP8, AV1, H.264, H.265
-- or MPEG-4 Part 2), AVI (MPEG-4 Part 2: Xvid, DivX) and MPEG (MPEG-1 / MPEG-2, or H.264 / H.265 in a transport stream) video that
-- can be split up: any run
-- of output frames is decoded from the sync sample (keyframe) before it, so parts of one video can be encoded at the
-- same time (Tools.ImportPool runs them on Actors) and put together with Flv2.assemble.
--
--   local m = ImportJob.parse(bytes)   the file's tracks (Formats.Mp4.parse, Formats.Webm.parse for WebM / MKV, or
--       Formats.Mpg.parse for MPEG program / transport streams: their video's samples are in its elementary stream, v.data;
--       Formats.Avi.parse for AVI: its MPEG-4 video and its MP3 / MP2 / AC-3 sound)
--
--   local t = ImportJob.mp4Timing(videoTrack, maxFps, maxSeconds)
--       t.fps, t.count (output frames), t.seconds, t.duration, t.srcFps, t.sourceIndex(k) -> display index of the
--       source frame shown at output frame k
--   ImportJob.mp4Frames(buf, videoTrack, t, k0, k1, sizes, onFrame, yield)
--       decodes output frames [k0, k1); onFrame(k, images) gets one RGBA image per size ({ w, h }) for each
--   local parts = ImportJob.encodeSegment(job, yield, progress)
--       job = { bytes (the MP4), k0, k1, sizes = { { w, h, kbps } ... }, maxFps, maxSeconds, layers, keyEvery }
--       -> one Flv2 part (w:finishPart()) per size; progress(framesDone) now and then
--   ImportJob.yuvToImages(dec, pic, sizes) -> one RGBA image per size ({ w, h }) of a decoded picture, box-filtered
--   ImportJob.yuvToImage(dec, pic, w, h) -> the same at one size
--   local part, info = ImportJob.encodeTsSegment(job, yield)   one HLS segment (MPEG-TS, H.264) -> one Flv2 part per size
--       job = { bytes (the segment), k0, k1 (its output frames in the whole video), offset (seconds from the segment's
--       start to frame k0), fps, sizes, layers }; the part is a single chunk starting at frame k0
--       info = { audio = Formats.Ts audio track (ADTS frames) or nil }
--   ImportJob.probeTs(bytes) -> width, height, hasAudio (a segment's picture size: its first frame is decoded)
--   (a stream part is an HLS segment (MPEG-TS, H.264), or a WebM stretch packed by Formats.Webm.packPart (VP9 / VP8))
--   ImportJob.tsFrames(bytes, k0, k1, offset, fps, sizes, onFrame(k, images), yield, from) -> audio track or nil
--       the decoded frames of one HLS segment, every one in [from or k0, k1) in order (clients decoding a stream
--       themselves; decoding starts at the last keyframe before `from`)
--   ImportJob.tsSound(bytes, segStart, yield, Encoder) -> clip, start   the sound of one stream part (AAC, MP3, Opus or Vorbis) as an
--       AudioLab clip (RBA3) and the stream time it starts at; nil when it has none (Encoder: AudioLab's Codec.Encoder,
--       required beforehand where this runs in parallel)

local FrameLab = script:FindFirstAncestor("FrameLab")
local Mp4 = require(FrameLab.Formats.Mp4)
local H264 = require(FrameLab.Video.H264)
local Hevc = require(FrameLab.Video.Hevc)
local Av1 = require(FrameLab.Video.Av1)
local Flv2 = require(FrameLab.Video.Flv2)
local Ts = require(FrameLab.Formats.Ts)
local Webm = require(FrameLab.Formats.Webm)
local Vp9 = require(FrameLab.Video.Vp9)
local Vp8 = require(FrameLab.Video.Vp8)
local Mpg = require(FrameLab.Formats.Mpg)
local Mpeg2 = require(FrameLab.Video.Mpeg2)
local Mpeg4 = require(FrameLab.Video.Mpeg4)
local Avi = require(FrameLab.Formats.Avi)

local Job = {}

-- a stream part: an MPEG-TS segment, or a WebM stretch (Formats.Webm.packPart), in the same shape
local function parseSegment(bytes)
	if Webm.isPart(bytes) then
		return Webm.unpackPart(bytes)
	end
	return Ts.parse(bytes)
end

function Job.parse(buf)
	if Avi.isAvi(buf) then
		local avi = Avi.parse(buf)
		return { container = "AVI", video = avi.video, audio = avi.track }
	end
	if Webm.isWebm(buf) then
		return Webm.parse(buf)
	end
	if Mpg.isMpg(buf) then
		return Mpg.parse(buf)
	end
	return Mp4.parse(buf)
end

do
	local readu8, writeu8, readu16, readu32, writeu32 = buffer.readu8, buffer.writeu8, buffer.readu16, buffer.readu32, buffer.writeu32
	local band, rshift = bit32.band, bit32.rshift

	local function colour(dec)
		local kr, kb = 0.299, 0.114
		if dec.bt709 then
			kr, kb = 0.2126, 0.0722
		end
		local kg = 1 - kr - kb
		local ys0, yscale, cscale = 16, 255 / 219, 255 / 224
		if dec.fullRange then
			ys0, yscale, cscale = 0, 1, 1
		end
		return ys0, yscale, 2 * (1 - kr) * cscale, 2 * (1 - kb) * cscale, 2 * (1 - kb) * kb / kg * cscale, 2 * (1 - kr) * kr / kg * cscale
	end

	-- box filter straight from the planes (any size)
	local MASKS = { 0x000000ff, 0x0000ffff, 0x00ffffff, 0xffffffff }
	local function direct(dec, pic, w: number, h: number)
		local W, Hh = dec.width, dec.height
		local cx, cy = dec.cropX or 0, dec.cropY or 0
		local Yp: buffer, Up: buffer, Vp: buffer = pic.Y, pic.U, pic.V
		local ys: number, cs: number, yo: number, co: number = pic.ys, pic.cs, pic.yo, pic.co
		local ylen = buffer.len(Yp)
		local out = buffer.create(w * h * 4)
		local ys0, yscale, rv, bu, gu, gv = colour(dec)
		local x0s, x1s, ms = table.create(w, 0), table.create(w, 0), table.create(w, 0)
		local c0s, c1s = table.create(w, 0), table.create(w, 0)
		for ox = 0, w - 1 do
			local x0 = ox * W // w
			local x1 = math.max(x0 + 1, (ox + 1) * W // w)
			x0s[ox + 1], x1s[ox + 1] = x0 + cx, x1 + cx
			ms[ox + 1] = x1 - x0 <= 4 and MASKS[x1 - x0] or 0
			c0s[ox + 1], c1s[ox + 1] = (x0 + cx) // 2, (x1 - 1 + cx) // 2 + 1
		end
		local SY = table.create(w, 0)
		local o = 0
		for oy = 0, h - 1 do
			local y0 = oy * Hh // h
			local y1 = math.max(y0 + 1, (oy + 1) * Hh // h)
			for ox = 1, w do
				SY[ox] = 0
			end
			for yy = y0, y1 - 1 do
				local row = yo + (yy + cy) * ys
				local safe = row + x1s[w] + 4 <= ylen
				for ox = 1, w do
					local a, b = row + x0s[ox], row + x1s[ox]
					local m = ms[ox]
					local s = 0
					if m ~= 0 and safe then
						local v = band(readu32(Yp, a), m)
						local t = band(v, 0x00ff00ff) + band(rshift(v, 8), 0x00ff00ff)
						s = band(t, 0xffff) + rshift(t, 16)
					else
						for p = a, b - 1 do
							s += readu8(Yp, p)
						end
					end
					SY[ox] += s
				end
			end
			local cyA, cyB = (y0 + cy) // 2, (y1 - 1 + cy) // 2
			local ny, nc = y1 - y0, cyB - cyA + 1
			for ox = 1, w do
				local ca, cb = c0s[ox], c1s[ox]
				local su, sv = 0, 0
				for yy = cyA, cyB do
					local row = co + yy * cs
					for p = row + ca, row + cb - 1 do
						su += readu8(Up, p)
						sv += readu8(Vp, p)
					end
				end
				local Y = (SY[ox] / ((x1s[ox] - x0s[ox]) * ny) - ys0) * yscale
				local m = (cb - ca) * nc
				local U = su / m - 128
				local V = sv / m - 128
				writeu32(out, o, math.clamp(math.floor(Y + rv * V + 0.5), 0, 255) + 256 * math.clamp(math.floor(Y - gu * U - gv * V + 0.5), 0, 255)
					+ 65536 * math.clamp(math.floor(Y + bu * U + 0.5), 0, 255) + 0xFF000000)
				o += 4
			end
		end
		return { width = w, height = h, data = out, hasAlpha = false }
	end

	-- the luma summed over 2 x 2 squares (one per chroma sample), as 16-bit values: W2 x H2
	local binBuf = buffer.create(4)
	local function binLuma(pic, cx: number, cy: number, W2: number, H2: number): buffer
		local Yp: buffer, ys: number = pic.Y, pic.ys
		local need = W2 * H2 * 2 + 4
		if buffer.len(binBuf) < need then
			binBuf = buffer.create(need)
		end
		local B = binBuf
		local quads = W2 // 2 -- (two squares, four pixels, at a time)
		for y2 = 0, H2 - 1 do
			local r0 = pic.yo + (2 * y2 + cy) * ys + cx
			local r1 = r0 + ys
			local o = y2 * W2 * 2
			for k = 0, quads - 1 do
				local a, b = readu32(Yp, r0 + 4 * k), readu32(Yp, r1 + 4 * k)
				writeu32(B, o + 4 * k, band(a, 0x00ff00ff) + band(rshift(a, 8), 0x00ff00ff) + band(b, 0x00ff00ff)
					+ band(rshift(b, 8), 0x00ff00ff))
			end
			if W2 % 2 == 1 then
				local x = 2 * (W2 - 1)
				buffer.writeu16(B, o + 2 * (W2 - 1), readu8(Yp, r0 + x) + readu8(Yp, r0 + x + 1) + readu8(Yp, r1 + x) + readu8(Yp, r1 + x + 1))
			end
		end
		return B
	end

	-- from the 2 x 2 squares (each output pixel at least one square wide and tall)
	local function binned(dec, pic, B: buffer, W2: number, H2: number, w: number, h: number)
		local cx, cy = dec.cropX or 0, dec.cropY or 0
		local Up: buffer, Vp: buffer = pic.U, pic.V
		local cs: number = pic.cs
		local cbase: number = pic.co + (cy // 2) * cs + cx // 2
		local out = buffer.create(w * h * 4)
		local ys0, yscale, rv, bu, gu, gv = colour(dec)
		local x0s, x1s = table.create(w, 0), table.create(w, 0)
		for ox = 0, w - 1 do
			local x0 = ox * W2 // w
			x0s[ox + 1] = x0
			x1s[ox + 1] = math.max(x0 + 1, (ox + 1) * W2 // w)
		end
		local SY, SU, SV = table.create(w, 0), table.create(w, 0), table.create(w, 0)
		local o = 0
		for oy = 0, h - 1 do
			local y0 = oy * H2 // h
			local y1 = math.max(y0 + 1, (oy + 1) * H2 // h)
			for ox = 1, w do
				SY[ox], SU[ox], SV[ox] = 0, 0, 0
			end
			for yy = y0, y1 - 1 do
				local lrow = yy * W2 * 2
				local crow = cbase + yy * cs
				for ox = 1, w do
					local a, b = x0s[ox], x1s[ox]
					local sy, su, sv = 0, 0, 0
					for x = a, b - 1 do
						sy += readu16(B, lrow + 2 * x)
						su += readu8(Up, crow + x)
						sv += readu8(Vp, crow + x)
					end
					SY[ox] += sy
					SU[ox] += su
					SV[ox] += sv
				end
			end
			local ny = y1 - y0
			for ox = 1, w do
				local m = (x1s[ox] - x0s[ox]) * ny
				local Y = (SY[ox] / (4 * m) - ys0) * yscale
				local U = SU[ox] / m - 128
				local V = SV[ox] / m - 128
				writeu8(out, o, math.clamp(math.floor(Y + rv * V + 0.5), 0, 255))
				writeu8(out, o + 1, math.clamp(math.floor(Y - gu * U - gv * V + 0.5), 0, 255))
				writeu8(out, o + 2, math.clamp(math.floor(Y + bu * U + 0.5), 0, 255))
				writeu8(out, o + 3, 255)
				o += 4
			end
		end
		return { width = w, height = h, data = out, hasAlpha = false }
	end

	-- a decoded picture (YUV 4:2:0) -> RGBA at each size { w, h } of sizes (box filter: each output pixel averages its
	-- source area); for small sizes the luma is first summed over the 2 x 2 squares that share a chroma sample, once for
	-- all of them
	function Job.yuvToImages(dec, pic, sizes)
		local W, Hh = dec.width, dec.height
		local cx, cy = dec.cropX or 0, dec.cropY or 0
		local W2, H2 = W // 2, Hh // 2
		local even = cx % 2 == 0 and cy % 2 == 0
		local out = table.create(#sizes)
		local B
		for i, sz in ipairs(sizes) do
			-- (from the squares when that is exact - a whole number of them per output pixel - or for a size at most a quarter
			-- of the picture's, where an output pixel spans several and their edges barely show)
			local exact = W % (2 * sz.w) == 0 and Hh % (2 * sz.h) == 0
			if even and (exact or (W >= 4 * sz.w and Hh >= 4 * sz.h)) then
				B = B or binLuma(pic, cx, cy, W2, H2)
				out[i] = binned(dec, pic, B, W2, H2, sz.w, sz.h)
			else
				out[i] = direct(dec, pic, sz.w, sz.h)
			end
		end
		return out
	end

	function Job.yuvToImage(dec, pic, w, h)
		return Job.yuvToImages(dec, pic, { { w = w, h = h } })[1]
	end
end

-- is this MP4 sample a picture other pictures predict from? (nal_ref_idc of its first slice)
local function isReferenceSample(buf, pos, size, nalLength)
	local stop = pos + size
	while pos + nalLength < stop do
		local n = 0
		for k = 0, nalLength - 1 do
			n = n * 256 + buffer.readu8(buf, pos + k)
		end
		pos += nalLength
		if n <= 0 or pos >= stop then
			break
		end
		local hdr = buffer.readu8(buf, pos)
		local t = bit32.band(hdr, 31)
		if t == 1 or t == 5 then
			return bit32.band(hdr, 0x60) ~= 0
		end
		pos += n
	end
	return true
end

-- does this MP4 sample hold an IDR picture (a clean start: nothing after it leans on the pictures before it)?
local function isIdrSample(buf, pos, size, nalLength)
	local stop = pos + size
	while pos + nalLength < stop do
		local n = 0
		for k = 0, nalLength - 1 do
			n = n * 256 + buffer.readu8(buf, pos + k)
		end
		pos += nalLength
		if n <= 0 or pos >= stop then
			break
		end
		local t = bit32.band(buffer.readu8(buf, pos), 31)
		if t == 5 then
			return true
		elseif t == 1 then
			return false
		end
		pos += n
	end
	return false
end

-- the same for an access unit with start codes (MPEG-TS)
local function isIdrUnit(buf, pos, size)
	local stop = pos + size - 3
	local p = pos
	while p < stop do
		if buffer.readu8(buf, p) == 0 and buffer.readu8(buf, p + 1) == 0 and buffer.readu8(buf, p + 2) == 1 then
			local t = bit32.band(buffer.readu8(buf, p + 3), 31)
			if t == 5 then
				return true
			elseif t == 1 then
				return false
			end
			p += 3
		else
			p += 1
		end
	end
	return false
end

-- H.265: the type of the first picture slice in a sample (length-prefixed units, or start codes when nalLength is nil)
local function hevcPictureType(buf, pos, size, nalLength)
	local stop = pos + size
	if not nalLength then
		local p = pos
		while p + 3 < stop do
			if buffer.readu8(buf, p) == 0 and buffer.readu8(buf, p + 1) == 0 and buffer.readu8(buf, p + 2) == 1 then
				local t = bit32.band(bit32.rshift(buffer.readu8(buf, p + 3), 1), 63)
				if t <= 21 then
					return t
				end
				p += 3
			else
				p += 1
			end
		end
		return nil
	end
	while pos + nalLength < stop do
		local n = 0
		for k = 0, nalLength - 1 do
			n = n * 256 + buffer.readu8(buf, pos + k)
		end
		pos += nalLength
		if n <= 0 or pos >= stop then
			break
		end
		local t = bit32.band(bit32.rshift(buffer.readu8(buf, pos), 1), 63)
		if t <= 21 then
			return t
		end
		pos += n
	end
	return nil
end
-- (IRAP: IDR, CRA or BLA - decoding can start there; the pictures after a CRA that lean on earlier ones show before it)
local function isHevcIrap(t)
	return t ~= nil and t >= 16 and t <= 21
end

-- display indices of the IDR samples, sorted (sync samples are checked: an "I" frame of an open GOP is listed as a sync
-- sample too, but the frames after it can still lean on older ones)
function Job.idrDisplay(buf, v, t)
	local list = {}
	if v.codec == "vp09" or v.codec == "vp08" or v.codec == "av01" or v.codec == "mpgv" or v.codec == "mp4v" or v.annexB then
		-- (a VP9 / VP8 / AV1 key frame always starts clean; MPEG streams list their key frames: Formats.Mpg; MPEG-4: its I pictures)
		for i, s in ipairs(v.samples) do
			if s.sync and not s.cut then
				table.insert(list, t.disp[i])
			end
		end
		table.sort(list)
		return list
	end
	if v.codec == "hvc1" or v.codec == "hev1" then
		local nalLength = Hevc.new(v.hvcC).nalLength
		for i, s in ipairs(v.samples) do
			if not s.cut and isHevcIrap(hevcPictureType(buf, s.pos, s.size, nalLength)) then
				table.insert(list, t.disp[i])
			end
		end
		table.sort(list)
		return list
	end
	local nalLength = H264.new(v.avcC).nalLength
	for i, s in ipairs(v.samples) do
		if (s.sync or i == 1) and not s.cut and isIdrSample(buf, s.pos, s.size, nalLength) then
			table.insert(list, t.disp[i])
		end
	end
	table.sort(list)
	return list
end

-- output frame ranges to encode apart: whole chunks (keyEvery frames), about `parts` of them, each starting soon after
-- an IDR picture (its decoding starts there; at most maxLead seconds before the part)
function Job.planSegments(t, idr, keyEvery, parts, maxLead)
	local count = t.count
	local chunks = math.ceil(count / keyEvery)
	local per = math.max(2, math.ceil(chunks / math.max(parts, 1)))
	maxLead = maxLead or 4
	local function lead(k)
		local si = t.sourceIndex(k)
		local best
		for _, d in ipairs(idr) do
			if d <= si then
				best = d
			else
				break
			end
		end
		if not best then
			return math.huge
		end
		return (si - best) / t.srcFps
	end
	local segs = {}
	local start = 0
	while start < count do
		local c = start // keyEvery + per
		local stop = count
		while c * keyEvery < count do
			if lead(c * keyEvery) <= maxLead then
				stop = c * keyEvery
				break
			end
			c += 1
		end
		table.insert(segs, { k0 = start, k1 = stop })
		start = stop
	end
	return segs
end

-- decoder errors without the script location
local function cleanError(err)
	return (string.gsub(tostring(err), "^[%w%._ ]+:%d+: ", ""))
end

function Job.mp4Timing(v, maxFps, maxSeconds)
	local samples = v.samples
	local n = #samples
	local order = table.create(n, 0)
	for i = 1, n do
		order[i] = i
	end
	table.sort(order, function(a, b)
		return samples[a].pts < samples[b].pts
	end)
	local disp, dispPts = table.create(n, 0), table.create(n, 0)
	for k, i in ipairs(order) do
		disp[i] = k
		dispPts[k] = samples[i].pts
	end
	local duration = v.duration
	local last = dispPts[n]
	if n > 1 then
		local frameDur = (last - dispPts[1]) / (n - 1)
		if duration <= 0 or duration < last then
			duration = last + frameDur
		end
	elseif duration <= 0 then
		duration = 1 / 24
	end
	local t = { n = n, disp = disp, dispPts = dispPts, duration = duration }
	t.srcFps = n / duration
	t.fps = math.max(1, math.floor(math.min(maxFps, t.srcFps) + 0.5))
	t.seconds = math.min(duration, maxSeconds)
	t.count = math.max(1, math.floor(t.seconds * t.fps + 1e-6))
	-- the last source frame (display order) whose time has come at output frame k
	function t.sourceIndex(k)
		local time = k / t.fps + 1e-6
		local lo, hi = 1, n
		while lo < hi do
			local mid = (lo + hi + 1) // 2
			if dispPts[mid] <= time then
				lo = mid
			else
				hi = mid - 1
			end
		end
		return lo
	end
	return t
end

function Job.mp4Frames(buf, v, t, k0, k1, sizes, onFrame, yield)
	buf = v.data or buf -- (an MPEG stream's video: its elementary stream)
	local samples, n, disp = v.samples, t.n, t.disp
	local mpgv = v.codec == "mpgv"
	local mp4v = v.codec == "mp4v"
	-- (VP9, VP8, AV1, MPEG-1 / MPEG-2 and MPEG-4 Part 2 are decoded alike here)
	local vp9 = v.codec == "vp09" or v.codec == "vp08" or v.codec == "av01" or mpgv or mp4v
	local hevc = v.codec == "hvc1" or v.codec == "hev1"
	local dec = mpgv and Mpeg2.new() or mp4v and Mpeg4.new(v.config, v.fourcc) or v.codec == "vp08" and Vp8.new()
		or v.codec == "av01" and Av1.new(v.av1C) or hevc and Hevc.new(v.hvcC) or vp9 and Vp9.new() or H264.new(v.avcC)
	local annexB = v.annexB -- (access units with start codes: MPEG-TS)
	local hevcNal = hevc and not annexB and dec.nalLength or nil
	-- (H.265 without temporal sub-layers: a picture no other picture leans on is decoded only when it is shown)
	local hevcFlat = false
	if hevc then
		hevcFlat = next(dec.spsList) ~= nil
		for _, s in pairs(dec.spsList) do
			if s.maxSubLayersMinus1 ~= 0 then
				hevcFlat = false
			end
		end
	end
	local pocType0 = true
	if not vp9 and not hevc then
		for _, s in pairs(dec.spsList) do
			if s.pocType ~= 0 then
				pocType0 = false
			end
		end
	end
	local needed = {}
	local first = t.sourceIndex(k0)
	for k = k0, k1 - 1 do
		needed[t.sourceIndex(k)] = true
	end
	-- start at the last IDR sample (decode order) shown no later than the first frame wanted
	local start = 1
	if k0 > 0 then
		for i = 1, n do
			local s = samples[i]
			local idr
			if hevc then
				idr = isHevcIrap(hevcPictureType(buf, s.pos, s.size, hevcNal))
			elseif annexB then
				idr = isIdrUnit(buf, s.pos, s.size)
			elseif vp9 then
				idr = s.sync
			else
				idr = s.sync and isIdrSample(buf, s.pos, s.size, dec.nalLength)
			end
			if disp[i] <= first and not s.cut and idr then
				start = i
			end
		end
		-- (an IDR inside an HLS segment may come without the stream's parameter sets: they are read from its first unit)
		if annexB and start > 1 then
			pcall(dec.decodeAccessUnit, dec, buf, samples[1].pos, samples[1].size)
			if hevc then
				dec:reset()
			end
		end
		-- (an MPEG key frame may come without the sequence header: it is read from the first frame)
		if (mpgv or (mp4v and not v.config)) and start > 1 then
			pcall(dec.decodeSample, dec, buf, samples[1].pos, samples[1].size)
		end
	end
	local cache = {}
	local nextSample = start
	local lastImages
	local function decodeUntil(si)
		while not cache[si] and nextSample <= n do
			local s = samples[nextSample]
			local idx = nextSample
			local di = disp[idx]
			nextSample += 1
			if s.cut then
				error(("the file is cut off: frame %d of %d is missing (the download stopped early)"):format(idx, n), 0)
			end
			local wanted
			if hevc then
				-- (sub-layer non-reference pictures: even types below 16)
				local pt = hevcFlat and not needed[di] and hevcPictureType(buf, s.pos, s.size, hevcNal)
				wanted = needed[di] or not (pt and pt < 16 and pt % 2 == 0)
			else
				wanted = needed[di] or vp9 or not pocType0 or annexB or isReferenceSample(buf, s.pos, s.size, dec.nalLength)
			end
			if wanted then
				local ok, pic = pcall(annexB and dec.decodeAccessUnit or dec.decodeSample, dec, buf, s.pos, s.size)
				if not ok then
					-- (a frame shown before the part starts may lean on pictures before its sync sample: not needed)
					if di >= first then
						error(("%s (frame %d of %d)"):format(cleanError(pic), idx, n), 0)
					end
				elseif pic and needed[di] then
					cache[di] = Job.yuvToImages(dec, pic, sizes)
				end
			end
			if yield then
				yield()
			end
		end
	end
	for k = k0, k1 - 1 do
		local si = t.sourceIndex(k)
		decodeUntil(si)
		local imgs = cache[si] or lastImages
		if imgs then
			onFrame(k, imgs)
			lastImages = imgs
		end
		for d in pairs(cache) do
			if d < si then
				cache[d] = nil
			end
		end
		if yield then
			yield()
		end
	end
end

function Job.encodeSegment(job, yield, progress)
	local buf = job.bytes
	local m = Job.parse(buf)
	local v = m.video
	local t = Job.mp4Timing(v, job.maxFps, job.maxSeconds)
	local writers = {}
	for i, sz in ipairs(job.sizes) do
		writers[i] = Flv2.writer(sz.w, sz.h, t.fps, { TargetKBps = sz.kbps, Layers = job.layers, KeyEvery = job.keyEvery,
			FirstFrame = job.k0 })
	end
	local done = 0
	Job.mp4Frames(buf, v, t, job.k0, job.k1, job.sizes, function(_, imgs)
		for i, w in ipairs(writers) do
			w:add(imgs[i])
			if yield then
				yield()
			end
		end
		done += 1
		if progress and done % 24 == 0 then
			progress(done)
		end
	end, yield)
	local parts = {}
	for i, w in ipairs(writers) do
		parts[i] = w:finishPart()
	end
	return parts
end

-- frame timing of one HLS segment's access units (decode order, pts in seconds): output frame k (0 = the part's first)
-- shows the last source frame whose time has come at offset + k / fps
local function unitTiming(units, fps, count, offset)
	local n = #units
	local order = table.create(n, 0)
	for i = 1, n do
		order[i] = i
	end
	table.sort(order, function(a, b)
		return units[a].pts < units[b].pts
	end)
	local disp, dispPts = table.create(n, 0), table.create(n, 0)
	local base = n > 0 and units[order[1]].pts or 0
	for k, i in ipairs(order) do
		disp[i] = k
		dispPts[k] = units[i].pts - base
	end
	local t = { n = n, disp = disp, dispPts = dispPts, fps = fps, count = count }
	function t.sourceIndex(k)
		local time = offset + (k - t.k0) / fps + 1e-6
		local lo, hi = 1, math.max(n, 1)
		while lo < hi do
			local mid = (lo + hi + 1) // 2
			if dispPts[mid] <= time then
				lo = mid
			else
				hi = mid - 1
			end
		end
		return lo
	end
	return t
end

function Job.probeTs(bytes)
	local ts = parseSegment(bytes)
	if ts.video.codec == "vp9" or ts.video.codec == "vp8" then
		local dec = (ts.video.codec == "vp8" and Vp8 or Vp9).new()
		for _, u in ipairs(ts.video.units) do
			local ok = pcall(dec.decodeSample, dec, u.data, 0, buffer.len(u.data))
			if ok and dec.width > 0 then
				return dec.width, dec.height, ts.audio.codec ~= nil
			end
		end
		error("the stream's first part has no picture", 0)
	end
	if ts.video.codec ~= "h264" then
		error(("the stream's video is %s: only H.264 can be read"):format(tostring(ts.video.codec or "missing")), 0)
	end
	local dec = H264.new(nil)
	for _, u in ipairs(ts.video.units) do
		local ok = pcall(dec.decodeAccessUnit, dec, u.data, 0, buffer.len(u.data))
		if ok and dec.width then
			return dec.width, dec.height, ts.audio.codec ~= nil
		end
	end
	error("the stream's first part has no picture", 0)
end

-- output frames [k0, k1) of one HLS segment (bytes), decoded: onFrame(k, images) gets one image per size, for every
-- frame (the last picture again where the segment has none; black where it has none at all); returns the segment's
-- audio track (Formats.Ts) or nil. from (default k0): the first frame wanted - decoding starts at the last keyframe
-- (IDR) before it, and the frames before it are left out
function Job.tsFrames(bytes, k0, k1, offset, fps, sizes, onFrame, yield, from)
	local ts = parseSegment(bytes)
	if ts.video.codec ~= "h264" and ts.video.codec ~= "vp9" and ts.video.codec ~= "vp8" then
		error(("the stream's video is %s: only H.264, VP9 and VP8 can be read"):format(tostring(ts.video.codec or "missing")), 0)
	end
	local vp9 = ts.video.codec == "vp9" or ts.video.codec == "vp8" -- (VP9 and VP8 are decoded alike here)
	local units = ts.video.units
	local total = 0
	for _, u in ipairs(units) do
		total += buffer.len(u.data)
	end
	local buf = buffer.create(math.max(total, 1))
	local samples = table.create(#units)
	local pos = 0
	for i, u in ipairs(units) do
		local len = buffer.len(u.data)
		buffer.copy(buf, pos, u.data, 0, len)
		samples[i] = { pos = pos, size = len, pts = u.pts, sync = i == 1 }
		pos += len
	end
	local count = k1 - k0
	local t = unitTiming(samples, fps, count, offset or 0)
	t.k0 = k0
	local first = math.clamp(from or k0, k0, math.max(k0, k1 - 1))
	local nextK, last = first, nil
	Job.mp4Frames(buf, { samples = samples, annexB = not vp9, codec = ts.video.codec == "vp8" and "vp08" or (vp9 and "vp09" or nil) }, t, first, k1, sizes, function(k, imgs)
		while nextK < k and last do
			onFrame(nextK, last)
			nextK += 1
		end
		onFrame(k, imgs)
		nextK, last = k + 1, imgs
	end, yield)
	if nextK < k1 and not last then
		last = {}
		for i, sz in ipairs(sizes) do
			local d = buffer.create(sz.w * sz.h * 4)
			buffer.fill(d, 0, 0)
			last[i] = { width = sz.w, height = sz.h, data = d }
		end
	end
	while nextK < k1 do
		onFrame(nextK, last)
		nextK += 1
	end
	return ts.audio.codec and ts.audio or nil
end

function Job.tsSound(bytes, segStart, yield, Encoder)
	local ts = parseSegment(bytes)
	local a = ts.audio
	local known = a.codec == "aac" or a.codec == "mp3" or a.codec == "opus" or a.codec == "vorbis"
	if not known or not a.frames or #a.frames == 0 then
		return nil
	end
	if not Encoder then
		local AudioLab = game:GetService("ReplicatedStorage"):FindFirstChild("LabHub")
		AudioLab = AudioLab and AudioLab:FindFirstChild("AudioLab")
		if not AudioLab then
			return nil
		end
		Encoder = require(AudioLab.Codec.Encoder)
	end
	-- (the frames one after another: an ADTS / MP3 stream; Opus / Vorbis packets are decoded as a track of them)
	local total = 0
	for _, f in ipairs(a.frames) do
		total += buffer.len(f.data)
	end
	local buf = buffer.create(total)
	local p = 0
	for _, f in ipairs(a.frames) do
		buffer.copy(buf, p, f.data)
		p += buffer.len(f.data)
	end
	local decoded
	if a.codec == "opus" or a.codec == "vorbis" then
		local list, q = table.create(#a.frames), 0
		for i, f in ipairs(a.frames) do
			list[i] = { pos = q, size = buffer.len(f.data) }
			q += buffer.len(f.data)
		end
		decoded = Encoder.decodeMp4Audio(buf, { codec = a.codec == "opus" and "Opus" or "vorbis", dOps = a.dOps, skip = a.skip,
			vorbisHeaders = a.vorbisHeaders, samples = list })
	else
		decoded = Encoder.decodeAudio(buf)
	end
	-- (not compressed here: EncodingService can't be used in parallel; the import worker compresses it after. Every
	-- part is encoded alike, short ones too - AudioLab's short-clip settings would give it fewer voices and other noise
	-- bands - so the parts join into one clip, Video.StreamSound)
	local clip = Encoder.encode(decoded, { Texture = false, Yield = yield, Compress = false, ShortSeconds = 0 })
	-- its start: the part's start plus how far its first sound frame comes after its first picture
	local base = math.huge
	for _, u in ipairs(ts.video.units) do
		base = math.min(base, u.pts)
	end
	if base == math.huge then
		base = a.frames[1].pts
	end
	return clip, segStart + (a.frames[1].pts - base)
end

function Job.encodeTsSegment(job, yield)
	local ts = parseSegment(job.bytes)
	if ts.video.codec ~= "h264" and ts.video.codec ~= "vp9" and ts.video.codec ~= "vp8" then
		error(("the stream's video is %s: only H.264, VP9 and VP8 can be read"):format(tostring(ts.video.codec or "missing")), 0)
	end
	local vp9 = ts.video.codec == "vp9" or ts.video.codec == "vp8" -- (VP9 and VP8 are decoded alike here)
	-- the access units in one buffer, as samples
	local units = ts.video.units
	local total = 0
	for _, u in ipairs(units) do
		total += buffer.len(u.data)
	end
	local buf = buffer.create(math.max(total, 1))
	local samples = table.create(#units)
	local pos = 0
	for i, u in ipairs(units) do
		local len = buffer.len(u.data)
		buffer.copy(buf, pos, u.data, 0, len)
		samples[i] = { pos = pos, size = len, pts = u.pts, sync = i == 1 }
		pos += len
	end
	local count = job.k1 - job.k0
	local t = unitTiming(samples, job.fps, count, job.offset or 0)
	t.k0 = job.k0
	local v = { samples = samples, annexB = not vp9, codec = ts.video.codec == "vp8" and "vp08" or (vp9 and "vp09" or nil) }
	local writers = {}
	for i, sz in ipairs(job.sizes) do
		writers[i] = Flv2.writer(sz.w, sz.h, job.fps, { TargetKBps = sz.kbps, Layers = job.layers, KeyEvery = count + 1,
			FirstFrame = job.k0 })
	end
	local info = { audio = ts.audio.codec and ts.audio or nil }
	local added, last = 0, nil
	local function add(imgs)
		for i, w in ipairs(writers) do
			w:add(imgs[i])
			if yield then
				yield()
			end
		end
		added += 1
		last = imgs
	end
	Job.mp4Frames(buf, v, t, job.k0, job.k1, job.sizes, function(_, imgs)
		add(imgs)
	end, yield)
	-- (the part always fills its frames: the next part starts right after it)
	if added < count and not last then
		last = {}
		for i, sz in ipairs(job.sizes) do
			local d = buffer.create(sz.w * sz.h * 4)
			buffer.fill(d, 0, 0)
			last[i] = { width = sz.w, height = sz.h, data = d }
		end
	end
	while added < count do
		add(last)
	end
	local parts = {}
	for i, w in ipairs(writers) do
		parts[i] = w:finishPart()
	end
	return parts, info
end

return Job
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">ImportPool</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[-- FrameLab import workers: encodes the parts of a video (Tools.ImportJob) on Actors, several at once (Parallel Luau),
-- on a running server. Each worker is a copy of Tools.ImportWorker in an Actor under ServerScriptService.
--   ImportPool.available() -> true on a running server (Studio's edit mode and clients encode in one piece)
--   ImportPool.run(bytes, jobs, workers, onProgress) -> results[i] = the parts of jobs[i] (ImportJob.encodeSegment);
--       bytes is the MP4, sent to each worker once; onProgress(framesDone) as they come in; a worker's error is raised
--   ImportPool.submit(job, workers, kind, onPart) -> parts, info   one HLS segment (ImportJob.encodeTsSegment) on the
--       next free worker; yields until it is done (nil, message when it failed). kind "sound": a stream part's sound
--       instead (job = { bytes, start }: ImportJob.tsSound -> clip, start); kind "blocks": its block picture
--       (Video.BlockStream.encodeSegment), handed over as it is made: onPart(kind, a, b) for each of its emits
local ImportPool = {}

local RunService = game:GetService("RunService")
local FrameLab = script:FindFirstAncestor("FrameLab")

local actors = {}
local fileId = 0

function ImportPool.available()
	return RunService:IsServer() and RunService:IsRunning() and FrameLab.Tools:FindFirstChild("ImportWorker") ~= nil
end

local function ensureActors(n)
	local sss = game:GetService("ServerScriptService")
	local folder = sss:FindFirstChild("FrameLabImportWorkers")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "FrameLabImportWorkers"
		folder.Parent = sss
	end
	while #actors < n do
		local a = Instance.new("Actor")
		a.Name = "Worker" .. (#actors + 1)
		local s = FrameLab.Tools.ImportWorker:Clone()
		s.Enabled = true
		s.Parent = a
		a.Parent = folder
		table.insert(actors, a)
	end
	-- (each worker says when its messages are bound)
	local t0 = os.clock()
	for i = 1, n do
		while not actors[i]:GetAttribute("Ready") do
			if os.clock() - t0 > 15 then
				return false
			end
			task.wait()
		end
	end
	return true
end

function ImportPool.run(bytes, jobs, workers, onProgress)
	workers = math.clamp(math.min(workers, #jobs), 1, 16)
	if not ensureActors(workers) then
		return nil, "the import workers didn't start"
	end
	fileId += 1
	local id = fileId
	local reply = Instance.new("BindableEvent")
	local results, failed = {}, nil
	local done, nextJob, running = {}, 1, 0
	local jobActor = {}
	local function dispatch(a)
		if failed or nextJob > #jobs then
			return
		end
		local i = nextJob
		nextJob += 1
		jobActor[i] = a
		running += 1
		a:SendMessage("segment", id, i, jobs[i], reply)
	end
	reply.Event:Connect(function(kind, i, value)
		if kind == "progress" then
			done[i] = value
			if onProgress then
				local total = 0
				for _, d in pairs(done) do
					total += d
				end
				onProgress(total)
			end
		elseif kind == "done" then
			results[i] = value
			done[i] = jobs[i].k1 - jobs[i].k0
			running -= 1
			dispatch(jobActor[i])
		elseif kind == "error" then
			failed = failed or value
			running -= 1
		end
	end)
	for k = 1, workers do
		actors[k]:SendMessage("file", id, bytes)
	end
	for k = 1, workers do
		dispatch(actors[k])
	end
	while running > 0 do
		task.wait(0.1)
	end
	for k = 1, workers do
		actors[k]:SendMessage("forget", id)
	end
	reply:Destroy()
	if failed then
		error(failed, 0)
	end
	return results
end

-- single jobs (HLS segments): one at a time on each worker, the rest wait for a free one
local submitReply, pending, nextJobId, free = nil, {}, 0, nil
function ImportPool.submit(job, workers, kind, onPart)
	workers = math.clamp(workers or 4, 1, 16)
	if not ensureActors(workers) then
		return nil, "the import workers didn't start"
	end
	if not submitReply then
		submitReply = Instance.new("BindableEvent")
		free = {}
		for i = 1, workers do
			table.insert(free, actors[i])
		end
		submitReply.Event:Connect(function(kind, id, a, b)
			local p = pending[id]
			if p and kind == "part" then
				-- (a piece of the work, as it is made)
				if p.onPart then
					task.spawn(p.onPart, a, b and b[1], b and b[2])
				end
			elseif p then
				pending[id] = nil
				table.insert(free, p.actor)
				p.result = { kind, a, b }
			end
		end)
	end
	while #free == 0 do
		task.wait(0.05)
	end
	local actor = table.remove(free, 1)
	nextJobId += 1
	local id = nextJobId
	local p = { actor = actor, onPart = onPart }
	pending[id] = p
	actor:SendMessage(kind or "ts", id, job, submitReply)
	while not p.result do
		task.wait(0.05)
	end
	if p.result[1] ~= "done" then
		return nil, tostring(p.result[2])
	end
	return p.result[2], p.result[3]
end

return ImportPool
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
        <Item class="Script" referent="60">
          <Properties>
            <string name="Name">ImportWorker</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <bool name="Disabled">true</bool>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <token name="RunContext">0</token>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[-- A FrameLab import worker: Tools.ImportPool puts copies of this script in Actors under ServerScriptService (here, in
-- ReplicatedStorage, it doesn't run). Each one encodes the parts of a video it is sent (Tools.ImportJob) in parallel
-- with the others; and single parts of streams (HLS segments) for Tools.Live.
local actor = script:GetActor()
if not actor then
	return
end
local FrameLab = game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("FrameLab")
local ImportJob = require(FrameLab.Tools.ImportJob)
-- (AudioLab's encoder, loaded now: a stream part's sound is encoded in parallel)
local Encoder
pcall(function()
	Encoder = require(game:GetService("ReplicatedStorage").LabHub.AudioLab.Codec.Encoder)
	Encoder.preload()
end)
local EncodingService = game:GetService("EncodingService")

-- (a job's result handed back; when it can't be sent, an error instead, so the job is never waited on forever)
local function answer(reply, id, ok, a, b)
	if ok and pcall(reply.Fire, reply, "done", id, a, b) then
		return
	end
	reply:Fire("error", id, ok and "the result couldn't be handed back" or tostring(a))
end

local files = {}
actor:BindToMessage("file", function(id, bytes)
	files[id] = bytes
end)
actor:BindToMessage("forget", function(id)
	files[id] = nil
end)
actor:BindToMessageParallel("segment", function(id, i, job, reply)
	while not files[id] do
		task.wait()
	end
	job.bytes = files[id]
	-- (a pause every ~25 ms keeps the server's frames short; the work goes on in parallel after it)
	local last = os.clock()
	local function yield()
		if os.clock() - last > 0.025 then
			task.wait()
			last = os.clock()
		end
	end
	local ok, res = pcall(ImportJob.encodeSegment, job, yield, function(framesDone)
		task.synchronize()
		reply:Fire("progress", i, framesDone)
		task.desynchronize()
		last = os.clock()
	end)
	task.synchronize()
	answer(reply, i, ok, res)
end)
-- one HLS segment (a stream's part, Tools.Live)
actor:BindToMessageParallel("ts", function(id, job, reply)
	local last = os.clock()
	local ok, parts, info = pcall(ImportJob.encodeTsSegment, job, function()
		if os.clock() - last > 0.025 then
			task.wait()
			last = os.clock()
		end
	end)
	task.synchronize()
	answer(reply, id, ok, parts, info)
end)
-- one stream part's sound (Tools.Live): an AudioLab clip and the time it starts at
actor:BindToMessageParallel("sound", function(id, job, reply)
	local last = os.clock()
	local ok, clip, start = pcall(ImportJob.tsSound, job.bytes, job.start, function()
		if os.clock() - last > 0.025 then
			task.wait()
			last = os.clock()
		end
	end, Encoder)
	task.synchronize()
	-- (packed without compression in parallel, where EncodingService can't be used: compressed now)
	if ok and clip and bit32.band(buffer.readu8(clip, 21), 1) == 0 then
		pcall(function()
			local head = 24 + buffer.readu8(clip, 7) + 4
			local payload = buffer.create(buffer.len(clip) - head)
			buffer.copy(payload, 0, clip, head)
			local z = EncodingService:CompressBuffer(payload, Enum.CompressionAlgorithm.Zstd, 6)
			local out = buffer.create(head + buffer.len(z))
			buffer.copy(out, 0, clip, 0, head)
			buffer.copy(out, head, z)
			buffer.writeu8(out, 21, bit32.bor(buffer.readu8(out, 21), 1))
			clip = out
		end)
	end
	answer(reply, id, ok, clip, start)
end)
-- one stream part as the block player's picture (Video.BlockStream), handed back piece by piece as they are made
local BlockStream
pcall(function()
	if require(FrameLab.Image.Blocks).ready() then -- (the pattern library, loaded now: the fitting runs in parallel)
		BlockStream = require(FrameLab.Video.BlockStream)
	end
end)
actor:BindToMessageParallel("blocks", function(id, job, reply)
	-- (shorter slices than an import's: a stream plays while this runs, and the server's frames wait on each slice)
	local last = os.clock()
	local ok, err = pcall(function()
		if not BlockStream then
			error("the block pattern library isn't loaded", 0)
		end
		BlockStream.encodeSegment(job, function()
			if os.clock() - last > 0.008 then
				task.wait()
				last = os.clock()
			end
		end, function(kind, a, b)
			task.synchronize()
			reply:Fire("part", id, kind, { a, b })
			task.desynchronize()
			last = os.clock()
		end, ImportJob)
	end)
	task.synchronize()
	answer(reply, id, ok, if ok then true else err)
end)
actor:SetAttribute("Ready", true)
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">Live</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[-- FrameLab streams: a video from an HLS address (.m3u8) that is never downloaded whole. The server fetches and converts
-- only the parts (the playlist's segments) near where it is being watched, on the import workers (Tools.ImportPool),
-- and keeps the most recently used few; clients stream the converted chunks like any other video (Tools.Net). A segment
-- is cut into FLV2 chunks of at most PART seconds, each made by its own worker (a long segment is ready sooner), so a
-- jump goes straight to the part it needs; the chunk asked for is made first. The picture only, for now: no sound.
--   Live.isPlaylist(text) -> true for an HLS playlist
--   local live = Live.open(url, text, options)   (yields: reads the playlists, probes the first segment)
--       options: Lines (the variant picked from a master playlist: the largest at most this tall), Sizes(w, h) ->
--       { { w, h, kbps } ... } (the sizes kept, largest first), Fps (24), MaxSeconds, Workers
--   live.fps, live.frames, live.seconds, live.width, live.height (the source's), live.sizes, live.held() (bytes in memory)
--   live.hasSound; live.sound(si) -> the sound of part si (rawHead's parts) as an AudioLab clip (RBA3) and the stream time
--       it starts at; nil while it is being made, nil, "none" for a part without sound (made on an import worker; asking
--       also starts the next part's)
--   live.head(rendition) -> the FLV2 header and chunk directory (chunk sizes 0: each chunk's come with it)
--   live.chunk(rendition, ci) -> bytes (the chunk's two coder streams), sizeA, sizeB; nil while it is being made, or
--       nil, message when it failed. Asking for a chunk also starts the few after it.
-- An MP4 / MOV at an address that sends byte ranges streams the same way (Live.openMp4): its sample tables (moov)
-- first, then each stretch from one keyframe to the next as it is watched, as access units (Ts.packUnits).
--   local live = Live.openMp4(url, options)   (yields; options as for open, and MaxLines: a taller source is refused
--       with a message saying it is imported whole instead)
-- A WebM (VP9 or VP8) at such an address streams alike (Live.openWebm, which openMp4 hands it to): its header and cue index
-- first, then each stretch from one cued key frame to a later one (Formats.Webm.packPart), with its Opus / Vorbis sound.
-- One without a cue index is refused with a message saying it is imported whole instead.
--   local live = Live.openWebm(url, options, firstBytes, fileSize)
-- Unconverted, for clients that decode the H.264 themselves (Video.DirectReader):
--   live.rawHead() -> a directory in the same form: one entry a segment (its first frame), the source's size
--   live.rawChunk(si) -> the segment's bytes (MPEG-TS), its offset (seconds from the segment's start to its first
--       frame); nil while it downloads, nil, message when that failed. Asking also fetches the next two.
-- As the block player's own picture, for clients that don't decode (phones; Video.BlockStream):
--   live.blocksHead() -> a directory in the same form: one entry a piece (its first frame), the picture's size
--   live.blockPiece(pi) -> the piece's bytes (Zstd); nil while it is being made, nil, message when that failed
local Live = {}

local HttpService = game:GetService("HttpService")
local EncodingService = game:GetService("EncodingService")
local FrameLab = script:FindFirstAncestor("FrameLab")
local Ts = require(FrameLab.Formats.Ts)
local ImportJob = require(FrameLab.Tools.ImportJob)
local ImportPool = require(FrameLab.Tools.ImportPool)
local Mp4 = require(FrameLab.Formats.Mp4)
local Webm = require(FrameLab.Formats.Webm)
local BlockStream = require(FrameLab.Video.BlockStream)

local AHEAD = 4 -- chunks made ahead of the one asked for
local KEEP = 40 -- converted chunks kept (the least recently asked for go first)
local PART = 4 -- longest chunk (seconds)
local KEEP_SEGMENTS = 12 -- downloaded segments kept (chunks are made from them; clients decoding themselves fetch them)
local KEEP_SOUNDS = 12 -- parts' sound clips kept
local BLOCK_LINES = 180 -- the block stream's picture (its short side)
local BLOCK_PIECE = 2 -- seconds a piece of it lasts (about)
local KEEP_PIECES = 40 -- block stream pieces kept

local function get(url)
	local ok, r = pcall(HttpService.RequestAsync, HttpService, { Url = url, Method = "GET" })
	if not ok then
		error("the download failed (" .. tostring(r) .. ")", 0)
	end
	if not r.Success then
		error(("the stream's server answered %d"):format(r.StatusCode), 0)
	end
	return r.Body
end

function Live.isPlaylist(text)
	return type(text) == "string" and string.find(string.sub(text, 1, 64), "#EXTM3U", 1, true) ~= nil
end

function Live.open(url, text, options)
	options = options or {}
	local pl = Ts.playlist(text, url)
	if #pl.variants > 0 then
		local v = Ts.pickVariant(pl.variants, options.Lines or 360)
		url = v.url
		pl = Ts.playlist(get(url), url)
	end
	if #pl.segments == 0 then
		error("the playlist lists no video parts", 0)
	end
	if not pl.ended then
		error("that's a live broadcast (its playlist isn't finished): only whole videos can be streamed", 0)
	end
	local firstBytes = buffer.fromstring(get(pl.segments[1].url))
	local w, h, hasAudio = ImportJob.probeTs(firstBytes)
	local o = table.clone(options)
	o.HasSound = hasAudio == true
	return Live.fromSegments(pl.segments, firstBytes, w, h, o)
end

-- the stream from its parts: srcSegments = { { start, duration, url or fetch = function() -> buffer } ... } (MPEG-TS,
-- or access units: Ts.packUnits); firstBytes: the first one's bytes; w, h: the picture's size
function Live.fromSegments(srcSegments, firstBytes, w, h, options)
	options = options or {}
	local self = { width = w, height = h }
	local fps = options.Fps or 24
	self.fps = fps
	self.sizes = options.Sizes and options.Sizes(w, h) or { { w = w, h = h, kbps = 60 } }
	local maxSeconds = options.MaxSeconds or 7200
	-- the chunks: each segment cut into pieces of at most PART seconds (frames [k0, k1); offset: seconds from the
	-- segment's start to frame k0)
	local segments = {}
	local frames = 0
	for si, sg in ipairs(srcSegments) do
		if sg.start >= maxSeconds then
			break
		end
		local k0 = math.ceil(sg.start * fps - 1e-6)
		local k1 = math.ceil(math.min(sg.start + sg.duration, maxSeconds) * fps - 1e-6)
		local pieces = math.max(1, math.ceil((k1 - k0) / (PART * fps)))
		for p = 0, pieces - 1 do
			local a = k0 + (k1 - k0) * p // pieces
			local b = k0 + (k1 - k0) * (p + 1) // pieces
			if b > a then
				table.insert(segments, { src = sg, segment = si, k0 = a, k1 = b, offset = a / fps - sg.start })
				frames = b
			end
		end
	end
	self.frames, self.seconds = frames, frames / fps
	self.segments = segments
	-- the segments whole (for clients decoding themselves)
	local raw = {}
	for _, sg in ipairs(srcSegments) do
		local k0 = math.ceil(sg.start * fps - 1e-6)
		if k0 >= frames then
			break
		end
		table.insert(raw, { src = sg, k0 = k0, offset = k0 / fps - sg.start })
	end
	self.raw = raw
	local workers = math.max(1, options.Workers or 4)

	-- the FLV2 header and directory of each size
	local heads = {}
	function self.head(r)
		if heads[r] then
			return heads[r]
		end
		local sz = self.sizes[r]
		local b = buffer.create(24 + #segments * 16)
		buffer.writestring(b, 0, "FLV2")
		buffer.writeu8(b, 4, 1)
		buffer.writeu8(b, 5, fps)
		buffer.writeu16(b, 6, sz.w)
		buffer.writeu16(b, 8, sz.h)
		buffer.writeu32(b, 10, frames)
		buffer.writeu16(b, 14, math.min(65535, fps * 4))
		buffer.writeu16(b, 16, #segments)
		buffer.writeu8(b, 18, 2)
		for i, sg in ipairs(segments) do
			buffer.writeu32(b, 24 + (i - 1) * 16 + 12, sg.k0)
		end
		heads[r] = b
		return b
	end

	-- converted chunks: cache[ci] = { [rendition] = { data, sizeA, sizeB } }, most recently used last in `order`
	local cache, order, busy, failed = {}, {}, {}, {}
	local running = 0
	-- downloaded segments (a segment's chunks share one download): segBytes[si] = buffer, or `true` while it downloads
	local segBytes, segOrder = { [1] = firstBytes }, { 1 }
	local function segment(si, src)
		while segBytes[si] == true do
			task.wait(0.05)
		end
		local b = segBytes[si]
		if not b then
			segBytes[si] = true
			local ok, res = pcall(function()
				return src.fetch and src.fetch() or buffer.fromstring(get(src.url))
			end)
			if not ok then
				segBytes[si] = nil
				error(res, 0)
			end
			b = res
			segBytes[si] = b
			table.insert(segOrder, si)
			while #segOrder > KEEP_SEGMENTS do
				local old = table.remove(segOrder, 1)
				if segBytes[old] ~= true then
					segBytes[old] = nil
				end
			end
		end
		return b
	end
	function self.rawHead()
		if heads.raw then
			return heads.raw
		end
		local b = buffer.create(24 + #raw * 16)
		buffer.writestring(b, 0, "FLV2")
		buffer.writeu8(b, 4, 1)
		buffer.writeu8(b, 5, fps)
		buffer.writeu16(b, 6, w)
		buffer.writeu16(b, 8, h)
		buffer.writeu32(b, 10, frames)
		buffer.writeu16(b, 14, math.min(65535, fps * 4))
		buffer.writeu16(b, 16, #raw)
		buffer.writeu8(b, 18, 2)
		for i, sg in ipairs(raw) do
			buffer.writeu32(b, 24 + (i - 1) * 16 + 12, sg.k0)
		end
		heads.raw = b
		return b
	end
	local rawFailed = {}
	local function fetchRaw(si)
		local ok, err = pcall(segment, si, raw[si].src)
		if not ok then
			rawFailed[si] = tostring(err)
		end
	end
	function self.rawChunk(si)
		local sg = raw[si]
		if not sg then
			return nil, "no such part"
		end
		if segBytes[si] == nil and not rawFailed[si] then
			task.spawn(fetchRaw, si)
		elseif typeof(segBytes[si]) == "buffer" then
			-- (the next two once this one is here, one download at a time: a jump's own part gets the whole connection)
			for k = si + 1, math.min(si + 2, #raw) do
				if segBytes[k] == true then
					break
				elseif segBytes[k] == nil and not rawFailed[k] then
					task.spawn(fetchRaw, k)
					break
				end
			end
		end
		local b = segBytes[si]
		if typeof(b) == "buffer" then
			return b, sg.offset
		end
		if rawFailed[si] then
			local why = rawFailed[si]
			rawFailed[si] = nil
			return nil, why
		end
		return nil
	end

	local function touch(ci)
		local i = table.find(order, ci)
		if i then
			table.remove(order, i)
		end
		table.insert(order, ci)
		while #order > KEEP do
			cache[table.remove(order, 1)] = nil
		end
	end
	local function make(ci)
		local sg = segments[ci]
		local ok, err = pcall(function()
			local bytes = segment(sg.segment, sg.src)
			local job = { kind = "ts", bytes = bytes, k0 = sg.k0, k1 = sg.k1, offset = sg.offset, fps = fps, sizes = self.sizes,
				layers = 2 }
			local parts
			if ImportPool.available() then
				local res, why = ImportPool.submit(job, workers)
				if not res then
					error(why, 0)
				end
				parts = res
			else
				parts = ImportJob.encodeTsSegment(job, function()
					task.wait()
				end)
			end
			local entry = {}
			for r, p in ipairs(parts) do
				local c = p.chunks[1]
				local a, b = c.a, c.b
				local data = buffer.create(buffer.len(a) + buffer.len(b))
				buffer.copy(data, 0, a)
				buffer.copy(data, buffer.len(a), b)
				entry[r] = { data = data, sizeA = buffer.len(a), sizeB = buffer.len(b) }
			end
			cache[ci] = entry
			touch(ci)
		end)
		if not ok then
			failed[ci] = tostring(err)
		end
		busy[ci] = nil
		running -= 1
	end
	local function start(ci)
		busy[ci] = true
		running += 1
		task.spawn(make, ci)
	end
	-- the chunk asked for first (alone, so nothing else slows it down); the ones after it once it is made
	local function schedule(from)
		if not cache[from] then
			if not busy[from] and not failed[from] then
				start(from)
			end
			return
		end
		for ci = from + 1, math.min(from + AHEAD, #segments) do
			if running >= workers then
				break
			end
			if not cache[ci] and not busy[ci] and not failed[ci] then
				start(ci)
			end
		end
	end
	self.schedule = schedule

	-- the sound: each part's own AudioLab clip, made from its downloaded bytes on an import worker
	self.hasSound = options.HasSound == true
	local sounds, soundBusy, soundFailed, soundOrder = {}, {}, {}, {}
	local function makeSound(si)
		local ok, err = pcall(function()
			local bytes = segment(si, raw[si].src)
			local clip, start
			if ImportPool.available() then
				clip, start = ImportPool.submit({ bytes = bytes, start = raw[si].src.start }, workers, "sound")
				if clip == nil and start ~= nil then
					error(start, 0)
				end
			else
				clip, start = ImportJob.tsSound(bytes, raw[si].src.start, function()
					task.wait()
				end)
			end
			sounds[si] = clip and { clip = clip, start = start } or false
			table.insert(soundOrder, si)
			while #soundOrder > KEEP_SOUNDS do
				sounds[table.remove(soundOrder, 1)] = nil
			end
		end)
		if not ok then
			soundFailed[si] = tostring(err)
		end
		soundBusy[si] = nil
	end
	function self.sound(si)
		if not raw[si] then
			return nil, "no such part"
		end
		for k = si, math.min(si + 1, #raw) do
			if sounds[k] == nil and not soundBusy[k] and not soundFailed[k] then
				soundBusy[k] = true
				task.spawn(makeSound, k)
			end
		end
		local s = sounds[si]
		if s then
			return s.clip, s.start
		elseif s == false then
			return nil, "none"
		end
		if soundFailed[si] then
			local why = soundFailed[si]
			soundFailed[si] = nil
			return nil, why
		end
		return nil
	end

	-- the block stream (Video.BlockStream): the block player's own picture at BLOCK_LINES, for clients that don't decode
	-- the video themselves (phones). Made on the import workers a segment at a time, as it is asked for, in pieces of
	-- about BLOCK_PIECE seconds (a chunk each for the clients); a segment carries on from where the one before ended, and
	-- the next one is started as soon as one is done while the stream is being watched
	local BW, BH = BlockStream.size(w, h, BLOCK_LINES)
	self.blockWidth, self.blockHeight = BW, BH
	local pieces, segPieces = {}, {}
	for si, rs in ipairs(raw) do
		local k0 = rs.k0
		local k1 = raw[si + 1] and raw[si + 1].k0 or frames
		if k1 > k0 then
			local n = math.max(1, math.floor((k1 - k0) / (BLOCK_PIECE * fps) + 0.5))
			local cuts = {}
			for p = 0, n - 1 do
				local a = k0 + (k1 - k0) * p // n
				table.insert(cuts, a)
				table.insert(pieces, { seg = si, i = p + 1, k0 = a })
			end
			segPieces[si] = { first = #pieces - n + 1, cuts = cuts, k1 = k1 }
		end
	end
	function self.blocksHead()
		if heads.blocks then
			return heads.blocks
		end
		local b = buffer.create(24 + #pieces * 16)
		buffer.writestring(b, 0, "FLV2")
		buffer.writeu8(b, 4, 1)
		buffer.writeu8(b, 5, fps)
		buffer.writeu16(b, 6, BW)
		buffer.writeu16(b, 8, BH)
		buffer.writeu32(b, 10, frames)
		buffer.writeu16(b, 14, math.min(65535, fps * 4))
		buffer.writeu16(b, 16, #pieces)
		buffer.writeu8(b, 18, 2)
		for i, pc in ipairs(pieces) do
			buffer.writeu32(b, 24 + (i - 1) * 16 + 12, pc.k0)
		end
		heads.blocks = b
		return b
	end
	local blockData, blockOrder, blockFailed, blockJobs, blockEnd, blockEndOrder, blockAsked = {}, {}, {}, {}, {}, {}, {}
	-- (a piece of segment si is being made: a job on it started at or before that piece)
	local function covered(si, i)
		for _, j in ipairs(blockJobs[si] or {}) do
			if j.from <= i then
				return true
			end
		end
		return false
	end
	local function makeBlocks(si, from)
		local sp = segPieces[si]
		local rec = { from = from }
		blockJobs[si] = blockJobs[si] or {}
		table.insert(blockJobs[si], rec)
		local ok, err = pcall(function()
			local bytes = segment(si, raw[si].src)
			local job = { bytes = bytes, k0 = raw[si].k0, k1 = sp.k1, offset = raw[si].offset, fps = fps, w = BW, h = BH,
				cuts = sp.cuts, from = from, state = from == 1 and blockEnd[si - 1] or nil }
			local function onPart(kind, a, b)
				if kind == "piece" then
					local pi = sp.first + a - 1
					blockData[pi] = EncodingService:CompressBuffer(b, Enum.CompressionAlgorithm.Zstd, 6)
					blockFailed[pi] = nil
					table.insert(blockOrder, pi)
					while #blockOrder > KEEP_PIECES do
						blockData[table.remove(blockOrder, 1)] = nil
					end
				elseif kind == "state" then
					blockEnd[si] = a
					table.insert(blockEndOrder, si)
					while #blockEndOrder > 3 do
						blockEnd[table.remove(blockEndOrder, 1)] = nil
					end
				end
			end
			if ImportPool.available() then
				local res, why = ImportPool.submit(job, workers, "blocks", onPart)
				if res == nil and why then
					error(why, 0)
				end
			else
				BlockStream.encodeSegment(job, function()
					task.wait()
				end, onPart)
			end
		end)
		local list = blockJobs[si]
		table.remove(list, table.find(list, rec))
		if #list == 0 then
			blockJobs[si] = nil
		end
		if not ok then
			for i = from, #sp.cuts do
				local pi = sp.first + i - 1
				if not blockData[pi] then
					blockFailed[pi] = tostring(err)
				end
			end
			return
		end
		local nextSp = segPieces[si + 1]
		if nextSp and os.clock() - (blockAsked[si] or -math.huge) < 20 and not blockData[nextSp.first] and not covered(si + 1, 1) then
			task.spawn(makeBlocks, si + 1, 1)
		end
	end
	function self.blockPiece(pi)
		local pc = pieces[pi]
		if not pc then
			return nil, "no such part"
		end
		blockAsked[pc.seg] = os.clock()
		local d = blockData[pi]
		if d then
			return d
		end
		if blockFailed[pi] then
			local why = blockFailed[pi]
			blockFailed[pi] = nil -- (asked again: made again)
			return nil, why
		end
		if not covered(pc.seg, pc.i) then
			task.spawn(makeBlocks, pc.seg, pc.i)
		end
		return nil
	end

	-- bytes this stream holds in the server's memory now (downloaded parts, converted chunks)
	function self.held()
		local n = 0
		for _, b in pairs(segBytes) do
			if typeof(b) == "buffer" then
				n += buffer.len(b)
			end
		end
		for _, e in pairs(cache) do
			for _, c in pairs(e) do
				n += buffer.len(c.data)
			end
		end
		for _, s in pairs(sounds) do
			if s then
				n += buffer.len(s.clip)
			end
		end
		for _, d in pairs(blockData) do
			n += buffer.len(d)
		end
		return n
	end

	function self.chunk(r, ci)
		if not segments[ci] then
			return nil, "no such part"
		end
		schedule(ci)
		local e = cache[ci]
		if e and e[r] then
			touch(ci)
			return e[r].data, e[r].sizeA, e[r].sizeB
		end
		if failed[ci] then
			local why = failed[ci]
			failed[ci] = nil -- (asked again: tried again)
			return nil, why
		end
		return nil
	end

	schedule(1)
	return self
end

-- part of a file at an address: bytes [a, b] (a string) and the file's whole size; error when the site sends no ranges
local function range(url, a, b)
	local ok, r = pcall(HttpService.RequestAsync, HttpService, { Url = url, Method = "GET",
		Headers = { Range = ("bytes=%d-%d"):format(a, b) } })
	if not ok then
		error("the download failed (" .. tostring(r) .. ")", 0)
	end
	if r.StatusCode == 200 then
		error("that site doesn't send parts of a file (no byte ranges), so it can't be streamed", 0)
	elseif r.StatusCode ~= 206 then
		error(("the video's site answered %d"):format(r.StatusCode), 0)
	end
	local total
	for k, v in pairs(r.Headers or {}) do
		if string.lower(k) == "content-range" then
			total = tonumber(string.match(v, "/(%d+)"))
		end
	end
	return r.Body, total
end

local function be32(s, o)
	return string.byte(s, o + 1) * 16777216 + string.byte(s, o + 2) * 65536 + string.byte(s, o + 3) * 256 + string.byte(s, o + 4)
end

function Live.openMp4(url, options)
	options = options or {}
	-- the top-level boxes up to the sample tables (moov: at the start of a file made for the web, else after the media)
	local head, total = range(url, 0, 65535)
	total = total or #head
	if string.sub(head, 1, 4) == "\26\69\223\163" then
		return Live.openWebm(url, options, head, total)
	end
	local moovAt, moovSize
	local pos = 0
	for _ = 1, 64 do
		if pos + 8 > total then
			break
		end
		local h = (pos + 16 <= #head) and string.sub(head, pos + 1, pos + 16) or range(url, pos, math.min(pos + 15, total - 1))
		local size, t = be32(h, 0), string.sub(h, 5, 8)
		if size == 1 and #h >= 16 then
			size = be32(h, 8) * 4294967296 + be32(h, 12)
		elseif size == 0 then
			size = total - pos
		end
		if size < 8 then
			error("the file isn't a readable MP4 (a damaged box)", 0)
		elseif t == "moov" then
			moovAt, moovSize = pos, size
			break
		elseif t == "moof" then
			error("this is a fragmented MP4 (made for streaming sites), which can't be streamed here: import it instead", 0)
		end
		pos += size
	end
	if not moovAt then
		error("no movie header (moov) found: this isn't an MP4 / MOV, or the file is cut off", 0)
	end
	if moovSize > 48 * 1048576 then
		error("the video's header is too big to stream", 0)
	end
	local moov = (moovAt + moovSize <= #head) and string.sub(head, moovAt + 1, moovAt + moovSize)
		or range(url, moovAt, moovAt + moovSize - 1)
	local m = Mp4.parse(buffer.fromstring(moov))
	local v = m.video
	if not v.avcC then
		error(("the video is %s: only H.264 can be streamed"):format(tostring(v.codec)), 0)
	end
	local maxLines = options.MaxLines or 400
	if math.min(v.width or 0, v.height or 0) > maxLines then
		error(("%dx%d is more than stream mode's %dp, so it is imported whole instead (shrunk to fit)"):format(v.width or 0,
			v.height or 0, maxLines), 0)
	end
	local samples = v.samples
	for _, s in ipairs(samples) do
		s.cut = nil -- (located in the file, not in the header this was read from)
	end
	local nalLength = v.avcC.nalLength
	local params = {}
	for _, p in ipairs(v.avcC.sps) do
		table.insert(params, p)
	end
	for _, p in ipairs(v.avcC.pps) do
		table.insert(params, p)
	end
	-- one access unit with start codes from a sample (length-prefixed NAL units); the parameter sets before the first
	local function unitOf(body, a, s, first)
		local off, stop = s.pos - a + 1, s.pos - a + s.size
		local nals = {}
		local p = off
		while p + nalLength - 1 <= stop do
			local n = 0
			for k = 0, nalLength - 1 do
				n = n * 256 + string.byte(body, p + k)
			end
			p += nalLength
			if n <= 0 or p + n - 1 > stop then
				break
			end
			table.insert(nals, { p, n })
			p += n
		end
		local size = 0
		if first then
			for _, x in ipairs(params) do
				size += 4 + buffer.len(x)
			end
		end
		for _, x in ipairs(nals) do
			size += 4 + x[2]
		end
		local out = buffer.create(size)
		local o = 0
		if first then
			for _, x in ipairs(params) do
				buffer.writeu32(out, o, 0x01000000) -- (00 00 00 01)
				buffer.copy(out, o + 4, x)
				o += 4 + buffer.len(x)
			end
		end
		for _, x in ipairs(nals) do
			buffer.writeu32(out, o, 0x01000000)
			buffer.writestring(out, o + 4, string.sub(body, x[1], x[1] + x[2] - 1))
			o += 4 + x[2]
		end
		return out
	end
	-- the sound, when it is AAC: its samples (in time order) and the ADTS header each one is sent with
	local aSamples, adtsHeader
	local au = m.audio
	local asc = au and au.esds and au.esds.asc
	local oti = au and au.esds and au.esds.oti
	if au and au.samples and asc and buffer.len(asc) >= 2 and (oti == 0x40 or (oti and oti >= 0x66 and oti <= 0x68)) then
		local b0, b1 = buffer.readu8(asc, 0), buffer.readu8(asc, 1)
		local objType = bit32.rshift(b0, 3)
		local freqIdx = bit32.bor(bit32.lshift(bit32.band(b0, 7), 1), bit32.rshift(b1, 7))
		local chan = bit32.band(bit32.rshift(b1, 3), 15)
		local profile = math.clamp((objType == 5 or objType == 29) and 1 or objType - 1, 0, 3) -- (HE-AAC: its LC core)
		if freqIdx < 13 and chan > 0 then
			aSamples = table.clone(au.samples)
			for _, s in ipairs(aSamples) do
				s.cut = nil
			end
			table.sort(aSamples, function(x, y)
				return x.pts < y.pts
			end)
			function adtsHeader(f, size)
				local len = size + 7
				buffer.writeu8(f, 0, 0xFF)
				buffer.writeu8(f, 1, 0xF1)
				buffer.writeu8(f, 2, bit32.bor(bit32.lshift(profile, 6), bit32.lshift(freqIdx, 2), bit32.rshift(chan, 2)))
				buffer.writeu8(f, 3, bit32.bor(bit32.lshift(bit32.band(chan, 3), 6), bit32.band(bit32.rshift(len, 11), 3)))
				buffer.writeu8(f, 4, bit32.band(bit32.rshift(len, 3), 0xFF))
				buffer.writeu8(f, 5, bit32.bor(bit32.lshift(bit32.band(len, 7), 5), 0x1F))
				buffer.writeu8(f, 6, 0xFC)
			end
		end
	end
	-- the parts: from each keyframe to the next (decode order)
	local keys = {}
	for i, s in ipairs(samples) do
		if s.sync or i == 1 then
			table.insert(keys, i)
		end
	end
	local srcSegments = {}
	for k, i0 in ipairs(keys) do
		local i1 = (keys[k + 1] or (#samples + 1)) - 1
		local start, a, b = math.huge, math.huge, 0
		for i = i0, i1 do
			local s = samples[i]
			start = math.min(start, s.pts)
			a = math.min(a, s.pos)
			b = math.max(b, s.pos + s.size - 1)
		end
		local sg = { start = start, a = a, b = b }
		function sg.fetch()
			local body = range(url, sg.a, sg.b)
			if #body < sg.b - sg.a + 1 then
				error("the video's site sent less than was asked for", 0)
			end
			local units = table.create(i1 - i0 + 1)
			for i = i0, i1 do
				units[i - i0 + 1] = { pts = samples[i].pts, data = unitOf(body, sg.a, samples[i], i == i0) }
			end
			local audio
			if sg.audio then
				audio = {}
				for j = sg.audio[1], sg.audio[2] do
					local s = aSamples[j]
					local f = buffer.create(7 + s.size)
					adtsHeader(f, s.size)
					buffer.writestring(f, 7, string.sub(body, s.pos - sg.a + 1, s.pos - sg.a + s.size))
					table.insert(audio, { pts = s.pts, data = f })
				end
			end
			return Ts.packUnits(units, audio)
		end
		table.insert(srcSegments, sg)
	end
	table.sort(srcSegments, function(x, y)
		return x.start < y.start
	end)
	for k, sg in ipairs(srcSegments) do
		local nextStart = srcSegments[k + 1] and srcSegments[k + 1].start or v.duration
		sg.duration = math.max(0, nextStart - sg.start)
	end
	-- the sound (AAC): each part carries the samples of its own stretch of time, as ADTS frames (Ts.packUnits)
	if aSamples then
		local j = 1
		for k, sg in ipairs(srcSegments) do
			local stop = srcSegments[k + 1] and srcSegments[k + 1].start or math.huge
			local j0 = j
			while aSamples[j] and aSamples[j].pts < stop do
				local s = aSamples[j]
				sg.a = math.min(sg.a, s.pos)
				sg.b = math.max(sg.b, s.pos + s.size - 1)
				j += 1
			end
			if j > j0 then
				sg.audio = { j0, j - 1 }
			end
		end
	end
	local firstBytes = srcSegments[1].fetch()
	local w, h, hasAudio = ImportJob.probeTs(firstBytes)
	-- (the video's own rate, at most 24)
	local srcFps = #samples / math.max(v.duration, 1e-3)
	local o = table.clone(options)
	o.Fps = o.Fps or math.max(1, math.floor(math.min(24, srcFps) + 0.5))
	o.HasSound = hasAudio == true
	local live = Live.fromSegments(srcSegments, firstBytes, w, h, o)
	live.mp4 = true
	return live
end

function Live.openWebm(url, options, first, total)
	options = options or {}
	if not first then
		first, total = range(url, 0, 65535)
	end
	total = total or #first
	local head = Webm.readHead(buffer.fromstring(first))
	if not head.firstCluster and #first < total then
		-- (a long header: read again, more of it)
		first = range(url, 0, math.min(total, 2097152) - 1)
		head = Webm.readHead(buffer.fromstring(first))
	end
	local vt = head.video
	if not vt then
		error("the WebM has no video track", 0)
	elseif vt.codecId ~= "V_VP9" and vt.codecId ~= "V_VP8" then
		local names = { V_AV1 = "AV1", ["V_MPEG4/ISO/AVC"] = "H.264", ["V_MPEGH/ISO/HEVC"] = "H.265" }
		error(("the video is %s: only VP9 and VP8 WebM can be streamed (import it instead)"):format(names[vt.codecId] or vt.codecId), 0)
	elseif vt.encoded then
		error("the WebM's tracks are compressed or encrypted, so it can't be streamed", 0)
	end
	local maxLines = options.MaxLines or 400
	if math.min(vt.width or 0, vt.height or 0) > maxLines then
		error(("%dx%d is more than stream mode's %dp, so it is imported whole instead (shrunk to fit)"):format(vt.width or 0,
			vt.height or 0, maxLines), 0)
	end
	local cues = head.cues
	if (not cues or #cues == 0) and head.cuesPos and head.cuesPos < total then
		local piece = range(url, head.cuesPos, math.min(total, head.cuesPos + 4194304) - 1)
		cues = Webm.readCuesAt(buffer.fromstring(piece), head.cuesPos, head.segStart, head.timescale, head.cuesPos)
	end
	if not cues or #cues == 0 then
		error("the WebM has no index (cues), so it can't be streamed in parts: it is imported whole instead", 0)
	end
	local plan = Webm.planParts(head, cues, total, 2)
	local t0 = plan[1].start
	local srcSegments = {}
	for k, p in ipairs(plan) do
		local sg = { start = p.start - t0, a = p.a, b = p.b }
		local nextStart = plan[k + 1] and plan[k + 1].start or math.max(head.duration, p.start + 1)
		sg.duration = math.max(0, nextStart - p.start)
		function sg.fetch()
			local body = range(url, sg.a, sg.b)
			if #body < sg.b - sg.a + 1 then
				error("the video's site sent less than was asked for", 0)
			end
			return Webm.packPart(buffer.fromstring(body), sg.a, head)
		end
		table.insert(srcSegments, sg)
	end
	local firstBytes = srcSegments[1].fetch()
	local w, h, hasAudio = ImportJob.probeTs(firstBytes)
	-- (the video's own rate, at most 24: from the track's frame duration, else from the first part)
	local srcFps
	if vt.defaultDuration and vt.defaultDuration > 0 then
		srcFps = 1e9 / vt.defaultDuration
	else
		local units = Webm.unpackPart(firstBytes).video.units
		srcFps = #units / math.max(srcSegments[1].duration, 1e-3)
	end
	local o = table.clone(options)
	o.Fps = o.Fps or math.max(1, math.floor(math.min(24, srcFps) + 0.5))
	o.HasSound = hasAudio == true
	local live = Live.fromSegments(srcSegments, firstBytes, w, h, o)
	live.webm = true
	return live
end

return Live
]]></string>
