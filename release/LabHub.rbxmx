              <string name="Source"><![CDATA[-- SILK tables (RFC 6716 section 4.2), generated from libopus silk/ (BSD-3-Clause, see the notice in the Opus module).
-- Arrays are flattened row by row; a C offset k is index k + 1 here.

local T = {}

T.LTP_per_index_iCDF = {
	179, 99, 0,
}
T.LTP_gain_iCDF_0 = {
