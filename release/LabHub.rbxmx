-- frame contexts (the adaptive probabilities)

local function defaultContext()
	return {
		coef = { table.clone(T.COEF_4X4), table.clone(T.COEF_8X8), table.clone(T.COEF_16X16), table.clone(T.COEF_32X32) },
		skip = { 192, 128, 64 },
		tx8 = { 100, 66 },
		tx16 = { 20, 152, 15, 101 },
		tx32 = { 3, 136, 37, 5, 52, 13 },
		yMode = table.clone(T.IF_Y),
		uvMode = table.clone(T.IF_UV),
		partition = table.clone(T.PARTITION),
		interMode = table.clone(T.INTER_MODE),
		interp = table.clone(T.SWITCHABLE_INTERP),
		intraInter = table.clone(T.INTRA_INTER),
		compInter = table.clone(T.COMP_INTER),
		singleRef = table.clone(T.SINGLE_REF),
		compRef = table.clone(T.COMP_REF),
		joints = { 32, 64, 96 },
		sign = { 128, 128 },
		classes = { 224, 144, 192, 168, 192, 176, 192, 198, 198, 245, 216, 128, 176, 160, 176, 176, 192, 198, 198, 208 },
		class0 = { 216, 208 },
		bits = { 136, 140, 148, 160, 176, 192, 224, 234, 234, 240, 136, 140, 148, 160, 176, 192, 224, 234, 234, 240 },
		class0fp = { 128, 128, 64, 96, 112, 64, 128, 128, 64, 96, 112, 64 },
		fp = { 64, 96, 64, 64, 96, 64 },
		class0hp = { 160, 160 },
		hp = { 128, 128 },
		initialized = true,
	}
end

local function cloneContext(c)
	local n = {}
	for k, v in pairs(c) do
		if k == "coef" then
			n.coef = { table.clone(v[1]), table.clone(v[2]), table.clone(v[3]), table.clone(v[4]) }
		elseif type(v) == "table" then
			n[k] = table.clone(v)
		else
			n[k] = v
		end
	end
	return n
end

local function newCounts()
	local c = { coef = {}, eob = {} }
	for t = 1, 4 do
		c.coef[t] = table.create(576, 0)
		c.eob[t] = table.create(144, 0)
	end
	c.skip = table.create(6, 0)
	c.tx8 = table.create(4, 0)
	c.tx16 = table.create(6, 0)
	c.tx32 = table.create(8, 0)
	c.yMode = table.create(40, 0)
	c.uvMode = table.create(100, 0)
	c.partition = table.create(64, 0)
	c.interMode = table.create(28, 0)
	c.interp = table.create(12, 0)
	c.intraInter = table.create(8, 0)
	c.compInter = table.create(10, 0)
	c.singleRef = table.create(20, 0)
	c.compRef = table.create(10, 0)
	c.joints = table.create(4, 0)
	c.sign = table.create(4, 0)
	c.classes = table.create(22, 0)
	c.class0 = table.create(4, 0)
	c.bits = table.create(40, 0)
	c.class0fp = table.create(16, 0)
	c.fp = table.create(8, 0)
	c.class0hp = table.create(4, 0)
	c.hp = table.create(4, 0)
	return c
end

local function adaptCoef(fc, pre, counts, intraOnly, lastKey)
	local sat, factor = 24, 112
	if not intraOnly and lastKey then
		factor = 128
	end
	for t = 1, 4 do
		local probs, pp, cc, ec = fc.coef[t], pre.coef[t], counts.coef[t], counts.eob[t]
		for i = 0, 1 do
			for j = 0, 1 do
				for k = 0, 5 do
					for l = 0, (k == 0 and 2 or 5) do
						local ci = ((i * 2 + j) * 6 + k) * 6 + l
						local n0, n1, n2, neob = cc[ci * 4 + 1], cc[ci * 4 + 2], cc[ci * 4 + 3], cc[ci * 4 + 4]
						local b0, b1 = neob, ec[ci + 1] - neob
						local pi = ci * 3
						for m = 0, 2 do
							local c0, c1
							if m == 0 then
								c0, c1 = b0, b1
							elseif m == 1 then
								c0, c1 = n0, n1 + n2
							else
								c0, c1 = n1, n2
							end
							local den = c0 + c1
							local prob = den == 0 and 128 or getProb(c0, den)
							local count = min(den, sat)
							local f = factor * count // sat
							probs[pi + m + 1] = weighted(pp[pi + m + 1], prob, f)
						end
					end
				end
			end
		end
	end
end

local function adaptMode(fc, pre, c, switchable, txSelect)
	for i = 1, 4 do
		fc.intraInter[i] = mergeModeMv(pre.intraInter[i], c.intraInter[i * 2 - 1], c.intraInter[i * 2])
	end
	for i = 1, 5 do
		fc.compInter[i] = mergeModeMv(pre.compInter[i], c.compInter[i * 2 - 1], c.compInter[i * 2])
		fc.compRef[i] = mergeModeMv(pre.compRef[i], c.compRef[i * 2 - 1], c.compRef[i * 2])
		for j = 0, 1 do
			local k = (i - 1) * 2 + j
			fc.singleRef[k + 1] = mergeModeMv(pre.singleRef[k + 1], c.singleRef[k * 2 + 1], c.singleRef[k * 2 + 2])
		end
	end
	for i = 0, 6 do
		-- (counts are kept by mode offset from NEARESTMV, the tree's leaves the same)
		treeMerge(INTER_MODE_TREE, pre.interMode, i * 3, c.interMode, i * 4, fc.interMode)
	end
	for i = 0, 3 do
		treeMerge(INTRA_MODE_TREE, pre.yMode, i * 9, c.yMode, i * 10, fc.yMode)
	end
	for i = 0, 9 do
		treeMerge(INTRA_MODE_TREE, pre.uvMode, i * 9, c.uvMode, i * 10, fc.uvMode)
	end
	for i = 0, 15 do
		treeMerge(PARTITION_TREE, pre.partition, i * 3, c.partition, i * 4, fc.partition)
	end
	if switchable then
		for i = 0, 3 do
			treeMerge(SWITCHABLE_TREE, pre.interp, i * 2, c.interp, i * 3, fc.interp)
		end
	end
	if txSelect then
		for i = 0, 1 do
			local t8 = { c.tx8[i * 2 + 1], c.tx8[i * 2 + 2] }
			fc.tx8[i + 1] = mergeModeMv(pre.tx8[i + 1], t8[1], t8[2])
			local a, b, d = c.tx16[i * 3 + 1], c.tx16[i * 3 + 2], c.tx16[i * 3 + 3]
			fc.tx16[i * 2 + 1] = mergeModeMv(pre.tx16[i * 2 + 1], a, b + d)
			fc.tx16[i * 2 + 2] = mergeModeMv(pre.tx16[i * 2 + 2], b, d)
			local e, f, g, h = c.tx32[i * 4 + 1], c.tx32[i * 4 + 2], c.tx32[i * 4 + 3], c.tx32[i * 4 + 4]
			fc.tx32[i * 3 + 1] = mergeModeMv(pre.tx32[i * 3 + 1], e, f + g + h)
			fc.tx32[i * 3 + 2] = mergeModeMv(pre.tx32[i * 3 + 2], f, g + h)
			fc.tx32[i * 3 + 3] = mergeModeMv(pre.tx32[i * 3 + 3], g, h)
		end
	end
	for i = 1, 3 do
		fc.skip[i] = mergeModeMv(pre.skip[i], c.skip[i * 2 - 1], c.skip[i * 2])
	end
end

local function adaptMv(fc, pre, c, allowHp)
	treeMerge(MV_JOINT_TREE, pre.joints, 0, c.joints, 0, fc.joints)
	for i = 0, 1 do
		fc.sign[i + 1] = mergeModeMv(pre.sign[i + 1], c.sign[i * 2 + 1], c.sign[i * 2 + 2])
		treeMerge(MV_CLASS_TREE, pre.classes, i * 10, c.classes, i * 11, fc.classes)
		treeMerge(MV_CLASS0_TREE, pre.class0, i, c.class0, i * 2, fc.class0)
		for j = 0, 9 do
			local k = i * 10 + j
			fc.bits[k + 1] = mergeModeMv(pre.bits[k + 1], c.bits[k * 2 + 1], c.bits[k * 2 + 2])
		end
		for j = 0, 1 do
			treeMerge(MV_FP_TREE, pre.class0fp, (i * 2 + j) * 3, c.class0fp, (i * 2 + j) * 4, fc.class0fp)
		end
		treeMerge(MV_FP_TREE, pre.fp, i * 3, c.fp, i * 4, fc.fp)
		if allowHp then
			fc.class0hp[i + 1] = mergeModeMv(pre.class0hp[i + 1], c.class0hp[i * 2 + 1], c.class0hp[i * 2 + 2])
			fc.hp[i + 1] = mergeModeMv(pre.hp[i + 1], c.hp[i * 2 + 1], c.hp[i * 2 + 2])
		end
	end
end


------------------------------------------------------------------------------------------------------------------------
-- frames: planes over whole superblocks (aligned to 64), the crop size inside; per 8 x 8 cell the motion it used

local function newFrame(width, height)
	local miCols, miRows = (width + 7) // 8, (height + 7) // 8
	local sbCols, sbRows = (miCols + 7) // 8, (miRows + 7) // 8
	local ys = sbCols * 64
	local cs = ys // 2
	local f = {
		w = width, h = height, cw = (width + 1) // 2, ch = (height + 1) // 2,
		aw = miCols * 8, ah = miRows * 8, miCols = miCols, miRows = miRows,
		ys = ys, cs = cs, yo = 0, co = 0,
		Y = buffer.create(ys * sbRows * 64), U = buffer.create(cs * sbRows * 32), V = buffer.create(cs * sbRows * 32),
	}
	local n = miCols * miRows
	f.ref0, f.ref1 = table.create(n, NONE_FRAME), table.create(n, NONE_FRAME)
	f.mv0r, f.mv0c, f.mv1r, f.mv1c = table.create(n, 0), table.create(n, 0), table.create(n, 0), table.create(n, 0)
	return f
end

local Decoder = {}
Decoder.__index = Decoder

function Vp9.new()
	local self = setmetatable({}, Decoder)
	self.refMap = {} -- [0..7] -> frame
	self.contexts = {}
	for i = 1, 4 do
		self.contexts[i] = defaultContext()
	end
	self.width, self.height = 0, 0
	self.cropX, self.cropY = 0, 0
	self.fullRange, self.bt709 = false, false
	self.signBias = { [0] = 0, 0, 0, 0 }
	self.lf = { refDeltas = { [0] = 1, 0, -1, -1 }, modeDeltas = { [0] = 0, 0 }, sharpness = 0, lastSharpness = -1 }
	self.seg = { enabled = false, features = {}, data = {}, treeProbs = table.create(7, 255), predProbs = table.create(3, 255),
		absDelta = false }
	for i = 0, 7 do
		self.seg.features[i] = { false, false, false, false }
		self.seg.data[i] = { 0, 0, 0, 0 }
	end
	self.frameType, self.intraOnly = 0, false
	self.lastFrameType, self.lastIntraOnly = 0, false
	self.lastShowFrame = false
	self.lastWidth, self.lastHeight = 0, 0
	self.refs = {}
	self.pool = {}
	self.haveKey = false
	self.txMode, self.refMode, self.interpFilter, self.allowHp = 0, 0, 0, false
	return self
end

-- the parts of the uncompressed header after the size (shared by key, intra-only and inter frames)
function Decoder:readTail(rb, intraOnly)
	local errorRes = self.errorRes
	if not errorRes then
		self.refreshContext = rb.read() == 1
		self.parallel = rb.read() == 1
	else
		self.refreshContext = false
		self.parallel = true
	end
	self.contextIdx = rb.literal(2)
	if intraOnly or errorRes then
		self:setupPastIndependence()
	end
	-- loop filter
	local lf = self.lf
	lf.level = rb.literal(6)
	lf.sharpness = rb.literal(3)
	lf.deltaEnabled = rb.read() == 1
	if lf.deltaEnabled then
		if rb.read() == 1 then
			for i = 0, 3 do
				if rb.read() == 1 then
					lf.refDeltas[i] = rb.signed(6)
				end
			end
			for i = 0, 1 do
				if rb.read() == 1 then
					lf.modeDeltas[i] = rb.signed(6)
				end
			end
		end
	end
	-- quantizer
	self.baseQ = rb.literal(8)
	local function dq()
		return rb.read() == 1 and rb.signed(4) or 0
	end
	self.yDcDelta, self.uvDcDelta, self.uvAcDelta = dq(), dq(), dq()
	self.lossless = self.baseQ == 0 and self.yDcDelta == 0 and self.uvDcDelta == 0 and self.uvAcDelta == 0
	-- segmentation
	local seg = self.seg
	seg.updateMap, seg.updateData = false, false
	seg.enabled = rb.read() == 1
	if seg.enabled then
		seg.updateMap = rb.read() == 1
		if seg.updateMap then
			for i = 1, 7 do
				seg.treeProbs[i] = rb.read() == 1 and rb.literal(8) or 255
			end
			seg.temporal = rb.read() == 1
			for i = 1, 3 do
				seg.predProbs[i] = (seg.temporal and rb.read() == 1) and rb.literal(8) or 255
			end
		end
		seg.updateData = rb.read() == 1
		if seg.updateData then
			seg.absDelta = rb.read() == 1
			local maxes, signed, bits = { 255, 63, 3, 0 }, { true, true, false, false }, { 8, 6, 2, 0 }
			for i = 0, 7 do
				for j = 1, 4 do
					local on = rb.read() == 1
					local data = 0
					if on then
						data = bits[j] > 0 and min(rb.literal(bits[j]), maxes[j]) or 0
						if signed[j] and rb.read() == 1 then
							data = -data
						end
					end
					seg.features[i][j] = on
					seg.data[i][j] = data
				end
			end
		end
	end
	-- dequantizers per segment
	self.dq = {}
	for i = 0, (seg.enabled and 7 or 0) do
		local q = self.baseQ
		if seg.enabled and seg.features[i][1] then
			local d = seg.data[i][1]
			q = math.clamp(seg.absDelta and d or q + d, 0, 255)
		end
		self.dq[i] = {
			T.DC_Q[math.clamp(q + self.yDcDelta, 0, 255) + 1], T.AC_Q[math.clamp(q, 0, 255) + 1],
			T.DC_Q[math.clamp(q + self.uvDcDelta, 0, 255) + 1], T.AC_Q[math.clamp(q + self.uvAcDelta, 0, 255) + 1],
		}
	end
	-- tiles
	local sb64 = (self.miCols + 7) // 8
	local minLog2, maxLog2 = 0, 1
	while lshift(64, minLog2) < sb64 do
		minLog2 += 1
	end
	while rshift(sb64, maxLog2) >= 4 do
		maxLog2 += 1
	end
	maxLog2 -= 1
	local log2 = minLog2
	local ones = maxLog2 - minLog2
	while ones > 0 and rb.read() == 1 do
		log2 += 1
		ones -= 1
	end
	self.log2TileCols = log2
	self.log2TileRows = rb.read()
	if self.log2TileRows == 1 then
		self.log2TileRows += rb.read()
	end
	local headerSize = rb.literal(16)
	if headerSize == 0 then
		fail("broken data (an empty header)")
	end
	return headerSize
end

function Decoder:setupPastIndependence()
	local seg = self.seg
	for i = 0, 7 do
		seg.features[i] = { false, false, false, false }
		seg.data[i] = { 0, 0, 0, 0 }
	end
	seg.absDelta = false
	local n = self.miCols * self.miRows
	for i = 1, n do
		self.lastSegMap[i] = 0
		self.curSegMap[i] = 0
	end
	local lf = self.lf
	lf.deltaEnabled = true
	lf.refDeltas = { [0] = 1, 0, -1, -1 }
	lf.modeDeltas = { [0] = 0, 0 }
	lf.lastSharpness = -1
	local fc = defaultContext()
	self.fc = fc
	if self.frameType == 0 or self.errorRes or self.resetContext == 3 then
		for i = 1, 4 do
			self.contexts[i] = cloneContext(fc)
		end
	elseif self.resetContext == 2 then
		self.contexts[self.contextIdx + 1] = cloneContext(fc)
	end
	self.signBias = { [0] = 0, 0, 0, 0 }
	self.contextIdx = 0
end

function Decoder:setSize(width, height)
	if width ~= self.width or height ~= self.height then
		self.width, self.height = width, height
		self.miCols, self.miRows = (width + 7) // 8, (height + 7) // 8
		local n = self.miCols * self.miRows
		self.lastSegMap = table.create(n, 0)
		self.curSegMap = table.create(n, 0)
	end
end

-- the compressed header: probability updates for this frame
function Decoder:readCompressedHeader(buf, pos, size)
	local r = newReader(buf, pos, size)
	local fc = self.fc
	local txMode
	if self.lossless then
		txMode = 0
	else
		txMode = r:literal(2)
		if txMode == 3 then
			txMode += r:read(128)
		end
	end
	self.txMode = txMode
	if txMode == 4 then
		for i = 1, 2 do
			diffUpdate(r, fc.tx8, i)
		end
		for i = 1, 4 do
			diffUpdate(r, fc.tx16, i)
		end
		for i = 1, 6 do
			diffUpdate(r, fc.tx32, i)
		end
	end
	for t = 1, TX_MODE_BIGGEST[txMode + 1] + 1 do
		if r:read(128) == 1 then
			local probs = fc.coef[t]
			for i = 0, 1 do
				for j = 0, 1 do
					for k = 0, 5 do
						for l = 0, (k == 0 and 2 or 5) do
							local base = (((i * 2 + j) * 6 + k) * 6 + l) * 3
							for m = 1, 3 do
								diffUpdate(r, probs, base + m)
							end
						end
					end
				end
			end
		end
	end
	for i = 1, 3 do
		diffUpdate(r, fc.skip, i)
	end
	if not self.intraOnlyFrame then
		for i = 1, 21 do
			diffUpdate(r, fc.interMode, i)
		end
		if self.interpFilter == 4 then
			for i = 1, 8 do
				diffUpdate(r, fc.interp, i)
			end
		end
		for i = 1, 4 do
			diffUpdate(r, fc.intraInter, i)
		end
		-- reference mode
		local sb = self.signBias
		local compAllowed = sb[2] ~= sb[1] or sb[3] ~= sb[1]
		local refMode = 0
		if compAllowed then
			if r:read(128) == 1 then
				refMode = r:read(128) == 1 and 2 or 1
			end
		end
		self.refMode = refMode -- 0 single, 1 compound, 2 select
		if refMode ~= 0 then
			if sb[LAST_FRAME] == sb[GOLDEN_FRAME] then
				self.compFixed, self.compVar0, self.compVar1 = ALTREF_FRAME, LAST_FRAME, GOLDEN_FRAME
			elseif sb[LAST_FRAME] == sb[ALTREF_FRAME] then
				self.compFixed, self.compVar0, self.compVar1 = GOLDEN_FRAME, LAST_FRAME, ALTREF_FRAME
			else
				self.compFixed, self.compVar0, self.compVar1 = LAST_FRAME, GOLDEN_FRAME, ALTREF_FRAME
			end
		end
		if refMode == 2 then
			for i = 1, 5 do
				diffUpdate(r, fc.compInter, i)
			end
		end
		if refMode ~= 1 then
			for i = 1, 10 do
				diffUpdate(r, fc.singleRef, i)
			end
		end
		if refMode ~= 0 then
			for i = 1, 5 do
				diffUpdate(r, fc.compRef, i)
			end
		end
		for i = 1, 36 do
			diffUpdate(r, fc.yMode, i)
		end
		for i = 1, 48 do
			diffUpdate(r, fc.partition, i)
		end
		-- motion vector probabilities
		local function upd(probs, i)
			if r:read(252) == 1 then
				probs[i] = r:literal(7) * 2 + 1
			end
		end
		for i = 1, 3 do
			upd(fc.joints, i)
		end
		for i = 0, 1 do
			upd(fc.sign, i + 1)
			for j = 1, 10 do
				upd(fc.classes, i * 10 + j)
			end
			upd(fc.class0, i + 1)
			for j = 1, 10 do
				upd(fc.bits, i * 10 + j)
			end
		end
		for i = 0, 1 do
			for j = 0, 1 do
				for k = 1, 3 do
					upd(fc.class0fp, (i * 2 + j) * 3 + k)
				end
			end
			for k = 1, 3 do
				upd(fc.fp, i * 3 + k)
			end
		end
		if self.allowHp then
			for i = 1, 2 do
				upd(fc.class0hp, i)
				upd(fc.hp, i)
			end
		end
	end
end


local inverseTransform, inverseWht = (function()

------------------------------------------------------------------------------------------------------------------------
-- transforms

local function RS(x)
	return floor((x + 8192) / 16384)
end
local function idct4(inp, io, out, oo)
	local step_0, step_1, step_2, step_3, temp1, temp2
	temp1 = (inp[io + 0] + inp[io + 2]) * 11585
	temp2 = (inp[io + 0] - inp[io + 2]) * 11585
	step_0 = (RS(temp1))
	step_1 = (RS(temp2))
	temp1 = inp[io + 1] * 6270 - inp[io + 3] * 15137
	temp2 = inp[io + 1] * 15137 + inp[io + 3] * 6270
	step_2 = (RS(temp1))
	step_3 = (RS(temp2))
	out[oo + 0] = (step_0 + step_3)
	out[oo + 1] = (step_1 + step_2)
	out[oo + 2] = (step_1 - step_2)
	out[oo + 3] = (step_0 - step_3)
end
local function iadst4(inp, io, out, oo)
	local s0, s1, s2, s3, s4, s5, s6, s7, x0, x1, x2, x3
	x0 = inp[io + 0]
	x1 = inp[io + 1]
	x2 = inp[io + 2]
	x3 = inp[io + 3]
	if x0 == 0 and x1 == 0 and x2 == 0 and x3 == 0 then for q = 0, 3 do out[oo + q] = 0 end return end
	s0 = 5283 * x0
	s1 = 9929 * x0
	s2 = 13377 * x1
	s3 = 15212 * x2
	s4 = 5283 * x2
	s5 = 9929 * x3
	s6 = 15212 * x3
	s7 = (x0 - x2 + x3)
	s0 = s0 + s3 + s5
	s1 = s1 - s4 - s6
	s3 = s2
	s2 = 13377 * s7
	out[oo + 0] = (RS(s0 + s3))
	out[oo + 1] = (RS(s1 + s3))
	out[oo + 2] = (RS(s2))
	out[oo + 3] = (RS(s0 + s1 - s3))
end
local function idct8(inp, io, out, oo)
	local step1_0, step1_1, step1_2, step1_3, step1_4, step1_5, step1_6, step1_7, step2_0, step2_1, step2_2, step2_3, step2_4, step2_5, step2_6, step2_7, temp1, temp2
	step1_0 = inp[io + 0]
	step1_2 = inp[io + 4]
	step1_1 = inp[io + 2]
	step1_3 = inp[io + 6]
	temp1 = inp[io + 1] * 3196 - inp[io + 7] * 16069
	temp2 = inp[io + 1] * 16069 + inp[io + 7] * 3196
	step1_4 = (RS(temp1))
	step1_7 = (RS(temp2))
	temp1 = inp[io + 5] * 13623 - inp[io + 3] * 9102
	temp2 = inp[io + 5] * 9102 + inp[io + 3] * 13623
	step1_5 = (RS(temp1))
	step1_6 = (RS(temp2))
	temp1 = (step1_0 + step1_2) * 11585
	temp2 = (step1_0 - step1_2) * 11585
	step2_0 = (RS(temp1))
	step2_1 = (RS(temp2))
	temp1 = step1_1 * 6270 - step1_3 * 15137
	temp2 = step1_1 * 15137 + step1_3 * 6270
	step2_2 = (RS(temp1))
	step2_3 = (RS(temp2))
	step2_4 = (step1_4 + step1_5)
	step2_5 = (step1_4 - step1_5)
	step2_6 = (-step1_6 + step1_7)
	step2_7 = (step1_6 + step1_7)
	step1_0 = (step2_0 + step2_3)
	step1_1 = (step2_1 + step2_2)
	step1_2 = (step2_1 - step2_2)
	step1_3 = (step2_0 - step2_3)
	step1_4 = step2_4
	temp1 = (step2_6 - step2_5) * 11585
	temp2 = (step2_5 + step2_6) * 11585
	step1_5 = (RS(temp1))
	step1_6 = (RS(temp2))
	step1_7 = step2_7
	out[oo + 0] = (step1_0 + step1_7)
	out[oo + 1] = (step1_1 + step1_6)
	out[oo + 2] = (step1_2 + step1_5)
	out[oo + 3] = (step1_3 + step1_4)
	out[oo + 4] = (step1_3 - step1_4)
	out[oo + 5] = (step1_2 - step1_5)
	out[oo + 6] = (step1_1 - step1_6)
	out[oo + 7] = (step1_0 - step1_7)
end
local function iadst8(inp, io, out, oo)
	local s0, s1, s2, s3, s4, s5, s6, s7, x0, x1, x2, x3, x4, x5, x6, x7
	x0 = inp[io + 7]
	x1 = inp[io + 0]
	x2 = inp[io + 5]
	x3 = inp[io + 2]
	x4 = inp[io + 3]
	x5 = inp[io + 4]
	x6 = inp[io + 1]
	x7 = inp[io + 6]
	if x0 == 0 and x1 == 0 and x2 == 0 and x3 == 0 and x4 == 0 and x5 == 0 and x6 == 0 and x7 == 0 then for q = 0, 7 do out[oo + q] = 0 end return end
	s0 = (16305 * x0 + 1606 * x1)
	s1 = (1606 * x0 - 16305 * x1)
	s2 = (14449 * x2 + 7723 * x3)
	s3 = (7723 * x2 - 14449 * x3)
	s4 = (10394 * x4 + 12665 * x5)
	s5 = (12665 * x4 - 10394 * x5)
	s6 = (4756 * x6 + 15679 * x7)
	s7 = (15679 * x6 - 4756 * x7)
	x0 = (RS(s0 + s4))
	x1 = (RS(s1 + s5))
	x2 = (RS(s2 + s6))
	x3 = (RS(s3 + s7))
	x4 = (RS(s0 - s4))
	x5 = (RS(s1 - s5))
	x6 = (RS(s2 - s6))
	x7 = (RS(s3 - s7))
	s0 = x0
	s1 = x1
	s2 = x2
	s3 = x3
	s4 = (15137 * x4 + 6270 * x5)
	s5 = (6270 * x4 - 15137 * x5)
	s6 = (-6270 * x6 + 15137 * x7)
	s7 = (15137 * x6 + 6270 * x7)
	x0 = (s0 + s2)
	x1 = (s1 + s3)
	x2 = (s0 - s2)
	x3 = (s1 - s3)
	x4 = (RS(s4 + s6))
	x5 = (RS(s5 + s7))
	x6 = (RS(s4 - s6))
	x7 = (RS(s5 - s7))
	s2 = (11585 * (x2 + x3))
	s3 = (11585 * (x2 - x3))
	s6 = (11585 * (x6 + x7))
	s7 = (11585 * (x6 - x7))
	x2 = (RS(s2))
	x3 = (RS(s3))
	x6 = (RS(s6))
	x7 = (RS(s7))
	out[oo + 0] = (x0)
	out[oo + 1] = (-x4)
	out[oo + 2] = (x6)
	out[oo + 3] = (-x2)
	out[oo + 4] = (x3)
	out[oo + 5] = (-x7)
	out[oo + 6] = (x5)
	out[oo + 7] = (-x1)
end
