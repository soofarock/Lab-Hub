	t19, t44 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t20 + t43, t20 - t43
	t20, t43 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
