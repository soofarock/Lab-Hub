	t21, t42 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t22 + t41, t22 - t41
	t22, t41 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t23 + t40, t23 - t40
	t23, t40 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t24 + t39, t24 - t39
	t24, t39 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
