	u, v = t29 + t34, t29 - t34
	t29, t34 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t30 + t33, t30 - t33
	t30, t33 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
