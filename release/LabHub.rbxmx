            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!optimize 2
-- Real-time MIDI synthesizer and sequencer on the WaveBank voice pool.
--
--   local synth = MidiSynth.new({
--       Parent = SoundService,      -- where the voice folder goes
--       Voices = 48,                -- polyphony (default 48 with a Bank/SoundFont, else 24)
--       MasterGain = 1,
--       Bank = bakedBank,           -- from Assets.bank / Importer.loadBank (preferred: no SF2 decoding)
--       SoundFont = sf,             -- or a decoded SF2 (Sf2.decode); analysed lazily per sample
--       Mode = "additive",          -- "additive" (default with Bank/SoundFont) or "wave" (one waveform)
--       Partials = 10,              -- max sine voices per note (default: the most any baked sample uses)
--       DrumChannel = 9,            -- synthesized kit channel; default nil with Bank/SoundFont, false = none
--       DeviceOutput = true,        -- false: don't play to the speakers (e.g. when wiring to an AudioEmitter)
--       Stereo = true,              -- channel pan (CC10); default on unless DeviceOutput = false (3D emitters are mono)
--       MaxPlayers = 192,           -- most players sounding at once; the quietest parts are dropped first
--       BankSelect = "mma",         -- how CC0/CC32 pick the SoundFont bank: "mma" (MSB*128+LSB, falls back to
--                                   -- MSB then LSB), "gs" (MSB only) or "xg" (LSB only)
--   })
--   synth:play(midiBytesOrDecoded, { Loop = false, Speed = 1, StartTime = 0 })
--       Loop = true repeats the region between loop markers ("LOOP_START"/"LOOP_END", "loopStart"/
--       "loopEnd" as marker or text meta events, or CC 111 for the start), else the whole song.
--   synth.Ended:Connect(...)            -- fires when a non-looping song finishes
--   synth:noteOn(ch, key, vel) / noteOff(ch, key) / controlChange(ch, cc, value)
--   synth:programChange(ch, program) / pitchBend(ch, value)   -- value -8192..8191
--   synth:pause(), synth:resume(), synth:seek(seconds), synth:getTime(), synth:getDuration()
--   synth:setMute(ch, bool), synth:setSolo(ch, bool), synth.activity[ch] (0..1, for meters)
--   synth:stop(), synth:destroy()
--   synth.pool.output                   -- AudioFader carrying the mix
--
-- Envelopes follow SoundFont semantics: delay, linear attack, hold, decay and release as the time
-- for a fall of 96 dB, sustain as a level. Additive notes follow the analysed sample in its own clock
-- (faster for higher keys, as a sample player would), with the envelope on top.

local RunService = game:GetService("RunService")
local AudioLab = script:FindFirstAncestor("AudioLab")
local OscillatorPool = require(AudioLab.Synth.OscillatorPool)
local Instruments = require(AudioLab.Synth.Instruments)
local WaveBank = require(AudioLab.Codec.WaveBank)
local Midi = require(AudioLab.Formats.Midi)
-- Synth.SourceFilter (kept inside this module)
local SourceFilter = (function()
-- Source-filter voices for sustained, voice-like samples (a sung "ah").
--
-- The additive engine rebuilds such a note from 17-29 sine players. Each one is a separate player the engine starts,
-- times and steps on its own, and their sum is heard as "mixed" rather than one voice. Here a note is how a voice is
-- made: one source and a vocal tract.
--   * a band-limited saw loop (WaveBank wave_saw_<base>) at the note's pitch: every harmonic in one waveform, so they
--     stay locked together
--   * the pink-noise loop (pink_noise) for the breath between and above the harmonics
--   * 8 AudioFilters, moved every block along the sample's baked frames (a.sf, baked from the SoundFont sample):
--     a formant cascade (LowShelf, 4 Peaks, HighShelf) shared by both sources (filters 1..npre on the saw only), and a
--     tilt for the noise (Highpass24, HighShelf) before it joins
-- 2 players + 8 filters per note, created once per voice and reused (no instances made or destroyed while playing).
--
-- AudioFilter is the RBJ cookbook biquad (Lowpass/Highpass 24 = two Butterworth sections),
-- a new setting takes effect from the next audio block and the coefficients glide to it over ~27 ms without clicks.
-- So filters are written for the END of the coming block (the glide is then mostly done in it) and a note's filters are
-- set to its first frame before its volume rises.
--
--   local sf = SourceFilter.new(pool)             -- pool: OscillatorPool (output / buses)
--   local h = sf:start(a, speed, bus, tau0)       -- a voice for one note; nil when every voice is busy (the caller plays
--                                                 -- the note another way)
--   sf:update(h, tauC, tauF, speed, bendR, gain)  -- sample times: block centre (levels, pitch) and block end (filters)
--   sf:free(h), sf:sweep(), sf:stopAll(), sf:destroy()
--   SourceFilter.frame(a.sf, tau, out) -> out         -- the interpolated frame (pure)
--
-- AudioLab attribute SourceFilter = false plays these samples on the additive engine instead.

local Base64 = require(AudioLab.Util.Base64)

local SourceFilter = {}
SourceFilter.__index = SourceFilter

SourceFilter.MaxVoices = 8
SourceFilter.IdleStop = 20 -- seconds a free voice's players keep running (a cold player is late on its first block)
local SAW_BASES = { 55, 220, 880, 3520 }
local MAX_SPEED = 2
local FILTERS = 8

-- decoded frames per a.sf: columns already in their final units
--   f0 = ratio to f0ref, gs / gn = linear gains (gain calibration included), filter f = Hz, g = dB, q = q
local decoded = setmetatable({}, { __mode = "k" })
local function decode(sf)
	local d = decoded[sf]
	if d then
		return d
	end
	local raw = Base64.decode(sf.data)
	local cols, nfr = sf.cols, sf.nfr
	local nc = #cols
	-- column -> (filter, field) and the stored value's unit
	local kind, target, field = table.create(nc), table.create(nc), table.create(nc)
	for c, name in ipairs(cols) do
		if name == "f0" or name == "gs" or name == "gn" then
			kind[c] = name
		else
			local i, p = string.match(name, "^(%d+):(%a)$")
			kind[c], target[c], field[c] = p, tonumber(i), p
		end
	end
	local data = table.create(nfr * nc)
	for j = 0, nfr - 1 do
		for c = 1, nc do
			data[j * nc + c] = buffer.readi16(raw, (j * nc + c - 1) * 2)
		end
	end
	d = { nc = nc, nfr = nfr, kind = kind, target = target, field = field, data = data, gainDb = sf.gain or 0 }
	decoded[sf] = d
	return d
end

-- sample time -> fractional frame (a looped sample repeats the baked second pass of its loop)
local function framePos(sf, d, tau)
	local ls, le = sf.ls, sf.le
	if ls and le and le > ls and tau >= ls then
		local L = le - ls
		tau = ls + L + (tau - ls) % L
	end
	return math.clamp(tau / sf.hop, 0, d.nfr - 1)
end

-- out = { f0 = ratio, gs, gn = linear, f = {..}, g = {..}, q = {..} } for the frame at sample time tau
function SourceFilter.frame(sf, tau, out)
	local d = decode(sf)
	out = out or {}
	out.f, out.g, out.q = out.f or table.create(FILTERS), out.g or table.create(FILTERS), out.q or table.create(FILTERS)
	local fx = sf.fixed
	for i = 1, #sf.types do
		out.f[i], out.g[i], out.q[i] = fx[i].f, fx[i].g, fx[i].q
	end
	local x = framePos(sf, d, tau)
	local j = math.floor(x)
	local a = x - j
	local j2 = math.min(j + 1, d.nfr - 1)
	local nc, data = d.nc, d.data
	for c = 1, nc do
		local v0, v1 = data[j * nc + c], data[j2 * nc + c]
		local v = v0 + (v1 - v0) * a
		local k = d.kind[c]
		if k == "f0" then
			out.f0 = 2 ^ (v / 4800)
		elseif k == "gs" then
			out.gs = 10 ^ ((v / 100 + d.gainDb) / 20)
		elseif k == "gn" then
			out.gn = 10 ^ ((v / 100 + d.gainDb) / 20)
		elseif k == "f" then
			out.f[d.target[c]] = 2 ^ (v / 1000)
		elseif k == "g" then
			out.g[d.target[c]] = v / 100
		else
			out.q[d.target[c]] = 2 ^ (v / 1000)
		end
	end
	return out
end

-- lowest saw base that reaches f within MAX_SPEED (the most harmonics below Nyquist)
function SourceFilter.sawBase(f)
	for _, b in ipairs(SAW_BASES) do
		if f / b <= MAX_SPEED then
			return b
		end
	end
	return SAW_BASES[#SAW_BASES]
end

local function wire(parent, from, to)
	local w = Instance.new("Wire")
	w.SourceInstance = from
	w.TargetInstance = to
	w.Parent = parent
	return w
end

function SourceFilter.new(pool)
	local self = setmetatable({}, SourceFilter)
	self.pool = pool
	self.folder = Instance.new("Folder")
	self.folder.Name = "SourceFilter"
	self.folder.Parent = pool.folder
	self.voices = {}
	self.tmp = {}
	self.clock = 0
	return self
end

function SourceFilter:_newVoice()
	local f = Instance.new("Folder")
	f.Name = "SF" .. (#self.voices + 1)
	local filters = table.create(FILTERS)
	for i = 1, FILTERS do
		local ft = Instance.new("AudioFilter")
		ft.Name = "F" .. i
		ft.Parent = f
		filters[i] = ft
	end
	local noise = Instance.new("AudioPlayer")
	noise.Name = "Pink"
	noise.Looping = true
	noise.Volume = 0
	noise.Parent = f
	local vc = {
		folder = f, filters = filters, noise = noise, saws = {}, busy = false, idleAt = 0,
		noiseIn = wire(f, noise, filters[7]), -- pink -> noise chain (7, 8) -> the formant chain at npre + 1
		noiseChain = wire(f, filters[7], filters[8]),
		join = wire(f, filters[8], filters[1]),
		out = wire(f, filters[6], self.pool.output),
		chain = {},
	}
	for i = 1, 5 do
		vc.chain[i] = wire(f, filters[i], filters[i + 1])
	end
	f.Parent = self.folder
	table.insert(self.voices, vc)
	return vc
end

function SourceFilter:_saw(vc, base)
	local p = vc.saws[base]
	if not p then
		p = Instance.new("AudioPlayer")
		p.Name = "Saw" .. base
		p.Looping = true
		p.Volume = 0
		p.Asset = WaveBank.Assets[("wave_saw_%d"):format(base)] or ""
		wire(vc.folder, p, vc.filters[1])
		p.Parent = vc.folder
		vc.saws[base] = p
	end
	return p
end

-- sets a voice's filter types and routing for one sample, and every filter to the frame at tau (speed: formant scale)
function SourceFilter:_route(vc, sf)
	if vc.routed == sf then
		return
	end
	vc.routed = sf
	-- the layout baked for every sample: formant filters 1-6, noise filters 7-8
	local types = sf.types
	assert(#types == FILTERS and (sf.nh or 6) == 6, "SourceFilter: unsupported filter layout")
	for i = 1, FILTERS do
		vc.filters[i].FilterType = Enum.AudioFilterType[types[i]]
	end
	vc.join.TargetInstance = vc.filters[(sf.npre or 0) + 1]
end

function SourceFilter:_setFilters(vc, fr, speed)
	local nt = #vc.routed.types
	for i = 1, nt do
		local ft = vc.filters[i]
		local f = math.clamp(fr.f[i] * speed, 20, 20000)
		if ft.Frequency ~= f then
			ft.Frequency = f
		end
		local g = math.clamp(fr.g[i], -30, 30)
		if ft.Gain ~= g then
			ft.Gain = g
		end
		local q = math.clamp(fr.q[i], 0.1, 10)
		if ft.Q ~= q then
			ft.Q = q
		end
	end
end

-- a voice for one note, or nil when all are busy. bus: OscillatorPool bus number (the channel's pan), or nil
function SourceFilter:start(a, speed, bus, tau0)
	local sf = a.sf
	local best
	for _, vc in ipairs(self.voices) do
		if not vc.busy then
			-- prefer the voice that last played this sample at this speed: its filters are already where the note starts
			if vc.routed == sf and vc.speed == speed then
				best = vc
				break
			end
			best = best or vc
		end
	end
	if not best then
		if #self.voices >= SourceFilter.MaxVoices then
			return nil
		end
		best = self:_newVoice()
	end
	local vc = best
	vc.busy = true
	self:_route(vc, sf)
	local fr = SourceFilter.frame(sf, tau0 or 0, self.tmp)
	local base = SourceFilter.sawBase(sf.f0ref * fr.f0 * speed)
	vc.base, vc.speed = base, speed
	self:_setFilters(vc, fr, speed)
	local target = self.pool.output
	if self.pool.stereo and self.pool.buses then
		local b = self.pool.buses[bus or 1] or self.pool.buses[1]
		target = b and b.input or target
	end
	if vc.out.TargetInstance ~= target then
		vc.out.TargetInstance = target
	end
	local saw = self:_saw(vc, base)
	for b, p in pairs(vc.saws) do
		if b ~= base and p.Volume ~= 0 then
			p.Volume = 0
		end
	end
	saw.Volume = 0
	saw.PlaybackSpeed = math.clamp(sf.f0ref * fr.f0 * speed / base, 0.05, MAX_SPEED * 1.05)
	if not saw.IsPlaying then
		saw:Play()
	end
	local nz = vc.noise
	if nz.Asset == "" then
		nz.Asset = WaveBank.Assets.pink_noise or ""
	end
	nz.Volume = 0
	if not nz.IsPlaying then
		nz.TimePosition = math.random() * 2.5 -- every voice its own stretch of the loop (equal noise would comb)
		nz:Play()
	end
	return vc
end

-- tauC: sample time at the middle of the block this write plays in (levels, pitch); tauF: at its end (filters)
-- gain: the note's linear gain (envelope x channel x velocity x master); bendR: pitch-bend ratio
function SourceFilter:update(vc, tauC, tauF, speed, bendR, gain)
	local sf = vc.routed
	local fr = SourceFilter.frame(sf, tauC, self.tmp)
	local saw = vc.saws[vc.base]
	local sp = math.clamp(sf.f0ref * fr.f0 * speed * bendR / vc.base, 0.05, MAX_SPEED * 1.05)
	if saw.PlaybackSpeed ~= sp then
		saw.PlaybackSpeed = sp
	end
	saw.Volume = fr.gs * gain
	vc.noise.Volume = fr.gn * gain
	fr = SourceFilter.frame(sf, tauF, self.tmp)
	self:_setFilters(vc, fr, speed)
end

-- the note is over: silent, and its filters go back to the onset frame of the same sample (the likeliest next note)
function SourceFilter:free(vc)
	if not vc or not vc.busy then
		return
	end
	vc.busy = false
	vc.idleAt = os.clock()
	for _, p in pairs(vc.saws) do
		p.Volume = 0
	end
	vc.noise.Volume = 0
	local sf = vc.routed
	if sf then
		task.delay(0.05, function()
			-- (after the release block has been played with the note's own filters)
			if not vc.busy and vc.routed == sf and vc.folder.Parent then
				self:_setFilters(vc, SourceFilter.frame(sf, 0, {}), vc.speed or 1)
			end
		end)
	end
end

-- stops the players of voices free for longer than IdleStop (call now and then)
function SourceFilter:sweep()
	local now = os.clock()
	for _, vc in ipairs(self.voices) do
		if not vc.busy and now - vc.idleAt > SourceFilter.IdleStop then
			for _, p in pairs(vc.saws) do
				if p.IsPlaying then
					p:Stop()
				end
			end
			if vc.noise.IsPlaying then
				vc.noise:Stop()
			end
		end
	end
end

function SourceFilter:stopAll()
	for _, vc in ipairs(self.voices) do
		self:free(vc)
		for _, p in pairs(vc.saws) do
			p:Stop()
		end
		vc.noise:Stop()
	end
end

function SourceFilter:destroy()
	self.voices = {}
	self.folder:Destroy()
end

return SourceFilter
end)()

local MidiSynth = {}
MidiSynth.__index = MidiSynth

local DEFAULT_DRUM_CHANNEL = 9
local SILENT = 1e-3
local FLOOR_DB = 96
local END_DB = 60 -- voices below -60 dB are freed
local SINE = Instruments.WaveIndex.sine
local SINE_GAIN = WaveBank.Waves[SINE].gain
local LOOKAHEAD = 0 -- seconds: note-ons prepared this early so every part starts on time and in phase (0 = off: restarting players to align phases stutters)
-- mix headroom: keeps loud songs under full scale, so the limiter only catches rare peaks, as in a SoundFont player.
local USE_RESIDUAL = true -- breath / consonant noise of pitched samples through the noise bands: without it vocal-type samples lose 3-9 dB above 2.5 kHz
-- -4.5 dB: the SoundFont centre pan law (a centred part is -3 dB per ear) plus room so the limiter rarely engages
-- (pumping, crushed bass).
local HEADROOM = 10 ^ (-4.5 / 20)
-- The engine reads a player's volume once per audio block (1024 samples, ~21 ms) and holds it for the whole block;
-- a write lands on the next block boundary. A one-shot's level at the instant of the write is the wrong value for that:
-- the first block of a note would play the t = 0 analysis frame (10-20 dB under the strike), so struck notes would
-- start soft and ~20 ms late, then jump up. Each write is the part's RMS level over
-- the block it will actually play in (sample time from the block clock), taken at BLOCK_TAPS points.
local BLOCK_AVG = true -- also for voice samples (attribute VoiceBlockAvg = false turns that off)
local BLOCK_TAPS = 4
local NOISE_TAPS = 6 -- taps per block for the analysed noise samples' block RMS
local MAX_PARTIAL_HZ = 17500 -- sine loops are pure, so they can be sped up this far without aliasing (880 Hz x 20 = 17.6 kHz, Roblox's speed limit)
local GROUP_COUNT = #WaveBank.BundleGroups
local BUNDLE_AMP = WaveBank.BundleRms * math.sqrt(2) -- sine-equivalent amplitude of a bundle at volume 1
local CHAIN = WaveBank.NoiseChain
local CHAIN_N = #CHAIN

local function newChannel()
	return {
		program = 0, bankMsb = 0, bankLsb = 0, volume = 100, expression = 127, pan = 64,
		bend = 0, bendRange = 2, sustain = false, rpnMsb = 127, rpnLsb = 127,
	}
end

-- Velocity, channel volume (CC7) and expression (CC11) scale the amplitude linearly (value / 127). 
-- (The General MIDI square law, 40 * log10, would be 3-5 dB off wherever channel volumes differ.)
local function curve(v)
	return v / 127
end
-- Channel volume (CC7) and expression (CC11): square law. A song fades out by stepping CC7 down to ~9; with the linear
-- curve that only reached -23 dB (the fade never finished), the original goes silent (-46 dB). Velocity stays linear.
local function ccCurve(v)
	return (v / 127) ^ 2
end

function MidiSynth.new(config)
	config = config or {}
	local self = setmetatable({}, MidiSynth)
	self.bank = config.Bank
	self.soundFont = config.SoundFont
	local hasInstruments = self.bank ~= nil or self.soundFont ~= nil
	-- SoundFont songs (long releases, many channels) need more polyphony: a long SoundFont song peaked at 36 notes
	self.voiceCount = config.Voices or (hasInstruments and 48 or 24)
	self.masterGain = config.MasterGain or 1 -- full SoundFont level; the pool's limiter catches peaks
	self.mode = config.Mode or (hasInstruments and "additive" or "wave")
	local maxPartials = Instruments.Defaults.Partials
	if self.bank and self.bank.samples then
		maxPartials = 1
		for _, a in pairs(self.bank.samples) do
			maxPartials = math.max(maxPartials, a.partials and #a.partials or 1)
		end
	end
	-- slots per voice: the sines (8, or more for older banks), one per harmonic bundle group, then the modes
	local maxModes = 0
	if self.bank and self.bank.samples then
		for _, a in pairs(self.bank.samples) do
			maxModes = math.max(maxModes, a.modes and #a.modes or 0)
		end
	end
	self.sineSlots = math.max(maxPartials, WaveBank.Sines)
	self.modeSlots = (self.mode == "additive") and maxModes or 0
	self.partials = (self.mode == "additive") and (self.sineSlots + GROUP_COUNT + self.modeSlots) or 1
	self.instrumentOptions = { Mode = self.mode, Partials = self.partials }
	-- slots per voice: the parts above, then one per fine harmonic group (WaveBank.FineGroups; used instead of the octave bundles
	-- when the harmonics pack is in the manifest)
	self.stride = self.partials + ((self.mode == "additive") and #WaveBank.FineGroups or 0)
	-- then one rough-sine partner per harmonic of the voice samples that have roughness frames (a.rough)
	local maxRough = 0
	if self.mode == "additive" and self.bank and self.bank.samples then
		for _, a in pairs(self.bank.samples) do
			if a.rough and a.rough[1] then
				maxRough = math.max(maxRough, #a.rough[1])
			end
		end
	end
	self.roughSlots = math.min(maxRough, 10) -- harmonics above 10 carry very little roughness
	self.roughBase = self.stride
	self.stride += self.roughSlots
	self.bankSelect = config.BankSelect or "mma"
	-- most parts sounding at once: 3/4 of the device's player limit (OscillatorPool.playerLimit: 320 -> 240 on computers,
	-- 128 -> 96 on phones), the rest is headroom for parts fading out and idle players; the quietest parts drop first
	local limit = OscillatorPool.playerLimit()
	self.maxPlayers = config.MaxPlayers or math.floor(limit * 0.75)
	self.prewarm = config.Prewarm
	if config.DrumChannel == false then
		self.drumChannel = nil
	elseif config.DrumChannel ~= nil then
		self.drumChannel = config.DrumChannel
	else
		self.drumChannel = (not hasInstruments) and DEFAULT_DRUM_CHANNEL or nil
	end
	local stereo = config.Stereo
	if stereo == nil then
		stereo = config.DeviceOutput ~= false
	end
	self.pool = OscillatorPool.new({
		Parent = config.Parent, Slots = self.voiceCount * self.stride, Bands = #WaveBank.NoiseBands,
		Smoothing = 300, AttackSmoothing = 2000, MasterGain = 1, BandsWarm = true, PhaseReset = true,
		Name = config.Name or "MidiSynth", DeviceOutput = config.DeviceOutput,
		Stereo = stereo, Buses = 16,
		-- idle players stay running (silent) 20 s and up to 256 of them: stopping them sooner makes busy passages
		-- restart dozens of players in one frame when they come back (their notes lose the start: stutter)
		-- (every running player costs the audio engine, silent or not: the reserve is a quarter of the player limit)
		WarmReserve = config.WarmReserve or math.floor(limit / 4), IdleStop = config.IdleStop or 20,
	})
	self.stereo = stereo
	self.baseWarmReserve, self.baseIdleStop = config.WarmReserve or math.floor(limit / 4), config.IdleStop or 20
	self.channels = {}
	for c = 0, 15 do
		self.channels[c] = newChannel()
	end
	self.voices = {}
	for v = 1, self.voiceCount do
		self.voices[v] = { active = false, slot = (v - 1) * self.stride + 1, amps = {} }
	end
	self.noiseHits = {}
	self.bandLevels = table.create(#WaveBank.NoiseBands, 0)
	self.clock = 0
	self._ended = Instance.new("BindableEvent")
	self.Ended = self._ended.Event
	self.stats = { notes = 0, stolen = 0, drums = 0 }
	self.missingWarned = {}
	self.muted, self.solo, self.activity = {}, {}, {}
	for c = 0, 15 do
		self.activity[c] = 0
	end
	return self
end

function MidiSynth:_audible(ch)
	if self.muted[ch] then
		return false
	end
	if next(self.solo) ~= nil then
		return self.solo[ch] == true
	end
	return true
end

function MidiSynth:setMute(ch, on)
	self.muted[ch] = on and true or nil
	if on then
		self:allNotesOff(ch, true)
	end
end

function MidiSynth:setSolo(ch, on)
	self.solo[ch] = on and true or nil
	for c = 0, 15 do
		if not self:_audible(c) then
			self:allNotesOff(c, true)
		end
	end
end

-- candidate SoundFont bank numbers for a channel, most specific first
function MidiSynth:_banks(c)
	local style = self.bankSelect
	if style == "gs" then
		return { c.bankMsb }
	elseif style == "xg" then
		return { c.bankLsb }
	end
	local list = { c.bankMsb * 128 + c.bankLsb }
	if c.bankLsb ~= 0 then
		table.insert(list, c.bankMsb)
		if c.bankMsb == 0 then
			list[1] = c.bankLsb
		else
			table.insert(list, c.bankLsb)
		end
	end
	return list
end

function MidiSynth:_preset(ch, key, velocity)
	local c = self.channels[ch]
	local p = nil
	if not (self.bank or self.soundFont) then
		return Instruments.gm(c.program)
	end
	local banks = self:_banks(c)
	for _, b in ipairs(banks) do
		if self.bank then
			p = Instruments.fromBank(self.bank, b, c.program, key, velocity, self.instrumentOptions)
		else
			p = Instruments.fromSoundFont(self.soundFont, b, c.program, key, velocity, self.instrumentOptions)
		end
		if p then
			return p
		end
	end
	local mk = banks[1] * 128 + c.program
	if not self.missingWarned[mk] then
		self.missingWarned[mk] = true
		local al = game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):FindFirstChild("AudioLab")
		if al and al:GetAttribute("Debug") == true then -- (a debug note: the fallback is fine)
			warn(("[AudioLab] no instrument for bank %d program %d (key %d); using the General MIDI preset"):format(banks[1], c.program, key))
		end
	end
	return Instruments.gm(c.program)
end

function MidiSynth:_silenceVoice(v)
	for i = 0, self.stride - 1 do
		self.pool:setVoice(v.slot + i, 0, 0, 0)
	end
	v.ron = nil
	if v.sfv then
		self.sf:free(v.sfv)
		v.sfv = nil
	end
end

function MidiSynth:_allocate()
	local best, bestScore = nil, math.huge
	for _, v in ipairs(self.voices) do
		if not v.active then
			return v
		end
		local score = (v.stage == "release" and 0 or 10) + v.level + v.startClock * 1e-6
		if score < bestScore then
			best, bestScore = v, score
		end
	end
	self.stats.stolen += 1
	self:_silenceVoice(best)
	return best
end

function MidiSynth:_start(v, fields)
	local slot, amps = v.slot, v.amps
	table.clear(v)
	v.slot, v.amps = slot, amps
	for k, val in pairs(fields) do
		v[k] = val
	end
	v.active = true
	v.level = 0
	v.atten = 0
	v.age = 0
	v.sampleTime = 0
	v.ph, v.fq, v.on = nil, nil, nil -- phase-steered parts start from the sample's own phase
	v.son, v.bon, v.pOff = nil, nil, nil
	v.pv, v.pvMax, v.pvTop, v.amps1, v.nextB, v.bS = nil, nil, nil, nil, nil, nil
	v.prange = nil
	v.stageTime = 0
	v.stage = ((v.preset.delay or 0) > 0) and "delay" or "attack"
	v.startClock = self.clock
	v.fresh = true -- first rendered frame starts at sample time 0 (don't skip the attack)
end

function MidiSynth:noteOn(ch, key, velocity, gate)
	if velocity <= 0 then
		return self:noteOff(ch, key)
	end
	if not self:_audible(ch) then
		return
	end
	self.activity[ch] = math.max(self.activity[ch] or 0, velocity / 127)
	local c = self.channels[ch]
	local velGain = curve(velocity)
	if ch == self.drumChannel then
		local spec = Instruments.drum(key)
		self.stats.drums += 1
		if spec.noise then
			table.insert(self.noiseHits, { kit = spec.noise, age = 0, gain = velGain, fresh = true, pan = c.pan / 127, channel = ch })
		end
		if spec.tone then
			local t = spec.tone
			self:_start(self:_allocate(), {
				channel = ch, key = key, velGain = velGain, drum = t,
				preset = { wave = t.wave, gain = t.gain, attack = 0.001, decay = t.decay * 2.2, sustain = 0, release = 0.06 },
			})
		end
		return
	end
	local preset = self:_preset(ch, key, velocity)
	self.stats.notes += 1
	-- SoundFont noise samples are ordinary voices (no pool slots): the envelope, note-off and release
	-- apply exactly as for tonal notes
	-- gate: seconds until the note should sound (sequencer lookahead); its players start silently now
	-- volume and expression are read when the note starts
	self:_start(self:_allocate(), { channel = ch, key = key, velGain = velGain, preset = preset, gate = (gate and gate > 0) and gate or nil, vol = c.volume, expr = c.expression })
end

-- Releases the oldest sounding voice for (ch, key). Overlapping notes on the same key are common
-- (legato re-strikes); releasing every match would cut the newer note short.
function MidiSynth:noteOff(ch, key)
	local c = self.channels[ch]
	local oldest = nil
	for _, v in ipairs(self.voices) do
		if v.active and v.channel == ch and v.key == key and v.stage ~= "release" and not v.held and not v.relPending then
			if not oldest or v.startClock < oldest.startClock then
				oldest = v
			end
		end
	end
	if oldest then
		if c.sustain then
			oldest.held = true
		elseif oldest.fresh then
			-- not rendered yet (a note shorter than a block starts and ends in the same step): it sounds for its first
			-- block before the release begins, otherwise it would release from level 0 and never be heard (snare rolls)
			oldest.relPending = true
		else
			oldest.stage = "release"
		end
	end
end

function MidiSynth:_releaseHeld(ch)
	for _, v in ipairs(self.voices) do
		if v.active and v.channel == ch and v.held then
			v.held = nil
			v.stage = "release"
		end
	end
end

function MidiSynth:allNotesOff(ch, immediate)
	for _, v in ipairs(self.voices) do
		if v.active and (ch == nil or v.channel == ch) then
			if immediate then
				v.active = false
				self:_silenceVoice(v)
			else
				v.held = nil
				v.stage = "release"
			end
		end
	end
	if immediate then
		for i = #self.noiseHits, 1, -1 do
			if ch == nil or self.noiseHits[i].channel == ch then
				table.remove(self.noiseHits, i)
			end
		end
	end
end

function MidiSynth:controlChange(ch, cc, value)
	local c = self.channels[ch]
	if cc == 0 then
		c.bankMsb = value
	elseif cc == 32 then
		c.bankLsb = value
	elseif cc == 7 then
		c.volume = value
	elseif cc == 10 then
		c.pan = value
		self.pool:setBusPan(ch + 1, value / 127)
	elseif cc == 11 then
		c.expression = value
	elseif cc == 64 then
		local on = value >= 64
		if c.sustain and not on then
			c.sustain = false
			self:_releaseHeld(ch)
		end
		c.sustain = on
	elseif cc == 101 then
		c.rpnMsb = value
	elseif cc == 100 then
		c.rpnLsb = value
	elseif cc == 6 then
		if c.rpnMsb == 0 and c.rpnLsb == 0 then
			c.bendRange = value
		end
	elseif cc == 120 then
		self:allNotesOff(ch, true)
	elseif cc == 123 then
		self:allNotesOff(ch, false)
	elseif cc == 121 then
		local keepProgram, keepBank = c.program, c.bankMsb
		self.channels[ch] = newChannel()
		self.channels[ch].program, self.channels[ch].bankMsb = keepProgram, keepBank
	end
end

function MidiSynth:programChange(ch, program)
	self.channels[ch].program = program
end

-- Pitch bend arrives as a staircase: vocal channels often send a bend event every ~36 ms, ~16 cents apart. Applied as
-- instant steps they are heard as a blocky glide on a near-pure vocal tone. Bends that follow each other closely (within
-- BEND_GAP) and are small (within BEND_SNAP semitones) are ramped over BEND_RAMP seconds instead; a new gesture, a big jump
-- (a scoop, a reset) or a seek is applied at once. Attribute BendRamp (seconds; 0 = off) on the AudioLab module overrides it.
local BEND_RAMP = 0.04
local BEND_GAP = 0.15
local BEND_SNAP = 0.5

function MidiSynth:pitchBend(ch, value)
	local c = self.channels[ch]
	local target = value / 8192
	local ramp = script.Parent.Parent:GetAttribute("BendRamp") or BEND_RAMP
	if ramp > 0 and self.playing and c.bendAt and (self.time or 0) - c.bendAt < BEND_GAP and (self.time or 0) >= c.bendAt
		and math.abs(target - c.bend) * c.bendRange <= BEND_SNAP then
		c.bendTarget = target
		c.bendRate = math.abs(target - c.bend) / ramp
	else
		c.bend, c.bendTarget = target, nil
	end
	c.bendAt = self.time or 0
end

-- Moves every ramping channel's bend toward its target by `dt` song seconds (called once per update).
function MidiSynth:_stepBend(dt)
	local channels = self.channels
	for ch = 0, 15 do
		local c = channels[ch]
		local target = c and c.bendTarget
		if target then
			local d = target - c.bend
			local step = c.bendRate * dt
			if math.abs(d) <= step then
				c.bend, c.bendTarget = target, nil
			else
				c.bend += (d > 0) and step or -step
			end
		end
	end
end

function MidiSynth:reset()
	self:allNotesOff(nil, true)
	for c = 0, 15 do
		self.channels[c] = newChannel()
		self.pool:setBusPan(c + 1, 0.5)
	end
end

-- envelope step; returns false when the voice has finished
local function stepEnvelope(v, p, dt)
	v.stageTime += dt
	local stage = v.stage
	if stage == "delay" then
		v.level = 0
		if v.stageTime >= p.delay then
			v.stage, v.stageTime = "attack", 0
		end
	elseif stage == "attack" then
		if p.attack <= 0 then
			v.level = 1
		else
			v.level += dt / p.attack
		end
		if v.level >= 1 then
			v.level, v.atten = 1, 0
			v.stage, v.stageTime = ((p.hold or 0) > 0) and "hold" or "decay", 0
		end
	elseif stage == "hold" then
		if v.stageTime >= p.hold then
			v.stage, v.stageTime = "decay", 0
		end
	elseif stage == "decay" then
		local target = (p.sustain > 0) and math.min(-20 * math.log10(p.sustain), FLOOR_DB) or FLOOR_DB
		if p.decay <= 0 then
			v.atten = target
		else
			v.atten = math.min(target, v.atten + dt * FLOOR_DB / p.decay)
		end
		v.level = 10 ^ (-v.atten / 20)
		if p.sustain <= 0 and v.atten >= END_DB then
			return false
		end
	elseif stage == "release" then
		if v.atten == 0 and v.level < 1 then
			v.atten = -20 * math.log10(math.max(v.level, 1e-5))
		end
		if p.release <= 0 then
			v.atten = FLOOR_DB
		else
			v.atten += dt * FLOOR_DB / p.release
		end
		v.level = 10 ^ (-v.atten / 20)
		if v.atten >= END_DB then
			return false
		end
	end
	return true
end

-- interpolated analysis amplitudes at sample time tau; returns nil when a one-shot has ended
-- sample time inside the analysed frames: past loopStart, analyses with cycle = true repeat the loop
local function loopTime(a, tau)
	if a.cycle then
		local ls, ll = a.loopStart or 0, a.loopLength or 0
		if tau >= ls and ll > 0 then
			return ls + (tau - ls) % ll
		end
	end
	return tau
end

-- A cycled loop: the frame after the last one is the frame at the same moment of the loop's next pass (i2, frac2 =
-- its position among the frames, i2 may need clamping). Without it the last ~2 frames of every pass fell back to the
-- loop's steady spectrum and the partials jumped there and back once per pass: a tick at the loop rate.
local function wrapPos(a, i, nf)
	local ll = a.loopLength or 0
	if not a.cycle or ll <= 0 or (nf - 1) * a.hop < (a.loopStart or 0) + ll - a.hop * 1.5 then
		return nil
	end
	local v = (i + 1) - ll / a.hop
	local i2 = math.floor(v)
	return i2, v - i2
end

-- the baked pitch track is measured every 10 ms with about +-10 cents of measurement jitter; played
-- raw it retunes every partial of the note each frame, a warble. Smooth it over 50 ms,
-- and when what is left moves less than 12 cents it is just a tuning offset: hold that constant.
local PITCH_SMOOTH = 5
local PITCH_FLAT_CENTS = 12
local cleanPitch = setmetatable({}, { __mode = "k" })
local function cleanedPitch(a)
	local c = cleanPitch[a]
	if c ~= nil then
		return c
	end
	local pc = a.pitch
	if not pc or #pc == 0 then
		cleanPitch[a] = false
		return false
	end
	local n, h, sm = #pc, PITCH_SMOOTH // 2, table.create(#pc)
	local lo, hi, sum = math.huge, -math.huge, 0
	for i = 1, n do
		local t, k = 0, 0
		for j = math.max(1, i - h), math.min(n, i + h) do
			t += pc[j]
			k += 1
		end
		local v = t / k
		sm[i] = v
		sum += v
		lo = math.min(lo, v)
		hi = math.max(hi, v)
	end
	if hi - lo < PITCH_FLAT_CENTS then
		c = { constant = 2 ^ ((sum / n) / 1200) }
	else
		c = { track = sm }
	end
	cleanPitch[a] = c
	return c
end

-- pitch ratio from the sample's own pitch track (vibrato, slides, detuning), 1 when it has none
local function pitchRatio(a, tau)
	local cp = cleanedPitch(a)
	if not cp then
		return 1
	end
	if cp.constant then
		return cp.constant
	end
	local pc = cp.track
	local fpos = loopTime(a, tau) / a.hop
	local i = math.floor(fpos)
	local n = #pc
	if i + 1 >= n then
		local i2, f2 = wrapPos(a, i, n)
		if i2 then
			local p0 = pc[math.min(i + 1, n)]
			local pa, pb = pc[math.clamp(i2 + 1, 1, n)], pc[math.clamp(i2 + 2, 1, n)]
			return 2 ^ ((p0 + (pa + (pb - pa) * f2 - p0) * math.min(fpos - i, 1)) / 1200)
		end
		return 2 ^ (pc[n] / 1200)
	end
	return 2 ^ ((pc[i + 1] + (pc[i + 2] - pc[i + 1]) * (fpos - i)) / 1200)
end

-- a loop shorter than 3 analysis frames is a steady waveform (e.g. a 15 ms single-cycle buzz): cycling the frames
-- inside it amplitude-modulates every partial at the loop rate (x playback speed), 
-- CleanVoice (attribute): per sample, its fixed harmonic levels and its mean tuning
local cleanAmps = setmetatable({}, { __mode = "k" })
local meanPitchCache = setmetatable({}, { __mode = "k" })
local function meanPitch(a)
	local m = meanPitchCache[a]
	if not m then
		local pc, s, n = a.pitch, 0, 0
		if pc then
			local from = math.floor((a.loopStart or 0) / (a.hop or 0.01)) + 1
			for i = math.min(from, #pc), #pc do
				s += pc[i]
				n += 1
			end
		 end
		m = 2 ^ ((n > 0 and s / n or 0) / 1200)
		meanPitchCache[a] = m
	end
	return m
end

local function steadyLoop(a)
	return (a.loopLength or 0) < a.hop * 3
end

-- Rough-sine levels (a.rough: per frame, per harmonic, the RMS of the harmonic's fast motion; same frame grid as the
-- harmonic frames), at sample time tau
local function roughAmps(a, tau, out)
	local fr = a.rough
	local nf = fr and #fr or 0
	if nf == 0 then
		return nil
	end
	if a.cycle then
		tau = loopTime(a, tau)
	end
	local fpos = math.max(tau, 0) / (a.roughHop or a.hop)
	local i = math.floor(fpos)
	if i + 1 >= nf then
		return fr[nf]
	end
	local f0, f1 = fr[i + 1], fr[i + 2]
	local frac = fpos - i
	for k = 1, #f0 do
		out[k] = f0[k] + (f1[k] - f0[k]) * frac
	end
	for k = #out, #f0 + 1, -1 do
		out[k] = nil
	end
	return out
end

local function additiveAmps(a, tau, out)
	local frames = a.frames
	local nf = #frames
	if a.cycle and nf > 0 and not (a.loopAmps and steadyLoop(a)) then
		tau = loopTime(a, tau)
	elseif a.looped and (nf == 0 or tau >= (a.loopStart or 0)) then
		return a.loopAmps
	end
	if not a.looped and tau >= a.length then
		return nil
	end
	local fpos = tau / a.hop
	local i = math.floor(fpos)
	if i + 1 >= nf then
		local i2, f2 = wrapPos(a, i, nf)
		if i2 and a.cycle then
			local f0 = frames[math.min(i + 1, nf)]
			local ra, rb = frames[math.clamp(i2 + 1, 1, nf)], frames[math.clamp(i2 + 2, 1, nf)]
			local frac = math.min(fpos - i, 1)
			for k = 1, #f0 do
				local target = ra[k] + (rb[k] - ra[k]) * f2
				out[k] = f0[k] + (target - f0[k]) * frac
			end
			for k = #out, #f0 + 1, -1 do
				out[k] = nil -- the table is reused across notes: drop parts of a previous, larger sample
			end
			return out
		end
		return a.looped and (a.loopAmps or frames[nf]) or frames[nf]
	end
	local f0, f1 = frames[i + 1], frames[i + 2]
	local frac = fpos - i
	for k = 1, #f0 do
		out[k] = f0[k] + (f1[k] - f0[k]) * frac
	end
	for k = #out, #f0 + 1, -1 do
		out[k] = nil -- the table is reused across notes: drop parts of a previous, larger sample
	end
	return out
end

-- Decaying parts. Per partial of a one-shot: its decay time constant in sample seconds (log-linear fit from the
-- partial's peak down to 30 dB under it), false when it doesn't decay steadily. Cached per analysis.
local DECAY = true
local DECAY_MAX_TAU = 1.8 -- slower decays step < 0.1 dB per block: plain sines are fine
local DECAY_MIN_TAU = 0.012
local decayOk, decayRevision = nil, nil
local function decayReady()
	-- the decaying sines are in use when the active manifest has them (WaveBank.Assets)
	if decayOk == nil or decayRevision ~= WaveBank.Revision then
		decayRevision = WaveBank.Revision
		decayOk = WaveBank.DecayWave0 ~= nil and WaveBank.assetId(WaveBank.decayWave(1, 1), 1) ~= nil
	end
	return decayOk
end
local decayTaus = setmetatable({}, { __mode = "k" })
local function sampleTaus(a)
	local c = decayTaus[a]
	if c ~= nil then
		return c
	end
	c = false
	local frames = a.frames
	if not a.looped and frames and #frames >= 4 then
		c = {}
		local hop = a.hop
		for i = 1, #frames[1] do
			local peak, jp = 0, 1
			for j, row in ipairs(frames) do
				if (row[i] or 0) > peak then
					peak, jp = row[i], j
				end
			end
			local tau = false
			if peak > 0 then
				local sw, st, sy, stt, sty = 0, 0, 0, 0, 0
				local floor = peak * 10 ^ (-30 / 20)
				local n = 0
				for j = jp, #frames do
					local x = frames[j][i] or 0
					if x < floor then
						break
					end
					local w = x / peak
					local t, y = (j - 1) * hop, math.log(x)
					sw += w
					st += w * t
					sy += w * y
					stt += w * t * t
					sty += w * t * y
					n += 1
				end
				local den = sw * stt - st * st
				if n >= 4 and den > 0 then
					local slope = (sw * sty - st * sy) / den
					if slope < 0 then
						tau = -1 / slope
					end
				end
			end
			c[i] = tau and { tau = tau, peak = (jp - 1) * hop } or false
		end
	end
	decayTaus[a] = c
	return c
end

-- Tracked parts: each sine's file position is followed block by block (the block clock), so the part can move to
-- another file at the same sine phase on a block boundary: the old player stops and the new one starts on the same
-- boundary, in phase, with no seam. rate = the decay the part should have now (1/s, amplitude e-folds per second).
-- Returns the wave (a decaying sine, or the looping sine at a fixed base), the volume corrected for the file's own
-- envelope, and the phase (cycles; the pool starts a new player there).
local function trackPart(v, key, f, vol, ph, rate, blockB, blockDur)
	v.dst = v.dst or {}
	local st = v.dst[key]
	if not st then
		local r = WaveBank.rangeFor(f)
		local base = WaveBank.Bases[r]
		st = { r = r, base = base, n = 0, pos = ((ph or 0) % 1) / base, b = blockB + 1, speed = f / base }
		v.dst[key] = st
	else
		-- file position at the block this write lands on (blocks so far ran at the speed set then)
		local nb = blockB + 1 - st.b
		if nb > 0 then
			st.pos += nb * blockDur * st.speed
			st.b = blockB + 1
		end
		if st.n == 0 then
			st.pos %= 1 -- the looping sine is one second of whole cycles
		end
	end
	st.speed = f / st.base
	local wantN = st.n
	if rate < 1 / DECAY_MIN_TAU then -- faster than any file (a click-short release): the volume does it
		local fileTau = (rate > 0) and (st.speed / rate) or math.huge
		if st.n > 0 then
			local cur = WaveBank.decayTau(st.n)
			if rate < 1 / (DECAY_MAX_TAU * 1.3) then
				wantN = 0 -- stopped decaying (reached its sustain level)
			elseif math.max(fileTau / cur, cur / fileTau) > 1.35 then
				wantN = math.clamp(math.floor(math.log(fileTau / 0.025, 1.6) + 1.5), 1, WaveBank.DecayCount)
			end
		elseif rate > 1.3 / DECAY_MAX_TAU then
			wantN = math.clamp(math.floor(math.log(fileTau / 0.025, 1.6) + 1.5), 1, WaveBank.DecayCount)
		end
		if wantN > 0 then
			local t = WaveBank.decayTau(wantN)
			if math.max(fileTau / t, t / fileTau) > 1.6 then
				wantN = (st.n > 0 and math.max(fileTau / WaveBank.decayTau(st.n), WaveBank.decayTau(st.n) / fileTau) <= 1.6) and st.n or 0
			end
		end
	end
	local function envAt(n, pos)
		return (n > 0) and math.exp(-(pos + 0.5 * blockDur * st.speed) / WaveBank.decayTau(n)) or 1
	end
	local env = envAt(st.n, st.pos)
	-- re-arm a decaying file that is running out (its envelope is far down: the correction would be huge)
	-- (or close to the end of its file: the long decays' files are cut at WaveBank.DecayFileMax; two blocks of margin)
	local rearm = st.n > 0 and (st.pos > math.min(WaveBank.decayTau(st.n) * WaveBank.DecayLength * 0.6,
		WaveBank.decayFileLength(st.n) - 2 * blockDur * st.speed - 0.02) or vol / env > 2.5)
	if wantN ~= st.n or rearm then
		local phase = (st.pos * st.base) % 1 -- sine phase (cycles) at the boundary: the new file starts there
		st.n = wantN
		st.pos = phase / st.base
		env = envAt(st.n, st.pos)
		v.dsw = (v.dsw or 0) + 1
	end
	local wave = (st.n > 0) and WaveBank.decayWave(st.n, st.r) or WaveBank.trackWave(st.r)
	return wave, vol / env, st.pos * st.base
end

-- noise chain row at sample time tau: (row0, row1, frac) or nil when a one-shot has ended
-- per-frame player budget: every part a voice wants this frame is collected, then the loudest
-- maxPlayers are played (parts already sounding get a 1.5x edge so the choice doesn't flicker)
local reqSlot, reqWave, reqFreq, reqVol, reqBus, reqPri, reqOrder, reqPhase = {}, {}, {}, {}, {}, {}, {}, {}
local reqFast = {}

local function noiseRows(p, tau)
	local nz = p.noise
	if nz.loop and p.looped and tau >= (p.loopStart or 0) then
		return nz.loop, nz.loop, 0
	end
	local frames = nz.frames
	local fpos = tau / nz.hop
	local i = math.floor(fpos)
	if i + 1 > #frames then
		if nz.loop and p.looped then
			return nz.loop, nz.loop, 0
		end
		return nil
	end
	return frames[i + 1], frames[i + 2] or frames[i + 1], fpos - i
end

-- Switches (attributes on the AudioLab module, all off by default; read every frame):
-- NoBundles, NoPhaseReset, NoResidual
local debugHost = script.Parent.Parent
-- The residual is measured leak-free (see Instruments.peakShare), so its low part is real (the thump of a note played
-- far below its sample's root) and nothing is cut by default. Attribute ResidualCutMax (Hz) cuts it below that.
local RESIDUAL_CUT_MAX = 0
-- parts quieter than this (about -68 dB, before the master) are inaudible next to anything else: no player for them
local PART_FLOOR = 0.0004
-- Phase-locked voice (samples with phaseFrames): each harmonic is one sine whose speed follows the sample's own phase,
-- so the voice keeps its natural pitch movement (plain fixed harmonics sound robotic).
-- The "pairs" form (two sines per harmonic, loudness set by steering their phases apart at predicted audio-block
-- boundaries) is off: the engine does not apply property writes on an exact block, so its parts can jump off pitch
-- for 21 ms at a time (freezes and high static).
-- Attributes: PhaseLockedVoice = true brings pairs back, NoPhaseFollow = true plays plain fixed harmonics.
local PLDiag = {}
local PHASE_PULL = 0.005 -- largest phase correction, as a fraction of the part's frequency (under 9 cents)
local PHASE_DEV = 0.015 -- how far a harmonic may move from k x the note's pitch (26 cents)
local PHASE_REANCHOR = 0.12 -- cycles: a larger phase error re-anchors the part instead of being pulled back
-- (TimePosition can't steer the phases: it is an estimate the engine extrapolates from the speed last set, not the
-- audio actually played.)
local function phaseLocked(a)
	return a.phaseFrames ~= nil and debugHost:GetAttribute("NoPhaseFollow") ~= true
end
local VOICE_LEAD = 0.010
local VOICE_LEAD_RAMP = 0.025 -- seconds
local VOICE_SHARP, VOICE_SHARP_DT = 0.8, 0.010
local ROUGH_SMOOTH = 0.05 -- seconds (attribute RoughSmooth; 0 = off)
local VOICE_SMOOTH = 0.015 -- seconds: default one-pole smoothing of a voice's harmonic levels (attribute VoiceSmooth; 0 = off)
local VOICE_SHARP_FLOOR = 0.5 -- the unsharp mask may lower a part to at most half its level
local RESIDUAL_LOW_BINS = 4 -- chain positions 1-4 (88-250 Hz): the over-sized part
-- The stored noise of many samples is far larger than what the partial fit left over (a bass with a 0.10 fit
-- error carried noise 2x its own tone). Scale each sample's noise (above the low bins) so its level is at most
-- 1.5x the leftover its fit error implies (never below 12% of the tone, so breathy samples keep theirs).
-- The low bins are the exception to that scaling (a note played far below its root has a real thump there), but a
-- sample whose low-bin noise is LOUDER THAN ITS OWN TONE is measuring leakage: partials closer together than the
-- analysis can resolve (a bass whose period-2 loop gives a 41 Hz comb) are counted as noise. Such samples keep
-- only LOW_RESIDUAL_KEEP of their tone's rms in the low bins (the original's valleys between harmonics sit 30-38 dB down). Attributes: NoLowResidualCap, LowResidualKeep.
local LOW_RESIDUAL_TRIGGER = 1.0
local LOW_RESIDUAL_KEEP = 0.1
local residualScales = setmetatable({}, { __mode = "k" })
local function residualScale(a, res)
	if a.voice or debugHost:GetAttribute("NoResidualScale") == true then
		-- voice samples carry their noise measured against the tone (valley level); NoResidualScale turns the scaling off
		return 1, 1
	end
	-- attribute ResidualFloor: a fixed noise level as a fraction of the tone's rms (ignores the fit error)
	local floorAttr = debugHost:GetAttribute("ResidualFloor")
	local keepAttr = debugHost:GetAttribute("LowResidualKeep")
	local capOff = debugHost:GetAttribute("NoLowResidualCap") == true
	local cached = residualScales[a]
	if cached and cached.floor == floorAttr and cached.keep == keepAttr and cached.capOff == capOff then
		return cached.v, cached.low
	end
	local s, sLow = 1, 1
	local rf, af = res.frames, a.frames
	if rf and af and #rf > 0 and #af > 0 then
		local rp, tp, rl = 0, 0, 0
		for _, f in ipairs(rf) do
			for d = 1, #f do
				if d <= RESIDUAL_LOW_BINS then
					rl += f[d] * f[d]
				else
					rp += f[d] * f[d]
				end
			end
		end
		for _, f in ipairs(af) do
			for _, amp in ipairs(f) do
				tp += amp * amp / 2
			end
		end
		rp = math.sqrt(rp / #rf)
		rl = math.sqrt(rl / #rf)
		tp = math.sqrt(tp / #af)
		if not capOff and tp > 0 and rl > LOW_RESIDUAL_TRIGGER * tp then
			sLow = (keepAttr or LOW_RESIDUAL_KEEP) * tp / rl
		end
		local fit = math.clamp(a.fitError or 0.3, 0, 0.98)
		local implied = fit / math.sqrt(1 - fit * fit)
		local target = floorAttr and floorAttr * tp or math.max(1.5 * implied, 0.12) * tp
		if rp > target and rp > 0 then
			s = target / rp
		end
	end
	residualScales[a] = { floor = floorAttr, keep = keepAttr, capOff = capOff, v = s, low = sLow }
	return s, sLow
end

-- Attribute PhaseSpread: each sine partial starts at its own fixed pseudo-random phase instead of
-- all at zero, so the summed waveform isn't a peaky pulse train (zero-phase harmonics add into a buzz)
-- Diagnostics (attribute NoDiag = true turns them off): warns in the output when the engine sees a long frame, an audio
-- stall (no 21 ms block for a while) or blocks arriving bunched, a burst of player starts, or more players wanted than
-- the limit.
local DIAG_GAP = 0.07 -- seconds without an audio block that count as a stall
-- (only with the AudioLab folder's Debug attribute)
local ALRoot = game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):FindFirstChild("AudioLab")
local function audioDebug()
	return ALRoot ~= nil and ALRoot:GetAttribute("Debug") == true
end
local function diag(self, dt, nreq, budget)
	if debugHost:GetAttribute("NoDiag") == true or self.blockClockFn or not audioDebug() then
		return
	end
	local d = self._dg
	local now = os.clock()
	local B = self:_blockClock()
	local started = self.pool.stats.started
	if not d then
		d = { B = B, at = now, started = started, last = {}, born = now }
		self._dg = d
		warn(("[AudioLab] %s started"):format(self.pool.folder.Name))
		return
	end
	local function say(kind, msg)
		if now - (d.last[kind] or 0) > 0.5 then
			d.last[kind] = now
			warn(("[AudioLab] %s @%.2fs (%.1fs after start): %s"):format(self.pool.folder.Name, self:getTime(), now - d.born, msg))
		end
	end
	if dt > 0.025 and not self.warming and not self.warmGain then -- the warm-up steps 50 ms of song per call
		say("frame", ("frame took %.0f ms"):format(dt * 1000))
	end
	if B ~= d.B then
		local jump = B - d.B
		if jump >= 3 and dt < 0.03 then
			say("bunch", ("%d audio blocks arrived in one %.0f ms frame"):format(jump, dt * 1000))
		end
		d.B, d.at = B, now
	elseif now - d.at > DIAG_GAP then
		say("stall", ("no audio block for %.0f ms"):format((now - d.at) * 1000))
	end
	if started - d.started >= 25 then
		say("starts", ("%d players started at once"):format(started - d.started))
	end
	d.started = started
	if nreq > budget then
		say("budget", ("wanted %d players, limit %d (quietest dropped)"):format(nreq, budget))
	end
end

local function partialPhase(k)
	local x = math.sin(k * 12.9898 + 78.233) * 43758.5453
	return x - math.floor(x)
end
local CHAIN_FC = {}
for d = 1, WaveBank.ChainBins do
	CHAIN_FC[d] = WaveBank.ChainBase * 2 ^ ((d - 1) / 2)
end

-- Source-filter notes (samples with a.sf, see Synth.SourceFilter): one saw + one noise player through 8 moving filters
-- instead of 17-29 sine parts. Returns false when the note plays on the additive engine instead: attribute
-- SourceFilter = false on the AudioLab module (read every frame), or every source-filter voice busy.
function MidiSynth:_sfStep(v, p, c, chGain, blockHalf)
	if v.sfNo or debugHost:GetAttribute("SourceFilter") == false then
		if v.sfv then
			self.sf:free(v.sfv)
			v.sfv = nil
		end
		return false
	end
	local a = p.additive
	local sp = p.speed or 1
	local tauC, tauF
	if blockHalf then
		-- block-ahead: this write lands on the block's start; levels for its middle, filters for its end
		tauC = v.sampleTime + blockHalf * sp
		tauF = v.sampleTime + 2 * blockHalf * sp
	else
		-- per frame: the write lands on the next boundary; filters a block further on (their ~27 ms glide)
		tauC = v.sampleTime + VOICE_LEAD * sp
		tauF = tauC + (self.blockDur or 1024 / 48000) * sp
	end
	if not v.sfv then
		self.sf = self.sf or SourceFilter.new(self.pool)
		local h = self.sf:start(a, sp, v.channel + 1, tauC)
		if not h then
			v.sfNo = true
			return false
		end
		v.sfv = h
		for i = 0, self.stride - 1 do
			self.pool:setVoice(v.slot + i, 0, 0, 0) -- sine parts it had (the attribute switched on mid-note)
		end
	end
	local bendR = (c.bend ~= 0) and 2 ^ (c.bend * c.bendRange / 12) or 1
	self.sf:update(v.sfv, tauC, tauF, sp, bendR, v.level * (p.atten or 1) / (a.energyComp or 1) * chGain)
	return true
end

-- One-shot onset bursts (sharp-start noise assets): a few players per asset, reused round-robin.
function MidiSynth:_playBurst(name, volume, speed, bus, delay)
	if self.burstHook then
		self.burstHook(name, volume, speed, bus)
	end
	local id = WaveBank.Assets[name]
	if not id or id == "" or volume <= 0 then
		return
	end
	local pool = self.pool
	self.burstPlayers = self.burstPlayers or {}
	local list = self.burstPlayers[name]
	if not list then
		list = {}
		self.burstPlayers[name] = list
	end
	local p
	for _, q in ipairs(list) do
		if not q.IsPlaying then
			p = q
			break
		end
	end
	if not p then
		if #list >= 8 then
			p = table.remove(list, 1)
			table.insert(list, p)
		else
			p = Instance.new("AudioPlayer")
			p.Name = name
			p.Asset = id
			p.Looping = false
			local w = Instance.new("Wire")
			w.Name = "Out"
			w.SourceInstance = p
			w.Parent = p
			p.Parent = pool.output
			table.insert(list, p)
		end
	end
	local target = pool.output
	if pool.stereo and pool.buses then
		local b = pool.buses[bus] or pool.buses[1]
		target = b and b.input or target
	end
	local w = p:FindFirstChild("Out")
	if w and w.TargetInstance ~= target then
		w.TargetInstance = target
	end
	p.Volume = volume
	p.PlaybackSpeed = speed
	local reg = WaveBank.Regions[name]
	if reg and reg.stopAt then
		-- atlas pack: the burst is a region of a shared file; start at its onset and stop where it ends (the file goes on
		-- with the next sound)
		-- delay: seconds of silence before the onset (the start lands on a block boundary; the file holds silence ahead of
		-- every sound, so starting that much earlier places the onset inside the block)
		local pre = math.min((delay or 0) * speed, reg.lead or 0)
		p.TimePosition = reg.onset - pre
		if not p.IsPlaying then
			p:Play()
		end
		local token = (p:GetAttribute("BurstToken") or 0) + 1
		p:SetAttribute("BurstToken", token)
		task.delay((reg.stopAt - reg.onset + pre) / math.max(speed, 0.05), function()
			if p.Parent and p:GetAttribute("BurstToken") == token then
				p:Stop()
			end
		end)
		return
	end
	p.TimePosition = 0
	if not p.IsPlaying then
		p:Play()
	end
end

-- The engine's audio block clock: a silent looping player's TimePosition moves once per block (1024 output samples),
-- so watching it tells which block boundary has just passed. Returns (index of the last boundary seen, block length).
function MidiSynth:_blockClock()
	if self.blockClockFn then
		return self.blockClockFn()
	end
	local cp = self.clockPlayer
	if not cp then
		cp = Instance.new("AudioPlayer")
		cp.Name = "BlockClock"
		cp.Asset = WaveBank.assetId(SINE, WaveBank.SineRange or 1) or ""
		cp.Looping = true
		cp.Volume = 0
		cp.Parent = self.pool.output or self.holder
		local w = Instance.new("Wire")
		w.Name = "Out"
		w.SourceInstance = cp
		w.TargetInstance = self.pool.output
		w.Parent = cp
		cp:Play()
		self.clockPlayer = cp
		self.blockIndex, self.blockDur, self.clockLast = 0, 1024 / 48000, nil
		self.clockSum, self.clockSteps = 0, 0
	end
	local pos = cp.TimePosition
	local last = self.clockLast
	if last then
		local d = pos - last
		if d < -0.5 then
			d += (cp.TimeLength > 0 and cp.TimeLength or 1)
		end
		if d > 1e-4 then
			local n = math.max(1, math.floor(d / self.blockDur + 0.5))
			self.blockIndex += n
			self.clockSum += d
			self.clockSteps += n
			if self.clockSteps >= 50 then
				-- 1024 samples at the device rate (21.3 ms at 48 kHz, 23.2 ms at 44.1 kHz)
				self.blockDur = self.clockSum / self.clockSteps
			end
		end
	end
	self.clockLast = pos
	return self.blockIndex, self.blockDur
end

function MidiSynth:update(dt)
	self.clock += dt
	self:_stepBend(dt)
	local pool = self.pool
	-- block-ahead mode (see _build): song seconds from the start of the block being written to its middle; nil per frame
	local blockHalf = self.blockHalf
	if self.warmTrimAt and self.clock >= self.warmTrimAt then
		self.warmTrimAt = nil
		pool.warmReserve, pool.idleStop = self.baseWarmReserve, self.baseIdleStop
	end
	local noBundles = debugHost:GetAttribute("NoBundles") == true
	-- pulse bundles are opt-in (attribute Pulses = true); a buzz from the bundles' even harmonics is fixed by
	-- Cycle = "exact" instead
	local noPulses = debugHost:GetAttribute("Pulses") ~= true
	local phaseSpread = debugHost:GetAttribute("PhaseSpread") == true
	local bundleGain = debugHost:GetAttribute("BundleGain") or 1
	local noResidual = debugHost:GetAttribute("NoResidual") == true
	pool.phaseReset = debugHost:GetAttribute("NoPhaseReset") ~= true
	local master = self.masterGain * HEADROOM * (self.warmGain or 1)
	local levels = self.bandLevels
	self.bandLevelsR = self.bandLevelsR or table.create(#levels, 0)
	local levelsR = self.bandLevelsR
	for b = 1, #levels do
		levels[b] = 0
		levelsR[b] = 0
	end
	local stereo = self.stereo
	local panGains = OscillatorPool.panGains
	local sineSlots = self.sineSlots
	local nreq = 0
	local realPool = pool
	local prep = nil -- set while a gated voice is processed: its parts are prepared, not played
	local function want(slot, wave, freq, vol, bus, phase, fast)
		if prep and wave ~= 0 and freq > 0 then
			vol = prep
		end
		if wave == 0 or vol == 0 or freq <= 0 then
			realPool:setVoice(slot, 0, 0, 0)
			return
		end
		nreq += 1
		reqSlot[nreq], reqWave[nreq], reqFreq[nreq], reqVol[nreq], reqBus[nreq], reqPhase[nreq] = slot, wave, freq, vol, bus, phase
		reqFast[nreq] = fast
	end
	pool = { setVoice = function(_, ...)
		want(...)
	end }
	local activity = self.activity
	local fall = math.exp(-dt * 6)
	for c = 0, 15 do
		activity[c] *= fall
	end
	for _, v in ipairs(self.voices) do
		if v.active and v.channel then
			local a = v.level * (v.velGain or 1) ^ 0.5
			if a > activity[v.channel] then
				activity[v.channel] = a
			end
		end
	end
	for _, v in ipairs(self.voices) do
		if v.active then
			local p = v.preset
			-- a note started during this frame renders its very start first; the sample clock
			-- only advances from the next frame (otherwise short attacks are skipped entirely)
			local alive
			if v.gate then
				-- not sounding yet: parts are prepared (first frame restarts them in phase), envelope waits
				prep = v.gatePrepared and OscillatorPool.PREPARE_HOLD or OscillatorPool.PREPARE
				v.gatePrepared = true
				v.gate -= dt
				if v.gate <= 0 then
					v.gate = nil
				end
				alive = true
			else
				prep = nil
				local fresh = v.fresh
				local clockDt = fresh and 0 or dt
				v.fresh = nil
				v.age += clockDt
				-- block-ahead: a note that starts on this block's boundary is drawn at the block's middle
				alive = stepEnvelope(v, p, (fresh and blockHalf) or dt)
				if v.relPending then
					v.relPending = nil
					if alive and v.stage ~= "release" then
						v.stage, v.stageTime = "release", 0
					end
				end
				if alive and v.stage ~= "delay" then
					v.sampleTime += clockDt * (p.speed or 1)
				end
			end
			local c = self.channels[v.channel]
			local semis
			if v.drum then
				local d = v.drum
				local f = d.to
				if d.sweep > 0 and v.age < d.sweep * 4 then
					f = d.to + (d.from - d.to) * math.exp(-v.age / d.sweep)
				end
				semis = 12 * math.log(f / 440, 2) + 69
			else
				semis = v.key + (p.transpose or 0) + c.bend * c.bendRange
			end
			local freq = 440 * 2 ^ ((semis - 69) / 12)
			-- channel volume (CC7) and expression (CC11) apply live to sounding notes, as in the original: a song fades a
			-- held chord by stepping CC7 down (KP3CLEAR). (Freezing them at note-on lost every one of those fades.)
			local chGain = v.velGain * ccCurve(self.freezeVolume and (v.vol or c.volume) or c.volume) * ccCurve(self.freezeVolume and (v.expr or c.expression) or c.expression) * master
			if alive and p.noise then
				local nt = v.sampleTime + (blockHalf and blockHalf * (p.speed or 1) or 0)
				local r0, r1, frac = noiseRows(p, nt)
				if not r0 and nt ~= v.sampleTime then
					nt = v.sampleTime -- the block's middle is past the sample's end: its start still plays
					r0, r1, frac = noiseRows(p, nt)
				end
				if not r0 then
					alive = false
				else
					local g = v.level * (p.atten or 1) * chGain
					local gl, gr = 1, 1
					if stereo then
						gl, gr = panGains(c.pan / 127)
					end
					local nz = p.noise
					-- a flam (clap): its hits are played as bursts at exact offsets; the chain only carries what follows them
					local gate = 1
					local hits = nz.hits
					if hits and not prep and v.hitsOn == nil then
						v.hitsOn = WaveBank.Regions.burst_4000_t6 ~= nil and debugHost:GetAttribute("NoClapHits") ~= true
						if v.hitsOn then
							local hsp = p.speed or 1
							local hg = tonumber(debugHost:GetAttribute("ClapHitGain")) or 0.56
							for _, h in ipairs(hits) do
								local bname = h.hz < 3000 and "burst_2000_t6" or (h.hz < 6000 and "burst_4000_t6" or "burst_8000_t6")
								local spec = WaveBank.Bursts[bname]
								self:_playBurst(bname, g * hg * h.amp / ((spec and spec.rms5) or 0.2), hsp, v.channel + 1, h.t / hsp)
							end
						end
					end
					if hits and v.hitsOn then
						gate = math.clamp((nt - (hits[#hits].t + 0.004)) / 0.010, 0, 1)
					end
					local pk = nz.peakAmps
					local fpos = nt / nz.hop
					local fi = math.floor(fpos)
					local ff = fpos - fi
					local ra, rb = pk and pk[fi + 1], pk and (pk[fi + 2] or pk[fi + 1])
					local fa, fb = pk and nz.peakFreqFrames[fi + 1], pk and (nz.peakFreqFrames[fi + 2] or nz.peakFreqFrames[fi + 1])
					local speed = p.speed or 1
					-- block-ahead: each level is the RMS over the block's own span (NOISE_TAPS taps; nothing past the
					-- sample's end), not the block's middle: the 10 ms frames of a short breath don't alias into a
					-- 47 Hz staircase, and the block that straddles the end stops at the end instead of playing on
					local taps = nil
					if blockHalf and debugHost:GetAttribute("NoiseBlockAvg") ~= false then
						taps = {}
						local blkS = 2 * blockHalf * speed
						for q = 1, NOISE_TAPS do
							local tq = v.sampleTime + blkS * (q - 0.5) / NOISE_TAPS
							local q0, q1, qf = noiseRows(p, tq)
							taps[q] = q0 and { t = tq, r0 = q0, r1 = q1, f = qf } or false
						end
					end
					local function peakAmp(i)
						if not taps then
							return (ra and ra[i] and (ra[i] + (rb[i] - ra[i]) * ff) or 0)
						end
						local e = 0
						for q = 1, NOISE_TAPS do
							local tp = taps[q]
							if tp and pk then
								local fp = tp.t / nz.hop
								local j = math.floor(fp)
								local xa, xb = pk[j + 1], pk[j + 2] or pk[j + 1]
								if xa and xa[i] then
									local x = xa[i] + ((xb and xb[i] or xa[i]) - xa[i]) * (fp - j)
									e += x * x
								end
							end
						end
						return math.sqrt(e / NOISE_TAPS)
					end
					for i = 1, sineSlots do
						local amp = peakAmp(i) * gate
						if amp > 0 then
							local f
							local fA = fa and fa[i]
							if fA then
								local fB = (fb and fb[i]) or fA
								f = (fA + (fB - fA) * ff) * speed
							else
								-- the block's middle lies past the analysed frames (its RMS still has sound from earlier
								-- taps): the pitch of the last frame that has this part
								local pff = nz.peakFreqFrames
								local last = pff and pff[math.min(fi + 1, #pff)]
								f = (last and last[i] or 0) * speed
							end
							if f > 0 and f < MAX_PARTIAL_HZ then
								pool:setVoice(v.slot + i - 1, SINE, f, g * amp / SINE_GAIN, v.channel + 1)
							else
								pool:setVoice(v.slot + i - 1, 0, 0, 0)
							end
						else
							pool:setVoice(v.slot + i - 1, 0, 0, 0)
						end
					end
					-- a sample played above its root key moves up the chain: 2 positions per octave
					local shift = 2 * math.log(p.speed or 1, 2)
					local function chainAt(q0, q1, qf, i0, t)
						local l = 0
						if i0 >= 1 and i0 <= CHAIN_N then
							l += (q0[i0] + (q1[i0] - q0[i0]) * qf) * (1 - t)
						end
						if i0 + 1 >= 1 and i0 + 1 <= CHAIN_N then
							l += (q0[i0 + 1] + (q1[i0 + 1] - q0[i0 + 1]) * qf) * t
						end
						return l
					end
					for d = 1, CHAIN_N do
						local sp = d - shift
						local i0 = math.floor(sp)
						local t = sp - i0
						local l
						if taps then
							local e = 0
							for q = 1, NOISE_TAPS do
								local tp = taps[q]
								if tp then
									local x = chainAt(tp.r0, tp.r1, tp.f, i0, t)
									e += x * x
								end
							end
							l = math.sqrt(e / NOISE_TAPS)
						else
							l = chainAt(r0, r1, frac, i0, t)
						end
						if l > 0 then
							l *= g * gate
							local band = CHAIN[d]
							levels[band] += (l * gl) ^ 2
							levelsR[band] += (l * gr) ^ 2
						end
					end
				end
			elseif alive and p.additive and p.additive.sf and not prep and self:_sfStep(v, p, c, chGain, blockHalf) then
				-- (played by the source-filter voice: _sfStep)
			elseif alive and p.additive then
				local a = p.additive
				-- a coherent voice follows fast spectral changes (a vowel is ~50 ms long): the engine applies a volume change
				-- about one frame (+ its own ramp) after it is written, so write the level that is due then
				local ampTime = v.sampleTime
				if blockHalf then
					-- block-ahead: the write lands exactly on the block's start, so the level due is the block's middle (no lead)
					ampTime += blockHalf * (p.speed or 1)
					if a.length and ampTime >= a.length then
						ampTime = math.max(v.sampleTime, a.length - 1e-4)
					end
				elseif a.voice and VOICE_LEAD > 0 and ampTime + VOICE_LEAD * (p.speed or 1) < (a.length or 0) then
					ampTime += VOICE_LEAD * (p.speed or 1) * math.clamp((v.sampleTime - VOICE_LEAD_RAMP) / 0.02, 0, 1) -- no lead on the first update: it would skip the opening frame (the consonant burst)
				end
				local amps = additiveAmps(a, ampTime, v.amps)
				local blockB, blockDur = nil, nil
				if amps and BLOCK_AVG and (not a.voice or debugHost:GetAttribute("VoiceBlockAvg") ~= false) and not a.phaseFrames and debugHost:GetAttribute("NoBlockAvg") ~= true then
					local B, blk = self:_blockClock()
					blockB, blockDur = B, blk
					-- the block where sample time 0 plays: players start on the boundary after the first write
					-- a note that waited (prepared, or in its envelope delay) starts on the boundary after its first sounding
					-- write (not the boundary of its last waiting write, which would skip its first block of attack)
					if prep or v.stage == "delay" then
						v.blk0, v.blkWait = B + 1, true
					elseif not v.blk0 or v.blkWait then
						v.blk0, v.blkWait = B + 1, nil
					end
					local span = blk * (p.speed or 1)
					local s0 = (B + 1 - v.blk0) * span
					v.bq, v.bt = v.bq or {}, v.bt or {}
					local acc = v.bq
					local n0 = #amps
					for k = 1, n0 do
						acc[k] = 0
					end
					for k = #acc, n0 + 1, -1 do
						acc[k] = nil
					end
					for q = 1, BLOCK_TAPS do
						local r = additiveAmps(a, s0 + span * (q - 0.5) / BLOCK_TAPS, v.bt)
						if r then
							for k = 1, n0 do
								local x = r[k] or 0
								acc[k] += x * x
							end
						end
					end
					for k = 1, n0 do
						acc[k] = math.sqrt(acc[k] / BLOCK_TAPS)
					end
					amps = acc
				end
				local vsharp = tonumber(debugHost:GetAttribute("VoiceSharp")) or VOICE_SHARP -- attribute VoiceSharp: 0 = no unsharp mask
				local sharpFloor = tonumber(debugHost:GetAttribute("VoiceSharpFloor")) or VOICE_SHARP_FLOOR
				if amps and a.voice and vsharp > 0 and not phaseLocked(a) then
					-- unsharp mask in time: the analysis window (16 ms) and the engine's ramp round off the edges of the vowel;
					-- pushing each part away from the mean of its neighbours restores the sharp up and down of the original
					local sp = p.speed or 1
					local len = a.length or 0
					local tA, tB = math.max(0, ampTime - VOICE_SHARP_DT * sp), math.min(len - 1e-4, ampTime + VOICE_SHARP_DT * sp)
					v.sA, v.sB, v.sS = v.sA or {}, v.sB or {}, v.sS or {}
					local ca = additiveAmps(a, tA, v.sA)
					local cb = additiveAmps(a, tB, v.sB)
					if ca and cb then
						local out = v.sS
						for k = 1, #amps do
							local c = amps[k]
							local x = c + vsharp * (c - 0.5 * ((ca[k] or c) + (cb[k] or c)))
							-- never below VOICE_SHARP_FLOOR x the part's own level: at a natural dip the mask would drive a
							-- harmonic to 0, switching the part off and restarting it at phase 0 a block later (stutter)
							out[k] = math.clamp(x, c * sharpFloor, c * 3)
						end
						amps = out
					end
				end
				-- attribute VoiceSmooth (seconds): one-pole smoothing of every harmonic's level over time. The
				-- engine applies a level once per 21 ms block, so a fast swing becomes a staircase whose steps are heard as a buzz.
				local vsm = tonumber(debugHost:GetAttribute("VoiceSmooth")) or VOICE_SMOOTH
				if amps and a.voice and vsm and vsm > 0 and not prep then
					local sm = v.vsm
					if not sm then
						sm = {}
						v.vsm = sm
					end
					-- a new note (sample time went back) starts from its own opening frame, and the first 40 ms stay unsmoothed (the consonant)
					if not v.vsmT or v.sampleTime < v.vsmT or v.sampleTime < 0.04 then
						table.clear(sm)
					end
					v.vsmT = v.sampleTime
					local alpha = 1 - math.exp(-math.clamp(dt, 1 / 240, 1 / 20) / vsm)
					for k = 1, #amps do
						local x, y = amps[k], sm[k]
						sm[k] = y and (y + (x - y) * alpha) or x
					end
					for k = #sm, #amps + 1, -1 do
						sm[k] = nil
					end
					amps = sm
				end
				-- attribute CleanVoice: a voice plays as a clean tone. Every harmonic holds the level it has
				-- in the sample's loop (only the first CLEAN_K), the pitch holds the sample's mean tuning, and the noise layer is
				-- off: nothing changes during the note except the note's own envelope.
				local clean = a.voice and not phaseLocked(a) and debugHost:GetAttribute("CleanVoice") == true
				if amps and clean then
					local ca = cleanAmps[a]
					if not ca then
						ca = {}
						local la = a.loopAmps or {}
						local K = tonumber(debugHost:GetAttribute("CleanVoiceK")) or 6
						for k = 1, #amps do
							ca[k] = (k <= K and la[k]) or 0
						end
						cleanAmps[a] = ca
					end
					amps = ca
				end
				if not amps then
					alive = false
				else
					local g = v.level * p.atten * chGain / SINE_GAIN
					local partials = a.partials
					-- samples that repeat every two root periods are analysed an octave down
					local fund = freq * (a.fundamental or 1) * (clean and meanPitch(a) or pitchRatio(a, v.sampleTime))
					local strongest = 0
					for i = 1, math.min(#partials, self.partials, #amps) do
						strongest = math.max(strongest, amps[i])
					end
					local groups = a.groups
					local P = #partials
					if groups then
						for j = 1, #groups do
							strongest = math.max(strongest, amps[P + j])
						end
					end
					local floorAmp = strongest * 0.003 -- skip parts 50 dB below the strongest (saves players)
					if phaseLocked(a) then
						-- phase-locked voice: each harmonic follows the sample's own phase. Its speed for the coming
						-- frame is chosen so it reaches the phase the sample has at the next update (the frame's
						-- correction rides on the speed), which keeps the shape of every vocal pulse
						local U = a.phaseFrames
						local nU = #U
						local hopA = a.hop
						local sp = p.speed or 1
						local dtn = math.clamp(dt, 1 / 240, 1 / 20)
						local s0 = v.sampleTime
						local bendR = (c.bend ~= 0) and 2 ^ (c.bend * c.bendRange / 12) or 1

						local function target(k, st)
							local fpos = math.max(st, 0) / hopA
							local j = math.floor(fpos)
							if j + 2 > nU then
								local r1, r0 = U[nU], U[math.max(1, nU - 1)]
								return r1[k] + (r1[k] - r0[k]) * (fpos - (nU - 1))
							end
							local ra, rb = U[j + 1], U[j + 2]
							return ra[k] + (rb[k] - ra[k]) * (fpos - j)
						end
						v.ph, v.fq, v.on = v.ph or {}, v.fq or {}, v.on or {}
						local ph, fq, on = v.ph, v.fq, v.on
						local s1 = s0 + dtn * sp
						if a.pairs and debugHost:GetAttribute("PhaseLockedVoice") == true then
							-- Two sines per harmonic at one volume for the whole note; the loudness a = 2 V cos(2 pi d) is
							-- set by steering them to phases target +- d (no volume change every frame: the engine ramps a
							-- volume change and then holds it, which is heard as a faint echo).
							-- The engine reads a player's speed once per audio block (1024 samples, ~21 ms) and applies it
							-- for the whole block, exactly. So the parts are steered per block: while block n runs, the
							-- speed for block n+1 is chosen so each sine lands on its target phase at the end of block n+1.
							local K = #U[1]
							local B, blk = self:_blockClock()
							local gFull = p.atten * chGain / SINE_GAIN
							v.pv = v.pv or {}
							local pv = v.pv
							if not v.pvMax then
								-- per-harmonic peak over the whole sample, once per note
								local mx = {}
								local top = 0
								for _, row in ipairs(a.frames) do
									for j = 1, K do
										local x = row[j] or 0
										if x > (mx[j] or 0) then
											mx[j] = x
										end
										if x > top then
											top = x
										end
									end
								end
								v.pvMax, v.pvTop = mx, top
							end
							local len = (a.length or 1) - 1e-4
							local function need(j, st, out)
								local am = additiveAmps(a, math.min(st, len), out)
								return am and (am[j] or 0) * g or 0
							end
							-- block bookkeeping: v.nextB = boundary that ends the block whose speed is already decided,
							-- v.bS = sample time at the boundary that starts it
							local decide = false
							local fresh = v.nextB == nil
							if fresh then
								if prep then
									for i = 1, sineSlots do
										pool:setVoice(v.slot + i - 1, 0, 0, 0)
									end
								else
									v.nextB = B + 2 -- a seek written now lands on boundary B + 1
									v.bS = 0
									decide = true
									-- the consonant: onset bursts start with the note's sines, on the same block boundary
									if a.bursts then
										for _, b in ipairs(a.bursts) do
											self:_playBurst(b.name, b.gain * p.atten * chGain, sp, v.channel + 1)
										end
									end
								end
							elseif B >= v.nextB - 1 then
								-- blocks that started before the decision ran at the speed already set
								while B > v.nextB - 1 do
									for i, f in pairs(fq) do
										ph[i] += f * blk
									end
									v.bS += blk * sp
									v.nextB += 1
								end
								decide = true
							end
							if v.nextB then
								v.namps = v.namps or {}
								-- fresh: the decided block starts at v.bS; otherwise the next block starts where the current one ends
								local sStart = fresh and 0 or (v.bS + blk * sp)
								local sEnd = sStart + blk * sp
								for j = 1, K do
									local slotA, slotB = v.slot + j - 1, v.slot + K + j - 1
									local mxj = v.pvMax[j] or 0
									v.pOff = v.pOff or {}
									if decide and a.smooth then
										-- a pair whose level has faded to nothing stops (both players at once: their sum is ~0),
										-- and starts again fresh if the level comes back
										local nEnd = need(j, sEnd, v.namps)
										if nEnd < PART_FLOOR * 0.5 then
											if not v.pOff[j] then
												v.pOff[j] = true
												pv[j], ph[j], ph[K + j] = nil, nil, nil
											end
										elseif v.pOff[j] and nEnd > PART_FLOOR then
											v.pOff[j] = nil
										end
									end
									if v.pOff[j] then
										pool:setVoice(slotA, 0, 0, 0)
										pool:setVoice(slotB, 0, 0, 0)
									elseif mxj > v.pvTop * 0.003 and gFull * mxj > PART_FLOOR then
										for side = 1, 2 do
											local i = (side == 1) and j or (K + j)
											local slot = (side == 1) and slotA or slotB
											if decide then
												local sg = (side == 1) and 1 or -1
												local V = pv[j]
												local n1 = need(j, sEnd, v.namps)
												if not V or n1 > 2 * V then
													V = math.max(gFull * mxj, n1) * 0.5 * 1.05
													pv[j] = V
												end
												local d1 = math.acos(math.clamp(n1 / (2 * V), 0, 1)) / (2 * math.pi)
												local u0, u1 = target(j, sStart) * bendR, target(j, sEnd) * bendR
												local startPh
												if fresh or ph[i] == nil then
													local n0 = need(j, sStart, v.namps)
													startPh = u0 + sg * math.acos(math.clamp(n0 / (2 * V), 0, 1)) / (2 * math.pi)
												else
													startPh = ph[i] + fq[i] * blk -- phase where the running block ends
												end
												local adv = u1 - u0
												local err = (u1 + sg * d1) - (startPh + adv)
												err -= math.floor(err + 0.5)
												local f = (adv + err) / blk
												if f <= 1 or f >= MAX_PARTIAL_HZ then
													f = math.clamp(adv / blk, 1, MAX_PARTIAL_HZ - 1)
												end
												ph[i], fq[i] = startPh, f -- ph = phase where the decided block starts
											end
											pool:setVoice(slot, SINE, fq[i], pv[j], v.channel + 1, ph[i] % 1, "exact")
										end
									else
										pool:setVoice(slotA, 0, 0, 0)
										pool:setVoice(slotB, 0, 0, 0)
									end
								end
								if decide then
									if not fresh then
										v.bS = sStart
									end
									if not fresh then
										v.nextB += 1
									end
								end
							end
							-- smooth mode: the strongest harmonics are pairs (above); the rest are ordinary sines
							v.son = v.son or {}
							local son = v.son
							for i = 2 * K + 1, sineSlots do
								local k = a.smooth and partials[i]
								local lim = son[i] and 0.3 or 1
								if k and (amps[i] or 0) > floorAmp * lim and g * amps[i] > PART_FLOOR * lim then
									son[i] = true
									local f = fund * k
									if f < MAX_PARTIAL_HZ and f > 20 then
										pool:setVoice(v.slot + i - 1, SINE, f, g * amps[i], v.channel + 1, (a.phases and a.phases[i]) or nil, false)
									else
										pool:setVoice(v.slot + i - 1, 0, 0, 0)
									end
								else
									son[i] = nil
									pool:setVoice(v.slot + i - 1, 0, 0, 0)
								end
							end
						else
						local Kp = #U[1] -- harmonics that have phase data (the partial list can be longer)
						v.fundNow = fund -- read by in-game checks
						for i = 1, sineSlots do
							local k = i <= Kp and partials[i]
							local slot = v.slot + i - 1
							-- Bend: the sample's phase is a running total, so multiplying it by the bend ratio would make the target
							-- jump every time the bend moved (a scoop = a chain of jumps). Instead the bend's extra
							-- cycles are summed frame by frame: target = sample phase + bo, speed = sample speed x bend ratio.
							local bo, rr0, rr1 = v.bo, nil, nil
							if not bo then
								bo = {}
								v.bo = bo
							end
							local fixBend = debugHost:GetAttribute("NoBendFix") ~= true
							local off = 0
							if k then
								rr0, rr1 = target(i, s0), target(i, s1)
								if fixBend then
									off = bo[i] or 0
									if not prep then
										bo[i] = off + (rr1 - rr0) * (bendR - 1)
									end
								end
							end
							-- the player keeps running at its last speed while it is muted (and a new one is started at the
							-- tracked phase), so the tracked phase advances every frame, sounding or not
							local cur = ph[i]
							if cur then
								cur += fq[i] * dt
								ph[i] = cur
							end
							-- on/off with hysteresis: a part that flickers around the floor would restart every frame
							local lim = on[i] and 0.3 or 1
							if k and (amps[i] or 0) > floorAmp * lim and g * amps[i] > PART_FLOOR * lim then
								local t0, adv
								if fixBend then
									t0 = rr0 + off
									adv = (rr1 - rr0) * bendR
								else
									t0 = rr0 * bendR
									adv = rr1 * bendR - t0
								end
								if not cur then
									cur = t0
								end
								local f
								if prep then
									f = adv / dtn -- not sounding yet: run at the nominal speed, corrected when the note starts
								else
									local err = t0 - cur
									err -= math.floor(err + 0.5)
									-- a big phase error is not pulled back: the part re-anchors on its current phase and follows
									-- the sample's phase increments from there. (After the PHASE_DEV clamp below overrides a messy
									-- onset frame the part can be most of a cycle off its target, and the gentle pull, <= 0.5 % +
									-- 0.5 Hz, would leave a short one-shot sharp, every harmonic at its own offset.)
									if fixBend and math.abs(err) > PHASE_REANCHOR and not prep then
										bo[i] = (bo[i] or 0) - err
										t0 -= err
										err = 0
									end
									-- pulled back toward the sample's phase gently: a frame the engine applied late (or a stall)
									-- never turns into an audible pitch jump
									local nominal = adv / dtn
									local lim = math.abs(nominal) * PHASE_PULL + 0.5
									f = nominal + math.clamp(err / dtn, -lim, lim)
								end
								-- the sample's phase on a weak harmonic is barely measurable: following it made that harmonic jump
								-- 10-60% between frames. Each harmonic moves freely within PHASE_DEV of its place in the series.
								local ref = fund * k
								if ref > 0 then
									local fBefore = f
									f = math.clamp(f, ref * (1 - PHASE_DEV), ref * (1 + PHASE_DEV))
									if debugHost:GetAttribute("PLDiag") == true and not prep and i == 1 then
										-- diagnostics: how often the first harmonic is clamped / how far it is from its target
										local d = PLDiag[v.channel]
										if not d then
											d = { n = 0, clamp = 0, errAbs = 0, errMax = 0, devSum = 0, dev = 0 }
											PLDiag[v.channel] = d
										end
										local e = math.abs(t0 - cur)
										e = math.abs(e - math.floor(e + 0.5))
										d.n += 1
										d.errAbs += e
										d.errMax = math.max(d.errMax, e)
										if f ~= fBefore then d.clamp += 1 end
										d.devSum += math.abs(fBefore / ref - 1)
										if d.n % 100 == 0 then
											debugHost:SetAttribute("PL" .. v.channel, string.format("n=%d clamped=%.0f%% errAvg=%.3f errMax=%.2f cyc devAvg=%.2f%% fund=%.1f", d.n, 100 * d.clamp / d.n, d.errAbs / d.n, d.errMax, 100 * d.devSum / d.n, fund))
										end
									end
								end
								if f > 1 and f < MAX_PARTIAL_HZ then
									pool:setVoice(slot, SINE, f, g * amps[i], v.channel + 1, cur % 1, "exact")
									ph[i], fq[i], on[i] = cur, f, true
								else
									pool:setVoice(slot, 0, 0, 0)
									on[i] = nil
								end
							else
								pool:setVoice(slot, 0, 0, 0)
								on[i] = nil
							end
						end
						end
					else
					v.son = v.son or {}
					local son = v.son
					-- Tracked parts (see trackPart): while a part decays (the envelope's decay to silence or its release, or
					-- the sample's own decay past the partial's peak) it plays from the decaying sine closest to its decay
					local track = DECAY and blockB and not prep and not a.exactCycle and not a.phases and decayReady() and debugHost:GetAttribute("NoDecay") ~= true
					local envRate = 0
					if track then
						if v.stage == "decay" and (p.decay or 0) > 0 then
							local target = (p.sustain > 0) and math.min(-20 * math.log10(p.sustain), FLOOR_DB) or FLOOR_DB
							if v.atten < target - 1 then
								envRate = FLOOR_DB / p.decay / 8.686 -- amplitude e-folds per second
							end
						elseif v.stage == "release" then
							envRate = (p.release or 0) > 0 and FLOOR_DB / p.release / 8.686 or math.huge
						end
					end
					local sTaus = track and sampleTaus(a) or nil
					local sp = p.speed or 1
					-- modes (Instruments modesFit): the harmonics they replace play from the frames until the modes take over
					local modes = a.modes and blockB and #a.modes <= self.modeSlots and debugHost:GetAttribute("NoModes") ~= true and a.modes or nil
					local fund0 = freq * (a.fundamental or 1)
					local tauNow = blockB and (blockB + 1 - (v.blk0 or blockB + 1)) * blockDur or 0 -- real seconds since the note's first block
					local function switchTau(k)
						-- real time of the first block boundary at or after the modes' start (sample time a.modeK[k])
						return math.ceil(a.modeK[k] / (blockDur * sp) - 1e-9) * blockDur
					end
					for i = 1, sineSlots do
						local k = partials[i]
						local modeK = modes and k and a.modeK[k]
						if modeK and tauNow >= switchTau(k) then
							k = nil -- the modes play this harmonic now
						end
						-- on/off with hysteresis: a part hovering at the floor would drop out and come back every few
						-- frames (a shuffling texture on single tones); once on it stays on down to 0.3x
						local lim = son[i] and 0.3 or 1
						if k and (amps[i] or 0) > floorAmp * lim and g * amps[i] > PART_FLOOR * lim then
							son[i] = true
							local f = fund * k
							local fold = a.imageFrom and i >= a.imageFrom and a.imageFoldHz
							if fold and f > fold then
								f = 2 * fold - f -- a playback image above the original's Nyquist folds back, as it did there
							end
							local startPh = (a.phases and a.phases[i]) or (a.phaseFrames and a.phaseFrames[1][i] and a.phaseFrames[1][i] % 1)
							local wave, vol, ph, fastMode = SINE, g * amps[i], startPh or (phaseSpread and partialPhase(k) or nil), a.exactCycle and "exact" or (a.voice == true)
							if modeK then
								-- start phase chosen so the frames' sine is in phase with the modes where they take over
								v.mph = v.mph or {}
								local mp = v.mph[i]
								if not mp then
									local tw = switchTau(k)
									local cr, ci = 0, 0
									for _, md in ipairs(modes) do
										if md.k == k then
											local amp = md.a * math.exp(md.l * sp * tw)
											local th = 2 * math.pi * (md.p + md.r * fund0 * tw)
											cr += amp * math.cos(th)
											ci += amp * math.sin(th)
										end
									end
									mp = (math.atan2(ci, cr) / (2 * math.pi) - f * (tw - tauNow)) % 1
									v.mph[i] = mp
								end
								ph = mp
							end
							if track and f < MAX_PARTIAL_HZ and f > 20 then
								local rate = envRate
								local sd = sTaus and sTaus[i]
								if sd and v.sampleTime >= sd.peak then
									rate += sp / sd.tau
								end
								wave, vol, ph = trackPart(v, i, f, vol, ph, rate, blockB, blockDur)
								fastMode = "exact"
							end
							if f < MAX_PARTIAL_HZ and f > 20 then
								pool:setVoice(v.slot + i - 1, wave, f, vol, v.channel + 1, ph, fastMode)
							else
								pool:setVoice(v.slot + i - 1, 0, 0, 0)
							end
						else
							son[i] = nil
							pool:setVoice(v.slot + i - 1, 0, 0, 0)
						end
					end
					-- the modes: one sine each at its own frequency, phase and decay
					local mBase = sineSlots + GROUP_COUNT
					for j = 1, self.modeSlots do
						local md = modes and modes[j]
						local key = mBase + j
						local slot = v.slot + key - 1
						local on = false
						if md and tauNow >= switchTau(md.k) then
							local f = md.r * fund0 -- (freq carries the bend)
							local amp = md.a * math.exp(md.l * (tauNow + 0.5 * blockDur) * sp)
							local lim = son[key] and 0.3 or 1
							if f > 20 and f < MAX_PARTIAL_HZ and amp > floorAmp * lim and g * amp > PART_FLOOR * lim then
								on = true
								son[key] = true
								local wave, vol, ph, fastMode = SINE, g * amp, (md.p + md.r * fund0 * tauNow) % 1, nil
								if track then
									wave, vol, ph = trackPart(v, key, f, vol, ph, envRate + math.max(0, -md.l) * sp, blockB, blockDur)
									fastMode = "exact"
								end
								pool:setVoice(slot, wave, f, vol, v.channel + 1, ph, fastMode)
							end
						end
						if not on then
							son[key] = nil
							pool:setVoice(slot, 0, 0, 0)
						end
					end
					-- rough sines: next to each harmonic of a voice sample, a narrow band of noise at the level of that harmonic's
					-- fast motion (WaveBank.RoughWave). Without it a voice built from steady sines sounds 8-bit.
					if self.roughSlots > 0 and (a.rough or v.ron) then
						local rr = a.rough and debugHost:GetAttribute("NoRough") ~= true and roughAmps(a, ampTime, v.ramps or {}) or nil
						if rr then
							v.ramps = rr ~= a.rough[#a.rough] and rr or v.ramps
						end
						-- the rough layer is a noise texture: its level need not follow the 10 ms frames. Each block's step
						-- in its level is a sideband pair 47 Hz either side of the harmonic (half of the sub-fundamental skirt
						-- of a high vocal note); a one-pole follower (RoughSmooth seconds) keeps the texture with smaller steps
						local rsm = tonumber(debugHost:GetAttribute("RoughSmooth")) or ROUGH_SMOOTH
						if rr and rsm > 0 and not prep then
							v.rsm = v.rsm or {}
							local al = 1 - math.exp(-math.clamp(dt, 1 / 240, 1 / 20) / rsm)
							local out = v.rsm
							for k = 1, #rr do
								local y = out[k]
								out[k] = y and (y + (rr[k] - y) * al) or rr[k]
							end
							for k = #out, #rr + 1, -1 do
								out[k] = nil
							end
							rr = out
						end
						local rg = v.level * p.atten * chGain / WaveBank.RoughRms * (tonumber(debugHost:GetAttribute("RoughGain")) or 1)
						v.ron = v.ron or {}
						for j = 1, self.roughSlots do
							local slot = v.slot + self.roughBase + j - 1
							local k = partials[j]
							local r = rr and rr[j] or 0
							local lim = v.ron[j] and 0.3 or 1
							local f = k and fund * k or 0
							if k and r > floorAmp * lim and rg * r > PART_FLOOR * lim and f > 20 and f < MAX_PARTIAL_HZ then
								-- a new partner starts somewhere random in the 3.9 s loop, so chops don't all repeat one pattern
								local ph = (not v.ron[j]) and math.random() * 3000 or nil
								v.ron[j] = true
								pool:setVoice(slot, WaveBank.RoughWave, f, rg * r, v.channel + 1, ph)
							elseif v.ron[j] then
								v.ron[j] = nil
								pool:setVoice(slot, 0, 0, 0)
							end
						end
						if not next(v.ron) then
							v.ron = nil
						end
					end
					end
					-- harmonic bundles: one player per higher octave of harmonics
					local base = v.level * p.atten * chGain / BUNDLE_AMP
					local r = WaveBank.bundleRange(fund)
					for gi = 1, GROUP_COUNT do
						local slot = v.slot + sineSlots + gi - 1
						local amp = 0
						local wasFine = v.fon and v.fon[gi]
						if v.fon then
							v.fon[gi] = nil -- set again below when the fine bundles are used this frame
						end
						if groups and r then
							for j = 1, #groups do
								if groups[j] == gi then
									amp = amps[P + j]
									break
								end
							end
						end
						-- pulse bundles (every harmonic of the group peaking together, once per period, in step with the
						-- sines) replace the older smeared bundles wherever a pulse file fits the note: the smeared ones buzz
						-- bundles get the same on/off hysteresis as the sines
						v.bon = v.bon or {}
						local blim = v.bon[gi] and 0.3 or 1
						local bOn = amp > floorAmp * blim and base * amp > PART_FLOOR * 4 * blim
						v.bon[gi] = bOn or nil
						local pr = (bOn and not noBundles and not noPulses and WaveBank.pulseRange) and WaveBank.pulseRange(gi, fund, v.prange and v.prange[gi]) or nil
						if pr then
							v.prange = v.prange or {}
							v.prange[gi] = pr
							local pc = WaveBank.pulseCoverage(gi, pr, fund)
							local rms = WaveBank.PulseRms[gi * 100 + pr]
							if pc > 0 and rms then
								pool:setVoice(slot, WaveBank.PulseWave0 + gi, fund, v.level * p.atten * chGain * amp * math.sqrt(pc) / (math.sqrt(2) * rms) * bundleGain, v.channel + 1, WaveBank.PulseClick, "exact")
							else
								pool:setVoice(slot, 0, 0, 0)
							end
						elseif bOn and not noBundles and self.stride > self.partials and WaveBank.fineReady(gi, r) then
							-- fine harmonic bundles (harmonics pack): this octave's level, shared among its narrower groups by the 1/k tilt
							pool:setVoice(slot, 0, 0, 0)
							v.fon = v.fon or {}
							v.fon[gi] = true
							for _, f in ipairs(WaveBank.FineOf[gi]) do
								local fslot = v.slot + self.partials + f - 1
								local share = WaveBank.fineShare(gi, f, r)
								if share > 0 then
									pool:setVoice(fslot, WaveBank.FineWave0 + f, fund, base * amp * math.sqrt(share) / WaveBank.fineGain(f, r) * bundleGain, v.channel + 1)
								else
									pool:setVoice(fslot, 0, 0, 0)
								end
							end
						elseif bOn and not noBundles then
							local cov = WaveBank.bundleCoverage(gi, r, fund)
							local gain = WaveBank.BundleGain[gi * 100 + r] or 1
							if cov > 0 then
								pool:setVoice(slot, WaveBank.BundleWave0 + gi, fund, base * amp * math.sqrt(cov) / gain * bundleGain, v.channel + 1)
							else
								pool:setVoice(slot, 0, 0, 0)
							end
						else
							pool:setVoice(slot, 0, 0, 0)
						end
						if wasFine and not (v.fon and v.fon[gi]) then
							for _, f in ipairs(WaveBank.FineOf[gi]) do
								pool:setVoice(v.slot + self.partials + f - 1, 0, 0, 0)
							end
						end
					end
					-- residual noise (attack clicks, breath): through the shared noise bands, key-shifted like
					-- a sample, with the voice's envelope
					local res = USE_RESIDUAL and not noResidual and not (a.voice and (debugHost:GetAttribute("CleanVoice") == true or debugHost:GetAttribute("NoVoiceNoise") == true)) and a.residual or nil
					if res then
						local fpos = loopTime(a, v.sampleTime + (blockHalf and blockHalf * (p.speed or 1) or 0)) / res.hop
						local fi = math.floor(fpos)
						local rframes = res.frames
						local r0 = rframes[math.min(fi + 1, #rframes)]
						local r1 = rframes[math.min(fi + 2, #rframes)]
						local frac = fpos - fi
						if fi + 2 > #rframes then
							local i2, f2 = wrapPos(a, fi, #rframes)
							if i2 then
								r1 = rframes[math.clamp(i2 + 1 + (f2 >= 0.5 and 1 or 0), 1, #rframes)]
								frac = math.min(frac, 1)
							end
						end
						local rScale, rLow = residualScale(a, res)
						local gn = v.level * p.atten * chGain * rScale
						if r0 and gn > 0 then
							local gl, gr = 1, 1
							if stereo then
								gl, gr = panGains(c.pan / 127)
							end
							local shift = 2 * math.log(p.speed or 1, 2)
							local cut = math.min((debugHost:GetAttribute("ResidualCut") or 8) * fund, debugHost:GetAttribute("ResidualCutMax") or RESIDUAL_CUT_MAX) / 1.19
							for d = 1, CHAIN_N do
								if CHAIN_FC[d] <= cut then
									continue
								end
								local sp = d - shift
								local i0 = math.floor(sp)
								local tt = sp - i0
								local l = 0
								if i0 >= 1 and i0 <= CHAIN_N then
									l += (r0[i0] + (r1[i0] - r0[i0]) * frac) * (1 - tt) * (i0 <= RESIDUAL_LOW_BINS and rLow or 1)
								end
								if i0 + 1 >= 1 and i0 + 1 <= CHAIN_N then
									l += (r0[i0 + 1] + (r1[i0 + 1] - r0[i0 + 1]) * frac) * tt * (i0 + 1 <= RESIDUAL_LOW_BINS and rLow or 1)
								end
								if l > 0 then
									l *= gn
									local band = CHAIN[d]
									levels[band] += (l * gl) ^ 2
									levelsR[band] += (l * gr) ^ 2
								end
							end
						end
					end
				end
			elseif alive then
				pool:setVoice(v.slot, p.wave, freq, v.level * p.gain * chGain, v.channel + 1)
			end
			if not alive then
				v.active = false
				self:_silenceVoice(v)
			end
		end
	end
	prep = nil
	pool = realPool
	if self.sf and self.clock - (self.sfSweepAt or 0) > 2 then
		self.sfSweepAt = self.clock
		self.sf:sweep()
	end
	local budget = self.maxPlayers
	diag(self, self.frameDt or dt, nreq, budget)
	if nreq <= budget then
		for i = 1, nreq do
			pool:setVoice(reqSlot[i], reqWave[i], reqFreq[i], reqVol[i], reqBus[i], reqPhase[i], reqFast[i])
		end
	else
		local slots = pool.slots
		for i = 1, nreq do
			local sl = slots[reqSlot[i]]
			reqPri[i] = (reqVol[i] < 0) and 1e9 or reqVol[i] * ((sl and sl.rec) and 1.5 or 1)
			reqOrder[i] = i
		end
		for i = nreq + 1, #reqOrder do
			reqOrder[i] = nil
		end
		table.sort(reqOrder, function(a, b)
			return reqPri[a] > reqPri[b]
		end)
		for r = 1, nreq do
			local i = reqOrder[r]
			if r <= budget then
				pool:setVoice(reqSlot[i], reqWave[i], reqFreq[i], reqVol[i], reqBus[i], reqPhase[i], reqFast[i])
			else
				pool:setVoice(reqSlot[i], 0, 0, 0)
			end
		end
		self.stats.dropped = (self.stats.dropped or 0) + (nreq - budget)
	end
	-- noise: synthesized kit hits and analysed percussion samples, summed per band
	local dc = self.channels[self.drumChannel or DEFAULT_DRUM_CHANNEL]
	local kitGain = ccCurve(dc.volume) * ccCurve(dc.expression) * master
	for i = #self.noiseHits, 1, -1 do
		local h = self.noiseHits[i]
		if h.fresh then
			h.fresh = nil
			h.age += blockHalf or 0 -- block-ahead: a hit starting on this block's boundary is drawn at its middle
		else
			h.age += dt
		end
		local keep = true
		local gl, gr = 1, 1
		if stereo then
			gl, gr = panGains(h.pan or 0.5)
		end
		if h.kit then
			local env = math.exp(-h.age * 5 / h.kit.decay) * h.gain * kitGain
			if env < SILENT then
				keep = false
			else
				for j, band in ipairs(h.kit.bands) do
					local l = h.kit.levels[j] * env
					levels[band] += (l * gl) ^ 2
					levelsR[band] += (l * gr) ^ 2
				end
			end
		else
			local s = h.sample
			local tau = h.age * s.speed
			local fpos = tau / s.hop
			local fi = math.floor(fpos)
			local frames = s.frames
			local env = 10 ^ (-(h.age * FLOOR_DB / s.decay) / 20) * h.gain
			if fi + 1 > #frames or env < SILENT then
				keep = false
			else
				local f0, f1 = frames[fi + 1], frames[fi + 2] or frames[fi + 1]
				local frac = fpos - fi
				for j, band in ipairs(s.bands) do
					local l = (f0[j] + (f1[j] - f0[j]) * frac) * env
					levels[band] += (l * gl) ^ 2
					levelsR[band] += (l * gr) ^ 2
				end
			end
		end
		if not keep then
			table.remove(self.noiseHits, i)
		end
	end
	for b = 1, #levels do
		pool:setBand(b, math.sqrt(levels[b]), math.sqrt(levelsR[b]))
	end
	pool:update(dt)
end

function MidiSynth:activeVoices()
	local n = 0
	for _, v in ipairs(self.voices) do
		if v.active then
			n += 1
		end
	end
	return n + #self.noiseHits
end

function MidiSynth:_dispatch(ev)
	local kind = ev.kind
	if kind == "noteOn" then
		self:noteOn(ev.channel, ev.a, ev.b)
	elseif kind == "noteOff" then
		self:noteOff(ev.channel, ev.a)
	elseif kind == "cc" then
		self:controlChange(ev.channel, ev.a, ev.b)
	elseif kind == "program" then
		self:programChange(ev.channel, ev.a)
	elseif kind == "pitchBend" then
		self:pitchBend(ev.channel, ev.a)
	end
end

function MidiSynth.findLoop(midi)
	local startTime, endTime = nil, nil
	for _, ev in ipairs(midi.events) do
		if ev.kind == "meta" and (ev.metaType == 6 or ev.metaType == 1 or ev.metaType == 7) then
			local t = string.lower(string.gsub(ev.data or "", "[%s_%-]", ""))
			if t == "loopstart" or t == "loop" or string.sub(t, 1, 9) == "loopstart" then
				startTime = startTime or ev.time
			elseif t == "loopend" or string.sub(t, 1, 7) == "loopend" then
				endTime = endTime or ev.time
			end
		elseif ev.kind == "cc" and ev.a == 111 then
			startTime = startTime or ev.time
		end
	end
	startTime = startTime or 0
	endTime = endTime or midi.duration
	if endTime <= startTime then
		startTime, endTime = 0, midi.duration
	end
	return startTime, endTime
end

local function firstEventAt(events, t)
	local lo, hi = 1, #events + 1
	while lo < hi do
		local mid = (lo + hi) // 2
		if events[mid].time < t then
			lo = mid + 1
		else
			hi = mid
		end
	end
	return lo
end

function MidiSynth:play(midi, options)
	if typeof(midi) == "buffer" or type(midi) == "string" then
		midi = Midi.decode(midi)
	end
	options = options or {}
	self:stop()
	self.midi = midi
	self.loop = options.Loop == true
	self.speed = options.Speed or 1
	self.loopStartTime, self.loopEndTime = MidiSynth.findLoop(midi)
	self.loopCount = 0
	self:seek(options.StartTime or 0)
	self:_connect()
end

-- Jump to a time (seconds): silences everything and rebuilds every channel's controller and
-- program state from the events before that time. Works while playing or paused.
function MidiSynth:seek(t)
	local midi = self.midi
	if not midi then
		return
	end
	t = math.clamp(t, 0, midi.duration)
	self:allNotesOff(nil, true)
	for c = 0, 15 do
		self.channels[c] = newChannel()
		self.pool:setBusPan(c + 1, 0.5)
	end
	local events = midi.events
	-- notes that began before t and are still held at t must sound too (seeking into the middle of a song
	-- keeps every sustained instrument playing)
	local open = {}
	do
		local i = 1
		while i <= #events and events[i].time < t do
			local ev = events[i]
			if ev.kind == "noteOn" and (ev.b or 0) > 0 then
				open[ev.channel * 128 + ev.a] = i
			elseif ev.kind == "noteOn" or ev.kind == "noteOff" then
				open[ev.channel * 128 + ev.a] = nil
			end
			i += 1
		end
	end
	local heldAt = {}
	for _, i in pairs(open) do
		heldAt[i] = true
	end
	local idx = 1
	while idx <= #events and events[idx].time < t do
		local ev = events[idx]
		if ev.kind ~= "noteOn" and ev.kind ~= "noteOff" then
			self:_dispatch(ev)
		elseif heldAt[idx] then
			self:noteOn(ev.channel, ev.a, ev.b)
		end
		idx += 1
	end
	self.eventIndex = idx
	self.preIndex = idx
	self.pre = {}
	self.time = t
	self.bsB = nil -- block-ahead: the next block starts the song clock again at its middle
end

function MidiSynth:getTime()
	return self.warmT0 or self.time or 0
end

function MidiSynth:getDuration()
	return self.midi and self.midi.duration or 0
end

function MidiSynth:pause()
	self._token = (self._token or 0) + 1
	self.warming, self.warmT0, self.warmGain, self.pool.trackFresh = false, nil, nil, false
	if self.conn then
		self.conn:Disconnect()
		self.conn = nil
	end
	self.paused = true
	self.playing = false
	self:allNotesOff(nil, true)
	self.pool:silence()
	self.pool:update(1)
	self.pool:stopAll()
	if self.sf then
		self.sf:stopAll()
	end
end

function MidiSynth:resume()
	if self.midi and not self.conn and not self.warming then
		self:_connect()
	end
end

-- Start-up warm-up. A cold AudioPlayer is silent for a moment, so the first seconds of a song lost the
-- attacks of whatever notes started on players created on the spot. Before the clock starts, the first
-- PREROLL seconds of music are played through the real sequencer at -60 dB (a few steps per frame, so there
-- is no hitch), which creates and starts exactly the players those notes need; then everything is put back
-- to the start position and the song waits until every fresh player is really producing samples.
local PREROLL, PREROLL_STEP, PREROLL_PER_FRAME, WARM_GAIN = 1.0, 1 / 20, 1, 1e-3 -- one step per frame: its player starts spread out

function MidiSynth:_preroll(step, token)
	local pool = self.pool
	local t0, loops = self.time, self.loopCount
	self.warmT0 = t0
	self.warmGain = WARM_GAIN
	pool.trackFresh = true
	pool.warmReserve, pool.idleStop = 256, 4 -- keep everything the warm-up starts running until the song is under way
	for k = 1, math.floor(PREROLL / PREROLL_STEP + 0.5) do
		step(PREROLL_STEP / self.speed)
		if k % PREROLL_PER_FRAME == 0 then
			task.wait()
			if self._token ~= token then
				return
			end
		end
	end
	self.warmGain = nil
	self:seek(t0)
	self.loopCount = loops
	pool:update(0.25)
	pool:update(0.05)
	local waited = 0
	while not pool:ready() and waited < 1.0 do
		waited += task.wait()
		if self._token ~= token then
			return
		end
	end
end

function MidiSynth:_connect()
	self.paused = false
	self.playing = true
	-- live playback: at most a few player starts per frame (a burst of starts freezes the frame, see OscillatorPool)
	self.pool.startBudget = OscillatorPool.START_BUDGET
	self.pool:warm()
	local frame, step = self:_build()
	self._token = (self._token or 0) + 1
	local token = self._token
	if self.prewarm == false then
		self.conn = RunService.Heartbeat:Connect(frame)
		return
	end
	self.warming = true
	task.spawn(function()
		local ok, err = pcall(self._preroll, self, step, token)
		if self._token ~= token then
			return
		end
		self.warming, self.warmT0, self.warmGain, self.pool.trackFresh = false, nil, nil, false
		self.warmTrimAt = self.clock + 3
		if not ok then
			warn("MidiSynth warm-up failed: " .. tostring(err))
		end
		if self.playing and not self.conn then
			self.conn = RunService.Heartbeat:Connect(frame)
		end
	end)
end

function MidiSynth:_build()
	local midi = self.midi
	local events = midi.events
	local step = function(dt)
		self.time += dt * self.speed
		if self.loop and self.time >= self.loopEndTime then
			while self.eventIndex <= #events do
				local ev = events[self.eventIndex]
				if ev.time > self.loopEndTime or (ev.time == self.loopEndTime and ev.kind == "noteOn") then
					break
				end
				self:_dispatch(ev)
				self.eventIndex += 1
			end
			self:allNotesOff(nil, false)
			self.time = self.loopStartTime + (self.time - self.loopEndTime)
			self.eventIndex = firstEventAt(events, self.loopStartTime)
			self.preIndex = self.eventIndex
			self.pre = {}
			self.loopCount += 1
		end
		local pre = self.pre
		while self.eventIndex <= #events and events[self.eventIndex].time <= self.time do
			local idx = self.eventIndex
			if not pre[idx] then
				self:_dispatch(events[idx])
			end
			pre[idx] = nil
			self.eventIndex += 1
		end
		-- lookahead: note-ons in the next LOOKAHEAD seconds start their players now (silently), so every
		-- part is running and in phase when the note is due. A channel with a program/controller change
		-- before its note in that window is left to normal dispatch.
		local look = self.time + LOOKAHEAD
		if self.loop then
			look = math.min(look, self.loopEndTime)
		end
		local pi = math.max(self.preIndex or 1, self.eventIndex)
		local blocked = nil
		while pi <= #events and events[pi].time <= look do
			local ev = events[pi]
			if ev.kind == "noteOn" and (ev.b or 0) > 0 then
				if not (blocked and blocked[ev.channel]) and not pre[pi] then
					pre[pi] = true
					self:noteOn(ev.channel, ev.a, ev.b, ev.time - self.time)
				end
			elseif ev.kind ~= "noteOff" and ev.kind ~= "meta" then
				blocked = blocked or {}
				blocked[ev.channel or -1] = true
			end
			pi += 1
		end
		self.preIndex = pi
		self:update(dt * self.speed)
		if not self.warmGain and not self.loop and self.eventIndex > #events and self.time >= midi.duration and self:activeVoices() == 0 then
			self:stop()
			self._ended:Fire()
		end
	end
	-- Block-ahead mode (attribute BlockAhead = true on the AudioLab folder; read every frame, so it can be flipped while a
	-- song plays). The engine reads each player's speed and volume once per audio block (1024 samples, ~21 ms) and a write
	-- lands on the next block boundary. Per frame, the synth renders "now" ~5 times per block and only the last render
	-- before the boundary counts, so a note starts up to a whole block (plus frame jitter) after its time. Here the synth
	-- renders once per block, as soon as a block starts, for the block after it: the song clock stands at the middle of
	-- that block, so every note starts on the boundary nearest its time, every level is the block's own, and the frames
	-- in between only start players that were held back by the start budget.
	self.bsB = nil
	local function frame(dt)
		local pool = self.pool
		if debugHost:GetAttribute("BlockAhead") ~= true then
			self.bsB, self.blockHalf, self.frameDt = nil, nil, nil
			pool.pendingStart, pool.pendingMake = nil, nil
			step(dt)
			return
		end
		local B, blk = self:_blockClock()
		local last = self.bsB
		if last == B then
			self.pool:startPending()
			return
		end
		self.bsB = B
		self.blockHalf = 0.5 * blk * self.speed
		self.frameDt = dt
		pool.pendingStart, pool.pendingMake = nil, nil
		if last == nil then
			step(0.5 * blk) -- first block: the song clock moves to its middle
		else
			step((B - last) * blk) -- the blocks that passed (after a stall the song catches up)
		end
	end
	return frame, step
end

function MidiSynth:stop()
	self._token = (self._token or 0) + 1
	self.warming, self.warmT0, self.warmGain, self.pool.trackFresh = false, nil, nil, false
	if self.conn then
		self.conn:Disconnect()
		self.conn = nil
	end
	if self.playing then
		self.playing = false
		self:allNotesOff(nil, true)
		self.pool:silence()
		self.pool:update(1)
		self.pool:stopAll()
		if self.sf then
			self.sf:stopAll()
		end
	end
end

function MidiSynth:destroy(gradual)
	if gradual then
		-- the pool is detached (silent) and freed bit by bit: no need to stop every player first
		self._token = (self._token or 0) + 1
		self.warming, self.warmT0, self.warmGain = false, nil, nil
		if self.conn then
			self.conn:Disconnect()
			self.conn = nil
		end
		self.playing = false
	else
		self:stop()
	end
	if self.sf then
		self.sf:destroy()
		self.sf = nil
	end
	self.pool:destroy(gradual)
	self._ended:Destroy()
end

return MidiSynth
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">Attach</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[-- Audio attached to instances, with a registry so any script can find it.
--
--   local h = Attach.attach(part, {
--       Midi = "MySong/music.mid", SoundFont = "MySong/instruments.sf2",   -- MIDI + instruments
--       -- or Clip = "sfx/splash" / File = "sfx/splash.wav"
--       Loop = true, Volume = 0.5, AutoPlay = true,
--       Spatial = true,    -- default for BaseParts, Attachments and Models: plays from an AudioEmitter
--       Range = 40,        -- spatial: full volume out to this many studs, half at twice it, silent at 6 x
--                          -- (default: Roblox's own falloff; or the instance's AudioLabRange attribute)
--   })
--   Attach.get(part) -> handle (or nil);  Attach.detach(part)
--   h:play(), h:stop(), h:setVolume(v), h:isPlaying(), h:destroy(); h.Ended; h.output (AudioFader)
--
--   Server-driven playback: an instance with AudioLabSynced = true follows the server's playhead (see AudioLab.Sync;
--   the server calls Sync.play(part, {...}), clients play locally and stay in sync, late joiners included).
--   The player's own music comes first: while it plays (SoundService attribute AudioLabLocalMusic = true, set by
--   Tools.Library), synced world audio (TVs, speakers; not the player's own channels) is silent on this client and picks
--   up again at the server's playhead when the music pauses or stops. AudioLab attribute LocalMusicFirst = false turns
--   that off.
--   Attach.bindTag("AudioLab")  -- attach every instance tagged "AudioLab" from its attributes:
--       AudioLabMidi, AudioLabSoundFont, AudioLabClip, AudioLabFile (strings), AudioLabLoop,
--       AudioLabAutoPlay, AudioLabSpatial (booleans), AudioLabVolume (number), AudioLabMode ("additive"/"wave")
--
-- Run on the client (LocalScript): the audio plays where it is created. Spatial output needs an
-- AudioListener; with SoundService.DefaultListenerLocation = Camera Roblox provides one in play mode.
-- Handles are removed automatically when their instance is destroyed. Coroutines/task threads share
-- this registry; Actors each have their own (call attach from the synchronized phase).

local CollectionService = game:GetService("CollectionService")
local AudioLab = script:FindFirstAncestor("AudioLab")
local Assets = require(AudioLab.Tools.Assets)
local MidiSynth = require(AudioLab.Synth.MidiSynth)
local Player = require(AudioLab.Synth.Player)
local Sync = require(AudioLab.Sync)

local Attach = {}
local handles = setmetatable({}, { __mode = "k" })
local loopLength -- (below) a synced clip's loop length from its instance, or nil

local Handle = {}
Handle.__index = Handle

local function spatialTarget(instance)
	if instance:IsA("BasePart") or instance:IsA("Attachment") then
		return instance
	end
	if instance:IsA("Model") then
		return instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

function Attach.attach(instance, options)
	assert(typeof(instance) == "Instance", "Attach.attach expects an Instance")
	options = options or {}
	Attach.detach(instance)
	local h = setmetatable({ instance = instance, options = options }, Handle)
	local target = (options.Spatial ~= false) and spatialTarget(instance) or nil
	local folder = Instance.new("Folder")
	folder.Name = "AudioLab"
	folder.Parent = instance
	h.folder = folder
	if options.Midi then
		local instruments = options.SoundFont and Assets.instruments(options.SoundFont) or {}
		h.kind = "midi"
		h.midi = Assets.midi(options.Midi)
		h.player = MidiSynth.new({
			Parent = folder, Voices = options.Voices, MasterGain = options.Volume or 0.5,
			Bank = instruments.Bank, SoundFont = instruments.SoundFont, Mode = options.Mode,
			Partials = options.Partials, DrumChannel = options.DrumChannel, DeviceOutput = target == nil,
		})
	elseif options.Clip or options.File then
		h.kind = "clip"
		h.player = Player.new(Assets.clip(options.Clip or options.File), {
			Parent = folder, MasterGain = options.Volume or 1, DeviceOutput = target == nil,
		})
	else
		folder:Destroy()
		error("Attach.attach needs Midi, Clip or File")
	end
	h.output = h.player.pool.output
	h.Ended = h.player.Ended
	if target then
		local emitter = Instance.new("AudioEmitter")
		emitter.Name = "AudioLabEmitter"
		emitter.Parent = target
		local wire = Instance.new("Wire")
		wire.Name = "ToEmitter"
		wire.SourceInstance = h.output
		wire.TargetInstance = emitter
		wire.Parent = folder
		h.emitter = emitter
		local range = options.Range or instance:GetAttribute("AudioLabRange")
		if type(range) == "number" and range > 0 then
			pcall(emitter.SetDistanceAttenuation, emitter, { [0] = 1, [range] = 1, [range * 2] = 0.5, [range * 6] = 0 })
		end
	end
	handles[instance] = h
	h._destroying = instance.Destroying:Connect(function()
		h:destroy()
	end)
	if options.AutoPlay ~= false then
		h:play()
	end
	return h
end

function Attach.get(instance)
	return handles[instance]
end

function Attach.detach(instance)
	local h = handles[instance]
	if h then
		h:destroy()
	end
end

function Attach.all()
	local list = {}
	for _, h in pairs(handles) do
		table.insert(list, h)
	end
	return list
end

function Handle:play(options)
	options = options or {}
	local loop = options.Loop
	if loop == nil then
		loop = self.options.Loop == true
	end
	if self.kind == "midi" then
		self.player:play(self.midi, { Loop = loop, Speed = options.Speed, StartTime = options.StartTime })
	else
		self.player:play({ Loop = loop, Speed = options.Speed, StartTime = options.StartTime, LoopLength = loopLength(self) })
	end
end

function Handle:stop()
	self.player:stop()
end

function Handle:isPlaying()
	return self.player.playing == true
end

function Handle:setVolume(v)
	if self.kind == "midi" then
		self.player.masterGain = v
	else
		self.player.pool:setMasterGain(v)
	end
end

function Handle:destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	if self._destroying then
		self._destroying:Disconnect()
	end
	if self._yieldConn then
		self._yieldConn:Disconnect()
	end
	pcall(function()
		self.player:destroy(true) -- players are freed a few per frame (no hitch)
	end)
	if self.emitter then
		self.emitter:Destroy()
	end
	if self.folder then
		self.folder:Destroy()
	end
	if handles[self.instance] == self then
		handles[self.instance] = nil
	end
end

-- Keeps a handle on the server's playhead (attributes written by AudioLab.Sync). Checked on every state change and twice a
-- second: starts late joiners in the right place, follows pause / seek / speed, and re-seeks when a client has drifted.
function loopLength(h)
	local v = h.instance and h.instance:GetAttribute("AudioLabLoopLength")
	return (type(v) == "number" and v > 0) and v or nil
end
local function syncInfo(h)
	if not h._syncInfo then
		if h.kind == "midi" then
			local ls, le = MidiSynth.findLoop(h.midi)
			h._syncInfo = { duration = h.midi.duration, loopStart = ls, loopEnd = le }
		else
			local d = h.player:getDuration()
			h._syncInfo = { duration = d, loopStart = 0, loopEnd = d }
		end
	end
	h._syncInfo.loop = h.options.Loop == true
	-- a clip with a loop length (AudioLab.Sync LoopLength: a video's sound) loops on that instead of its own length
	if h.kind ~= "midi" then
		local len = loopLength(h)
		h._syncInfo.duration = len or h.player:getDuration()
		h._syncInfo.loopEnd = h._syncInfo.duration
	end
	return h._syncInfo
end

function Attach.startSync(h)
	if not h then
		return
	end
	local instance = h.instance
	local token = {}
	h._sync = token
	local appliedSeq = nil
	local SoundService = game:GetService("SoundService")
	-- world audio steps aside while this player's own music plays (it gets the players and the attention)
	local function yielded()
		return instance:GetAttribute("AudioLabChannel") == nil and SoundService:GetAttribute("AudioLabLocalMusic") == true
			and AudioLab:GetAttribute("LocalMusicFirst") ~= false
	end
	local function reconcile()
		if h.destroyed or h._sync ~= token then
			return
		end
		local st = Sync.state(instance)
		if not st then
			return
		end
		if yielded() then
			appliedSeq = nil -- back on the server's playhead when the music stops
			if h:isPlaying() then
				h:stop()
			end
			return
		end
		if st.state ~= "playing" then
			appliedSeq = nil
			if h:isPlaying() then
				h:stop()
			end
			return
		end
		local info = syncInfo(h)
		local lead = instance:GetAttribute("AudioLabSyncLead") or Sync.Lead
		local target, finished = Sync.target(st, workspace:GetServerTimeNow() + lead, info)
		if finished then
			appliedSeq = st.seq
			if h:isPlaying() then
				h:stop()
			end
			return
		end
		if target < 0 then -- a delayed start that has not begun: wait for it
			appliedSeq = nil
			if h:isPlaying() then
				h:stop()
			end
			task.delay(-target / math.max(st.speed, 0.01), reconcile)
			return
		end
		if appliedSeq ~= st.seq then
			appliedSeq = st.seq
			h:play({ Loop = info.loop, Speed = st.speed, StartTime = target })
			return
		end
		if not h:isPlaying() then
			return -- a one-shot that ended
		end
		local drift = h.player:getTime() - target
		if info.loop and info.loopEnd > info.loopStart then
			local len = info.loopEnd - info.loopStart
			drift = (drift + len / 2) % len - len / 2
		end
		if math.abs(drift) > Sync.Tolerance then
			h.player:seek(target)
		end
	end
	h._reconcile = reconcile
	if h._yieldConn then
		h._yieldConn:Disconnect()
	end
	h._yieldConn = SoundService:GetAttributeChangedSignal("AudioLabLocalMusic"):Connect(function()
		task.defer(reconcile)
	end)
	local isChannel = instance:GetAttribute("AudioLabChannel") ~= nil
	local lastReport = 0
	task.spawn(function()
		while not h.destroyed and h._sync == token do
			reconcile()
			if isChannel and os.clock() - lastReport >= 2 then -- the server learns what this player is really playing
				lastReport = os.clock()
				pcall(Sync.report, instance, h:isPlaying(), h.player:getTime())
			end
			task.wait(0.5)
		end
	end)
end

local ATTRS = { "AudioLabSynced", "AudioLabMidi", "AudioLabSoundFont", "AudioLabClip", "AudioLabFile", "AudioLabLoop",
	"AudioLabAutoPlay", "AudioLabSpatial", "AudioLabVolume", "AudioLabMode" }

local function optionsFromAttributes(instance)
	return {
		Midi = instance:GetAttribute("AudioLabMidi"), SoundFont = instance:GetAttribute("AudioLabSoundFont"),
		Clip = instance:GetAttribute("AudioLabClip"), File = instance:GetAttribute("AudioLabFile"),
		Loop = instance:GetAttribute("AudioLabLoop") == true,
		AutoPlay = (not instance:GetAttribute("AudioLabSynced")) and instance:GetAttribute("AudioLabAutoPlay") or false,
		Spatial = instance:GetAttribute("AudioLabSpatial"), Volume = instance:GetAttribute("AudioLabVolume"),
		Mode = instance:GetAttribute("AudioLabMode"),
	}
end

function Attach.bindTag(tag)
	tag = tag or "AudioLab"
	local conns = {}
	local attrConns = {}
	local bindGen = setmetatable({}, { __mode = "k" })
	local function bind(instance)
		-- a clip that has to be downloaded first (a video import's sound) loads before anything is replaced; if the
		-- attributes changed meanwhile, the newer bind does the work
		local gen = (bindGen[instance] or 0) + 1
		bindGen[instance] = gen
		local clip = instance:GetAttribute("AudioLabClip") or instance:GetAttribute("AudioLabFile")
		if type(clip) == "string" and not instance:GetAttribute("AudioLabMidi") then
			pcall(Assets.clip, clip)
			if bindGen[instance] ~= gen or not instance.Parent then
				return
			end
		end
		local ok, err = pcall(Attach.attach, instance, optionsFromAttributes(instance))
		if not ok then
			warn(("[AudioLab] %s: %s"):format(instance:GetFullName(), tostring(err)))
		elseif instance:GetAttribute("AudioLabSynced") then
			Attach.startSync(Attach.get(instance))
		end
		if not attrConns[instance] then
			local list = {}
			for _, a in ipairs(ATTRS) do
				table.insert(list, instance:GetAttributeChangedSignal(a):Connect(function()
					local h = Attach.get(instance)
					if a == "AudioLabVolume" and h and not h.destroyed then
						h:setVolume(instance:GetAttribute("AudioLabVolume") or (h.kind == "midi" and 0.5 or 1)) -- no restart
					else
						task.defer(bind, instance)
					end
				end))
			end
			table.insert(list, instance:GetAttributeChangedSignal("AudioLabSeq"):Connect(function()
				local h = Attach.get(instance)
				if h and h._reconcile then
					task.defer(h._reconcile)
				end
			end))
			attrConns[instance] = list
		end
	end
	local function unbind(instance)
		Attach.detach(instance)
		for _, c in ipairs(attrConns[instance] or {}) do
			c:Disconnect()
		end
		attrConns[instance] = nil
	end
	for _, inst in ipairs(CollectionService:GetTagged(tag)) do
		task.spawn(bind, inst)
	end
	table.insert(conns, CollectionService:GetInstanceAddedSignal(tag):Connect(bind))
	table.insert(conns, CollectionService:GetInstanceRemovedSignal(tag):Connect(unbind))
	return {
		Disconnect = function()
			for _, c in ipairs(conns) do
				c:Disconnect()
			end
			for inst in pairs(attrConns) do
				unbind(inst)
			end
		end,
	}
end

return Attach
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">Tracks</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[-- Tracks: manager for everything that plays through AudioLab (MIDI + SoundFont songs, WAV/AIFF/MP3 clips).
-- Reached through the main module: AudioLab.play, AudioLab.getAllPlayingTracks, AudioLab.crossfade, ...
--
-- Tracks
--   local track = AudioLab.play(path, options)   -- starts it and returns a handle
--       path: a Library id ("MySong/music.mid", "clip:imports/MyClip"), a file in Data/Files
--             (.mid + SoundFont, .wav/.aif/.mp3), a clip in Data/Clips, or an entry of Library.list()
--       options: Loop (default false), Volume (1), FadeIn (seconds), StartTime, SoundFont (path of an .sf2),
--                Name, Group (any string), AutoDelete (default true: a track that reaches its end is deleted),
--                Parent, Paused (create it paused: call track:play() later)
--   AudioLab.getAllPlayingTracks() -> { track, ... }   -- playing right now (not paused, stopped, pending)
--   AudioLab.getAllTracks() -> { track, ... }          -- every track that has not been deleted
--   AudioLab.getTrack(id), AudioLab.getTracksInGroup(group)
--   AudioLab.pause(target?), resume(target?), stop(target?), delete(target?)   -- target: a track, an id, a list of
--       either, or nothing for every track. stop() keeps the track (play it again with track:play());
--       delete() stops it and frees its players. AudioLab.pauseAll / resumeAll / stopAll / deleteAll are the same.
--   AudioLab.fadeOut(target?, seconds, then?)           -- then: "stop" (default), "pause", "delete"
--   AudioLab.setLoop(target?, on)                       -- loop on / off for tracks that are already playing
--   AudioLab.setMasterVolume(v, fadeSeconds?), AudioLab.getMasterVolume()
--
--   track:play(startTime?, fadeIn?), :pause(), :resume(), :stop(), :delete() (also :destroy()),
--   track:seek(t), :getTime(), :getDuration(), :isPlaying(), :isPaused(), :getState(),
--   track:setLoop(on), :getLoop(), :setVolume(v, fadeSeconds?), :getVolume(), :fadeTo(v, seconds, onDone?),
--   track:fadeIn(seconds), :fadeOut(seconds, then?, onDone?), :getInfo(),
--   MIDI tracks also: :setMute(ch, on), :setSolo(ch, on), :channels(), :activity(ch)
--   track.Ended (fires when it reaches its end), track.id, track.name, track.kind ("midi" | "clip"), track.group
--   states: "pending" (waiting for a switch), "playing", "paused", "stopped", "ended", "deleted"
--
-- Transitions
--   AudioLab.crossfade(path, { Duration = 2, From = track?, Keep = false, ...play options })
--       the tracks that are playing (or From) fade out and are deleted (Keep: stopped) while the new one fades in
--   AudioLab.switch(path, { FadeOut = 0.5, FadeIn = 0.25, ... })    -- fade the current tracks out, then start the new one
--
-- Playlist (one at a time)
--   AudioLab.setPlaylist({ path, ... }, { Repeat = "all" | "one" | "off", Shuffle = false, Crossfade = 0,
--                                         StartIndex = 1, Play = true, Volume = 1 })
--   AudioLab.queue(path), AudioLab.next(opts?), AudioLab.previous(opts?), AudioLab.jump(indexOrPath, opts?)
--   AudioLab.setRepeat(mode), AudioLab.setShuffle(on), AudioLab.setCrossfade(seconds)
--   AudioLab.getPlaylist() -> { items, index, repeat, shuffle, crossfade, current }, AudioLab.getCurrentTrack()
--   AudioLab.stopPlaylist(fadeSeconds?), AudioLab.clearPlaylist()
--   With Crossfade > 0 the next song starts that many seconds before the current one ends; with 0 it follows it.
--
-- Events: AudioLab.TrackAdded(track), TrackStateChanged(track, new, old), TrackEnded(track), TrackRemoved(track),
--         PlaylistChanged(track)

local RunService = game:GetService("RunService")
local AudioLab = script:FindFirstAncestor("AudioLab")

local Tracks = {}
local Track = {}
Track.__index = Track

local registry = {} -- id -> track
local list = {} -- tracks, oldest first
local nextId = 0
local master = 1
local masterFade = nil
local connection = nil
local autoUpdate = true

local function newEvent()
	local e = Instance.new("BindableEvent")
	return e
end
local evAdded, evState, evEnded, evRemoved, evPlaylist = newEvent(), newEvent(), newEvent(), newEvent(), newEvent()
Tracks.TrackAdded = evAdded.Event
Tracks.TrackStateChanged = evState.Event
Tracks.TrackEnded = evEnded.Event
Tracks.TrackRemoved = evRemoved.Event
Tracks.PlaylistChanged = evPlaylist.Event

local playlist = {
	items = {}, -- { path, options }
	order = {}, -- play order: indices into items
	pos = 0, -- position in order of the current item
	current = nil,
	repeatMode = "all",
	shuffle = false,
	crossfade = 0,
	volume = 1,
}

-- fade curves: rising 0 -> 1 over p in 0..1. "power" keeps the summed power of a crossfade constant.
local function rise(kind, p)
	p = math.clamp(p, 0, 1)
	if kind == "linear" then
		return p
	elseif kind == "power" then
		return math.sin(p * math.pi / 2)
	end
	return p * p * (3 - 2 * p)
end

local function fadeValue(f, p)
	if f.to >= f.from then
		return f.from + (f.to - f.from) * rise(f.curve, p)
	end
	return f.to + (f.from - f.to) * rise(f.curve, 1 - p)
end

-- Opening ----------------------------------------------------------------------------------

local function resolve(path, options)
	local Library = require(AudioLab.Tools.Library)
	if type(path) == "table" then
		return path
	end
	for _, t in ipairs(Library.list()) do
		if t.id == path or t.title == path or t.midi == path or t.clip == path or t.id == "clip:" .. path then
			local entry = table.clone(t)
			if options.SoundFont and entry.kind == "midi" then
				entry.soundFont = options.SoundFont
			end
			return entry
		end
	end
	local ext = string.lower(string.match(path, "%.(%w+)$") or "")
	if ext == "mid" or ext == "midi" then
		local soundFont = options.SoundFont
		if not soundFont then
			local folder = string.match(path, "^(.*)/[^/]+$") or ""
			for _, f in ipairs(require(AudioLab.Tools.Importer).list()) do
				if string.lower(string.match(f, "%.(%w+)$") or "") == "sf2" and (string.match(f, "^(.*)/[^/]+$") or "") == folder then
					soundFont = f
					break
				end
			end
		end
		return { id = path, kind = "midi", midi = path, soundFont = soundFont, title = path }
	elseif ext == "" or ext == "wav" or ext == "aif" or ext == "aiff" or ext == "aifc" or ext == "mp3" or ext == "flac" or ext == "ogg" or ext == "oga" then
		return { id = path, kind = "clip", clip = path, title = path }
	end
	error("AudioLab: unsupported track type ." .. ext .. " (" .. tostring(path) .. ")")
end

-- returns a Library controller and the resolved entry (replaceable for tests: Tracks._open)
function Tracks._open(path, options, gain)
	local entry = resolve(path, options)
	local controller = require(AudioLab.Tools.Library).open(entry, {
		Parent = options.Parent, Volume = gain, Loop = options.Loop == true,
	})
	return controller, entry
end

-- Update loop --------------------------------------------------------------------------------

local function ensureConnection()
	if autoUpdate and not connection then
		connection = RunService.Heartbeat:Connect(function(dt)
			Tracks.update(dt)
		end)
	end
end

function Tracks.setAutoUpdate(on)
	autoUpdate = on
	if not on and connection then
		connection:Disconnect()
		connection = nil
	elseif on and (#list > 0 or masterFade or playlist.current) then
		ensureConnection()
	end
end

function Track:_gain()
	return self.volume * self.fadeGain * master
end

function Track:_applyVolume(force)
	local g = self:_gain()
	if force or g ~= self._applied then
		self._applied = g
		self.controller:setVolume(g)
	end
end

function Track:_setState(state)
	local old = self.state
	if old == state then
		return
	end
	self.state = state
	evState:Fire(self, state, old)
end

function Track:_finishFade(f)
	self.fadeGain = f.to
	self._fade = nil
	self:_applyVolume()
	if f.to == 0 then
		self.fadingOut = false
		local action = f.thenDo
		if action == "delete" then
			self:delete()
		elseif action == "stop" then
			self:stop()
		elseif action == "pause" then
			self:pause()
		end
	end
	if f.onDone then
		f.onDone(self)
	end
end

-- Tracks ---------------------------------------------------------------------------------------

function Tracks.create(path, options)
	options = options or {}
	nextId += 1
	local track = setmetatable({
		id = nextId,
		path = path,
		volume = options.Volume or options.MasterGain or 1,
		fadeGain = 1,
		loop = options.Loop == true,
		autoDelete = options.AutoDelete ~= false,
		group = options.Group,
		state = "stopped",
		fadingOut = false,
	}, Track)
	track.fadeGain = (options.FadeIn and options.FadeIn > 0) and 0 or 1
	local controller, entry = Tracks._open(path, options, track:_gain())
	track.controller = controller
	track.entry = entry
	track.kind = entry.kind
	track.name = options.Name or entry.title or tostring(path)
	track._applied = track:_gain()
	track._endedEvent = newEvent()
	track.Ended = track._endedEvent.Event
	track._endConn = controller.Ended:Connect(function()
		Tracks._onEnded(track)
	end)
	registry[track.id] = track
	table.insert(list, track)
	evAdded:Fire(track)
	ensureConnection()
	return track
end

function Tracks.play(path, options)
	options = options or {}
	local track = Tracks.create(path, options)
	if options.Paused then
		return track
	end
	track:play(options.StartTime, options.FadeIn)
	return track
end

function Track:play(startTime, fadeIn)
	assert(self.state ~= "deleted", "AudioLab: the track was deleted")
	if fadeIn and fadeIn > 0 then
		self.fadeGain = 0
		self._fade = { from = 0, to = 1, elapsed = 0, dur = fadeIn, curve = "power" }
		self.fadingOut = false
	elseif not self._fade then
		self.fadeGain = 1
		self.fadingOut = false
	end
	self._advanced = nil
	self:_applyVolume(true)
	self.controller:setLoop(self.loop)
	self.controller:play(startTime or 0)
	self:_setState("playing")
	ensureConnection()
end

function Track:pause()
	if self.state == "playing" then
		self.controller:pause()
		self:_setState("paused")
	end
end

function Track:resume()
	if self.state == "paused" then
		self.controller:resume()
		self:_setState("playing")
		if self.fadeGain == 0 and not self._fade then
			self:fadeIn(0.25)
		end
	elseif self.state == "stopped" or self.state == "ended" then
		self:play(0)
	end
end

function Track:stop()
	if self.state == "deleted" or self.state == "stopped" then
		return
	end
	self._fade, self._vfade = nil, nil
	self.fadingOut = false
	self.fadeGain = 1
	self.controller:stop()
	self:_applyVolume()
	self:_setState("stopped")
end

function Track:delete()
	if self.state == "deleted" then
		return
	end
	self._fade, self._vfade = nil, nil
	if self._endConn then
		self._endConn:Disconnect()
		self._endConn = nil
	end
	pcall(function()
		self.controller:destroy(true) -- players are freed a few milliseconds per frame (no hitch)
	end)
	registry[self.id] = nil
	local i = table.find(list, self)
	if i then
		table.remove(list, i)
	end
	self:_setState("deleted")
	evRemoved:Fire(self)
	self._endedEvent:Destroy()
end
Track.destroy = Track.delete

function Track:seek(t)
	self.controller:seek(t)
end

function Track:getTime()
	return self.controller:getTime()
end

function Track:getDuration()
	return self.controller:getDuration()
end

function Track:getState()
	return self.state
end

function Track:isPlaying()
	return self.state == "playing"
end

function Track:isPaused()
	return self.state == "paused"
end

function Track:setLoop(on)
	self.loop = on == true
	self.controller:setLoop(self.loop)
end

function Track:getLoop()
	return self.loop
end

function Track:setVolume(v, fadeSeconds)
	if fadeSeconds and fadeSeconds > 0 then
		self._vfade = { from = self.volume, to = v, elapsed = 0, dur = fadeSeconds, curve = "smooth" }
	else
		self._vfade = nil
		self.volume = v
		self:_applyVolume()
	end
end

function Track:getVolume()
	return self.volume
end

function Track:fadeTo(v, seconds, onDone)
	self:setVolume(v, seconds)
	if onDone then
		if self._vfade then
			self._vfade.onDone = onDone
		else
			onDone(self)
		end
	end
end

function Track:fadeIn(seconds, onDone)
	self.fadingOut = false
	if seconds <= 0 then
		self._fade = nil
		self.fadeGain = 1
		self:_applyVolume()
		if onDone then
			onDone(self)
		end
		return
	end
	self._fade = { from = self.fadeGain, to = 1, elapsed = 0, dur = seconds, curve = "power", onDone = onDone }
end

-- fade to silence, then "stop" (default), "pause", "delete" or "none"
function Track:fadeOut(seconds, thenDo, onDone)
	thenDo = thenDo or "stop"
	self.fadingOut = true
	local f = { from = self.fadeGain, to = 0, elapsed = 0, dur = seconds, curve = "power", thenDo = thenDo, onDone = onDone }
	if seconds <= 0 then
		self:_finishFade(f)
		return
	end
	self._fade = f
end

function Track:getInfo()
	return {
		id = self.id, name = self.name, kind = self.kind, state = self.state, group = self.group,
		time = self.state ~= "deleted" and self:getTime() or 0,
		duration = self.state ~= "deleted" and self:getDuration() or 0,
		volume = self.volume, gain = self:_gain(), loop = self.loop,
	}
end

function Track:setMute(ch, on)
	self.controller:setMute(ch, on)
end

function Track:setSolo(ch, on)
	self.controller:setSolo(ch, on)
end

function Track:channels()
	return self.controller:channels()
end

function Track:activity(ch)
	return self.controller:activity(ch)
end

-- a track reached its end by itself
function Tracks._onEnded(track)
	if track.state == "deleted" then
		return
	end
	track:_setState("ended")
	evEnded:Fire(track)
	track._endedEvent:Fire()
	local wasCurrent = playlist.current == track
	local advanced = track._advanced
	if track.autoDelete then
		track:delete()
	end
	if wasCurrent then
		playlist.current = nil
		if not advanced and Tracks.hasNext() then
			Tracks.next({ Crossfade = 0 })
		end
	end
end

-- Queries and bulk control -----------------------------------------------------------------

local function targets(target)
	local out = {}
	if target == nil then
		for _, t in ipairs(list) do
			table.insert(out, t)
		end
	elseif type(target) == "table" and target.controller then
		table.insert(out, target)
	elseif type(target) == "table" then
		for _, x in ipairs(target) do
			for _, t in ipairs(targets(x)) do
				table.insert(out, t)
			end
		end
	else
		local t = registry[target]
		if t then
			table.insert(out, t)
		end
	end
	return out
end

function Tracks.getAllTracks()
	return targets(nil)
end

function Tracks.getAllPlayingTracks()
	local out = {}
	for _, t in ipairs(list) do
		if t.state == "playing" then
			table.insert(out, t)
		end
	end
	return out
end

function Tracks.getTrack(id)
	return registry[id]
end

function Tracks.getTracksInGroup(group)
	local out = {}
	for _, t in ipairs(list) do
		if t.group == group then
			table.insert(out, t)
		end
	end
	return out
end

function Tracks.pause(target)
	for _, t in ipairs(targets(target)) do
		t:pause()
	end
end

function Tracks.resume(target)
	for _, t in ipairs(targets(target)) do
		t:resume()
	end
end

function Tracks.stop(target)
	for _, t in ipairs(targets(target)) do
		t:stop()
	end
end

function Tracks.delete(target)
	for _, t in ipairs(targets(target)) do
		t:delete()
	end
end

function Tracks.fadeOut(target, seconds, thenDo)
	for _, t in ipairs(targets(target)) do
		t:fadeOut(seconds, thenDo)
	end
end

function Tracks.setLoop(target, on)
	if type(target) == "boolean" then
		target, on = nil, target
	end
	for _, t in ipairs(targets(target)) do
		t:setLoop(on)
	end
end

Tracks.pauseAll, Tracks.resumeAll, Tracks.stopAll, Tracks.deleteAll = Tracks.pause, Tracks.resume, Tracks.stop, Tracks.delete

function Tracks.setMasterVolume(v, fadeSeconds)
	if fadeSeconds and fadeSeconds > 0 then
		masterFade = { from = master, to = v, elapsed = 0, dur = fadeSeconds, curve = "smooth" }
		ensureConnection()
	else
		masterFade = nil
		master = v
		for _, t in ipairs(list) do
			t:_applyVolume()
		end
	end
end

function Tracks.getMasterVolume()
	return master
end

-- Transitions ------------------------------------------------------------------------------------

local function fadable(options)
	local out = {}
	local from = options.From and targets(options.From) or Tracks.getAllPlayingTracks()
	for _, t in ipairs(from) do
		if not t.fadingOut then
			table.insert(out, t)
		end
	end
	return out
end

function Tracks.crossfade(path, options)
	options = options or {}
	local d = options.Duration or 2
	local from = fadable(options)
	local new = Tracks.create(path, options) -- opened first: loading time doesn't eat into the fade
	for _, t in ipairs(from) do
		t:fadeOut(d, options.Keep and "stop" or "delete")
	end
	if options.Paused then
		return new
	end
	new:play(options.StartTime, d)
	return new
end

function Tracks.switch(path, options)
	options = options or {}
	local fadeOut = options.FadeOut or 0.5
	local from = fadable(options)
	local new = Tracks.create(path, options)
	new:_setState("pending")
	local remaining = #from
	local function start()
		if new.state == "pending" then
			new:play(options.StartTime, options.FadeIn or 0.25)
		end
	end
	if remaining == 0 then
		start()
	elseif fadeOut <= 0 then
		for _, t in ipairs(from) do
			if options.Keep then
				t:stop()
			else
				t:delete()
			end
		end
		start()
	else
		for _, t in ipairs(from) do
			t:fadeOut(fadeOut, options.Keep and "stop" or "delete", function()
				remaining -= 1
				if remaining == 0 then
					start()
				end
			end)
		end
	end
	return new
end

-- Playlist -----------------------------------------------------------------------------------------

local function normalize(item)
	if type(item) == "table" and item.path then
		return { path = item.path, options = item }
	end
	return { path = item, options = {} }
end

local function rebuildOrder(firstIndex)
	local n = #playlist.items
	local order = table.create(n)
	for i = 1, n do
		order[i] = i
	end
	if playlist.shuffle then
		for i = n, 2, -1 do
			local j = math.random(i)
			order[i], order[j] = order[j], order[i]
		end
		if firstIndex then
			local at = table.find(order, firstIndex)
			if at and at ~= 1 then
				order[at], order[1] = order[1], order[at]
			end
		end
	end
	playlist.order = order
	playlist.pos = firstIndex and table.find(order, firstIndex) or 0
end

local function currentItemIndex()
	return playlist.order[playlist.pos]
end

local function startItem(pos, transition)
	playlist.pos = pos
	local item = playlist.items[playlist.order[pos]]
	local o = table.clone(item.options)
	o.Loop = playlist.repeatMode == "one"
	o.Volume = o.Volume or playlist.volume
	o.Group = "playlist"
	local old = playlist.current
	local new
	if transition > 0 and old and old.state == "playing" then
		o.Duration = transition
		o.From = old
		new = Tracks.crossfade(item.path, o)
	else
		if old then
			old:delete()
		end
		new = Tracks.play(item.path, o)
	end
	playlist.current = new
	evPlaylist:Fire(new)
	return new
end

function Tracks.hasNext()
	local n = #playlist.order
	if n == 0 then
		return false
	end
	return playlist.repeatMode ~= "off" or playlist.pos < n
end

function Tracks.setPlaylist(items, options)
	options = options or {}
	playlist.items = {}
	for _, it in ipairs(items) do
		table.insert(playlist.items, normalize(it))
	end
	playlist.repeatMode = options.Repeat or playlist.repeatMode
	if options.Shuffle ~= nil then
		playlist.shuffle = options.Shuffle
	end
	playlist.crossfade = options.Crossfade or playlist.crossfade
	playlist.volume = options.Volume or playlist.volume
	local first = math.clamp(options.StartIndex or 1, 1, math.max(#playlist.items, 1))
	rebuildOrder(#playlist.items > 0 and first or nil)
	if options.Play ~= false and #playlist.items > 0 then
		return startItem(playlist.pos, options.Transition or 0)
	end
	evPlaylist:Fire(playlist.current)
	return nil
end

function Tracks.queue(path, atFront)
	local item = normalize(path)
	if atFront then
		table.insert(playlist.items, 1, item)
		for i, v in ipairs(playlist.order) do
			playlist.order[i] = v + 1
		end
		table.insert(playlist.order, math.max(playlist.pos, 0) + 1, 1)
	else
		table.insert(playlist.items, item)
		table.insert(playlist.order, #playlist.items)
	end
	evPlaylist:Fire(playlist.current)
end

function Tracks.next(options)
	options = options or {}
	local n = #playlist.order
	if n == 0 then
		return nil
	end
	local pos = playlist.pos + 1
	if pos > n then
		if playlist.repeatMode == "off" then
			Tracks.stopPlaylist(options.Crossfade or playlist.crossfade)
			return nil
		end
		if playlist.shuffle then
			rebuildOrder(nil)
		end
		pos = 1
	end
	return startItem(pos, options.Crossfade or playlist.crossfade)
end

function Tracks.previous(options)
	options = options or {}
	local n = #playlist.order
	if n == 0 then
		return nil
	end
	local cur = playlist.current
	if cur and cur.state ~= "deleted" and cur:getTime() > 3 then
		cur:seek(0)
		return cur
	end
	local pos = playlist.pos - 1
	if pos < 1 then
		pos = (playlist.repeatMode == "off") and 1 or n
	end
	return startItem(pos, options.Crossfade or playlist.crossfade)
end

function Tracks.jump(target, options)
	options = options or {}
	local index = target
	if type(target) == "string" then
		index = nil
		for i, it in ipairs(playlist.items) do
			if it.path == target then
				index = i
				break
			end
		end
	end
	local pos = index and table.find(playlist.order, index)
	if not pos then
		return nil
	end
	return startItem(pos, options.Crossfade or playlist.crossfade)
end

function Tracks.setRepeat(mode)
	assert(mode == "off" or mode == "all" or mode == "one", 'AudioLab.setRepeat: "off", "all" or "one"')
	playlist.repeatMode = mode
	local cur = playlist.current
	if cur and cur.state ~= "deleted" then
		cur:setLoop(mode == "one")
	end
end

function Tracks.setShuffle(on)
	if playlist.shuffle == (on == true) then
		return
	end
	playlist.shuffle = on == true
	rebuildOrder(currentItemIndex())
end

function Tracks.setCrossfade(seconds)
	playlist.crossfade = math.max(seconds, 0)
end

function Tracks.getCurrentTrack()
	local cur = playlist.current
	if cur and cur.state ~= "deleted" then
		return cur
	end
	return nil
end

function Tracks.getPlaylist()
	local paths = {}
	for i, it in ipairs(playlist.items) do
		paths[i] = it.path
	end
	return {
		items = paths, index = currentItemIndex(), position = playlist.pos, order = table.clone(playlist.order),
		["repeat"] = playlist.repeatMode, shuffle = playlist.shuffle, crossfade = playlist.crossfade,
		current = Tracks.getCurrentTrack(),
	}
end

function Tracks.stopPlaylist(fadeSeconds)
	local cur = playlist.current
	playlist.current = nil
	playlist.pos = 0
	if cur and cur.state ~= "deleted" then
		if fadeSeconds and fadeSeconds > 0 then
			cur._advanced = true
			cur:fadeOut(fadeSeconds, "delete")
		else
			cur:delete()
		end
	end
	evPlaylist:Fire(nil)
end

function Tracks.clearPlaylist()
	Tracks.stopPlaylist(0)
	playlist.items, playlist.order = {}, {}
end

-- Frame step: fades, master volume, playlist advance. Runs on Heartbeat; tests call it with Tracks.setAutoUpdate(false).
function Tracks.update(dt)
	if masterFade then
		local f = masterFade
		f.elapsed += dt
		local p = math.min(f.elapsed / f.dur, 1)
		master = fadeValue(f, p)
		for _, t in ipairs(list) do
			t:_applyVolume()
		end
		if p >= 1 then
			masterFade = nil
		end
	end
	for _, t in ipairs(table.clone(list)) do
		local vf = t._vfade
		if vf then
			vf.elapsed += dt
			local p = math.min(vf.elapsed / vf.dur, 1)
			t.volume = fadeValue(vf, p)
			t:_applyVolume()
			if p >= 1 then
				t._vfade = nil
				if vf.onDone then
					vf.onDone(t)
				end
			end
		end
		local f = t._fade
		if f and t.state ~= "deleted" then
			-- fades run on the track's own clock while it plays; a paused track holds its level
			if t.state ~= "paused" then
				f.elapsed += dt
			end
			local p = math.min(f.elapsed / f.dur, 1)
			t.fadeGain = fadeValue(f, p)
			t:_applyVolume()
			if p >= 1 then
				t:_finishFade(f)
			end
		end
	end
	-- the next song starts Crossfade seconds before the current one ends
	local cur = playlist.current
	if cur and cur.state == "playing" and not cur.loop and not cur._advanced and playlist.crossfade > 0 and Tracks.hasNext() then
		local remaining = cur:getDuration() - cur:getTime()
		if remaining > 0 and remaining <= playlist.crossfade then
			cur._advanced = true
			Tracks.next({ Crossfade = math.max(remaining, 0.05) })
		end
	end
	if #list == 0 and not masterFade and not playlist.current and connection then
		connection:Disconnect()
		connection = nil
	end
end

Tracks.Track = Track

return Tracks
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">TexturePlayer</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!optimize 2
-- Plays an RBA4 texture clip (Codec.Texture): every bubble, click and grain is one start of a generic upload file, at an
-- exact time. Same interface as Synth.Player (Player.new hands RBA4 clips here):
--   local p = TexturePlayer.new(clip, { Parent = SoundService, MasterGain = 1, DeviceOutput = true })
--   p:play({ Loop = false }); p.Ended:Connect(...); p:stop(); p:pause(); p:resume(); p:seek(t); p:destroy()
--
-- Timing: the engine applies AudioPlayer writes on the next audio block boundary (1024 samples). A piece that starts d
-- seconds after that boundary is started there with TimePosition = (its start in the file) - d * speed: the file has
-- silence before every piece (the lead-in), so the piece is heard exactly d seconds later. Pieces are scheduled up to
-- LOOK blocks ahead (more when frames are slow), which the lead-ins cover. A player is stopped on the first boundary after
-- its piece ends (or reused there for the next piece).
-- Slow devices: when frames keep arriving more than ~1.6 blocks apart, the sixth-octave grain set is dropped and the
-- half-octave set plays at full weight in its place (well under half the starts; the lows lose a little colour).
-- The pieces live in the codec's upload files (ids in Codec.Manifests.Files); a player stays on one file. Every player
-- a clip needs is made (and loaded) when the clip is opened, and every spot of the files it uses is played once silently
-- (_warmUp), so the first playback sounds like the others.
-- Beds (when tex_beds is uploaded): the grains are not started one by one (~4500 starts a second, ~300 players) but
-- played as one looping player per band (49): tex_beds holds each band's grain stream pre-rendered at a constant level
-- (1 s loops, played with LoopRegion), and the player's volume is set once per audio block from the clip's grain
-- volumes (their power per block). About 63 players for a clip instead of ~310, and nothing sound-specific is uploaded.

local RunService = game:GetService("RunService")
local AudioLab = script:FindFirstAncestor("AudioLab")
local Texture = require(AudioLab.Codec.Texture)
local Files = require(AudioLab.Codec.Manifests.Files)

local TexturePlayer = {}
TexturePlayer.__index = TexturePlayer

local R = 48000
local LAYOUT = Texture.LAYOUT
local BANDS = Texture.BANDS
local MIX_CALIBRATION = math.sqrt(2) -- an AudioFader with several inputs is -3.01 dB (see OscillatorPool)
local MAX_VOLUME = 3
local MIN_LOOK = 2 -- blocks scheduled ahead (at least): a frame that arrives a block late doesn't make pieces late
-- the bed loops: 13 short files tex_beds_01 .. tex_beds_13 (4 loops each, 4.16 s).
-- Band k's loop sits in file BEDS[k][1] at BEDS[k][2] s, 1 s long, with 0.02 s of its own wrap on both
-- sides, peak-normalised in the file by BEDS[k][4] (its level: the expected power of the band's grain stream). The loops
-- are stored reversed (noise sounds the same backwards) and played at speed 1 (see bedSpeed).
local BED_FILES = 13
local BEDS = { -- [band] = { file, start, len, gain }
	{ 1, 0.020000, 1.000000, 2.267203 }, { 1, 1.060000, 1.000000, 2.006382 }, { 1, 2.100000, 1.000000, 2.028231 },
	{ 1, 3.140000, 1.000000, 2.232738 }, { 2, 0.020000, 1.000000, 2.117899 }, { 2, 1.060000, 1.000000, 2.000708 },
	{ 2, 2.100000, 1.000000, 1.314349 }, { 2, 3.140000, 1.000000, 1.675955 }, { 3, 0.020000, 1.000000, 1.668530 },
	{ 3, 1.060000, 1.000000, 1.493324 }, { 3, 2.100000, 1.000000, 1.530395 }, { 3, 3.140000, 1.000000, 1.710341 },
	{ 4, 0.020000, 1.000000, 1.418800 }, { 4, 1.060000, 1.000000, 1.386274 }, { 4, 2.100000, 1.000000, 1.466820 },
	{ 4, 3.140000, 1.000000, 1.128155 }, { 5, 0.020000, 1.000000, 1.334138 }, { 5, 1.060000, 1.000000, 1.291318 },
	{ 5, 2.100000, 1.000000, 1.418072 }, { 5, 3.140000, 1.000000, 1.316535 }, { 6, 0.020000, 1.000000, 1.343831 },
	{ 6, 1.060000, 1.000000, 1.340666 }, { 6, 2.100000, 1.000000, 1.325587 }, { 6, 3.140000, 1.000000, 1.415053 },
	{ 7, 0.020000, 1.000000, 1.285036 }, { 7, 1.060000, 1.000000, 0.918249 }, { 7, 2.100000, 1.000000, 1.297667 },
	{ 7, 3.140000, 1.000000, 1.117693 }, { 8, 0.020000, 1.000000, 1.018590 }, { 8, 1.060000, 1.000000, 1.092079 },
	{ 8, 2.100000, 1.000000, 0.768751 }, { 8, 3.140000, 1.000000, 1.138501 }, { 9, 0.020000, 1.000000, 1.016022 },
	{ 9, 1.060000, 1.000000, 1.021772 }, { 9, 2.100000, 1.000000, 1.034011 }, { 9, 3.140000, 1.000000, 1.241620 },
	{ 10, 0.020000, 1.000000, 1.073985 }, { 10, 1.060000, 1.000000, 1.093674 }, { 10, 2.100000, 1.000000, 0.887936 },
	{ 10, 3.140000, 1.000000, 1.142311 }, { 11, 0.020000, 1.000000, 1.000482 }, { 11, 1.060000, 1.000000, 1.082118 },
	{ 11, 2.100000, 1.000000, 1.069825 }, { 11, 3.140000, 1.000000, 0.958929 }, { 12, 0.020000, 1.000000, 1.138605 },
	{ 12, 1.060000, 1.000000, 0.941378 }, { 12, 2.100000, 1.000000, 1.024534 }, { 12, 3.140000, 1.000000, 0.914992 },
	{ 13, 0.020000, 1.000000, 0.879394 },
}
local function bedFile(i)
	return ("tex_beds_%02d"):format(i)
end
-- A client plays about 400 AudioPlayers at once (all audio together); past that the engine drops
-- players, and a texture clip that starts over it loses most of its pieces. play() counts what else is playing, then
-- plays the full clip, the low-cost set (no sixth-octave grains) or, if even that doesn't fit, skips grains past the
-- budget (bubbles and clicks always play).
local ENGINE_LIMIT = 400
local CLOCK_STEADY = 8 -- block ticks in a row the clock needs before a play starts
local LIMIT_MARGIN = 16
-- (only players wired into something count: AudioLab keeps stopped songs' players running unwired, and those barely
-- take room: 200 of them cost a clip ~2 dB, 200 wired ones ~14 dB)
local function playingElsewhere(mine)
	local n = 0
	for _, d in ipairs(game:GetService("SoundService"):GetDescendants()) do
		if d:IsA("AudioPlayer") and d.IsPlaying and not d:IsDescendantOf(mine) then
			for _, w in ipairs(d:GetConnectedWires("Output")) do
				if w.TargetInstance then
					n += 1
					break
				end
			end
		end
	end
	return n
end
local function assetId(name)
	local id = Files[name]
	return (id and id ~= "") and id or nil
end
TexturePlayer.assetId = assetId

-- true when every upload file of the codec has an id
function TexturePlayer.ready()
	for _, name in ipairs(LAYOUT.allFiles) do
		if not assetId(name) then
			return false, name
		end
	end
	return true
end

-- the beds are used once every tex_beds file is known to load (a new upload is refused while Roblox reviews it, or if
-- it is rejected): until then clips play their grains. Probe players retry every 30 s until all the files load.
local bedsLoaded = false
local bedsChecking = false -- (the first round of probes is still running: a play waits for it, up to 3 s)
do
	local all = true
	for i = 1, BED_FILES do
		if not assetId(bedFile(i)) then
			all = false
		end
	end
	if all then
		bedsChecking = true
		task.spawn(function()
			local loaded = {}
			while not bedsLoaded do
				local probes = {}
				for i = 1, BED_FILES do
					if not loaded[i] then
						local probe = Instance.new("AudioPlayer")
						probe.Name = "AudioLabBedsProbe"
						probe.Asset = assetId(bedFile(i))
						probe.Volume = 0
						probe.Parent = game:GetService("SoundService")
						probes[i] = probe
					end
				end
				local t0 = os.clock()
				repeat
					task.wait(0.1)
					local done = true
					for i, probe in pairs(probes) do
						if probe.IsReady then
							loaded[i] = true
						else
							done = false
						end
					end
				until done or os.clock() - t0 > 30
				for _, probe in pairs(probes) do
					probe:Destroy()
				end
				local n = 0
				for i = 1, BED_FILES do
					if loaded[i] then
						n += 1
					end
				end
				bedsLoaded = n == BED_FILES
				bedsChecking = false
			end
		end)
	end
end
function TexturePlayer.bedsReady()
	return bedsLoaded
end

local function wire(parent, from, to)
	local w = Instance.new("Wire")
	w.SourceInstance = from
	w.TargetInstance = to
	w.Parent = parent
	return w
end

-- every piece of the clip as one start: { t (clip s), file, at (s in that file), lead, speed, vol, dur (real s), band }
-- (beds: the grains are played by the beds, not as pieces)
local function buildEvents(clip, rng, beds)
	local ev = {}
	local L = LAYOUT
	for _, b in ipairs(clip.bubbles) do
		local w = L.tones.where[b.shape]
		table.insert(ev, { t = b.t / R, file = w.file, at = w.start, lead = L.tones.lead, speed = b.speed,
			vol = b.amp * L.tones.gain, dur = L.tones.len[b.shape] / b.speed })
	end
	for _, c in ipairs(clip.clicks) do
		local item = ((c.band - 1) * 3 + (c.tau - 1)) * 3 + c.var
		local w = L.clicks.where[item]
		-- (a click can be played from another spot at a speed: Texture.ClickRemap; gain keeps its energy)
		local speed = w.speed or 1
		table.insert(ev, { t = c.t / R, file = w.file, at = w.start, lead = L.clicks.lead, speed = speed,
			vol = c.amp * L.clicks.gain * (w.gain or 1), dur = (w.flen or L.clicks.len[item]) / speed })
	end
	local G = L.grains
	for bi, vols in ipairs(beds and {} or clip.grains) do
		local g = G.g[bi]
		local hop = g / 2
		local where = G.where[bi]
		for k, v in ipairs(vols) do
			if v > 0 then
				local t = math.floor((k - 1) * hop * R + 0.5) / R
				local w = where[rng:NextInteger(1, G.K)]
				table.insert(ev, { t = t, file = w.file, at = w.start, lead = G.lead, speed = 1,
					vol = v * G.gain[bi], dur = g, band = bi })
			end
		end
	end
	table.sort(ev, function(a, b)
		return a.t < b.t
	end)
	return ev
end

-- per band, per audio block of the clip: the bed's volume (the mean power of the grains centred in that block; blocks
-- without a grain centre - long grains - in between their neighbours), in the file's units
local function bedVolumes(clip)
	local blk = 1024 / R
	local nb = math.max(1, math.ceil(clip.duration / blk))
	local out = {}
	for bi, vols in ipairs(clip.grains) do
		local g = LAYOUT.grains.g[bi]
		local hop = g / 2
		local sum, cnt = table.create(nb, 0), table.create(nb, 0)
		for k, v in ipairs(vols) do
			local b = math.min(math.floor(((k - 1) * hop + g / 2) / blk), nb - 1) + 1
			sum[b] += v * v
			cnt[b] += 1
		end
		local p = table.create(nb, 0)
		local left, right = table.create(nb, 0), table.create(nb, 0)
		local last = 0
		for b = 1, nb do
			if cnt[b] > 0 then
				p[b] = sum[b] / cnt[b]
				last = b
			end
			left[b] = last
		end
		last = 0
		for b = nb, 1, -1 do
			if cnt[b] > 0 then
				last = b
			end
			right[b] = last
		end
		local gain = BEDS[bi] and BEDS[bi][4] or 1
		local v = table.create(nb, 0)
		for b = 1, nb do
			local pb = p[b]
			if cnt[b] == 0 then
				local l, r = left[b], right[b]
				if l > 0 and r > 0 then
					pb = p[l] + (p[r] - p[l]) * (b - l) / (r - l)
				elseif l > 0 then
					pb = p[l]
				elseif r > 0 then
					pb = p[r]
				end
			end
			v[b] = math.sqrt(pb) / gain
		end
		out[bi] = v
	end
	return out
end

-- how many players each file needs at once: a piece takes its player on the boundary where it enters the look-ahead
-- (at most 3 blocks ahead) and frees it on the first boundary after it ends; counted that way (plus a little spare)
-- (ahead: blocks before its boundary a piece takes its player, 2 for the pool, 1 for the usual case; spare: true adds a
-- little)
local function playersNeeded(events, ahead, spare)
	local blk = 1024 / R
	local per = {}
	for _, e in ipairs(events) do
		local list = per[e.file]
		if not list then
			list = {}
			per[e.file] = list
		end
		table.insert(list, { math.floor(e.t / blk) - ahead, 1 }) -- taken on this boundary
		table.insert(list, { math.ceil((e.t + e.dur) / blk), -1 }) -- free again on this one
	end
	local need = {}
	for file, list in pairs(per) do
		table.sort(list, function(a, b)
			if a[1] ~= b[1] then
				return a[1] < b[1]
			end
			return a[2] < b[2] -- (frees first on a tie)
		end)
		local cur, top = 0, 0
		for _, x in ipairs(list) do
			cur += x[2]
			top = math.max(top, cur)
		end
		need[file] = spare and (math.ceil(top * 1.1) + 2) or top
	end
	return need
end

function TexturePlayer.new(clip, config)
	if typeof(clip) == "buffer" or type(clip) == "string" then
		clip = Texture.unpack(clip)
	end
	config = config or {}
	local self = setmetatable({}, TexturePlayer)
	self.clip = clip
	self.texture = true
	self.seed = config.Seed or 1
	self.useBeds = config.Beds ~= false and bedsLoaded
	self.events = buildEvents(clip, Random.new(self.seed), self.useBeds)
	self.folder = Instance.new("Folder")
	self.folder.Name = config.Name or "AudioLabTexture"
	-- players -> Mix (several inputs: keep-alive input so the -3 dB is constant) -> low-pass at the clip's top -> Master
	self.mix = Instance.new("AudioFader")
	self.mix.Name = "Mix"
	self.mix.Volume = MIX_CALIBRATION
	self.mix.Parent = self.folder
	local keep = Instance.new("AudioPlayer")
	keep.Name = "keepalive"
	keep.Volume = 0
	keep.Parent = self.mix
	wire(self.mix, keep, self.mix)
	self.filter = Instance.new("AudioFilter")
	self.filter.Name = "Top"
	self.filter.FilterType = Enum.AudioFilterType.Lowpass48dB
	self.filter.Frequency = math.clamp(clip.fc, 200, 20000)
	self.filter.Parent = self.folder
	wire(self.folder, self.mix, self.filter)
	self.output = Instance.new("AudioFader")
	self.output.Name = "Master"
	self.output.Volume = config.MasterGain or 1
	self.output.Parent = self.folder
	wire(self.folder, self.filter, self.output)
	if config.DeviceOutput ~= false then
		local device = Instance.new("AudioDeviceOutput")
		device.Name = "Speakers"
		device.Parent = self.folder
		if config.Limiter ~= false then
			local lim = Instance.new("AudioLimiter")
			lim.Name = "Limiter"
			lim.MaxLevel = config.LimiterCeiling or -1
			lim.Release = 0.12
			lim.Parent = self.folder
			wire(self.folder, self.output, lim)
			wire(self.folder, lim, device)
		else
			wire(self.folder, self.output, device)
		end
	end
	self.folder.Parent = config.Parent or game:GetService("SoundService")
	-- the parts of an OscillatorPool that players' users reach for (Library volume, the analyzer, Attach)
	local selfRef = self
	self.pool = {
		folder = self.folder,
		output = self.output,
		device = self.folder:FindFirstChild("Speakers"),
		stereo = false,
		setMasterGain = function(_, v)
			selfRef.output.Volume = v
		end,
	}
	self.pools = {} -- upload file name -> { free = { records }, count }
	self.forceLow = config.LowCost == true
	self.lowCost = self.forceLow
	self.budget, self.dropped = math.huge, 0
	self.time = 0
	self.playing = false
	self._ended = Instance.new("BindableEvent")
	self.Ended = self._ended.Event
	-- the block clock: a silent looping player (the loop file); the upload files themselves are preloaded (Manifests Core)
	local cp = Instance.new("AudioPlayer")
	cp.Name = "BlockClock"
	cp.Asset = assetId("tex_loop") or ""
	cp.Looping = true
	cp.Volume = 0
	cp.Parent = self.folder
	wire(cp, cp, self.mix)
	cp:Play()
	self.clockPlayer = cp
	-- the clock's position moves in clumps for a moment after it starts, and whenever the audio engine falls behind (right
	-- after songs are switched): clockSteady counts the block ticks since the last clump, and play waits for a run of them
	-- (the first play started on a clumpy clock and came out late and thinned)
	self.clockSteady = 0
	local lastPos
	self.clockWatch = RunService.Heartbeat:Connect(function()
		if not cp.IsReady then
			return
		end
		local pos = cp.TimePosition
		if lastPos and pos ~= lastPos then
			local d = pos - lastPos
			if d < -0.5 then
				d += (cp.TimeLength > 0 and cp.TimeLength or 1)
			end
			if d > 0 and d < 1.5 * 1024 / R then
				self.clockSteady += 1
			else
				self.clockSteady = 0
			end
		end
		lastPos = pos
	end)
	self.pending = {}
	self.bedsOff = config.Beds == false
	if self.useBeds then
		self:_makeBeds()
	end
	-- make every player now: a player made during playback isn't loaded in time for its first piece
	-- players the clip needs at once: everything, and the low-cost set
	self:_countNeed()
	local needed = playersNeeded(self.events, 2, true)
	for file, count in pairs(needed) do
		local pool = self:_pool(file)
		for _ = 1, count do
			table.insert(pool.free, self:_make(file))
		end
	end
	self:_warmUp()
	local ok, missing = TexturePlayer.ready()
	if not ok then
		warn(("[AudioLab] texture clip: the generic texture files are not all uploaded yet (Codec.Manifests.Files has no id for %s)"):format(missing))
	end
	return self
end

-- the 49 bed players (one per band, looping its band's loop)
function TexturePlayer:_makeBeds()
	self.bedVol = bedVolumes(self.clip)
	self.beds = {}
	for bi = 1, #BANDS do
		local p = Instance.new("AudioPlayer")
		p.Name = "bed_" .. bi
		local b = BEDS[bi]
		p.Asset = assetId(bedFile(b[1]))
		p.Looping = true
		local s, len = b[2], b[3]
		p.LoopRegion = NumberRange.new(s, s + len)
		p.Volume = 0
		p.Parent = self.folder
		wire(p, p, self.mix)
		-- (each band starts somewhere else in its loop)
		self.beds[bi] = { p = p, start = s + ((bi * 0.618034) % 1) * len * 0.9, vol = 0 }
	end
end

-- A clip opened before the bed files had loaded (right after joining, the probe takes a moment) plays its grains; on
-- its next play() it switches to the beds, and its grain players are let go.
function TexturePlayer:_enableBeds()
	if self.beds or self.bedsOff or not bedsLoaded then
		return
	end
	self.useBeds = true
	self.events = buildEvents(self.clip, Random.new(self.seed), true)
	self:_makeBeds()
	self:_countNeed()
	for file, pool in pairs(self.pools) do
		if string.find(file, "grains", 1, true) then
			for _, rec in ipairs(pool.free) do
				rec.p:Destroy()
			end
			pool.free = {}
			pool.count = 0
		end
	end
	-- warm up again: the beds, and the pieces left (the grain players it was warming are gone)
	if self.warmConn then
		self.warmConn:Disconnect()
		self.warmConn = nil
	end
	self:_warmUp()
end

-- players the clip needs at once: everything, and the low-cost set
function TexturePlayer:_countNeed()
	local lowEvents = {}
	for _, e in ipairs(self.events) do
		if not e.band or BANDS[e.band].half then
			table.insert(lowEvents, e)
		end
	end
	self.need = { full = 0, low = 0 }
	for _, c in pairs(playersNeeded(lowEvents, 1)) do
		self.need.low += c
	end
	for _, c in pairs(playersNeeded(self.events, 1)) do
		self.need.full += c
	end
	if self.beds then
		self.need.full += #self.beds
		for _, band in ipairs(BANDS) do
			if band.half then
				self.need.low += 1
			end
		end
	end
end

-- audio block counter (see Synth.Player): a silent looping player's position advances one block at a time
function TexturePlayer:_blockClock()
	local cp = self.clockPlayer
	if not self.blockDur then
		self.blockIndex, self.blockDur, self.clockLast = 0, 1024 / R, nil
		self.clockSum, self.clockSteps = 0, 0
	end
	local pos = cp.TimePosition
	local last = self.clockLast
	if last then
		local d = pos - last
		if d < -0.5 then
			d += (cp.TimeLength > 0 and cp.TimeLength or 1)
		end
		if d > 1e-4 then
			local n = math.max(1, math.floor(d / self.blockDur + 0.5))
			self.blockIndex += n
			self.clockSum += d
			self.clockSteps += n
			if self.clockSteps >= 50 then
				self.blockDur = self.clockSum / self.clockSteps
			end
		end
	end
	self.clockLast = pos
	return self.blockIndex, self.blockDur
end

function TexturePlayer:_pool(file)
	local pool = self.pools[file]
	if not pool then
		pool = { free = {}, count = 0 }
		self.pools[file] = pool
	end
	return pool
end

function TexturePlayer:_take(file)
	local rec = table.remove(self:_pool(file).free)
	if rec then
		return rec
	end
	return self:_make(file)
end

-- a new player on `file` (not in the free list yet)
function TexturePlayer:_make(file)
	local pool = self:_pool(file)
	local p = Instance.new("AudioPlayer")
	p.Name = file
	p.Asset = assetId(file) or ""
	p.Looping = false
	p.Volume = 0
	p.Parent = self.folder
	wire(p, p, self.mix)
	pool.count += 1
	return { p = p, file = file }
end

function TexturePlayer:_reset(fromTime)
	-- the next event to schedule, and the busy players
	local ev = self.events
	local i = 1
	while i <= #ev and ev[i].t < fromTime do
		i += 1
	end
	self.nextEvent = i
	self.busy = {}
	self.startBlock = nil
	self.timeOrigin = fromTime
	self.advance = {}
	self.pending = {}
end

-- once per audio block (the first frame that sees a new block): schedule what starts before the look-ahead horizon
function TexturePlayer:_step()
	local B, blk = self:_blockClock()
	if B == self.lastB then
		return
	end
	local adv = self.lastB and (B - self.lastB) or 1
	self.lastB = B
	local st = self.stats
	if st and adv > st.maxAdv then
		st.maxAdv = adv
	end
	-- how far apart frames arrive (in blocks): look further ahead on slow devices, switch to low cost if it persists
	table.insert(self.advance, adv)
	if #self.advance > 60 then
		table.remove(self.advance, 1)
	end
	local maxAdv, sum = 1, 0
	for _, a in ipairs(self.advance) do
		maxAdv = math.max(maxAdv, a)
		sum += a
	end
	local look = math.clamp(maxAdv, MIN_LOOK, 3)
	if not self.slowFrames and #self.advance >= 30 and sum / #self.advance > 1.6 then
		self.slowFrames = true
	end
	-- the player budget follows what else plays (checked every ~12 blocks)
	if not self.budgetAt or B - self.budgetAt >= 12 then
		self.budgetAt = B
		self:_budget()
	end
	if not self.startBlock then
		-- the clip's time origin sits on this boundary: far enough ahead that a slow first frame isn't late
		self.startBlock = B + 1 + 3
	end
	local land = B + 1 -- what is written now is applied on this boundary
	local function clipTime(boundary)
		return self.timeOrigin + (boundary - self.startBlock) * blk
	end
	local tLand = clipTime(land)
	self.time = math.max(self.timeOrigin, tLand)
	self:_bedStep(tLand)
	local horizon = clipTime(land + look)
	-- players whose piece is over by the landing boundary are free
	local freed = {}
	local still = {}
	for _, rec in ipairs(self.busy) do
		if rec.ends <= tLand then
			table.insert(freed, rec)
		else
			table.insert(still, rec)
		end
	end
	self.busy = still
	local spare = {}
	for _, rec in ipairs(freed) do
		local list = spare[rec.file]
		if not list then
			list = {}
			spare[rec.file] = list
		end
		table.insert(list, rec)
	end
	local function start(e)
		local d = e.t - tLand
		local skip = 0
		if d < 0 then
			skip = -d -- late (a stalled frame): start inside the piece
			d = 0
			if st then
				st.late += 1
				st.maxLate = math.max(st.maxLate, skip)
			end
		end
		if skip >= e.dur then
			return
		end
		if e.band and #self.busy >= self.budget then
			self.dropped += 1 -- over the player budget: a grain is skipped (the engine would drop something anyway)
			return
		end
		-- the lead-in covers d * speed seconds of file at most (a fast piece waits in `pending` until it fits)
		local back = math.min((d - skip) * e.speed, e.lead)
		local list = spare[e.file]
		local rec = (list and table.remove(list)) or self:_take(e.file)
		local p = rec.p
		p.TimePosition = e.at - back
		p.PlaybackSpeed = e.speed
		p.Volume = math.min(e.vol, MAX_VOLUME)
		if not p.IsPlaying then
			p:Play()
		end
		rec.ends = e.t + e.dur
		table.insert(self.busy, rec)
	end
	-- pieces that were too far ahead for their lead-in
	local pending = self.pending
	if #pending > 0 then
		local keep = {}
		for _, e in ipairs(pending) do
			if (e.t - tLand) * e.speed <= e.lead or e.t - tLand < blk then
				start(e)
			else
				table.insert(keep, e)
			end
		end
		self.pending = keep
		pending = keep
	end
	-- schedule
	local ev = self.events
	local i = self.nextEvent
	local low = self.lowCost
	while i <= #ev and ev[i].t < horizon do
		local e = ev[i]
		i += 1
		if low and e.band then
			-- low cost: no sixth-octave grains; the half-octave set at full weight (it carries the band's whole power)
			local band = BANDS[e.band]
			if band.half then
				local w = band.w
				e = table.clone(e)
				e.vol /= math.sqrt(w)
				if (e.t - tLand) > e.lead and e.t - tLand >= blk then
					table.insert(pending, e)
				else
					start(e)
				end
			end
		elseif (e.t - tLand) * e.speed > e.lead and e.t - tLand >= blk then
			table.insert(pending, e)
		else
			start(e)
		end
	end
	self.nextEvent = i
	if st then
		st.maxBusy = math.max(st.maxBusy, #self.busy)
		st.lowCost = st.lowCost or self.lowCost
		st.minBudget = math.min(st.minBudget, self.budget)
	end
	-- players not reused: stop on the landing boundary (before the file reaches its next piece)
	for file, list in pairs(spare) do
		local pool = self:_pool(file)
		for _, rec in ipairs(list) do
			if rec.p.IsPlaying then
				rec.p:Stop()
			end
			table.insert(pool.free, rec)
		end
	end
	-- the end: every piece has played
	local dur = self.clip.duration
	if self.nextEvent > #ev and #self.pending == 0 and #self.busy == 0 and tLand >= dur then
		self:_report()
		if self.loop then
			self:_reset(0)
			self.lastB = B
			self:_newStats(0)
		else
			self:_finish()
			self._ended:Fire()
		end
	end
end

-- Every bed reads its loop at its own speed, which also wanders slowly (once every 2 blocks): played at speed 1 the
-- loops came round again together (every hiss band every 0.5 s), and a fading tail pulsed in that rhythm instead of
-- dying away (the hiss repeated with correlation 0.85 at 0.5 s; with these speeds 0.07, as low as the original's own).
-- Speeds stay within 1 +- 0.07: a band's noise moves a few percent in pitch, which noise doesn't show.
local BED_SPREAD, BED_WOBBLE = 0.04, 0.03
local PHI = 0.618034
local function bedSpeed(bi, t)
	local u = (bi * PHI) % 1 * 2 - 1 -- spread over the bands
	local per = 0.35 + 0.3 * ((bi * 0.381966) % 1) -- wobble period 0.35 .. 0.65 s
	local ph = 2 * math.pi * ((bi * 0.7548777) % 1)
	return 1 + BED_SPREAD * u + BED_WOBBLE * math.sin(2 * math.pi * t / per + ph)
end

-- the beds' volumes (and speeds) for the block that starts at clip time t (written now, applied on that block's
-- boundary)
function TexturePlayer:_bedStep(t)
	local beds = self.beds
	if not beds then
		return
	end
	if not self.bedsOn then
		self.bedsOn = true
		self.bedSpeedSet = false
		for _, b in ipairs(beds) do
			b.p.PlaybackSpeed = 1
			b.p.Volume = 0
			b.vol = 0
			b.p.TimePosition = b.start
			if not b.p.IsPlaying then
				b.p:Play()
			end
		end
	end
	local idx = math.floor(t * R / 1024 + 1e-6) + 1
	local before = t < self.timeOrigin - 1e-6 -- (the first blocks, before the clip's time origin: silent)
	local low = self.lowCost
	-- (the drift is off unless AudioLab's attribute BedSpeedDrift = true: drifting beds sound
	-- warbly: the engine resamples each loop at a changing speed)
	local speedNow = AudioLab:GetAttribute("BedSpeedDrift") == true and (idx % 2 == 1 or not self.bedSpeedSet)
	self.bedSpeedSet = true
	local ts = (idx - 1) * 1024 / R
	for bi, b in ipairs(beds) do
		if speedNow then
			b.p.PlaybackSpeed = bedSpeed(bi, ts)
		end
		local list = self.bedVol[bi]
		local v = 0
		if not before and idx >= 1 and idx <= #list then
			v = list[idx]
		end
		if low then
			-- low cost: no sixth-octave beds; the half-octave set at full weight (as the grains do)
			local band = BANDS[bi]
			v = band.half and v / math.sqrt(band.w) or 0
		end
		v = math.min(v, MAX_VOLUME)
		if math.abs(v - b.vol) > 1e-5 then
			b.vol = v
			b.p.Volume = v
		end
	end
end

function TexturePlayer:_finish()
	if self.conn then
		self.conn:Disconnect()
		self.conn = nil
	end
	self.playing = false
	if self.beds then
		for _, b in ipairs(self.beds) do
			b.p.Volume = 0
			b.vol = 0
			if b.p.IsPlaying then
				b.p:Stop()
			end
		end
		self.bedsOn = false
	end
	for _, pool in pairs(self.pools) do
		for _, rec in ipairs(pool.free) do
			if rec.p.IsPlaying then
				rec.p:Stop()
			end
		end
	end
	for _, rec in ipairs(self.busy or {}) do
		if rec.p.IsPlaying then
			rec.p:Stop()
		end
		table.insert(self:_pool(rec.file).free, rec)
	end
	self.busy = {}
	self.pending = {}
end

-- Before the first play every spot of the files the clip uses is played once, silently (a few per frame): the engine
-- decodes a compressed file where a player jumps in, and a first play that jumps into ~600 new spots at once
-- stutters (spots decoded before play smoothly).
local WARM_PER_FRAME = 16
function TexturePlayer:_warmUp()
	-- every distinct piece: { file, at, lead, dur }
	local seen, queue = {}, {}
	for _, e in ipairs(self.events) do
		local key = e.file .. ":" .. e.at
		if not seen[key] then
			seen[key] = true
			table.insert(queue, { file = e.file, at = e.at, lead = e.lead, len = e.dur * e.speed })
		end
	end
	local recs = {}
	for file, pool in pairs(self.pools) do
		recs[file] = { list = table.clone(pool.free), i = 0 }
	end
	local running = {}
	local busy = {}
	self.warmed = false
	self.warmTotal = #queue
	-- the beds: each played silently for a moment at its starting spot (up to 10 s for them to load)
	local warmStart = os.clock()
	local bedsUntil, bedsDone = nil, self.beds == nil
	self.warmConn = RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if not bedsDone then
			if not bedsUntil then
				local ready = true
				for _, b in ipairs(self.beds) do
					if not b.p.IsReady then
						ready = false
						break
					end
				end
				if ready then
					for _, b in ipairs(self.beds) do
						b.p.Volume = 0
						b.p.TimePosition = b.start
						b.p:Play()
					end
					bedsUntil = now + 0.4
				elseif now - warmStart > 10 then
					bedsDone = true
				end
			elseif now >= bedsUntil then
				if not self.playing then
					for _, b in ipairs(self.beds) do
						if b.p.IsPlaying then
							b.p:Stop()
						end
					end
				end
				bedsDone = true
			end
		end
		for i = #running, 1, -1 do
			local r = running[i]
			if now >= r.until_ then
				if r.rec.p.IsPlaying then
					r.rec.p:Stop()
				end
				busy[r.rec] = nil
				table.remove(running, i)
			end
		end
		local started = 0
		local qi = 1
		while qi <= #queue and started < WARM_PER_FRAME do
			local item = queue[qi]
			local set = recs[item.file]
			local rec
			if set and #set.list > 0 then
				for _ = 1, #set.list do
					set.i = set.i % #set.list + 1
					local c = set.list[set.i]
					if not busy[c] and c.p.IsReady then
						rec = c
						break
					end
				end
			end
			if rec then
				table.remove(queue, qi)
				busy[rec] = true
				rec.p.Volume = 0
				rec.p.PlaybackSpeed = 1
				rec.p.TimePosition = math.max(item.at - item.lead, 0)
				rec.p:Play()
				table.insert(running, { rec = rec, until_ = now + item.lead + item.len + 0.03 })
				started += 1
			else
				qi += 1
			end
		end
		if #queue == 0 and #running == 0 and bedsDone then
			self.warmed = true
			self.warmConn:Disconnect()
			self.warmConn = nil
		end
	end)
end

-- one line in the output after every play (or loop): what the player saw, to tell a bad play from a good one
function TexturePlayer:_newStats(waited)
	self.stats = { late = 0, maxLate = 0, maxAdv = 0, maxBusy = 0, lowCost = false, minBudget = math.huge, waited = waited,
		unready = 0, steady = self.clockSteady, n = (self.stats and self.stats.n or 0) + 1 }
end
function TexturePlayer:_unready()
	local n = 0
	for _, b in ipairs(self.beds or {}) do
		if not b.p.IsReady then
			n += 1
		end
	end
	for _, pool in pairs(self.pools) do
		for _, rec in ipairs(pool.free) do
			if not rec.p.IsReady then
				n += 1
			end
		end
	end
	return n
end
function TexturePlayer:_report()
	local st = self.stats
	-- (a testing aid: only with the AudioLab folder's Debug attribute)
	local al = script:FindFirstAncestor("AudioLab")
	if not st or not (al and al:GetAttribute("Debug") == true) then
		return
	end
	print(("[AudioLab] texture play %d: waited %.2f s (not loaded %d, warmed %s, clock ticks %d), late pieces %d (worst %.0f ms), "
		.. "biggest block jump %d, low cost %s, grains skipped %d, players at most %d (+%d beds), budget %s"):format(st.n, st.waited or -1,
		st.unready, tostring(self.warmed), st.steady or -1, st.late, st.maxLate * 1000, st.maxAdv, st.lowCost and "yes" or "no",
		self.dropped, st.maxBusy, self.beds and #self.beds or 0, st.minBudget == math.huge and "-" or tostring(st.minBudget)))
end

function TexturePlayer:_loaded()
	if not self.clockPlayer.IsReady or not self.warmed then
		return false
	end
	for _, b in ipairs(self.beds or {}) do
		if not b.p.IsReady then
			return false
		end
	end
	for _, pool in pairs(self.pools) do
		for _, rec in ipairs(pool.free) do
			if not rec.p.IsReady then
				return false
			end
		end
	end
	return true
end

function TexturePlayer:_connect()
	self.playing = true
	self.paused = false
	self.lastB = nil
	-- wait for every player to be loaded (a half-loaded clip sounds broken; right after joining, loading can take seconds,
	-- so up to 15 s), then for the clock to tick steadily (up to 2 s more: the engine catches up after a song switch)
	local waitFrom = os.clock()
	local loadedAt
	self.conn = RunService.Heartbeat:Connect(function()
		if waitFrom then
			local now = os.clock()
			-- right after joining the bed files are still being checked: the first play waits for that (up to 3 s) so it
			-- plays the beds too instead of falling back to the grains
			if not self.beds and not self.bedsOff then
				if bedsChecking and now - waitFrom < 3 then
					return
				end
				if bedsLoaded then
					self:_enableBeds()
					self:_reset(self.timeOrigin) -- (the events changed)
				end
			end
			if not loadedAt then
				if not self:_loaded() and now - waitFrom < 15 then
					return
				end
				loadedAt = now
			end
			if self.clockSteady < CLOCK_STEADY and now - loadedAt < 2 then
				return
			end
			if self.stats then
				self.stats.waited = os.clock() - waitFrom
				self.stats.unready = self:_unready()
				self.stats.steady = self.clockSteady
			end
			waitFrom = nil
			self.advance = {} -- (how far apart frames arrive is measured from the start of playback)
		end
		self:_step()
	end)
end

-- the budget (players this clip may run) and the mode: full, or low cost when the full set doesn't fit or frames are slow
function TexturePlayer:_budget()
	self.budget = math.max(ENGINE_LIMIT - LIMIT_MARGIN - playingElsewhere(self.folder), 24)
	self.lowCost = self.forceLow or self.slowFrames or self.budget < self.need.full
end

function TexturePlayer:play(options)
	options = options or {}
	self:stop()
	self:_enableBeds()
	-- room under the engine's player limit: silent players other audio left running stop first (they restart quickly)
	pcall(function()
		require(AudioLab.Synth.OscillatorPool).stopIdle()
	end)
	self.dropped = 0
	self:_newStats(os.clock())
	self.slowFrames = false
	self.budgetAt = nil
	self:_budget()
	self.loop = options.Loop == true
	self:_reset(options.StartTime or 0)
	self:_connect()
end

function TexturePlayer:stop()
	if self.playing or self.conn then
		self:_finish()
	end
end

function TexturePlayer:pause()
	local t = self.time
	self:_finish()
	self.paused = true
	self.time = t
end

function TexturePlayer:resume()
	if not self.conn then
		self:_reset(self.time or 0)
		self:_connect()
	end
end

function TexturePlayer:seek(t)
	t = math.clamp(t, 0, self.clip.duration)
	self.time = t
	if self.playing then
		self:_finish()
		self:_reset(t)
		self:_connect()
	end
end

function TexturePlayer:getTime()
	return self.time or 0
end

function TexturePlayer:getDuration()
	return self.clip.duration
end

function TexturePlayer:destroy()
	if self.clockWatch then
		self.clockWatch:Disconnect()
		self.clockWatch = nil
	end
	if self.warmConn then
		self.warmConn:Disconnect()
		self.warmConn = nil
	end
	self:_finish()
	self.folder:Destroy()
	self._ended:Destroy()
end

return TexturePlayer
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="94">
        <Properties>
          <string name="Name">Tools</string>
          <BinaryString name="AttributesSerialize"></BinaryString>
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <Color3 name="IconTint">
            <R>0</R>
            <G>0</G>
            <B>0</B>
          </Color3>
          <bool name="DefinesCapabilities">false</bool>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <int64 name="SourceAssetId">-1</int64>
        </Properties>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">Importer</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[-- Studio-only: bring files from disk into the place as base64 ModuleScripts, and read them back.
--
--   Importer.prompt({ Folder = "sfx_1" })  -- opens Studio's file picker (plugin/command-bar context)
--   Importer.store("sfx_1/00_twirl.wav", bytes) -> ModuleScript under Data.Files
--   Importer.load("sfx_1/00_twirl.wav") -> buffer       (works at runtime too)
--   Importer.list() -> { "sfx_1/00_twirl.wav", ... }
--   Importer.storeClip(name, rbacBytes) / Importer.loadClip(name)   (Data.Clips)
--   Importer.storeBank(name, table) / Importer.loadBank(name)        (Data.Banks, JSON; baked SoundFonts)
--   Importer.has(path) / hasClip(path) / hasBank(path)
--
-- Paths use "/" separators and become nested Folders, so files with the same name in
-- different source folders don't collide.

local AudioLab = script:FindFirstAncestor("AudioLab")
local Base64 = require(AudioLab.Util.Base64)

local Importer = {}

local LINE = 4096 -- base64 characters per source line (keeps the script editor responsive)
local PART_CHARS = 180000 -- per module, under Roblox's 200,000-character Source limit
local EXTENSIONS = { "wav", "aif", "aiff", "aifc", "mp3", "flac", "ogg", "oga", "mid", "midi", "sf2" }

local function splitPath(path)
	local parts = {}
	for part in string.gmatch(path, "[^/\\]+") do
		table.insert(parts, part)
	end
	return parts
end

local function resolve(root, path, create)
	local parts = splitPath(path)
	assert(#parts > 0, "empty path")
	local node = root
	for i = 1, #parts - 1 do
		local child = node:FindFirstChild(parts[i])
		if not child then
			if not create then
				return nil, parts[#parts]
			end
			child = Instance.new("Folder")
			child.Name = parts[i]
			child.Parent = node
		end
		node = child
	end
	return node, parts[#parts]
end

-- Game scripts can't write Script.Source (it needs plugin capability), so the Studio import server
-- running in Play stores entries as StringValues instead: same base64 text, split into parts.
local VALUE_PART_CHARS = 100000
local function storeAsValues(root, path, buf, text, attributes)
	local parent, name = resolve(root, path, true)
	local old = parent:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local holder = Instance.new("StringValue")
	holder.Name = name
	local parts = math.max(1, math.ceil(#text / VALUE_PART_CHARS))
	for p = 1, parts do
		local part = Instance.new("StringValue")
		part.Name = ("part%03d"):format(p)
		part.Value = string.sub(text, (p - 1) * VALUE_PART_CHARS + 1, p * VALUE_PART_CHARS)
		part.Parent = holder
	end
	holder:SetAttribute("Parts", parts)
	holder:SetAttribute("Bytes", buffer.len(buf))
	for k, v in pairs(attributes or {}) do
		holder:SetAttribute(k, v)
	end
	holder.Parent = parent
	return holder
end

local canWriteSource = nil
local function sourceWritable()
	if canWriteSource == nil then
		canWriteSource = pcall(function()
			local probe = Instance.new("ModuleScript")
			probe.Source = "return nil"
			probe:Destroy()
		end)
	end
	return canWriteSource
end

local function storeIn(root, path, bytes, attributes)
	local buf = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	local text = Base64.encode(buf)
	if not sourceWritable() then
		return storeAsValues(root, path, buf, text, attributes)
	end
	local lines = {}
	for i = 1, #text, LINE do
		table.insert(lines, '\t"' .. string.sub(text, i, i + LINE - 1) .. '",')
	end
	local parent, name = resolve(root, path, true)
	local module = parent:FindFirstChild(name)
	if module and not module:IsA("ModuleScript") then
		module:Destroy()
		module = nil
	end
	if not module then
		module = Instance.new("ModuleScript")
		module.Name = name
	end
	for _, child in ipairs(module:GetChildren()) do
		child:Destroy()
	end
	if #text <= PART_CHARS then
		module.Source = "-- AudioLab data: base64, " .. buffer.len(buf) .. " bytes\nreturn table.concat({\n" .. table.concat(lines, "\n") .. "\n})\n"
	else
		-- Script sources are capped at 200,000 characters: split into child part modules.
		local perPart = PART_CHARS // LINE
		local partCount = math.ceil(#lines / perPart)
		for p = 1, partCount do
			local part = Instance.new("ModuleScript")
			part.Name = ("part%03d"):format(p)
			local slice = table.move(lines, (p - 1) * perPart + 1, math.min(#lines, p * perPart), 1, {})
			part.Source = "return table.concat({\n" .. table.concat(slice, "\n") .. "\n})\n"
			part.Parent = module
		end
		module.Source = ("-- AudioLab data: base64, %d bytes in %d parts\nlocal parts = {}\nfor i = 1, %d do\n\tparts[i] = require(script[(\"part%%03d\"):format(i)])\nend\nreturn table.concat(parts)\n"):format(buffer.len(buf), partCount, partCount)
	end
	module:SetAttribute("Bytes", buffer.len(buf))
	for k, v in pairs(attributes or {}) do
		module:SetAttribute(k, v)
	end
	module.Parent = parent
	return module
end

local function loadFrom(root, path)
	local parent, name = resolve(root, path, false)
	local module = parent and parent:FindFirstChild(name)
	if not module then
		error("AudioLab data not found: " .. path)
	end
	if module:IsA("StringValue") then
		local parts = {}
		for p = 1, module:GetAttribute("Parts") or 0 do
			local part = module:WaitForChild(("part%03d"):format(p), 10)
			if not part then
				error("AudioLab data incomplete (still replicating?): " .. path)
			end
			parts[p] = part.Value
		end
		return Base64.decode(table.concat(parts))
	end
	return Base64.decode(require(module))
end

local function listIn(root)
	local out = {}
	for _, d in ipairs(root:GetDescendants()) do
		-- part### modules of a large entry live inside it: they aren't entries themselves
		local entry = (d:IsA("ModuleScript") or (d:IsA("StringValue") and d:GetAttribute("Parts") ~= nil))
		if entry and not (d.Parent and (d.Parent:IsA("ModuleScript") or d.Parent:IsA("StringValue"))) then
			local path = d.Name
			local node = d.Parent
			while node and node ~= root do
				path = node.Name .. "/" .. path
				node = node.Parent
			end
			table.insert(out, path)
		end
	end
	table.sort(out)
	return out
end

function Importer.filesRoot()
	return AudioLab.Data.Files
end

function Importer.clipsRoot()
	return AudioLab.Data.Clips
end

function Importer.store(path, bytes)
	return storeIn(Importer.filesRoot(), path, bytes)
end

function Importer.load(path)
	return loadFrom(Importer.filesRoot(), path)
end

function Importer.list()
	return listIn(Importer.filesRoot())
end

function Importer.storeClip(path, bytes, attributes)
	return storeIn(Importer.clipsRoot(), path, bytes, attributes)
end

function Importer.loadClip(path)
	return loadFrom(Importer.clipsRoot(), path)
end

function Importer.listClips()
	return listIn(Importer.clipsRoot())
end

function Importer.banksRoot()
	return AudioLab.Data.Banks
end

-- Baked data (any JSON-encodable table) under Data/Banks, e.g. an analysed SoundFont.
function Importer.storeBank(path, data, attributes)
	local json = game:GetService("HttpService"):JSONEncode(data)
	return storeIn(Importer.banksRoot(), path, buffer.fromstring(json), attributes)
end

function Importer.loadBank(path)
	return game:GetService("HttpService"):JSONDecode(buffer.tostring(loadFrom(Importer.banksRoot(), path)))
end

function Importer.hasBank(path)
	local parent, name = resolve(Importer.banksRoot(), path, false)
	return parent ~= nil and parent:FindFirstChild(name) ~= nil
end

function Importer.has(path)
	local parent, name = resolve(Importer.filesRoot(), path, false)
	return parent ~= nil and parent:FindFirstChild(name) ~= nil
end

function Importer.hasClip(path)
	local parent, name = resolve(Importer.clipsRoot(), path, false)
	return parent ~= nil and parent:FindFirstChild(name) ~= nil
end

-- Opens Studio's multi-file picker. Needs plugin-level access (command bar / plugin).
-- options.Folder prefixes the stored paths. Returns the stored paths.
function Importer.prompt(options)
	options = options or {}
	local StudioService = game:GetService("StudioService")
	local files = StudioService:PromptImportFilesAsync(options.Extensions or EXTENSIONS)
	local stored = {}
	for _, file in ipairs(files or {}) do
		local path = options.Folder and (options.Folder .. "/" .. file.Name) or file.Name
		Importer.store(path, file:GetBinaryContents())
		table.insert(stored, path)
	end
	return stored
end

return Importer
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">Baker</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[-- Studio-time baking: analyse a SoundFont once and store the result in Data/Banks, so games load a
-- few kilobytes of presets instead of decoding and analysing the whole .sf2 at runtime.
--
--   local bank, stats = Baker.bakeSoundFont("MySong/instruments.sf2", { Partials = 6 })
--   -- later, anywhere (any script, any Actor):  Assets.bank("MySong/instruments.sf2")
--
--   Baker.build(sf, options)  -- same analysis, kept in memory (used when a SoundFont has no baked bank)
--
-- Both yield between samples (call from a thread that can yield). options.Progress(done, total) is
-- called after each region. stats.checks lists every analysed sample with its self-check error (dB,
-- rebuilt vs original spectrum), worst first; stats.meanError is the average.

local AudioLab = script:FindFirstAncestor("AudioLab")
local Importer = require(AudioLab.Tools.Importer)
local Sf2 = require(AudioLab.Formats.Sf2)
local Instruments = require(AudioLab.Synth.Instruments)

local Baker = {}
Baker.Version = 1
Baker.FrameBudget = 0.012 -- seconds of analysis per frame before yielding

function Baker.build(sf, options)
	options = options or {}
	local flat = Sf2.flatten(sf)
	local bank = {
		version = Baker.Version,
		partials = options.Partials or Instruments.Defaults.Partials,
		hop = options.Hop or Instruments.Defaults.Hop,
		presets = {}, samples = {},
	}
	local total = 0
	for _, p in ipairs(flat) do
		total += #p.regions
	end
	local regions, samples = 0, 0
	local checks = {}
	local sliceStart = os.clock()
	for _, p in ipairs(flat) do
		local entry = { bank = p.bank, program = p.program, name = p.name, regions = {} }
		for _, r in ipairs(p.regions) do
			if os.clock() - sliceStart > Baker.FrameBudget then
				task.wait()
				sliceStart = os.clock()
			end
			local a, key = Instruments.analyseRegion(sf, r.region, options)
			if bank.samples[key] == nil then
				samples += 1
				table.insert(checks, {
					sample = key, preset = p.name, program = p.program, kind = a.kind,
					err = a.check and a.check.err or -1, steady = a.check and a.check.steady or -1,
					periodicity = a.periodicity, bundleShare = a.bundleShare,
				})
			end
			bank.samples[key] = a
			table.insert(entry.regions, {
				kl = r.keyLo, kh = r.keyHi, vl = r.velLo, vh = r.velHi, sample = key, info = Instruments.regionInfo(r.region),
			})
			regions += 1
			if options.Progress then
				options.Progress(regions, total)
			end
		end
		table.insert(bank.presets, entry)
	end
	table.sort(checks, function(x, y)
		return x.err > y.err
	end)
	local sum = 0
	for _, c in ipairs(checks) do
		sum += math.max(c.err, 0)
	end
	bank.analysisVersion = Instruments.AnalysisVersion
	return bank, { presets = #bank.presets, regions = regions, samples = samples, checks = checks, meanError = sum / math.max(#checks, 1) }
end

function Baker.bakeSoundFont(path, options)
	options = options or {}
	local t0 = os.clock()
	local sf = Sf2.decode(Importer.load(path))
	local bank, stats = Baker.build(sf, options)
	bank.source = path
	local module = Importer.storeBank(options.Name or path, bank, { Presets = stats.presets, Regions = stats.regions, Samples = stats.samples })
	stats.bytes = module:GetAttribute("Bytes")
	stats.seconds = os.clock() - t0
	return bank, stats
end

return Baker
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">Assets</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[-- Shared asset cache: every file is decoded once per Luau VM and the result is shared.
-- Values are shared between callers: treat them as read-only.
--
--   Assets.file(path)        raw bytes (buffer) from Data/Files
--   Assets.midi(path)        decoded MIDI (Midi.decode)
--   Assets.clip(path)        RBAC clip bytes: Data/Clips/<path without extension>, or encoded from the file
--   Assets.bank(path)        baked SoundFont bank (Tools/Baker) or nil
--   Assets.soundFont(path)   decoded SF2 (fallback when there is no baked bank)
--   Assets.instruments(path) { Bank = bank }: the baked bank, or one built in memory (yields)  (pass into MidiSynth.new)
--   Assets.preload({ paths }), Assets.clear(prefix?)
--   Assets.addSource(fn)     fn(clipPath) -> bytes or nil: where clips that aren't in Data/Clips come from (FrameLab adds
--                            one on clients: in-game video imports keep their sound on the server and send it on demand).
--                            On a client, a clip that isn't there waits a few seconds for a source to be added.
--
-- Concurrent requests for the same path while it is loading wait for the first one instead of
-- decoding twice. Each Actor has its own VM, so each Actor has its own cache: bake SoundFonts so
-- what every Actor loads is small.

local AudioLab = script:FindFirstAncestor("AudioLab")
local Importer = require(AudioLab.Tools.Importer)
local Midi = require(AudioLab.Formats.Midi)
local Sf2 = require(AudioLab.Formats.Sf2)
local Encoder = require(AudioLab.Codec.Encoder)

local Assets = {}
local sources = {}
function Assets.addSource(fn)
	table.insert(sources, fn)
end
local cache = {}
local loading = {}
local NONE = {}

local function get(key, loader)
	local v = cache[key]
	if v ~= nil then
		return (v ~= NONE) and v or nil
	end
	while loading[key] do
		task.wait()
		v = cache[key]
		if v ~= nil then
			return (v ~= NONE) and v or nil
		end
	end
	loading[key] = true
	local ok, result = pcall(loader)
	loading[key] = nil
	if not ok then
		error(("AudioLab.Assets: %s: %s"):format(key, tostring(result)), 0)
	end
	cache[key] = (result == nil) and NONE or result
	return result
end

function Assets.file(path)
	return get("file:" .. path, function()
		return Importer.load(path)
	end)
end

function Assets.midi(path)
	return get("midi:" .. path, function()
		return Midi.decode(Assets.file(path))
	end)
end

function Assets.clip(path)
	return get("clip:" .. path, function()
		local clipPath = string.gsub(path, "%.%w+$", "")
		if Importer.hasClip(clipPath) then
			return Importer.loadClip(clipPath)
		end
		if Importer.has(path) then
			return (Encoder.encodeFile(Assets.file(path)))
		end
		if #sources == 0 and game:GetService("RunService"):IsClient() then
			local t0 = os.clock()
			while #sources == 0 and os.clock() - t0 < 10 do -- (a client runtime that adds one may still be starting)
				task.wait(0.1)
			end
		end
		for _, fn in ipairs(sources) do
			local ok, bytes = pcall(fn, clipPath)
			if ok and typeof(bytes) == "buffer" then
				return bytes
			end
		end
		return (Encoder.encodeFile(Assets.file(path)))
	end)
end

function Assets.bank(path)
	return get("bank:" .. path, function()
		if Importer.hasBank(path) then
			return Importer.loadBank(path)
		end
		return nil
	end)
end

function Assets.soundFont(path)
	return get("sf2:" .. path, function()
		return Sf2.decode(Assets.file(path))
	end)
end

function Assets.instruments(path)
	local bank = Assets.bank(path)
	if bank then
		return { Bank = bank }
	end
	-- not baked: analyse every sample now (yields), so nothing is analysed mid-song
	local built = get("built:" .. path, function()
		local Baker = require(AudioLab.Tools.Baker)
		return (Baker.build(Assets.soundFont(path)))
	end)
	return { Bank = built }
end

function Assets.preload(paths)
	for _, path in ipairs(paths) do
		local ext = string.lower(string.match(path, "%.(%w+)$") or "")
		if ext == "mid" or ext == "midi" then
			Assets.midi(path)
		elseif ext == "sf2" then
			Assets.instruments(path)
		else
			Assets.clip(path)
		end
	end
end

function Assets.clear(prefix)
	for key in pairs(cache) do
		if prefix == nil or string.find(key, prefix, 1, true) then
			cache[key] = nil
		end
	end
end

return Assets
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">Library</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[-- Track library for players and menus.
--
--   Library.list() -> { { id, title, folder, kind = "midi" | "clip", midi?, soundFont?, clip? } }
--       MIDI files are paired with the SoundFont (.sf2, baked bank preferred) in the same folder;
--       WAV/AIFF/MP3 files and stored clips are "clip" tracks. Test folders are skipped.
--   local c = Library.open(track, { Parent, Volume, Loop })   -- one controller for both kinds:
--       c:play(), c:pause(), c:resume(), c:stop(), c:seek(t), c:getTime(), c:getDuration(),
--       c:isPlaying(), c:setVolume(v), c:setLoop(bool), c.Ended, c:destroy()
--       MIDI only: c.channels() -> { [ch] = { notes, program, name, pan } }, c:setMute(ch, on),
--       c:setSolo(ch, on), c:activity(ch) -> 0..1, c.loopStart / c.loopEnd
--   While any controller plays (on a client), SoundService attribute AudioLabLocalMusic = true: synced world audio (TVs,
--   speakers) steps aside on this client so the player's own music gets the players (see Synth.Attach).

local AudioLab = script:FindFirstAncestor("AudioLab")
local Importer = require(AudioLab.Tools.Importer)
local Assets = require(AudioLab.Tools.Assets)
local MidiSynth = require(AudioLab.Synth.MidiSynth)
local Player = require(AudioLab.Synth.Player)

local Library = {}
local SKIP = { tests = true, selftest = true }

local function split(path)
	local folder, name = string.match(path, "^(.*)/([^/]+)$")
	return folder or "", name or path
end

function Library.list()
	local tracks = {}
	local files = Importer.list()
	local soundFonts = {}
	for _, path in ipairs(files) do
		local folder = split(path)
		if string.lower(string.match(path, "%.(%w+)$") or "") == "sf2" then
			soundFonts[folder] = soundFonts[folder] or path
		end
	end
	local clipsSeen = {}
	for _, path in ipairs(files) do
		local folder, name = split(path)
		local top = string.match(path, "^([^/]+)/") or ""
		if not SKIP[top] then
			local ext = string.lower(string.match(name, "%.(%w+)$") or "")
			local base = string.gsub(name, "%.%w+$", "")
			if ext == "mid" or ext == "midi" then
				table.insert(tracks, {
					id = path, kind = "midi", midi = path, soundFont = soundFonts[folder], folder = folder,
					title = (folder ~= "" and (folder .. " - ") or "") .. base,
				})
			elseif ext == "wav" or ext == "aif" or ext == "aiff" or ext == "aifc" or ext == "mp3" or ext == "flac" or ext == "ogg" or ext == "oga" then
				local clipPath = string.gsub(path, "%.%w+$", "")
				clipsSeen[clipPath] = true
				table.insert(tracks, { id = path, kind = "clip", clip = path, folder = folder, title = (folder ~= "" and (folder .. " - ") or "") .. base })
			end
		end
	end
	for _, path in ipairs(Importer.listClips()) do
		local top = string.match(path, "^([^/]+)/") or ""
		if not clipsSeen[path] and not SKIP[top] then
			local folder, name = split(path)
			table.insert(tracks, { id = "clip:" .. path, kind = "clip", clip = path, folder = folder, title = (folder ~= "" and (folder .. " - ") or "") .. name })
		end
	end
	table.sort(tracks, function(a, b)
		if a.kind ~= b.kind then
			return a.kind == "midi"
		end
		return a.title < b.title
	end)
	return tracks
end

local Controller = {}
Controller.__index = Controller

-- which controllers are playing: the player's own music, so world audio steps aside (Synth.Attach)
local playingSet = setmetatable({}, { __mode = "k" })
local function markPlaying(c, on)
	playingSet[c] = on and true or nil
	if not game:GetService("RunService"):IsClient() then
		return
	end
	local any = next(playingSet) ~= nil
	local SoundService = game:GetService("SoundService")
	if (SoundService:GetAttribute("AudioLabLocalMusic") == true) ~= any then
		SoundService:SetAttribute("AudioLabLocalMusic", any or nil)
	end
end

-- every controller playing on this client paused at once (watching a video: the player's own music steps aside) ->
-- the list paused, for Library.resumeAll(list), which resumes only those still paused (not ones stopped or restarted
-- by hand in between)
function Library.pauseAll()
	local paused = {}
	for c in pairs(playingSet) do
		if pcall(c.pause, c) then
			table.insert(paused, c)
		end
	end
	return paused
end
function Library.resumeAll(list)
	for _, c in ipairs(list or {}) do
		local ok, isPaused = pcall(c.isPaused, c)
		if ok and isPaused then
			pcall(c.resume, c)
		end
	end
end

function Library.open(track, options)
	options = options or {}
	local c = setmetatable({ track = track, loop = options.Loop == true }, Controller)
	if track.kind == "midi" then
		local midi = Assets.midi(track.midi)
		local inst = track.soundFont and Assets.instruments(track.soundFont) or {}
		c.midi = midi
		c.engine = MidiSynth.new({
			Parent = options.Parent, MasterGain = options.Volume or 1, Bank = inst.Bank, SoundFont = inst.SoundFont,
			Name = "AudioLabMusic_" .. tostring(track.title),
		})
		c.loopStart, c.loopEnd = MidiSynth.findLoop(midi)
		-- per channel summary: note count, first program, track name
		local info = {}
		for _, n in ipairs(midi.notes) do
			local ch = info[n.channel] or { notes = 0, program = n.program }
			ch.notes += 1
			info[n.channel] = ch
		end
		for _, tr in ipairs(midi.tracks) do
			for _, ev in ipairs(tr.events) do
				if ev.channel and info[ev.channel] then
					info[ev.channel].name = info[ev.channel].name or tr.name
					break
				end
			end
		end
		c._channels = info
	else
		local clip = Assets.clip(track.clip)
		c.engine = Player.new(clip, { Parent = options.Parent, MasterGain = options.Volume or 1, Name = "AudioLabMusic_" .. tostring(track.title) })
	end
	c.Ended = c.engine.Ended
	c.Ended:Connect(function()
		if not c.engine.playing then
			markPlaying(c, false)
		end
	end)
	return c
end

function Controller:play(startTime)
	markPlaying(self, true)
	if self.midi then
		self.engine:play(self.midi, { Loop = self.loop, StartTime = startTime })
	else
		self.engine:play({ Loop = self.loop, StartTime = startTime })
	end
end

function Controller:pause()
	self.engine:pause()
	markPlaying(self, false)
end

function Controller:resume()
	markPlaying(self, true)
	if self.engine.paused then
		self.engine:resume()
	elseif not self.engine.playing then
		self:play(self:getTime())
	end
end

function Controller:stop()
	markPlaying(self, false)
	self.engine:stop()
	self.engine.paused = false
	if self.engine.seek then
		self.engine:seek(0)
	end
end

function Controller:seek(t)
	local wasPlaying = self.engine.playing
	if self.midi then
		self.engine:seek(t)
	else
		self.engine:seek(t)
	end
	if not wasPlaying and not self.engine.paused then
		-- stopped: remember the position for the next play
		self.engine.time = t
	end
end

function Controller:getTime()
	return self.engine:getTime()
end

function Controller:getDuration()
	return self.engine:getDuration()
end

function Controller:isPlaying()
	return self.engine.playing == true
end

function Controller:isPaused()
	return self.engine.paused == true
end

function Controller:setVolume(v)
	if self.midi then
		self.engine.masterGain = v
	else
		self.engine.pool:setMasterGain(v)
	end
end

function Controller:setLoop(on)
	self.loop = on
	self.engine.loop = on
end

function Controller:channels()
	return self._channels or {}
end

function Controller:setMute(ch, on)
	if self.midi then
		self.engine:setMute(ch, on)
	end
end

function Controller:setSolo(ch, on)
	if self.midi then
		self.engine:setSolo(ch, on)
	end
end

function Controller:activity(ch)
	return self.midi and (self.engine.activity[ch] or 0) or 0
end

function Controller:destroy(gradual)
	markPlaying(self, false)
	self.engine:destroy(gradual)
end

return Library
]]></string>
