          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">Atlas</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Atlas manifest: sounds stored as regions of a few uploaded files ("packs"), played with AudioPlayer.LoopRegion. It is
-- the sound source of the Atlas profile (Codec.Manifests: AudioLab attribute Manifest = "Atlas"): a way to play AudioLab
-- from your own uploads, a few files instead of one per sound.
--
-- Making one: tools/audio/make_atlas.py packs the generic sounds of the repo's assets/audio into WAV files and writes
-- their entries (Atlas.packs.<name> = {...}; table.insert(Atlas.order, "<name>")). Upload the WAVs, paste the entries
-- below, put each file's asset id in its pack's `id`. A pack with no id is not used.
--
-- Layout inside a pack, in units (1 unit = 375 samples = 1/128 s at 48 kHz, an exact binary fraction, so every
-- boundary is sample-exact). Each sound is { pre, onset, body, len } (a one-shot: { pre, onset, onset, len, false }),
-- in units from the start of the file:
--   pre    units of silence just before the onset
--   onset  where the sound fades in (1 ms raised-cosine ramp)
--   body   where the loop body starts (one unit after the onset); the body is a whole number of cycles
--   len    loop body length: loop region = [body, body + len] (a one-shot plays once and stops len units after onset)
-- A player started d seconds before `onset` (0 <= d <= lead) begins its sound exactly d seconds late: that is how a
-- note starts inside a 21 ms audio block instead of on its edge.

local Atlas = {
	wired = true, -- the voice pool plays from loop regions (OscillatorPool: applyRegion); false = atlas profiles use their `fallback`
	order = {}, -- packs in the order they are used; a sound in two packs plays from the first
	packs = {},
}

-- your packs (the output of tools/audio/make_atlas.py) go here

-- Atlas.soundsOf(packName) = { name -> { id, pack, lead, onset, loopStart, loopEnd | stopAt } } with times in seconds,
-- or nil when that pack has no id yet (not uploaded). The same sound name can exist in several packs, so a profile asks
-- for its packs one by one.
local cache = {}
function Atlas.soundsOf(packName)
	local pack = Atlas.packs[packName]
	if not (pack and type(pack.id) == "string" and pack.id ~= "") then
		return nil
	end
	local key = packName .. "|" .. pack.id
	if cache[key] then
		return cache[key]
	end
	local out = {}
	local sec = pack.unit / pack.rate
	for name, seg in pairs(pack.segments) do
		local sound = { id = pack.id, pack = packName, lead = seg[1] * sec, onset = seg[2] * sec }
		if seg[5] == false then
			sound.stopAt = (seg[2] + seg[4]) * sec -- one-shot: plays once, the player stops here
		else
			sound.loopStart = seg[3] * sec
			sound.loopEnd = (seg[3] + seg[4]) * sec
		end
		out[name] = sound
	end
	cache[key] = out
	return out
end

-- Atlas.sounds: every uploaded pack of Atlas.order merged, the first pack of the order winning a shared name
Atlas.sounds = {}
for _, packName in ipairs(Atlas.order) do
	for name, sound in pairs(Atlas.soundsOf(packName) or {}) do
		if Atlas.sounds[name] == nil then
			Atlas.sounds[name] = sound
		end
	end
end

return Atlas
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="116">
          <Properties>
            <string name="Name">Texture</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- Texture codec ("RBA4"): short sound effects rebuilt from three kinds of generic, pre-uploaded sound pieces, each started
-- at an exact time:
--   bubbles  short tones that glide (water drops, rings, chirps): one of 120 generic tone shapes, at a speed (sets pitch
--            and length together) and a volume
--   clicks   sharp decaying octave-noise bursts (5 octaves x 3 decays x 3 variants)
--   grains   sine-windowed noise puffs on a fixed grid per band, one volume each: a half-octave set (15 bands, 44 Hz ..
--            5.7 kHz) and a sixth-octave set (34 bands, 40 Hz .. 2 kHz) that gives the lows their exact colour
-- plus a low-pass at the top of the original's own spectrum.
--
--   local bytes, stats = Texture.encode(signal, { Yield = task.wait, Progress = function(stage, frac) end })
--   Texture.isClip(bytes) / Texture.unpack(bytes) -> clip    Texture.LAYOUT (which upload file holds each piece, and where)
-- The generic upload files are tex_tones, tex_clicks, tex_grains2 and tex_loop; a kind in Texture.SplitSeconds is split into
-- tex_<kind>_NN files under that many seconds. Their ids are in Codec.Manifests.Files; Codec.Manifests puts every file of
-- Texture.LAYOUT.allFiles in its Core set (preloaded like the other generic files).
--
-- The analysis splits the sound into its steady tones and its noise (median filters
-- over the spectrogram), finds tone ridges and fits a tone shape to each (spectrogram matching), keeps a tone only if it
-- brings the rebuilt sound closer to the original where it plays AND explains far more than chance (phase-scrambled
-- copies), finds clicks in the noise (0.5 ms energy peaks per octave), and sets the grain volumes from what remains.

local AudioLab = script:FindFirstAncestor("AudioLab")
local FFT = require(AudioLab.DSP.FFT)

local Texture = {}
Texture.Magic = "RBA4"
Texture.Version = 2 -- (v2: two grain sets, tex_grains2)

local R = 48000
local PI = math.pi
local sqrt, log, exp, sin, cos, floor, abs, max, min = math.sqrt, math.log, math.exp, math.sin, math.cos, math.floor, math.abs,
	math.max, math.min
local LN10 = log(10)

-- (constant tables: filters as second-order sections {b0,b1,b2,a1,a2}, grain calibration, upload layout)
