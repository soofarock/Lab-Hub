	t29, t18 = (t29 * 799 - t18 * 4017 + 2048) // 4096, (-t29 * 4017 - t18 * 799 + 2048) // 4096
	t26, t21 = (t26 * 2276 + t21 * 3406 + 2048) // 4096, (t26 * 3406 - t21 * 2276 + 2048) // 4096
	t25, t22 = (t25 * 3406 - t22 * 2276 + 2048) // 4096, (-t25 * 2276 - t22 * 3406 + 2048) // 4096
	t0, t1 = (t0 * 2896 + t1 * 2896 + 2048) // 4096, (t0 * 2896 - t1 * 2896 + 2048) // 4096
