            <string name="Source"><![CDATA[--!native
--!optimize 2
-- FrameLab AV1 decoder, part 3: the one-dimensional inverse DCT (4 to 64 points) and ADST (8, 16 points)
-- butterflies. Each works in place on T[o + k * s], clamping the intermediate sums to lo .. hi.

local function idct4(T, o, s, lo, hi)
	local t0, t1, t2, t3 = T[o], T[o + 2 * s], T[o + 1 * s], T[o + 3 * s]
	local u, v
	t0, t1 = (t0 * 2896 + t1 * 2896 + 2048) // 4096, (t0 * 2896 - t1 * 2896 + 2048) // 4096
	t2, t3 = (t2 * 1567 - t3 * 3784 + 2048) // 4096, (t2 * 3784 + t3 * 1567 + 2048) // 4096
	u, v = t0 + t3, t0 - t3
	t0, t3 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t1 + t2, t1 - t2
	t1, t2 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	T[o], T[o + 1 * s], T[o + 2 * s], T[o + 3 * s] = t0, t1, t2, t3
end

local function idct8(T, o, s, lo, hi)
	local t0, t1, t2, t3, t4, t5, t6, t7 = T[o], T[o + 4 * s], T[o + 2 * s], T[o + 6 * s], T[o + 1 * s], T[o + 5 * s], T[o + 3 * s], T[o + 7 * s]
	local u, v
	t4, t7 = (t4 * 799 - t7 * 4017 + 2048) // 4096, (t4 * 4017 + t7 * 799 + 2048) // 4096
	t5, t6 = (t5 * 3406 - t6 * 2276 + 2048) // 4096, (t5 * 2276 + t6 * 3406 + 2048) // 4096
	t0, t1 = (t0 * 2896 + t1 * 2896 + 2048) // 4096, (t0 * 2896 - t1 * 2896 + 2048) // 4096
	t2, t3 = (t2 * 1567 - t3 * 3784 + 2048) // 4096, (t2 * 3784 + t3 * 1567 + 2048) // 4096
	u, v = t4 + t5, t4 - t5
	t4, t5 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t7 + t6, t7 - t6
	t7, t6 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t0 + t3, t0 - t3
	t0, t3 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t1 + t2, t1 - t2
	t1, t2 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	t6, t5 = (t6 * 2896 + t5 * 2896 + 2048) // 4096, (t6 * 2896 - t5 * 2896 + 2048) // 4096
	u, v = t0 + t7, t0 - t7
	t0, t7 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t1 + t6, t1 - t6
	t1, t6 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t2 + t5, t2 - t5
	t2, t5 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t3 + t4, t3 - t4
	t3, t4 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	T[o], T[o + 1 * s], T[o + 2 * s], T[o + 3 * s], T[o + 4 * s], T[o + 5 * s], T[o + 6 * s], T[o + 7 * s] = t0, t1, t2, t3, t4, t5, t6, t7
end

local function idct16(T, o, s, lo, hi)
