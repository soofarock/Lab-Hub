local function idct32(T, o, s, lo, hi)
	local t0, t1, t2, t3, t4, t5, t6, t7 = T[o], T[o + 16 * s], T[o + 8 * s], T[o + 24 * s], T[o + 4 * s], T[o + 20 * s], T[o + 12 * s], T[o + 28 * s]
