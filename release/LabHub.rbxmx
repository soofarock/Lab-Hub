	"36 -83 83 -36 -36 83 -83 36 36 -83 83 -36 -36 83 -83 36 36 -83 83 -36 -36 83 -83 36 36 -83 83 -36 -36 83 -83 36",
	"31 -78 90 -61 4 54 -88 82 -38 -22 73 -90 67 -13 -46 85 -85 46 13 -67 90 -73 22 38 -82 88 -54 -4 61 -90 78 -31",
