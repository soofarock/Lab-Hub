local Aac = {}

local readu8 = buffer.readu8
local lshift, rshift, byteswap, band = bit32.lshift, bit32.rshift, bit32.byteswap, bit32.band
local floor, sqrt, abs, sin, cos, pi, min, max = math.floor, math.sqrt, math.abs, math.sin, math.cos, math.pi, math.min, math.max

local function fail(msg)
	error("AAC: " .. msg, 0)
end

Aac.Rates = { 96000, 88200, 64000, 48000, 44100, 32000, 24000, 22050, 16000, 12000, 11025, 8000, 7350 }
local OBJECT_NAMES = { [1] = "AAC Main", [2] = "AAC-LC", [3] = "AAC SSR", [4] = "AAC LTP", [5] = "HE-AAC (SBR)", [6] = "AAC Scalable",
	[17] = "ER AAC-LC", [19] = "ER AAC LTP", [20] = "ER AAC Scalable", [22] = "ER BSAC", [23] = "AAC-LD", [29] = "HE-AAC v2 (PS)",
	[39] = "AAC-ELD", [42] = "xHE-AAC (USAC)" }

------------------------------------------------------------------------------------------------------------------------
-- bit reader over one access unit (copied into a padded work buffer)

local B = buffer.create(16)
local bitPos, bitEnd = 0, 0

local function load(src, pos, len)
	if buffer.len(B) < len + 8 then
		B = buffer.create(len + 1024)
	end
	buffer.fill(B, len, 0, 8)
	buffer.copy(B, 0, src, pos, len)
	bitPos, bitEnd = 0, len * 8
end

local function peek(n) -- n <= 24
	local v = byteswap(buffer.readu32(B, bitPos // 8))
	return rshift(lshift(v, bitPos % 8), 32 - n)
end

local function bits(n)
	if n == 0 then
		return 0
	end
	local v = rshift(lshift(byteswap(buffer.readu32(B, bitPos // 8)), bitPos % 8), 32 - n)
	bitPos += n
	return v
end

local function overread()
	if bitPos > bitEnd then
		fail("a frame is damaged (read past its end)")
	end
end

------------------------------------------------------------------------------------------------------------------------
-- Huffman tables: 8-bit lookups; an entry is symbol * 32 + bits used at that level, or -(sub-table index)

local LB = 8
local function buildHuff(codes, lens)
	local subs = {}
	local root = table.create(256, false)
	for i = 1, #codes do
		local len, code = lens[i], codes[i]
		local t, rem = root, len
		while rem > LB do
			local prefix = rshift(code, rem - LB) % 256
			local e = t[prefix + 1]
			if e == false then
				table.insert(subs, table.create(256, false))
				e = -#subs
				t[prefix + 1] = e
			end
			t = subs[-e]
			rem -= LB
			code = code % (2 ^ rem)
		end
		local shift = LB - rem
		local base = lshift(code, shift)
		for k = 0, 2 ^ shift - 1 do
			t[base + k + 1] = (i - 1) * 32 + rem
		end
	end
	return { root = root, subs = subs }
end

local function huff(h)
	local t = h.root
	while true do
		local e = t[peek(LB) + 1]
		if e == false then
			fail("a frame is damaged (bad Huffman code)")
		end
		if e >= 0 then
			bitPos += e % 32
			return e // 32
		end
		bitPos += LB
		t = h.subs[-e]
	end
end

local SF_HUFF = buildHuff(T.sfCodes, T.sfBits)
local SPEC_HUFF = {}
for i = 1, 11 do
	SPEC_HUFF[i] = buildHuff(T.spectral[i].codes, T.spectral[i].bits)
end

-- codebook shapes: dimension, values per digit (mod), signed offset (0 = unsigned)
local CB_DIM = { 4, 4, 4, 4, 2, 2, 2, 2, 2, 2, 2 }
local CB_MOD = { 3, 3, 3, 3, 9, 9, 8, 8, 13, 13, 17 }
local CB_OFF = { 1, 1, 0, 0, 4, 4, 0, 0, 0, 0, 0 }

-- |q|^(4/3)
local POW43 = table.create(8192 + 64, 0)
for q = 0, 8192 + 63 do
	POW43[q + 1] = q ^ (4 / 3)
end

------------------------------------------------------------------------------------------------------------------------
-- windows and the inverse MDCT

local function kbdRise(N, alpha)
	-- Kaiser-Bessel-derived window, rising half (N / 2 values)
	local function i0(x)
		local s, t, k = 1, 1, 1
		repeat
			t *= (x / (2 * k)) ^ 2
			s += t
			k += 1
		until t < s * 1e-12
		return s
	end
	local half = N // 2
	local w = table.create(half + 1, 0)
	local total = 0
	for j = 0, half do
		local r = (j - N / 4) / (N / 4)
		w[j + 1] = i0(pi * alpha * sqrt(max(0, 1 - r * r)))
		total += w[j + 1]
	end
	local out = table.create(half, 0)
	local acc = 0
	for n = 0, half - 1 do
		acc += w[n + 1]
		out[n + 1] = sqrt(acc / total)
	end
	return out
end
local function sineRise(N)
	local out = table.create(N // 2, 0)
	for n = 0, N // 2 - 1 do
		out[n + 1] = sin(pi / N * (n + 0.5))
	end
	return out
end
-- [shape + 1] = rising half; shape 0 = sine, 1 = KBD
local LONG_WIN = { sineRise(2048), kbdRise(2048, 4) }
local SHORT_WIN = { sineRise(256), kbdRise(256, 6) }

local plans = {}
local function plan(N)
	local p = plans[N]
	if p then
		return p
	end
	local M = N // 2
	local H = M // 2 -- complex FFT size
	local tc, ts = table.create(H, 0), table.create(H, 0)
	for j = 0, H - 1 do
		local a = -pi * (j + 0.125) / M
		tc[j + 1], ts[j + 1] = cos(a), sin(a)
	end
	local rev = table.create(H, 0)
	local logn = 0
	while 2 ^ logn < H do
		logn += 1
	end
	for i = 0, H - 1 do
		local r, x = 0, i
		for _ = 1, logn do
			r = r * 2 + x % 2
			x = x // 2
		end
		rev[i + 1] = r
	end
	-- twiddles for the FFT stages: w^k = exp(-2 pi i k / H)
	local wc, ws = table.create(H // 2, 0), table.create(H // 2, 0)
	for k = 0, H // 2 - 1 do
		wc[k + 1], ws[k + 1] = cos(-2 * pi * k / H), sin(-2 * pi * k / H)
	end
	p = { M = M, H = H, tc = tc, ts = ts, rev = rev, wc = wc, ws = ws, re = table.create(H, 0), im = table.create(H, 0),
		c = table.create(M, 0) }
	plans[N] = p
	return p
end

-- X[xo + 1 .. xo + N/2] -> out[oo + 1 .. oo + N], scaled by 2 / N (ISO 14496-3 4.6.18)
local function imdct(X, xo, N, out, oo)
	local p = plan(N)
	local M, H = p.M, p.H
	local tc, ts, rev, re, im, c = p.tc, p.ts, p.rev, p.re, p.im, p.c
	for j = 0, H - 1 do
		local a, b = X[xo + 2 * j + 1], X[xo + M - 2 * j]
		local cc, ss = tc[j + 1], ts[j + 1]
		local r = rev[j + 1] + 1
		re[r] = a * cc - b * ss
		im[r] = a * ss + b * cc
	end
	-- radix-2 FFT (decimation in time, input already bit-reversed)
	local wc, ws = p.wc, p.ws
	local size = 2
	while size <= H do
		local half = size // 2
		local step = H // size
		for start = 0, H - 1, size do
			for k = 0, half - 1 do
				local w = k * step + 1
				local cr, ci = wc[w], ws[w]
				local i1 = start + k + 1
				local i2 = i1 + half
				local xr, xi = re[i2], im[i2]
				local tr = xr * cr - xi * ci
				local ti = xr * ci + xi * cr
				local ur, ui = re[i1], im[i1]
				re[i1], im[i1] = ur + tr, ui + ti
				re[i2], im[i2] = ur - tr, ui - ti
			end
		end
		size *= 2
	end
	for j = 0, H - 1 do
		local cc, ss = tc[j + 1], ts[j + 1]
		local zr, zi = re[j + 1], im[j + 1]
		c[2 * j + 1] = zr * cc - zi * ss
		c[M - 2 * j] = -(zr * ss + zi * cc)
	end
	local scale = 2 / N
	local h = M // 2
	for n = 0, N - 1 do
		local q = n + h
		local v
		if q < M then
			v = c[q + 1]
		elseif q < 2 * M then
			v = -c[2 * M - q]
		else
			v = -c[q - 2 * M + 1]
		end
		out[oo + n + 1] = v * scale
	end
end
Aac.imdct = imdct

------------------------------------------------------------------------------------------------------------------------
-- one channel's spectrum (individual_channel_stream)

local ONLY_LONG, LONG_START, EIGHT_SHORT, LONG_STOP = 0, 1, 2, 3
local ZERO_HCB, NOISE_HCB, INTENSITY_HCB2, INTENSITY_HCB = 0, 13, 14, 15

local function newIcs()
	return { seq = 0, shape = 0, maxSfb = 0, numWindows = 1, numGroups = 1, groupLen = table.create(8, 1), swb = nil, numSwb = 0,
		tnsMax = 0 }
end

local function newChannel()
	return {
		ics = newIcs(),
		bandType = table.create(8 * 64, 0),
		scale = table.create(8 * 64, 0), -- per (group, band): dequantisation gain / noise energy / intensity gain
		q = table.create(1024, 0),
		coef = table.create(1024, 0),
		tns = { n = table.create(8, 0), length = {}, order = {}, dir = {}, coef = {} },
		tnsPresent = false,
		prevShape = 0,
		overlap = table.create(1024, 0),
		win = table.create(2048, 0),
	}
end

local function readIcsInfo(dec, ics)
	bits(1) -- reserved
	ics.seq = bits(2)
	ics.shape = bits(1)
	local sfi = dec.sfi
	if ics.seq == EIGHT_SHORT then
		ics.maxSfb = bits(4)
		local g = 1
		ics.groupLen[1] = 1
		for _ = 1, 7 do
			if bits(1) == 1 then
				ics.groupLen[g] += 1
			else
				g += 1
				ics.groupLen[g] = 1
			end
		end
		ics.numGroups = g
		ics.numWindows = 8
		ics.swb, ics.numSwb, ics.tnsMax = T.swb128[sfi], T.numSwb128[sfi], T.tnsMax128[sfi]
	else
		ics.maxSfb = bits(6)
		ics.numGroups, ics.numWindows = 1, 1
		ics.groupLen[1] = 1
		ics.swb, ics.numSwb, ics.tnsMax = T.swb1024[sfi], T.numSwb1024[sfi], T.tnsMax1024[sfi]
		if bits(1) == 1 then
			fail("this stream uses prediction (AAC Main / LTP), which isn't supported; re-save the sound as AAC-LC")
		end
	end
	if ics.maxSfb > ics.numSwb then
		fail("a frame is damaged (too many scale factor bands)")
	end
end

local function copyIcs(dst, src)
	dst.seq, dst.shape, dst.maxSfb, dst.numWindows, dst.numGroups = src.seq, src.shape, src.maxSfb, src.numWindows, src.numGroups
	dst.swb, dst.numSwb, dst.tnsMax = src.swb, src.numSwb, src.tnsMax
	for i = 1, 8 do
		dst.groupLen[i] = src.groupLen[i]
	end
end

local rand = 0x1f2e3d4c
local function nextRandom()
	rand = (rand * 1664525 + 1013904223) % 4294967296
	return rand >= 2147483648 and rand - 4294967296 or rand
end

local function readIcs(dec, ch, commonWindow)
	local ics = ch.ics
	local globalGain = bits(8)
	if not commonWindow then
		readIcsInfo(dec, ics)
	end
	local maxSfb, numGroups, swb = ics.maxSfb, ics.numGroups, ics.swb
	local bandType, scale = ch.bandType, ch.scale
	-- section data
	local sectBits = ics.seq == EIGHT_SHORT and 3 or 5
	local esc = 2 ^ sectBits - 1
	for g = 0, numGroups - 1 do
		local k = 0
		while k < maxSfb do
			local cb = bits(4)
			if cb == 12 then
				fail("a frame is damaged (band type 12)")
			end
			local stop = k
			local inc
			repeat
				inc = bits(sectBits)
				stop += inc
				overread()
			until inc ~= esc
			if stop > maxSfb then
				fail("a frame is damaged (section runs past the last band)")
			end
			for b = k, stop - 1 do
				bandType[g * maxSfb + b + 1] = cb
			end
			k = stop
		end
	end
	-- scale factors
	local off0, off1, off2 = globalGain, globalGain - 90, 0
	local firstNoise = true
	for g = 0, numGroups - 1 do
		for b = 0, maxSfb - 1 do
			local i = g * maxSfb + b + 1
			local cb = bandType[i]
			if cb == ZERO_HCB then
				scale[i] = 0
			elseif cb == INTENSITY_HCB or cb == INTENSITY_HCB2 then
				off2 += huff(SF_HUFF) - 60
				local p = math.clamp(off2, -155, 100)
				scale[i] = 2 ^ (-0.25 * p)
			elseif cb == NOISE_HCB then
				if firstNoise then
					off1 += bits(9) - 256
					firstNoise = false
				else
					off1 += huff(SF_HUFF) - 60
				end
				local p = math.clamp(off1, -100, 155)
				scale[i] = 2 ^ (0.25 * p)
			else
				off0 += huff(SF_HUFF) - 60
				if off0 < 0 or off0 > 255 then
					fail("a frame is damaged (scale factor out of range)")
				end
				scale[i] = 2 ^ (0.25 * (off0 - 100))
			end
		end
	end
	-- pulses
	local npulse = 0
	local ppos, pamp = dec.ppos, dec.pamp
	if bits(1) == 1 then
		if ics.seq == EIGHT_SHORT then
			fail("a frame is damaged (pulses in a short window)")
		end
		npulse = bits(2) + 1
		local startBand = bits(6)
		if startBand >= ics.numSwb then
			fail("a frame is damaged (pulse band)")
		end
		local pos = swb[startBand + 1]
		for p = 1, npulse do
			pos += bits(5)
			if pos >= 1024 then
				fail("a frame is damaged (pulse position)")
			end
			ppos[p] = pos
			pamp[p] = bits(4)
		end
	end
	-- temporal noise shaping
	ch.tnsPresent = bits(1) == 1
	if ch.tnsPresent then
		local tns = ch.tns
		local short = ics.seq == EIGHT_SHORT
		local maxOrder = short and 7 or 12
		for w = 1, ics.numWindows do
			local nf = bits(short and 1 or 2)
			tns.n[w] = nf
			if nf > 0 then
				local res = bits(1)
				tns.length[w] = tns.length[w] or {}
				tns.order[w] = tns.order[w] or {}
				tns.dir[w] = tns.dir[w] or {}
				tns.coef[w] = tns.coef[w] or {}
				for f = 1, nf do
					tns.length[w][f] = bits(short and 4 or 6)
					local order = bits(short and 3 or 5)
					if order > maxOrder then
						fail("a frame is damaged (TNS order)")
					end
					tns.order[w][f] = order
					if order > 0 then
						tns.dir[w][f] = bits(1)
						local compress = bits(1)
						local len = res + 3 - compress
						local map = T.tns[2 * compress + res + 1]
						local cf = tns.coef[w][f] or table.create(20, 0)
						tns.coef[w][f] = cf
						for i = 1, order do
							cf[i] = map[bits(len) + 1]
						end
					end
				end
			end
		end
	end
	if bits(1) == 1 then
		fail("this stream uses gain control (AAC SSR), which isn't supported")
	end
	-- spectral data (quantised values)
	local q = ch.q
	for i = 1, 1024 do
		q[i] = 0
	end
	local base = 0 -- first window of the group
	for g = 0, numGroups - 1 do
		local glen = ics.groupLen[g + 1]
		for b = 0, maxSfb - 1 do
			local cb = bandType[g * maxSfb + b + 1]
			local a, e = swb[b + 1], swb[b + 2]
			if cb >= 1 and cb <= 11 then
				local h = SPEC_HUFF[cb]
				local dim, mod, offs = CB_DIM[cb], CB_MOD[cb], CB_OFF[cb]
				for w = 0, glen - 1 do
					local o = (base + w) * 128
					local k = a
					while k < e do
						local idx = huff(h)
						if dim == 4 then
							local v1, v2, v3, v4 = idx // 27, (idx // 9) % 3, (idx // 3) % 3, idx % 3
							if offs > 0 then
								q[o + k + 1], q[o + k + 2], q[o + k + 3], q[o + k + 4] = v1 - 1, v2 - 1, v3 - 1, v4 - 1
							else
								if v1 ~= 0 and bits(1) == 1 then
									v1 = -v1
								end
								if v2 ~= 0 and bits(1) == 1 then
									v2 = -v2
								end
								if v3 ~= 0 and bits(1) == 1 then
									v3 = -v3
								end
								if v4 ~= 0 and bits(1) == 1 then
									v4 = -v4
								end
								q[o + k + 1], q[o + k + 2], q[o + k + 3], q[o + k + 4] = v1, v2, v3, v4
							end
							k += 4
						else
							local v1, v2 = idx // mod, idx % mod
							if offs > 0 then
								q[o + k + 1], q[o + k + 2] = v1 - offs, v2 - offs
							else
								local n1 = v1 ~= 0 and bits(1) == 1
								local n2 = v2 ~= 0 and bits(1) == 1
								if cb == 11 then
									if v1 == 16 then
										local n = 0
										while bits(1) == 1 do
											n += 1
											if n > 8 then
												fail("a frame is damaged (escape too long)")
											end
										end
										v1 = 2 ^ (n + 4) + bits(n + 4)
									end
									if v2 == 16 then
										local n = 0
										while bits(1) == 1 do
											n += 1
											if n > 8 then
												fail("a frame is damaged (escape too long)")
											end
										end
										v2 = 2 ^ (n + 4) + bits(n + 4)
									end
								end
								q[o + k + 1] = n1 and -v1 or v1
								q[o + k + 2] = n2 and -v2 or v2
							end
							k += 2
						end
					end
				end
			end
		end
		base += glen
	end
	overread()
	for p = 1, npulse do
		local i = ppos[p] + 1
		local v = q[i]
		q[i] = v > 0 and v + pamp[p] or v - pamp[p]
	end
	-- dequantise; noise bands get scaled noise
	local coef = ch.coef
	for i = 1, 1024 do
		coef[i] = 0
	end
	base = 0
	for g = 0, numGroups - 1 do
		local glen = ics.groupLen[g + 1]
		for b = 0, maxSfb - 1 do
			local i = g * maxSfb + b + 1
			local cb, s = bandType[i], scale[i]
			local a, e = swb[b + 1], swb[b + 2]
			if cb >= 1 and cb <= 11 then
				for w = 0, glen - 1 do
					local o = (base + w) * 128
					for k = o + a + 1, o + e do
						local v = q[k]
						if v ~= 0 then
							if v > 0 then
								coef[k] = (POW43[v + 1] or v ^ (4 / 3)) * s
							else
								coef[k] = -(POW43[1 - v] or (-v) ^ (4 / 3)) * s
							end
						end
					end
				end
			elseif cb == NOISE_HCB then
				for w = 0, glen - 1 do
					local o = (base + w) * 128
					local energy = 0
					for k = o + a + 1, o + e do
						local r = nextRandom()
						coef[k] = r
						energy += r * r
					end
					local f = s / sqrt(energy)
					for k = o + a + 1, o + e do
						coef[k] *= f
					end
				end
			end
		end
		base += glen
	end
end

-- all-pole TNS filters over the spectrum (ISO 14496-3 4.6.9)
local lpc, lpcTmp = table.create(20, 0), table.create(20, 0)
local function applyTns(ch)
	local ics, tns, coef = ch.ics, ch.tns, ch.coef
	local mmm = min(ics.tnsMax, ics.maxSfb)
	if mmm == 0 then
		return
	end
	local swb = ics.swb
	for w = 1, ics.numWindows do
		local bottom = ics.numSwb
		for f = 1, tns.n[w] do
			local top = bottom
			bottom = max(0, top - tns.length[w][f])
			local order = tns.order[w][f]
			if order > 0 then
				-- reflection coefficients -> LPC
				local cf = tns.coef[w][f]
				for i = 0, order - 1 do
					local r = -cf[i + 1]
					for j = 1, i do
						lpcTmp[j] = lpc[j]
					end
					lpc[i + 1] = r
					for j = 0, (i + 1) // 2 - 1 do
						local fwd, bwd = lpcTmp[j + 1], lpcTmp[i - j]
						lpc[j + 1] = fwd + r * bwd
						lpc[i - j] = bwd + r * fwd
					end
				end
				local start = swb[min(bottom, mmm) + 1]
				local stop = swb[min(top, mmm) + 1]
				local size = stop - start
				if size > 0 then
					local inc = 1
					if tns.dir[w][f] == 1 then
						inc = -1
						start = stop - 1
					end
					start += (w - 1) * 128
					for m = 0, size - 1 do
						local idx = start + m * inc + 1
						local v = coef[idx]
						for i = 1, min(m, order) do
							v -= coef[idx - i * inc] * lpc[i]
						end
						coef[idx] = v
					end
				end
			end
		end
	end
end

-- inverse MDCT, windowing and overlap-add: 1024 new samples into out[1 .. 1024]
local function synthesize(ch, out)
	local ics = ch.ics
	local seq, shape, prev = ics.seq, ics.shape, ch.prevShape
	local coef, win, overlap = ch.coef, ch.win, ch.overlap
	if seq == EIGHT_SHORT then
		for i = 1, 2048 do
			win[i] = 0
		end
		local tmp = ch.shortTmp or table.create(256, 0)
		ch.shortTmp = tmp
		local cur = SHORT_WIN[shape + 1]
		for w = 0, 7 do
			imdct(coef, w * 128, 256, tmp, 0)
			local left = w == 0 and SHORT_WIN[prev + 1] or cur
			local o = 448 + w * 128
			for n = 0, 127 do
				win[o + n + 1] += tmp[n + 1] * left[n + 1]
				win[o + 128 + n + 1] += tmp[128 + n + 1] * cur[128 - n]
			end
		end
	else
		imdct(coef, 0, 2048, win, 0)
		if seq == LONG_STOP then
			local left = SHORT_WIN[prev + 1]
			for n = 0, 447 do
				win[n + 1] = 0
			end
			for n = 0, 127 do
				win[448 + n + 1] *= left[n + 1]
			end
		else
			local left = LONG_WIN[prev + 1]
			for n = 0, 1023 do
				win[n + 1] *= left[n + 1]
			end
		end
		if seq == LONG_START then
			local right = SHORT_WIN[shape + 1]
			for n = 0, 127 do
				win[1472 + n + 1] *= right[128 - n]
			end
			for n = 1600, 2047 do
				win[n + 1] = 0
			end
		else
			local right = LONG_WIN[shape + 1]
			for n = 0, 1023 do
				win[1024 + n + 1] *= right[1024 - n]
			end
		end
	end
	for n = 1, 1024 do
		out[n] = win[n] + overlap[n]
		overlap[n] = win[1024 + n]
	end
	ch.prevShape = shape
end

------------------------------------------------------------------------------------------------------------------------
-- configuration

local function readConfigBits()
	local ot = bits(5)
	if ot == 31 then
		ot = 32 + bits(6)
	end
	return ot
end
local function readRate()
	local i = bits(4)
	if i == 15 then
		return nil, bits(12) * 4096 + bits(12)
	end
	return i, Aac.Rates[i + 1]
end

-- AudioSpecificConfig (the decoder setup stored in MP4 'esds') -> config
function Aac.parseConfig(asc)
	local b = type(asc) == "string" and buffer.fromstring(asc) or asc
	load(b, 0, buffer.len(b))
	local cfg = {}
	cfg.objectType = readConfigBits()
	local sfi, rate = readRate()
	cfg.channelConfig = bits(4)
	if cfg.objectType == 5 or cfg.objectType == 29 then
		cfg.sbr = true
		cfg.ps = cfg.objectType == 29
		local _, extRate = readRate()
		cfg.extensionRate = extRate
		cfg.objectType = readConfigBits()
	end
	cfg.sfi, cfg.sampleRate = sfi, rate
	local ot = cfg.objectType
	if ot ~= 2 and ot ~= 1 and ot ~= 4 then
		fail(("%s sound isn't supported (only AAC-LC and HE-AAC are)"):format(OBJECT_NAMES[ot] or ("object type " .. ot)))
	end
	-- GASpecificConfig
	if bits(1) == 1 then
		fail("960-sample frames aren't supported")
	end
	if bits(1) == 1 then
		bits(14) -- core coder delay
	end
	bits(1) -- extension flag
	if not sfi then
		-- an explicit rate: the nearest standard rate's tables
		local best, bi = math.huge, 4
		for i, r in ipairs(Aac.Rates) do
			if abs(r - rate) < best then
				best, bi = abs(r - rate), i - 1
			end
		end
		sfi = bi
		cfg.sfi = sfi
	end
	return cfg
end

-- skip a program_config_element
local function skipPce()
	bits(4) -- object type
	bits(4) -- sampling index
	local front, side, back, lfe, assoc, cc = bits(4), bits(4), bits(4), bits(2), bits(3), bits(4)
	if bits(1) == 1 then
		bits(4)
	end
	if bits(1) == 1 then
		bits(4)
	end
	if bits(1) == 1 then
		bits(3)
	end
	bitPos += (front + side + back) * 5 + lfe * 4 + assoc * 4 + cc * 5
	bitPos = (bitPos + 7) // 8 * 8
	bitPos += bits(8) * 8
end

------------------------------------------------------------------------------------------------------------------------
-- decoder

local Decoder = {}
Decoder.__index = Decoder

-- config: parseConfig output, or the AudioSpecificConfig bytes
function Aac.new(config)
	if type(config) ~= "table" then
		config = Aac.parseConfig(config)
	end
	local self = setmetatable({}, Decoder)
	self.config = config
	self.sfi = config.sfi + 1
	self.sampleRate = config.sampleRate
	self.elements = {} -- [type * 16 + tag + 1] = { channels }
	self.ppos, self.pamp = table.create(4, 0), table.create(4, 0)
	self.bufs = {}
	return self
end

local function element(self, kind, tag, n)
	local key = kind * 16 + tag + 1
	local e = self.elements[key]
	if not e then
		e = { kind = kind, tag = tag, ch = {}, out = {} }
		for i = 1, n do
			e.ch[i] = newChannel()
			e.out[i] = table.create(1024, 0)
		end
		self.elements[key] = e
	end
	return e
end

-- one raw AAC frame (an MP4 sample); returns left, right (arrays of 1024 samples, -1..1; right == left for mono)
function Decoder:decodeFrame(buf, pos, len)
	load(buf, pos, len)
	local decoded = {}
	while true do
		if bitPos + 3 > bitEnd then
			break
		end
		local id = bits(3)
		if id == 7 then
			break
		elseif id == 0 or id == 3 then -- SCE, LFE
			local e = element(self, id, bits(4), 1)
			readIcs(self, e.ch[1], false)
			if e.ch[1].tnsPresent then
				applyTns(e.ch[1])
			end
			synthesize(e.ch[1], e.out[1])
			table.insert(decoded, e)
		elseif id == 1 then -- CPE
			local e = element(self, id, bits(4), 2)
			local c0, c1 = e.ch[1], e.ch[2]
			local common = bits(1) == 1
			local msPresent = 0
			local ms = e.ms or table.create(8 * 64, 0)
			e.ms = ms
			if common then
				readIcsInfo(self, c0.ics)
				copyIcs(c1.ics, c0.ics)
				msPresent = bits(2)
				local n = c0.ics.numGroups * c0.ics.maxSfb
				if msPresent == 1 then
					for i = 1, n do
						ms[i] = bits(1)
					end
				elseif msPresent == 2 then
					for i = 1, n do
						ms[i] = 1
					end
				elseif msPresent == 3 then
					fail("a frame is damaged (ms_mask_present 3)")
				end
			end
			readIcs(self, c0, common)
			readIcs(self, c1, common)
			local ics = c1.ics
			local swb, maxSfb = ics.swb, ics.maxSfb
			if common and msPresent > 0 then
				local base = 0
				for g = 0, ics.numGroups - 1 do
					local glen = ics.groupLen[g + 1]
					for b = 0, maxSfb - 1 do
						local i = g * maxSfb + b + 1
						if ms[i] == 1 and c0.bandType[i] < NOISE_HCB and c1.bandType[i] < NOISE_HCB then
							for w = 0, glen - 1 do
								local o = (base + w) * 128
								local l, r = c0.coef, c1.coef
								for k = o + swb[b + 1] + 1, o + swb[b + 2] do
									local m, s = l[k], r[k]
									l[k], r[k] = m + s, m - s
								end
							end
						end
					end
					base += glen
				end
			end
			-- intensity stereo: the right channel's band is the left one scaled
			local base = 0
			for g = 0, ics.numGroups - 1 do
				local glen = ics.groupLen[g + 1]
				for b = 0, maxSfb - 1 do
					local i = g * maxSfb + b + 1
					local cb = c1.bandType[i]
					if cb == INTENSITY_HCB or cb == INTENSITY_HCB2 then
						local c = cb == INTENSITY_HCB and 1 or -1
						if msPresent > 0 and ms[i] == 1 then
							c = -c
						end
						local s = c * c1.scale[i]
						for w = 0, glen - 1 do
							local o = (base + w) * 128
							local l, r = c0.coef, c1.coef
							for k = o + swb[b + 1] + 1, o + swb[b + 2] do
								r[k] = l[k] * s
							end
						end
					end
				end
				base += glen
			end
			for k = 1, 2 do
				if e.ch[k].tnsPresent then
					applyTns(e.ch[k])
				end
				synthesize(e.ch[k], e.out[k])
			end
			table.insert(decoded, e)
		elseif id == 2 then
			fail("coupling channels (CCE) aren't supported")
		elseif id == 4 then -- DSE
			bits(4)
			local align = bits(1)
			local count = bits(8)
			if count == 255 then
				count += bits(8)
			end
			if align == 1 then
				bitPos = (bitPos + 7) // 8 * 8
			end
			bitPos += count * 8
		elseif id == 5 then
			skipPce()
		elseif id == 6 then -- FIL (SBR data lives here; the core is decoded without it)
			local count = bits(4)
			if count == 15 then
				count += bits(8) - 1
			end
			bitPos += count * 8
		end
		overread()
	end
	-- mix to stereo: the first pair is left / right, a single channel goes to both, others are folded in
	local L, R = self.bufs[1], self.bufs[2]
	if not L then
		L, R = table.create(1024, 0), table.create(1024, 0)
		self.bufs[1], self.bufs[2] = L, R
	end
	for n = 1, 1024 do
		L[n], R[n] = 0, 0
	end
	local stereo = false
	local mainUsed = false
	for _, e in ipairs(decoded) do
		if e.kind ~= 3 then
			local g = mainUsed and 0.7071 or 1
			if e.kind == 1 then
				local a, b = e.out[1], e.out[2]
				for n = 1, 1024 do
					L[n] += a[n] * g
					R[n] += b[n] * g
				end
				stereo = true
			else
				local a = e.out[1]
				for n = 1, 1024 do
					L[n] += a[n] * g
					R[n] += a[n] * g
				end
			end
			mainUsed = true
		end
	end
	local s = 1 / 32768
	for n = 1, 1024 do
		L[n] *= s
		R[n] *= s
	end
	return L, R, stereo, #decoded > 0
end

-- frames: { { pos, size } ... } in buf; options: Yield, MaxSeconds, Skip (samples to drop at the start: encoder delay)
-- -> signal { sampleRate, channels, length, data = { f32 buffers } } (AudioLab DSP.Signal layout)
function Aac.decodeFrames(config, buf, frames, options)
	options = options or {}
	local dec = Aac.new(config)
	local rate = dec.sampleRate
	local skip = options.Skip or 0
	local maxSamples = options.MaxSeconds and floor(options.MaxSeconds * rate) or math.huge
	local total = min(#frames * 1024 - skip, maxSamples)
	if total <= 0 then
		fail("the sound has no frames")
	end
	local left, right = buffer.create(total * 4), buffer.create(total * 4)
	local written = 0
	local stereo = false
	local t0 = os.clock()
	for i, f in ipairs(frames) do
		if written >= total then
			break
		end
		local ok, L, R, st = pcall(dec.decodeFrame, dec, buf, f.pos, f.size)
		if not ok then
			error(("%s (frame %d of %d)"):format(tostring(L), i, #frames), 0)
		end
		stereo = stereo or st
		for n = 1, 1024 do
			if skip > 0 then
				skip -= 1
			elseif written < total then
				buffer.writef32(left, written * 4, L[n])
				buffer.writef32(right, written * 4, R[n])
				written += 1
			end
		end
		if options.Yield and os.clock() - t0 > 0.02 then
			options.Yield()
			t0 = os.clock()
		end
	end
	local data = stereo and { left, right } or { left }
	return { sampleRate = rate, channels = #data, length = written, data = data }
end

-- ADTS stream (a raw .aac file) -> frames + config
function Aac.isAdts(bytes)
	local b = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	return buffer.len(b) >= 7 and readu8(b, 0) == 0xFF and band(readu8(b, 1), 0xF6) == 0xF0
end

function Aac.parseAdts(bytes)
	local b = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	local len = buffer.len(b)
	local pos = 0
	local frames = {}
	local cfg
	while pos + 7 <= len do
		if readu8(b, pos) ~= 0xFF or band(readu8(b, pos + 1), 0xF6) ~= 0xF0 then
			break
		end
		local protectionAbsent = band(readu8(b, pos + 1), 1)
		local b2, b3, b4, b5, b6 = readu8(b, pos + 2), readu8(b, pos + 3), readu8(b, pos + 4), readu8(b, pos + 5), readu8(b, pos + 6)
		local profile = rshift(b2, 6) + 1
		local sfi = band(rshift(b2, 2), 15)
		local chc = band(b2, 1) * 4 + rshift(b3, 6)
		local flen = band(b3, 3) * 2048 + b4 * 8 + rshift(b5, 5)
		local blocks = band(b6, 3) + 1
		if blocks ~= 1 then
			fail("ADTS frames with several raw blocks aren't supported")
		end
		local head = protectionAbsent == 1 and 7 or 9
		if flen < head or pos + flen > len then
			break
		end
		if not cfg then
			if profile ~= 2 and profile ~= 1 then
				fail(("%s sound isn't supported (only AAC-LC is)"):format(OBJECT_NAMES[profile] or ("profile " .. profile)))
			end
			cfg = { objectType = profile, sfi = sfi, sampleRate = Aac.Rates[sfi + 1], channelConfig = chc }
		end
		table.insert(frames, { pos = pos + head, size = flen - head })
		pos += flen
	end
	if not cfg then
		fail("no ADTS frames found")
	end
	return cfg, frames
end

return Aac
]]></string>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">Opus</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <ContentId name="LinkedSource">
              <null>
              </null>
            </ContentId>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <string name="Source"><![CDATA[--!native
--!optimize 2
-- Opus decoder (RFC 6716): SILK (speech), CELT (music) and hybrid frames, mono or stereo, decoded to 48 kHz.
-- Opus streams arrive in MP4 / M4A (sample entry "Opus", from Formats.Mp4 on the FrameLab side) and in Ogg (.opus).
--
--   local st = Opus.new(channels)                                  -- output channels (1 or 2)
--   local n = Opus.decodePacket(st, buf, offset, length, out, outOff) -- out[c][outOff + 1 ..] gets n samples (-1..1)
--   local signal = Opus.decodeOgg(bytes, options?)                 -- a whole .opus file -> DSP.Signal (48 kHz)
--   local signal = Opus.decodePackets(list, channels, preSkip, options?, gainDb?) -- list of { buf, offset, length }
--   Opus.readDops(buffer, from, to) -> { channels, preSkip, gainDb, mapping, streams }   -- MP4 Opus setup box
--   Opus.isOgg(bytes)
-- options: Yield (function called now and then), MaxSeconds
--
-- Ported from libopus 1.5 (https://opus-codec.org), which carries this notice:
--   Copyright (c) 2001-2011 Xiph.Org, Skype Limited, Octasic, Jean-Marc Valin, Timothy B. Terriberry, CSIRO,
--   Gregory Maxwell, Mark Borgerding, Erik de Castro Lopo. Redistribution and use in source and binary forms, with or
--   without modification, are permitted provided that the following conditions are met: redistributions of source
--   code must retain the above copyright notice, this list of conditions and the following disclaimer; redistributions
--   in binary form must reproduce the above copyright notice, this list of conditions and the following disclaimer in
--   the documentation and/or other materials provided with the distribution; neither the name of Internet Society,
--   IETF or IETF Trust, nor the names of specific contributors, may be used to endorse or promote products derived
--   from this software without specific prior written permission. THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS
--   AND CONTRIBUTORS "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED
--   WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT
--   OWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES
--   (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR
--   BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
--   (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF THE
--   POSSIBILITY OF SUCH DAMAGE.

local Opus = {}

local Entropy, Celt, Silk
if script then
	Entropy = require(script.Entropy)
	Celt = require(script.Celt)
	Silk = require(script.Silk)
else
	Entropy = require("@self/Entropy")
	Celt = require("@self/Celt")
	Silk = require("@self/Silk")
end

local MODE_SILK, MODE_HYBRID, MODE_CELT = 1000, 1001, 1002
local BW_NB, BW_MB, BW_WB, BW_SWB, BW_FB = 1, 2, 3, 4, 5
local FS = 48000
local F20, F10, F5, F2_5 = 960, 480, 240, 120
local WINDOW
do
	local T = if script then require(script.CeltTables) else require("@self/CeltTables")
	WINDOW = T.window
end

local function packetMode(toc)
	if bit32.band(toc, 0x80) ~= 0 then
		return MODE_CELT
	elseif bit32.band(toc, 0x60) == 0x60 then
		return MODE_HYBRID
	end
	return MODE_SILK
end

local function packetBandwidth(toc)
	if bit32.band(toc, 0x80) ~= 0 then
		local bw = BW_MB + bit32.band(bit32.rshift(toc, 5), 3)
		if bw == BW_MB then
			bw = BW_NB
		end
		return bw
	elseif bit32.band(toc, 0x60) == 0x60 then
		return bit32.band(toc, 0x10) ~= 0 and BW_FB or BW_SWB
	end
	return BW_NB + bit32.band(bit32.rshift(toc, 5), 3)
end

local function samplesPerFrame(toc)
	if bit32.band(toc, 0x80) ~= 0 then
		return (FS * 2 ^ bit32.band(bit32.rshift(toc, 3), 3)) // 400
	elseif bit32.band(toc, 0x60) == 0x60 then
		return bit32.band(toc, 0x08) ~= 0 and FS // 50 or FS // 100
	end
	local a = bit32.band(bit32.rshift(toc, 3), 3)
	if a == 3 then
		return FS * 60 // 1000
	end
	return (FS * 2 ^ a) // 100
end
Opus.samplesPerFrame = samplesPerFrame

-- frame sizes of one packet: returns count, sizes (list), first frame offset; nil on a malformed packet
local function parseSize(buf, pos, len)
	if len < 1 then
		return -1, 0
	end
	local b0 = buffer.readu8(buf, pos)
	if b0 < 252 then
		return b0, 1
	end
	if len < 2 then
		return -1, 0
	end
	return 4 * buffer.readu8(buf, pos + 1) + b0, 2
end

local function parsePacket(buf, off, len)
	if len < 1 then
		return nil
	end
	local toc = buffer.readu8(buf, off)
	local framesize = samplesPerFrame(toc)
	local pos = off + 1
	len -= 1
	local lastSize = len
	local sizes = {}
	local count
	local code = bit32.band(toc, 3)
	if code == 0 then
		count = 1
	elseif code == 1 then
		count = 2
		if len % 2 ~= 0 then
			return nil
		end
		lastSize = len // 2
		sizes[1] = lastSize
	elseif code == 2 then
		count = 2
		local s, bytes = parseSize(buf, pos, len)
		len -= bytes
		if s < 0 or s > len then
			return nil
		end
		sizes[1] = s
		pos += bytes
		lastSize = len - s
	else
		if len < 1 then
			return nil
		end
		local ch = buffer.readu8(buf, pos)
		pos += 1
		count = bit32.band(ch, 0x3F)
		if count <= 0 or framesize * count > 5760 then
			return nil
		end
		len -= 1
		if bit32.band(ch, 0x40) ~= 0 then
			local p
			repeat
				if len <= 0 then
					return nil
				end
				p = buffer.readu8(buf, pos)
				pos += 1
				len -= 1
				local tmp = p == 255 and 254 or p
				len -= tmp
			until p ~= 255
		end
		if len < 0 then
			return nil
		end
		local cbr = bit32.band(ch, 0x80) == 0
		if not cbr then
			lastSize = len
			for i = 1, count - 1 do
				local s, bytes = parseSize(buf, pos, len)
				len -= bytes
				if s < 0 or s > len then
					return nil
				end
				sizes[i] = s
				pos += bytes
				lastSize -= bytes + s
			end
			if lastSize < 0 then
				return nil
			end
		else
			lastSize = len // count
			if lastSize * count ~= len then
				return nil
			end
			for i = 1, count - 1 do
				sizes[i] = lastSize
			end
		end
	end
	if lastSize > 1275 then
		return nil
	end
	sizes[count] = lastSize
	return toc, count, sizes, pos
end

function Opus.new(channels)
	return {
		channels = channels, celt = Celt.new(channels), silk = nil,
		mode = 0, prevMode = 0, prevRedundancy = false, frameSize = F20, bandwidth = 0, streamChannels = channels,
	}
end

local function newBuf(channels, n)
	local t = {}
	for c = 1, channels do
		t[c] = table.create(n, 0)
	end
	return t
end

-- out = w^2 * in2 + (1 - w^2) * in1 over `overlap` samples (arrays with their own 0-based offsets)
local function smoothFade(in1, o1, in2, o2, out, oo, overlap, channels)
	for c = 1, channels do
		local a, b, y = in1[c], in2[c], out[c]
		for i = 1, overlap do
			local w = WINDOW[i]
			w = w * w
			y[oo + i] = w * b[o2 + i] + (1 - w) * a[o1 + i]
		end
	end
end

local decodeFrame
decodeFrame = function(st, buf, off, len, out, outOff, frameSize)
	local channels = st.channels
	frameSize = math.min(frameSize, FS // 25 * 3)
	local data = buf
	if len <= 1 then
		data = nil
		frameSize = math.min(frameSize, st.frameSize)
	end
	local audiosize, mode, bandwidth
	local ec
	if data then
		audiosize = st.frameSize
		mode = st.mode
		bandwidth = st.bandwidth
		ec = Entropy.new(buf, off, len)
	else
		audiosize = frameSize
		mode = st.prevRedundancy and MODE_CELT or st.prevMode
		bandwidth = 0
		if mode == 0 then
			for c = 1, channels do
				local y = out[c]
				for i = 1, audiosize do
					y[outOff + i] = 0
				end
			end
			return audiosize
		end
		if audiosize > F20 then
			local done = 0
			repeat
				local ret = decodeFrame(st, nil, 0, 0, out, outOff + done, math.min(audiosize, F20))
				done += ret
				audiosize -= ret
			until audiosize <= 0
			return frameSize
		elseif audiosize < F20 then
			if audiosize > F10 then
				audiosize = F10
			elseif mode ~= MODE_SILK and audiosize > F5 and audiosize < F10 then
				audiosize = F5
			end
		end
	end
	local celtAccum = mode ~= MODE_CELT
	local transition = false
	local pcmTransition
	if data and st.prevMode > 0 and ((mode == MODE_CELT and st.prevMode ~= MODE_CELT and not st.prevRedundancy)
		or (mode ~= MODE_CELT and st.prevMode == MODE_CELT)) then
		transition = true
	end
	if transition and mode == MODE_CELT then
		pcmTransition = newBuf(channels, F5)
		decodeFrame(st, nil, 0, 0, pcmTransition, 0, math.min(F5, audiosize))
	end
	if audiosize > frameSize then
		error("Opus: frame larger than the buffer")
	end
	frameSize = audiosize
	if mode ~= MODE_CELT then
		if not st.silk then
			st.silk = Silk.new()
		end
		if st.prevMode == MODE_CELT then
			Silk.reset(st.silk)
		end
		local ctl = st.silk.control
		ctl.payloadSizeMs = math.max(10, 1000 * audiosize // FS)
		if data then
			ctl.nChannelsInternal = st.streamChannels
			if mode == MODE_SILK then
				if bandwidth == BW_NB then
					ctl.internalSampleRate = 8000
				elseif bandwidth == BW_MB then
					ctl.internalSampleRate = 12000
				else
					ctl.internalSampleRate = 16000
				end
			else
				ctl.internalSampleRate = 16000
			end
		end
		ctl.nChannelsAPI = channels
		local lostFlag = data and 0 or 1
		local decoded = 0
		repeat
			local n = Silk.decode(st.silk, lostFlag, decoded == 0, ec, out, outOff + decoded, frameSize - decoded)
			decoded += n
		until decoded >= frameSize
	end
	local startBand = 0
	local redundancy = false
	local redundancyBytes = 0
	local celtToSilk = false
	if data and mode ~= MODE_CELT and ec:tell() + 17 + (mode == MODE_HYBRID and 20 or 0) <= 8 * len then
		if mode == MODE_HYBRID then
			redundancy = ec:bitLogp(12) ~= 0
		else
			redundancy = true
		end
		if redundancy then
			celtToSilk = ec:bitLogp(1) ~= 0
			if mode == MODE_HYBRID then
				redundancyBytes = ec:uint(256) + 2
			else
				redundancyBytes = len - ((ec:tell() + 7) // 8)
			end
			len -= redundancyBytes
			if len * 8 < ec:tell() then
				len = 0
				redundancyBytes = 0
				redundancy = false
			end
			ec.storage -= redundancyBytes
		end
	end
	if mode ~= MODE_CELT then
		startBand = 17
	end
	if redundancy then
		transition = false
	end
	if transition and mode ~= MODE_CELT then
		pcmTransition = newBuf(channels, F5)
		decodeFrame(st, nil, 0, 0, pcmTransition, 0, math.min(F5, audiosize))
	end
	local celt = st.celt
	if bandwidth ~= 0 then
		local endband = 21
		if bandwidth == BW_NB then
			endband = 13
		elseif bandwidth == BW_MB or bandwidth == BW_WB then
			endband = 17
		elseif bandwidth == BW_SWB then
			endband = 19
		end
		celt.endBand = endband
	end
	celt.streamChannels = st.streamChannels
	local redundant
	if redundancy then
		redundant = newBuf(channels, F5)
	end
	if redundancy and celtToSilk then
		celt.start = 0
		Celt.decode(celt, Entropy.new(buf, off + len, redundancyBytes), redundancyBytes, F5, redundant, 0, false)
	end
	celt.start = startBand
	if mode ~= MODE_SILK then
		local celtFrame = math.min(F20, frameSize)
		if mode ~= st.prevMode and st.prevMode > 0 and not st.prevRedundancy then
			Celt.reset(celt)
		end
		Celt.decode(celt, data and ec or nil, data and len or 0, celtFrame, out, outOff, celtAccum)
	else
		if not celtAccum then
			for c = 1, channels do
				for i = 1, frameSize do
					out[c][outOff + i] = 0
				end
			end
		end
		if st.prevMode == MODE_HYBRID and not (redundancy and celtToSilk and st.prevRedundancy) then
			celt.start = 0
			local silence = buffer.create(2)
			buffer.writeu8(silence, 0, 0xFF)
			buffer.writeu8(silence, 1, 0xFF)
			local tmp = newBuf(channels, F2_5)
			for c = 1, channels do
				for i = 1, F2_5 do
					tmp[c][i] = out[c][outOff + i]
				end
			end
			Celt.decode(celt, Entropy.new(silence, 0, 2), 2, F2_5, tmp, 0, celtAccum)
			for c = 1, channels do
				for i = 1, F2_5 do
					out[c][outOff + i] = tmp[c][i]
				end
			end
		end
	end
	if redundancy and not celtToSilk then
		Celt.reset(celt)
		celt.start = 0
		Celt.decode(celt, Entropy.new(buf, off + len, redundancyBytes), redundancyBytes, F5, redundant, 0, false)
		smoothFade(out, outOff + frameSize - F2_5, redundant, F2_5, out, outOff + frameSize - F2_5, F2_5, channels)
	end
	if redundancy and celtToSilk and (st.prevMode ~= MODE_SILK or st.prevRedundancy) then
		for c = 1, channels do
			for i = 1, F2_5 do
				out[c][outOff + i] = redundant[c][i]
			end
		end
		smoothFade(redundant, F2_5, out, outOff + F2_5, out, outOff + F2_5, F2_5, channels)
	end
	if transition then
		if audiosize >= F5 then
			for c = 1, channels do
				for i = 1, F2_5 do
					out[c][outOff + i] = pcmTransition[c][i]
				end
			end
			smoothFade(pcmTransition, F2_5, out, outOff + F2_5, out, outOff + F2_5, F2_5, channels)
		else
			smoothFade(pcmTransition, 0, out, outOff, out, outOff, F2_5, channels)
		end
	end
	st.prevMode = mode
	st.prevRedundancy = redundancy and not celtToSilk
	return audiosize
end

-- decodes one packet (or a lost one: length 0) into out[c][outOff + 1 ..]; returns the samples written
function Opus.decodePacket(st, buf, off, len, out, outOff, lostFrameSize)
	outOff = outOff or 0
	if not buf or len == 0 then
		local frameSize = lostFrameSize or st.frameSize
		local count = 0
		repeat
			count += decodeFrame(st, nil, 0, 0, out, outOff + count, frameSize - count)
		until count >= frameSize
		return count
	end
	local toc, count, sizes, pos = parsePacket(buf, off, len)
	if not toc then
		return 0
	end
	st.mode = packetMode(toc)
	st.bandwidth = packetBandwidth(toc)
	st.frameSize = samplesPerFrame(toc)
	st.streamChannels = bit32.band(toc, 0x4) ~= 0 and 2 or 1
	local n = 0
	for i = 1, count do
		local ret = decodeFrame(st, buf, pos, sizes[i], out, outOff + n, 5760 - n)
		pos += sizes[i]
		n += ret
	end
	return n
end

-- packets: list of { buf, offset, length } (a length of 0 is a lost packet) -> AudioLab DSP.Signal layout:
-- { sampleRate = 48000, channels, length, data = { f32 buffer per channel } }. gainDb: the stream's output gain.
function Opus.decodePackets(packets, channels, preSkip, options, gainDb)
	options = options or {}
	preSkip = preSkip or 0
	local outCh = math.min(2, math.max(1, channels))
	local st = Opus.new(outCh)
	local maxSamples = options.MaxSeconds and math.floor(options.MaxSeconds * FS) or math.huge
	local gain = 10 ^ ((gainDb or 0) / 20)
	local scratch = newBuf(outCh, 5760)
	local cap = 48000 * 10
	local data = {}
	for c = 1, outCh do
		data[c] = buffer.create(cap * 4)
	end
	local total = 0 -- samples kept
	local skip = preSkip
	local lastYield = os.clock()
	for _, p in ipairs(packets) do
		local got = Opus.decodePacket(st, p[1], p[2], p[3], scratch, 0)
		local from = math.min(skip, got)
		skip -= from
		local keep = math.min(got - from, maxSamples - total)
		if keep > 0 then
			if total + keep > cap then
				while total + keep > cap do
					cap *= 2
				end
				for c = 1, outCh do
					local nb = buffer.create(cap * 4)
					buffer.copy(nb, 0, data[c], 0, total * 4)
					data[c] = nb
				end
			end
			for c = 1, outCh do
				local src, dst = scratch[c], data[c]
				for i = 1, keep do
					local v = src[from + i] * gain
					if v > 1 then
						v = 1
					elseif v < -1 then
						v = -1
					end
					buffer.writef32(dst, (total + i - 1) * 4, v)
				end
			end
			total += keep
		end
		if total >= maxSamples then
			break
		end
		if options.Yield and os.clock() - lastYield > 0.02 then
			options.Yield()
			lastYield = os.clock()
		end
	end
	for c = 1, outCh do
		if buffer.len(data[c]) ~= math.max(total, 1) * 4 then
			local nb = buffer.create(math.max(total, 1) * 4)
			buffer.copy(nb, 0, data[c], 0, total * 4)
			data[c] = nb
		end
	end
	return { sampleRate = FS, channels = outCh, length = total, data = data }
end

-- the dOps box of an MP4 "Opus" sample entry (payload bytes) -> { channels, preSkip, gainDb, mapping, streams }
function Opus.readDops(b, p, q)
	if q - p < 11 then
		error("Opus: the dOps box is too short", 0)
	end
	local gain = buffer.readu8(b, p + 8) * 256 + buffer.readu8(b, p + 9)
	if gain >= 32768 then
		gain -= 65536
	end
	return {
		channels = buffer.readu8(b, p + 1),
		preSkip = buffer.readu8(b, p + 2) * 256 + buffer.readu8(b, p + 3),
		gainDb = gain / 256,
		mapping = buffer.readu8(b, p + 10),
		streams = if buffer.readu8(b, p + 10) ~= 0 and q - p >= 12 then buffer.readu8(b, p + 11) else 1,
	}
end

function Opus.isOgg(bytes)
	local b = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	return buffer.len(b) >= 36 and buffer.readstring(b, 0, 4) == "OggS" and buffer.readstring(b, 28, 8) == "OpusHead"
end

-- an Ogg Opus file: the first logical stream's packets (pages joined by lacing), OpusHead, the audio
function Opus.decodeOgg(bytes, options)
	local b = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	local n = buffer.len(b)
	local pos = 0
	local packets = {}
	local pending -- { parts } of a packet continued over pages
	local serial
	while pos + 27 <= n do
		if buffer.readstring(b, pos, 4) ~= "OggS" then
			error("Opus: not an Ogg page at " .. pos, 0)
		end
		local pageSerial = buffer.readu32(b, pos + 14)
		local nseg = buffer.readu8(b, pos + 26)
		local p = pos + 27 + nseg
		serial = serial or pageSerial
		for s = 0, nseg - 1 do
			local L = buffer.readu8(b, pos + 27 + s)
			if pageSerial == serial then
				pending = pending or {}
				table.insert(pending, { p, L })
				if L < 255 then
					-- join the parts into one packet
					if #pending == 1 then
						table.insert(packets, { b, pending[1][1], pending[1][2] })
					else
						local total = 0
						for _, part in ipairs(pending) do
							total += part[2]
						end
						local pk = buffer.create(total)
						local o = 0
						for _, part in ipairs(pending) do
							buffer.copy(pk, o, b, part[1], part[2])
							o += part[2]
						end
						table.insert(packets, { pk, 0, total })
					end
					pending = nil
				end
			end
			p += L
		end
		pos = p
	end
	local head = packets[1]
	if not head or buffer.readstring(head[1], head[2], 8) ~= "OpusHead" then
		error("Opus: no OpusHead", 0)
	end
	local channels = buffer.readu8(head[1], head[2] + 9)
	local preSkip = buffer.readu16(head[1], head[2] + 10)
	local gainDb = buffer.readi16(head[1], head[2] + 16) / 256
	local mapping = buffer.readu8(head[1], head[2] + 18)
	if mapping ~= 0 and (channels > 2 or buffer.readu8(head[1], head[2] + 19) > 1) then
		error("Opus: surround (multistream) audio isn't supported; mono and stereo are", 0)
	end
	local audio = table.move(packets, 3, #packets, 1, {})
	return Opus.decodePackets(audio, channels, preSkip, options, gainDb)
end

return Opus
]]></string>
