          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">FrameLabClient</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab:init() on a client, the same way AudioLabClient plays synced sound: plays every synced screen
-- (an instance tagged "FrameLab" with FrameLabSynced = true: a Part, or a Model with a part named "Screen") on a
-- SurfaceGui, on the server's playhead (FrameLab.Sync). The video's bytes stream from the server while it plays.
-- Only the nearest screens within view distance play (FrameLab attributes ViewDistance / MaxPlaying).
return function(FrameLab)
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local CollectionService = game:GetService("CollectionService")
	local root = script:FindFirstAncestor("FrameLab")
	local Net = require(root.Tools.Net)
	local Sync = require(root.Sync)
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))
	local player = Players.LocalPlayer
	if not player then
		return
	end
	-- the sound of an in-game import stays on the server until a TV here plays it (AudioLab asks for clips it hasn't got)
	pcall(function()
		local al = game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):FindFirstChild("AudioLab")
		if al then
			require(al.Tools.Assets).addSource(Net.clip)
		end
	end)
	local playerGui = player:WaitForChild("PlayerGui")

	local function newHolder()
		local h = Instance.new("Folder")
		h.Name = "FrameLabScreens"
		h.Parent = playerGui
		return h
	end
	local holder = newHolder()

	local function screenOf(inst)
		if inst:IsA("BasePart") then
			return inst
		end
		local s = inst:FindFirstChild("Screen", true)
		return s and s:IsA("BasePart") and s or nil
	end

	local playing = {} -- instance -> { gui, video, stream, key }

	local function stopTV(tv)
		local p = playing[tv]
		if not p then
			return
		end
		playing[tv] = nil
		if p.stream then
			p.stream.close()
		end
		if p.video then
			pcall(function()
				p.video:destroy()
			end)
		end
		if p.gui then
			p.gui:Destroy()
		end
	end

	local function startTV(tv)
		local name = tv:GetAttribute("FrameLabVideo")
		local screen = screenOf(tv)
		if not screen or not name or name == "" then
			return
		end
		local key = name
		local p = { key = key }
		playing[tv] = p
		local gui = Instance.new("SurfaceGui")
		gui.Name = tv.Name
		gui.Adornee = screen
		gui.Face = Enum.NormalId[tv:GetAttribute("FrameLabFace") or "Front"] or Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		-- about 1000 pixels across whatever the screen's size (a huge TV stays sharp, a small one stays cheap)
		gui.PixelsPerStud = math.clamp(math.floor(1000 / math.max(screen.Size.X, screen.Size.Y, 0.1)), 4, 200)
		gui.LightInfluence = 0
		gui.ClipsDescendants = true
		gui.ResetOnSpawn = false
		local bg = Instance.new("Frame")
		bg.Size = UDim2.fromScale(1, 1)
		bg.BackgroundColor3 = Color3.new(0, 0, 0)
		bg.BorderSizePixel = 0
		bg.Parent = gui
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(150, 160, 175)
		label.Font = Enum.Font.Code
		label.TextScaled = true
		label.Text = "loading..."
		label.ZIndex = 5
		label.Parent = bg
		local sizer = Instance.new("UITextSizeConstraint")
		sizer.MaxTextSize = 24
		sizer.Parent = label
		gui.Parent = holder
		p.gui = gui
		local stream = Net.openVideo(name)
		p.stream = stream
		task.spawn(function()
			while not stream.info and not stream.failed do
				task.wait(0.05)
			end
			if playing[tv] ~= p then
				return
			end
			if stream.failed then
				label.Text = "can't play " .. name
				return
			end
			local seconds = tv:GetAttribute("FrameLabDuration") or stream.info.Seconds or 1
			if seconds <= 0 then
				seconds = stream.info.Seconds or 1
			end
			local function clock()
				local st = Sync.state(tv)
				if not st then
					return 0
				end
				return (Sync.target(st, workspace:GetServerTimeNow(), { duration = seconds, loop = tv:GetAttribute("FrameLabLoop") == true }))
			end
			stream.follow(clock)
			if not stream.waitFor(clock(), 30) or playing[tv] ~= p then
				if playing[tv] == p then
					label.Text = "can't play " .. name
				end
				return
			end
			local ok, video = pcall(FrameLab.Player.new, stream.bytes, bg, { Clock = clock, Loop = tv:GetAttribute("FrameLabLoop") == true, Ready = stream.ready })
			if not ok then
				label.Text = "can't play " .. name
				warn("[FrameLab TV] " .. tostring(video))
				return
			end
			p.video = video
			label.Visible = false
			video:play()
			-- the player's state on the SurfaceGui (attributes, every half second), to see a screen that looks wrong:
			-- ShownTime (the frame on screen), TargetTime (where it should be), SoundTime (AudioLab's playhead for the
			-- same screen), DecodeMs, Behind (rows still to draw), HalfRate, Tolerance, Strips
			local Attach
			pcall(function()
				Attach = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):FindFirstChild("AudioLab").Synth.Attach)
			end)
			local fpsNow = 0
			local fpsConn = RunService.Heartbeat:Connect(function(dt)
				fpsNow = fpsNow * 0.95 + (1 / math.max(dt, 1e-3)) * 0.05
			end)
			-- (only with Config.Debug: checked every half second, so it can be switched on while playing)
			local shown = false
			while playing[tv] == p and gui.Parent do
				if not Config.Debug then
					if shown then
						shown = false
						for k in pairs(gui:GetAttributes()) do
							gui:SetAttribute(k, nil)
						end
					end
					task.wait(0.5)
					continue
				end
				shown = true
				pcall(function()
					local st, r = video.Stats, video.reader
					gui:SetAttribute("ShownTime", r.frame / video.fps)
					gui:SetAttribute("TargetTime", clock())
					local h = Attach and Attach.get(tv)
					gui:SetAttribute("SoundTime", h and h.player and h.player:getTime() or nil)
					gui:SetAttribute("DecodeMs", st.decodeMs)
					gui:SetAttribute("Behind", st.behind)
					gui:SetAttribute("HalfRate", st.halfRate == true)
					gui:SetAttribute("Tolerance", st.tolerance)
					gui:SetAttribute("Strips", st.strips)
					local objects, modes = video.canvas:objects()
					gui:SetAttribute("Objects", objects)
					gui:SetAttribute("Modes", ("own %d, shapes %d+%d, pieces %d, flat %d"):format(modes.grad, modes.shared1, modes.shared, modes.pieces, modes.flat))
					gui:SetAttribute("ShapesInUse", nil)
					-- strip share (follows the gradients replaced per screen frame) and replacements per second
					gui:SetAttribute("Share", video.MaxGradients)
					gui:SetAttribute("ChangesPerSec", video.cps and math.floor(video.cps) or 0)
					gui:SetAttribute("WorkMs", st.ms)
					gui:SetAttribute("Fps", fpsNow)
				end)
				task.wait(0.5)
			end
			fpsConn:Disconnect()
		end)
	end

	CollectionService:GetInstanceRemovedSignal(Sync.Tag):Connect(stopTV)

	-- which screens play: the nearest few with a video, within view distance
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.5 then
			return
		end
		acc = 0
		-- respawning clears the PlayerGui, this folder and its screens too: start them again in a new one
		if holder.Parent ~= playerGui then
			for tv in pairs(playing) do
				stopTV(tv)
			end
			holder = newHolder()
		end
		local cam = workspace.CurrentCamera
		local from = cam and cam.CFrame.Position or Vector3.zero
		local cands = {}
		for _, tv in ipairs(CollectionService:GetTagged(Sync.Tag)) do
			local video = tv:GetAttribute("FrameLabVideo")
			local screen = tv:IsDescendantOf(workspace) and tv:GetAttribute("FrameLabSynced") == true
				and tv:GetAttribute("FrameLabState") ~= "stopped" and screenOf(tv)
			if video and video ~= "" and screen then
				local d = (screen.Position - from).Magnitude - screen.Size.Magnitude / 2 -- from its edge (big screens)
				if d <= (Config.ViewDistance or 120) then
					table.insert(cands, { tv = tv, d = d })
				end
			end
		end
		table.sort(cands, function(a, b)
			return a.d < b.d
		end)
		local want = {}
		for i = 1, math.min(#cands, Config.MaxPlaying or 2) do
			want[cands[i].tv] = true
		end
		for tv, p in pairs(playing) do
			local key = tostring(tv:GetAttribute("FrameLabVideo"))
			if not want[tv] or p.key ~= key then
				stopTV(tv)
			end
		end
		for tv in pairs(want) do
			if not playing[tv] then
				startTV(tv)
			end
		end
	end)
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">TV</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab:init() on a client: the TV owner's controls. A TV is a synced FrameLab screen (FrameLabClient
-- plays it for everyone); its owner gets a prompt on it to pick a video, pause / resume, stop, or pick the TV up.
-- Anyone can click a TV to watch it: the camera sits in front of its screen until they move or press Leave (clicking
-- the picture again plays / pauses). While
-- watching, a YouTube-style bar shows the time and a seek bar; the TV's owner (or anyone, on a screen with
-- FrameLabClientControl) can play / pause, seek, skip 10 s and change the speed, and everyone sets their own volume.
-- Music the player is playing in the AudioLab player pauses while they watch and resumes when they leave.
-- Keys while watching: Space / K play-pause, J / L 10 s back / ahead, Left / Right 5 s, Up / Down volume, M mute.
return function(FrameLab)
	local Players = game:GetService("Players")
	local root = script:FindFirstAncestor("FrameLab")
	local Net = require(root.Tools.Net)
	local player = Players.LocalPlayer
	if not player then
		return
	end
	local playerGui = player:WaitForChild("PlayerGui")
	local remote = Net.remotes(false):WaitForChild("TV")
	local Sync = require(root.Sync)
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))
	local folder = workspace:WaitForChild("FrameLabTVs")

	-- picker for the owner
	local picker
	local function closePicker()
		if picker then
			picker:Destroy()
			picker = nil
		end
	end
	local order = 0
	local function button(parent, text, w)
		local b = Instance.new("TextButton")
		order += 1
		b.LayoutOrder = order
		b.Size = UDim2.new(0, w, 0, 30)
		b.BackgroundColor3 = Color3.fromRGB(34, 38, 48)
		b.TextColor3 = Color3.fromRGB(230, 233, 240)
		b.Font = Enum.Font.GothamMedium
		b.TextSize = 13
		b.Text = text
		b.AutoButtonColor = true
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 6)
		c.Parent = b
		b.Parent = parent
		return b
	end
	local function openPicker(tv)
		closePicker()
		-- (one window at a time: the Labs panels close)
		pcall(function()
			require(game:GetService("ReplicatedStorage"):FindFirstChild("LabHub")).closeAll()
		end)
		local sg = Instance.new("ScreenGui")
		sg.Name = "FrameLabTVPicker"
		sg.ResetOnSpawn = false
		sg.DisplayOrder = 20
		local panel = Instance.new("Frame")
		panel.Size = UDim2.new(0, 380, 0, 420)
		panel.Position = UDim2.fromScale(0.5, 0.5)
		panel.AnchorPoint = Vector2.new(0.5, 0.5)
		panel.BackgroundColor3 = Color3.fromRGB(20, 23, 30)
		panel.Parent = sg
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(0, 12)
		c.Parent = panel
		local pad = Instance.new("UIPadding")
		for _, k in ipairs({ "PaddingTop", "PaddingBottom", "PaddingLeft", "PaddingRight" }) do
			pad[k] = UDim.new(0, 12)
		end
		pad.Parent = panel
		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, 0, 0, 22)
		title.BackgroundTransparency = 1
		title.Text = "TV: pick a video"
		title.TextColor3 = Color3.fromRGB(230, 233, 240)
		title.Font = Enum.Font.GothamBold
		title.TextSize = 15
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.Parent = panel
		-- admins: the data manager (every import, its size, delete / load again: Runtime/Client/DataManager)
		local dataBtn = button(panel, "Data", 56)
		dataBtn.Size = UDim2.new(0, 56, 0, 24)
		dataBtn.Position = UDim2.new(1, -56, 0, -2)
		dataBtn.Visible = false
		task.spawn(function()
			dataBtn.Visible = Net.isAdmin()
		end)
		dataBtn.MouseButton1Click:Connect(function()
			closePicker()
			if FrameLab.openDataManager then
				FrameLab.openDataManager()
			end
		end)
		local list = Instance.new("ScrollingFrame")
		list.Size = UDim2.new(1, 0, 1, -112)
		list.Position = UDim2.new(0, 0, 0, 68)
		-- admins: import a video from a web address (kept while the server runs)
		local importRow = Instance.new("Frame")
		importRow.Size = UDim2.new(1, 0, 0, 30)
		importRow.Position = UDim2.new(0, 0, 0, 30)
		importRow.BackgroundTransparency = 1
		importRow.Visible = false
		importRow.Parent = panel
		local urlBox = Instance.new("TextBox")
		urlBox.Size = UDim2.new(1, -152, 1, 0)
		urlBox.BackgroundColor3 = Color3.fromRGB(28, 32, 41)
		urlBox.TextColor3 = Color3.fromRGB(230, 233, 240)
		urlBox.PlaceholderText = "video URL: MP4, GIF, WebP, AVI, or a YouTube link"
		urlBox.PlaceholderColor3 = Color3.fromRGB(140, 148, 165)
		urlBox.Text = ""
		urlBox.ClearTextOnFocus = false
		urlBox.Font = Enum.Font.Code
		urlBox.TextSize = 12
		urlBox.TextTruncate = Enum.TextTruncate.AtEnd
		local uc = Instance.new("UICorner")
		uc.CornerRadius = UDim.new(0, 6)
		uc.Parent = urlBox
		urlBox.Parent = importRow
		local importBtn = button(importRow, "Import", 88)
		importBtn.Position = UDim2.new(1, -88, 0, 0)
		-- the size the video is imported at (FrameLab Config ImportVideoQuality is the default; this client remembers the pick)
		local QUALITIES = { "144p", "240p", "360p" }
		local quality = playerGui:GetAttribute("FrameLabImportQuality") or Config.ImportVideoQuality or "144p"
		if not table.find(QUALITIES, quality) then
			quality = "144p"
		end
		local qualityBtn = button(importRow, quality, 50)
		qualityBtn.Position = UDim2.new(1, -144, 0, 0)
		qualityBtn.MouseButton1Click:Connect(function()
			quality = QUALITIES[(table.find(QUALITIES, quality) or 1) % #QUALITIES + 1]
			qualityBtn.Text = quality
			playerGui:SetAttribute("FrameLabImportQuality", quality)
		end)
		task.spawn(function()
			importRow.Visible = Net.isAdmin()
		end)
		list.BackgroundColor3 = Color3.fromRGB(28, 32, 41)
		list.BorderSizePixel = 0
		list.ScrollBarThickness = 4
		list.AutomaticCanvasSize = Enum.AutomaticSize.Y
		list.CanvasSize = UDim2.new()
		list.Parent = panel
		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Padding = UDim.new(0, 4)
		layout.Parent = list
		local lp = Instance.new("UIPadding")
		lp.PaddingTop, lp.PaddingLeft, lp.PaddingRight = UDim.new(0, 6), UDim.new(0, 6), UDim.new(0, 10)
		lp.Parent = list
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 30)
		row.Position = UDim2.new(0, 0, 1, -30)
		row.BackgroundTransparency = 1
		row.Parent = panel
		local rl = Instance.new("UIListLayout")
		rl.SortOrder = Enum.SortOrder.LayoutOrder
		rl.FillDirection = Enum.FillDirection.Horizontal
		rl.Padding = UDim.new(0, 6)
		rl.Parent = row
		button(row, "Pause / play", 96).MouseButton1Click:Connect(function()
			Sync.request(tv, "toggle")
		end)
		button(row, "Stop", 60).MouseButton1Click:Connect(function()
			Sync.request(tv, "stop")
			closePicker()
		end)
		button(row, "Pick up", 70).MouseButton1Click:Connect(function()
			remote:FireServer("remove", tv)
			closePicker()
		end)
		button(row, "Close", 60).MouseButton1Click:Connect(closePicker)
		sg:SetAttribute("TV", tv.Name)
		sg.Parent = playerGui
		picker = sg
		local importing = false
		local fill
		local function doImport()
			if importing or urlBox.Text == "" then
				return
			end
			importing = true
			importBtn.Text = "Importing..."
			title.Text = "Importing... (a long video takes a while)"
			-- how far it is (the server's ImportStatus: "42% - video - 31 s")
			task.spawn(function()
				local folder = Net.remotes(false)
				while importing and picker == sg do
					local st = folder:GetAttribute("ImportStatus")
					if type(st) == "string" and st ~= "" then
						title.Text = "Importing: " .. st
						importBtn.Text = string.match(st, "^%d+%%") or "Importing..."
					end
					task.wait(0.25)
				end
			end)
			local ok, res = pcall(Net.invoke, "importUrl", "video", urlBox.Text, quality)
			importing = false
			importBtn.Text = "Import"
			if picker ~= sg then
				return
			end
			if not ok or type(res) ~= "table" then
				title.Text = "That didn't import"
			elseif res.error then
				title.Text = res.error
			else
				-- the new video joins the list (the panel stays as it is)
				title.Text = ("Imported %s (%.1f s): pick it below"):format(res.name, res.seconds or 0)
				urlBox.Text = ""
				Net.forget()
				fill()
			end
		end
		importBtn.MouseButton1Click:Connect(doImport)
		urlBox.FocusLost:Connect(function(enter)
			if enter then
				doImport()
			end
		end)
		function fill()
			for _, ch in ipairs(list:GetChildren()) do
				if ch:IsA("GuiButton") then
					ch:Destroy()
				end
			end
		local videos = Net.videos()
		if #videos == 0 then
			local b = button(list, "No videos yet: import some with FrameLab.import() in Studio", 10)
			b.Size = UDim2.new(1, 0, 0, 30)
			b.TextWrapped = true
		end
		for _, v in ipairs(videos) do
			local b = button(list, ("%s   %dx%d, %.1f s%s"):format(v.name, v.Width or 0, v.Height or 0, v.Seconds or 0, v.Imported and ", imported" or (v.Server and ", streamed" or "")), 10)
			b.Size = UDim2.new(1, 0, 0, 30)
			b.TextXAlignment = Enum.TextXAlignment.Left
			local bp = Instance.new("UIPadding")
			bp.PaddingLeft = UDim.new(0, 8)
			bp.Parent = b
			b.MouseButton1Click:Connect(function()
				Sync.request(tv, "play", { Video = v.name, Loop = true })
				closePicker()
			end)
		end
		end
		fill()
	end

	-- watching: the camera in front of a TV's screen, framing it
	local RunService = game:GetService("RunService")
	local PromptService = game:GetService("ProximityPromptService")
	local watching, watchConn, watchGui, promptsWere, pendingWas
	local watchConns = {} -- input connections of the control bar
	local buildControls -- (below)
	local watchToggle -- play / pause of the TV being watched (clicking its picture while watching)
	local UIS = game:GetService("UserInputService")
	local CAS = game:GetService("ContextActionService")
	local KEYS_ACTION = "FrameLabTVKeys"
	-- this player's own volume per TV (0..1, times the TV's AudioLab volume); AudioLab's handle for the TV's sound
	local tvVolume, tvMuted = {}, {}
	local Attach, Library
	pcall(function()
		local al = game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("AudioLab", 2)
		Attach = require(al.Synth.Attach)
		Library = require(al.Tools.Library)
	end)
	local pausedMusic -- this player's own music, paused while watching (resumed when they leave)
	-- while watching, the backpack and the other GUI step aside (chat stays)
	local StarterGui = game:GetService("StarterGui")
	local CORE = { Enum.CoreGuiType.Backpack, Enum.CoreGuiType.PlayerList, Enum.CoreGuiType.Health, Enum.CoreGuiType.EmotesMenu }
	local coreWas, hiddenGuis = {}, {}
	local function hideGui()
		for _, t in ipairs(CORE) do
			coreWas[t] = StarterGui:GetCoreGuiEnabled(t)
			pcall(StarterGui.SetCoreGuiEnabled, StarterGui, t, false)
		end
		for _, g in ipairs(playerGui:GetChildren()) do
			-- (not the ones holding SurfaceGuis / BillboardGuis: those draw the TVs and other things in the world)
			if g:IsA("ScreenGui") and g.Enabled and g ~= watchGui and not g:FindFirstChildWhichIsA("SurfaceGui", true)
				and not g:FindFirstChildWhichIsA("BillboardGui", true) then
				g.Enabled = false
				table.insert(hiddenGuis, g)
			end
		end
	end
	local function showGui()
		for t, was in pairs(coreWas) do
			pcall(StarterGui.SetCoreGuiEnabled, StarterGui, t, was)
		end
		table.clear(coreWas)
		for _, g in ipairs(hiddenGuis) do
			if g.Parent then
				g.Enabled = true
			end
		end
		table.clear(hiddenGuis)
	end
	local function stopWatching()
		if not watching then
			return
		end
		watching = nil
		if watchConn then
			watchConn:Disconnect()
			watchConn = nil
		end
		if watchGui then
			watchGui:Destroy()
			watchGui = nil
		end
		for _, c in ipairs(watchConns) do
			c:Disconnect()
		end
		table.clear(watchConns)
		CAS:UnbindAction(KEYS_ACTION)
		watchToggle = nil
		if pausedMusic and Library then
			Library.resumeAll(pausedMusic)
		end
		pausedMusic = nil
		if promptsWere ~= nil then
			-- a moment later: the click that ended watching mustn't also trigger the prompt it reveals
			pendingWas = promptsWere
			promptsWere = nil
			task.delay(0.3, function()
				if not watching and pendingWas ~= nil then
					PromptService.Enabled = pendingWas
					pendingWas = nil
				end
			end)
		end
		showGui()
		local cam = workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Custom
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			cam.CameraSubject = hum
		end
	end
	-- the control bar (YouTube-like) shown while watching
	local RED = Color3.fromRGB(255, 0, 51)
	local WHITE = Color3.new(1, 1, 1)
	local function clock(t)
		t = math.max(0, math.floor(t + 0.0001))
		if t >= 3600 then
			return ("%d:%02d:%02d"):format(t // 3600, (t // 60) % 60, t % 60)
		end
		return ("%d:%02d"):format(t // 60, t % 60)
	end
	local function iconButton(parent, text, w, order_)
		local b = Instance.new("TextButton")
		b.LayoutOrder = order_
		b.Size = UDim2.new(0, w, 0, 36)
		b.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
		b.BackgroundTransparency = 0.35
		b.TextColor3 = WHITE
		b.Font = Enum.Font.GothamBold
		b.TextSize = 15
		b.Text = text
		b.AutoButtonColor = true
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(1, 0)
		c.Parent = b
		b.Parent = parent
		return b
	end
	function buildControls(tv, gui)
		local function canControl()
			local owner = tv:GetAttribute("FrameLabOwner")
			return (owner ~= nil and owner == player.UserId) or tv:GetAttribute("FrameLabClientControl") == true
		end
		local function duration()
			return tv:GetAttribute("FrameLabDuration") or 0
		end
		local function now()
			return Sync.getTime(tv, { duration = duration(), loop = tv:GetAttribute("FrameLabLoop") == true })
		end
		local function playing()
			return tv:GetAttribute("FrameLabState") == "playing"
		end
		local function seekTo(t)
			local d = duration()
			if d > 0 then
				t = math.clamp(t, 0, math.max(0, d - 0.05))
			end
			Sync.request(tv, "seek", math.max(0, t))
		end

		-- bottom panel: a dark fade, the seek bar, then the buttons. A CanvasGroup, so the whole bar fades out together
		-- (GroupTransparency) when the mouse rests, and snaps back in when it moves (see update)
		local panel = Instance.new("CanvasGroup")
		panel.Name = "Controls"
		panel.AnchorPoint = Vector2.new(0.5, 1)
		panel.Position = UDim2.new(0.5, 0, 1, 0)
		panel.Size = UDim2.new(1, 0, 0, 116) -- (12 px of headroom: a CanvasGroup clips, and the seek time tip sits above the bar)
		panel.BackgroundTransparency = 1
		panel.BorderSizePixel = 0
		panel.Active = true -- clicks on the bar don't reach the TV behind it
		local shade = Instance.new("Frame") -- (its own frame: a gradient on the group would fade the buttons too)
		shade.Name = "Shade"
		shade.Size = UDim2.fromScale(1, 1)
		shade.BackgroundColor3 = Color3.new(0, 0, 0)
		shade.BorderSizePixel = 0
		shade.ZIndex = 0
		local fade = Instance.new("UIGradient")
		fade.Rotation = 90
		fade.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.35) })
		fade.Parent = shade
		shade.Parent = panel
		panel.Parent = gui

		-- seek bar (a wide invisible hit area around a thin bar)
		local hit = Instance.new("TextButton")
		hit.Name = "Seek"
		hit.Text = ""
		hit.AutoButtonColor = false
		hit.BackgroundTransparency = 1
		hit.AnchorPoint = Vector2.new(0.5, 0)
		hit.Position = UDim2.new(0.5, 0, 0, 30)
		hit.Size = UDim2.new(1, -48, 0, 18)
		hit.Parent = panel
		local track = Instance.new("Frame")
		track.AnchorPoint = Vector2.new(0, 0.5)
		track.Position = UDim2.new(0, 0, 0.5, 0)
		track.Size = UDim2.new(1, 0, 0, 4)
		track.BackgroundColor3 = WHITE
		track.BackgroundTransparency = 0.65
		track.BorderSizePixel = 0
		track.Parent = hit
		local hover = Instance.new("Frame") -- where a click would land
		hover.Size = UDim2.new(0, 0, 1, 0)
		hover.BackgroundColor3 = WHITE
		hover.BackgroundTransparency = 0.6
		hover.BorderSizePixel = 0
		hover.Visible = false
		hover.Parent = track
		local fill = Instance.new("Frame")
		fill.Size = UDim2.new(0, 0, 1, 0)
		fill.BackgroundColor3 = RED
		fill.BorderSizePixel = 0
		fill.ZIndex = 2
		fill.Parent = track
		local knob = Instance.new("Frame")
		knob.AnchorPoint = Vector2.new(0.5, 0.5)
		knob.Size = UDim2.new(0, 13, 0, 13)
		knob.BackgroundColor3 = RED
		knob.BorderSizePixel = 0
		knob.ZIndex = 3
		local kc = Instance.new("UICorner")
		kc.CornerRadius = UDim.new(1, 0)
		kc.Parent = knob
		knob.Parent = track
		local tip = Instance.new("TextLabel") -- the time under the mouse
		tip.AnchorPoint = Vector2.new(0.5, 1)
		tip.Size = UDim2.new(0, 56, 0, 20)
		tip.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
		tip.BackgroundTransparency = 0.2
		tip.TextColor3 = WHITE
		tip.Font = Enum.Font.GothamMedium
		tip.TextSize = 12
		tip.Visible = false
		tip.ZIndex = 4
		local tc = Instance.new("UICorner")
		tc.CornerRadius = UDim.new(0, 4)
		tc.Parent = tip
		tip.Parent = hit

		-- button row
		local row = Instance.new("Frame")
		row.BackgroundTransparency = 1
		row.Position = UDim2.new(0, 24, 0, 58)
		row.Size = UDim2.new(1, -48, 0, 40)
		row.Parent = panel
		local left = Instance.new("Frame")
		left.BackgroundTransparency = 1
		left.Size = UDim2.new(0.6, 0, 1, 0)
		left.Parent = row
		local ll = Instance.new("UIListLayout")
		ll.FillDirection = Enum.FillDirection.Horizontal
		ll.VerticalAlignment = Enum.VerticalAlignment.Center
		ll.SortOrder = Enum.SortOrder.LayoutOrder
		ll.Padding = UDim.new(0, 8)
		ll.Parent = left
		local right = Instance.new("Frame")
		right.BackgroundTransparency = 1
		right.AnchorPoint = Vector2.new(1, 0)
		right.Position = UDim2.new(1, 0, 0, 0)
		right.Size = UDim2.new(0.4, 0, 1, 0)
		right.Parent = row
		local rl = ll:Clone()
		rl.HorizontalAlignment = Enum.HorizontalAlignment.Right
		rl.Parent = right

		local playBtn = iconButton(left, "II", 40, 1)
		local backBtn = iconButton(left, "-10", 46, 2)
		local fwdBtn = iconButton(left, "+10", 46, 3)
		local volBtn = iconButton(left, "Vol", 48, 4)
		volBtn.TextSize = 12
		local volTrack = Instance.new("TextButton")
		volTrack.LayoutOrder = 5
		volTrack.Text = ""
		volTrack.AutoButtonColor = false
		volTrack.Size = UDim2.new(0, 80, 0, 4)
		volTrack.BackgroundColor3 = WHITE
		volTrack.BackgroundTransparency = 0.65
		volTrack.BorderSizePixel = 0
		volTrack.Parent = left
		local volFill = Instance.new("Frame")
		volFill.Size = UDim2.new(1, 0, 1, 0)
		volFill.BackgroundColor3 = WHITE
		volFill.BorderSizePixel = 0
		volFill.Parent = volTrack
		local timeLabel = Instance.new("TextLabel")
		timeLabel.LayoutOrder = 6
		timeLabel.BackgroundTransparency = 1
		timeLabel.Size = UDim2.new(0, 120, 0, 36)
		timeLabel.TextColor3 = WHITE
		timeLabel.Font = Enum.Font.GothamMedium
		timeLabel.TextSize = 14
		timeLabel.TextXAlignment = Enum.TextXAlignment.Left
		timeLabel.Text = "0:00 / 0:00"
		timeLabel.Parent = left

		local speeds = { 0.5, 1, 1.5, 2 }
		local speedBtns = {}
		for i, sp in ipairs(speeds) do
			local b = iconButton(right, (sp == math.floor(sp) and tostring(math.floor(sp)) or tostring(sp)) .. "x", 46, i)
			b.TextSize = 13
			speedBtns[sp] = b
			b.Activated:Connect(function()
				if canControl() then
					Sync.request(tv, "setSpeed", sp)
				end
			end)
		end
		local leaveBtn = iconButton(right, "Leave", 64, 10)
		leaveBtn.TextSize = 13
		leaveBtn.Activated:Connect(stopWatching)

		local note = Instance.new("TextLabel") -- why the buttons do nothing
		note.AnchorPoint = Vector2.new(0.5, 1)
		note.Position = UDim2.new(0.5, 0, 0, 26)
		note.Size = UDim2.new(1, 0, 0, 16)
		note.BackgroundTransparency = 1
		note.TextColor3 = Color3.fromRGB(200, 200, 200)
		note.Font = Enum.Font.Gotham
		note.TextSize = 12
		note.Text = ""
		note.Parent = panel

		-- actions
		local function toggle()
			if canControl() then
				Sync.request(tv, "toggle")
			end
		end
		local function skip(dt)
			if canControl() then
				seekTo(now() + dt)
			end
		end
		local function volume()
			return tvVolume[tv] or 1
		end
		local function setVolume(v)
			tvVolume[tv] = math.clamp(v, 0, 1)
			tvMuted[tv] = tvVolume[tv] <= 0 or nil
		end
		playBtn.Activated:Connect(toggle)
		watchToggle = toggle
		backBtn.Activated:Connect(function()
			skip(-10)
		end)
		fwdBtn.Activated:Connect(function()
			skip(10)
		end)
		volBtn.Activated:Connect(function()
			tvMuted[tv] = not tvMuted[tv] or nil
			if not tvMuted[tv] and volume() <= 0 then
				tvVolume[tv] = 1
			end
		end)

		-- dragging (seek bar and volume)
		local dragging -- "seek" | "volume"
		local lastMove = os.clock()
		local function fracOf(guiObj, x)
			local p, w = guiObj.AbsolutePosition.X, math.max(guiObj.AbsoluteSize.X, 1)
			return math.clamp((x - p) / w, 0, 1)
		end
		local previewT
		local function isPress(input)
			return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
		end
		table.insert(watchConns, hit.InputBegan:Connect(function(input)
			if isPress(input) and canControl() then
				dragging = "seek"
				previewT = fracOf(track, input.Position.X) * duration()
			end
		end))
		table.insert(watchConns, volTrack.InputBegan:Connect(function(input)
			if isPress(input) then
				dragging = "volume"
				setVolume(fracOf(volTrack, input.Position.X))
			end
		end))
		table.insert(watchConns, UIS.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				lastMove = os.clock()
				if dragging == "seek" then
					previewT = fracOf(track, input.Position.X) * duration()
				elseif dragging == "volume" then
					setVolume(fracOf(volTrack, input.Position.X))
				end
			end
		end))
		table.insert(watchConns, UIS.InputEnded:Connect(function(input)
			if isPress(input) and dragging then
				if dragging == "seek" and previewT then
					seekTo(previewT)
				end
				dragging, previewT = nil, nil
			end
		end))

		-- keys (sunk, so Space doesn't jump and the arrows don't walk away from the TV)
		CAS:BindActionAtPriority(KEYS_ACTION, function(_, state, input)
			if state ~= Enum.UserInputState.Begin then
				return Enum.ContextActionResult.Sink
			end
			lastMove = os.clock()
			local k = input.KeyCode
			if k == Enum.KeyCode.Space or k == Enum.KeyCode.K then
				toggle()
			elseif k == Enum.KeyCode.J then
				skip(-10)
			elseif k == Enum.KeyCode.L then
				skip(10)
			elseif k == Enum.KeyCode.Left then
				skip(-5)
			elseif k == Enum.KeyCode.Right then
				skip(5)
			elseif k == Enum.KeyCode.Up then
				setVolume(volume() + 0.1)
			elseif k == Enum.KeyCode.Down then
				setVolume(volume() - 0.1)
			elseif k == Enum.KeyCode.M then
				tvMuted[tv] = not tvMuted[tv] or nil
			end
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value + 100, Enum.KeyCode.Space, Enum.KeyCode.K, Enum.KeyCode.J,
			Enum.KeyCode.L, Enum.KeyCode.Left, Enum.KeyCode.Right, Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.M)

		-- every frame: time, bar, buttons, this player's volume on the TV's sound; the bar hides after 3 s without the
		-- mouse moving (while playing)
		local lastHandle, lastGain
		local shownAmount, lastUpdate = 1, os.clock() -- 1 = bar fully shown
		local FADE_IN, FADE_OUT, IDLE = 0.08, 0.6, 2.5 -- seconds
		local function update()
			local d = duration()
			local t = now()
			local shown = previewT or t
			local f = d > 0 and math.clamp(shown / d, 0, 1) or 0
			fill.Size = UDim2.new(f, 0, 1, 0)
			knob.Position = UDim2.new(f, 0, 0.5, 0)
			timeLabel.Text = clock(shown) .. " / " .. clock(d)
			local isPlaying = playing()
			playBtn.Text = isPlaying and "II" or ">"
			local sp = tv:GetAttribute("FrameLabSpeed") or 1
			for v, b in pairs(speedBtns) do
				local on = math.abs(v - sp) < 0.01
				b.BackgroundColor3 = on and RED or Color3.fromRGB(28, 28, 28)
			end
			local ctl = canControl()
			for _, b in ipairs({ playBtn, backBtn, fwdBtn }) do
				b.TextTransparency = ctl and 0 or 0.55
			end
			for _, b in pairs(speedBtns) do
				b.TextTransparency = ctl and 0 or 0.55
			end
			if not ctl then
				note.Text = ("Only %s can pause, seek or change the speed of this TV"):format(tv:GetAttribute("OwnerName") or "its owner")
			else
				note.Text = ""
			end
			-- the mouse over the seek bar: a preview of where a click goes
			local m = UIS:GetMouseLocation() -- screen pixels, like this ScreenGui's (IgnoreGuiInset)
			local mx, my = m.X, m.Y
			local hp, hs = hit.AbsolutePosition, hit.AbsoluteSize
			local over = ctl and mx >= hp.X and mx <= hp.X + hs.X and my >= hp.Y - 6 and my <= hp.Y + hs.Y + 6
			track.Size = UDim2.new(1, 0, 0, (over or dragging == "seek") and 6 or 4)
			if (over or dragging == "seek") and d > 0 then
				local hf = dragging == "seek" and f or fracOf(track, mx)
				hover.Visible = true
				hover.Size = UDim2.new(hf, 0, 1, 0)
				tip.Visible = true
				tip.Position = UDim2.new(hf, 0, 0, -8)
				tip.Text = clock(hf * d)
			else
				hover.Visible = false
				tip.Visible = false
			end
			-- volume
			local vol = tvMuted[tv] and 0 or volume()
			volFill.Size = UDim2.new(vol, 0, 1, 0)
			volBtn.Text = (vol <= 0) and "Muted" or "Vol"
			if Attach then
				local h = Attach.get(tv)
				if h then
					local base = tv:GetAttribute("AudioLabVolume") or 1
					local gain = base * vol
					if h ~= lastHandle or gain ~= lastGain then
						pcall(h.setVolume, h, gain)
						lastHandle, lastGain = h, gain
					end
				end
			end
			-- auto-hide
			local show = not isPlaying or dragging ~= nil or over or os.clock() - lastMove < IDLE
			-- a quick fade in when the mouse moves, a slow fade out when it rests
			local tNow = os.clock()
			local dt = math.min(tNow - lastUpdate, 0.1)
			lastUpdate = tNow
			if show then
				shownAmount = math.min(1, shownAmount + dt / FADE_IN)
			else
				shownAmount = math.max(0, shownAmount - dt / FADE_OUT)
			end
			local eased = shownAmount * shownAmount * (3 - 2 * shownAmount)
			panel.GroupTransparency = 1 - eased
			panel.Visible = shownAmount > 0
		end
		return { update = update }
	end

	local function watch(tv)
		if watching == tv then
			-- clicking the picture while watching: play / pause, like a video site (Leave or moving ends watching)
			if watchToggle then
				watchToggle()
			end
			return
		end
		stopWatching()
		local screen = tv:FindFirstChild("Screen")
		if not screen then
			return
		end
		watching = tv
		closePicker()
		-- the player's own music pauses while they watch (and picks up again when they leave)
		if Library then
			pausedMusic = Library.pauseAll()
		end
		-- no prompts ("Change video") over the picture while watching
		if pendingWas ~= nil then
			promptsWere, pendingWas = pendingWas, nil
		else
			promptsWere = PromptService.Enabled
		end
		PromptService.Enabled = false
		local cam = workspace.CurrentCamera
		local from = cam.CFrame
		cam.CameraType = Enum.CameraType.Scriptable
		local t0 = os.clock()
		watchConn = RunService.RenderStepped:Connect(function()
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if not tv:IsDescendantOf(folder) or not screen.Parent or not hum or hum.Health <= 0 or hum.MoveDirection.Magnitude > 0.1
				or hum.Jump then
				stopWatching()
				return
			end
			-- frame the TV's own screen (the picture fits inside it), as big as the view allows
			local size = screen:GetAttribute("BaseSize")
			local offset = screen:GetAttribute("BaseOffset")
			local base = (typeof(offset) == "CFrame") and (tv:GetPivot() * offset) or screen.CFrame
			size = typeof(size) == "Vector3" and size or screen.Size
			local vp = cam.ViewportSize
			local tanV = math.tan(math.rad(cam.FieldOfView) / 2)
			local d = math.max(size.Y / 2 / tanV, size.X / 2 / (tanV * vp.X / math.max(vp.Y, 1))) * 1.06 + size.Z / 2
			local goal = CFrame.lookAt((base * CFrame.new(0, 0, -d)).Position, base.Position, base.UpVector)
			local a = math.min(1, (os.clock() - t0) / 0.5)
			cam.CFrame = from:Lerp(goal, 1 - (1 - a) ^ 3)
		end)
		watchGui = Instance.new("ScreenGui")
		watchGui.Name = "FrameLabTVWatch"
		watchGui.ResetOnSpawn = false
		watchGui.DisplayOrder = 15
		watchGui.IgnoreGuiInset = true
		local controls = buildControls(tv, watchGui)
		watchGui.Parent = playerGui
		hideGui()
		local update = controls.update
		local inner = watchConn
		watchConn = RunService.RenderStepped:Connect(function(dt)
			update(dt)
		end)
		table.insert(watchConns, inner)
	end
	player.CharacterAdded:Connect(stopWatching)

	-- the TV tool's hint goes once no TV tool is in hand (the tool's own script can be gone before it clears it)
	task.spawn(function()
		while true do
			task.wait(0.5)
			local hint = playerGui:FindFirstChild("FrameLabTVHint")
			if hint then
				local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
				if not (tool and tool:GetAttribute("FrameLabTV")) then
					hint:Destroy()
				end
			end
		end
	end)

	local function hook(tv)
		local detector = tv:FindFirstChild("Watch", true)
		if detector and detector:IsA("ClickDetector") then
			detector.MouseClick:Connect(function(who)
				if who == player then
					watch(tv)
				end
			end)
		end
		local prompt = tv:FindFirstChild("Change", true)
		if prompt and prompt:IsA("ProximityPrompt") then
			-- only the owner sees the prompt (a client-side change)
			prompt.Enabled = tv:GetAttribute("FrameLabOwner") == player.UserId
			prompt.Triggered:Connect(function(who)
				if picker and picker:GetAttribute("TV") == tv.Name then
					return -- already open: keep what's typed in it
				end
				if who == player and tv:GetAttribute("FrameLabOwner") == player.UserId then
					openPicker(tv)
				end
			end)
		end
		tv.AncestryChanged:Connect(function()
			if not tv:IsDescendantOf(folder) and picker and picker:GetAttribute("TV") == tv.Name then
				closePicker()
			end
		end)
	end
	for _, tv in ipairs(folder:GetChildren()) do
		hook(tv)
	end
	folder.ChildAdded:Connect(hook)

end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">Spray</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab:init() on a client: draws picture sprays (workspace.FrameLabSprays, Kind "image" / "url") with
-- FrameLab strips on a SurfaceGui. Only the nearest few within view distance are drawn (Config.SprayMaxRendered /
-- SprayViewDistance); pictures are fetched from the server once and kept.
return function(FrameLab)
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local root = script:FindFirstAncestor("FrameLab")
	local Net = require(root.Tools.Net)
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))
	local player = Players.LocalPlayer
	if not player then
		return
	end
	local playerGui = player:WaitForChild("PlayerGui")
	local folder = workspace:WaitForChild("FrameLabSprays")
	local function newHolder()
		local h = Instance.new("Folder")
		h.Name = "FrameLabSprays"
		h.Parent = playerGui
		return h
	end
	local holder = newHolder()

	local shown = {} -- spray part -> { gui, canvas, level }
	local images = {} -- key -> image table (smaller copy for drawing)

	-- Performance mode (phones by default; Config.SprayPerformanceMode "on" / "off" / "auto"): fewer sprays drawn, and
	-- each with fewer GUI objects. Every device draws a spray cheaply ("far") until you come within
	-- SprayDetailDistance, then in full ("near"): GUI objects cost drawing time every frame, even on a still picture.
	local UIS = game:GetService("UserInputService")
	local function performance()
		local m = Config.SprayPerformanceMode or "auto"
		if m == "on" then
			return true
		elseif m == "off" then
			return false
		end
		return UIS.TouchEnabled and not UIS.KeyboardEnabled
	end
	-- most GUI objects a spray's blocks may take
	local function budgetOf(original, level)
		local perf = performance()
		if level == "far" then
			return perf and 500 or 1500
		end
		if original then
			return perf and (Config.SprayPhonePieces or 3500) or (Config.SprayOriginalPieces or 9000)
		end
		return perf and 1200 or 3000
	end

	local function drop(s)
		if s.canvas then
			s.canvas:destroy()
		end
		s.gui:Destroy()
		if s.old then
			drop(s.old)
			s.old = nil
		end
	end

	local function hide(part)
		local s = shown[part]
		if s then
			shown[part] = nil
			drop(s)
		end
	end

	-- level: "near" | "far"; old: the spray's previous drawing, kept until this one is drawn (no blink when it switches)
	local function show(part, level, old)
		local key = part:GetAttribute("Key")
		local original = part:GetAttribute("Original") == true
		level = level or "near"
		local s = { level = level, old = old }
		shown[part] = s
		local gui = Instance.new("SurfaceGui")
		gui.Adornee = part
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = original and 40 or 30
		gui.LightInfluence = 1
		gui.ClipsDescendants = true
		gui.ResetOnSpawn = false
		gui.Parent = holder
		s.gui = gui
		task.spawn(function()
			-- picture size: O up to SprayOriginalSize (512); the others ~16 pixels a stud (L and XL sharper than S / M)
			local px = original and (Config.SprayOriginalSize or 512)
				or math.clamp(math.floor(math.max(part.Size.X, part.Size.Y) * 16), Config.SprayPictureSize or 96, 192)
			local cacheKey = original and (key .. "#original") or (key .. "#" .. px)
			local img = images[cacheKey]
			if not img then
				local full = Net.image(key)
				if not full then
					return
				end
				img = FrameLab.Resize.fit(full, px)
				images[cacheKey] = img
			end
			if shown[part] ~= s then
				return
			end
			-- block pictures (Image.Blocks, when the pattern library is in place): one ImageLabel per 8x8 / 4x4 block, no
			-- gradients, no streaks. O sprays: the threshold rises a little, then the picture shrinks, until it fits
			-- SprayOriginalPieces objects
			local Blocks = require(root.Image.Blocks)
			if Blocks.ready() then
				local budget = budgetOf(original, level)
				local listKey = cacheKey .. "#blocks" .. budget
				local list = images[listKey]
				if not list then
					local cur = img
					while true do
						for _, T in ipairs({ 6, 9 }) do
							list = Blocks.encode(cur, { Threshold = T, Yield = true })
							if list.count <= budget then
								break
							end
						end
						if list.count <= budget or math.max(cur.width, cur.height) < 80 then
							break
						end
						cur = FrameLab.Resize.fit(img, math.floor(math.max(cur.width, cur.height) * 0.85))
					end
					images[listKey] = list
				end
				if shown[part] ~= s then
					return
				end
				s.canvas = Blocks.draw(list, gui, { KeepAspect = false })
				if s.old and shown[part] == s then
					drop(s.old)
					s.old = nil
				end
				return
			end
			-- a full-resolution picture: as sharp as the strip budget allows (Roblox draws only so many gradients, see
			-- Render/Canvas), so the tolerance rises until it fits
			local tol = 12
			if original then
				-- a full-resolution picture, as sharp as the budget allows. With the ramp image the cost is GUI objects (one per
				-- keypoint pair); without it, strips (each needs a gradient). The tolerance stays low (raising it smears the
				-- picture sideways); past the budget the picture is drawn smaller instead (softer, not smeared)
				local fit = images[cacheKey .. "#fit"]
				if not fit then
					local ramp = FrameLab.Canvas.rampImage() ~= nil
					local limit = ramp and (Config.SprayOriginalPieces or 9000) or (Config.SprayOriginalStrips or 160)
					-- GUI objects: a strip with its own gradient is 1 (the longest ones get those: about 120 of the sprays'
					-- share, Canvas.MaxStaticGradients), a flat one 1, the rest 1 + one ramp piece per segment
					local function cost(strips)
						if not ramp then
							return #strips.list
						end
						local segs = {}
						for _, st in ipairs(strips.list) do
							table.insert(segs, #st.kp - 1)
						end
						table.sort(segs, function(a, b)
							return a > b
						end)
						local n = 0
						for i, k in ipairs(segs) do
							n += (i <= 120 or k <= 1) and 1 or (1 + k)
						end
						return n
					end
					-- (sharp first, then a little softer; past that the picture is drawn smaller. A photo at tolerance 24 came out
					-- streaky (rows smeared sideways); the same budget at a smaller size and tolerance 10 looked far better)
					local tols = ramp and { 10, 14 } or { 12, 24, 40 }
					local cur, side = img, math.max(img.width, img.height)
					while not fit do
						for _, t in ipairs(tols) do
							if cost(FrameLab.encode(cur, { Tolerance = t })) <= limit then
								fit = { img = cur, tol = t }
								break
							end
							task.wait()
						end
						if not fit then
							side = math.floor(side * 0.8)
							if side < 64 then
								fit = { img = cur, tol = tols[#tols] }
							else
								cur = FrameLab.Resize.fit(img, side)
							end
						end
					end
					images[cacheKey .. "#fit"] = fit
				end
				img, tol = fit.img, fit.tol
				if shown[part] ~= s then
					return
				end
			end
			s.canvas = FrameLab.show(img, gui, { Tolerance = tol, KeepAspect = false })
			if s.old and shown[part] == s then
				drop(s.old)
				s.old = nil
			end
		end)
	end

	folder.ChildRemoved:Connect(hide)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.5 then
			return
		end
		acc = 0
		-- respawning clears the PlayerGui, this folder and its sprays too: draw them again in a new one
		if holder.Parent ~= playerGui then
			for p in pairs(shown) do
				hide(p)
			end
			holder = newHolder()
		end
		local cam = workspace.CurrentCamera
		local from = cam and cam.CFrame.Position or Vector3.zero
		local cands = {}
		for _, p in ipairs(folder:GetChildren()) do
			local kind = p:GetAttribute("Kind")
			if (kind == "image" or kind == "url") and p:IsA("BasePart") then
				local d = (p.Position - from).Magnitude
				if d <= (Config.SprayViewDistance or 150) then
					table.insert(cands, { p = p, d = d })
				end
			end
		end
		table.sort(cands, function(a, b)
			return a.d < b.d
		end)
		local want = {}
		local maxShown = Config.SprayMaxRendered or 24
		if performance() then
			maxShown = math.min(maxShown, Config.SprayPhoneMaxRendered or 8)
		end
		-- full detail within SprayDetailDistance (a big spray from further: it looks big from further), cheap beyond
		-- (a little further before going back to cheap: no flipping at the edge)
		local near = Config.SprayDetailDistance or 40
		for i = 1, math.min(#cands, maxShown) do
			local c = cands[i]
			local reach = near * math.max(1, math.max(c.p.Size.X, c.p.Size.Y) / 8)
			local cur = shown[c.p]
			local level
			if cur and cur.level == "near" then
				level = (c.d <= reach * 1.25) and "near" or "far"
			else
				level = (c.d <= reach) and "near" or "far"
			end
			want[c.p] = level
		end
		for p in pairs(shown) do
			if not want[p] then
				hide(p)
			end
		end
		for p, level in pairs(want) do
			local cur = shown[p]
			if not cur then
				show(p, level)
			elseif cur.level ~= level and cur.canvas then
				-- switch detail: the new drawing replaces the old one once it is drawn
				shown[p] = nil
				local old = cur.old
				cur.old = nil
				if old then
					drop(old)
				end
				show(p, level, cur)
			end
		end
	end)
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">DataManager</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab:init() on a client: the data manager panel (admins). Opened from the TV picker's "Data" button
-- (FrameLab.openDataManager()). Lists this server's imports and the kept records (Runtime/Server/Library): thumbnail,
-- name, kind, quality, length, size, who imported it, whether it is in memory; Load (import again from its URL),
-- Delete, and the URL to copy. The header shows how much the server holds.
return function(FrameLab)
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	if not player then
		return
	end
	local playerGui = player:WaitForChild("PlayerGui")
	local root = script:FindFirstAncestor("FrameLab")
	local Net = require(root.Tools.Net)

	local C = {
		bg = Color3.fromRGB(20, 23, 30), panel = Color3.fromRGB(28, 32, 41), row = Color3.fromRGB(34, 38, 48),
		text = Color3.fromRGB(230, 233, 240), dim = Color3.fromRGB(150, 158, 175), red = Color3.fromRGB(200, 70, 70),
		green = Color3.fromRGB(90, 190, 120), amber = Color3.fromRGB(220, 170, 70),
	}
	local function make(class, props, parent)
		local o = Instance.new(class)
		for k, v in pairs(props) do
			if k ~= "Corner" then -- (ours: rounded corners, not a property)
				o[k] = v
			end
		end
		if class == "TextButton" or class == "TextBox" or (class == "Frame" and props.Corner) then
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, 6)
			c.Parent = o
		end
		o.Parent = parent
		return o
	end
	local function btn(parent, text, w, color)
		return make("TextButton", {
			Size = UDim2.new(0, w, 0, 24), BackgroundColor3 = color or C.row, TextColor3 = C.text, Text = text,
			Font = Enum.Font.GothamMedium, TextSize = 12, AutoButtonColor = true,
		}, parent)
	end
	local function mb(n)
		if not n then
			return "?"
		end
		if n >= 1048576 then
			return ("%.1f MB"):format(n / 1048576)
		end
		return ("%d KB"):format(math.floor(n / 1024 + 0.5))
	end
	local function clock(s)
		if not s then
			return ""
		end
		s = math.floor(s + 0.5)
		return ("%d:%02d"):format(s // 60, s % 60)
	end

	local gui
	local thumbCache = {}
	local function close()
		if gui then
			gui:Destroy()
			gui = nil
		end
	end

	-- a thumbnail (rgb, w x h from the server) into frame
	local function drawThumb(frame, id)
		task.spawn(function()
			local t = thumbCache[id]
			if not t then
				local ok, r = pcall(Net.invoke, "libThumb", id)
				if not ok or type(r) ~= "table" or typeof(r.rgb) ~= "buffer" then
					return
				end
				local data = buffer.create(r.w * r.h * 4)
				for i = 0, r.w * r.h - 1 do
					buffer.writeu8(data, i * 4, buffer.readu8(r.rgb, i * 3))
					buffer.writeu8(data, i * 4 + 1, buffer.readu8(r.rgb, i * 3 + 1))
					buffer.writeu8(data, i * 4 + 2, buffer.readu8(r.rgb, i * 3 + 2))
					buffer.writeu8(data, i * 4 + 3, 255)
				end
				t = { width = r.w, height = r.h, data = data }
				thumbCache[id] = t
			end
			if not frame.Parent then
				return
			end
			local Blocks = require(root.Image.Blocks)
			if Blocks.ready() then
				Blocks.draw(Blocks.encode(t, { Threshold = 5 }), frame, {})
			else
				FrameLab.show(t, frame, { Tolerance = 8, Yield = false })
			end
		end)
	end

	local refresh
	local function open()
		close()
		gui = make("ScreenGui", { Name = "FrameLabDataManager", ResetOnSpawn = false, DisplayOrder = 30 }, playerGui)
		local panel = make("Frame", {
			Size = UDim2.new(0, 600, 0, 480), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = C.bg, Corner = true,
		}, gui)
		local pad = Instance.new("UIPadding")
		for _, k in ipairs({ "PaddingTop", "PaddingBottom", "PaddingLeft", "PaddingRight" }) do
			pad[k] = UDim.new(0, 12)
		end
		pad.Parent = panel
		make("TextLabel", {
			Size = UDim2.new(1, -80, 0, 22), BackgroundTransparency = 1, Text = "Data manager", TextColor3 = C.text,
			Font = Enum.Font.GothamBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left,
		}, panel)
		local closeBtn = btn(panel, "Close", 64)
		closeBtn.Position = UDim2.new(1, -64, 0, 0)
		closeBtn.Activated:Connect(close)
		-- the DataStore switch: keep records (URL + thumbnail) between servers. Off by default.
		local storeBtn = btn(panel, "DataStore: ...", 120)
		storeBtn.Position = UDim2.new(1, -194, 0, 0)
		local storeOn = false
		local function showStore(on)
			storeOn = on
			storeBtn.Text = on and "DataStore: On" or "DataStore: Off"
			storeBtn.BackgroundColor3 = on and Color3.fromRGB(50, 120, 80) or C.row
		end
		storeBtn.Activated:Connect(function()
			storeBtn.Text = "..."
			local ok, r = pcall(Net.invoke, "libSetStore", not storeOn)
			if ok and type(r) == "table" then
				showStore(r.on)
			else
				showStore(storeOn)
			end
			task.spawn(refresh)
		end)
		local stats = make("TextLabel", {
			Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 0, 26), BackgroundTransparency = 1, Text = "loading...",
			TextColor3 = C.dim, Font = Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, panel)
		local urlBox = make("TextBox", {
			Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(1, 0, 1, 0), AnchorPoint = Vector2.new(1, 1),
			BackgroundColor3 = C.panel, TextColor3 = C.text, Text = "", PlaceholderText = "the URL of the item you click URL on (select it and copy)",
			PlaceholderColor3 = C.dim, Font = Enum.Font.Code, TextSize = 12, ClearTextOnFocus = false, TextEditable = false,
			TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		}, panel)
		local list = make("ScrollingFrame", {
			Size = UDim2.new(1, 0, 1, -82), Position = UDim2.new(0, 0, 0, 50), BackgroundColor3 = C.panel, BorderSizePixel = 0,
			ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
		}, panel)
		make("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, list)
		local lp = Instance.new("UIPadding")
		lp.PaddingTop, lp.PaddingLeft, lp.PaddingRight, lp.PaddingBottom = UDim.new(0, 6), UDim.new(0, 6), UDim.new(0, 10), UDim.new(0, 6)
		lp.Parent = list

		local busy = false
		function refresh()
			if not gui then
				return
			end
			local okS, st = pcall(Net.invoke, "libStats")
			local okL, items = pcall(Net.invoke, "libList")
			if not gui then
				return
			end
			if not okL or type(items) ~= "table" then
				stats.Text = "only admins can open the data manager"
				return
			end
			if okS and type(st) == "table" then
				showStore(st.records == true)
				local recs = st.records and (st.storeError and ("DataStore error: " .. st.storeError) or "records kept in the DataStore")
					or (st.storeError and ("DataStore unavailable: " .. st.storeError) or "records in this server only (DataStore off)")
				stats.Text = ("%d items in this server's memory, %s  -  %s"):format(st.entries, mb(st.bytes), recs)
			end
			for _, c in ipairs(list:GetChildren()) do
				if c:IsA("Frame") then
					c:Destroy()
				end
			end
			if #items == 0 then
				make("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1 }, list)
				make("TextLabel", {
					Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Text = "nothing imported yet", TextColor3 = C.dim,
					Font = Enum.Font.Gotham, TextSize = 12,
				}, list:FindFirstChildOfClass("Frame"))
			end
			for i, it in ipairs(items) do
				local row = make("Frame", { Size = UDim2.new(1, 0, 0, 64), BackgroundColor3 = C.row, LayoutOrder = i, Corner = true }, list)
				local thumb = make("Frame", {
					Size = UDim2.new(0, 96, 0, 56), Position = UDim2.new(0, 4, 0, 4), BackgroundColor3 = Color3.new(0, 0, 0),
					BorderSizePixel = 0, ClipsDescendants = true,
				}, row)
				local audio = it.kind == "sound" or it.kind == "music"
				if it.thumb then
					drawThumb(thumb, it.id)
				elseif audio then
					thumb.BackgroundColor3 = it.kind == "music" and Color3.fromRGB(60, 40, 90) or Color3.fromRGB(30, 60, 80)
					make("TextLabel", {
						Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = it.kind == "music" and "MUSIC" or "SOUND",
						TextColor3 = C.text, Font = Enum.Font.GothamBold, TextSize = 13,
					}, thumb)
				end
				local name = tostring(it.name or "?"):gsub("^imported/", "")
				make("TextLabel", {
					Size = UDim2.new(1, -330, 0, 20), Position = UDim2.new(0, 108, 0, 6), BackgroundTransparency = 1, Text = name,
					TextColor3 = C.text, Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
				}, row)
				local info = { it.kind == "image" and "picture" or (audio and (it.kind == "music" and "AudioLab music" or "AudioLab sound")) or "video" }
				if it.detail then
					table.insert(info, it.detail)
				end
				if it.quality then
					table.insert(info, it.quality)
				end
				if it.width and it.height then
					table.insert(info, it.width .. "x" .. it.height)
				end
				if it.seconds then
					table.insert(info, clock(it.seconds))
				end
				table.insert(info, mb(it.bytes))
				if it.by then
					table.insert(info, "by " .. it.by)
				end
				make("TextLabel", {
					Size = UDim2.new(1, -330, 0, 16), Position = UDim2.new(0, 108, 0, 26), BackgroundTransparency = 1,
					Text = table.concat(info, "  -  "), TextColor3 = C.dim, Font = Enum.Font.Gotham, TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
				}, row)
				local status = it.loaded and (it.kept and "in memory, kept" or "in memory (this server only)")
					or (audio and "kept, not loaded (import it again in the music player, Studio)" or "kept, not loaded")
				make("TextLabel", {
					Size = UDim2.new(1, -330, 0, 16), Position = UDim2.new(0, 108, 0, 42), BackgroundTransparency = 1, Text = status,
					TextColor3 = it.loaded and C.green or C.amber, Font = Enum.Font.Gotham, TextSize = 11,
					TextXAlignment = Enum.TextXAlignment.Left,
				}, row)
				local x = -8
				local function action(text, w, color, fn)
					local b = btn(row, text, w, color)
					b.AnchorPoint = Vector2.new(1, 0.5)
					b.Position = UDim2.new(1, x, 0.5, 0)
					x -= w + 6
					b.Activated:Connect(function()
						if busy then
							return
						end
						busy = true
						local old = b.Text
						b.Text = "..."
						local ok, err = pcall(fn)
						if not ok then
							stats.Text = tostring(err)
						end
						if b.Parent then
							b.Text = old
						end
						busy = false
					end)
					return b
				end
				local confirm = false
				local del
				del = action("Delete", 64, C.red, function()
					if not confirm then
						confirm = true
						task.delay(0.05, function()
							if del.Parent then
								del.Text = "Sure?"
							end
						end)
						task.delay(3, function()
							confirm = false
							if del.Parent then
								del.Text = "Delete"
							end
						end)
						return
					end
					local r = Net.invoke("libDelete", it.id)
					if type(r) == "table" and r.error then
						error(r.error, 0)
					end
					pcall(Net.forget)
					task.defer(refresh)
				end)
				if it.url then
					action("URL", 48, nil, function()
						urlBox.Text = it.url
						urlBox:CaptureFocus()
						urlBox.SelectionStart = 1
						urlBox.CursorPosition = #urlBox.Text + 1
					end)
				end
				if not it.loaded and it.kept and not audio then
					action("Load", 56, Color3.fromRGB(50, 90, 160), function()
						stats.Text = "loading " .. name .. " from its URL (the import progress shows in the TV picker)..."
						local r = Net.invoke("libLoad", it.id)
						if type(r) == "table" and r.error then
							error("couldn't load: " .. r.error, 0)
						end
						pcall(Net.forget)
						task.defer(refresh)
					end)
				end
			end
		end
		task.spawn(refresh)
	end

	FrameLab.openDataManager = open
	FrameLab.closeDataManager = close

	-- in the Labs menu (LabHub) for admins
	local hubOk, LabHub = pcall(function()
		return require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub", 5))
	end)
	if hubOk and LabHub then
		local hub
		local baseOpen = open
		-- (one Lab window at a time: opening this closes the others, and the hub can close this one)
		open = function()
			baseOpen()
			if hub then
				hub.opened()
			end
		end
		FrameLab.openDataManager = open
		hub = LabHub.add({
			id = "data", label = "Data", order = 20,
			closeWindow = close,
			isOpen = function()
				return gui ~= nil
			end,
			action = function()
				if gui then
					close()
				else
					open()
				end
			end,
			available = function()
				return Net.isAdmin()
			end,
		})
	end
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">SettingsPanel</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab:init() on a client: the settings panel (the game's owner; anyone in a Studio test), in the Labs
-- menu (LabHub). Every FrameLab and AudioLab setting: switches, choices, numbers and text. A change applies at once;
-- Save keeps them all (a DataStore) and every server starts with them, over the place's own values.
return function(FrameLab)
	local Players = game:GetService("Players")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local player = Players.LocalPlayer
	if not player then
		return
	end
	local playerGui = player:WaitForChild("PlayerGui")
	local root = script:FindFirstAncestor("FrameLab")
	local Net = require(root.Tools.Net)

	local C = {
		bg = Color3.fromRGB(20, 23, 30), panel = Color3.fromRGB(28, 32, 41), row = Color3.fromRGB(34, 38, 48),
		text = Color3.fromRGB(230, 233, 240), dim = Color3.fromRGB(150, 158, 175), on = Color3.fromRGB(50, 120, 80),
		blue = Color3.fromRGB(50, 90, 160), red = Color3.fromRGB(160, 60, 60),
	}
	local openChoices -- (below)
	local openPeople -- (below)
	local function make(class, props, parent)
		local o = Instance.new(class)
		for k, v in pairs(props) do
			o[k] = v
		end
		if class == "TextButton" or class == "TextBox" then
			local c = Instance.new("UICorner")
			c.CornerRadius = UDim.new(0, 6)
			c.Parent = o
		end
		o.Parent = parent
		return o
	end
	local function btn(parent, text, w, color)
		return make("TextButton", {
			Size = UDim2.new(0, w, 0, 24), BackgroundColor3 = color or C.row, TextColor3 = C.text, Text = text,
			Font = Enum.Font.GothamMedium, TextSize = 12, AutoButtonColor = true,
		}, parent)
	end

	-- the window (hidden until picked in the Labs menu)
	local gui = make("ScreenGui", { Name = "LabSettings", ResetOnSpawn = false, DisplayOrder = 30 }, playerGui)
	local win = make("Frame", {
		Size = UDim2.new(0, 560, 0, 500), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = C.bg, Visible = false,
	}, gui)
	local wc = Instance.new("UICorner")
	wc.CornerRadius = UDim.new(0, 12)
	wc.Parent = win
	local pad = Instance.new("UIPadding")
	for _, k in ipairs({ "PaddingTop", "PaddingBottom", "PaddingLeft", "PaddingRight" }) do
		pad[k] = UDim.new(0, 12)
	end
	pad.Parent = win
	make("TextLabel", {
		Size = UDim2.new(1, -320, 0, 24), BackgroundTransparency = 1, Text = "Settings", TextColor3 = C.text,
		Font = Enum.Font.GothamBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left,
	}, win)
	local closeB = btn(win, "Close", 60)
	closeB.Position = UDim2.new(1, -60, 0, 0)
	local saveB = btn(win, "Save", 60, C.blue)
	saveB.Position = UDim2.new(1, -126, 0, 0)
	local clearB = btn(win, "Clear saved", 90, C.red)
	clearB.Position = UDim2.new(1, -222, 0, 0)
	-- the TV and Spray Paint tools for you, whatever the access settings say
	local toolsB = btn(win, "Get tools", 76, C.on)
	toolsB.Position = UDim2.new(1, -304, 0, 0)
	local status = make("TextLabel", {
		Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0, 28), BackgroundTransparency = 1, Text = "",
		TextColor3 = C.dim, Font = Enum.Font.Gotham, TextSize = 11, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
	}, win)
	local list = make("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, -64), Position = UDim2.new(0, 0, 0, 64), BackgroundColor3 = C.panel, BorderSizePixel = 0,
		ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
	}, win)
	make("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	local lp = Instance.new("UIPadding")
	lp.PaddingTop, lp.PaddingLeft, lp.PaddingRight, lp.PaddingBottom = UDim.new(0, 6), UDim.new(0, 6), UDim.new(0, 10), UDim.new(0, 6)
	lp.Parent = list

	local function say(text)
		status.Text = text
	end

	-- the open dropdown list (one at a time; closes on a pick or a click elsewhere in the window)
	local choiceList
	local function closeChoices()
		if choiceList then
			choiceList:Destroy()
			choiceList = nil
		end
	end
	local set -- (below)
	function openChoices(anchor, it)
		local wasFor = choiceList and choiceList:GetAttribute("For")
		closeChoices()
		if wasFor == it.folder .. "." .. it.key then
			return -- (a second click closes it)
		end
		local a, s = anchor.AbsolutePosition - win.AbsolutePosition, anchor.AbsoluteSize
		choiceList = make("Frame", {
			Position = UDim2.fromOffset(a.X - 12, a.Y + s.Y + 2 - 12), Size = UDim2.fromOffset(s.X, #it.choices * 26 + 6),
			BackgroundColor3 = C.bg, BorderSizePixel = 0, ZIndex = 20,
		}, win)
		choiceList:SetAttribute("For", it.folder .. "." .. it.key)
		local st = Instance.new("UIStroke")
		st.Color = Color3.fromRGB(70, 78, 96)
		st.Parent = choiceList
		local cc = Instance.new("UICorner")
		cc.CornerRadius = UDim.new(0, 6)
		cc.Parent = choiceList
		for i, v in ipairs(it.choices) do
			local b = btn(choiceList, tostring(v), s.X - 6, v == it.value and C.on or C.row)
			b.Position = UDim2.fromOffset(3, 3 + (i - 1) * 26)
			b.ZIndex = 21
			b.Activated:Connect(function()
				closeChoices()
				if v ~= it.value then
					set(it, v)
				end
			end)
		end
	end
	list:GetPropertyChangedSignal("CanvasPosition"):Connect(closeChoices)

	-- a list of people (Admins, ToolAccessList): who is on it (name and UserId), remove with x, add with + by name or
	-- UserId or from the players in this server; each kept as a UserId (survives name changes) or a username
	local peopleView
	local saveAsId = true
	function openPeople(it)
		closeChoices()
		if peopleView then
			peopleView:Destroy()
		end
		local v = make("Frame", {
			Size = UDim2.new(1, 0, 1, -64), Position = UDim2.new(0, 0, 0, 64), BackgroundColor3 = C.panel, ZIndex = 10,
			BorderSizePixel = 0,
		}, win)
		peopleView = v
		local title = make("TextLabel", {
			Size = UDim2.new(1, -90, 0, 26), Position = UDim2.new(0, 8, 0, 4), BackgroundTransparency = 1,
			Text = it.key == "Admins" and "Admins (import, Data, URL pictures)" or (it.key .. " (who gets tools set to \"list\")"),
			TextColor3 = C.text, Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11,
		}, v)
		local done = btn(v, "Done", 70, C.blue)
		done.Position = UDim2.new(1, -78, 0, 4)
		done.ZIndex = 11
		done.Activated:Connect(function()
			v:Destroy()
			peopleView = nil
			task.spawn(refresh)
		end)
		-- add row: name / UserId box, players here, save as, add
		local box = make("TextBox", {
			Size = UDim2.new(0, 170, 0, 26), Position = UDim2.new(0, 8, 0, 36), BackgroundColor3 = C.row, TextColor3 = C.text,
			PlaceholderText = "username or UserId", PlaceholderColor3 = C.dim, Text = "", Font = Enum.Font.Gotham, TextSize = 12,
			ClearTextOnFocus = false, ZIndex = 11,
		}, v)
		local here = btn(v, "Players here  v", 110, C.row)
		here.Position = UDim2.new(0, 184, 0, 37)
		here.ZIndex = 11
		local asB = btn(v, "", 120, C.row)
		asB.Position = UDim2.new(0, 300, 0, 37)
		asB.ZIndex = 11
		local function showAs()
			asB.Text = saveAsId and "Save as: UserId" or "Save as: Username"
		end
		showAs()
		asB.Activated:Connect(function()
			saveAsId = not saveAsId
			showAs()
		end)
		local add = btn(v, "+ Add", 64, C.on)
		add.Position = UDim2.new(0, 426, 0, 37)
		add.ZIndex = 11
		local note = make("TextLabel", {
			Size = UDim2.new(1, -16, 0, 16), Position = UDim2.new(0, 8, 0, 66), BackgroundTransparency = 1,
			Text = "A UserId keeps working when someone changes their name.", TextColor3 = C.dim, Font = Enum.Font.Gotham,
			TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11,
		}, v)
		local rows = make("ScrollingFrame", {
			Size = UDim2.new(1, -16, 1, -94), Position = UDim2.new(0, 8, 0, 88), BackgroundTransparency = 1, BorderSizePixel = 0,
			ScrollBarThickness = 4, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ZIndex = 11,
		}, v)
		make("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, rows)

		local current = tostring(it.value)
		local function entries()
			local list = {}
			for e in string.gmatch(current, "[^,%s]+") do
				table.insert(list, e)
			end
			return list
		end
		local function store(list)
			current = table.concat(list, ", ")
			local ok, r = pcall(Net.invoke, "settingsSet", it.folder, it.key, current)
			if ok and type(r) == "table" and r.ok then
				it.value = current
				say(it.key .. " changed (applied; Save to keep it)")
			else
				say("couldn't change " .. it.key)
			end
		end
		local draw
		function draw()
			for _, c in ipairs(rows:GetChildren()) do
				if c:IsA("Frame") then
					c:Destroy()
				end
			end
			local okP, data = pcall(Net.invoke, "settingsPeople", it.folder, it.key)
			if not okP or type(data) ~= "table" then
				return
			end
			if #data.entries == 0 then
				local r = make("Frame", { Size = UDim2.new(1, -6, 0, 28), BackgroundTransparency = 1, ZIndex = 11 }, rows)
				make("TextLabel", {
					Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "nobody yet", TextColor3 = C.dim,
					Font = Enum.Font.Gotham, TextSize = 12, ZIndex = 12,
				}, r)
			end
			for i, e in ipairs(data.entries) do
				local r = make("Frame", { Size = UDim2.new(1, -6, 0, 30), BackgroundColor3 = C.row, LayoutOrder = i, ZIndex = 11 }, rows)
				local rc = Instance.new("UICorner")
				rc.CornerRadius = UDim.new(0, 6)
				rc.Parent = r
				local label = e.name and (e.userId and ("%s  (%d)"):format(e.name, e.userId) or e.name) or ("UserId " .. e.entry .. " (not found)")
				if not e.byId and not e.userId then
					label = e.entry .. "  (no such user)"
				end
				make("TextLabel", {
					Size = UDim2.new(1, -150, 1, 0), Position = UDim2.new(0, 8, 0, 0), BackgroundTransparency = 1, Text = label,
					TextColor3 = C.text, Font = Enum.Font.GothamMedium, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 12,
				}, r)
				make("TextLabel", {
					Size = UDim2.new(0, 100, 1, 0), Position = UDim2.new(1, -140, 0, 0), BackgroundTransparency = 1,
					Text = e.byId and "saved as UserId" or "saved as name", TextColor3 = C.dim, Font = Enum.Font.Gotham,
					TextSize = 11, ZIndex = 12,
				}, r)
				local x = btn(r, "x", 26, C.red)
				x.AnchorPoint = Vector2.new(1, 0.5)
				x.Position = UDim2.new(1, -4, 0.5, 0)
				x.ZIndex = 12
				x.Activated:Connect(function()
					local list = entries()
					local idx = table.find(list, e.entry)
					if idx then
						table.remove(list, idx)
						store(list)
						draw()
					end
				end)
			end
		end
		local function addPerson(text)
			if text == "" then
				return
			end
			note.Text = "looking up " .. text .. "..."
			local okR, who = pcall(Net.invoke, "settingsResolve", text)
			if not okR or type(who) ~= "table" or who.error then
				note.Text = type(who) == "table" and who.error or "couldn't look that up"
				return
			end
			local token = saveAsId and tostring(who.userId) or who.name
			local list = entries()
			for _, e in ipairs(list) do
				if e == token or e == tostring(who.userId) or string.lower(e) == string.lower(who.name) then
					note.Text = who.name .. " is already on the list"
					return
				end
			end
			table.insert(list, token)
			store(list)
			box.Text = ""
			note.Text = ("added %s (%d)"):format(who.name, who.userId)
			draw()
		end
		add.Activated:Connect(function()
			addPerson(box.Text)
		end)
		box.FocusLost:Connect(function(enter)
			if enter then
				addPerson(box.Text)
			end
		end)
		-- players in this server, to pick from
		local pick
		here.Activated:Connect(function()
			if pick then
				pick:Destroy()
				pick = nil
				return
			end
			local okP, data = pcall(Net.invoke, "settingsPeople", it.folder, it.key)
			local online = okP and type(data) == "table" and data.online or {}
			pick = make("ScrollingFrame", {
				Size = UDim2.fromOffset(200, math.min(#online, 8) * 28 + 8), Position = UDim2.new(0, 184, 0, 66),
				BackgroundColor3 = C.bg, BorderSizePixel = 0, ScrollBarThickness = 4, ZIndex = 30,
				AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
			}, v)
			make("UIListLayout", { Padding = UDim.new(0, 2) }, pick)
			for _, p in ipairs(online) do
				local b = btn(pick, (p.display ~= p.name) and ("%s (@%s)"):format(p.display, p.name) or p.name, 194, C.row)
				b.ZIndex = 31
				b.Activated:Connect(function()
					pick:Destroy()
					pick = nil
					addPerson(tostring(p.userId))
				end)
			end
		end)
		task.spawn(draw)
	end

	local refresh
	function set(it, value)
		local ok, r = pcall(Net.invoke, "settingsSet", it.folder, it.key, value)
		if not ok or type(r) ~= "table" then
			say("couldn't change " .. it.key)
		elseif r.error then
			say(it.key .. ": " .. r.error)
		else
			say(("%s is now %s (applied; Save to keep it)"):format(it.key, tostring(r.value)))
		end
		task.spawn(refresh)
	end

	function refresh()
		local ok, data = pcall(Net.invoke, "settingsGet")
		if not ok or type(data) ~= "table" then
			say("only the game's owner can change settings")
			return
		end
		local head = data.store and (data.hasSaved and "Saved settings are applied on every server." or "Nothing saved yet: the place's own values are used.")
			or ("No DataStore (" .. tostring(data.storeError) .. "): changes last for this server only.")
		say(head .. " Changes apply at once; Save keeps them.")
		local canvasY = list.CanvasPosition.Y
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("Frame") then
				c:Destroy()
			end
		end
		local lastFolder
		local order = 0
		for _, it in ipairs(data.items) do
			if it.folder ~= lastFolder then
				lastFolder = it.folder
				order += 1
				local hdr = make("Frame", { Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, LayoutOrder = order }, list)
				make("TextLabel", {
					Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = string.upper(it.folder), TextColor3 = C.dim,
					Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
				}, hdr)
			end
			order += 1
			local row = make("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = C.row, LayoutOrder = order }, list)
			local rc = Instance.new("UICorner")
			rc.CornerRadius = UDim.new(0, 6)
			rc.Parent = row
			local isDefault = it.value == it.default
			make("TextLabel", {
				Size = UDim2.new(0.5, -8, 1, 0), Position = UDim2.new(0, 8, 0, 0), BackgroundTransparency = 1,
				Text = it.key .. (isDefault and "" or "  *"), TextColor3 = C.text, Font = Enum.Font.GothamMedium, TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
			}, row)
			local ctl
			if it.kind == "people" then
				local n = 0
				for _ in string.gmatch(tostring(it.value), "[^,%s]+") do
					n += 1
				end
				ctl = btn(row, (n == 1 and "1 person" or (n .. " people")) .. "  -  Edit", 140, C.panel)
				ctl.Activated:Connect(function()
					openPeople(it)
				end)
			elseif it.kind == "boolean" then
				ctl = btn(row, it.value and "On" or "Off", 70, it.value and C.on or C.panel)
				ctl.Activated:Connect(function()
					set(it, not it.value)
				end)
			elseif it.choices then
				-- a dropdown: the value and an arrow; the choices open in a list under it
				ctl = btn(row, tostring(it.value) .. "  v", 120, C.panel)
				ctl.Activated:Connect(function()
					openChoices(ctl, it)
				end)
			else
				ctl = make("TextBox", {
					Size = UDim2.new(0, it.kind == "number" and 90 or 220, 0, 24), BackgroundColor3 = C.panel, TextColor3 = C.text,
					Text = tostring(it.value), Font = Enum.Font.Code, TextSize = 12, ClearTextOnFocus = false,
					TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
				}, row)
				ctl.FocusLost:Connect(function(enter)
					local v = ctl.Text
					if it.kind == "number" then
						v = tonumber(v)
						if not v then
							say(it.key .. " takes a number")
							ctl.Text = tostring(it.value)
							return
						end
					end
					if v ~= it.value then
						set(it, v)
					end
				end)
			end
			ctl.AnchorPoint = Vector2.new(1, 0.5)
			ctl.Position = UDim2.new(1, -60, 0.5, 0)
			local def = btn(row, "Default", 52, C.panel)
			def.TextSize = 10
			def.AnchorPoint = Vector2.new(1, 0.5)
			def.Position = UDim2.new(1, -4, 0.5, 0)
			def.Visible = not isDefault
			def.Activated:Connect(function()
				pcall(Net.invoke, "settingsDefault", it.folder, it.key)
				say(it.key .. " is back to its default (Save to keep it)")
				task.spawn(refresh)
			end)
		end
		list.CanvasPosition = Vector2.new(0, canvasY)
	end

	toolsB.Activated:Connect(function()
		local ok, r = pcall(Net.invoke, "toolsGive")
		if ok and type(r) == "table" and r.ok then
			say("The TV and Spray Paint tools are in your backpack.")
		else
			say(type(r) == "table" and r.error or "couldn't give the tools")
		end
	end)
	saveB.Activated:Connect(function()
		say("saving...")
		local ok, r = pcall(Net.invoke, "settingsSave")
		if ok and type(r) == "table" and r.ok then
			say("Saved: every server starts with these settings.")
		else
			say(type(r) == "table" and r.error or "couldn't save")
		end
	end)
	local clearArmed = false
	clearB.Activated:Connect(function()
		if not clearArmed then
			clearArmed = true
			clearB.Text = "Sure?"
			task.delay(3, function()
				clearArmed = false
				clearB.Text = "Clear saved"
			end)
			return
		end
		local ok, r = pcall(Net.invoke, "settingsClear")
		if ok and type(r) == "table" and r.ok then
			say("Saved settings cleared: the next server uses the place's own values.")
		else
			say(type(r) == "table" and r.error or "couldn't clear")
		end
	end)

	win:GetPropertyChangedSignal("Visible"):Connect(function()
		closeChoices()
		if peopleView then
			peopleView:Destroy()
			peopleView = nil
		end
		if win.Visible then
			task.spawn(refresh)
		end
	end)

	local hubOk, LabHub = pcall(function()
		return require(ReplicatedStorage:WaitForChild("LabHub", 5))
	end)
	if hubOk and LabHub then
		local hub = LabHub.add({
			id = "settings", label = "Settings", order = 90, toggle = win,
			available = function()
				local ok, d = pcall(Net.invoke, "settingsGet")
				return ok and type(d) == "table" and d.owner == true
			end,
		})
		closeB.Activated:Connect(function()
			hub.close()
		end)
	else
		closeB.Activated:Connect(function()
			win.Visible = false
		end)
	end
	FrameLab.openSettings = function()
		win.Visible = true
	end
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">ToolBinder</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab.init() on each client: gives the Lab tools their behaviour. A "TV" tool runs FrameLab.Tools.TVTool
-- and a "Spray Paint" tool runs FrameLab.Tools.SprayTool, once per tool, when it reaches this player's Backpack or
-- character (the tools hold no scripts: the server builds them from LabHub.Blueprints).
return function(FrameLab)
	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	local root = script:FindFirstAncestor("FrameLab")
	local BEHAVIOUR = { TV = "TVTool", ["Spray Paint"] = "SprayTool" }
	local bound = setmetatable({}, { __mode = "k" })

	local function bind(tool)
		local name = tool:IsA("Tool") and BEHAVIOUR[tool.Name]
		if not name or bound[tool] then
			return
		end
		bound[tool] = true
		task.spawn(function()
			local ok, err = pcall(function()
				require(root.Tools[name])(tool)
			end)
			if not ok then
				warn(("[FrameLab] %s tool: %s"):format(tool.Name, tostring(err)))
			end
		end)
	end
	local function watch(container)
		for _, c in ipairs(container:GetChildren()) do
			bind(c)
		end
		container.ChildAdded:Connect(bind)
	end

	-- the Backpack is replaced on every respawn; the character holds the equipped tool
	player.ChildAdded:Connect(function(c)
		if c:IsA("Backpack") then
			watch(c)
		end
	end)
	local bp = player:FindFirstChildOfClass("Backpack")
	if bp then
		watch(bp)
	end
	player.CharacterAdded:Connect(watch)
	if player.Character then
		watch(player.Character)
	end
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="48">
          <Properties>
            <string name="Name">Server</string>
            <BinaryString name="AttributesSerialize"></BinaryString>
            <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
            <Color3 name="IconTint">
              <R>0</R>
              <G>0</G>
              <B>0</B>
            </Color3>
            <bool name="DefinesCapabilities">false</bool>
            <BinaryString name="SerializedOverrides">
            </BinaryString>
            <int64 name="SourceAssetId">-1</int64>
          </Properties>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Media</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab:init() on the server: makes the FrameLab remotes and answers the clients'
-- requests for videos and pictures. Videos in ServerStorage.FrameLabData (the big ones) never replicate; a client gets
-- only the byte ranges it asks for, while it plays them. Other server runtimes add actions to FrameLab.Server.handlers.
return function(FrameLab)
	local Players = game:GetService("Players")
	local ServerStorage = game:GetService("ServerStorage")
	local root = script:FindFirstAncestor("FrameLab")
	local Net = require(root.Tools.Net)
	local Store = FrameLab.Store
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))
	local remotes = Net.remotes(true)

	local function serverRoot(kind)
		local data = ServerStorage:FindFirstChild("FrameLabData")
		return data and data:FindFirstChild(kind)
	end
	local function roots(kind) -- "Videos" / "Images": the replicated library, then the server-only one
		local list = { root.Data[kind] }
		local s = serverRoot(kind)
		if s then
			table.insert(list, s)
		end
		return list
	end
	-- in-game imports: kept in memory while the server runs ("imported/<name>"); Sounds: their AudioLab clips
	-- ("video/imported/<name>"), sent to a client only when it plays one (clipHead / clipRange)
	local session = { Images = {}, Videos = {}, Sounds = {} }
	local function sessionEntry(kind, name)
		local s = session[kind] and session[kind][name]
		if not s then
			return nil
		end
		return {
			Name = name,
			GetAttribute = function(_, k)
				return s.attrs[k]
			end,
			GetAttributes = function()
				return table.clone(s.attrs)
			end,
		}
	end
	local function find(kind, name)
		local se = sessionEntry(kind, name)
		if se then
			return "session", se
		end
		for _, r in ipairs(roots(kind)) do
			if Store.has(r, name) then
				return r, Store.entry(r, name)
			end
		end
		return nil
	end

	-- recently read entries (decoding a big entry's text is the slow part)
	local cache, order = {}, {}
	local function readEntry(kind, name)
		local key = kind .. "/" .. name
		local c = cache[key]
		if c then
			return c
		end
		local r = find(kind, name)
		if not r then
			return nil
		end
		if r == "session" then
			return session[kind][name].bytes
		end
		c = Store.read(r, name)
		cache[key] = c
		table.insert(order, key)
		if #order > (Config.CachedEntries or 6) then
			cache[table.remove(order, 1)] = nil
		end
		return c
	end

	local function isAdmin(player)
		if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
			return true
		end
		if game.CreatorType == Enum.CreatorType.Group then
			local ok, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
			if ok and rank >= 254 then
				return true
			end
		end
		return Config.listed(player, "Admins")
	end

	local server = { handlers = {}, isAdmin = isAdmin, readEntry = readEntry, find = find, remotes = remotes, urlImages = {}, session = session }
	require(root.Sync).extraEntry = function(name)
		return sessionEntry("Videos", name)
	end
	-- seconds a client needs to download an imported video's sound (~300 KB/s with FrameLab.Net.clip, plus a margin)
	require(root.Sync).soundLoadDelay = function(clip)
		local s = session.Sounds[clip]
		if not s then
			return 0
		end
		local size = typeof(s.bytes) == "buffer" and buffer.len(s.bytes) or #tostring(s.bytes)
		return math.clamp(size / 300000 + 0.7, 0.5, 6)
	end

	local function listOf(kind)
		local out, seen = {}, {}
		local names = {}
		for name in pairs(session[kind]) do
			table.insert(names, name)
		end
		table.sort(names)
		for _, name in ipairs(names) do
			seen[name] = true
			local a = session[kind][name].attrs
			table.insert(out, { name = name, Width = a.Width, Height = a.Height, Seconds = a.Seconds, Fps = a.Fps, Bytes = a.Bytes, Audio = a.Audio, Server = true, Imported = true })
		end
		for i, r in ipairs(roots(kind)) do
			for _, name in ipairs(Store.list(r)) do
				if not seen[name] then
					seen[name] = true
					local e = Store.entry(r, name)
					local a = e and e:GetAttributes() or {}
					table.insert(out, { name = name, Width = a.Width, Height = a.Height, Seconds = a.Seconds, Fps = a.Fps, Bytes = a.Bytes, Audio = a.Audio, Server = i > 1 })
				end
			end
		end
		return out
	end

	local h = server.handlers
	h.videos = function()
		return listOf("Videos")
	end
	h.images = function()
		return listOf("Images")
	end
	h.isAdmin = function(player)
		return isAdmin(player)
	end
	h.videoHead = function(_, name)
		if type(name) ~= "string" then
			return nil
		end
		local bytes = readEntry("Videos", name)
		if not bytes then
			return nil
		end
		local headLen = 24
		if buffer.readstring(bytes, 0, 4) == "FLV2" then
			headLen = 24 + buffer.readu16(bytes, 16) * 16
		else
			headLen = math.min(buffer.len(bytes), 20 + buffer.readu16(bytes, 16) * 16)
		end
		local head = buffer.create(headLen)
		buffer.copy(head, 0, bytes, 0, headLen)
		local _, e = find("Videos", name)
		return { size = buffer.len(bytes), head = head, attrs = e and e:GetAttributes() or {} }
	end
	h.videoRange = function(_, name, offset, len)
		if type(name) ~= "string" or type(offset) ~= "number" or type(len) ~= "number" then
			return nil
		end
		local bytes = readEntry("Videos", name)
		if not bytes then
			return nil
		end
		offset = math.floor(offset)
		len = math.clamp(math.floor(len), 0, Net.RANGE)
		if offset < 0 or offset >= buffer.len(bytes) then
			return nil
		end
		len = math.min(len, buffer.len(bytes) - offset)
		local out = buffer.create(len)
		buffer.copy(out, 0, bytes, offset, len)
		return out
	end
	h.clipHead = function(_, path)
		local s = type(path) == "string" and session.Sounds[path]
		return s and { size = buffer.len(s.bytes) } or nil
	end
	h.clipRange = function(_, path, offset, len)
		local s = type(path) == "string" and session.Sounds[path]
		if not s or type(offset) ~= "number" or type(len) ~= "number" then
			return nil
		end
		local bytes = s.bytes
		offset = math.floor(offset)
		len = math.clamp(math.floor(len), 0, Net.RANGE)
		if offset < 0 or offset >= buffer.len(bytes) then
			return nil
		end
		len = math.min(len, buffer.len(bytes) - offset)
		local out = buffer.create(len)
		buffer.copy(out, 0, bytes, offset, len)
		return out
	end
	h.image = function(_, key)
		if type(key) ~= "string" then
			return nil
		end
		if string.sub(key, 1, 4) == "lib:" then
			return readEntry("Images", string.sub(key, 5))
		elseif string.sub(key, 1, 4) == "url:" then
			local u = server.urlImages[key]
			return u and u.bytes
		end
		return nil
	end

	-- YouTube links go through the VideoLab YouTube helper (yt-dlp + ffmpeg in a small program of your own: see
	-- VideoLab's helper folder). It answers 202 while it works, so this asks again until the MP4 is ready.
	local function youtubeId(url)
		local host = string.lower(string.match(url, "^https?://([^/:?#]+)") or "")
		host = string.gsub(string.gsub(string.gsub(host, "^www%.", ""), "^m%.", ""), "^music%.", "")
		local id
		if host == "youtu.be" then
			id = string.match(url, "^https?://[^/]+/([%w_%-]+)")
		elseif host == "youtube.com" or host == "youtube-nocookie.com" then
			id = string.match(url, "[?&]v=([%w_%-]+)") or string.match(url, "/shorts/([%w_%-]+)")
				or string.match(url, "/embed/([%w_%-]+)") or string.match(url, "/live/([%w_%-]+)")
		end
		return id and #id == 11 and id or nil, host == "youtube.com" or host == "youtu.be" or host == "youtube-nocookie.com"
	end
	local function fetchYouTube(id, size, onWait)
		local HttpService = game:GetService("HttpService")
		local base = string.gsub(tostring(Config.YouTubeHelper or "http://localhost:8787"), "/+$", "")
		local q = ("%s/fetch?id=%s&size=%d&seconds=%d&key=%s"):format(base, id, size or 256, Config.ImportMaxSeconds or 120,
			HttpService:UrlEncode(tostring(Config.YouTubeHelperKey or "")))
		local t0 = os.clock()
		while true do
			local ok, r = pcall(HttpService.RequestAsync, HttpService, { Url = q, Method = "GET" })
			if not ok then
				local local_ = string.find(base, "localhost", 1, true) or string.find(base, "127.0.0.1", 1, true)
				return nil, ("the YouTube helper at %s didn't answer: start it (start-windows.bat in the helper folder)%s (%s)"):format(base,
					(local_ and not game:GetService("RunService"):IsStudio()) and "; a live server can't reach localhost, so give YouTubeHelper a public address" or "",
					tostring(r))
			end
			if r.StatusCode == 202 then
				if onWait then
					onWait()
				end
				if os.clock() - t0 > 900 then
					return nil, "the YouTube helper is still working after 15 minutes"
				end
				task.wait(2)
			elseif r.Success then
				return r
			else
				local okJ, j = pcall(HttpService.JSONDecode, HttpService, r.Body)
				return nil, "YouTube: " .. ((okJ and type(j) == "table" and j.error) or ("the helper answered " .. r.StatusCode))
			end
		end
	end

	-- admins: import a picture or a video from a web address, kept in memory while the server runs
	local importing = false
	-- how far the import is: attribute ImportStatus on the FrameLab remotes folder ("" when none runs), which the TV's
	-- panel shows, e.g. "42% - video - 31 s"; the server's output gets each step's time when it ends
	local statusAt = 0
	local function setStatus(text, force)
		if force or os.clock() - statusAt > 0.25 then
			statusAt = os.clock()
			remotes:SetAttribute("ImportStatus", text)
		end
	end
	-- quality: "144p" / "240p" / "360p" (FrameLab.Importer.Qualities) or nil for Config.ImportVideoQuality
	h.importUrl = function(player, kind, url, quality) -- player nil: server code (FrameLab.Server.importUrl)
		if player ~= nil and not isAdmin(player) then
			return { error = "only admins can import" }
		end
		if quality ~= nil and (type(quality) ~= "string" or not FrameLab.Importer.Qualities[quality]) then
			quality = nil
		end
		local q, qName = FrameLab.Importer.quality(quality)
		if kind ~= "image" and kind ~= "video" then
			return { error = "import a picture or a video" }
		end
		if type(url) ~= "string" or #url > 2000 or not string.match(url, "^https?://[%w%.%-]+") then
			return { error = "that isn't a web address (http:// or https://)" }
		end
		if kind == "image" then
			local allowed, why = Config.imageUrlAllowed(url)
			if not allowed then
				return { error = why }
			end
		end
		if importing then
			return { error = "another import is running, try again in a moment" }
		end
		importing = true
		local tStart = os.clock()
		local timing = {}
		setStatus("0% - downloading", true)
		local ok, res = pcall(function()
			local HttpService = game:GetService("HttpService")
			local host = string.match(url, "^https?://([^/:?#]+)") or url
			local ytId, isYouTube = youtubeId(url)
			if isYouTube and not ytId then
				return { error = "that YouTube link has no video in it (use a watch, youtu.be or shorts link)" }
			end
			local okHttp, r
			if ytId then
				-- (the helper shrinks to fit a size x size box: the long side of the quality)
				local res2, err2 = fetchYouTube(ytId, math.ceil(q.lines * 16 / 9), function()
					setStatus(("0%% - the YouTube helper is downloading - %d s"):format(os.clock() - tStart))
				end)
				if not res2 then
					return { error = err2 }
				end
				okHttp, r = true, res2
			else
				okHttp, r = pcall(HttpService.RequestAsync, HttpService, { Url = url, Method = "GET" })
			end
			if not okHttp then
				local raw = tostring(r)
				local low = string.lower(raw)
				local why
				if string.find(low, "not enabled", 1, true) then
					why = "HTTP requests are off for this game: turn on Game Settings > Security > Allow HTTP Requests"
				elseif string.find(low, "roblox", 1, true) and string.find(low, "not allowed", 1, true) then
					why = "Roblox doesn't let games download from its own sites (" .. host .. "): use a picture uploaded somewhere else, or the Decal ID tab"
				elseif string.find(low, "dns", 1, true) or string.find(low, "resolve", 1, true) then
					why = "couldn't find the site " .. host .. " (check the address)"
				elseif string.find(low, "timeout", 1, true) or string.find(low, "timed out", 1, true) then
					why = host .. " took too long to answer"
				elseif string.find(low, "number of requests exceeded", 1, true) then
					why = "too many downloads this minute: try again in a moment"
				elseif string.find(low, "trust", 1, true) or string.find(low, "ssl", 1, true) or string.find(low, "certificate", 1, true) then
					why = host .. "'s secure connection failed (bad certificate)"
				else
					why = "the download failed"
				end
				return { error = ("%s (%s)"):format(why, raw) }
			end
			if not r.Success then
				local code = r.StatusCode
				local hint = ""
				if code == 404 or code == 410 then
					hint = string.find(host, "discord", 1, true)
							and ": Discord links expire after about a day, so copy a fresh one"
						or ": the file isn't there (check the link)"
				elseif code == 403 or code == 401 then
					hint = string.find(host, "discord", 1, true) and ": the Discord link expired or is private, so copy a fresh one"
						or ": the site won't share it (it may need a login, or block downloads from games)"
				elseif code == 429 then
					hint = ": the site is limiting downloads, so try again later"
				elseif code >= 500 then
					hint = ": the site is having trouble, so try again later"
				end
				local msg = tostring(r.StatusMessage or "")
				return { error = ("%s answered %d%s%s"):format(host, code, msg ~= "" and (" " .. msg) or "", hint) }
			end
			if #r.Body == 0 then
				return { error = host .. " sent an empty file" }
			end
			local maxBytes = Config.ImportMaxBytes or 8388608
			if #r.Body > maxBytes then
				return { error = ("that file is %.1f MB; the limit is %.1f MB (ImportMaxBytes)"):format(#r.Body / 1048576, maxBytes / 1048576) }
			end
			local ctype = r.Headers and (r.Headers["content-type"] or r.Headers["Content-Type"]) or nil
			local fileName = string.match(url, "([^/?#]+)[?#]?[^/]*$") or "import"
			fileName = string.gsub(fileName, "%%(%x%x)", function(hex) -- "%28" -> "("
				return string.char(tonumber(hex, 16))
			end)
			if ytId then
				-- named after the video's title (the helper sends it URL-encoded)
				local title = r.Headers and (r.Headers["x-title"] or r.Headers["X-Title"]) or ""
				title = string.gsub(title, "%%(%x%x)", function(hex)
					return string.char(tonumber(hex, 16))
				end)
				title = string.sub(string.gsub(title, "[^%w%-_ ]", ""), 1, 40)
				fileName = (title ~= "" and title or ytId) .. ".mp4"
			end
			timing.download = os.clock() - tStart
			local tImport = os.clock()
			local result
			local okImp, err = pcall(function()
				result = FrameLab.Importer.importFile(fileName, buffer.fromstring(r.Body), {
					Timing = timing,
					-- (the picture takes most of the time: video 0 - 80 %, the sound 80 - 100 %)
					Progress = function(stage, f)
						local pct = stage == "video" and f * 80 or 80 + f * 20
						setStatus(("%d%% - %s - %d s"):format(math.floor(pct), stage, os.clock() - tStart))
					end,
					Folder = "imported", MaxImage = Config.ImportMaxPicture or 320, MaxSeconds = Config.ImportMaxSeconds or 120,
					Quality = qName,
					Log = function() end,
					Taken = function(name)
						return find("Videos", name) ~= nil or find("Images", name) ~= nil
					end,
					Sink = function(k, name, bytes, attrs)
						attrs.Bytes = buffer.len(bytes)
						attrs.Url = url
						attrs.ImportedBy = player and player.UserId or 0
						session[k][name] = { bytes = bytes, attrs = attrs }
					end,
				})
			end)
			timing.import = os.clock() - tImport
			if not okImp then
				local msg = FrameLab.Importer.cleanError(err)
				if ctype and string.find(msg, "FrameLab reads", 1, true) then
					msg ..= (" (the site said it's %s)"):format(ctype)
				end
				return { error = msg }
			end
			if (kind == "image") ~= (result.kind == "image") then
				return { error = ("that's a %s, not a %s"):format(result.kind == "image" and "picture" or "video", kind == "image" and "picture" or "video"), name = result.name, kind = result.kind }
			end
			-- the data manager keeps a record of it (Runtime/Server/Library)
			if server.onImported then
				local okRec, errRec = pcall(server.onImported, result, url, qName, player)
				if not okRec then
					warn("[FrameLab] library record: " .. tostring(errRec))
				end
			end
			return { name = result.name, kind = result.kind, width = result.width, height = result.height, seconds = result.seconds, bytes = result.bytes }
		end)
		importing = false
		setStatus("", true)
		local parts = {}
		for _, k in ipairs({ "download", "video", "sound decode", "sound encode" }) do
			if timing[k] then
				table.insert(parts, ("%s %.1f s"):format(k, timing[k]))
			end
		end
		if Config.Debug then
			print(("[FrameLab] import of %s took %.1f s: %s"):format(url, os.clock() - tStart, table.concat(parts, ", ")))
		end
		if not ok then
			return { error = tostring(res) }
		end
		return res
	end

	-- a few requests a second per player is plenty for playback (a 60 KB range is ~2 s of video)
	local budget = {}
	remotes.Media.OnServerInvoke = function(player, action, ...)
		local b = budget[player]
		local now = os.clock()
		if not b or now - b.t > 1 then
			b = { t = now, n = 0 }
			budget[player] = b
		end
		b.n += 1
		if b.n > (Config.RequestsPerSecond or 30) then
			return nil
		end
		local fn = type(action) == "string" and h[action]
		if not fn then
			return nil
		end
		local ok, res = pcall(fn, player, ...)
		if not ok then
			warn("[FrameLab] " .. tostring(action) .. " failed: " .. tostring(res))
			return nil
		end
		return res
	end
	Players.PlayerRemoving:Connect(function(p)
		budget[p] = nil
	end)

	-- server code (VideoLab.importUrl): the same import, without the admin check
	server.importUrl = function(kind, url, quality)
		return h.importUrl(nil, kind, url, quality)
	end
	server.listOf = listOf

	FrameLab.Server = server
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">FrameLabServer</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab:init() on the server, the same way AudioLabServer works for sound. The
-- server never decodes video: it keeps the playback STATE of synced screens (attributes, see FrameLab.Sync) and every
-- client plays that state itself on the server's playhead.
--
-- 1. Auto-start: an instance tagged "FrameLab" with FrameLabSynced = true and FrameLabAutoPlay = true (set in Studio with
--    FrameLabVideo, FrameLabLoop, FrameLabStartTime, FrameLabSpeed...) starts when the server starts, or when it is
--    added later. Players who join afterwards start in the right place.
-- 2. Client control: ReplicatedStorage.FrameLabSyncRemotes.SyncControl lets a client play / pause / resume / seek / ...
--    a screen it owns (FrameLabOwner = its UserId, e.g. its TV) or one with FrameLabClientControl = true
--    (FrameLab.Sync.request on the client). Requests are validated and rate-limited, and
--    `Sync.authorize(player, target, action, arg)` (set by any server script) can veto them.
-- Other server scripts drive video directly: require(ReplicatedStorage.LabHub.FrameLab.Sync).play(part, { Video = ... }).
return function(FrameLab)
	local CollectionService = game:GetService("CollectionService")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local Players = game:GetService("Players")
	local root = script:FindFirstAncestor("FrameLab")
	local Sync = require(root.Sync)
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))

	-- 1. auto-start
	local function autoStart(instance)
		if instance:GetAttribute("FrameLabSynced") ~= true or instance:GetAttribute("FrameLabAutoPlay") ~= true then
			return
		end
		if Sync.state(instance) ~= nil then
			return
		end
		Sync.play(instance, {
			StartTime = instance:GetAttribute("FrameLabStartTime") or 0,
			Speed = instance:GetAttribute("FrameLabSpeed") or 1,
			Delay = 0,
		})
	end
	CollectionService:GetInstanceAddedSignal(Sync.Tag):Connect(autoStart)
	for _, instance in ipairs(CollectionService:GetTagged(Sync.Tag)) do
		task.spawn(autoStart, instance)
	end

	-- 2. client requests
	local remotes = ReplicatedStorage:FindFirstChild("FrameLabSyncRemotes")
	if not remotes then
		remotes = Instance.new("Folder")
		remotes.Name = "FrameLabSyncRemotes"
		remotes.Parent = ReplicatedStorage
	end
	local control = remotes:FindFirstChild("SyncControl")
	if not control then
		control = Instance.new("RemoteEvent")
		control.Name = "SyncControl"
		control.Parent = remotes
	end

	local recent = {}
	local function allowed(player, limit)
		local now = os.clock()
		local r = recent[player]
		if not r or now - r[1] >= 1 then
			r = { now, 0 }
			recent[player] = r
		end
		r[2] += 1
		return r[2] <= limit
	end
	Players.PlayerRemoving:Connect(function(player)
		recent[player] = nil
	end)

	local function sanitizePlay(arg)
		if type(arg) ~= "table" then
			return nil
		end
		local v = arg.Video
		if type(v) ~= "string" or #v == 0 or #v > 200 or string.find(v, "..", 1, true) or not Sync.videoEntry(v) then
			return nil
		end
		local o = { Video = v }
		if type(arg.Loop) == "boolean" then
			o.Loop = arg.Loop
		end
		if type(arg.Sound) == "boolean" then
			o.Sound = arg.Sound
		end
		local function num(key, lo, hi)
			local n = arg[key]
			if type(n) == "number" and n == n then
				return math.clamp(n, lo, hi)
			end
			return nil
		end
		o.Speed, o.StartTime = num("Speed", 0.25, 4), num("StartTime", 0, 36000)
		return o
	end

	local ACTIONS = {
		pause = function(inst) Sync.pause(inst) end,
		resume = function(inst) Sync.resume(inst) end,
		toggle = function(inst)
			local st = Sync.state(inst)
			if st and st.state == "playing" then
				Sync.pause(inst)
			else
				Sync.resume(inst)
			end
		end,
		stop = function(inst) Sync.stop(inst) end,
		restart = function(inst)
			Sync.seek(inst, 0)
			local st = Sync.state(inst)
			if st and st.state ~= "playing" then
				Sync.resume(inst)
			end
		end,
		seek = function(inst, n) Sync.seek(inst, math.max(n, 0)) end,
		setSpeed = function(inst, n) Sync.setSpeed(inst, math.clamp(n, 0.25, 4)) end,
	}
	local NEEDS_NUMBER = { seek = true, setSpeed = true }

	control.OnServerEvent:Connect(function(player, target, action, arg)
		if type(action) ~= "string" or not allowed(player, Config.ControlPerSecond or 8) then
			return
		end
		if typeof(target) ~= "Instance" or not target:IsDescendantOf(workspace) then
			return
		end
		local owner = target:GetAttribute("FrameLabOwner")
		local mayControl = (owner ~= nil and owner == player.UserId) or target:GetAttribute("FrameLabClientControl") == true
		if not mayControl then
			return
		end
		if Sync.authorize then
			local ok, verdict = pcall(Sync.authorize, player, target, action, arg)
			if not ok or verdict == false then
				return
			end
		end
		if action == "play" then
			local opts = sanitizePlay(arg)
			if opts then
				Sync.play(target, opts)
			end
			return
		end
		local handler = ACTIONS[action]
		if not handler then
			return
		end
		if NEEDS_NUMBER[action] and (type(arg) ~= "number" or arg ~= arg or math.abs(arg) == math.huge) then
			return
		end
		handler(target, arg)
	end)
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">TV</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab.init() on the server: placed TVs. Clicking with the TV tool drops the TV (it leaves the hand,
-- lands in front of the player and grows) and makes it that player's synced FrameLab screen (FrameLab.Sync, owner =
-- the player): its owner picks what it plays through FrameLabServer, everyone sees it through FrameLabClient. Picking
-- it up gives the tool back.
return function(FrameLab)
	local Players = game:GetService("Players")
	local root = script:FindFirstAncestor("FrameLab")
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))
	local Sync = require(root.Sync)
	-- the TV that gets set down: built once from LabHub.Blueprints.tv (Instancer), then cloned
	local template
	local function tvTemplate()
		if not template then
			local hub = root.Parent
			template = require(hub.Instancer).build(require(hub.Blueprints).tv)
		end
		return template
	end
	task.spawn(tvTemplate)
	while not FrameLab.Server do
		task.wait()
	end
	local server = FrameLab.Server
	local remote = server.remotes.TV

	local folder = workspace:FindFirstChild("FrameLabTVs")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "FrameLabTVs"
		folder.Parent = workspace
	end

	local function tvsOf(player)
		local list = {}
		for _, tv in ipairs(folder:GetChildren()) do
			if tv:GetAttribute("FrameLabOwner") == player.UserId then
				table.insert(list, tv)
			end
		end
		return list
	end

	-- the TV tool goes here while its TV stands in the world (picking the TV up gives it back)
	local ServerStorage = game:GetService("ServerStorage")
	local RunService = game:GetService("RunService")
	local TweenService = game:GetService("TweenService")
	local held = ServerStorage:FindFirstChild("FrameLabHeldTools")
	if not held then
		held = Instance.new("Folder")
		held.Name = "FrameLabHeldTools"
		held.Parent = ServerStorage
	end
	local function heldToolOf(player)
		for _, t in ipairs(held:GetChildren()) do
			if t:GetAttribute("HeldBy") == player.UserId then
				return t
			end
		end
	end

	-- the screen takes the shape of what it plays (a 9:16 short gets a tall screen, 21:9 a wide one), as big as fits
	-- inside the TV's own screen, centred; the black backing fills the rest (letterbox / pillarbox bars)
	local function reshape(tv)
		local screen = tv:FindFirstChild("Screen")
		local baseSize = screen and screen:GetAttribute("BaseSize")
		local baseOffset = screen and screen:GetAttribute("BaseOffset")
		if typeof(baseSize) ~= "Vector3" or typeof(baseOffset) ~= "CFrame" then
			return
		end
		local w, h = baseSize.X, baseSize.Y
		local name = tv:GetAttribute("FrameLabVideo")
		local entry = tv:GetAttribute("FrameLabState") ~= "stopped" and name and Sync.videoEntry(name)
		local vw = entry and entry:GetAttribute("Width")
		local vh = entry and entry:GetAttribute("Height")
		if vw and vh and vw > 0 and vh > 0 then
			local aspect = vw / vh
			if aspect >= w / h then
				h = w / aspect
			else
				w = h * aspect
			end
		end
		local key = ("%.3f,%.3f"):format(w, h)
		if screen:GetAttribute("ShapeKey") == key then
			return
		end
		screen:SetAttribute("ShapeKey", key)
		local goal = tv:GetPivot() * baseOffset
		TweenService:Create(screen, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Size = Vector3.new(w, h, baseSize.Z), CFrame = goal }):Play()
	end

	-- like the classic gear that drops itself: the TV leaves the hand where it is, lands in front of the player
	-- facing them, and grows to full size
	local function drop(player)
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local tool = char and char:FindFirstChildOfClass("Tool")
		if not hrp or not hum or hum.Health <= 0 or not tool or not tool:GetAttribute("FrameLabTV") then
			return
		end
		local handle = tool:FindFirstChild("Handle")
		local from = handle and handle.CFrame or hrp.CFrame
		-- the spot: ahead of the player (further for a bigger TV), on whatever is below it
		local scale = Config.TVScale or 3
		local size = tvTemplate().Body.Size * scale
		local ahead = hrp.Position + (hrp.CFrame.LookVector * Vector3.new(1, 0, 1)).Unit * (size.Z / 2 + 2.5 + size.Y / 2) -- far enough back to see the screen
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { char, folder }
		local hit = workspace:Raycast(ahead + Vector3.new(0, 4, 0), Vector3.new(0, -40, 0), params)
		local ground = hit and hit.Position or (ahead - Vector3.new(0, hum.HipHeight + hrp.Size.Y / 2, 0))
		local face = (hrp.Position - ground) * Vector3.new(1, 0, 1)
		if face.Magnitude < 0.1 then
			face = -hrp.CFrame.LookVector
		end
		local to = CFrame.lookAt(ground, ground + face.Unit)
		for _, old in ipairs(tvsOf(player)) do
			Sync.stop(old) -- picture and sound
			old:Destroy()
		end
		tool:SetAttribute("HeldBy", player.UserId)
		tool.Parent = held
		local tv = tvTemplate():Clone()
		Sync.setOwner(tv, player) -- the owner controls it through FrameLab.Sync (FrameLabServer checks)
		tv:SetAttribute("OwnerName", player.DisplayName)
		-- its sound is heard at full volume out to the TV's own size (then fades: AudioLab's Range), not Roblox's
		-- default falloff, which made a big TV quiet from where you watch it
		tv:SetAttribute("AudioLabRange", math.max(size.X, size.Y))
		tv.Name = player.Name .. "_TV"
		-- the TV's pivot is its bottom centre; start where the handle was
		tv:PivotTo(from)
		tv.Parent = folder
		local body = tv:FindFirstChild("Body")
		local puff = body and body:FindFirstChild("Puff")
		local t, T = 0, 0.6
		local conn
		conn = RunService.Heartbeat:Connect(function(dt)
			if not tv.Parent then
				conn:Disconnect()
				return
			end
			t = math.min(T, t + dt)
			local a = t / T
			local e = 1 - (1 - a) * (1 - a) -- ease out
			tv:ScaleTo(1 + (scale - 1) * e)
			tv:PivotTo(from:Lerp(to, e))
			if t >= T then
				conn:Disconnect()
				-- ScaleTo scales the prompt's reach too: set it once the TV is full size, reachable from where you stand
				local prompt = body and body:FindFirstChild("Change")
				if prompt then
					prompt.MaxActivationDistance = math.max(12, size.Z / 2 + size.Y / 2 + 10)
				end
				local screen = tv:FindFirstChild("Screen")
				if screen then
					screen:SetAttribute("BaseSize", screen.Size)
					screen:SetAttribute("BaseOffset", tv:GetPivot():ToObjectSpace(screen.CFrame))
					tv:GetAttributeChangedSignal("FrameLabSeq"):Connect(function()
						reshape(tv)
					end)
					reshape(tv)
				end
				if puff then
					puff:Emit(25)
				end
			end
		end)
	end

	local last = {}
	remote.OnServerEvent:Connect(function(player, action, a)
		local now = os.clock()
		if last[player] and now - last[player] < 0.3 then
			return
		end
		last[player] = now
		if action == "drop" then
			drop(player)
		elseif action == "remove" then
			-- pick the TV up: the tool comes back (unless they got a new one when they respawned)
			if typeof(a) ~= "Instance" or a.Parent ~= folder or a:GetAttribute("FrameLabOwner") ~= player.UserId then
				return
			end
			Sync.stop(a) -- picture and sound
			a:Destroy()
			local tool = heldToolOf(player)
			if tool then
				local backpack = player:FindFirstChildOfClass("Backpack")
				local has = false
				for _, place in ipairs({ backpack, player.Character }) do
					for _, t in ipairs(place and place:GetChildren() or {}) do
						if t:IsA("Tool") and t:GetAttribute("FrameLabTV") then
							has = true
						end
					end
				end
				if has or not backpack then
					tool:Destroy()
				else
					tool:SetAttribute("HeldBy", nil)
					tool.Parent = backpack
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		last[player] = nil
		for _, tv in ipairs(tvsOf(player)) do
			Sync.stop(tv)
			tv:Destroy()
		end
		local tool = heldToolOf(player)
		if tool then
			tool:Destroy()
		end
	end)
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">Spray</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab:init() on the server: Spray Paint. A spray is a thin invisible part on the surface that was
-- sprayed (welded to it when it moves), holding what to show:
--   Kind "decal": a Roblox decal / image id, shown with a normal Decal (Roblox-moderated, like the original gear)
--   Kind "image": a FrameLab library picture ("lib:<name>"), drawn by each client with strips (Runtime/Client/Spray)
--   Kind "url":   a picture an admin loaded from a web address ("url:<n>"), drawn the same way
-- Loading from a URL is for admins only (the FrameLab folder's Admins attribute, and the place owner): those pictures skip Roblox's
-- moderation, so whoever loads them is responsible for them.
return function(FrameLab)
	local Players = game:GetService("Players")
	local HttpService = game:GetService("HttpService")
	local MarketplaceService = game:GetService("MarketplaceService")
	local InsertService = game:GetService("InsertService")
	local root = script:FindFirstAncestor("FrameLab")
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))
	while not FrameLab.Server do
		task.wait()
	end
	local server = FrameLab.Server
	local remote = server.remotes.Spray

	local folder = workspace:FindFirstChild("FrameLabSprays")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "FrameLabSprays"
		folder.Parent = workspace
	end

	-- decal id -> image texture ("rbxassetid://<image id>"); a decal's own id doesn't work as a texture at runtime
	local textures = {}
	local function textureOf(id)
		if textures[id] ~= nil then
			return textures[id]
		end
		local result = false
		local ok, info = pcall(MarketplaceService.GetProductInfoAsync, MarketplaceService, id, Enum.InfoType.Asset)
		if ok and info then
			if info.AssetTypeId == 1 then -- already an image
				result = "rbxassetid://" .. id
			elseif info.AssetTypeId == 13 then -- a decal: its image
				local ok2, model = pcall(InsertService.LoadAsset, InsertService, id)
				if ok2 and model then
					local d = model:FindFirstChildWhichIsA("Decal", true)
					if d then
						result = d.Texture
					end
					model:Destroy()
				end
				if not result then
					-- the image is usually uploaded just before the decal, by the same creator
					for k = 1, 8 do
						local ok3, i2 = pcall(MarketplaceService.GetProductInfoAsync, MarketplaceService, id - k, Enum.InfoType.Asset)
						if ok3 and i2 and i2.AssetTypeId == 1 and i2.Creator and info.Creator and i2.Creator.Id == info.Creator.Id then
							result = "rbxassetid://" .. (id - k)
							break
						end
					end
				end
			end
		end
		textures[id] = result
		return result
	end

	-- admins: load a picture from a web address
	local urlCount = 0
	local byUrl = {}
	server.handlers.loadUrl = function(player, url)
		if not server.isAdmin(player) then
			return { error = "only admins can load pictures from a URL" }
		end
		if type(url) ~= "string" or #url > 2000 or not string.match(url, "^https?://[%w%.%-]+") then
			return { error = "that isn't a web address (http:// or https://)" }
		end
		local allowed, why = Config.imageUrlAllowed(url)
		if not allowed then
			return { error = why }
		end
		if byUrl[url] then
			local u = server.urlImages[byUrl[url]]
			return { key = byUrl[url], width = u.width, height = u.height }
		end
		local ok, res = pcall(HttpService.RequestAsync, HttpService, { Url = url, Method = "GET" })
		if not ok then
			return { error = "couldn't fetch it: " .. tostring(res) }
		end
		if not res.Success then
			return { error = ("the site answered %d %s"):format(res.StatusCode, tostring(res.StatusMessage)) }
		end
		local body = res.Body
		if #body > (Config.UrlMaxBytes or 4194304) then
			return { error = "that file is too big" }
		end
		local size = Config.UrlPictureSize or 160
		local ok2, image = pcall(FrameLab.decodeImage, buffer.fromstring(body), url, { MaxSize = size, Yield = true })
		if not ok2 then
			return { error = "not a picture FrameLab reads (PNG, JPG, BMP, TGA, GIF)" }
		end
		image = FrameLab.Resize.fit(image, size, size, true)
		local packed = FrameLab.Importer.packImage(image)
		urlCount += 1
		local key = "url:" .. urlCount
		server.urlImages[key] = { bytes = packed, width = image.width, height = image.height, url = url, by = player.UserId }
		byUrl[url] = key
		return { key = key, width = image.width, height = image.height }
	end

	local mine = {} -- player -> { spray parts, oldest first }
	local last = {}

	local function addSpray(player, part)
		local list = mine[player] or {}
		mine[player] = list
		table.insert(list, part)
		while #list > (Config.SprayMaxPerPlayer or 10) do
			local old = table.remove(list, 1)
			old:Destroy()
		end
		local life = Config.SprayLifetime or 300
		if life > 0 then
			task.delay(life, function()
				if part.Parent then
					part:Destroy()
				end
				local l = mine[player]
				if l then
					local i = table.find(l, part)
					if i then
						table.remove(l, i)
					end
				end
			end)
		end
	end

	remote.OnServerEvent:Connect(function(player, choice, size, pos, normal, target)
		local now = os.clock()
		if last[player] and now - last[player] < (Config.SprayCooldown or 1.5) then
			return
		end
		if type(choice) ~= "table" or type(size) ~= "number" or typeof(pos) ~= "Vector3" or typeof(normal) ~= "Vector3" then
			return
		end
		if typeof(target) ~= "Instance" or not target:IsA("BasePart") or not target:IsDescendantOf(workspace) then
			return
		end
		if target:IsDescendantOf(folder) or (workspace:FindFirstChild("FrameLabTVs") and target:IsDescendantOf(workspace.FrameLabTVs)) then
			return
		end
		local model = target:FindFirstAncestorOfClass("Model")
		if model and model:FindFirstChildOfClass("Humanoid") then
			return -- not on players or NPCs
		end
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 or (hrp.Position - pos).Magnitude > (Config.SprayRange or 14) + 4 then
			return
		end
		if normal.Magnitude < 0.5 then
			return
		end
		normal = normal.Unit
		local original = size == 0 -- "O": sized from the picture's own pixels, drawn at full resolution
		size = math.clamp(size, 2, 10)

		-- what to show
		local kind, key, aspect = nil, nil, 1
		if choice.Kind == "decal" then
			local id = tonumber(choice.Value)
			if not id or id <= 0 or id ~= math.floor(id) then
				return
			end
			local tex = textureOf(id)
			if not tex then
				return
			end
			kind, key = "decal", tex
		elseif choice.Kind == "image" and type(choice.Value) == "string" then
			local r, entry = server.find("Images", choice.Value)
			if not r then
				return
			end
			kind, key = "image", "lib:" .. choice.Value
			aspect = (entry:GetAttribute("Height") or 1) / math.max(1, entry:GetAttribute("Width") or 1)
		elseif choice.Kind == "url" and type(choice.Value) == "string" then
			local u = server.urlImages[choice.Value]
			if not u or not server.isAdmin(player) then
				return
			end
			kind, key = "url", choice.Value
			aspect = u.height / math.max(1, u.width)
		else
			return
		end
		last[player] = now

		if original then
			local pw, ph
			if kind == "image" then
				local _, entry = server.find("Images", string.sub(key, 5))
				pw, ph = entry and entry:GetAttribute("Width"), entry and entry:GetAttribute("Height")
			elseif kind == "url" then
				local u = server.urlImages[key]
				pw, ph = u and u.width, u and u.height
			end
			local longest = math.max(pw or 0, ph or 0)
			-- (up to ~21 studs: a 512-pixel picture at 24 pixels a stud)
			size = longest > 0 and math.clamp(longest / (Config.SprayOriginalPixelsPerStud or 24), 3, 22) or 10
		end
		local w, h = size, size
		if aspect > 1 then
			w = size / aspect
		else
			h = size * aspect
		end
		-- facing out of the surface; "up" follows the world, or the player's view on floors and ceilings
		local up = Vector3.yAxis
		if math.abs(normal.Y) > 0.9 then
			up = (hrp.CFrame.LookVector * Vector3.new(1, 0, 1))
			if up.Magnitude < 0.1 then
				up = Vector3.zAxis
			end
			up = up.Unit
			if normal.Y < 0 then
				up = -up
			end
		end
		local p = Instance.new("Part")
		p.Name = "Spray"
		p.Size = Vector3.new(w, h, 0.05)
		p.CFrame = CFrame.lookAt(pos + normal * 0.03, pos + normal * 2, up)
		p.Transparency = 1
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Massless = true
		p:SetAttribute("Kind", kind)
		p:SetAttribute("Key", key)
		p:SetAttribute("Owner", player.UserId)
		if original then
			p:SetAttribute("Original", true)
		end
		if kind == "decal" then
			local d = Instance.new("Decal")
			d.Face = Enum.NormalId.Front
			d.Texture = key
			d.Parent = p
		end
		if target.Anchored then
			p.Anchored = true
		else
			p.Anchored = false
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = target
			weld.Part1 = p
			weld.Parent = p
		end
		p.Parent = folder
		addSpray(player, p)
		local tool = char:FindFirstChildOfClass("Tool")
		local sound = tool and tool:FindFirstChild("Handle") and tool.Handle:FindFirstChildOfClass("Sound")
		if sound then
			sound:Play()
			task.delay(1.2, function()
				sound:Stop()
			end)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		last[player] = nil
		for _, p in ipairs(mine[player] or {}) do
			p:Destroy()
		end
		mine[player] = nil
	end)
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Library</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab:init() on the server: the data manager's server side (admins only).
-- In-game imports live in the server's memory (Runtime/Server/Media) and are gone when it closes. The library keeps a
-- small record of each in a DataStore instead of the data itself: where it came from (the URL), its kind, quality,
-- size, length, who imported it, and a thumbnail that fits 64 x 64. A record whose data isn't in memory can be
-- imported again from its URL with one click (Load).
--
-- Requests (FrameLab.Net, remotes.Media): libList, libThumb(id), libDelete(id), libLoad(id), libStats,
-- libSetStore(on)
-- The DataStore is OFF by default (Config.LibraryDataStore = false): records live only in this server's memory. An
-- admin turns it on in the data manager (the "DataStore" switch, for this server) or sets the attribute to true.
-- Config.LibraryStore: the DataStore's name
return function(FrameLab)
	local Players = game:GetService("Players")
	local HttpService = game:GetService("HttpService")
	local EncodingService = game:GetService("EncodingService")
	local root = script:FindFirstAncestor("FrameLab")
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))
	local Stream = require(root.Video.Stream)

	-- the media runtime makes FrameLab.Server
	local t0 = os.clock()
	while not FrameLab.Server and os.clock() - t0 < 30 do
		task.wait(0.1)
	end
	local server = FrameLab.Server
	if not server then
		warn("[FrameLab] library: the media runtime didn't start")
		return
	end
	local h, session, isAdmin = server.handlers, server.session, server.isAdmin

	-- the DataStores, or nil: switched off (the default), or not available (no API access). Records are kept one
	-- per key (store: "rec/<id>", "thumb/<id>"), and an OrderedDataStore holds id -> import time, which lists them
	-- newest first a page at a time (no single key that grows with every import)
	local store, ordered, storeError
	local function openStore()
		store, ordered, storeError = nil, nil, nil
		local name = Config.LibraryStore
		if type(name) ~= "string" or name == "" then
			name = "FrameLabLibrary_v1"
		end
		local ok, err = pcall(function()
			local DSS = game:GetService("DataStoreService")
			store = DSS:GetDataStore(name)
			ordered = DSS:GetOrderedDataStore(name .. "_order")
		end)
		if not ok then
			store, ordered, storeError = nil, nil, tostring(err)
		end
	end
	if Config.LibraryDataStore == true then
		openStore()
	end

	-- records: id -> { id, kind, name, url, quality, seconds, width, height, bytes, by, byName, at, tw, th }
	local records = {}
	local loadedIndex = false
	-- the newest Config.LibraryListSize (50) records, read once per server (each record is one GetAsync)
	local reading = false
	local function readIndex()
		if loadedIndex or not store or reading then
			return
		end
		reading = true
		local ok, err = pcall(function()
			local want = Config.LibraryListSize or 50
			local pages = ordered:GetSortedAsync(false, math.min(want, 100))
			local ids = {}
			while true do
				for _, e in ipairs(pages:GetCurrentPage()) do
					table.insert(ids, e.key)
				end
				if #ids >= want or pages.IsFinished then
					break
				end
				pages:AdvanceToNextPageAsync()
			end
			for i = 1, math.min(#ids, want) do
				local id = ids[i]
				if not records[id] then
					local r = store:GetAsync("rec/" .. id)
					if type(r) == "table" and type(r.url) == "string" then
						records[id] = r
					end
				end
			end
		end)
		reading = false
		if ok then
			loadedIndex = true
		else
			storeError = tostring(err)
		end
	end
	-- keep one record (and its place in the order)
	local function writeIndex(id)
		local r = records[id]
		if not store or not r then
			return
		end
		local ok, err = pcall(function()
			store:SetAsync("rec/" .. id, r)
			ordered:SetAsync(id, math.floor(r.at or os.time()))
		end)
		if not ok then
			storeError = tostring(err)
			warn("[FrameLab] library: couldn't save a record: " .. tostring(err))
		end
	end
	local function deleteRecord(id)
		records[id] = nil
		if store then
			pcall(function()
				ordered:RemoveAsync(id)
				store:RemoveAsync("rec/" .. id)
				store:RemoveAsync("thumb/" .. id)
			end)
		end
	end
	task.spawn(readIndex) -- (nothing while the DataStore is off)

	-- a thumbnail: the picture fitted into 64 x 64, RGB, zstd, base64 (a few KB)
	local function thumbOf(image)
		local small = FrameLab.Resize.fit(image, 64)
		local w, hgt = small.width, small.height
		local rgb = buffer.create(w * hgt * 3)
		for i = 0, w * hgt - 1 do
			buffer.writeu8(rgb, i * 3, buffer.readu8(small.data, i * 4))
			buffer.writeu8(rgb, i * 3 + 1, buffer.readu8(small.data, i * 4 + 1))
			buffer.writeu8(rgb, i * 3 + 2, buffer.readu8(small.data, i * 4 + 2))
		end
		local z = EncodingService:CompressBuffer(rgb, Enum.CompressionAlgorithm.Zstd, 9)
		return buffer.tostring(EncodingService:Base64Encode(z)), w, hgt
	end

	-- a picture of an imported video: the frame a tenth of the way in
	local function videoFrame(bytes)
		local reader = Stream.reader(bytes, { Decompress = function(b)
			return EncodingService:DecompressBuffer(b, Enum.CompressionAlgorithm.Zstd)
		end })
		local target = math.floor(reader.frameCount * 0.1)
		if target > 0 then
			reader:seek(target)
		else
			reader:advance()
		end
		if reader.render then
			reader.render()
		end
		local W, H, pw = reader.width, reader.height, reader.pw
		local data = buffer.create(W * H * 4)
		for y = 0, H - 1 do
			buffer.copy(data, y * W * 4, reader.rgba, y * pw * 4, W * 4)
		end
		return { width = W, height = H, data = data }
	end

	local thumbs = {} -- id -> { data, w, h } (this server's copy)

	-- AudioLab imports (sounds: a clip under AudioLab's Data/Clips; music: a MIDI (and SoundFont) under Data/Files)
	local function audioImporter()
		local AL = game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):FindFirstChild("AudioLab")
		return AL and AL:FindFirstChild("Tools") and AL.Tools:FindFirstChild("Importer") and require(AL.Tools.Importer)
	end
	local function isAudio(r)
		return r.kind == "sound" or r.kind == "music"
	end
	local function audioLoaded(r)
		local ok, yes = pcall(function()
			local I = audioImporter()
			if not I then
				return false
			end
			if r.kind == "sound" then
				return I.hasClip(r.path)
			end
			return I.has(r.path .. "/" .. r.name .. ".mid")
		end)
		return ok and yes == true
	end
	-- remove an AudioLab import's stored data (the node at path under root)
	local function dropPath(rootInst, path)
		local node = rootInst
		for seg in string.gmatch(path, "[^/]+") do
			node = node and node:FindFirstChild(seg)
		end
		if node and node ~= rootInst then
			node:Destroy()
		end
	end

	-- the session entry of a record (or nil: not in memory)
	local function loadedName(r)
		if isAudio(r) then
			return audioLoaded(r) and r.name or nil
		end
		local kind = r.kind == "image" and "Images" or "Videos"
		if r.name and session[kind][r.name] and session[kind][r.name].attrs.Url == r.url then
			return r.name
		end
		for name, e in pairs(session[kind]) do
			if e.attrs.Url == r.url and (e.attrs.Quality == r.quality or r.kind == "image") then
				return name
			end
		end
		return nil
	end

	-- after each import (Media calls it): a record for it, with its thumbnail
	server.onImported = function(result, url, quality, player)
		local kind = result.kind == "image" and "image" or "video"
		local e = session[kind == "image" and "Images" or "Videos"][result.name]
		if not e then
			return
		end
		readIndex()
		local id
		for rid, r in pairs(records) do
			if r.url == url and r.kind == kind and (kind == "image" or r.quality == quality) then
				id = rid
			end
		end
		id = id or HttpService:GenerateGUID(false)
		local r = {
			id = id, kind = kind, name = result.name, url = url, quality = kind == "video" and quality or nil,
			seconds = result.seconds, width = result.width, height = result.height, bytes = result.bytes,
			by = player and player.UserId or 0, byName = player and player.Name or "server", at = os.time(),
		}
		local ok, err = pcall(function()
			local img = kind == "image" and FrameLab.unpackImage(e.bytes) or videoFrame(e.bytes)
			local data, w, hgt = thumbOf(img)
			thumbs[id] = { data = data, w = w, h = hgt }
			r.tw, r.th = w, hgt
			if store then
				store:SetAsync("thumb/" .. id, data)
			end
		end)
		if not ok and Config.Debug then
			warn("[FrameLab] library: no thumbnail for " .. tostring(result.name) .. ": " .. tostring(err))
		end
		records[id] = r
		writeIndex(id)
	end

	-- after each AudioLab import (AudioLab's import server calls it): a record, no thumbnail
	server.onAudioImported = function(info)
		readIndex()
		local id
		for rid, r in pairs(records) do
			if r.kind == info.kind and r.path == info.path then
				id = rid
			end
		end
		id = id or HttpService:GenerateGUID(false)
		records[id] = {
			id = id, kind = info.kind, name = info.name, path = info.path, url = info.url, soundFontUrl = info.soundFontUrl,
			seconds = info.seconds, bytes = info.bytes, detail = info.detail,
			by = info.player and info.player.UserId or 0, byName = info.player and info.player.Name or "server", at = os.time(),
		}
		writeIndex(id)
	end

	local function sizeOf(e)
		return typeof(e.bytes) == "buffer" and buffer.len(e.bytes) or 0
	end

	-- the DataStore switch (this server; the default comes from Config.LibraryDataStore)
	h.libSetStore = function(player, on)
		if not isAdmin(player) then
			return nil
		end
		if on == true then
			if not store then
				openStore()
				if store then
					-- this server's records join the kept ones
					local mine = records
					records = {}
					loadedIndex = false
					readIndex()
					for id, r in pairs(mine) do
						records[id] = r
						local t = thumbs[id]
						if t then
							pcall(store.SetAsync, store, "thumb/" .. id, t.data)
						end
						writeIndex(id)
					end
				end
			end
		else
			store, storeError = nil, nil
			-- (kept records that aren't in memory leave the list; this server's own stay)
			for id, r in pairs(records) do
				if not loadedName(r) then
					records[id] = nil
				end
			end
			loadedIndex = false
		end
		return { on = store ~= nil, storeError = storeError }
	end

	h.libStats = function(player)
		if not isAdmin(player) then
			return nil
		end
		local n, total = 0, 0
		for _, kind in ipairs({ "Videos", "Images", "Sounds" }) do
			for _, e in pairs(session[kind]) do
				n += 1
				total += sizeOf(e)
			end
		end
		return { entries = n, bytes = total, records = store ~= nil, storeError = storeError }
	end

	-- everything: this server's imports (loaded) and the kept records (loaded or not)
	h.libList = function(player)
		if not isAdmin(player) then
			return nil
		end
		readIndex()
		local out, seen = {}, {}
		for id, r in pairs(records) do
			local name = loadedName(r)
			local e = name and session[r.kind == "image" and "Images" or "Videos"][name]
			local soundBytes = 0
			if e and e.attrs.Audio then
				local s = session.Sounds[string.sub(e.attrs.Audio, 6)]
				soundBytes = s and sizeOf(s) or 0
			end
			if name then
				seen[name] = true
			end
			table.insert(out, {
				id = id, kind = r.kind, name = name or r.name, url = r.url, quality = r.quality, seconds = r.seconds,
				width = r.width, height = r.height, by = r.byName, at = r.at, loaded = name ~= nil,
				bytes = e and (sizeOf(e) + soundBytes) or r.bytes, kept = store ~= nil, thumb = r.tw ~= nil, detail = r.detail,
				soundFontUrl = r.soundFontUrl,
			})
		end
		for kind, k in pairs({ Videos = "video", Images = "image" }) do
			for name, e in pairs(session[kind]) do
				if not seen[name] then
					local a = e.attrs
					table.insert(out, {
						id = "session:" .. kind .. ":" .. name, kind = k, name = name, url = a.Url, quality = a.Quality,
						seconds = a.Seconds, width = a.Width, height = a.Height, loaded = true, bytes = sizeOf(e), kept = false,
					})
				end
			end
		end
		table.sort(out, function(a, b)
			return (a.at or math.huge) > (b.at or math.huge)
		end)
		return out
	end

	h.libThumb = function(player, id)
		if not isAdmin(player) or type(id) ~= "string" then
			return nil
		end
		local t = thumbs[id]
		if not t and store and records[id] then
			local ok, v = pcall(store.GetAsync, store, "thumb/" .. id)
			if ok and type(v) == "string" then
				t = { data = v, w = records[id].tw, h = records[id].th }
				thumbs[id] = t
			end
		end
		if not t then
			return nil
		end
		local ok, rgb = pcall(function()
			return EncodingService:DecompressBuffer(EncodingService:Base64Decode(buffer.fromstring(t.data)), Enum.CompressionAlgorithm.Zstd)
		end)
		return ok and { w = t.w, h = t.h, rgb = rgb } or nil
	end

	-- remove: from this server's memory (picture / video and its sound) and from the records
	h.libDelete = function(player, id)
		if not isAdmin(player) or type(id) ~= "string" then
			return { error = "only admins" }
		end
		local kind, name
		local sk, sn = string.match(id, "^session:(%a+):(.+)$")
		if sk then
			kind, name = sk, sn
		else
			readIndex()
			local r = records[id]
			if r and isAudio(r) then
				-- an AudioLab import: its stored clip / MIDI and SoundFont go too
				pcall(function()
					local I = audioImporter()
					if I then
						if r.kind == "sound" then
							dropPath(I.clipsRoot(), r.path)
						else
							dropPath(I.filesRoot(), r.path)
						end
					end
				end)
				deleteRecord(id)
				return { ok = true }
			end
			if r then
				kind = r.kind == "image" and "Images" or "Videos"
				name = loadedName(r)
				thumbs[id] = nil
				deleteRecord(id)
			end
		end
		if kind and name and session[kind] and session[kind][name] then
			local e = session[kind][name]
			if e.attrs.Audio then
				session.Sounds[string.sub(e.attrs.Audio, 6)] = nil
			end
			session[kind][name] = nil
		end
		return { ok = true }
	end

	-- load a kept record that isn't in memory: import it again from its URL
	h.libLoad = function(player, id)
		if not isAdmin(player) or type(id) ~= "string" then
			return { error = "only admins" }
		end
		readIndex()
		local r = records[id]
		if not r then
			return { error = "no such record" }
		end
		if loadedName(r) then
			return { ok = true, name = loadedName(r) }
		end
		if isAudio(r) then
			return { error = "import it again from the music player's Import (Studio): its URL is under URL" }
		end
		return h.importUrl(player, r.kind, r.url, r.quality)
	end

	Players.PlayerRemoving:Connect(function() end)
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Settings</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab:init() on the server: the settings panel's server side (the game's owner only; anyone in a
-- Studio test). The settings are the attributes on the FrameLab and AudioLab folders. Changes apply at once (they
-- replicate); Save keeps them in a DataStore, and every server applies the saved ones when it starts, over the place's
-- own values. Clear removes the saved ones (the place's values come back on the next server).
--
-- Requests: settingsGet, settingsSet(folder, key, value), settingsSave, settingsClear, settingsDefault(folder, key)
return function(FrameLab)
	local RunService = game:GetService("RunService")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local root = script:FindFirstAncestor("FrameLab")
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))

	local STORE, KEY = "LabSettings_v1", "settings"

	-- the settings: FrameLab's (Config.Defaults) and AudioLab's
	local AUDIO = {
		{ key = "Manifest", default = "Lean", choices = { "Lean", "Full", "Atlas" }, note = "sound set: Lean (the shared uploads), Full (plus your own extra uploads) or Atlas (your own atlas)" },
		{ key = "Debug", default = false, note = "testing aids: logs, the old comparison versions in the music player" },
	}
	local SKIP = {}
	-- FrameLab settings with a fixed set of values (a dropdown in the panel)
	local CHOICES = {
		SprayPerformanceMode = { "auto", "on", "off" },
		ImportVideoQuality = { "144p", "240p", "360p" },
		TVToolAccess = { "everyone", "admins", "owner", "list", "nobody" },
		SprayToolAccess = { "everyone", "admins", "owner", "list", "nobody" },
	}
	-- lists of people (UserIds or names, comma-separated): edited as a list in the panel
	local PEOPLE = { Admins = true, ToolAccessList = true }
	local function folders()
		return { FrameLab = root, AudioLab = game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):FindFirstChild("AudioLab") }
	end
	local function schema()
		local list = {}
		local keys = {}
		for k in pairs(Config.Defaults) do
			if not SKIP[k] then
				table.insert(keys, k)
			end
		end
		table.sort(keys)
		for _, k in ipairs(keys) do
			table.insert(list, { folder = "FrameLab", key = k, default = Config.Defaults[k], choices = CHOICES[k], people = PEOPLE[k] })
		end
		if folders().AudioLab then
			for _, s in ipairs(AUDIO) do
				table.insert(list, { folder = "AudioLab", key = s.key, default = s.default, choices = s.choices, note = s.note })
			end
		end
		return list
	end
	local function find(folder, key)
		for _, s in ipairs(schema()) do
			if s.folder == folder and s.key == key then
				return s
			end
		end
		return nil
	end
	local function valueOf(s)
		local f = folders()[s.folder]
		local v = f and f:GetAttribute(s.key)
		if v == nil then
			v = s.default
		end
		return v
	end

	local store, storeError
	local ok, err = pcall(function()
		store = game:GetService("DataStoreService"):GetDataStore(STORE)
	end)
	if not ok then
		storeError = tostring(err)
	end
	local saved -- the saved table, or nil

	-- the saved settings, over the place's (every server, at start)
	local function apply(t)
		if type(t) ~= "table" then
			return
		end
		for folderName, values in pairs(t) do
			local f = folders()[folderName]
			if f and type(values) == "table" then
				for k, v in pairs(values) do
					local s = find(folderName, k)
					if s and typeof(v) == typeof(s.default) then
						f:SetAttribute(k, v)
					end
				end
			end
		end
	end
	if store then
		local okG, v = pcall(store.GetAsync, store, KEY)
		if okG then
			saved = v
			apply(v)
		else
			storeError = tostring(v)
		end
	end

	local function isOwner(player)
		if RunService:IsStudio() then
			return true
		end
		if game.CreatorType == Enum.CreatorType.User then
			return player.UserId == game.CreatorId
		end
		local okR, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
		return okR and rank >= 255
	end

	local t0 = os.clock()
	while not FrameLab.Server and os.clock() - t0 < 30 do
		task.wait(0.1)
	end
	if not FrameLab.Server then
		return
	end
	local h = FrameLab.Server.handlers

	h.settingsGet = function(player)
		if not isOwner(player) then
			return nil
		end
		local items = {}
		for _, s in ipairs(schema()) do
			local sv = nil
			if type(saved) == "table" and type(saved[s.folder]) == "table" then
				sv = saved[s.folder][s.key]
			end
			table.insert(items, {
				folder = s.folder, key = s.key, value = valueOf(s), default = s.default, kind = s.people and "people" or typeof(s.default),
				choices = s.choices, note = s.note, saved = sv ~= nil, changed = sv ~= nil and sv ~= valueOf(s),
			})
		end
		return { owner = true, items = items, store = store ~= nil and storeError == nil, storeError = storeError, hasSaved = saved ~= nil }
	end

	h.settingsSet = function(player, folder, key, value)
		if not isOwner(player) then
			return { error = "only the owner" }
		end
		local s = find(folder, key)
		if not s then
			return { error = "no such setting" }
		end
		if typeof(value) ~= typeof(s.default) then
			return { error = ("%s takes a %s"):format(key, typeof(s.default)) }
		end
		if type(value) == "number" and (value ~= value or math.abs(value) == math.huge) then
			return { error = "not a number" }
		end
		if s.choices and not table.find(s.choices, value) then
			return { error = "pick one of: " .. table.concat(s.choices, ", ") }
		end
		folders()[folder]:SetAttribute(key, value)
		return { ok = true, value = value }
	end

	-- people: a name or a UserId -> { userId, name } (Roblox's lookups, cached)
	local Players = game:GetService("Players")
	local nameCache, idCache = {}, {}
	local function nameOf(id)
		if nameCache[id] == nil then
			local p = Players:GetPlayerByUserId(id)
			if p then
				nameCache[id] = p.Name
			else
				local okN, n = pcall(Players.GetNameFromUserIdAsync, Players, id)
				nameCache[id] = okN and n or false
			end
		end
		return nameCache[id] or nil
	end
	local function idOf(name)
		local key = string.lower(name)
		if idCache[key] == nil then
			for _, p in ipairs(Players:GetPlayers()) do
				if string.lower(p.Name) == key or string.lower(p.DisplayName) == key then
					idCache[key] = p.UserId
					nameCache[p.UserId] = p.Name
				end
			end
			if idCache[key] == nil then
				local okI, id = pcall(Players.GetUserIdFromNameAsync, Players, name)
				idCache[key] = okI and id or false
			end
		end
		return idCache[key] or nil
	end
	h.settingsResolve = function(player, text)
		if not isOwner(player) or type(text) ~= "string" then
			return nil
		end
		text = string.gsub(text, "^%s*@?(.-)%s*$", "%1")
		local id = tonumber(text)
		if id then
			local n = nameOf(id)
			return n and { userId = id, name = n } or { error = "no Roblox user with id " .. text }
		end
		local uid = idOf(text)
		return uid and { userId = uid, name = nameOf(uid) or text } or { error = "no Roblox user named " .. text }
	end
	-- the people in a list setting, with names and ids filled in where Roblox knows them
	h.settingsPeople = function(player, folder, key)
		if not isOwner(player) then
			return nil
		end
		local s = find(folder, key)
		if not s or not s.people then
			return nil
		end
		local out = {}
		for entry in string.gmatch(tostring(valueOf(s)), "[^,%s]+") do
			local id = tonumber(entry)
			if id then
				table.insert(out, { entry = entry, userId = id, name = nameOf(id), byId = true })
			else
				table.insert(out, { entry = entry, name = entry, userId = idOf(entry), byId = false })
			end
		end
		local online = {}
		for _, p in ipairs(Players:GetPlayers()) do
			table.insert(online, { userId = p.UserId, name = p.Name, display = p.DisplayName })
		end
		return { entries = out, online = online }
	end

	h.settingsDefault = function(player, folder, key)
		if not isOwner(player) then
			return { error = "only the owner" }
		end
		local s = find(folder, key)
		if not s then
			return { error = "no such setting" }
		end
		folders()[folder]:SetAttribute(key, s.default)
		return { ok = true, value = s.default }
	end

	-- keep every setting's current value; every server applies them when it starts
	h.settingsSave = function(player)
		if not isOwner(player) then
			return { error = "only the owner" }
		end
		if not store then
			return { error = "no DataStore: " .. tostring(storeError) }
		end
		local t = {}
		for _, s in ipairs(schema()) do
			t[s.folder] = t[s.folder] or {}
			t[s.folder][s.key] = valueOf(s)
		end
		local okS, e = pcall(store.SetAsync, store, KEY, t)
		if not okS then
			return { error = "couldn't save: " .. tostring(e) .. (RunService:IsStudio() and " (Studio: Game Settings > Security > Enable Studio Access to API Services)" or "") }
		end
		saved = t
		return { ok = true }
	end

	h.settingsClear = function(player)
		if not isOwner(player) then
			return { error = "only the owner" }
		end
		if not store then
			return { error = "no DataStore: " .. tostring(storeError) }
		end
		local okR, e = pcall(store.RemoveAsync, store, KEY)
		if not okR then
			return { error = "couldn't clear: " .. tostring(e) }
		end
		saved = nil
		return { ok = true }
	end
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">ToolAccess</string>
              <BinaryString name="AttributesSerialize"></BinaryString>
              <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
              <ContentId name="LinkedSource">
                <null>
                </null>
              </ContentId>
              <bool name="DefinesCapabilities">false</bool>
              <BinaryString name="SerializedOverrides">
              </BinaryString>
              <string name="Source"><![CDATA[-- Started by FrameLab.init() on the server: who gets the Lab tools (the "TV" and "Spray Paint" tools, built from
-- LabHub.Blueprints; a tool of that name in StarterPack is used instead). They are kept in ServerStorage and handed out
-- by the settings:
--   TVToolAccess, SprayToolAccess: "everyone" | "admins" (FrameLab admins: Config.Admins, the owner) | "owner" |
--                                   "list" (ToolAccessList: UserIds or names, comma-separated) | "nobody"
-- A change applies at once (tools given or taken away). The settings panel's "Get tools" gives the owner both tools
-- whatever the settings say (request: toolsGive).
return function(FrameLab)
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local StarterPack = game:GetService("StarterPack")
	local ServerStorage = game:GetService("ServerStorage")
	local root = script:FindFirstAncestor("FrameLab")
	local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):WaitForChild("Config"))

	local TOOLS = { { name = "TV", setting = "TVToolAccess" }, { name = "Spray Paint", setting = "SprayToolAccess" } }

	-- the tools, kept out of StarterPack (so nobody gets them unless allowed)
	local store = ServerStorage:FindFirstChild("FrameLabTools") or Instance.new("Folder")
	store.Name = "FrameLabTools"
	store.Parent = ServerStorage
	local hub = root.Parent
	local Blueprints = require(hub.Blueprints)
	local Instancer = require(hub.Instancer)
	local tools = {}
	for _, t in ipairs(TOOLS) do
		local tool = StarterPack:FindFirstChild(t.name) or store:FindFirstChild(t.name)
		if not tool and Blueprints.tools[t.name] then
			tool = Instancer.build(Blueprints.tools[t.name]) -- (its behaviour: FrameLab Runtime/Client/ToolBinder)
		end
		if tool then
			tool.Parent = store
			tools[t.name] = tool
		end
	end

	local t0 = os.clock()
	while not FrameLab.Server and os.clock() - t0 < 30 do
		task.wait(0.1)
	end
	local isAdmin = FrameLab.Server and FrameLab.Server.isAdmin or function()
		return false
	end
	local function isOwner(player)
		if RunService:IsStudio() then
			return true
		end
		if game.CreatorType == Enum.CreatorType.User then
			return player.UserId == game.CreatorId
		end
		local ok, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
		return ok and rank >= 255
	end
	local function onList(player)
		for entry in string.gmatch(tostring(Config.ToolAccessList or ""), "[^,%s]+") do
			if tonumber(entry) == player.UserId or string.lower(entry) == string.lower(player.Name) then
				return true
			end
		end
		return false
	end
	local function allowed(player, setting)
		local mode = Config[setting] or "everyone"
		if mode == "everyone" then
			return true
		elseif mode == "admins" then
			return isAdmin(player) or isOwner(player)
		elseif mode == "owner" then
			return isOwner(player)
		elseif mode == "list" then
			return onList(player) or isOwner(player)
		end
		return false -- "nobody"
	end

	local granted = {} -- player -> { [tool name] = true }: given by "Get tools" whatever the settings
	local function has(player, name)
		local bp = player:FindFirstChildOfClass("Backpack")
		return (bp and bp:FindFirstChild(name)) or (player.Character and player.Character:FindFirstChild(name))
	end
	local function update(player)
		for _, t in ipairs(TOOLS) do
			local tool = tools[t.name]
			if tool then
				local want = allowed(player, t.setting) or (granted[player] and granted[player][t.name])
				local held = has(player, t.name)
				if want and not held then
					local bp = player:FindFirstChildOfClass("Backpack")
					if bp then
						tool:Clone().Parent = bp
					end
				elseif not want and held then
					while has(player, t.name) do
						has(player, t.name):Destroy()
					end
				end
			end
		end
	end
	local function hook(player)
		player.CharacterAdded:Connect(function()
			task.wait() -- (the new Backpack)
			update(player)
		end)
		if player.Character then
			update(player)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, p in ipairs(Players:GetPlayers()) do
		task.spawn(hook, p)
	end
	Players.PlayerRemoving:Connect(function(p)
		granted[p] = nil
	end)
	-- a settings change: give / take away now
	for _, key in ipairs({ "TVToolAccess", "SprayToolAccess", "ToolAccessList", "Admins" }) do
		root:GetAttributeChangedSignal(key):Connect(function()
			for _, p in ipairs(Players:GetPlayers()) do
				update(p)
			end
		end)
	end

	if FrameLab.Server then
		FrameLab.Server.handlers.toolsGive = function(player)
			if not isOwner(player) then
				return { error = "only the owner" }
			end
			granted[player] = {}
			for _, t in ipairs(TOOLS) do
				granted[player][t.name] = true
			end
			update(player)
			return { ok = true }
		end
	end
end
]]></string>
              <int64 name="SourceAssetId">-1</int64>
            </Properties>
          </Item>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">Sync</string>
          <BinaryString name="AttributesSerialize"></BinaryString>
          <SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
          <ContentId name="LinkedSource">
            <null>
            </null>
          </ContentId>
          <bool name="DefinesCapabilities">false</bool>
          <BinaryString name="SerializedOverrides">
          </BinaryString>
          <string name="Source"><![CDATA[-- Server-authoritative video playback for FrameLab, the same way AudioLab.Sync does sound. The server never decodes a
-- video: it writes a handful of attributes on the screen's instance (a Part, or a Model with a part named "Screen"),
-- and every client plays the video there itself (Runtime/Client/FrameLabClient), on the server's playhead. Attributes
-- replicate to everyone and stay on the instance, so a player who joins later starts in the right place.
--
-- Server:
--   local Sync = require(game.ReplicatedStorage.LabHub.FrameLab.Sync)
--   Sync.play(screen, { Video = "intro", Loop = true })     -- also StartTime, Speed, Delay, Face, Sound (default true)
--   Sync.pause(screen); Sync.resume(screen); Sync.seek(screen, 12.5); Sync.stop(screen); Sync.setSpeed(screen, 1.5)
--   Sync.getTime(screen, { duration =, loop = })             -- the server's playhead in seconds
--   Sync.setClientControl(screen, true)                      -- clients may pause / seek / ... it (default: only its owner)
--   Sync.setOwner(screen, player)                            -- that player may control it (TVs)
--   Sync.authorize = function(player, target, action, arg) return true end   -- optional: veto client requests
-- Client: Sync.request(screen, "play", { Video = "intro", Loop = true }) or "pause" | "resume" | "toggle" | "stop" |
--   "restart" | "seek" | "setSpeed", n. The server checks it (Runtime/Server/FrameLabServer).
-- In Studio: tag an instance "FrameLab", set FrameLabSynced = true, FrameLabAutoPlay = true, FrameLabVideo = "<name>"
--   (and FrameLabLoop, FrameLabStartTime) and the server starts it.
-- A video imported with its sound (attribute Audio = "clip:<name>") plays that sound through AudioLab.Sync on the same
-- instance, so picture and sound share one playhead.
-- State attributes: FrameLabState ("playing" | "paused" | "stopped"), FrameLabPos, FrameLabAt, FrameLabSpeed, FrameLabSeq.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Sync = {}
Sync.Tag = "FrameLab"
Sync.Delay = 0.5 -- seconds between a server command and the start (time for clients to fetch the first chunk)

local CONFIG = { Video = "FrameLabVideo", Loop = "FrameLabLoop", Face = "FrameLabFace" }

local function serverNow()
	return workspace:GetServerTimeNow()
end

function Sync.state(instance)
	local state = instance:GetAttribute("FrameLabState")
	if state == nil then
		return nil
	end
	return {
		state = state,
		pos = instance:GetAttribute("FrameLabPos") or 0,
		at = instance:GetAttribute("FrameLabAt") or 0,
		speed = instance:GetAttribute("FrameLabSpeed") or 1,
		seq = instance:GetAttribute("FrameLabSeq") or 0,
	}
end

function Sync.rawPosition(st, now)
	if st.state == "playing" then
		return st.pos + (now - st.at) * st.speed
	end
	return st.pos
end

-- where the video should be at server time `now` (seconds, wrapped into the loop), and whether a one-shot finished
function Sync.target(st, now, info)
	local p = Sync.rawPosition(st, now)
	if p < 0 then
		return 0, false
	end
	local d = info.duration or 0
	if info.loop and d > 0 then
		return p % d, false
	end
	if d > 0 and p >= d then
		return d, true
	end
	return p, false
end

function Sync.getTime(instance, info)
	local st = Sync.state(instance)
	if not st then
		return 0
	end
	local now = serverNow()
	if info then
		return (Sync.target(st, now, info))
	end
	return math.max(0, Sync.rawPosition(st, now))
end

local function serverOnly()
	assert(RunService:IsServer(), "FrameLab.Sync commands run on the server")
end

-- AudioLab sound for a video imported with one (best effort: AudioLab may not be there)
local AudioSync
local function audio()
	if AudioSync == nil then
		local rs = game:GetService("ReplicatedStorage")
		local al = game:GetService("ReplicatedStorage"):WaitForChild("LabHub"):FindFirstChild("AudioLab")
		local m = al and al:FindFirstChild("Sync")
		local ok, mod = pcall(function()
			return m and require(m)
		end)
		AudioSync = (ok and mod) or false
	end
	return AudioSync or nil
end
local function soundOf(instance)
	if instance:GetAttribute("FrameLabSound") == false then
		return nil
	end
	local a = instance:GetAttribute("FrameLabAudio")
	if type(a) == "string" and string.sub(a, 1, 5) == "clip:" then
		return string.sub(a, 6)
	end
	return nil
end
-- runs fn(AudioLab.Sync) when this screen has (or had) sound: a screen that switched to a silent video still has to
-- stop the old video's sound
local function audioDo(instance, fn)
	local A = audio()
	if A and (instance:GetAttribute("FrameLabAudio") or instance:GetAttribute("AudioLabState") ~= nil) then
		pcall(fn, A)
	end
end

-- The sound follows the picture's playhead exactly: AudioLab's state is written with the same position, start time and
-- speed. (Calling AudioLab.Sync.pause / resume / seek let it pick its own start delay, 0.3 s against the picture's
-- 0.5 s, so every pause / resume or seek moved the sound 0.2 s further from the picture.)
local function mirrorSound(instance)
	if instance:GetAttribute("AudioLabState") == nil or not soundOf(instance) then
		return -- (no sound, or a silent video: its old sound stays stopped)
	end
	instance:SetAttribute("AudioLabPos", instance:GetAttribute("FrameLabPos"))
	instance:SetAttribute("AudioLabAt", instance:GetAttribute("FrameLabAt"))
	instance:SetAttribute("AudioLabSpeed", instance:GetAttribute("FrameLabSpeed"))
	instance:SetAttribute("AudioLabState", instance:GetAttribute("FrameLabState"))
	instance:SetAttribute("AudioLabSeq", (instance:GetAttribute("AudioLabSeq") or 0) + 1) -- last: clients react to it
end

local function write(instance, state, pos, at, speed)
	instance:SetAttribute("FrameLabPos", pos)
	instance:SetAttribute("FrameLabAt", at)
	instance:SetAttribute("FrameLabSpeed", speed)
	instance:SetAttribute("FrameLabState", state)
	instance:SetAttribute("FrameLabSeq", (instance:GetAttribute("FrameLabSeq") or 0) + 1) -- last: clients react to it
end

-- the video library entry (server: both the replicated and the ServerStorage library)
function Sync.videoEntry(name)
	if Sync.extraEntry then -- in-game imports (set by the server's Media runtime)
		local e = Sync.extraEntry(name)
		if e then
			return e
		end
	end
	local root = script.Parent
	local Store = require(root.Tools.Store)
	local roots = { root.Data.Videos }
	if RunService:IsServer() then
		local data = game:GetService("ServerStorage"):FindFirstChild("FrameLabData")
		if data and data:FindFirstChild("Videos") then
			table.insert(roots, data.Videos)
		end
	end
	for _, r in ipairs(roots) do
		local e = Store.entry(r, name)
		if e then
			return e
		end
	end
	return nil
end

function Sync.play(instance, opts)
	serverOnly()
	opts = opts or {}
	for key, attr in pairs(CONFIG) do
		if opts[key] ~= nil then
			instance:SetAttribute(attr, opts[key])
		end
	end
	local name = instance:GetAttribute("FrameLabVideo")
	local entry = name and Sync.videoEntry(name)
	if not entry then
		warn("[FrameLab] Sync.play: no video named " .. tostring(name))
		return
	end
	instance:SetAttribute("FrameLabDuration", entry:GetAttribute("Seconds") or 0)
	instance:SetAttribute("FrameLabAudio", entry:GetAttribute("Audio"))
	instance:SetAttribute("FrameLabSynced", true)
	if opts.Sound ~= nil then
		instance:SetAttribute("FrameLabSound", opts.Sound)
	end
	if not CollectionService:HasTag(instance, Sync.Tag) then
		CollectionService:AddTag(instance, Sync.Tag)
	end
	local delay = opts.Delay or Sync.Delay
	local speed = opts.Speed or instance:GetAttribute("FrameLabSpeed") or 1
	local start = opts.StartTime or 0
	local clip = soundOf(instance)
	-- an imported video's sound downloads to each client when it first plays (FrameLab.Net.clip, a few seconds): the
	-- start waits for it (Sync.soundLoadDelay, set by the server's Media runtime), so picture and sound begin together
	-- (the screen shows its first picture meanwhile)
	if clip and opts.Delay == nil and Sync.soundLoadDelay then
		local ok, d = pcall(Sync.soundLoadDelay, clip)
		if ok and type(d) == "number" then
			delay = math.max(delay, d)
		end
	end
	write(instance, "playing", start, serverNow() + delay, speed)
	-- a video's sound starts on the picture's clock: no start-up lead (AudioLab's default 0.05 s, on top of its own
	-- block-ahead scheduling, put the sound ~0.1 s before the picture), unless the instance sets its own
	if instance:GetAttribute("AudioLabSyncLead") == nil then
		instance:SetAttribute("AudioLabSyncLead", 0)
	end
	audioDo(instance, function(A)
		if clip then
			-- the sound loops on the picture's length (an imported sound is often a few ms shorter or longer than its
			-- video: looping on its own length it crept ~0.05 s further off every loop)
			local len = instance:GetAttribute("FrameLabDuration")
			A.play(instance, { Clip = clip, Loop = instance:GetAttribute("FrameLabLoop") == true, StartTime = start, Speed = speed, Delay = delay, Spatial = true,
				LoopLength = (type(len) == "number" and len > 0) and len or nil })
			mirrorSound(instance) -- the very same start time as the picture
		elseif A.state(instance) then
			A.stop(instance) -- the new video is silent: the old one's sound stops
		end
	end)
end

function Sync.pause(instance)
	serverOnly()
	local st = Sync.state(instance)
	if not st or st.state ~= "playing" then
		return
	end
	local now = serverNow()
	write(instance, "paused", math.max(0, Sync.rawPosition(st, now)), now, st.speed)
	mirrorSound(instance)
end

function Sync.resume(instance)
	serverOnly()
	local st = Sync.state(instance)
	if not st or st.state == "playing" then
		return
	end
	local pos = st.state == "stopped" and 0 or st.pos
	write(instance, "playing", pos, serverNow() + Sync.Delay, st.speed)
	mirrorSound(instance)
end

function Sync.stop(instance)
	serverOnly()
	if not Sync.state(instance) then
		return
	end
	write(instance, "stopped", 0, serverNow(), instance:GetAttribute("FrameLabSpeed") or 1)
	audioDo(instance, function(A)
		A.stop(instance)
	end)
end

function Sync.seek(instance, seconds)
	serverOnly()
	local st = Sync.state(instance)
	if not st then
		return
	end
	local now = serverNow()
	write(instance, st.state == "stopped" and "paused" or st.state, math.max(0, seconds), now, st.speed)
	mirrorSound(instance)
end

function Sync.setSpeed(instance, speed)
	serverOnly()
	local st = Sync.state(instance)
	if not st then
		instance:SetAttribute("FrameLabSpeed", speed)
		return
	end
	local now = serverNow()
	write(instance, st.state, math.max(0, Sync.rawPosition(st, now)), now, speed)
	mirrorSound(instance)
end

function Sync.setClientControl(instance, allowed)
	instance:SetAttribute("FrameLabClientControl", allowed == true)
end

function Sync.setOwner(instance, player)
	instance:SetAttribute("FrameLabOwner", player and player.UserId or nil)
end

-- client: ask the server to change a screen's video
function Sync.request(target, action, arg)
	assert(RunService:IsClient(), "Sync.request is for clients")
	local remotes = game:GetService("ReplicatedStorage"):WaitForChild("FrameLabSyncRemotes", 10)
	if remotes then
		remotes:WaitForChild("SyncControl"):FireServer(target, action, arg)
	end
end

return Sync
]]></string>
