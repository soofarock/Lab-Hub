	local t16, t17, t18, t19, t20, t21, t22, t23 = T[o + 1 * s], T[o + 17 * s], T[o + 9 * s], T[o + 25 * s], T[o + 5 * s], T[o + 21 * s], T[o + 13 * s], T[o + 29 * s]
