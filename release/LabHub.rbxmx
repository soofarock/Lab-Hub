	T[o], T[o + 1 * s], T[o + 2 * s], T[o + 3 * s], T[o + 4 * s], T[o + 5 * s], T[o + 6 * s], T[o + 7 * s] = t0, t1, t2, t3, t4, t5, t6, t7
	T[o + 8 * s], T[o + 9 * s], T[o + 10 * s], T[o + 11 * s], T[o + 12 * s], T[o + 13 * s], T[o + 14 * s], T[o + 15 * s] = t8, t9, t10, t11, t12, t13, t14, t15
	T[o + 16 * s], T[o + 17 * s], T[o + 18 * s], T[o + 19 * s], T[o + 20 * s], T[o + 21 * s], T[o + 22 * s], T[o + 23 * s] = t16, t17, t18, t19, t20, t21, t22, t23
	T[o + 24 * s], T[o + 25 * s], T[o + 26 * s], T[o + 27 * s], T[o + 28 * s], T[o + 29 * s], T[o + 30 * s], T[o + 31 * s] = t24, t25, t26, t27, t28, t29, t30, t31
	T[o + 32 * s], T[o + 33 * s], T[o + 34 * s], T[o + 35 * s], T[o + 36 * s], T[o + 37 * s], T[o + 38 * s], T[o + 39 * s] = t32, t33, t34, t35, t36, t37, t38, t39
	T[o + 40 * s], T[o + 41 * s], T[o + 42 * s], T[o + 43 * s], T[o + 44 * s], T[o + 45 * s], T[o + 46 * s], T[o + 47 * s] = t40, t41, t42, t43, t44, t45, t46, t47
	T[o + 48 * s], T[o + 49 * s], T[o + 50 * s], T[o + 51 * s], T[o + 52 * s], T[o + 53 * s], T[o + 54 * s], T[o + 55 * s] = t48, t49, t50, t51, t52, t53, t54, t55
	T[o + 56 * s], T[o + 57 * s], T[o + 58 * s], T[o + 59 * s], T[o + 60 * s], T[o + 61 * s], T[o + 62 * s], T[o + 63 * s] = t56, t57, t58, t59, t60, t61, t62, t63
end

local function iadst8(T, o, s, lo, hi)
	local t0, t1, t2, t3, t4, t5, t6, t7 = T[o + 7 * s], T[o], T[o + 5 * s], T[o + 2 * s], T[o + 3 * s], T[o + 4 * s], T[o + 1 * s], T[o + 6 * s]
	local u, v
	t0, t1 = (t0 * 4076 + t1 * 401 + 2048) // 4096, (t0 * 401 - t1 * 4076 + 2048) // 4096
	t2, t3 = (t2 * 3612 + t3 * 1931 + 2048) // 4096, (t2 * 1931 - t3 * 3612 + 2048) // 4096
	t4, t5 = (t4 * 2598 + t5 * 3166 + 2048) // 4096, (t4 * 3166 - t5 * 2598 + 2048) // 4096
	t6, t7 = (t6 * 1189 + t7 * 3920 + 2048) // 4096, (t6 * 3920 - t7 * 1189 + 2048) // 4096
	u, v = t0 + t4, t0 - t4
	t0, t4 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t1 + t5, t1 - t5
	t1, t5 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t2 + t6, t2 - t6
	t2, t6 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t3 + t7, t3 - t7
	t3, t7 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	t4, t5 = (t4 * 3784 + t5 * 1567 + 2048) // 4096, (t4 * 1567 - t5 * 3784 + 2048) // 4096
	t7, t6 = (t7 * 1567 + t6 * 3784 + 2048) // 4096, (t7 * 3784 - t6 * 1567 + 2048) // 4096
	u, v = t0 + t2, t0 - t2
	t0, t2 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t4 + t6, t4 - t6
	t4, t6 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t1 + t3, t1 - t3
	t1, t3 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t5 + t7, t5 - t7
	t5, t7 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	t2, t3 = (t2 * 2896 + t3 * 2896 + 2048) // 4096, (t2 * 2896 - t3 * 2896 + 2048) // 4096
	t6, t7 = (t6 * 2896 + t7 * 2896 + 2048) // 4096, (t6 * 2896 - t7 * 2896 + 2048) // 4096
	T[o], T[o + 1 * s], T[o + 2 * s], T[o + 3 * s], T[o + 4 * s], T[o + 5 * s], T[o + 6 * s], T[o + 7 * s] = t0, -t4, t6, -t2, t3, -t7, t5, -t1
end

local function iadst16(T, o, s, lo, hi)
	local t0, t1, t2, t3, t4, t5, t6, t7 = T[o + 15 * s], T[o], T[o + 13 * s], T[o + 2 * s], T[o + 11 * s], T[o + 4 * s], T[o + 9 * s], T[o + 6 * s]
	local t8, t9, t10, t11, t12, t13, t14, t15 = T[o + 7 * s], T[o + 8 * s], T[o + 5 * s], T[o + 10 * s], T[o + 3 * s], T[o + 12 * s], T[o + 1 * s], T[o + 14 * s]
	local u, v
	t0, t1 = (t0 * 4091 + t1 * 201 + 2048) // 4096, (t0 * 201 - t1 * 4091 + 2048) // 4096
	t2, t3 = (t2 * 3973 + t3 * 995 + 2048) // 4096, (t2 * 995 - t3 * 3973 + 2048) // 4096
	t4, t5 = (t4 * 3703 + t5 * 1751 + 2048) // 4096, (t4 * 1751 - t5 * 3703 + 2048) // 4096
	t6, t7 = (t6 * 3290 + t7 * 2440 + 2048) // 4096, (t6 * 2440 - t7 * 3290 + 2048) // 4096
	t8, t9 = (t8 * 2751 + t9 * 3035 + 2048) // 4096, (t8 * 3035 - t9 * 2751 + 2048) // 4096
	t10, t11 = (t10 * 2106 + t11 * 3513 + 2048) // 4096, (t10 * 3513 - t11 * 2106 + 2048) // 4096
	t12, t13 = (t12 * 1380 + t13 * 3857 + 2048) // 4096, (t12 * 3857 - t13 * 1380 + 2048) // 4096
	t14, t15 = (t14 * 601 + t15 * 4052 + 2048) // 4096, (t14 * 4052 - t15 * 601 + 2048) // 4096
	u, v = t0 + t8, t0 - t8
	t0, t8 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t1 + t9, t1 - t9
	t1, t9 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t2 + t10, t2 - t10
	t2, t10 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t3 + t11, t3 - t11
	t3, t11 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t4 + t12, t4 - t12
	t4, t12 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t5 + t13, t5 - t13
	t5, t13 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t6 + t14, t6 - t14
	t6, t14 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t7 + t15, t7 - t15
	t7, t15 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	t8, t9 = (t8 * 4017 + t9 * 799 + 2048) // 4096, (t8 * 799 - t9 * 4017 + 2048) // 4096
	t13, t12 = (t13 * 799 + t12 * 4017 + 2048) // 4096, (t13 * 4017 - t12 * 799 + 2048) // 4096
	t10, t11 = (t10 * 2276 + t11 * 3406 + 2048) // 4096, (t10 * 3406 - t11 * 2276 + 2048) // 4096
	t15, t14 = (t15 * 3406 + t14 * 2276 + 2048) // 4096, (t15 * 2276 - t14 * 3406 + 2048) // 4096
	u, v = t0 + t4, t0 - t4
	t0, t4 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t8 + t12, t8 - t12
	t8, t12 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t1 + t5, t1 - t5
	t1, t5 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t9 + t13, t9 - t13
	t9, t13 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t2 + t6, t2 - t6
	t2, t6 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t10 + t14, t10 - t14
	t10, t14 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t3 + t7, t3 - t7
	t3, t7 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t11 + t15, t11 - t15
	t11, t15 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	t4, t5 = (t4 * 3784 + t5 * 1567 + 2048) // 4096, (t4 * 1567 - t5 * 3784 + 2048) // 4096
	t12, t13 = (t12 * 3784 + t13 * 1567 + 2048) // 4096, (t12 * 1567 - t13 * 3784 + 2048) // 4096
	t7, t6 = (t7 * 1567 + t6 * 3784 + 2048) // 4096, (t7 * 3784 - t6 * 1567 + 2048) // 4096
	t15, t14 = (t15 * 1567 + t14 * 3784 + 2048) // 4096, (t15 * 3784 - t14 * 1567 + 2048) // 4096
	u, v = t0 + t2, t0 - t2
	t0, t2 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t4 + t6, t4 - t6
	t4, t6 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t8 + t10, t8 - t10
	t8, t10 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t12 + t14, t12 - t14
	t12, t14 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t1 + t3, t1 - t3
	t1, t3 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t5 + t7, t5 - t7
	t5, t7 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t9 + t11, t9 - t11
	t9, t11 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	u, v = t13 + t15, t13 - t15
	t13, t15 = u < lo and lo or u > hi and hi or u, v < lo and lo or v > hi and hi or v
	t2, t3 = (t2 * 2896 + t3 * 2896 + 2048) // 4096, (t2 * 2896 - t3 * 2896 + 2048) // 4096
	t6, t7 = (t6 * 2896 + t7 * 2896 + 2048) // 4096, (t6 * 2896 - t7 * 2896 + 2048) // 4096
	t10, t11 = (t10 * 2896 + t11 * 2896 + 2048) // 4096, (t10 * 2896 - t11 * 2896 + 2048) // 4096
	t14, t15 = (t14 * 2896 + t15 * 2896 + 2048) // 4096, (t14 * 2896 - t15 * 2896 + 2048) // 4096
	T[o], T[o + 1 * s], T[o + 2 * s], T[o + 3 * s], T[o + 4 * s], T[o + 5 * s], T[o + 6 * s], T[o + 7 * s] = t0, -t8, t12, -t4, t6, -t14, t10, -t2
	T[o + 8 * s], T[o + 9 * s], T[o + 10 * s], T[o + 11 * s], T[o + 12 * s], T[o + 13 * s], T[o + 14 * s], T[o + 15 * s] = t3, -t11, t15, -t7, t5, -t13, t9, -t1
end

return { idct4 = idct4, idct8 = idct8, idct16 = idct16, idct32 = idct32, idct64 = idct64, iadst8 = iadst8, iadst16 = iadst16 }
]]></string>
            <int64 name="SourceAssetId">-1</int64>
