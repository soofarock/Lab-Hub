-- ------------------------------------------------------------------ yielding
local Y = { fn = nil, slice = 0, budget = 0.015 }
local function tick()
	if Y.fn and os.clock() - Y.slice > Y.budget then
		Y.fn()
		Y.slice = os.clock()
	end
end

-- ------------------------------------------------------------------ small tools
local function log10(v)
	return log(v) / LN10
end
local hannCache = {}
local function hann(n, periodic)
	local key = n * 2 + (periodic and 1 or 0)
	local w = hannCache[key]
	if w then
		return w
	end
	w = table.create(n)
	local d = periodic and n or (n - 1)
	for i = 0, n - 1 do
		w[i + 1] = 0.5 - 0.5 * cos(2 * PI * i / d)
	end
	hannCache[key] = w
	return w
end
local function nextPow2(n)
	local p = 1
	while p < n do
		p *= 2
	end
	return p
end
-- median of a[1..k] (sorts a in place; even k: mean of the middle two, like numpy)
local function medianInPlace(a, k)
	for i = 2, k do
		local v = a[i]
		local j = i - 1
		while j >= 1 and a[j] > v do
			a[j + 1] = a[j]
			j -= 1
		end
		a[j + 1] = v
	end
	if k % 2 == 1 then
		return a[(k + 1) // 2]
	end
	return 0.5 * (a[k // 2] + a[k // 2 + 1])
end

-- Prng: xorshift32 + Box-Muller (deterministic: every client builds the same click waveforms)
local Prng = {}
Prng.__index = Prng
function Prng.new(seed)
	local s = (seed * 2654435761 + 12345) % 4294967296
	if s == 0 then
		s = 1
	end
	return setmetatable({ s = s }, Prng)
end
function Prng:u32()
	local s = self.s
	s = bit32.bxor(s, bit32.lshift(s, 13))
	s = bit32.bxor(s, bit32.rshift(s, 17))
	s = bit32.bxor(s, bit32.lshift(s, 5))
	self.s = s
	return s
end
function Prng:uniform()
	return (bit32.rshift(self:u32(), 8) + 0.5) / 16777216
end
function Prng:normals(n)
	local out = table.create(n, 0)
	local i = 1
	while i <= n do
		local u1, u2 = self:uniform(), self:uniform()
		local r = sqrt(-2 * log(u1))
		out[i] = r * cos(2 * PI * u2)
		if i + 1 <= n then
			out[i + 1] = r * sin(2 * PI * u2)
		end
		i += 2
	end
	return out
end
Texture.Prng = Prng

-- ------------------------------------------------------------------ filters (second-order sections {b0,b1,b2,a1,a2})
local function sosfiltInPlace(sos, y, n)
	for _, s in ipairs(sos) do
		local b0, b1, b2, a1, a2 = s[1], s[2], s[3], s[4], s[5]
		local z1, z2 = 0, 0
		for i = 1, n do
			local v = y[i]
			local o = b0 * v + z1
			z1 = b1 * v - a1 * o + z2
			z2 = b2 * v - a2 * o
			y[i] = o
		end
	end
end
local PADLEN = 1024
-- zero-phase: odd extension at both ends, forward, backward
local function filtfilt(sos, x, n)
	n = n or #x
	local p = min(PADLEN, n - 1)
	local m = n + 2 * p
	local e = table.create(m)
	local x1, xn = x[1], x[n]
	for i = 1, p do
		e[i] = 2 * x1 - x[p + 2 - i]
	end
	for i = 1, n do
		e[p + i] = x[i]
	end
	for i = 1, p do
		e[p + n + i] = 2 * xn - x[n - i]
	end
	sosfiltInPlace(sos, e, m)
	-- backward
	for i = 1, m // 2 do
		e[i], e[m + 1 - i] = e[m + 1 - i], e[i]
	end
	sosfiltInPlace(sos, e, m)
	local out = table.create(n)
	for i = 1, n do
		out[i] = e[m + 1 - (p + i)]
	end
	tick()
	return out
end
Texture.filtfilt = filtfilt

-- ------------------------------------------------------------------ FFT helpers (DSP.FFT: complex, in place, 1-indexed)
-- analytic signal of x[1..n] through an FFT of the next power of two
local function analytic(x, n)
	local N = nextPow2(n)
	local re, im = table.create(N, 0), table.create(N, 0)
	for i = 1, n do
		re[i] = x[i]
	end
	FFT.transform(re, im)
	local half = N // 2
	for k = 1, N do
		local h
		if k == 1 or k == half + 1 then
			h = 1
		elseif k <= half then
			h = 2
		else
			h = 0
		end
		re[k] *= h
		im[k] *= h
	end
	FFT.transform(re, im, true)
	return re, im
end

-- ------------------------------------------------------------------ resampling to 48 kHz (windowed sinc)
local function resample48(x, sr, taps)
	taps = taps or 16
	local n = #x
	if sr == R then
		local y = table.create(n)
		for i = 1, n do
			y[i] = x[i]
		end
		return y
	end
	local nOut = floor(n * R / sr)
	local fc = 0.95 * min(sr, R) / 2 / sr
	local scale = max(1, sr / R)
	local lim = taps * scale
	local y = table.create(nOut, 0)
	for i = 0, nOut - 1 do
		local t = i * sr / R
		local k0 = floor(t)
		local acc = 0
		for k = -taps + 1, taps do
			local kk = k0 + k
			if kk >= 0 and kk < n then
				local d = t - kk
				if abs(d) < lim then
					local w = 0.5 + 0.5 * cos(PI * d / lim)
					local a = 2 * fc * d
					local sc = (a == 0) and 1 or (sin(PI * a) / (PI * a))
					acc += x[kk + 1] * 2 * fc * sc * w
				end
			end
		end
		y[i + 1] = acc
		if i % 4096 == 0 then
			tick()
		end
	end
	return y
end
Texture.resample48 = resample48

-- ------------------------------------------------------------------ 1. split into tones / noise
local SP_N, SP_H, SP_T, SP_F = 1024, 64, 11, 11
local function split(x, n)
	local N, H = SP_N, SP_H
	local K = N // 2 + 1
	local w = hann(N, true)
	local pad = N // 2
	local nf = (n + H - 1) // H + 1
	local Zr, Zi = buffer.create(nf * K * 4), buffer.create(nf * K * 4)
	local M = buffer.create(nf * K * 4)
	local re, im = table.create(N, 0), table.create(N, 0)
	for j = 0, nf - 1 do
		for i = 1, N do
			local xi = j * H + i - pad -- 1-based index into x
			re[i] = (xi >= 1 and xi <= n) and x[xi] * w[i] or 0
			im[i] = 0
		end
		FFT.transform(re, im)
		local o = j * K * 4
		for k = 1, K do
			local a, b = re[k], im[k]
			buffer.writef32(Zr, o + (k - 1) * 4, a)
			buffer.writef32(Zi, o + (k - 1) * 4, b)
			buffer.writef32(M, o + (k - 1) * 4, sqrt(a * a + b * b))
		end
		if j % 64 == 0 then
			tick()
		end
	end
	-- medians: across time (steady tones) and across frequency (clicks), edges repeat the end value
	local mask = buffer.create(nf * K * 4)
	local win = table.create(11, 0)
	local ht, hf = SP_T // 2, SP_F // 2
	for j = 0, nf - 1 do
		for k = 0, K - 1 do
			for q = -ht, ht do
				local jj = min(max(j + q, 0), nf - 1)
				win[q + ht + 1] = buffer.readf32(M, (jj * K + k) * 4)
			end
			local hm = medianInPlace(win, SP_T)
			for q = -hf, hf do
				local kk = min(max(k + q, 0), K - 1)
				win[q + hf + 1] = buffer.readf32(M, (j * K + kk) * 4)
			end
			local pm = medianInPlace(win, SP_F)
			local h2 = hm * hm
			buffer.writef32(mask, (j * K + k) * 4, h2 / (h2 + pm * pm + 1e-20))
		end
		if j % 32 == 0 then
			tick()
		end
	end
	-- inverse: both parts, overlap-add, normalised by the summed squared window
	local total = n + 2 * N + pad
	local xt, xn, ws = table.create(total, 0), table.create(total, 0), table.create(total, 0)
	local rt, it, rn, inn = table.create(N, 0), table.create(N, 0), table.create(N, 0), table.create(N, 0)
	for j = 0, nf - 1 do
		local o = j * K
		for k = 1, K do
			local a = buffer.readf32(Zr, (o + k - 1) * 4)
			local b = buffer.readf32(Zi, (o + k - 1) * 4)
			local mh = buffer.readf32(mask, (o + k - 1) * 4)
			rt[k], it[k] = a * mh, b * mh
			rn[k], inn[k] = a * (1 - mh), b * (1 - mh)
		end
		-- numpy irfft ignores the imaginary parts of the DC and Nyquist bins
		it[1], it[K], inn[1], inn[K] = 0, 0, 0, 0
		for k = K + 1, N do
			local src = N - k + 2
			rt[k], it[k] = rt[src], -it[src]
			rn[k], inn[k] = rn[src], -inn[src]
		end
		FFT.transform(rt, it, true)
		FFT.transform(rn, inn, true)
		local base = j * H
		for i = 1, N do
			local wi = w[i]
			xt[base + i] += rt[i] * wi
			xn[base + i] += rn[i] * wi
			ws[base + i] += wi * wi
		end
		if j % 64 == 0 then
			tick()
		end
	end
	local ot, on = table.create(n), table.create(n)
	for i = 1, n do
		local d = max(ws[pad + i], 1e-9)
		ot[i] = xt[pad + i] / d
		on[i] = xn[pad + i] / d
	end
	return ot, on
end

-- ------------------------------------------------------------------ 2. tone seeds (ridge tracker)
local function track(x, n, win)
	local hop, fmin, fmax, promDb, maxJump, minFrames, nfft = 128, 300, 7000, 10, 0.12, 6, 4096
	local w = hann(win, false)
	local wsum = 0
	for i = 1, win do
		wsum += w[i]
	end
	local lo, hi = math.ceil(fmin * nfft / R), math.ceil(fmax * nfft / R)
	local re, im = table.create(nfft, 0), table.create(nfft, 0)
	local P = table.create(nfft // 2 + 1, 0)
	local nb = table.create(64, 0)
	local frames = {}
	local s = 0
	while s < n - win do
		for i = 1, nfft do
			re[i] = (i <= win) and x[s + i] * w[i] or 0
			im[i] = 0
		end
		FFT.transform(re, im)
		for k = lo, hi do -- P[k] (0-based bin k at index k + 1)
			local a, b = re[k + 1], im[k + 1]
			P[k + 1] = 20 * log10(sqrt(a * a + b * b) + 1e-12)
		end
		local pk = {}
		for i = lo + 1, hi - 2 do
			local pi = P[i + 1]
			if pi > P[i] and pi >= P[i + 2] then
				local c = 0
				for q = max(lo, i - 40), i - 9 do
					c += 1
					nb[c] = P[q + 1]
				end
				for q = i + 9, min(hi, i + 41) - 1 do
					c += 1
					nb[c] = P[q + 1]
				end
				if c > 0 and pi - medianInPlace(nb, c) > promDb then
					local a, b, cc = P[i], pi, P[i + 2]
					local d = 0.5 * (a - cc) / (a - 2 * b + cc)
					table.insert(pk, { (i + d) * R / nfft, 10 ^ ((b - 0.25 * (a - cc) * d) / 20) * 2 / wsum })
				end
			end
		end
		table.insert(frames, pk)
		s += hop
		if #frames % 16 == 0 then
			tick()
		end
	end
	local tracks, live = {}, {}
	for j, pk in ipairs(frames) do
		local used, nxt = {}, {}
		for _, tr in ipairs(live) do
			local fl = tr.f[#tr.f]
			local best, bd = nil, maxJump
			for q, p in ipairs(pk) do
				if not used[q] then
					local dv = abs(p[1] / fl - 1)
					if dv < bd then
						best, bd = q, dv
					end
				end
			end
			if best then
				used[best] = true
				table.insert(tr.f, pk[best][1])
				table.insert(tr.a, pk[best][2])
				table.insert(nxt, tr)
			else
				table.insert(tracks, tr)
			end
		end
		for q, p in ipairs(pk) do
			if not used[q] then
				table.insert(nxt, { start = j - 1, f = { p[1] }, a = { p[2] } })
			end
		end
		live = nxt
	end
	for _, tr in ipairs(live) do
		table.insert(tracks, tr)
	end
	local out = {}
	for _, tr in ipairs(tracks) do
		if #tr.f >= minFrames then
			table.insert(out, tr)
		end
	end
	return out
end
local function seeds(x, n)
	local out = {}
	for _, win in ipairs({ 1024, 512 }) do
		for _, t in ipairs(track(x, n, win)) do
			local sa, sl = 0, 0
			for i, a in ipairs(t.a) do
				sa += a * a
				sl += a * a * log(t.f[i])
			end
			local t0 = (t.start * 128 + win // 2 - 64) / R
			local d = #t.f * 128 / R
			local fm = exp(sl / sa)
			local dup = false
			for _, s in ipairs(out) do
				if abs(log(s.fm / fm)) < 0.15 and s.t0 < t0 + d and t0 < s.t0 + s.d then
					dup = true
					break
				end
			end
			if not dup then
				table.insert(out, { t0 = t0, d = d, fm = fm })
			end
		end
	end
	return out
end

-- ------------------------------------------------------------------ 3. tone shapes and the fit
local function makeShape(r, c, p, dec)
	local f0, attack = 1000.0, 0.12
	local acc = 0
	for i = 0, 2000 do
		acc += r ^ ((i / 2000) ^ p)
	end
	local T = c / (f0 * (acc / 2001))
	local n = floor(T * R)
	local m = floor(0.2 * n)
	local y = table.create(n + m)
	local envf, ff = table.create(n + m), table.create(n + m)
	local phs = 0
	local fl, el, pl = 0, 0, 0
	local sw, swl = 0, 0
	for i = 0, n - 1 do
		local t = i / R
		local f = f0 * r ^ ((t / T) ^ p)
		phs += f
		local ph = 2 * PI * phs / R
		local env = min(1, t / (attack * T)) * 10 ^ (-dec / 20 * t / T)
		y[i + 1] = env * sin(ph)
		envf[i + 1], ff[i + 1] = env, f
		fl, el, pl = f, env, ph
		local wv = env * env
		sw += wv
		swl += wv * log(f)
	end
	local f1 = fl
	for j = 0, m - 1 do
		local tail = exp(-j / (0.05 * n + 1))
		y[n + j + 1] = (el * tail) * sin(pl + 2 * PI * fl * (j + 1) / R)
		envf[n + j + 1], ff[n + j + 1] = el * tail, fl
		local wv = (el * tail) ^ 2
		sw += wv
		swl += wv * log(fl)
	end
	local pk = 0
	for i = 1, n + m do
		pk = max(pk, abs(y[i]))
	end
	for i = 1, n + m do
		y[i] /= pk
		envf[i] /= pk
	end
	return { y = y, T = T, fmean = exp(swl / sw), f0 = f0, f1 = f1, envf = envf, ff = ff }
end
local FAM = nil
local function family()
	if not FAM then
		FAM = {}
		for i, k in ipairs(SHAPES) do
			FAM[i] = makeShape(k[1], k[2], k[3], k[4])
			if i % 8 == 0 then
				tick()
			end
		end
	end
	return FAM
end
Texture.family = family
-- numpy.interp(arange(0, len - 1, sp), arange(len), s)
local function atSpeed(s, sp)
	local L = #s
	local cnt = math.ceil((L - 1) / sp)
	local out = table.create(cnt)
	for k = 0, cnt - 1 do
		local q = k * sp
		local i = floor(q)
		local fr = q - i
		local a = s[i + 1]
		local b = s[i + 2] or a
		out[k + 1] = a + fr * (b - a)
	end
	return out
end
local TF_WIN, TF_HOP, TF_NFFT, TF_FMAX = 384, 48, 512, 7000
local TF_K = TF_NFFT // 2 + 1
local KMAX = floor(TF_FMAX * TF_NFFT / R) + 1
-- |rfft| of frames j0..j1-1 of y (frame j = y[j*hop + 1 .. + win], zero beyond the end), bins 0..kmax-1: rows of arrays
local tfRe, tfIm = table.create(TF_NFFT, 0), table.create(TF_NFFT, 0)
local function tfFrames(y, n, j0, j1, kmax)
	local w = hann(TF_WIN, false)
	local rows = table.create(max(0, j1 - j0))
	for j = j0, j1 - 1 do
		local o = j * TF_HOP
		for i = 1, TF_NFFT do
			local yi = o + i
			tfRe[i] = (i <= TF_WIN and yi <= n) and y[yi] * w[i] or 0
			tfIm[i] = 0
		end
		FFT.transform(tfRe, tfIm)
		local row = table.create(kmax)
		for k = 1, kmax do
			local a, b = tfRe[k], tfIm[k]
			row[k] = sqrt(a * a + b * b)
		end
		rows[j - j0 + 1] = row
	end
	return rows
end
local function tfCount(n)
	local len = max(n, TF_WIN)
	return (len - TF_WIN) // TF_HOP + 1
end
-- the sound's peak map: magnitude minus its median across PK_FLOOR bins (wide: a fast sweep smeared over many bins stays)
local PK_FLOOR = 21
local function peakMap(x, n)
	local nf = tfCount(n)
	local rows = tfFrames(x, n, 0, nf, TF_K)
	local h = PK_FLOOR // 2
	local win = table.create(PK_FLOOR, 0)
	local out = table.create(nf)
	for j = 1, nf do
		local row = rows[j]
		local o = table.create(KMAX)
		for k = 1, KMAX do
			for q = -h, h do
				win[q + h + 1] = row[min(max(k + q, 1), TF_K)]
			end
			o[k] = row[k] - medianInPlace(win, PK_FLOOR)
		end
		out[j] = o
		if j % 64 == 0 then
			tick()
		end
	end
	return out
end
local MIN_LEN, MAX_LEN, SLACK = 0.7, 4.0, 0.012
local function tfScore(Mx, s, sp, j0, sl)
	local y = atSpeed(s.y, sp)
	local ny = #y
	local Mb = tfFrames(y, ny, 0, tfCount(ny), KMAX)
	local nb = #Mb
	local function dot(lag)
		local d = 0
		for j = 1, nb do
			local xr = Mx[lag + j]
			if not xr then
				break
			end
			local br = Mb[j]
			for k = 1, KMAX do
				d += xr[k] * br[k]
			end
		end
		return d
	end
	local lo, hi = max(0, j0 - sl), j0 + sl
	local bd, bl = nil, lo
	for lag = lo, hi, 2 do
		local d = dot(lag)
		if bd == nil or d > bd then
			bd, bl = d, lag
		end
	end
	for _, lag in ipairs({ bl - 1, bl + 1 }) do
		if lag >= lo and lag <= hi then
			local d = dot(lag)
			if d > bd then
				bd, bl = d, lag
			end
		end
	end
	local nn = 0
	for j = 1, nb do
		local br = Mb[j]
		for k = 1, KMAX do
			nn += br[k] * br[k]
		end
	end
	tick()
	return bd / sqrt(nn), bl, bd / nn
end
-- cheap pre-score: the peak map (max of 3 bins) summed along the shape's own pitch path, weighted by its envelope
local NPRE = 12
local function peak3(Mx)
	local out = table.create(#Mx)
	for j, row in ipairs(Mx) do
		local o = table.create(KMAX)
		for k = 1, KMAX do
			o[k] = max(row[k], row[min(k + 1, KMAX)], row[max(k - 1, 1)])
		end
		out[j] = o
	end
	return out
end
local function preScore(P3, s, sp, j0, sl)
	local ny = math.ceil((#s.y - 1) / sp)
	local nfr = (max(ny, TF_WIN) - TF_WIN) // TF_HOP + 1
	local L = #s.envf
	local js, bins, es = {}, {}, {}
	local ne = 0
	for j = 0, nfr - 1 do
		local tc = (j * TF_HOP + TF_WIN / 2) * sp
		local idx = min(floor(tc), L - 1)
		local b = floor(s.ff[idx + 1] * sp * TF_NFFT / R + 0.5)
		if b >= 1 and b <= KMAX - 2 then
			local e = s.envf[idx + 1]
			table.insert(js, j)
			table.insert(bins, b + 1)
			table.insert(es, e)
			ne += e * e
		end
	end
	if #es == 0 then
		return -1e30
	end
	local nP = #P3
	local best = nil
	for lag = max(0, j0 - sl), j0 + sl, 2 do
		local d = 0
		for q = 1, #es do
			local r = lag + js[q]
			if r < nP then
				d += es[q] * P3[r + 1][bins[q]]
			end
		end
		if best == nil or d > best then
			best = d
		end
	end
	return best / sqrt(ne)
end
local function fit(Mx, P3, sd)
	local fam = family()
	local j0 = floor(sd.t0 * R / TF_HOP)
	local sl = floor(SLACK * R / TF_HOP)
	local pre = {}
	for i, s in ipairs(fam) do
		for cc = -300, 300, 50 do
			local sp = sd.fm / s.fmean * 2 ^ (cc / 1200)
			if sp >= 0.15 and sp <= 6 then
				local T = s.T / sp
				if T >= MIN_LEN * sd.d and T <= MAX_LEN * sd.d + 0.03 then
					table.insert(pre, { preScore(P3, s, sp, j0, sl), i, sp, #pre })
				end
			end
		end
	end
	if #pre == 0 then
		return nil
	end
	local function byScore(a, b)
		if a[1] ~= b[1] then
			return a[1] > b[1]
		end
		return a[4] < b[4]
	end
	table.sort(pre, byScore)
	tick()
	local cand = {}
	for q = 1, min(NPRE, #pre) do
		local i, sp = pre[q][2], pre[q][3]
		table.insert(cand, { (tfScore(Mx, fam[i], sp, j0, sl)), i, sp, q })
	end
	table.sort(cand, byScore)
	local best = nil
	for q = 1, min(4, #cand) do
		local i, sp0 = cand[q][2], cand[q][3]
		for _, cc in ipairs({ -20, -10, 0, 10, 20 }) do
			local sp = sp0 * 2 ^ (cc / 1200)
			local e, lag, amp = tfScore(Mx, fam[i], sp, j0, sl)
			if best == nil or e > best.energy then
				best = { t = lag * TF_HOP, shape = i, speed = sp, amp = amp, energy = e }
			end
		end
	end
	return best
end
local function dedupe(bl)
	local fam = family()
	local order = table.clone(bl)
	for i, b in ipairs(order) do
		b._i = i
	end
	table.sort(order, function(a, b)
		if a.energy ~= b.energy then
			return a.energy > b.energy
		end
		return a._i < b._i
	end)
	local out = {}
	for _, b in ipairs(order) do
		local s = fam[b.shape]
		local f0, T = s.f0 * b.speed, s.T / b.speed
		local same = false
		for _, o in ipairs(out) do
			local so = fam[o.shape]
			local g0, To = so.f0 * o.speed, so.T / o.speed
			local ov = min(b.t / R + T, o.t / R + To) - max(b.t, o.t) / R
			if abs(log(f0 / g0)) < 0.1 and ov > 0.6 * min(T, To) then
				same = true
				break
			end
		end
		if not same then
			table.insert(out, b)
		end
	end
	return out
end
-- adds a bubble's waveform to y (in place)
local function addBubble(y, n, b, scale)
	local s = atSpeed(family()[b.shape].y, b.speed)
	local a = b.amp * (scale or 1)
	for i = 1, min(#s, n - b.t) do
		y[b.t + i] += s[i] * a
	end
	return #s
end

-- ---- checks
local ACCEPT_DB, COHERENT_DB, N_SUR = 4.0, 6.0, 8
local function smooth3(rows)
	local nf = #rows
	local out = table.create(nf)
	for j = 1, nf do
		local a, b, c = rows[max(j - 1, 1)], rows[j], rows[min(j + 1, nf)]
		local o = table.create(#b)
		for k = 1, #b do
			o[k] = (a[k] + b[k] + c[k]) / 3
		end
		out[j] = o
	end
	return out
end
local function logRows(rows)
	for _, row in ipairs(rows) do
		for k = 1, #row do
			row[k] = 20 * log10(row[k] + 1e-7)
		end
	end
	return rows
end
local function gainDb(x, cur, n, b)
	local s = table.create(n, 0)
	local len = addBubble(s, n, b)
	local nfr = (n - TF_WIN) // TF_HOP + 1
	local a = max(0, b.t // TF_HOP - 2)
	local e = min(nfr, (b.t + len) // TF_HOP + 3)
	if e - a < 2 then
		return -99
	end
	local Ms = tfFrames(s, n, a, e, TF_K)
	local mx = 0
	for _, row in ipairs(Ms) do
		for k = 1, TF_K do
			mx = max(mx, row[k] + 1e-7)
		end
	end
	local kcut = floor(8000 * TF_NFFT / R)
	local Lx = smooth3(logRows(tfFrames(x, n, a, e, TF_K)))
	local L0 = smooth3(logRows(tfFrames(cur, n, a, e, TF_K)))
	local c1 = table.create(n)
	for i = 1, n do
		c1[i] = cur[i] + s[i]
	end
	local L1 = smooth3(logRows(tfFrames(c1, n, a, e, TF_K)))
	local d0, d1, cnt = 0, 0, 0
	for j = 1, #Ms do
		local row = Ms[j]
		for k = 1, kcut do
			if row[k] + 1e-7 > mx * 0.1 then
				d0 += abs(Lx[j][k] - L0[j][k])
				d1 += abs(Lx[j][k] - L1[j][k])
				cnt += 1
			end
		end
	end
	if cnt == 0 then
		return -99
	end
	return (d0 - d1) / cnt
end
local function bestProj(xr, xi, nx, sr, si, m, c)
	local ns = 0
	for i = 1, m do
		ns += sr[i] * sr[i] + si[i] * si[i]
	end
	local best = 0
	for a = c - 48, c + 48, 4 do
		if a >= 0 and a + m <= nx then
			local pr, pi = 0, 0
			for i = 1, m do
				-- conj(s) * x
				local ar, ai, br, bi = sr[i], si[i], xr[a + i], xi[a + i]
				pr += ar * br + ai * bi
				pi += ar * bi - ai * br
			end
			best = max(best, (pr * pr + pi * pi) / ns)
		end
	end
	return best
end
local function surrogateDb(x, n, b, rng)
	local s = atSpeed(family()[b.shape].y, b.speed)
	local t = b.t
	local m = min(#s, n - t)
	if m < 64 then
		return -99
	end
	local sr, si = analytic(s, m)
	local p = floor(0.03 * R)
	local a0 = max(0, t - p)
	local a1 = min(n, t + m + p)
	local L = a1 - a0
	local seg = table.create(L)
	for i = 1, L do
		seg[i] = x[a0 + i]
	end
	local c = t - a0
	local xr, xi = analytic(seg, L)
	local real = bestProj(xr, xi, L, sr, si, m, c)
	local N = nextPow2(L)
	local re, im = table.create(N, 0), table.create(N, 0)
	for i = 1, L do
		re[i] = seg[i]
	end
	FFT.transform(re, im)
	local K = N // 2 + 1
	local mag = table.create(K)
	for k = 1, K do
		mag[k] = sqrt(re[k] * re[k] + im[k] * im[k])
	end
	local sur = 0
	local zr, zi = table.create(N, 0), table.create(N, 0)
	local z = table.create(L, 0)
	for _ = 1, N_SUR do
		for k = 1, K do
			local u = rng:uniform()
			if k == 1 then
				zr[k], zi[k] = mag[k], 0
			else
				zr[k], zi[k] = mag[k] * cos(2 * PI * u), mag[k] * sin(2 * PI * u)
			end
		end
		zi[K] = 0 -- (irfft drops the Nyquist bin's imaginary part)
		for k = K + 1, N do
			zr[k], zi[k] = zr[N - k + 2], -zi[N - k + 2]
		end
		FFT.transform(zr, zi, true)
		for i = 1, L do
			z[i] = zr[i]
		end
		local ar, ai = analytic(z, L)
		sur += bestProj(ar, ai, L, sr, si, m, c)
		tick()
	end
	return 10 * log10(real / (sur / N_SUR + 1e-20) + 1e-12)
end

-- ------------------------------------------------------------------ 4. clicks
local CB = { 500, 1000, 2000, 4000, 8000 }
local TAUS = { 0.0007, 0.002, 0.006 }
local RISE_DB = 9.0
local BURSTS = nil
local function bursts()
	if not BURSTS then
		BURSTS = {}
		for bi, c in ipairs(CB) do
			BURSTS[bi] = {}
			for ti, tau in ipairs(TAUS) do
				BURSTS[bi][ti] = {}
				for v = 0, 2 do
					local n = floor(tau * 7 * R) + 64
					local seed = c * 100 + floor(tau * 1e4 + 0.5) * 10 + v
					local z = Prng.new(seed):normals(n + 2048)
					z = filtfilt(CB_SOS[bi], z, n + 2048)
					local y = table.create(n)
					local e = 0
					for i = 1, n do
						local t = (i - 1) / R
						local env = min(1, t / 0.0002) * exp(-t / tau)
						y[i] = z[1024 + i] * env
						e += y[i] * y[i]
					end
					e = sqrt(e)
					for i = 1, n do
						y[i] /= e
					end
					BURSTS[bi][ti][v + 1] = y
				end
			end
		end
	end
	return BURSTS
end
Texture.bursts = bursts
local function detectClicks(xn, n)
	local ev = {}
	local h = 24
	for bi = 1, #CB do
		local b = filtfilt(CB_SOS[bi], xn, n)
		local ne = (n + h - 1) // h
		local e = table.create(ne, 0)
		for i = 1, n do
			local q = (i - 1) // h + 1
			e[q] += b[i] * b[i]
		end
		-- 20 ms background: median over 41 cells (edges repeat)
		local bg = table.create(ne)
		local win = table.create(41, 0)
		for i = 1, ne do
			for q = -20, 20 do
				win[q + 21] = e[min(max(i + q, 1), ne)]
			end
			bg[i] = medianInPlace(win, 41) + 1e-14
		end
		local L = table.create(ne)
		for i = 1, ne do
			L[i] = 10 * log10(e[i] + 1e-14) - 10 * log10(bg[i])
		end
		local order = table.create(ne)
		for i = 1, ne do
			order[i] = i
		end
		table.sort(order, function(a, c)
			if e[a] ~= e[c] then
				return e[a] > e[c]
			end
			return a < c
		end)
		local used = table.create(ne, false)
		for _, i in ipairs(order) do
			if L[i] >= RISE_DB then
				local busy = false
				for q = max(1, i - 2), min(ne, i + 2) do
					if used[q] then
						busy = true
						break
					end
				end
				if not busy then
					local j = i
					while j + 1 <= ne and j - i < 40 and L[j + 1] > 3 do
						j += 1
					end
					local k = i
					while k - 1 >= 1 and i - k < 4 and L[k - 1] > 3 do
						k -= 1
					end
					local E = 0
					for q = k, j do
						E += max(e[q] - bg[q], 0)
					end
					local ex0 = max(e[i] - bg[i], 0)
					local cnt = j - i + 1
					for q = i, j do
						if max(e[q] - bg[q], 0) < ex0 * exp(-2) then
							cnt = q - i
							break
						end
					end
					local dur = cnt * h / R
					local ti, bestv = 1, math.huge
					for t, tau in ipairs(TAUS) do
						local v = abs(log(tau / max(dur, 1e-4)))
						if v < bestv then
							ti, bestv = t, v
						end
					end
					table.insert(ev, { t = (k - 1) * h, band = bi, tau = ti, var = #ev % 3 + 1, amp = sqrt(E) })
					for q = k, j do
						used[q] = true
					end
				end
			end
		end
		tick()
	end
	return ev
end
local function clicksWave(ev, n)
	local B = bursts()
	local y = table.create(n, 0)
	for _, c in ipairs(ev) do
		local s = B[c.band][c.tau][c.var]
		for i = 1, min(#s, n - c.t) do
			y[c.t + i] += s[i] * c.amp
		end
	end
	return y
end

-- ------------------------------------------------------------------ 5. grains
local GB = table.create(15)
for i = -3, 11 do
	GB[i + 4] = 125 * 2 ^ (i / 2)
end
Texture.GB = GB
local function gReal(c)
	return c >= 500 and 0.007 or (c >= 200 and 0.010 or (c >= 100 and 0.025 or 0.040))
end
Texture.gReal = gReal
-- v2 grain bands: the half-octave set (GB, crackle grains from 1 kHz) then the sixth-octave set (40 Hz .. 2 kHz, smooth);
-- each band's weight (W2: share of the band's power its set carries) and calibration (UNIT2) come from the data above
local SIXTH = {}
do
	local k = 0
	while 40 * 2 ^ (k / 6) < 2000 do
		table.insert(SIXTH, 40 * 2 ^ (k / 6))
		k += 1
	end
end
local BANDS = {}
for _, c in ipairs(GB) do
	table.insert(BANDS, { c = c, half = true })
end
for _, c in ipairs(SIXTH) do
	table.insert(BANDS, { c = c, half = false })
end
for i, b in ipairs(BANDS) do
	b.w = W2[i]
end
Texture.BANDS = BANDS
local function gReal2(c)
	return 2 * gReal(c)
end
Texture.gReal2 = gReal2
-- per band: grain volumes on its fixed grid (t = k * G/2), from the band power of target minus `minus` in each grain window
local function grainLevels2(target, minus, n)
	local out = {}
	for bi, band in ipairs(BANDS) do
		local G = gReal2(band.c)
		local hop = G / 2
		local xb = filtfilt(B2_SOS[bi], target, n)
		local tb = filtfilt(B2_SOS[bi], minus, n)
		local g = floor(G * R)
		local w = table.create(g)
		local ws = 0
		for i = 0, g - 1 do
			local v = sin(PI * (i + 0.5) / g)
			w[i + 1] = v * v
			ws += v * v
		end
		for i = 1, g do
			w[i] /= ws
		end
		local sw = sqrt(W2[bi])
		local vols = {}
		local k = 0
		while k * hop < n / R do
			local a = floor(k * hop * R)
			local m = min(g, n - a)
			local px, pt = 0, 0
			for i = 1, m do
				local xv, tv = xb[a + i], tb[a + i]
				px += xv * xv * w[i]
				pt += tv * tv * w[i]
			end
			local p = max(px - pt, 0.05 * px)
			vols[k + 1] = (p > 1e-12) and sqrt(p / UNIT2[bi]) * sw or 0
			k += 1
		end
		out[bi] = vols
		tick()
	end
	return out
end

-- ------------------------------------------------------------------ where each piece sits in the upload files
-- (each piece follows LEAD seconds of silence; same packing as the file maker)
local function shapeSamples(r, c, p)
	local acc = 0
	for i = 0, 2000 do
		acc += r ^ ((i / 2000) ^ p)
	end
	local T = c / (1000.0 * (acc / 2001))
	local n = floor(T * R)
	return n + floor(0.2 * n)
end
-- kinds whose upload file is split into tex_<kind>_NN files of at most this many seconds (the rest: MAX_FILE). Every
-- upload is kept at 4.16 s or less; the split files are the single files cut at piece boundaries (same audio).
-- (clicks: tex_clicks_01 and the tex_clicks_low_NN files below. grains2 is only the fallback for when the tex_beds files
-- can't load and is not required; grains2 = 4.16 splits it, with files 07..09 cut finer by SubSplit.)
Texture.SplitSeconds = { tones = 4.16, clicks = 2.0 }
-- split files cut finer: kind -> { [file number] = seconds }. That file's pieces are packed again, same rule, into files of at most that many seconds, named
-- tex_<kind>_NNa, NNb, ...
Texture.SubSplit = { grains2 = { [7] = 2.2, [8] = 2.2, [9] = 2.2 } }
-- Clicks split (SplitSeconds.clicks = 2.0) keep tex_clicks_01 (the 500 Hz clicks and the short 1000 Hz ones). ClickRemap
-- says where the higher clicks come from, played faster (speed k = band / source band: the octave band and the decay
-- scale together; volume x sqrt(k) keeps the energy):
--   "low"    tex_clicks_low_NN: each one made in the 500 Hz band with a k times longer decay and played k times faster,
--            which puts it back in its own band and decay. Where each sits: Texture.ClickLow (click index -> { file,
--            start sample }). A click with no entry, or whose file has no id in Codec.Manifests.Files, plays as "reuse"
--            from the kept clicks and these.
--   "reuse"  another click sped up (the one whose decay comes closest): no extra files
--   nil      not split (tex_clicks_01..NN as packed)
Texture.ClickRemap = "low"
Texture.ClickLow = {
	[35] = { "tex_clicks_low_07", 4800 }, [36] = { "tex_clicks_low_07", 25792 }, [37] = { "tex_clicks_low_07", 46784 },
	[38] = { "tex_clicks_low_07", 55411 }, [39] = { "tex_clicks_low_08", 4800 }, [40] = { "tex_clicks_low_08", 13427 },
	[41] = { "tex_clicks_low_08", 29043 }, [42] = { "tex_clicks_low_08", 44659 }, [43] = { "tex_clicks_low_09", 4800 },
	[44] = { "tex_clicks_low_10", 4800 }, [45] = { "tex_clicks_low_03", 4800 },
}
local function hasId(name)
	local ok, files = pcall(function()
		return require(script.Parent:FindFirstChild("Manifests"):FindFirstChild("Files"))
	end)
	return ok and type(files) == "table" and (files[name] or "") ~= ""
end
local function buildLayout()
	-- same packing as the file maker: pieces in order, each after LEAD seconds of silence; a new file starts when the
	-- piece (and the silence that ends every file) would take the file past the kind's maximum length
	local L = {}
	local function packer(kind, lead)
		local maxFile = Texture.SplitSeconds[kind] or MAX_FILE
		local MAXS = maxFile * R
		local split = maxFile < 1e6 -- one file per kind (tex_<kind>), or files under maxFile s (tex_<kind>_NN)
		local sub = split and Texture.SubSplit[kind] or {}
		local LS = floor(lead * R)
		local file, pos = 1, 0
		local names = {}
		local cur, subN, subPos, subMax
		local function open(f)
			if sub[f] then
				subN, subPos, subMax = 1, 0, sub[f] * R
				cur = ("tex_%s_%02da"):format(kind, f)
			else
				subN = nil
				cur = split and ("tex_%s_%02d"):format(kind, f) or ("tex_" .. kind)
			end
			table.insert(names, cur)
		end
		open(1)
		return function(len)
			if split and pos > 0 and pos + LS + len + LS > MAXS then
				file += 1
				pos = 0
				open(file)
			end
			pos += LS
			local st = pos / R
			pos += len
			if subN then -- a finer-cut file: its own position, a new part when this one is full
				if subPos > 0 and subPos + LS + len + LS > subMax then
					subN += 1
					subPos = 0
					cur = ("tex_%s_%02d%s"):format(kind, file, string.char(96 + subN))
					table.insert(names, cur)
				end
				subPos += LS
				st = subPos / R
				subPos += len
			end
			return { file = cur, start = st }
		end, names
	end
	local put, names = packer("tones", LEAD.tones)
	L.tones = { lead = LEAD.tones, gain = GAIN.tones, where = {}, len = {}, files = names }
	for i, k in ipairs(SHAPES) do
		local len = shapeSamples(k[1], k[2], k[3])
		L.tones.where[i] = put(len)
		L.tones.len[i] = len / R
	end
	put, names = packer("clicks", LEAD.clicks)
	L.clicks = { lead = LEAD.clicks, gain = GAIN.clicks, where = {}, len = {}, files = names }
	for _, _c in ipairs(CB) do
		for _, tau in ipairs(TAUS) do
			for _ = 1, 3 do
				local len = floor(tau * 7 * R) + 64
				table.insert(L.clicks.where, put(len))
				table.insert(L.clicks.len, len / R)
			end
		end
	end
	-- clicks outside the kept file, played from elsewhere at a speed (Texture.ClickRemap)
	local mode = Texture.SplitSeconds.clicks and Texture.ClickRemap
	if mode then
		local C = L.clicks
		local keep = C.files[1]
		local lowNames = {}
		local own = {} -- click index -> { band, decay, variant } as it sits in its file (the clicks with a file of their own)
		local rest = {}
		local idx = 0
		for _, c in ipairs(CB) do
			for _, tau in ipairs(TAUS) do
				for v = 1, 3 do
					idx += 1
					if C.where[idx].file == keep then
						own[idx] = { c, tau, v }
					else
						local low = mode == "low" and Texture.ClickLow[idx]
						if low and hasId(low[1]) then -- made at 500 Hz with a k times longer decay, played k times faster
							local k = c / CB[1]
							local n = floor(tau * k * 7 * R) + 64
							if not table.find(lowNames, low[1]) then
								table.insert(lowNames, low[1])
							end
							C.where[idx] = { file = low[1], start = low[2] / R, speed = k, gain = math.sqrt(k), flen = n / R }
							own[idx] = { CB[1], tau * k, v }
						else
							table.insert(rest, { idx, c, tau, v })
						end
					end
				end
			end
		end
		-- the others: the click with a file of its own (same variant, band not above this one) whose decay, sped up to
		-- this band, comes closest
		for _, t in ipairs(rest) do
			local i, c, tau, v = t[1], t[2], t[3], t[4]
			local best, bestErr
			for j, o in pairs(own) do
				if o[3] == v and o[1] <= c then
					local err = math.abs(math.log(o[2] * o[1] / c / tau))
					if not bestErr or err < bestErr - 1e-9 or (math.abs(err - bestErr) <= 1e-9 and j < best) then
						best, bestErr = j, err
					end
				end
			end
			local w, k = C.where[best], c / own[best][1]
			C.where[i] = { file = w.file, start = w.start, speed = k, gain = math.sqrt(k), flen = w.flen or C.len[best] }
		end
		C.files = { keep }
		for _, nm in ipairs(lowNames) do
			table.insert(C.files, nm)
		end
	end
	put, names = packer("grains2", LEAD.grains)
	L.grains = { lead = LEAD.grains, K = K2, gain = GAIN2, g = {}, where = {}, files = names }
	for bi, band in ipairs(BANDS) do
		local g = floor(gReal2(band.c) * R)
		L.grains.g[bi] = gReal2(band.c)
		L.grains.where[bi] = {}
		for k = 1, K2 do
			L.grains.where[bi][k] = put(g)
		end
	end
	L.loop = { gain = GAIN.loop, len = LOOP_LEN, centre = LOOP_CENTRE, files = { "tex_loop" } }
	-- the upload files a clip needs, in order (Codec.Manifests preloads the same names). The grain files are only the
	-- fallback for when the tex_beds files can't load (TexturePlayer plays the noise bands as beds), so they are not
	-- required: L.grainFiles (a game without them still plays)
	L.allFiles = {}
	for _, kind in ipairs({ "tones", "clicks", "loop" }) do
		for _, nm in ipairs(L[kind].files) do
			table.insert(L.allFiles, nm)
		end
	end
	L.grainFiles = table.clone(L.grains.files)
	return L
end
Texture.LAYOUT = buildLayout()

-- ------------------------------------------------------------------ 6. top cutoff
local function topCutoff(x, n)
	local N, H = 4096, 2048
	local w = hann(N, true)
	local len = max(n, N)
	local K = N // 2 + 1
	local p = table.create(K, 0)
	local re, im = table.create(N, 0), table.create(N, 0)
	local cnt = 0
	local s = 0
	while s <= len - N do
		for i = 1, N do
			local xi = s + i
			re[i] = (xi <= n) and x[xi] * w[i] or 0
			im[i] = 0
		end
		FFT.transform(re, im)
		for k = 1, K do
			p[k] += re[k] * re[k] + im[k] * im[k]
		end
		cnt += 1
		s += H
	end
	local L = table.create(K)
	for k = 1, K do
		L[k] = 10 * log10(p[k] / cnt + 1e-20)
	end
	local function lv(q)
		local a, b = q / 2 ^ (1 / 12), q * 2 ^ (1 / 12)
		local sum, c = 0, 0
		for k = 1, K do
			local f = (k - 1) * R / N
			if f >= a and f <= b then
				sum += L[k]
				c += 1
			end
		end
		return sum / c
	end
	local q = 3000.0
	while q * 2 ^ (1 / 3) < 20000 do
		if lv(q * 2 ^ (1 / 3)) < lv(q) - 15 then
			return min(q * 2 ^ (1 / 6), 7800)
		end
		q *= 2 ^ (1 / 24)
	end
	return 7800
end

-- ------------------------------------------------------------------ the encoder
local LOW_AS_NOISE = 400.0
-- x: mono samples at 48 kHz (array, 1-indexed). Returns the encoded table.
function Texture.analyse(x, options)
	options = options or {}
	Y.fn = options.Yield
	Y.slice = os.clock()
	local progress = options.Progress or function() end
	local n = #x
	local rng = Prng.new(1)
	progress("split", 0)
	local xt, xn = split(x, n)
	progress("clicks", 0.25)
	local clicks = detectClicks(xn, n)
	local yc = clicksWave(clicks, n)
	local low = filtfilt(LP400_SOS, xt, n)
	local target = table.create(n)
	for i = 1, n do
		target[i] = xn[i] + low[i]
	end
	local noise = target -- (the bubble checks compare against the noise part: what no tone explains)
	progress("tones", 0.35)
	local Mx = peakMap(x, n)
	local P3 = peak3(Mx)
	local sds = seeds(x, n)
	local cands = {}
	for q, sd in ipairs(sds) do
		local b = fit(Mx, P3, sd)
		if b then
			table.insert(cands, b)
		end
		progress("tones", 0.35 + 0.4 * q / #sds)
	end
	cands = dedupe(cands)
	progress("checks", 0.75)
	local kept = {}
	local cur = table.clone(noise)
	for _, b in ipairs(cands) do -- (dedupe returns them strongest first)
		if gainDb(x, cur, n, b) > ACCEPT_DB and surrogateDb(x, n, b, rng) > COHERENT_DB then
			table.insert(kept, b)
			addBubble(cur, n, b)
		end
	end
	-- grains follow the whole sound, minus what the clicks and the kept bubbles carry
	progress("grains", 0.85)
	local minus = table.clone(yc)
	for _, b in ipairs(kept) do
		addBubble(minus, n, b)
	end
	local vols = grainLevels2(x, minus, n)
	progress("done", 1)
	return { n = n, fc = topCutoff(x, n), bubbles = kept, clicks = clicks, grains = vols, candidates = #cands }
end

-- ------------------------------------------------------------------ RBA4 bytes
-- header: "RBA4" u8 version u8 bands u16 reserved | u32 samples (48 kHz) | f32 fc | u16 bubbles u16 clicks
-- bubble: u32 t, u8 shape, f32 speed, f32 amp     click: u32 t, u8 band, u8 tau, u8 var, f32 amp
-- per band: u32 count, then count u8 volume codes (0 = silent; else 10^((q - 220) * 0.4 / 20))
local function volCode(v)
	if v <= 0 then
		return 0
	end
	local q = floor(20 * log10(v) / 0.4 + 220 + 0.5)
	return math.clamp(q, 1, 255)
end
local VOL = table.create(256, 0)
for q = 1, 255 do
	VOL[q + 1] = 10 ^ ((q - 220) * 0.4 / 20)
end
function Texture.pack(enc)
	local size = 20 + #enc.bubbles * 13 + #enc.clicks * 11
	for _, v in ipairs(enc.grains) do
		size += 4 + #v
	end
	local b = buffer.create(size)
	buffer.writestring(b, 0, "RBA4")
	buffer.writeu8(b, 4, Texture.Version)
	buffer.writeu8(b, 5, #enc.grains)
	buffer.writeu32(b, 8, enc.n)
	buffer.writef32(b, 12, enc.fc)
	buffer.writeu16(b, 16, #enc.bubbles)
	buffer.writeu16(b, 18, #enc.clicks)
	local o = 20
	for _, e in ipairs(enc.bubbles) do
		buffer.writeu32(b, o, e.t)
		buffer.writeu8(b, o + 4, e.shape)
		buffer.writef32(b, o + 5, e.speed)
		buffer.writef32(b, o + 9, e.amp)
		o += 13
	end
	for _, e in ipairs(enc.clicks) do
		buffer.writeu32(b, o, e.t)
		buffer.writeu8(b, o + 4, e.band)
		buffer.writeu8(b, o + 5, e.tau)
		buffer.writeu8(b, o + 6, e.var)
		buffer.writef32(b, o + 7, e.amp)
		o += 11
	end
	for _, v in ipairs(enc.grains) do
		buffer.writeu32(b, o, #v)
		o += 4
		for k = 1, #v do
			buffer.writeu8(b, o, volCode(v[k]))
			o += 1
		end
	end
	return b
end
function Texture.isClip(bytes)
	local b = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	return buffer.len(b) >= 20 and buffer.readstring(b, 0, 4) == "RBA4"
end
function Texture.unpack(bytes)
	local b = type(bytes) == "string" and buffer.fromstring(bytes) or bytes
	assert(buffer.readstring(b, 0, 4) == "RBA4", "not an RBA4 clip")
	local clip = { version = 4, texture = true, bankVersion = 0 }
	if buffer.readu8(b, 4) < Texture.Version then
		error("this texture clip was made by an older version of the converter: import the sound again", 0)
	end
	local nb = buffer.readu8(b, 5)
	clip.n = buffer.readu32(b, 8)
	clip.duration = clip.n / R
	clip.fc = buffer.readf32(b, 12)
	local nbub, ncl = buffer.readu16(b, 16), buffer.readu16(b, 18)
	local o = 20
	clip.bubbles = table.create(nbub)
	for i = 1, nbub do
		clip.bubbles[i] = { t = buffer.readu32(b, o), shape = buffer.readu8(b, o + 4), speed = buffer.readf32(b, o + 5),
			amp = buffer.readf32(b, o + 9) }
		o += 13
	end
	clip.clicks = table.create(ncl)
	for i = 1, ncl do
		clip.clicks[i] = { t = buffer.readu32(b, o), band = buffer.readu8(b, o + 4), tau = buffer.readu8(b, o + 5),
			var = buffer.readu8(b, o + 6), amp = buffer.readf32(b, o + 7) }
		o += 11
	end
	clip.grains = table.create(nb)
	for bi = 1, nb do
		local cnt = buffer.readu32(b, o)
		o += 4
		local v = table.create(cnt)
		for k = 1, cnt do
			v[k] = VOL[buffer.readu8(b, o) + 1]
			o += 1
		end
		clip.grains[bi] = v
	end
	return clip
end

-- signal (DSP.Signal: { sampleRate, channels, length, data = { buffer f32 per channel } }) -> RBA4 bytes, stats
function Texture.encode(signal, options)
	options = options or {}
	local t0 = os.clock()
	local n, ch = signal.length, signal.channels
	local mono = table.create(n, 0)
	for c = 1, ch do
		local d = signal.data[c]
		for i = 0, n - 1 do
			mono[i + 1] += buffer.readf32(d, i * 4) / ch
		end
	end
	Y.fn = options.Yield
	Y.slice = os.clock()
	local x = resample48(mono, signal.sampleRate)
	local enc = Texture.analyse(x, options)
	local bytes = Texture.pack(enc)
	local starts = 0
	for _, v in ipairs(enc.grains) do
		for k = 1, #v do
			if v[k] > 0 then
				starts += 1
			end
		end
	end
	return bytes, {
		bytes = buffer.len(bytes), seconds = n / signal.sampleRate, encodeTime = os.clock() - t0, format = "texture",
		bubbles = #enc.bubbles, candidates = enc.candidates, clicks = #enc.clicks, grainStarts = starts, fc = enc.fc,
	}
end

return Texture
