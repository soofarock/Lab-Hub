-- AV1 constant tables: default probabilities, scan orders, filter taps and lookups.
-- Each table is a 1-based array; multi-dimensional tables are stored row-major.
local ALPH = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz+/"
local DEC = {}
for i = 1, 64 do DEC[string.byte(ALPH, i)] = i - 1 end
local function unpack(s)
	local t, n, z, sh = {}, 0, 0, 1
	for i = 1, #s do
		local d = DEC[string.byte(s, i)]
		if d >= 32 then
			z += (d - 32) * sh
			n += 1
			t[n] = if z % 2 == 0 then z // 2 else -(z + 1) // 2
			z, sh = 0, 1
		else
			z += d * sh
			sh *= 32
		end
	end
	return t
end
