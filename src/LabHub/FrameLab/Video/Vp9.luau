local NORM = table.create(256, 0)
for i = 1, 255 do
	local s = 0
	while lshift(i, s) < 128 do
		s += 1
	end
	NORM[i + 1] = s
end
local POW2 = table.create(64, 0)
for i = 0, 63 do
	POW2[i + 1] = 2 ^ i
end

-- C's integer division (towards zero)
local function idiv(a, b)
	local q = a / b
	if q >= 0 then
		return floor(q)
	end
	return -floor(-q)
end

