local function invRecenter(v, m)
	if v > 2 * m then
		return v
	end
	if band(v, 1) == 1 then
		return m - rshift(v + 1, 1)
	end
	return m + rshift(v, 1)
end

local function diffUpdate(r, probs, i)
	if r:read(252) == 1 then
		local delp
		if r:read(128) == 0 then
			delp = r:literal(4)
		elseif r:read(128) == 0 then
			delp = r:literal(4) + 16
		elseif r:read(128) == 0 then
			delp = r:literal(5) + 32
		else
			local v = r:literal(7)
			if v >= 65 then
				v = v * 2 - 65 + r:read(128)
			end
			delp = v + 64
		end
		local m = probs[i]
		local v = INV_MAP[delp + 1]
		m -= 1
		if m * 2 <= 255 then
			probs[i] = 1 + invRecenter(v, m)
		else
			probs[i] = 255 - invRecenter(v, 255 - 1 - m)
		end
	end
end

local function getProb(num, den)
	local p = (num * 256 + rshift(den, 1)) // den
	if p > 255 then
		return 255
	elseif p == 0 then
		return 1
	end
	return p
end

local function weighted(p1, p2, factor)
	return rshift(p1 * (256 - factor) + p2 * factor + 128, 8)
end

local COUNT_TO_FACTOR = { 0, 6, 12, 19, 25, 32, 38, 44, 51, 57, 64, 70, 76, 83, 89, 96, 102, 108, 115, 121, 128 }
local function mergeModeMv(pre, c0, c1)
	local den = c0 + c1
	if den == 0 then
		return pre
	end
	return weighted(pre, getProb(c0, den), COUNT_TO_FACTOR[min(den, 20) + 1])
end

-- tree adaptation (vpx_tree_merge_probs): counts [base + leaf + 1]
local function treeMerge(tree, pre, preBase, counts, cBase, probs)
	local function walk(i)
		local l = tree[i + 1]
		local lc = l <= 0 and counts[cBase - l + 1] or walk(l)
		local r = tree[i + 2]
		local rc = r <= 0 and counts[cBase - r + 1] or walk(r)
		probs[preBase + rshift(i, 1) + 1] = mergeModeMv(pre[preBase + rshift(i, 1) + 1], lc, rc)
		return lc + rc
	end
	walk(0)
end


