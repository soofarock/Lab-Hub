--!native
--!optimize 2
-- VP9 video decoder (profile 0: 8-bit 4:2:0), for WebM / IVF video. Every tool of the format: key, inter and hidden
-- (alt-ref) frames, superframes, compound prediction, segmentation, tiles, lossless, switchable filters, backward
-- probability adaptation and the loop filter; its output matches the reference decoder (libvpx) exactly. Profiles 1 -
-- 3 (4:4:4, more than 8 bits) and references at another size than the frame (resizing streams) are refused with a
-- message. Written from libvpx's decoder (BSD licence, Copyright the WebM project authors).
--
--   local dec = Vp9.new()
--   local pic = dec:decodeSample(buf, pos, len)   -- one WebM block / IVF frame -> the picture it shows, or nil (a
--                                                 -- hidden frame); a superframe's frames are decoded in turn
--   pic.Y, pic.U, pic.V (planes), pic.ys / pic.cs (strides), pic.yo / pic.co (offset of pixel 0,0),
--   dec.width, dec.height, dec.cropX, dec.cropY (0), dec.fullRange, dec.bt709 - as Video.H264's decoder, so
--   Tools.ImportJob.yuvToImage reads either. The planes are valid until the next decodeSample call.

local band, bor, bxor, rshift, lshift, arshift = bit32.band, bit32.bor, bit32.bxor, bit32.rshift, bit32.lshift, bit32.arshift
local readu8, writeu8 = buffer.readu8, buffer.writeu8
local floor, min, max, abs = math.floor, math.min, math.max, math.abs

local Vp9 = {}

local function fail(msg)
	error("VP9: " .. msg, 0)
end

local lastYield = os.clock()
local function breathe()
	if task and os.clock() - lastYield > 0.05 then
		task.wait()
		lastYield = os.clock()
	end
end

local function hexBytes(s)
	local t = table.create(#s // 2)
	for i = 1, #s, 2 do
		t[(i + 1) // 2] = tonumber(string.sub(s, i, i + 1), 16)
	end
	return t
end
local function hexWords(s)
	local t = table.create(#s // 4)
	for i = 1, #s, 4 do
		local v = tonumber(string.sub(s, i, i + 3), 16)
		if v >= 32768 then
			v -= 65536
		end
		t[(i + 3) // 4] = v
	end
	return t
end

