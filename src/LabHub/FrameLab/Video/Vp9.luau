			D(0, 3, v)
			v = avg3(a2, a3, a4)
			D(2, 1, v)
			D(1, 3, v)
			v = avg3(a3, a4, a5)
			D(3, 1, v)
			D(2, 3, v)
			D(3, 3, avg3(a4, a5, a6))
		elseif mode == D45_PRED then
			D(0, 0, avg3(a0, a1, a2))
			local v = avg3(a1, a2, a3)
			D(1, 0, v)
			D(0, 1, v)
			v = avg3(a2, a3, a4)
			D(2, 0, v)
			D(1, 1, v)
			D(0, 2, v)
			v = avg3(a3, a4, a5)
			D(3, 0, v)
			D(2, 1, v)
			D(1, 2, v)
			D(0, 3, v)
			v = avg3(a4, a5, a6)
			D(3, 1, v)
			D(2, 2, v)
			D(1, 3, v)
			v = avg3(a5, a6, a7)
			D(3, 2, v)
			D(2, 3, v)
			D(3, 3, a7)
		elseif mode == D117_PRED then
			local v = avg2(X, a0)
			D(0, 0, v)
			D(1, 2, v)
			v = avg2(a0, a1)
			D(1, 0, v)
			D(2, 2, v)
			v = avg2(a1, a2)
			D(2, 0, v)
			D(3, 2, v)
			D(3, 0, avg2(a2, a3))
			D(0, 3, avg3(K, J, I))
			D(0, 2, avg3(J, I, X))
			v = avg3(I, X, a0)
			D(0, 1, v)
			D(1, 3, v)
			v = avg3(X, a0, a1)
			D(1, 1, v)
			D(2, 3, v)
			v = avg3(a0, a1, a2)
			D(2, 1, v)
			D(3, 3, v)
			D(3, 1, avg3(a1, a2, a3))
		elseif mode == D135_PRED then
			D(0, 3, avg3(J, K, L))
			local v = avg3(I, J, K)
			D(1, 3, v)
			D(0, 2, v)
			v = avg3(X, I, J)
			D(2, 3, v)
			D(1, 2, v)
			D(0, 1, v)
			v = avg3(a0, X, I)
			D(3, 3, v)
			D(2, 2, v)
			D(1, 1, v)
			D(0, 0, v)
			v = avg3(a1, a0, X)
			D(3, 2, v)
			D(2, 1, v)
			D(1, 0, v)
			v = avg3(a2, a1, a0)
			D(3, 1, v)
			D(2, 0, v)
			D(3, 0, avg3(a3, a2, a1))
		else -- D153
			local v = avg2(I, X)
			D(0, 0, v)
			D(2, 1, v)
			v = avg2(J, I)
			D(0, 1, v)
			D(2, 2, v)
			v = avg2(K, J)
			D(0, 2, v)
			D(2, 3, v)
			D(0, 3, avg2(L, K))
			D(3, 0, avg3(a0, a1, a2))
			D(2, 0, avg3(X, a0, a1))
			v = avg3(I, X, a0)
			D(1, 0, v)
			D(3, 1, v)
			v = avg3(J, I, X)
			D(1, 1, v)
			D(3, 2, v)
			v = avg3(K, J, I)
			D(1, 2, v)
			D(3, 3, v)
			D(1, 3, avg3(L, K, J))
		end
		for y = 0, 3 do
			for x = 0, 3 do
				writeu8(dst, off + y * s + x, o[y * 4 + x + 1])
			end
		end
	else
		-- the generic directional predictors (8 x 8 and larger)
		local function P(x, y, v)
			writeu8(dst, off + y * s + x, v)
		end
		local function G(x, y)
			return readu8(dst, off + y * s + x)
		end
		local function above(i)
			return AL[A + i]
		end
		local function left(i)
			return LC[i + 1]
		end
		if mode == D207_PRED then
			for r = 0, bs - 2 do
				P(0, r, avg2(left(r), left(r + 1)))
			end
			P(0, bs - 1, left(bs - 1))
			for r = 0, bs - 3 do
				P(1, r, avg3(left(r), left(r + 1), left(r + 2)))
			end
			P(1, bs - 2, avg3(left(bs - 2), left(bs - 1), left(bs - 1)))
			P(1, bs - 1, left(bs - 1))
			for c = 0, bs - 3 do
				P(2 + c, bs - 1, left(bs - 1))
			end
			for r = bs - 2, 0, -1 do
				for c = 0, bs - 3 do
					P(2 + c, r, G(2 + c - 2, r + 1))
				end
			end
		elseif mode == D63_PRED then
			for c = 0, bs - 1 do
				P(c, 0, avg2(above(c), above(c + 1)))
				P(c, 1, avg3(above(c), above(c + 1), above(c + 2)))
			end
			local size = bs - 2
			for r = 2, bs - 1, 2 do
				for c = 0, size - 1 do
					P(c, r, G(c + rshift(r, 1), 0))
				end
				for c = size, bs - 1 do
					P(c, r, above(bs - 1))
				end
				for c = 0, size - 1 do
					P(c, r + 1, G(c + rshift(r, 1), 1))
				end
				for c = size, bs - 1 do
					P(c, r + 1, above(bs - 1))
				end
				size -= 1
			end
		elseif mode == D45_PRED then
			local ar = above(bs - 1)
			for x = 0, bs - 2 do
				P(x, 0, avg3(above(x), above(x + 1), above(x + 2)))
			end
			P(bs - 1, 0, ar)
			local size = bs - 2
			for x = 1, bs - 1 do
				for c = 0, size - 1 do
					P(c, x, G(x + c, 0))
				end
				for c = size, bs - 1 do
					P(c, x, ar)
				end
				size -= 1
			end
		elseif mode == D117_PRED then
			for c = 0, bs - 1 do
				P(c, 0, avg2(above(c - 1), above(c)))
			end
			P(0, 1, avg3(left(0), above(-1), above(0)))
			for c = 1, bs - 1 do
				P(c, 1, avg3(above(c - 2), above(c - 1), above(c)))
			end
			P(0, 2, avg3(above(-1), left(0), left(1)))
			for r = 3, bs - 1 do
				P(0, r, avg3(left(r - 3), left(r - 2), left(r - 1)))
			end
			for r = 2, bs - 1 do
				for c = 1, bs - 1 do
					P(c, r, G(c - 1, r - 2))
				end
			end
		elseif mode == D135_PRED then
			local border = {}
			for i = 0, bs - 3 do
				border[i] = avg3(left(bs - 3 - i), left(bs - 2 - i), left(bs - 1 - i))
			end
			border[bs - 2] = avg3(above(-1), left(0), left(1))
			border[bs - 1] = avg3(left(0), above(-1), above(0))
			border[bs] = avg3(above(-1), above(0), above(1))
			for i = 0, bs - 3 do
				border[bs + 1 + i] = avg3(above(i), above(i + 1), above(i + 2))
			end
			for i = 0, bs - 1 do
				for c = 0, bs - 1 do
					P(c, i, border[bs - 1 - i + c])
				end
			end
		else -- D153
			P(0, 0, avg2(above(-1), left(0)))
			for r = 1, bs - 1 do
				P(0, r, avg2(left(r - 1), left(r)))
			end
			P(1, 0, avg3(left(0), above(-1), above(0)))
			P(1, 1, avg3(above(-1), left(0), left(1)))
			for r = 2, bs - 1 do
				P(1, r, avg3(left(r - 2), left(r - 1), left(r)))
			end
			for c = 0, bs - 3 do
				P(2 + c, 0, avg3(above(c - 1), above(c), above(c + 1)))
			end
			for r = 1, bs - 1 do
				for c = 0, bs - 3 do
					P(2 + c, r, G(2 + c - 2, r - 1))
				end
			end
		end
	end
end

