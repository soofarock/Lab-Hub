------------------------------------------------------------------------------------------------------------------------
-- frames

local LITERAL_TO_FILTER = { 1, 0, 2, 3 }

-- a frame buffer to decode into: one no reference (and not the previous frame) still holds, of this size
function Decoder:takeFrame(w, h)
	local used = {}
	for i = 0, 7 do
		local f = self.refMap[i]
		if f then
			used[f] = true
		end
	end
	if self.prevFrame then
		used[self.prevFrame] = true
	end
	local pool = self.pool
	for i = #pool, 1, -1 do
		local f = pool[i]
		if not used[f] then
			if f.w == w and f.h == h then
				return f
			end
			table.remove(pool, i)
		end
	end
	local f = newFrame(w, h)
	table.insert(pool, f)
	return f
end

local function readSyncCode(rb)
	if rb.literal(8) ~= 0x49 or rb.literal(8) ~= 0x83 or rb.literal(8) ~= 0x42 then
		fail("broken data (sync code)")
	end
end

local function tileOffset(i, mis, log2)
	local sbs = (mis + 7) // 8
	return min(lshift(rshift(i * sbs, log2), 3), mis)
end

-- one frame (not a superframe); returns the frame it shows, or nil
function Decoder:decodeFrame(buf, pos, size)
	local rb = bitReader(buf, pos, size)
	self.lastFrameType = self.frameType
	self.lastIntraOnly = self.intraOnly
	if rb.literal(2) ~= 2 then
		fail("not a VP9 frame (frame marker)")
	end
	local profile = rb.read() + rb.read() * 2
	if profile > 2 then
		profile += rb.read()
	end
	if profile ~= 0 then
		fail(("only VP9 profile 0 (8-bit 4:2:0) is supported; this video is profile %d"):format(profile))
	end
	if rb.read() == 1 then
		local f = self.refMap[rb.literal(3)]
		if not f then
			fail("broken data (shows a frame that was never decoded)")
		end
		return f
	end
	self.frameType = rb.read()
	self.showFrame = rb.read() == 1
	self.errorRes = rb.read() == 1
	local refresh
	local width, height
	if self.frameType == 0 then
		readSyncCode(rb)
		local cs = rb.literal(3)
		if cs == 7 then
			fail("RGB (sRGB) VP9 is not supported")
		end
		self.fullRange = rb.read() == 1
		self.bt709 = cs == 2
		refresh = 0xff
		width, height = rb.literal(16) + 1, rb.literal(16) + 1
		self:setSize(width, height)
		if rb.read() == 1 then
			rb.literal(32)
		end
		self.intraFrame = true
		self.haveKey = true
	else
		self.intraOnly = (not self.showFrame) and rb.read() == 1
		self.resetContext = self.errorRes and 0 or rb.literal(2)
		if self.intraOnly then
			readSyncCode(rb)
			self.fullRange, self.bt709 = false, false
			refresh = rb.literal(8)
			width, height = rb.literal(16) + 1, rb.literal(16) + 1
			self:setSize(width, height)
			if rb.read() == 1 then
				rb.literal(32)
			end
			self.intraFrame = true
		else
			if not self.haveKey then
				fail("the video does not start with a key frame")
			end
			refresh = rb.literal(8)
			local refs = self.refs
			for i = 1, 3 do
				local f = self.refMap[rb.literal(3)]
				if not f then
					fail("broken data (a missing reference frame)")
				end
				refs[i] = f
				self.signBias[i] = rb.read()
			end
			local found = false
			for i = 1, 3 do
				if rb.read() == 1 then
					width, height = refs[i].w, refs[i].h
					found = true
					break
				end
			end
			if not found then
				width, height = rb.literal(16) + 1, rb.literal(16) + 1
			end
			self:setSize(width, height)
			if rb.read() == 1 then
				rb.literal(32)
			end
			self.allowHp = rb.read() == 1
			self.interpFilter = rb.read() == 1 and 4 or LITERAL_TO_FILTER[rb.literal(2) + 1]
			self.intraFrame = false
		end
	end
	local headerSize = self:readTail(rb, self.intraFrame)
	local dataPos = pos + rb.bytes()
	local stop = pos + size
	if dataPos + headerSize > stop then
		fail("the frame is cut off")
	end

	-- this frame's state
	D = self
	intraFrame = self.intraFrame
	miCols, miRows = self.miCols, self.miRows
	usePrev = not self.errorRes and width == self.lastWidth and height == self.lastHeight and not self.lastIntraOnly
		and self.lastShowFrame and self.lastFrameType ~= 0 and self.prevFrame ~= nil
	prevFrame = self.prevFrame
	refFrames = self.refs
	fc = cloneContext(self.contexts[self.contextIdx + 1])
	self.fc = fc
	self.intraOnlyFrame = intraFrame
	self:readCompressedHeader(buf, dataPos, headerSize)

	cur = self:takeFrame(width, height)
	local sbCols, sbRows = (miCols + 7) // 8, (miRows + 7) // 8
	grid = table.create(miCols * miRows)
	counts = (not self.errorRes and not self.parallel) and newCounts() or nil

	-- loop filter levels
	local lf = self.lf
	lfOn = lf.level > 0
	lfStride = sbCols * 8
	if lfOn then
		if lf.lastSharpness ~= lf.sharpness then
			updateSharpness(lf.sharpness)
			lf.lastSharpness = lf.sharpness
		end
		local n = lfStride * sbRows * 8
		local nu = n // 4
		if not self.lfY or #self.lfY.lvl ~= n then
			self.lfY = { lvl = table.create(n, 0), left = table.create(n, 0), above = table.create(n, 0), int4 = table.create(n, false),
				leftUV = table.create(nu, 0), aboveUV = table.create(nu, 0), int4UV = table.create(nu, false) }
		else
			local t = self.lfY
			for i = 1, n do
				t.lvl[i], t.left[i], t.above[i], t.int4[i] = 0, 0, 0, false
			end
			for i = 1, nu do
				t.leftUV[i], t.aboveUV[i], t.int4UV[i] = 0, 0, false
			end
		end
		local t = self.lfY
		lvlY, leftY, aboveY, int4Y, leftUV, aboveUV, int4UV = t.lvl, t.left, t.above, t.int4, t.leftUV, t.aboveUV, t.int4UV
		lvlTable = table.create(64, 0)
		local scale = lshift(1, rshift(lf.level, 5))
		local seg = self.seg
		for s = 0, 7 do
			local lvlSeg = lf.level
			if seg.enabled and seg.features[s][2] then
				local d = seg.data[s][2]
				lvlSeg = math.clamp(seg.absDelta and d or lf.level + d, 0, 63)
			end
			if not lf.deltaEnabled then
				for k = 1, 8 do
					lvlTable[s * 8 + k] = lvlSeg
				end
			else
				lvlTable[s * 8 + 1] = math.clamp(lvlSeg + lf.refDeltas[0] * scale, 0, 63)
				for ref = 1, 3 do
					for mode = 0, 1 do
						lvlTable[s * 8 + ref * 2 + mode + 1] =
							math.clamp(lvlSeg + lf.refDeltas[ref] * scale + lf.modeDeltas[mode] * scale, 0, 63)
					end
				end
			end
		end
	end

	-- the tiles
	local tileCols, tileRows = lshift(1, self.log2TileCols), lshift(1, self.log2TileRows)
	local p = dataPos + headerSize
	local tiles = {}
	for tr = 0, tileRows - 1 do
		for tc = 0, tileCols - 1 do
			local last = tr == tileRows - 1 and tc == tileCols - 1
			local tsize
			if last then
				tsize = stop - p
			else
				if p + 4 > stop then
					fail("the frame is cut off (tile size)")
				end
				tsize = buffer.readu8(buf, p) * 16777216 + buffer.readu8(buf, p + 1) * 65536 + buffer.readu8(buf, p + 2) * 256
					+ buffer.readu8(buf, p + 3)
				p += 4
				if tsize > stop - p then
					fail("the frame is cut off (tile)")
				end
			end
			tiles[tr * tileCols + tc + 1] = { p, tsize }
			p += tsize
		end
	end
	aboveCtx = { [0] = table.create(sbCols * 16 + 16, 0), table.create(sbCols * 8 + 16, 0), table.create(sbCols * 8 + 16, 0) }
	for k = 0, 2 do
		local a = aboveCtx[k]
		a[0] = 0
	end
	aboveSeg = table.create(sbCols * 8 + 8, 0)
	aboveSeg[0] = 0
	leftCtx = { [0] = table.create(16, 0), table.create(16, 0), table.create(16, 0) }
	leftSeg = table.create(8, 0)
	local readers = {}
	for tr = 0, tileRows - 1 do
		local rowStart, rowEnd = tileOffset(tr, miRows, self.log2TileRows), tileOffset(tr + 1, miRows, self.log2TileRows)
		for tc = 0, tileCols - 1 do
			local t = tiles[tr * tileCols + tc + 1]
			readers[tc] = newReader(buf, t[1], t[2])
		end
		for miRow = rowStart, rowEnd - 1, 8 do
			for tc = 0, tileCols - 1 do
				R = readers[tc]
				tileStart, tileEnd = tileOffset(tc, miCols, self.log2TileCols), tileOffset(tc + 1, miCols, self.log2TileCols)
				for k = 0, 2 do
					local l = leftCtx[k]
					for i = 0, 15 do
						l[i] = 0
					end
				end
				for i = 0, 7 do
					leftSeg[i] = 0
				end
				for miCol = tileStart, tileEnd - 1, 8 do
					decodePartition(miRow, miCol, BLOCK_64X64, 4)
				end
			end
			breathe()
		end
	end

	if lfOn then
		loopFilterFrame(cur)
	end

	-- backward adaptation
	if not self.errorRes and not self.parallel then
		local pre = self.contexts[self.contextIdx + 1]
		adaptCoef(fc, pre, counts, intraFrame, self.lastFrameType == 0)
		if not intraFrame then
			adaptMode(fc, pre, counts, self.interpFilter == 4, self.txMode == 4)
			adaptMv(fc, pre, counts, self.allowHp)
		end
	end
	if self.refreshContext then
		self.contexts[self.contextIdx + 1] = fc
	end
	for i = 0, 7 do
		if band(refresh, lshift(1, i)) ~= 0 then
			self.refMap[i] = cur
		end
	end
	self.lastShowFrame = self.showFrame
	self.prevFrame = cur
	if self.seg.enabled then
		self.lastSegMap, self.curSegMap = self.curSegMap, self.lastSegMap
	end
	self.lastWidth, self.lastHeight = width, height
	local shown = self.showFrame and cur or nil
	-- (drop references the next frame must not see)
	grid, cur, prevFrame, refFrames, R, counts = nil, nil, nil, nil, nil, nil
	return shown
end

-- one WebM block / IVF frame: a frame or a superframe (several frames, normally all but the last hidden)
local function decodeSample(self, buf, pos, len)
	if len < 1 then
		fail("an empty frame")
	end
	local marker = readu8(buf, pos + len - 1)
	local shown
	if band(marker, 0xe0) == 0xc0 then
		local frames = band(marker, 7) + 1
		local mag = band(rshift(marker, 3), 3) + 1
		local indexSize = 2 + mag * frames
		if len >= indexSize and readu8(buf, pos + len - indexSize) == marker then
			local p = pos + len - indexSize + 1
			local at = pos
			local stop = pos + len - indexSize
			for _ = 1, frames do
				local sz = 0
				for b = 0, mag - 1 do
					sz += readu8(buf, p + b) * POW2[b * 8 + 1]
				end
				p += mag
				if sz > stop - at then
					fail("broken data (superframe index)")
				end
				if sz > 0 then
					local f = self:decodeFrame(buf, at, sz)
					if f then
						shown = f
					end
				end
				at += sz
			end
			return shown
		end
	end
	return self:decodeFrame(buf, pos, len)
end

-- one frame at a time in a Luau VM: the decoding state lives in this module, and a frame pauses midway (breathe), so a
-- second decoder (another import worker in the same VM) waits for the frame being made to finish
local holder
local function decodeLocked(fn, ...)
	local me = coroutine.running()
	if task then
		while holder and holder ~= me and coroutine.status(holder) ~= "dead" do
			task.wait()
		end
	end
	holder = me
	local ok, pic = pcall(fn, ...)
	holder = nil
	if not ok then
		error(pic, 0)
	end
	return pic
end

function Decoder:decodeSample(buf, pos, len)
	pos = pos or 0
	len = len or buffer.len(buf) - pos
	return decodeLocked(decodeSample, self, buf, pos, len)
end

return Vp9

