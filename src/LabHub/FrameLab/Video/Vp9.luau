-- inter prediction (motion compensation): the reference is read as if edge-extended without end (its visible size)

local KERNELS = { [0] = T.FILTER_REGULAR, T.FILTER_SMOOTH, T.FILTER_SHARP, T.FILTER_BILINEAR }
local WS = 80 -- the edge window's stride
local winBuf = buffer.create(WS * 72)
local mid = table.create(71 * 64, 0)

-- predict a w x h block at (x0, y0) + subpel (sx, sy in 1/16) from ref (plane, stride, visible fw x fh) into dst;
-- avg: average with what dst holds (the second reference of a compound block)
local function predictInter(ref: buffer, rs: number, fw: number, fh: number, x0: number, y0: number, sx: number, sy: number,
	w: number, h: number, kernel, dst: buffer, doff: number, ds: number, avg: boolean)
	local src: buffer, ss: number, base: number
	local ex0, ey0, ex1, ey1 = 0, 0, 0, 0
	if sx ~= 0 then
		ex0, ex1 = 3, 4
	end
	if sy ~= 0 then
		ey0, ey1 = 3, 4
	end
	if x0 - ex0 >= 0 and y0 - ey0 >= 0 and x0 + w - 1 + ex1 < fw and y0 + h - 1 + ey1 < fh then
		src, ss, base = ref, rs, y0 * rs + x0
	else
		-- copy the area (3 before, 4 after) with its coordinates clamped to the picture
		src, ss, base = winBuf, WS, 3 * WS + 3
		local fw1, fh1 = fw - 1, fh - 1
		for yy = 0, h + 6 do
			local y = y0 - 3 + yy
			y = math.clamp(y, 0, fh1)
			local rowOff = y * rs
			local o = yy * WS
			local xa = x0 - 3
			if xa >= 0 and xa + w + 6 <= fw1 then
				buffer.copy(winBuf, o, ref, rowOff + xa, w + 7)
			else
				for xx = 0, w + 6 do
					local x = xa + xx
					x = math.clamp(x, 0, fw1)
					writeu8(winBuf, o + xx, readu8(ref, rowOff + x))
				end
			end
		end
	end
	if sx == 0 and sy == 0 then
		if not avg then
			for r = 0, h - 1 do
				buffer.copy(dst, doff + r * ds, src, base + r * ss, w)
			end
		else
			for r = 0, h - 1 do
				local s, p = base + r * ss, doff + r * ds
				for c = 0, w - 1 do
					writeu8(dst, p + c, rshift(readu8(dst, p + c) + readu8(src, s + c) + 1, 1))
				end
			end
		end
		return
	end
	if sy == 0 then
		local fx = sx * 8
		local k0, k1, k2, k3, k4, k5, k6, k7 = kernel[fx + 1], kernel[fx + 2], kernel[fx + 3], kernel[fx + 4], kernel[fx + 5],
			kernel[fx + 6], kernel[fx + 7], kernel[fx + 8]
		for r = 0, h - 1 do
			local q = base + r * ss - 3
			local p = doff + r * ds
			for c = 0, w - 1 do
				local sum = readu8(src, q) * k0 + readu8(src, q + 1) * k1 + readu8(src, q + 2) * k2 + readu8(src, q + 3) * k3
					+ readu8(src, q + 4) * k4 + readu8(src, q + 5) * k5 + readu8(src, q + 6) * k6 + readu8(src, q + 7) * k7 + 64
				local v = math.clamp(sum // 128, 0, 255)
				if avg then
					v = rshift(readu8(dst, p + c) + v + 1, 1)
				end
				writeu8(dst, p + c, v)
				q += 1
			end
		end
		return
	end
	local fy = sy * 8
	local k0, k1, k2, k3, k4, k5, k6, k7 = kernel[fy + 1], kernel[fy + 2], kernel[fy + 3], kernel[fy + 4], kernel[fy + 5],
		kernel[fy + 6], kernel[fy + 7], kernel[fy + 8]
	if sx == 0 then
		local s2, s3, s4, s5, s6, s7 = 2 * ss, 3 * ss, 4 * ss, 5 * ss, 6 * ss, 7 * ss
		for r = 0, h - 1 do
			local q = base + (r - 3) * ss
			local p = doff + r * ds
			for c = 0, w - 1 do
				local sum = readu8(src, q) * k0 + readu8(src, q + ss) * k1 + readu8(src, q + s2) * k2 + readu8(src, q + s3) * k3
					+ readu8(src, q + s4) * k4 + readu8(src, q + s5) * k5 + readu8(src, q + s6) * k6 + readu8(src, q + s7) * k7 + 64
				local v = math.clamp(sum // 128, 0, 255)
				if avg then
					v = rshift(readu8(dst, p + c) + v + 1, 1)
				end
				writeu8(dst, p + c, v)
				q += 1
			end
		end
		return
	end
	-- both: horizontal into `mid` (h + 7 rows, clipped to 8 bits), then vertical
	local fx = sx * 8
	local h0, h1, h2, h3, h4, h5, h6, h7 = kernel[fx + 1], kernel[fx + 2], kernel[fx + 3], kernel[fx + 4], kernel[fx + 5],
		kernel[fx + 6], kernel[fx + 7], kernel[fx + 8]
	local m = 1
	for r = 0, h + 6 do
		local q = base + (r - 3) * ss - 3
		for _ = 0, w - 1 do
			local sum = readu8(src, q) * h0 + readu8(src, q + 1) * h1 + readu8(src, q + 2) * h2 + readu8(src, q + 3) * h3
				+ readu8(src, q + 4) * h4 + readu8(src, q + 5) * h5 + readu8(src, q + 6) * h6 + readu8(src, q + 7) * h7 + 64
			mid[m] = math.clamp(sum // 128, 0, 255)
			m += 1
			q += 1
		end
	end
	local w2, w3, w4, w5, w6, w7 = 2 * w, 3 * w, 4 * w, 5 * w, 6 * w, 7 * w
	for r = 0, h - 1 do
		local q = r * w + 1
		local p = doff + r * ds
		for c = 0, w - 1 do
			local sum = mid[q] * k0 + mid[q + w] * k1 + mid[q + w2] * k2 + mid[q + w3] * k3 + mid[q + w4] * k4 + mid[q + w5] * k5
				+ mid[q + w6] * k6 + mid[q + w7] * k7 + 64
			local v = math.clamp(sum // 128, 0, 255)
			if avg then
				v = rshift(readu8(dst, p + c) + v + 1, 1)
			end
			writeu8(dst, p + c, v)
			q += 1
		end
	end
end

return predictIntra, predictInter, AL, LC, KERNELS
end)()


------------------------------------------------------------------------------------------------------------------------
-- frame decoding state (one frame at a time)

local D -- the decoder
local fc -- this frame's probabilities
local counts -- symbol counts for adaptation, or nil
local R -- the tile's bool decoder
local cur -- the frame being decoded
local miCols, miRows, lfStride
local grid -- [miRow * miCols + miCol + 1] = the block covering that 8 x 8 cell
local intraFrame -- key frame or intra-only frame
local tileStart, tileEnd -- the tile's columns (in 8 x 8 units)
local aboveCtx, leftCtx -- token contexts per plane (0-based, in 4 x 4 units)
local aboveSeg, leftSeg -- partition contexts
local refFrames -- [1..3] the frames LAST, GOLDEN and ALTREF point at
local usePrev, prevFrame
local lfOn
local lvlY, leftY, aboveY, int4Y, leftUV, aboveUV, int4UV -- loop filter edges per 8 x 8 cell (frame-wide)
local lvlTable -- [seg * 8 + ref * 2 + modeType + 1] = filter level

-- the current block
local toTop, toBottom, toLeft, toRight -- distances to the frame edges (1/8 pel)
local aboveMi, leftMi

local SCANS = {
	[0] = { [0] = T.SCAN_DEFAULT_4X4, T.SCAN_ROW_4X4, T.SCAN_COL_4X4, T.SCAN_DEFAULT_4X4 },
	{ [0] = T.SCAN_DEFAULT_8X8, T.SCAN_ROW_8X8, T.SCAN_COL_8X8, T.SCAN_DEFAULT_8X8 },
	{ [0] = T.SCAN_DEFAULT_16X16, T.SCAN_ROW_16X16, T.SCAN_COL_16X16, T.SCAN_DEFAULT_16X16 },
	{ [0] = T.SCAN_DEFAULT_32X32, T.SCAN_DEFAULT_32X32, T.SCAN_DEFAULT_32X32, T.SCAN_DEFAULT_32X32 },
}
local NBS = {
	[0] = { [0] = T.NB_DEFAULT_4X4, T.NB_ROW_4X4, T.NB_COL_4X4, T.NB_DEFAULT_4X4 },
	{ [0] = T.NB_DEFAULT_8X8, T.NB_ROW_8X8, T.NB_COL_8X8, T.NB_DEFAULT_8X8 },
	{ [0] = T.NB_DEFAULT_16X16, T.NB_ROW_16X16, T.NB_COL_16X16, T.NB_DEFAULT_16X16 },
	{ [0] = T.NB_DEFAULT_32X32, T.NB_DEFAULT_32X32, T.NB_DEFAULT_32X32, T.NB_DEFAULT_32X32 },
}

------------------------------------------------------------------------------------------------------------------------
-- coefficient tokens

local coef = table.create(1024, 0)
for i = 0, 1023 do
	coef[i] = 0
end
local written = table.create(1024, 0)
local nWritten = 0
local tokenCache = table.create(1024, 0)
for i = 0, 1023 do
	tokenCache[i] = 0
end
local PARETO = PARETO8
local CAT1, CAT2, CAT3, CAT4, CAT5, CAT6 = CAT_PROBS[1], CAT_PROBS[2], CAT_PROBS[3], CAT_PROBS[4], CAT_PROBS[5], CAT_PROBS[6]

local function readCoeff(probs, n)
	local v = 0
	for i = 1, n do
		v = v * 2 + R:read(probs[i])
	end
	return v
end

-- one transform block's coefficients (dequantized, into `coef` at their raster positions); returns the end of block
local function decodeCoefs(ptype, ref, tx, dqDC, dqAC, ctx, scan, nb)
	local maxEob = lshift(16, tx * 2)
	local probs = fc.coef[tx + 1]
	local cnt = counts and counts.coef[tx + 1]
	local ecnt = counts and counts.eob[tx + 1]
	local bandT = tx == 0 and COEFBAND_4X4 or COEFBAND_8X8PLUS
	local half = tx == 3
	local tb = (ptype * 2 + ref) * 6
	local c = 0
	local dqv = dqDC
	local r = R
	while c < maxEob do
		local bc = (tb + bandT[c + 1]) * 6 + ctx
		local pi = bc * 3
		if cnt then
			ecnt[bc + 1] += 1
		end
		if r:read(probs[pi + 1]) == 0 then
			if cnt then
				cnt[bc * 4 + 4] += 1
			end
			break
		end
		while r:read(probs[pi + 2]) == 0 do
			if cnt then
				cnt[bc * 4 + 1] += 1
			end
			dqv = dqAC
			tokenCache[scan[c + 1]] = 0
			c += 1
			if c >= maxEob then
				return c
			end
			ctx = rshift(1 + tokenCache[nb[2 * c + 1]] + tokenCache[nb[2 * c + 2]], 1)
			bc = (tb + bandT[c + 1]) * 6 + ctx
			pi = bc * 3
		end
		local v
		local pos = scan[c + 1]
		if r:read(probs[pi + 3]) == 1 then
			if cnt then
				cnt[bc * 4 + 3] += 1
			end
			local pp = (probs[pi + 3] - 1) * 8
			local val
			if r:read(PARETO[pp + 1]) == 1 then
				if r:read(PARETO[pp + 4]) == 1 then
					tokenCache[pos] = 5
					if r:read(PARETO[pp + 6]) == 1 then
						if r:read(PARETO[pp + 8]) == 1 then
							val = 67 + readCoeff(CAT6, 14)
						else
							val = 35 + readCoeff(CAT5, 5)
						end
					elseif r:read(PARETO[pp + 7]) == 1 then
						val = 19 + readCoeff(CAT4, 4)
					else
						val = 11 + readCoeff(CAT3, 3)
					end
				else
					tokenCache[pos] = 4
					if r:read(PARETO[pp + 5]) == 1 then
						val = 7 + readCoeff(CAT2, 2)
					else
						val = 5 + readCoeff(CAT1, 1)
					end
				end
				v = val * dqv
			elseif r:read(PARETO[pp + 2]) == 1 then
				tokenCache[pos] = 3
				v = (3 + r:read(PARETO[pp + 3])) * dqv
			else
				tokenCache[pos] = 2
				v = 2 * dqv
			end
		else
			if cnt then
				cnt[bc * 4 + 2] += 1
			end
			tokenCache[pos] = 1
			v = dqv
		end
		if half then
			v = v // 2
		end
		if r:read(128) == 1 then
			v = -v
		end
		coef[pos] = v
		nWritten += 1
		written[nWritten] = pos
		c += 1
		ctx = rshift(1 + tokenCache[nb[2 * c + 1]] + tokenCache[nb[2 * c + 2]], 1)
		dqv = dqAC
	end
	return c
end

local function clearCoefs()
	for i = 1, nWritten do
		coef[written[i]] = 0
	end
	nWritten = 0
end

-- tokens of the transform block at (x, y) (4 x 4 units inside the block) with their contexts; maxW / maxH: 0, or the
-- block's extent inside the frame
local function blockTokens(plane, aBase, lBase, x, y, tx, scan, nb, mi, maxW, maxH)
	local a, l = aboveCtx[plane], leftCtx[plane]
	local n = lshift(1, tx)
	local ao, lo = aBase + x, lBase + y
	local ctx = 0
	for i = 0, n - 1 do
		if a[ao + i] ~= 0 then
			ctx = 1
			break
		end
	end
	for i = 0, n - 1 do
		if l[lo + i] ~= 0 then
			ctx += 1
			break
		end
	end
	local dq = D.dq[mi.seg]
	local eob
	if plane == 0 then
		eob = decodeCoefs(0, mi.r0 > 0 and 1 or 0, tx, dq[1], dq[2], ctx, scan, nb)
	else
		eob = decodeCoefs(1, mi.r0 > 0 and 1 or 0, tx, dq[3], dq[4], ctx, scan, nb)
	end
	local v = eob > 0 and 1 or 0
	for i = 0, n - 1 do
		a[ao + i] = (maxW == 0 or x + i < maxW) and v or 0
		l[lo + i] = (maxH == 0 or y + i < maxH) and v or 0
	end
	return eob
end

------------------------------------------------------------------------------------------------------------------------
-- intra prediction edges

local A0 = 17
local function buildEdges(mode, tx, planeBuf, off, stride, x0, y0, fw, fh, haveTop, haveLeft, haveRight)
	local bs = lshift(4, tx)
	local ext = EXTEND_MODES[mode + 1]
	if band(ext, NEED_LEFT) ~= 0 then
		if haveLeft then
			local n = bs
			if toBottom < 0 and y0 + bs > fh then
				n = fh - y0
			end
			local p = off - 1
			for i = 1, n do
				LC[i] = readu8(planeBuf, p)
				p += stride
			end
			local last = LC[n]
			for i = n + 1, bs do
				LC[i] = last
			end
		else
			for i = 1, bs do
				LC[i] = 129
			end
		end
	end
	local needAbove = band(ext, NEED_ABOVE) ~= 0
	local needRight = band(ext, NEED_ABOVERIGHT) ~= 0
	if needAbove or needRight then
		local total = needRight and 2 * bs or bs
		if haveTop then
			local p = off - stride
			-- how much of the row above is real: the block (and its right neighbour for 4 x 4 when that is decoded),
			-- cut at the frame's (8-aligned) width
			local real = (needRight and bs == 4 and haveRight) and 8 or bs
			if toRight < 0 and x0 + real > fw then
				real = fw - x0
			end
			for i = 0, real - 1 do
				AL[A0 + i] = readu8(planeBuf, p + i)
			end
			local last = AL[A0 + real - 1]
			for i = real, total - 1 do
				AL[A0 + i] = last
			end
			AL[A0 - 1] = haveLeft and readu8(planeBuf, p - 1) or 129
		else
			for i = 0, total - 1 do
				AL[A0 + i] = 127
			end
			AL[A0 - 1] = 127
		end
	end
end

------------------------------------------------------------------------------------------------------------------------
-- mode info

local function readSegId(m, miRow, miCol, xMis, yMis)
	local seg = D.seg
	if not seg.enabled then
		return 0
	end
	local last, curMap = D.lastSegMap, D.curSegMap
	local base = miRow * miCols + miCol + 1
	if intraFrame then
		if not seg.updateMap then
			for y = 0, yMis - 1 do
				local b = base + y * miCols
				for x = 0, xMis - 1 do
					curMap[b + x] = last[b + x]
				end
			end
			return 0
		end
		local id = R:tree(SEGMENT_TREE, seg.treeProbs, 0)
		for y = 0, yMis - 1 do
			local b = base + y * miCols
			for x = 0, xMis - 1 do
				curMap[b + x] = id
			end
		end
		return id
	end
	local pred = 8
	for y = 0, yMis - 1 do
		local b = base + y * miCols
		for x = 0, xMis - 1 do
			local v = last[b + x]
			if v < pred then
				pred = v
			end
		end
	end
	if not seg.updateMap then
		for y = 0, yMis - 1 do
			local b = base + y * miCols
			for x = 0, xMis - 1 do
				curMap[b + x] = last[b + x]
			end
		end
		return pred
	end
	local id
	if seg.temporal then
		local ctx = (aboveMi and aboveMi.sp or 0) + (leftMi and leftMi.sp or 0)
		m.sp = R:read(seg.predProbs[ctx + 1])
		id = m.sp == 1 and pred or R:tree(SEGMENT_TREE, seg.treeProbs, 0)
	else
		id = R:tree(SEGMENT_TREE, seg.treeProbs, 0)
	end
	for y = 0, yMis - 1 do
		local b = base + y * miCols
		for x = 0, xMis - 1 do
			curMap[b + x] = id
		end
	end
	return id
end

local function segFeature(id, f)
	local seg = D.seg
	return seg.enabled and seg.features[id][f]
end

local function readSkip(m)
	if segFeature(m.seg, 4) then
		return 1
	end
	local ctx = (aboveMi and aboveMi.skip or 0) + (leftMi and leftMi.skip or 0)
	local s = R:read(fc.skip[ctx + 1])
	if counts then
		counts.skip[ctx * 2 + s + 1] += 1
	end
	return s
end

local function readTxSize(m, allowSelect)
	local maxTx = MAX_TXSIZE[m.bs + 1]
	local txMode = D.txMode
	if allowSelect and txMode == 4 and m.bs >= BLOCK_8X8 then
		local a = (aboveMi and aboveMi.skip == 0) and aboveMi.tx or maxTx
		local l = (leftMi and leftMi.skip == 0) and leftMi.tx or maxTx
		if not leftMi then
			l = a
		end
		if not aboveMi then
			a = l
		end
		local ctx = (a + l > maxTx) and 1 or 0
		local tx
		if maxTx == 1 then
			tx = R:read(fc.tx8[ctx + 1])
			if counts then
				counts.tx8[ctx * 2 + tx + 1] += 1
			end
		elseif maxTx == 2 then
			tx = R:read(fc.tx16[ctx * 2 + 1])
			if tx ~= 0 then
				tx += R:read(fc.tx16[ctx * 2 + 2])
			end
			if counts then
				counts.tx16[ctx * 3 + tx + 1] += 1
			end
		else
			tx = R:read(fc.tx32[ctx * 3 + 1])
			if tx ~= 0 then
				tx += R:read(fc.tx32[ctx * 3 + 2])
				if tx ~= 1 then
					tx += R:read(fc.tx32[ctx * 3 + 3])
				end
			end
			if counts then
				counts.tx32[ctx * 4 + tx + 1] += 1
			end
		end
		return tx
	end
	return min(maxTx, TX_MODE_BIGGEST[txMode + 1])
end

local function yModeOf(m, b)
	if m.bs < BLOCK_8X8 then
		return m.bm[b + 1]
	end
	return m.mode
end

local function kfYProbBase(m, b)
	local above, left
	if b == 0 or b == 1 then
		above = (aboveMi and aboveMi.r0 <= 0) and yModeOf(aboveMi, b + 2) or DC_PRED
	else
		above = m.bm[b - 1]
	end
	if b == 0 or b == 2 then
		left = (leftMi and leftMi.r0 <= 0) and yModeOf(leftMi, b + 1) or DC_PRED
	else
		left = m.bm[b]
	end
	return (above * 10 + left) * 9
end

local function readIntraFrameModeInfo(m, miRow, miCol, xMis, yMis)
	m.seg = readSegId(m, miRow, miCol, xMis, yMis)
	m.skip = readSkip(m)
	m.tx = readTxSize(m, true)
	m.r0, m.r1 = INTRA_FRAME, NONE_FRAME
	local bs = m.bs
	local r = R
	if bs == 0 then
		local bm = { 0, 0, 0, 0 }
		m.bm = bm
		for i = 0, 3 do
			bm[i + 1] = r:tree(INTRA_MODE_TREE, KF_Y_MODE, kfYProbBase(m, i))
		end
		m.mode = bm[4]
	elseif bs == 1 then
		local bm = { 0, 0, 0, 0 }
		m.bm = bm
		local v = r:tree(INTRA_MODE_TREE, KF_Y_MODE, kfYProbBase(m, 0))
		bm[1], bm[3] = v, v
		v = r:tree(INTRA_MODE_TREE, KF_Y_MODE, kfYProbBase(m, 1))
		bm[2], bm[4] = v, v
		m.mode = v
	elseif bs == 2 then
		local bm = { 0, 0, 0, 0 }
		m.bm = bm
		local v = r:tree(INTRA_MODE_TREE, KF_Y_MODE, kfYProbBase(m, 0))
		bm[1], bm[2] = v, v
		v = r:tree(INTRA_MODE_TREE, KF_Y_MODE, kfYProbBase(m, 2))
		bm[3], bm[4] = v, v
		m.mode = v
	else
		m.mode = r:tree(INTRA_MODE_TREE, KF_Y_MODE, kfYProbBase(m, 0))
	end
	m.uv = r:tree(INTRA_MODE_TREE, KF_UV_MODE, m.mode * 9)
end

local function readYMode(group)
	local v = R:tree(INTRA_MODE_TREE, fc.yMode, group * 9)
	if counts then
		counts.yMode[group * 10 + v + 1] += 1
	end
	return v
end

local function readIntraBlockModeInfo(m)
	local bs = m.bs
	if bs == 0 then
		local bm = { 0, 0, 0, 0 }
		m.bm = bm
		for i = 1, 4 do
			bm[i] = readYMode(0)
		end
		m.mode = bm[4]
	elseif bs == 1 then
		local bm = { 0, 0, 0, 0 }
		m.bm = bm
		local v = readYMode(0)
		bm[1], bm[3] = v, v
		v = readYMode(0)
		bm[2], bm[4] = v, v
		m.mode = v
	elseif bs == 2 then
		local bm = { 0, 0, 0, 0 }
		m.bm = bm
		local v = readYMode(0)
		bm[1], bm[2] = v, v
		v = readYMode(0)
		bm[3], bm[4] = v, v
		m.mode = v
	else
		m.mode = readYMode(SIZE_GROUP[bs + 1])
	end
	local uv = R:tree(INTRA_MODE_TREE, fc.uvMode, m.mode * 9)
	if counts then
		counts.uvMode[m.mode * 10 + uv + 1] += 1
	end
	m.uv = uv
	m.filt = 3
	m.r0, m.r1 = INTRA_FRAME, NONE_FRAME
end

-- reference frame contexts (see the libvpx pred_common)
local function hasSecond(m)
	return m.r1 > 0
end

local function refModeCtx()
	local fixed = D.compFixed
	local a, l = aboveMi, leftMi
	if a and l then
		if not hasSecond(a) and not hasSecond(l) then
			return bxor(a.r0 == fixed and 1 or 0, l.r0 == fixed and 1 or 0)
		elseif not hasSecond(a) then
			return 2 + ((a.r0 == fixed or a.r0 <= 0) and 1 or 0)
		elseif not hasSecond(l) then
			return 2 + ((l.r0 == fixed or l.r0 <= 0) and 1 or 0)
		end
		return 4
	elseif a or l then
		local e = a or l
		if not hasSecond(e) then
			return e.r0 == fixed and 1 or 0
		end
		return 3
	end
	return 1
end

local function refOf(m, i)
	return i == 0 and m.r0 or m.r1
end

local function compRefCtx()
	local fixed, var0, var1 = D.compFixed, D.compVar0, D.compVar1
	local varIdx = 1 - D.signBias[fixed]
	local a, l = aboveMi, leftMi
	if a and l then
		local ai, li = a.r0 <= 0, l.r0 <= 0
		if ai and li then
			return 2
		elseif ai or li then
			local e = ai and l or a
			if not hasSecond(e) then
				return 1 + 2 * (e.r0 ~= var1 and 1 or 0)
			end
			return 1 + 2 * (refOf(e, varIdx) ~= var1 and 1 or 0)
		end
		local lsg, asg = not hasSecond(l), not hasSecond(a)
		local vrfa = asg and a.r0 or refOf(a, varIdx)
		local vrfl = lsg and l.r0 or refOf(l, varIdx)
		if vrfa == vrfl and var1 == vrfa then
			return 0
		elseif lsg and asg then
			if (vrfa == fixed and vrfl == var0) or (vrfl == fixed and vrfa == var0) then
				return 4
			elseif vrfa == vrfl then
				return 3
			end
			return 1
		elseif lsg or asg then
			local vrfc = lsg and vrfa or vrfl
			local rfs = asg and vrfa or vrfl
			if vrfc == var1 and rfs ~= var1 then
				return 1
			elseif rfs == var1 and vrfc ~= var1 then
				return 2
			end
			return 4
		elseif vrfa == vrfl then
			return 4
		end
		return 2
	elseif a or l then
		local e = a or l
		if e.r0 <= 0 then
			return 2
		end
		if hasSecond(e) then
			return 4 * (refOf(e, varIdx) ~= var1 and 1 or 0)
		end
		return 3 * (e.r0 ~= var1 and 1 or 0)
	end
	return 2
end

local function singleRefP1Ctx()
	local a, l = aboveMi, leftMi
	if a and l then
		local ai, li = a.r0 <= 0, l.r0 <= 0
		if ai and li then
			return 2
		elseif ai or li then
			local e = ai and l or a
			if not hasSecond(e) then
				return 4 * (e.r0 == LAST_FRAME and 1 or 0)
			end
			return 1 + ((e.r0 == LAST_FRAME or e.r1 == LAST_FRAME) and 1 or 0)
		end
		local as, ls = hasSecond(a), hasSecond(l)
		if as and ls then
			return 1 + ((a.r0 == LAST_FRAME or a.r1 == LAST_FRAME or l.r0 == LAST_FRAME or l.r1 == LAST_FRAME) and 1 or 0)
		elseif as or ls then
			local rfs = not as and a.r0 or l.r0
			local crf1 = as and a.r0 or l.r0
			local crf2 = as and a.r1 or l.r1
			if rfs == LAST_FRAME then
				return 3 + ((crf1 == LAST_FRAME or crf2 == LAST_FRAME) and 1 or 0)
			end
			return (crf1 == LAST_FRAME or crf2 == LAST_FRAME) and 1 or 0
		end
		return 2 * (a.r0 == LAST_FRAME and 1 or 0) + 2 * (l.r0 == LAST_FRAME and 1 or 0)
	elseif a or l then
		local e = a or l
		if e.r0 <= 0 then
			return 2
		end
		if not hasSecond(e) then
			return 4 * (e.r0 == LAST_FRAME and 1 or 0)
		end
		return 1 + ((e.r0 == LAST_FRAME or e.r1 == LAST_FRAME) and 1 or 0)
	end
	return 2
end

local function singleRefP2Ctx()
	local a, l = aboveMi, leftMi
	if a and l then
		local ai, li = a.r0 <= 0, l.r0 <= 0
		if ai and li then
			return 2
		elseif ai or li then
			local e = ai and l or a
			if not hasSecond(e) then
				if e.r0 == LAST_FRAME then
					return 3
				end
				return 4 * (e.r0 == GOLDEN_FRAME and 1 or 0)
			end
			return 1 + 2 * ((e.r0 == GOLDEN_FRAME or e.r1 == GOLDEN_FRAME) and 1 or 0)
		end
		local as, ls = hasSecond(a), hasSecond(l)
		local a0, a1, l0, l1 = a.r0, a.r1, l.r0, l.r1
		if as and ls then
			if a0 == l0 and a1 == l1 then
				return 3 * ((a0 == GOLDEN_FRAME or a1 == GOLDEN_FRAME or l0 == GOLDEN_FRAME or l1 == GOLDEN_FRAME) and 1 or 0)
			end
			return 2
		elseif as or ls then
			local rfs = not as and a0 or l0
			local crf1 = as and a0 or l0
			local crf2 = as and a1 or l1
			local g = (crf1 == GOLDEN_FRAME or crf2 == GOLDEN_FRAME) and 1 or 0
			if rfs == GOLDEN_FRAME then
				return 3 + g
			elseif rfs == ALTREF_FRAME then
				return g
			end
			return 1 + 2 * g
		end
		if a0 == LAST_FRAME and l0 == LAST_FRAME then
			return 3
		elseif a0 == LAST_FRAME or l0 == LAST_FRAME then
			local e0 = a0 == LAST_FRAME and l0 or a0
			return 4 * (e0 == GOLDEN_FRAME and 1 or 0)
		end
		return 2 * (a0 == GOLDEN_FRAME and 1 or 0) + 2 * (l0 == GOLDEN_FRAME and 1 or 0)
	elseif a or l then
		local e = a or l
		if e.r0 <= 0 or (e.r0 == LAST_FRAME and not hasSecond(e)) then
			return 2
		elseif not hasSecond(e) then
			return 4 * (e.r0 == GOLDEN_FRAME and 1 or 0)
		end
		return 3 * ((e.r0 == GOLDEN_FRAME or e.r1 == GOLDEN_FRAME) and 1 or 0)
	end
	return 2
end

local function readRefFrames(m)
	if segFeature(m.seg, 3) then
		m.r0, m.r1 = D.seg.data[m.seg][3], NONE_FRAME
		return
	end
	local mode = D.refMode
	if mode == 2 then
		local ctx = refModeCtx()
		mode = R:read(fc.compInter[ctx + 1])
		if counts then
			counts.compInter[ctx * 2 + mode + 1] += 1
		end
	end
	if mode == 1 then
		local fixed = D.compFixed
		local idx = D.signBias[fixed]
		local ctx = compRefCtx()
		local bit = R:read(fc.compRef[ctx + 1])
		if counts then
			counts.compRef[ctx * 2 + bit + 1] += 1
		end
		local var = bit == 1 and D.compVar1 or D.compVar0
		if idx == 0 then
			m.r0, m.r1 = fixed, var
		else
			m.r0, m.r1 = var, fixed
		end
	else
		local ctx0 = singleRefP1Ctx()
		local bit0 = R:read(fc.singleRef[ctx0 * 2 + 1])
		if counts then
			counts.singleRef[ctx0 * 4 + bit0 + 1] += 1
		end
		if bit0 == 1 then
			local ctx1 = singleRefP2Ctx()
			local bit1 = R:read(fc.singleRef[ctx1 * 2 + 2])
			if counts then
				counts.singleRef[ctx1 * 4 + 2 + bit1 + 1] += 1
			end
			m.r0 = bit1 == 1 and ALTREF_FRAME or GOLDEN_FRAME
		else
			m.r0 = LAST_FRAME
		end
		m.r1 = NONE_FRAME
	end
end

------------------------------------------------------------------------------------------------------------------------
-- motion vectors

local listR, listC = { 0, 0 }, { 0, 0 }
local fmCount, fmEarly = 0, false

-- add a candidate; true when the search is done
local function fmAdd(r, c)
	if fmCount > 0 then
		if r ~= listR[1] or c ~= listC[1] then
			listR[2], listC[2] = r, c
			fmCount = 2
			return true
		end
		return false
	end
	listR[1], listC[1] = r, c
	fmCount = 1
	return fmEarly
end

local function mvOf(m, i)
	if i == 0 then
		return m.m0r, m.m0c
	end
	return m.m1r, m.m1c
end

local function subBlockMv(m, which, searchCol, block)
	if block >= 0 and m.bs < BLOCK_8X8 then
		local sb = IDX_N_COLUMN_TO_SUBBLOCK[block + 1][searchCol == 0 and 2 or 1]
		local bv = m.bv
		return bv[sb * 4 + which * 2 + 1], bv[sb * 4 + which * 2 + 2]
	end
	return mvOf(m, which)
end

local function clampRef(n)
	local minC, maxC = toLeft - 128, toRight + 128
	local minR, maxR = toTop - 128, toBottom + 128
	for i = 1, n do
		local c, r = listC[i], listR[i]
		listC[i] = c < minC and minC or (c > maxC and maxC or c)
		listR[i] = r < minR and minR or (r > maxR and maxR or r)
	end
end

-- dec_find_mv_refs: the candidates (listR / listC) for one reference frame; returns how many are meaningful
local function findMvRefs(m, mode, ref, miRow, miCol, block)
	listR[1], listC[1], listR[2], listC[2] = 0, 0, 0, 0
	fmCount = 0
	fmEarly = mode ~= NEARMV
	local search = MV_REF_BLOCKS[m.bs + 1]
	local sb = D.signBias
	local differentFound = false
	local i = 0
	if block >= 0 then
		for k = 0, 1 do
			local pr, pc = search[k * 2 + 1], search[k * 2 + 2]
			local rr, cc = miRow + pr, miCol + pc
			if rr >= 0 and cc >= tileStart and rr < miRows and cc < tileEnd then
				local cand = grid[rr * miCols + cc + 1]
				differentFound = true
				if cand.r0 == ref then
					local r, c = subBlockMv(cand, 0, pc, block)
					if fmAdd(r, c) then
						clampRef(fmCount)
						return fmCount
					end
				elseif cand.r1 == ref then
					local r, c = subBlockMv(cand, 1, pc, block)
					if fmAdd(r, c) then
						clampRef(fmCount)
						return fmCount
					end
				end
			end
		end
		i = 2
	end
	for k = i, 7 do
		local rr, cc = miRow + search[k * 2 + 1], miCol + search[k * 2 + 2]
		if rr >= 0 and cc >= tileStart and rr < miRows and cc < tileEnd then
			local cand = grid[rr * miCols + cc + 1]
			differentFound = true
			if cand.r0 == ref then
				if fmAdd(cand.m0r, cand.m0c) then
					clampRef(fmCount)
					return fmCount
				end
			elseif cand.r1 == ref then
				if fmAdd(cand.m1r, cand.m1c) then
					clampRef(fmCount)
					return fmCount
				end
			end
		end
	end
	local pidx = miRow * miCols + miCol + 1
	local pr0, pr1
	if usePrev then
		pr0, pr1 = prevFrame.ref0[pidx], prevFrame.ref1[pidx]
		if pr0 == ref then
			if fmAdd(prevFrame.mv0r[pidx], prevFrame.mv0c[pidx]) then
				clampRef(fmCount)
				return fmCount
			end
		elseif pr1 == ref then
			if fmAdd(prevFrame.mv1r[pidx], prevFrame.mv1c[pidx]) then
				clampRef(fmCount)
				return fmCount
			end
		end
	end
	if differentFound then
		local refBias = sb[ref]
		for k = 0, 7 do
			local rr, cc = miRow + search[k * 2 + 1], miCol + search[k * 2 + 2]
			if rr >= 0 and cc >= tileStart and rr < miRows and cc < tileEnd then
				local cand = grid[rr * miCols + cc + 1]
				if cand.r0 > 0 then
					if cand.r0 ~= ref then
						local r, c = cand.m0r, cand.m0c
						if sb[cand.r0] ~= refBias then
							r, c = -r, -c
						end
						if fmAdd(r, c) then
							clampRef(fmCount)
							return fmCount
						end
					end
					if cand.r1 > 0 and cand.r1 ~= ref and (cand.m1r ~= cand.m0r or cand.m1c ~= cand.m0c) then
						local r, c = cand.m1r, cand.m1c
						if sb[cand.r1] ~= refBias then
							r, c = -r, -c
						end
						if fmAdd(r, c) then
							clampRef(fmCount)
							return fmCount
						end
					end
				end
			end
		end
	end
	if usePrev then
		local refBias = sb[ref]
		if pr0 ~= ref and pr0 > 0 then
			local r, c = prevFrame.mv0r[pidx], prevFrame.mv0c[pidx]
			if sb[pr0] ~= refBias then
				r, c = -r, -c
			end
			if fmAdd(r, c) then
				clampRef(fmCount)
				return fmCount
			end
		end
		if pr1 > 0 and pr1 ~= ref
			and (prevFrame.mv1r[pidx] ~= prevFrame.mv0r[pidx] or prevFrame.mv1c[pidx] ~= prevFrame.mv0c[pidx]) then
			local r, c = prevFrame.mv1r[pidx], prevFrame.mv1c[pidx]
			if sb[pr1] ~= refBias then
				r, c = -r, -c
			end
			if fmAdd(r, c) then
				clampRef(fmCount)
				return fmCount
			end
		end
	end
	local n = mode == NEARMV and 2 or 1
	clampRef(n)
	return n
end

local function lowerPrecision(r, c, allowHp)
	if allowHp and abs(r) < 64 and abs(c) < 64 then
		return r, c
	end
	if r % 2 ~= 0 then
		r += r > 0 and -1 or 1
	end
	if c % 2 ~= 0 then
		c += c > 0 and -1 or 1
	end
	return r, c
end

local function readMvComponent(comp, usehp)
	local r = R
	local sign = r:read(fc.sign[comp + 1])
	local cls = r:tree(MV_CLASS_TREE, fc.classes, comp * 10)
	local mag, d, fr, hp
	if cls == 0 then
		d = r:read(fc.class0[comp + 1])
		fr = r:tree(MV_FP_TREE, fc.class0fp, (comp * 2 + d) * 3)
		hp = usehp and r:read(fc.class0hp[comp + 1]) or 1
		mag = 0
		if counts then
			counts.class0[comp * 2 + d + 1] += 1
			counts.class0fp[(comp * 2 + d) * 4 + fr + 1] += 1
			counts.class0hp[comp * 2 + hp + 1] += 1
		end
	else
		d = 0
		for i = 0, cls - 1 do
			local bit = r:read(fc.bits[comp * 10 + i + 1])
			d += bit * POW2[i + 1]
			if counts then
				counts.bits[(comp * 10 + i) * 2 + bit + 1] += 1
			end
		end
		fr = r:tree(MV_FP_TREE, fc.fp, comp * 3)
		hp = usehp and r:read(fc.hp[comp + 1]) or 1
		mag = lshift(2, cls + 2)
		if counts then
			counts.fp[comp * 4 + fr + 1] += 1
			counts.hp[comp * 2 + hp + 1] += 1
		end
	end
	if counts then
		counts.sign[comp * 2 + sign + 1] += 1
		counts.classes[comp * 11 + cls + 1] += 1
	end
	mag += d * 8 + fr * 2 + hp + 1
	return sign == 1 and -mag or mag
end

local function readMv(refR, refC)
	local j = R:tree(MV_JOINT_TREE, fc.joints, 0)
	if counts then
		counts.joints[j + 1] += 1
	end
	local usehp = D.allowHp and abs(refR) < 64 and abs(refC) < 64
	local dr, dc = 0, 0
	if j == 2 or j == 3 then
		dr = readMvComponent(0, usehp)
	end
	if j == 1 or j == 3 then
		dc = readMvComponent(1, usehp)
	end
	local r, c = refR + dr, refC + dc
	if r <= -16384 or r >= 16383 or c <= -16384 or c >= 16383 then
		fail("broken data (a motion vector out of range)")
	end
	return r, c
end

local function readInterMode(ctx)
	local v = R:tree(INTER_MODE_TREE, fc.interMode, ctx * 3)
	if counts then
		counts.interMode[ctx * 4 + v + 1] += 1
	end
	return NEARESTMV + v
end

local bestR, bestC = { 0, 0 }, { 0, 0 } -- best_ref_mvs
local subR, subC = { 0, 0 }, { 0, 0 } -- best_sub8x8

-- append_sub8x8_mvs_for_idx
local function appendSub8x8(m, bmode, j, ref, miRow, miCol)
	local refFrame = refOf(m, ref)
	local bv = m.bv
	local o = ref * 2
	if j == 0 then
		local n = findMvRefs(m, bmode, refFrame, miRow, miCol, 0)
		subR[ref + 1], subC[ref + 1] = listR[n], listC[n]
	elseif j == 1 or j == 2 then
		local r0, c0 = bv[o + 1], bv[o + 2]
		if bmode == NEARESTMV then
			subR[ref + 1], subC[ref + 1] = r0, c0
		else
			findMvRefs(m, bmode, refFrame, miRow, miCol, j)
			subR[ref + 1], subC[ref + 1] = 0, 0
			for n = 1, 2 do
				if r0 ~= listR[n] or c0 ~= listC[n] then
					subR[ref + 1], subC[ref + 1] = listR[n], listC[n]
					break
				end
			end
		end
	else
		local r2, c2 = bv[8 + o + 1], bv[8 + o + 2]
		if bmode == NEARESTMV then
			subR[ref + 1], subC[ref + 1] = r2, c2
		else
			local r1, c1 = bv[4 + o + 1], bv[4 + o + 2]
			local r0, c0 = bv[o + 1], bv[o + 2]
			subR[ref + 1], subC[ref + 1] = 0, 0
			if r2 ~= r1 or c2 ~= c1 then
				subR[ref + 1], subC[ref + 1] = r1, c1
			elseif r2 ~= r0 or c2 ~= c0 then
				subR[ref + 1], subC[ref + 1] = r0, c0
			else
				findMvRefs(m, bmode, refFrame, miRow, miCol, 3)
				for n = 1, 2 do
					if r2 ~= listR[n] or c2 ~= listC[n] then
						subR[ref + 1], subC[ref + 1] = listR[n], listC[n]
						break
					end
				end
			end
		end
	end
end

local function readInterBlockModeInfo(m, miRow, miCol)
	readRefFrames(m)
	local compound = m.r1 > 0
	local bs = m.bs
	local search = MV_REF_BLOCKS[bs + 1]
	-- mode context from the two nearest neighbours
	local counter = 0
	for k = 0, 1 do
		local rr, cc = miRow + search[k * 2 + 1], miCol + search[k * 2 + 2]
		if rr >= 0 and cc >= tileStart and rr < miRows and cc < tileEnd then
			counter += MODE_2_COUNTER[grid[rr * miCols + cc + 1].mode + 1]
		end
	end
	local ctx = COUNTER_TO_CONTEXT[counter + 1]
	if segFeature(m.seg, 4) then
		m.mode = ZEROMV
		if bs < BLOCK_8X8 then
			fail("broken data (segment skip on a small block)")
		end
	elseif bs >= BLOCK_8X8 then
		m.mode = readInterMode(ctx)
	end
	if D.interpFilter == 4 then
		local lt = leftMi and leftMi.filt or 3
		local at = aboveMi and aboveMi.filt or 3
		local fctx
		if lt == at then
			fctx = lt
		elseif lt == 3 then
			fctx = at
		elseif at == 3 then
			fctx = lt
		else
			fctx = 3
		end
		local f = R:tree(SWITCHABLE_TREE, fc.interp, fctx * 2)
		if counts then
			counts.interp[fctx * 3 + f + 1] += 1
		end
		m.filt = f
	else
		m.filt = D.interpFilter
	end
	local allowHp = D.allowHp
	bestR[1], bestC[1], bestR[2], bestC[2] = 0, 0, 0, 0
	if bs < BLOCK_8X8 then
		local n4w, n4h = NUM_4X4_W[bs + 1], NUM_4X4_H[bs + 1]
		local bv = table.create(16, 0)
		m.bv = bv
		subR[2], subC[2] = -32768, -32768
		local gotNew = false
		local bmode
		for idy = 0, 1, n4h do
			for idx = 0, 1, n4w do
				local j = idy * 2 + idx
				bmode = readInterMode(ctx)
				local o = j * 4
				if bmode == NEARESTMV or bmode == NEARMV then
					for ref = 0, compound and 1 or 0 do
						appendSub8x8(m, bmode, j, ref, miRow, miCol)
					end
					bv[o + 1], bv[o + 2], bv[o + 3], bv[o + 4] = subR[1], subC[1], subR[2], subC[2]
				elseif bmode == NEWMV then
					if not gotNew then
						for ref = 0, compound and 1 or 0 do
							findMvRefs(m, NEWMV, refOf(m, ref), miRow, miCol, -1)
							bestR[ref + 1], bestC[ref + 1] = lowerPrecision(listR[1], listC[1], allowHp)
						end
						gotNew = true
					end
					bv[o + 1], bv[o + 2] = readMv(bestR[1], bestC[1])
					if compound then
						bv[o + 3], bv[o + 4] = readMv(bestR[2], bestC[2])
					end
				else
					bv[o + 1], bv[o + 2], bv[o + 3], bv[o + 4] = 0, 0, 0, 0
				end
				if n4h == 2 then
					bv[o + 9], bv[o + 10], bv[o + 11], bv[o + 12] = bv[o + 1], bv[o + 2], bv[o + 3], bv[o + 4]
				end
				if n4w == 2 then
					bv[o + 5], bv[o + 6], bv[o + 7], bv[o + 8] = bv[o + 1], bv[o + 2], bv[o + 3], bv[o + 4]
				end
			end
		end
		m.mode = bmode
		m.m0r, m.m0c, m.m1r, m.m1c = bv[13], bv[14], bv[15], bv[16]
	else
		local mode = m.mode
		if mode ~= ZEROMV then
			for ref = 0, compound and 1 or 0 do
				local n = findMvRefs(m, mode, refOf(m, ref), miRow, miCol, -1)
				bestR[ref + 1], bestC[ref + 1] = lowerPrecision(listR[n], listC[n], allowHp)
			end
		end
		if mode == NEWMV then
			m.m0r, m.m0c = readMv(bestR[1], bestC[1])
			if compound then
				m.m1r, m.m1c = readMv(bestR[2], bestC[2])
			else
				m.m1r, m.m1c = 0, 0
			end
		elseif mode == ZEROMV then
			m.m0r, m.m0c, m.m1r, m.m1c = 0, 0, 0, 0
		else
			m.m0r, m.m0c, m.m1r, m.m1c = bestR[1], bestC[1], bestR[2], bestC[2]
		end
	end
end

local function readInterFrameModeInfo(m, miRow, miCol, xMis, yMis)
	m.seg = readSegId(m, miRow, miCol, xMis, yMis)
	m.skip = readSkip(m)
	local inter
	if segFeature(m.seg, 3) then
		inter = D.seg.data[m.seg][3] ~= INTRA_FRAME
	else
		local a, l = aboveMi, leftMi
		local ctx
		if a and l then
			local ai, li = a.r0 <= 0, l.r0 <= 0
			ctx = (ai and li) and 3 or ((ai or li) and 1 or 0)
		elseif a or l then
			ctx = (a or l).r0 <= 0 and 2 or 0
		else
			ctx = 0
		end
		local v = R:read(fc.intraInter[ctx + 1])
		if counts then
			counts.intraInter[ctx * 2 + v + 1] += 1
		end
		inter = v == 1
	end
	m.tx = readTxSize(m, m.skip == 0 or not inter)
	if inter then
		readInterBlockModeInfo(m, miRow, miCol)
	else
		readIntraBlockModeInfo(m)
	end
	-- the motion this frame keeps for the next one
	local f = cur
	for y = 0, yMis - 1 do
		local b = (miRow + y) * miCols + miCol + 1
		for x = 0, xMis - 1 do
			local k = b + x
			f.ref0[k], f.ref1[k] = m.r0, m.r1
			f.mv0r[k], f.mv0c[k], f.mv1r[k], f.mv1c[k] = m.m0r or 0, m.m0c or 0, m.m1r or 0, m.m1c or 0
		end
	end
end

------------------------------------------------------------------------------------------------------------------------
-- reconstruction

local function predictInterBlock(m, miRow, miCol, bw, bh)
	local kernel = KERNELS[m.filt]
	local f = cur
	for ref = 0, m.r1 > 0 and 1 or 0 do
		local rf = refFrames[refOf(m, ref)]
		if not rf then
			fail("broken data (a missing reference frame)")
		end
		if rf.w ~= f.w or rf.h ~= f.h then
			fail("streams that change size between key frames are not supported")
		end
		local avg = ref == 1
		if m.bs < BLOCK_8X8 then
			local bv = m.bv
			local o = ref * 2
			-- luma: each 4 x 4 with its own vector
			for y = 0, 1 do
				for x = 0, 1 do
					local i = y * 2 + x
					local mr, mc = bv[i * 4 + o + 1], bv[i * 4 + o + 2]
					local px, py = miCol * 8 + x * 4, miRow * 8 + y * 4
					local sr, sc = mr * 2, mc * 2
					predictInter(rf.Y, rf.ys, rf.w, rf.h, px + floor(sc / 16), py + floor(sr / 16), sc % 16, sr % 16, 4, 4,
						kernel, f.Y, py * f.ys + px, f.ys, avg)
				end
			end
			-- chroma: one 4 x 4 with the average of the four
			local sr = bv[o + 1] + bv[4 + o + 1] + bv[8 + o + 1] + bv[12 + o + 1]
			local sc = bv[o + 2] + bv[4 + o + 2] + bv[8 + o + 2] + bv[12 + o + 2]
			sr = idiv(sr < 0 and sr - 2 or sr + 2, 4)
			sc = idiv(sc < 0 and sc - 2 or sc + 2, 4)
			local px, py = miCol * 4, miRow * 4
			local cw, ch = rf.cw, rf.ch
			local x0, y0, fx, fy = px + floor(sc / 16), py + floor(sr / 16), sc % 16, sr % 16
			local doff = py * f.cs + px
			predictInter(rf.U, rf.cs, cw, ch, x0, y0, fx, fy, 4, 4, kernel, f.U, doff, f.cs, avg)
			predictInter(rf.V, rf.cs, cw, ch, x0, y0, fx, fy, 4, 4, kernel, f.V, doff, f.cs, avg)
		else
			local mr, mc = mvOf(m, ref)
			local px, py = miCol * 8, miRow * 8
			local sr, sc = mr * 2, mc * 2
			local w, h = bw * 8, bh * 8
			predictInter(rf.Y, rf.ys, rf.w, rf.h, px + floor(sc / 16), py + floor(sr / 16), sc % 16, sr % 16, w, h,
				kernel, f.Y, py * f.ys + px, f.ys, avg)
			px, py = miCol * 4, miRow * 4
			local x0, y0, fx, fy = px + floor(mc / 16), py + floor(mr / 16), mc % 16, mr % 16
			local doff = py * f.cs + px
			predictInter(rf.U, rf.cs, rf.cw, rf.ch, x0, y0, fx, fy, w // 2, h // 2, kernel, f.U, doff, f.cs, avg)
			predictInter(rf.V, rf.cs, rf.cw, rf.ch, x0, y0, fx, fy, w // 2, h // 2, kernel, f.V, doff, f.cs, avg)
		end
	end
end

local function reconstruct(tx, txType, buf, off, stride, eob)
	if D.lossless then
		inverseWht(coef, buf, off, stride)
	else
		inverseTransform(coef, tx, txType, buf, off, stride, eob)
	end
	clearCoefs()
end

local function decodeBlock(miRow, miCol, bs, bwl, bhl)
	local bw, bh = lshift(1, bwl - 1), lshift(1, bhl - 1)
	local xMis, yMis = min(bw, miCols - miCol), min(bh, miRows - miRow)
	local m = { bs = bs, skip = 0, sp = 0, filt = 3 }
	local base = miRow * miCols + miCol + 1
	for y = 0, yMis - 1 do
		local b = base + y * miCols
		for x = 0, xMis - 1 do
			grid[b + x] = m
		end
	end
	toTop = -miRow * 64
	toBottom = (miRows - bh - miRow) * 64
	toLeft = -miCol * 64
	toRight = (miCols - bw - miCol) * 64
	aboveMi = miRow ~= 0 and grid[base - miCols] or nil
	leftMi = miCol > tileStart and grid[base - 1] or nil

	if intraFrame then
		readIntraFrameModeInfo(m, miRow, miCol, xMis, yMis)
	else
		readInterFrameModeInfo(m, miRow, miCol, xMis, yMis)
	end

	local f = cur
	local aY, lY = miCol * 2, band(miRow * 2, 15)
	local aC, lC = miCol, band(miRow, 7)
	if m.skip == 1 then
		local a, l = aboveCtx[0], leftCtx[0]
		for i = 0, bw * 2 - 1 do
			a[aY + i] = 0
		end
		for i = 0, bh * 2 - 1 do
			l[lY + i] = 0
		end
		for p = 1, 2 do
			a, l = aboveCtx[p], leftCtx[p]
			for i = 0, bw - 1 do
				a[aC + i] = 0
			end
			for i = 0, bh - 1 do
				l[lC + i] = 0
			end
		end
	end

	local uvTx = bs < BLOCK_8X8 and 0 or min(m.tx, MAX_TXSIZE[UV_BLOCK[bs + 1] + 1])
	local lossless = D.lossless
	if m.r0 <= 0 then
		-- intra: predict and add each transform block in turn (each predicts from the ones before it)
		for plane = 0, 2 do
			local tx, n4w, n4h, ss, buf, stride, aBase, lBase, n4wl
			if plane == 0 then
				tx, n4w, n4h, ss, buf, stride, aBase, lBase, n4wl = m.tx, bw * 2, bh * 2, 0, f.Y, f.ys, aY, lY, bwl
			else
				tx, n4w, n4h, ss, stride, aBase, lBase, n4wl = uvTx, bw, bh, 1, f.cs, aC, lC, bwl - 1
				buf = plane == 1 and f.U or f.V
			end
			local maxW = toRight >= 0 and 0 or n4w + toRight // lshift(32, ss)
			local maxH = toBottom >= 0 and 0 or n4h + toBottom // lshift(32, ss)
			local limW = maxW == 0 and n4w or maxW
			local limH = maxH == 0 and n4h or maxH
			local step = lshift(1, tx)
			local fw, fh = rshift(f.aw, ss), rshift(f.ah, ss)
			local px0, py0 = rshift(miCol * 8, ss), rshift(miRow * 8, ss)
			local bwIn = lshift(1, n4wl)
			local bsz = lshift(4, tx)
			for row = 0, limH - 1, step do
				for col = 0, limW - 1, step do
					local mode = plane == 0 and m.mode or m.uv
					if plane == 0 and bs < BLOCK_8X8 then
						mode = m.bm[row * 2 + col + 1]
					end
					local x0, y0 = px0 + col * 4, py0 + row * 4
					local off = y0 * stride + x0
					local haveTop = row > 0 or aboveMi ~= nil
					local haveLeft = col > 0 or leftMi ~= nil
					local haveRight = col + step < bwIn
					buildEdges(mode, tx, buf, off, stride, x0, y0, fw, fh, haveTop, haveLeft, haveRight)
					predictIntra(mode, bsz, buf, off, stride, haveLeft, haveTop)
					if m.skip == 0 then
						local txType = (plane > 0 or lossless) and 0 or MODE_TX_TYPE[mode + 1]
						local eob = blockTokens(plane, aBase, lBase, col, row, tx, SCANS[tx][txType], NBS[tx][txType], m, maxW,
							maxH)
						if eob > 0 then
							reconstruct(tx, txType, buf, off, stride, eob)
						end
					end
				end
			end
		end
	else
		predictInterBlock(m, miRow, miCol, bw, bh)
		if m.skip == 0 then
			local eobTotal = 0
			for plane = 0, 2 do
				local tx, n4w, n4h, ss, buf, stride, aBase, lBase
				if plane == 0 then
					tx, n4w, n4h, ss, buf, stride, aBase, lBase = m.tx, bw * 2, bh * 2, 0, f.Y, f.ys, aY, lY
				else
					tx, n4w, n4h, ss, stride, aBase, lBase = uvTx, bw, bh, 1, f.cs, aC, lC
					buf = plane == 1 and f.U or f.V
				end
				local maxW = toRight >= 0 and 0 or n4w + toRight // lshift(32, ss)
				local maxH = toBottom >= 0 and 0 or n4h + toBottom // lshift(32, ss)
				local limW = maxW == 0 and n4w or maxW
				local limH = maxH == 0 and n4h or maxH
				local step = lshift(1, tx)
				local px0, py0 = rshift(miCol * 8, ss), rshift(miRow * 8, ss)
				local scan, nb = SCANS[tx][0], NBS[tx][0]
				for row = 0, limH - 1, step do
					for col = 0, limW - 1, step do
						local eob = blockTokens(plane, aBase, lBase, col, row, tx, scan, nb, m, maxW, maxH)
						if eob > 0 then
							eobTotal += eob
							reconstruct(tx, 0, buf, (py0 + row * 4) * stride + px0 + col * 4, stride, eob)
						end
					end
				end
			end
			if bs >= BLOCK_8X8 and eobTotal == 0 then
				m.skip = 1
			end
		end
	end

	if lfOn then
		-- the loop filter's edges for this block
		local lvl
		if m.r0 <= 0 then
			lvl = lvlTable[m.seg * 8 + 1]
		else
			lvl = lvlTable[m.seg * 8 + m.r0 * 2 + (m.mode == ZEROMV and 0 or 1) + 1]
		end
		if lvl > 0 then
			local tx = m.tx
			local code = tx + 1
			local edges = not (m.skip == 1 and m.r0 > 0)
			local stepT = tx == 2 and 2 or (tx == 3 and 4 or 1)
			local w8, h8 = NUM_8X8_W[bs + 1], NUM_8X8_H[bs + 1]
			local L = lfStride
			for y = 0, h8 - 1 do
				local p = (miRow + y) * L + miCol
				for x = 0, w8 - 1 do
					local q = p + x + 1
					lvlY[q] = lvl
					if x == 0 or (edges and x % stepT == 0) then
						leftY[q] = code
					end
					if y == 0 or (edges and y % stepT == 0) then
						aboveY[q] = code
					end
					if edges and tx == 0 then
						int4Y[q] = true
					end
				end
			end
			if band(miRow, 1) == 0 and band(miCol, 1) == 0 then
				local uw, uh = max(1, w8 // 2), max(1, h8 // 2)
				local ucode = uvTx + 1
				local stepU = uvTx == 2 and 2 or (uvTx == 3 and 4 or 1)
				local LU = L // 2
				for y = 0, uh - 1 do
					local p = (miRow // 2 + y) * LU + miCol // 2
					for x = 0, uw - 1 do
						local q = p + x + 1
						if x == 0 or (edges and x % stepU == 0) then
							leftUV[q] = ucode
						end
						if y == 0 or (edges and y % stepU == 0) then
							aboveUV[q] = ucode
						end
						if edges and uvTx == 0 then
							int4UV[q] = true
						end
					end
				end
			end
		end
	end
end

local function decodePartition(miRow, miCol, bs, n4l2)
	if miRow >= miRows or miCol >= miCols then
		return
	end
	local n8l2 = n4l2 - 1
	local num8 = lshift(1, n8l2)
	local hbs = rshift(num8, 1)
	local hasRows = miRow + hbs < miRows
	local hasCols = miCol + hbs < miCols
	local ctx = band(rshift(leftSeg[band(miRow, 7)], n8l2), 1) * 2 + band(rshift(aboveSeg[miCol], n8l2), 1) + n8l2 * 4
	local probs = intraFrame and KF_PARTITION or fc.partition
	local pb = ctx * 3
	local p
	if hasRows and hasCols then
		p = R:tree(PARTITION_TREE, probs, pb)
	elseif hasCols then
		p = R:read(probs[pb + 2]) == 1 and 3 or 1
	elseif hasRows then
		p = R:read(probs[pb + 3]) == 1 and 3 or 2
	else
		p = 3
	end
	if counts then
		counts.partition[ctx * 4 + p + 1] += 1
	end
	local sub = SUBSIZE[p + 1][bs + 1]
	if hbs == 0 then
		decodeBlock(miRow, miCol, sub, 1, 1)
	elseif p == 0 then
		decodeBlock(miRow, miCol, sub, n4l2, n4l2)
	elseif p == 1 then
		decodeBlock(miRow, miCol, sub, n4l2, n8l2)
		if hasRows then
			decodeBlock(miRow + hbs, miCol, sub, n4l2, n8l2)
		end
	elseif p == 2 then
		decodeBlock(miRow, miCol, sub, n8l2, n4l2)
		if hasCols then
			decodeBlock(miRow, miCol + hbs, sub, n8l2, n4l2)
		end
	else
		decodePartition(miRow, miCol, sub, n8l2)
		decodePartition(miRow, miCol + hbs, sub, n8l2)
		decodePartition(miRow + hbs, miCol, sub, n8l2)
		decodePartition(miRow + hbs, miCol + hbs, sub, n8l2)
	end
	if bs == BLOCK_8X8 or p ~= 3 then
		local va, vl = PART_ABOVE[sub + 1], PART_LEFT[sub + 1]
		for i = 0, num8 - 1 do
			aboveSeg[miCol + i] = va
			leftSeg[band(miRow, 7) + i] = vl
		end
	end
end


local updateSharpness, loopFilterFrame = (function()

------------------------------------------------------------------------------------------------------------------------
-- loop filter

local LIM, MBLIM = table.create(64, 0), table.create(64, 0)
local function updateSharpness(s)
	for lvl = 0, 63 do
		local lim = rshift(lvl, (s > 0 and 1 or 0) + (s > 4 and 1 or 0))
		if s > 0 and lim > 9 - s then
			lim = 9 - s
		end
		if lim < 1 then
			lim = 1
		end
		LIM[lvl + 1] = lim
		MBLIM[lvl + 1] = 2 * (lvl + 2) + lim
	end
end

local function sc(t)
	return math.clamp(t, -128, 127)
end

-- the narrow filter: p1 p0 | q0 q1 (s = q0, st = step across the edge)
local function filter4(buf: buffer, s: number, st: number, p1: number, p0: number, q0: number, q1: number, hevT: number)
	local ps1, ps0, qs0, qs1 = p1 - 128, p0 - 128, q0 - 128, q1 - 128
	if abs(p1 - p0) > hevT or abs(q1 - q0) > hevT then
		local f = math.clamp(math.clamp(ps1 - qs1, -128, 127) + 3 * (qs0 - ps0), -128, 127)
		local f1 = math.clamp(f + 4, -128, 127) // 8
		local f2 = math.clamp(f + 3, -128, 127) // 8
		writeu8(buf, s, math.clamp(qs0 - f1, -128, 127) + 128)
		writeu8(buf, s - st, math.clamp(ps0 + f2, -128, 127) + 128)
	else
		local f = math.clamp(3 * (qs0 - ps0), -128, 127)
		local f1 = math.clamp(f + 4, -128, 127) // 8
		local f2 = math.clamp(f + 3, -128, 127) // 8
		writeu8(buf, s, math.clamp(qs0 - f1, -128, 127) + 128)
		writeu8(buf, s - st, math.clamp(ps0 + f2, -128, 127) + 128)
		local g = (f1 + 1) // 2
		writeu8(buf, s + st, math.clamp(qs1 - g, -128, 127) + 128)
		writeu8(buf, s - 2 * st, math.clamp(ps1 + g, -128, 127) + 128)
	end
end

-- n pixels along the edge (along = step between them), the filter 4, 8 or 16 wide
local function filterEdge(buf: buffer, s: number, st: number, along: number, n: number, kind: number, lvl: number)
	local lim, mblim, hevT = LIM[lvl + 1], MBLIM[lvl + 1], rshift(lvl, 4)
	for _ = 1, n do
		local p3, p2, p1, p0 = readu8(buf, s - 4 * st), readu8(buf, s - 3 * st), readu8(buf, s - 2 * st), readu8(buf, s - st)
		local q0, q1, q2, q3 = readu8(buf, s), readu8(buf, s + st), readu8(buf, s + 2 * st), readu8(buf, s + 3 * st)
		if not (abs(p3 - p2) > lim or abs(p2 - p1) > lim or abs(p1 - p0) > lim or abs(q1 - q0) > lim or abs(q2 - q1) > lim
			or abs(q3 - q2) > lim or abs(p0 - q0) * 2 + abs(p1 - q1) // 2 > mblim) then
			local flat = false
			if kind > 1 and abs(p1 - p0) <= 1 and abs(q1 - q0) <= 1 and abs(p2 - p0) <= 1 and abs(q2 - q0) <= 1
				and abs(p3 - p0) <= 1 and abs(q3 - q0) <= 1 then
				flat = true
			end
			local done = false
			if flat and kind == 3 then
				local p4, p5, p6, p7 = readu8(buf, s - 5 * st), readu8(buf, s - 6 * st), readu8(buf, s - 7 * st), readu8(buf, s - 8 * st)
				local q4, q5, q6, q7 = readu8(buf, s + 4 * st), readu8(buf, s + 5 * st), readu8(buf, s + 6 * st), readu8(buf, s + 7 * st)
				if abs(p4 - p0) <= 1 and abs(q4 - q0) <= 1 and abs(p5 - p0) <= 1 and abs(q5 - q0) <= 1 and abs(p6 - p0) <= 1
					and abs(q6 - q0) <= 1 and abs(p7 - p0) <= 1 and abs(q7 - q0) <= 1 then
					writeu8(buf, s - 7 * st, rshift(p7 * 7 + p6 * 2 + p5 + p4 + p3 + p2 + p1 + p0 + q0 + 8, 4))
					writeu8(buf, s - 6 * st, rshift(p7 * 6 + p6 + p5 * 2 + p4 + p3 + p2 + p1 + p0 + q0 + q1 + 8, 4))
					writeu8(buf, s - 5 * st, rshift(p7 * 5 + p6 + p5 + p4 * 2 + p3 + p2 + p1 + p0 + q0 + q1 + q2 + 8, 4))
					writeu8(buf, s - 4 * st, rshift(p7 * 4 + p6 + p5 + p4 + p3 * 2 + p2 + p1 + p0 + q0 + q1 + q2 + q3 + 8, 4))
					writeu8(buf, s - 3 * st, rshift(p7 * 3 + p6 + p5 + p4 + p3 + p2 * 2 + p1 + p0 + q0 + q1 + q2 + q3 + q4 + 8, 4))
					writeu8(buf, s - 2 * st,
						rshift(p7 * 2 + p6 + p5 + p4 + p3 + p2 + p1 * 2 + p0 + q0 + q1 + q2 + q3 + q4 + q5 + 8, 4))
					writeu8(buf, s - st, rshift(p7 + p6 + p5 + p4 + p3 + p2 + p1 + p0 * 2 + q0 + q1 + q2 + q3 + q4 + q5 + q6 + 8, 4))
					writeu8(buf, s, rshift(p6 + p5 + p4 + p3 + p2 + p1 + p0 + q0 * 2 + q1 + q2 + q3 + q4 + q5 + q6 + q7 + 8, 4))
					writeu8(buf, s + st, rshift(p5 + p4 + p3 + p2 + p1 + p0 + q0 + q1 * 2 + q2 + q3 + q4 + q5 + q6 + q7 * 2 + 8, 4))
					writeu8(buf, s + 2 * st, rshift(p4 + p3 + p2 + p1 + p0 + q0 + q1 + q2 * 2 + q3 + q4 + q5 + q6 + q7 * 3 + 8, 4))
					writeu8(buf, s + 3 * st, rshift(p3 + p2 + p1 + p0 + q0 + q1 + q2 + q3 * 2 + q4 + q5 + q6 + q7 * 4 + 8, 4))
					writeu8(buf, s + 4 * st, rshift(p2 + p1 + p0 + q0 + q1 + q2 + q3 + q4 * 2 + q5 + q6 + q7 * 5 + 8, 4))
					writeu8(buf, s + 5 * st, rshift(p1 + p0 + q0 + q1 + q2 + q3 + q4 + q5 * 2 + q6 + q7 * 6 + 8, 4))
					writeu8(buf, s + 6 * st, rshift(p0 + q0 + q1 + q2 + q3 + q4 + q5 + q6 * 2 + q7 * 7 + 8, 4))
					done = true
				end
			end
			if not done then
				if flat then
					writeu8(buf, s - 3 * st, rshift(p3 + p3 + p3 + 2 * p2 + p1 + p0 + q0 + 4, 3))
					writeu8(buf, s - 2 * st, rshift(p3 + p3 + p2 + 2 * p1 + p0 + q0 + q1 + 4, 3))
					writeu8(buf, s - st, rshift(p3 + p2 + p1 + 2 * p0 + q0 + q1 + q2 + 4, 3))
					writeu8(buf, s, rshift(p2 + p1 + p0 + 2 * q0 + q1 + q2 + q3 + 4, 3))
					writeu8(buf, s + st, rshift(p1 + p0 + q0 + 2 * q1 + q2 + q3 + q3 + 4, 3))
					writeu8(buf, s + 2 * st, rshift(p0 + q0 + q1 + 2 * q2 + q3 + q3 + q3 + 4, 3))
				else
					filter4(buf, s, st, p1, p0, q0, q1, hevT)
				end
			end
		end
		s += along
	end
end

local sbL, sbA, sbI, sbLv = table.create(64, 0), table.create(64, 0), table.create(64, false), table.create(64, 0)
local uvL, uvA, uvI, uvLv = table.create(16, 0), table.create(16, 0), table.create(16, false), table.create(16, 0)

local function loopFilterFrame(f)
	local L, LU = lfStride, lfStride // 2
	local Y, U, V, ys, cs = f.Y, f.U, f.V, f.ys, f.cs
	for sbRow = 0, miRows - 1, 8 do
		local rows = min(8, miRows - sbRow)
		local urows = rshift(rows + 1, 1)
		for sbCol = 0, miCols - 1, 8 do
			local cols = min(8, miCols - sbCol)
			-- this superblock's edges after the adjustments (vp9_adjust_mask)
			for r = 0, 7 do
				for c = 0, 7 do
					local q = (sbRow + r) * L + sbCol + c + 1
					local k = r * 8 + c + 1
					local l, a, i4 = leftY[q], aboveY[q], int4Y[q]
					if l == 4 then
						l = 3
					end
					if a == 4 then
						a = 3
					end
					if l == 1 and c % 4 == 0 then
						l = 2
					end
					if a == 1 and r % 4 == 0 then
						a = 2
					end
					if r >= rows or c >= cols then
						l, a, i4 = 0, 0, false
					end
					if sbCol == 0 and c == 0 then
						l = 0
					end
					sbL[k], sbA[k], sbI[k], sbLv[k] = l, a, i4, lvlY[q]
				end
			end
			for r = 0, 3 do
				for c = 0, 3 do
					local q = (sbRow // 2 + r) * LU + sbCol // 2 + c + 1
					local k = r * 4 + c + 1
					local l, a, i4 = leftUV[q], aboveUV[q], int4UV[q]
					if l == 4 then
						l = 3
					end
					if a == 4 then
						a = 3
					end
					if l == 1 and c == 0 then
						l = 2
					end
					if a == 1 and r == 0 then
						a = 2
					end
					if rows < 8 then
						if r >= urows then
							l, a, i4 = 0, 0, false
						end
						if a == 3 and (rows == 1 or (rows == 5 and r >= 2)) then
							a = 2
						end
					end
					if cols < 8 then
						if c >= rshift(cols + 1, 1) then
							l, a = 0, 0
						end
						if c >= rshift(cols, 1) then
							i4 = false
						end
						if l == 3 and (cols == 1 or (cols == 5 and c >= 2)) then
							l = 2
						end
					end
					if sbCol == 0 and c == 0 then
						l = 0
					end
					uvL[k], uvA[k], uvI[k] = l, a, i4
					uvLv[k] = lvlY[(sbRow + 2 * r) * L + sbCol + 2 * c + 1]
				end
			end
			-- luma: vertical edges, then horizontal ones
			local x0, y0 = sbCol * 8, sbRow * 8
			for r = 0, rows - 1 do
				local rowOff = (y0 + r * 8) * ys + x0
				for c = 0, 7 do
					local k = r * 8 + c + 1
					local code = sbL[k]
					if code > 0 then
						filterEdge(Y, rowOff + c * 8, 1, ys, 8, code, sbLv[k])
					end
					if sbI[k] then
						filterEdge(Y, rowOff + c * 8 + 4, 1, ys, 8, 1, sbLv[k])
					end
				end
			end
			for r = 0, rows - 1 do
				local rowOff = (y0 + r * 8) * ys + x0
				local top = sbRow + r == 0
				for c = 0, 7 do
					local k = r * 8 + c + 1
					local code = top and 0 or sbA[k]
					if code > 0 then
						filterEdge(Y, rowOff + c * 8, ys, 1, 8, code, sbLv[k])
					end
					if sbI[k] then
						filterEdge(Y, rowOff + 4 * ys + c * 8, ys, 1, 8, 1, sbLv[k])
					end
				end
			end
			-- chroma
			local cx0, cy0 = sbCol * 4, sbRow * 4
			for p = 1, 2 do
				local P = p == 1 and U or V
				for r = 0, 3 do
					if sbRow + (r >= 2 and 4 or 0) < miRows then
						local rowOff = (cy0 + r * 8) * cs + cx0
						for c = 0, 3 do
							local k = r * 4 + c + 1
							local code = uvL[k]
							if code > 0 then
								filterEdge(P, rowOff + c * 8, 1, cs, 8, code, uvLv[k])
							end
							if uvI[k] then
								filterEdge(P, rowOff + c * 8 + 4, 1, cs, 8, 1, uvLv[k])
							end
						end
					end
				end
				for r = 0, 3 do
					local mr = sbRow + 2 * r
					if mr < miRows then
						local rowOff = (cy0 + r * 8) * cs + cx0
						local top = mr == 0
						local lastRow = mr == miRows - 1
						for c = 0, 3 do
							local k = r * 4 + c + 1
							local code = top and 0 or uvA[k]
							if code > 0 then
								filterEdge(P, rowOff + c * 8, cs, 1, 8, code, uvLv[k])
							end
							if uvI[k] and not lastRow then
								filterEdge(P, rowOff + 4 * cs + c * 8, cs, 1, 8, 1, uvLv[k])
							end
						end
					end
				end
			end
		end
		breathe()
	end
end

return updateSharpness, loopFilterFrame
