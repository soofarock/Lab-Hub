-- frames: planes over whole superblocks (aligned to 64), the crop size inside; per 8 x 8 cell the motion it used

local function newFrame(width, height)
	local miCols, miRows = (width + 7) // 8, (height + 7) // 8
	local sbCols, sbRows = (miCols + 7) // 8, (miRows + 7) // 8
	local ys = sbCols * 64
	local cs = ys // 2
	local f = {
		w = width, h = height, cw = (width + 1) // 2, ch = (height + 1) // 2,
		aw = miCols * 8, ah = miRows * 8, miCols = miCols, miRows = miRows,
		ys = ys, cs = cs, yo = 0, co = 0,
		Y = buffer.create(ys * sbRows * 64), U = buffer.create(cs * sbRows * 32), V = buffer.create(cs * sbRows * 32),
	}
	local n = miCols * miRows
	f.ref0, f.ref1 = table.create(n, NONE_FRAME), table.create(n, NONE_FRAME)
	f.mv0r, f.mv0c, f.mv1r, f.mv1c = table.create(n, 0), table.create(n, 0), table.create(n, 0), table.create(n, 0)
	return f
end

local Decoder = {}
Decoder.__index = Decoder

function Vp9.new()
	local self = setmetatable({}, Decoder)
	self.refMap = {} -- [0..7] -> frame
	self.contexts = {}
	for i = 1, 4 do
		self.contexts[i] = defaultContext()
	end
	self.width, self.height = 0, 0
	self.cropX, self.cropY = 0, 0
	self.fullRange, self.bt709 = false, false
	self.signBias = { [0] = 0, 0, 0, 0 }
	self.lf = { refDeltas = { [0] = 1, 0, -1, -1 }, modeDeltas = { [0] = 0, 0 }, sharpness = 0, lastSharpness = -1 }
	self.seg = { enabled = false, features = {}, data = {}, treeProbs = table.create(7, 255), predProbs = table.create(3, 255),
		absDelta = false }
	for i = 0, 7 do
		self.seg.features[i] = { false, false, false, false }
		self.seg.data[i] = { 0, 0, 0, 0 }
	end
	self.frameType, self.intraOnly = 0, false
	self.lastFrameType, self.lastIntraOnly = 0, false
	self.lastShowFrame = false
	self.lastWidth, self.lastHeight = 0, 0
	self.refs = {}
	self.pool = {}
	self.haveKey = false
	self.txMode, self.refMode, self.interpFilter, self.allowHp = 0, 0, 0, false
	return self
end

-- the parts of the uncompressed header after the size (shared by key, intra-only and inter frames)
function Decoder:readTail(rb, intraOnly)
	local errorRes = self.errorRes
	if not errorRes then
		self.refreshContext = rb.read() == 1
		self.parallel = rb.read() == 1
	else
		self.refreshContext = false
		self.parallel = true
	end
	self.contextIdx = rb.literal(2)
	if intraOnly or errorRes then
		self:setupPastIndependence()
	end
	-- loop filter
	local lf = self.lf
	lf.level = rb.literal(6)
	lf.sharpness = rb.literal(3)
	lf.deltaEnabled = rb.read() == 1
	if lf.deltaEnabled then
		if rb.read() == 1 then
			for i = 0, 3 do
				if rb.read() == 1 then
					lf.refDeltas[i] = rb.signed(6)
				end
			end
			for i = 0, 1 do
				if rb.read() == 1 then
					lf.modeDeltas[i] = rb.signed(6)
				end
			end
		end
	end
	-- quantizer
	self.baseQ = rb.literal(8)
	local function dq()
		return rb.read() == 1 and rb.signed(4) or 0
	end
	self.yDcDelta, self.uvDcDelta, self.uvAcDelta = dq(), dq(), dq()
	self.lossless = self.baseQ == 0 and self.yDcDelta == 0 and self.uvDcDelta == 0 and self.uvAcDelta == 0
	-- segmentation
	local seg = self.seg
	seg.updateMap, seg.updateData = false, false
	seg.enabled = rb.read() == 1
	if seg.enabled then
		seg.updateMap = rb.read() == 1
		if seg.updateMap then
			for i = 1, 7 do
				seg.treeProbs[i] = rb.read() == 1 and rb.literal(8) or 255
			end
			seg.temporal = rb.read() == 1
			for i = 1, 3 do
				seg.predProbs[i] = (seg.temporal and rb.read() == 1) and rb.literal(8) or 255
			end
		end
		seg.updateData = rb.read() == 1
		if seg.updateData then
			seg.absDelta = rb.read() == 1
			local maxes, signed, bits = { 255, 63, 3, 0 }, { true, true, false, false }, { 8, 6, 2, 0 }
			for i = 0, 7 do
				for j = 1, 4 do
					local on = rb.read() == 1
					local data = 0
					if on then
						data = bits[j] > 0 and min(rb.literal(bits[j]), maxes[j]) or 0
						if signed[j] and rb.read() == 1 then
							data = -data
						end
					end
					seg.features[i][j] = on
					seg.data[i][j] = data
				end
			end
		end
	end
	-- dequantizers per segment
	self.dq = {}
	for i = 0, (seg.enabled and 7 or 0) do
		local q = self.baseQ
		if seg.enabled and seg.features[i][1] then
			local d = seg.data[i][1]
			q = math.clamp(seg.absDelta and d or q + d, 0, 255)
		end
		self.dq[i] = {
			T.DC_Q[math.clamp(q + self.yDcDelta, 0, 255) + 1], T.AC_Q[math.clamp(q, 0, 255) + 1],
			T.DC_Q[math.clamp(q + self.uvDcDelta, 0, 255) + 1], T.AC_Q[math.clamp(q + self.uvAcDelta, 0, 255) + 1],
		}
	end
	-- tiles
	local sb64 = (self.miCols + 7) // 8
	local minLog2, maxLog2 = 0, 1
	while lshift(64, minLog2) < sb64 do
		minLog2 += 1
	end
	while rshift(sb64, maxLog2) >= 4 do
		maxLog2 += 1
	end
	maxLog2 -= 1
	local log2 = minLog2
	local ones = maxLog2 - minLog2
	while ones > 0 and rb.read() == 1 do
		log2 += 1
		ones -= 1
	end
	self.log2TileCols = log2
	self.log2TileRows = rb.read()
	if self.log2TileRows == 1 then
		self.log2TileRows += rb.read()
	end
	local headerSize = rb.literal(16)
	if headerSize == 0 then
		fail("broken data (an empty header)")
	end
	return headerSize
end

function Decoder:setupPastIndependence()
	local seg = self.seg
	for i = 0, 7 do
		seg.features[i] = { false, false, false, false }
		seg.data[i] = { 0, 0, 0, 0 }
	end
	seg.absDelta = false
	local n = self.miCols * self.miRows
	for i = 1, n do
		self.lastSegMap[i] = 0
		self.curSegMap[i] = 0
	end
	local lf = self.lf
	lf.deltaEnabled = true
	lf.refDeltas = { [0] = 1, 0, -1, -1 }
	lf.modeDeltas = { [0] = 0, 0 }
	lf.lastSharpness = -1
	local fc = defaultContext()
	self.fc = fc
	if self.frameType == 0 or self.errorRes or self.resetContext == 3 then
		for i = 1, 4 do
			self.contexts[i] = cloneContext(fc)
		end
	elseif self.resetContext == 2 then
		self.contexts[self.contextIdx + 1] = cloneContext(fc)
	end
	self.signBias = { [0] = 0, 0, 0, 0 }
	self.contextIdx = 0
end

function Decoder:setSize(width, height)
	if width ~= self.width or height ~= self.height then
		self.width, self.height = width, height
		self.miCols, self.miRows = (width + 7) // 8, (height + 7) // 8
		local n = self.miCols * self.miRows
		self.lastSegMap = table.create(n, 0)
		self.curSegMap = table.create(n, 0)
	end
end

-- the compressed header: probability updates for this frame
function Decoder:readCompressedHeader(buf, pos, size)
	local r = newReader(buf, pos, size)
	local fc = self.fc
	local txMode
	if self.lossless then
		txMode = 0
	else
		txMode = r:literal(2)
		if txMode == 3 then
			txMode += r:read(128)
		end
	end
	self.txMode = txMode
	if txMode == 4 then
		for i = 1, 2 do
			diffUpdate(r, fc.tx8, i)
		end
		for i = 1, 4 do
			diffUpdate(r, fc.tx16, i)
		end
		for i = 1, 6 do
			diffUpdate(r, fc.tx32, i)
		end
	end
	for t = 1, TX_MODE_BIGGEST[txMode + 1] + 1 do
		if r:read(128) == 1 then
			local probs = fc.coef[t]
			for i = 0, 1 do
				for j = 0, 1 do
					for k = 0, 5 do
						for l = 0, (k == 0 and 2 or 5) do
							local base = (((i * 2 + j) * 6 + k) * 6 + l) * 3
							for m = 1, 3 do
								diffUpdate(r, probs, base + m)
							end
						end
					end
				end
			end
		end
	end
	for i = 1, 3 do
		diffUpdate(r, fc.skip, i)
	end
	if not self.intraOnlyFrame then
		for i = 1, 21 do
			diffUpdate(r, fc.interMode, i)
		end
		if self.interpFilter == 4 then
			for i = 1, 8 do
				diffUpdate(r, fc.interp, i)
			end
		end
		for i = 1, 4 do
			diffUpdate(r, fc.intraInter, i)
		end
		-- reference mode
		local sb = self.signBias
		local compAllowed = sb[2] ~= sb[1] or sb[3] ~= sb[1]
		local refMode = 0
		if compAllowed then
			if r:read(128) == 1 then
				refMode = r:read(128) == 1 and 2 or 1
			end
		end
		self.refMode = refMode -- 0 single, 1 compound, 2 select
		if refMode ~= 0 then
			if sb[LAST_FRAME] == sb[GOLDEN_FRAME] then
				self.compFixed, self.compVar0, self.compVar1 = ALTREF_FRAME, LAST_FRAME, GOLDEN_FRAME
			elseif sb[LAST_FRAME] == sb[ALTREF_FRAME] then
				self.compFixed, self.compVar0, self.compVar1 = GOLDEN_FRAME, LAST_FRAME, ALTREF_FRAME
			else
				self.compFixed, self.compVar0, self.compVar1 = LAST_FRAME, GOLDEN_FRAME, ALTREF_FRAME
			end
		end
		if refMode == 2 then
			for i = 1, 5 do
				diffUpdate(r, fc.compInter, i)
			end
		end
		if refMode ~= 1 then
			for i = 1, 10 do
				diffUpdate(r, fc.singleRef, i)
			end
		end
		if refMode ~= 0 then
			for i = 1, 5 do
				diffUpdate(r, fc.compRef, i)
			end
		end
		for i = 1, 36 do
			diffUpdate(r, fc.yMode, i)
		end
		for i = 1, 48 do
			diffUpdate(r, fc.partition, i)
		end
		-- motion vector probabilities
		local function upd(probs, i)
			if r:read(252) == 1 then
				probs[i] = r:literal(7) * 2 + 1
			end
		end
		for i = 1, 3 do
			upd(fc.joints, i)
		end
		for i = 0, 1 do
			upd(fc.sign, i + 1)
			for j = 1, 10 do
				upd(fc.classes, i * 10 + j)
			end
			upd(fc.class0, i + 1)
			for j = 1, 10 do
				upd(fc.bits, i * 10 + j)
			end
		end
		for i = 0, 1 do
			for j = 0, 1 do
				for k = 1, 3 do
					upd(fc.class0fp, (i * 2 + j) * 3 + k)
				end
			end
			for k = 1, 3 do
				upd(fc.fp, i * 3 + k)
			end
		end
		if self.allowHp then
			for i = 1, 2 do
				upd(fc.class0hp, i)
				upd(fc.hp, i)
			end
		end
	end
end


