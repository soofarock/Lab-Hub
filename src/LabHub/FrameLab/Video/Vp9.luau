-- the boolean (arithmetic) decoder: value holds the 8-bit window and `cnt` more bits below it
local Reader = {}
Reader.__index = Reader

local function newReader(buf, pos, size)
	if size < 1 then
		fail("a tile is empty")
	end
	local r = setmetatable({ buf = buf, pos = pos + 1, stop = pos + size, value = readu8(buf, pos), cnt = 0, range = 255 }, Reader)
	if r:read(128) ~= 0 then
		fail("broken data (marker bit)")
	end
	return r
end

function Reader:read(p)
	local cnt = self.cnt
	local value = self.value
	if cnt < 8 then
		local buf, pos, stop = self.buf, self.pos, self.stop
		repeat
			value = value * 256 + (pos < stop and readu8(buf, pos) or 0)
			pos += 1
			cnt += 8
		until cnt >= 16
		self.pos = pos
	end
	local range = self.range
	local split = 1 + rshift((range - 1) * p, 8)
	local big = split * POW2[cnt + 1]
	local bit
	if value >= big then
		range -= split
		value -= big
		bit = 1
	else
		range = split
		bit = 0
	end
	local shift = NORM[range + 1]
	self.range = lshift(range, shift)
	self.cnt = cnt - shift
	self.value = value
	return bit
end

function Reader:literal(bits)
	local v = 0
	for _ = 1, bits do
		v = v * 2 + self:read(128)
	end
	return v
end

-- tree: 1-based copy of a vpx_tree_index array; probs: array, base (0-based offset into it)
function Reader:tree(tree, probs, base)
	local i = 0
	repeat
		i = tree[i + self:read(probs[base + rshift(i, 1) + 1]) + 1]
	until i <= 0
	return -i
end

