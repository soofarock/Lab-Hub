local tmpOut, tmpIn, tmpCol = table.create(1024, 0), table.create(32, 0), table.create(32, 0)
local DCTF = { [0] = idct4, idct8, idct16, idct32 }
local ADSTF = { [0] = iadst4, iadst8, iadst16, idct32 }
-- (rows: horizontal = DCT for DCT_DCT, ADST_DCT; columns: vertical = ADST for ADST_DCT, ADST_ADST)
local ROW_ADST = { [0] = false, false, true, true }
local COL_ADST = { [0] = false, true, false, true }
local SHIFT = { [0] = 4, 5, 6, 6 }

-- coef (0-based table, n x n) -> added to the plane at off (stride); then the coefficients written are cleared
local function inverseTransform(coef, txSize, txType, plane, off, stride, eob)
	local n = lshift(4, txSize)
	if eob == 1 and (txType == 0 or txSize == 3) then
		-- only the DC: one value added to the whole block
		local shift = SHIFT[txSize]
		local v = floor((RS(RS(coef[0] * 11585) * 11585) + lshift(1, shift - 1)) / lshift(1, shift))
		if v == 0 then
			return
		end
		for i = 0, n - 1 do
			local p = off + i * stride
			for j = 0, n - 1 do
				local x = readu8(plane, p + j) + v
				writeu8(plane, p + j, math.clamp(x, 0, 255))
			end
		end
		return
	end
	local rowf = ROW_ADST[txType] and ADSTF[txSize] or DCTF[txSize]
	local colf = COL_ADST[txType] and ADSTF[txSize] or DCTF[txSize]
	local out = tmpOut
	-- rows (an all-zero row stays zero)
	for i = 0, n - 1 do
		local base = i * n
		local any = false
		for j = 0, n - 1 do
			if coef[base + j] ~= 0 then
				any = true
				break
			end
		end
		if any then
			rowf(coef, base, out, base)
		else
			for j = 0, n - 1 do
				out[base + j] = 0
			end
		end
	end
	local shift = SHIFT[txSize]
	local half = lshift(1, shift - 1)
	local div = lshift(1, shift)
	local tin, tc = tmpIn, tmpCol
	for i = 0, n - 1 do
		for j = 0, n - 1 do
			tin[j] = out[j * n + i]
		end
		colf(tin, 0, tc, 0)
		local p = off + i
		for j = 0, n - 1 do
			local v = readu8(plane, p) + floor((tc[j] + half) / div)
			writeu8(plane, p, math.clamp(v, 0, 255))
			p += stride
		end
	end
end

-- the lossless transform (Walsh-Hadamard 4 x 4)
local function inverseWht(coef, plane, off, stride)
	local op = tmpOut
	for i = 0, 3 do
		local a1 = floor(coef[i * 4] / 4)
		local c1 = floor(coef[i * 4 + 1] / 4)
		local d1 = floor(coef[i * 4 + 2] / 4)
		local b1 = floor(coef[i * 4 + 3] / 4)
		a1 += c1
		d1 -= b1
		local e1 = floor((a1 - d1) / 2)
		b1 = e1 - b1
		c1 = e1 - c1
		a1 -= b1
		d1 += c1
		op[i * 4], op[i * 4 + 1], op[i * 4 + 2], op[i * 4 + 3] = a1, b1, c1, d1
	end
	for i = 0, 3 do
		local a1, c1, d1, b1 = op[i], op[4 + i], op[8 + i], op[12 + i]
		a1 += c1
		d1 -= b1
		local e1 = floor((a1 - d1) / 2)
		b1 = e1 - b1
		c1 = e1 - c1
		a1 -= b1
		d1 += c1
		local p = off + i
		local vals = { a1, b1, c1, d1 }
		for j = 1, 4 do
			local v = readu8(plane, p) + vals[j]
			writeu8(plane, p, math.clamp(v, 0, 255))
			p += stride
		end
	end
end

return inverseTransform, inverseWht
