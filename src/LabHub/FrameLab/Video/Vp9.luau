-- the uncompressed header's plain bits
local function bitReader(buf, pos, size)
	local rb = { bit = 0 }
	function rb.read()
		local byte = rb.bit // 8
		if byte >= size then
			fail("the frame header is cut off")
		end
		local b = band(rshift(readu8(buf, pos + byte), 7 - rb.bit % 8), 1)
		rb.bit += 1
		return b
	end
	function rb.literal(n)
		local v = 0
		for _ = 1, n do
			v = v * 2 + rb.read()
		end
		return v
	end
	function rb.signed(n)
		local v = rb.literal(n)
		return rb.read() == 1 and -v or v
	end
	function rb.bytes()
		return (rb.bit + 7) // 8
	end
	return rb
end

