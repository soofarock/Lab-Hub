		bits = { 136, 140, 148, 160, 176, 192, 224, 234, 234, 240, 136, 140, 148, 160, 176, 192, 224, 234, 234, 240 },
		class0fp = { 128, 128, 64, 96, 112, 64, 128, 128, 64, 96, 112, 64 },
		fp = { 64, 96, 64, 64, 96, 64 },
		class0hp = { 160, 160 },
		hp = { 128, 128 },
		initialized = true,
	}
end

local function cloneContext(c)
	local n = {}
	for k, v in pairs(c) do
		if k == "coef" then
			n.coef = { table.clone(v[1]), table.clone(v[2]), table.clone(v[3]), table.clone(v[4]) }
		elseif type(v) == "table" then
			n[k] = table.clone(v)
		else
			n[k] = v
		end
	end
	return n
end

local function newCounts()
	local c = { coef = {}, eob = {} }
	for t = 1, 4 do
		c.coef[t] = table.create(576, 0)
		c.eob[t] = table.create(144, 0)
	end
	c.skip = table.create(6, 0)
	c.tx8 = table.create(4, 0)
	c.tx16 = table.create(6, 0)
	c.tx32 = table.create(8, 0)
	c.yMode = table.create(40, 0)
	c.uvMode = table.create(100, 0)
	c.partition = table.create(64, 0)
	c.interMode = table.create(28, 0)
	c.interp = table.create(12, 0)
	c.intraInter = table.create(8, 0)
	c.compInter = table.create(10, 0)
	c.singleRef = table.create(20, 0)
	c.compRef = table.create(10, 0)
	c.joints = table.create(4, 0)
	c.sign = table.create(4, 0)
	c.classes = table.create(22, 0)
	c.class0 = table.create(4, 0)
	c.bits = table.create(40, 0)
	c.class0fp = table.create(16, 0)
	c.fp = table.create(8, 0)
	c.class0hp = table.create(4, 0)
	c.hp = table.create(4, 0)
	return c
end

local function adaptCoef(fc, pre, counts, intraOnly, lastKey)
	local sat, factor = 24, 112
	if not intraOnly and lastKey then
		factor = 128
	end
	for t = 1, 4 do
		local probs, pp, cc, ec = fc.coef[t], pre.coef[t], counts.coef[t], counts.eob[t]
		for i = 0, 1 do
			for j = 0, 1 do
				for k = 0, 5 do
					for l = 0, (k == 0 and 2 or 5) do
						local ci = ((i * 2 + j) * 6 + k) * 6 + l
						local n0, n1, n2, neob = cc[ci * 4 + 1], cc[ci * 4 + 2], cc[ci * 4 + 3], cc[ci * 4 + 4]
						local b0, b1 = neob, ec[ci + 1] - neob
						local pi = ci * 3
						for m = 0, 2 do
							local c0, c1
							if m == 0 then
								c0, c1 = b0, b1
							elseif m == 1 then
								c0, c1 = n0, n1 + n2
							else
								c0, c1 = n1, n2
							end
							local den = c0 + c1
							local prob = den == 0 and 128 or getProb(c0, den)
							local count = min(den, sat)
							local f = factor * count // sat
							probs[pi + m + 1] = weighted(pp[pi + m + 1], prob, f)
						end
					end
				end
			end
		end
	end
end

local function adaptMode(fc, pre, c, switchable, txSelect)
	for i = 1, 4 do
		fc.intraInter[i] = mergeModeMv(pre.intraInter[i], c.intraInter[i * 2 - 1], c.intraInter[i * 2])
	end
	for i = 1, 5 do
		fc.compInter[i] = mergeModeMv(pre.compInter[i], c.compInter[i * 2 - 1], c.compInter[i * 2])
		fc.compRef[i] = mergeModeMv(pre.compRef[i], c.compRef[i * 2 - 1], c.compRef[i * 2])
		for j = 0, 1 do
			local k = (i - 1) * 2 + j
			fc.singleRef[k + 1] = mergeModeMv(pre.singleRef[k + 1], c.singleRef[k * 2 + 1], c.singleRef[k * 2 + 2])
		end
	end
	for i = 0, 6 do
		-- (counts are kept by mode offset from NEARESTMV, the tree's leaves the same)
		treeMerge(INTER_MODE_TREE, pre.interMode, i * 3, c.interMode, i * 4, fc.interMode)
	end
	for i = 0, 3 do
		treeMerge(INTRA_MODE_TREE, pre.yMode, i * 9, c.yMode, i * 10, fc.yMode)
	end
	for i = 0, 9 do
		treeMerge(INTRA_MODE_TREE, pre.uvMode, i * 9, c.uvMode, i * 10, fc.uvMode)
	end
	for i = 0, 15 do
		treeMerge(PARTITION_TREE, pre.partition, i * 3, c.partition, i * 4, fc.partition)
	end
	if switchable then
		for i = 0, 3 do
			treeMerge(SWITCHABLE_TREE, pre.interp, i * 2, c.interp, i * 3, fc.interp)
		end
	end
	if txSelect then
		for i = 0, 1 do
			local t8 = { c.tx8[i * 2 + 1], c.tx8[i * 2 + 2] }
			fc.tx8[i + 1] = mergeModeMv(pre.tx8[i + 1], t8[1], t8[2])
			local a, b, d = c.tx16[i * 3 + 1], c.tx16[i * 3 + 2], c.tx16[i * 3 + 3]
			fc.tx16[i * 2 + 1] = mergeModeMv(pre.tx16[i * 2 + 1], a, b + d)
			fc.tx16[i * 2 + 2] = mergeModeMv(pre.tx16[i * 2 + 2], b, d)
			local e, f, g, h = c.tx32[i * 4 + 1], c.tx32[i * 4 + 2], c.tx32[i * 4 + 3], c.tx32[i * 4 + 4]
			fc.tx32[i * 3 + 1] = mergeModeMv(pre.tx32[i * 3 + 1], e, f + g + h)
			fc.tx32[i * 3 + 2] = mergeModeMv(pre.tx32[i * 3 + 2], f, g + h)
			fc.tx32[i * 3 + 3] = mergeModeMv(pre.tx32[i * 3 + 3], g, h)
		end
	end
	for i = 1, 3 do
		fc.skip[i] = mergeModeMv(pre.skip[i], c.skip[i * 2 - 1], c.skip[i * 2])
	end
end

local function adaptMv(fc, pre, c, allowHp)
	treeMerge(MV_JOINT_TREE, pre.joints, 0, c.joints, 0, fc.joints)
	for i = 0, 1 do
		fc.sign[i + 1] = mergeModeMv(pre.sign[i + 1], c.sign[i * 2 + 1], c.sign[i * 2 + 2])
		treeMerge(MV_CLASS_TREE, pre.classes, i * 10, c.classes, i * 11, fc.classes)
		treeMerge(MV_CLASS0_TREE, pre.class0, i, c.class0, i * 2, fc.class0)
		for j = 0, 9 do
			local k = i * 10 + j
			fc.bits[k + 1] = mergeModeMv(pre.bits[k + 1], c.bits[k * 2 + 1], c.bits[k * 2 + 2])
		end
		for j = 0, 1 do
			treeMerge(MV_FP_TREE, pre.class0fp, (i * 2 + j) * 3, c.class0fp, (i * 2 + j) * 4, fc.class0fp)
		end
		treeMerge(MV_FP_TREE, pre.fp, i * 3, c.fp, i * 4, fc.fp)
		if allowHp then
			fc.class0hp[i + 1] = mergeModeMv(pre.class0hp[i + 1], c.class0hp[i * 2 + 1], c.class0hp[i * 2 + 2])
			fc.hp[i + 1] = mergeModeMv(pre.hp[i + 1], c.hp[i * 2 + 1], c.hp[i * 2 + 2])
		end
	end
end


